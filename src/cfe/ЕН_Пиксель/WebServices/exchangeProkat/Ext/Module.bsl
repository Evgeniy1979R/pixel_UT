		ИмяМенеджера = "Справочники";
		ИмяОбъекта = СтрЗаменить(ТипИсточника,"Справочник.","");
	КонецЕсли;
	Возврат Новый Структура("ИмяМенеджера,ИмяОбъекта",ИмяМенеджера,ИмяОбъекта );

