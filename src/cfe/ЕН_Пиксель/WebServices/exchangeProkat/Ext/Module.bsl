Функция СкорректироватьСтавкуНДСПоДате(Знач СтавкаНДС,Знач Дата)
	Если ТипЗнч(СтавкаНДС) = Тип("СправочникСсылка.СтавкиНДС") Тогда 
		СтавкаНДС = СтавкаНДС.ПеречислениеСтавкаНДС;
	КонецЕсли;
	
	Если Дата = '00010101' Тогда 
		Дата = ТекущаяДата();
	КонецЕсли;
	
	Результат = СтавкаНДС;
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС18 
		или СтавкаНДС = Перечисления.СтавкиНДС.НДС20
		или СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда 
		Если Дата < '20190101' Тогда 
			Результат = Перечисления.СтавкиНДС.НДС18;
		ИначеЕсли Дата < '20260101' Тогда 
			Результат = Перечисления.СтавкиНДС.НДС20;
		Иначе
			Результат = Перечисления.СтавкиНДС.НДС22;
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

