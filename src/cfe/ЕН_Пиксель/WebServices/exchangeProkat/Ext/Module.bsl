Функция ПолучитьСоздатьДоговор (Организация,Контрагент,ТипДоговора) Экспорт
	Если ТипЗнч(ТипДоговора) = Тип("Строка") Тогда
		ВидДоговора = Перечисления.ТипыДоговоров[ВидДоговора];
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка КАК Договор
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Контрагент = &Контрагент
	|	И ДоговорыКонтрагентов.ТипДоговора = &ВидДоговора
	|	И ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорыКонтрагентов.Организация = &Организация");
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("ВидДоговора",Перечисления.ТипыДоговоров.СПокупателем);
	Запрос.УстановитьПараметр("Организация",Организация);
	// попадались догворы ведение взаиморасчетов по заказам, из за чего не проводятся реализации
	//Запрос.УстановитьПараметр("ВедениеВзаиморасчетов",Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом);
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	Если Выборка.Следующий() Тогда

		Возврат Выборка.Договор;
	Иначе
		ЭтоОрганизацияПрокат = Организация = Справочники.Организации.ПолучитьСсылку(		Новый УникальныйИдентификатор("9a093968-89ff-11e6-b801-002590a813d8"));
		Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Договор.Контрагент = Контрагент;
		Договор.ТипДоговора = ТипДоговора;
		Если ЭтоОрганизацияПрокат = истина Тогда 

			Договор.Наименование = "По договорам(прокат)";// ?(ТипДоговора = Перечисления.ТипыДоговоров.Про,"Договор залога","Договор аренды");//Контрагент.Наименование+"_"+ВидДоговора;
			Договор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
		    Договор.НаименованиеДляПечати = "По договорам(прокат)";
		Иначе
			
			Договор.Наименование = "По заказам";// ?(ТипДоговора = Перечисления.ТипыДоговоров.Про,"Договор залога","Договор аренды");//Контрагент.Наименование+"_"+ВидДоговора;
			Договор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
		    Договор.НаименованиеДляПечати = "По заказам";

		КонецЕсли;
		//Договор.ВидВзаиморасчетов	=
		Договор.Организация = Организация;
		Договор.УстановитьНовыйКод();
		Договор.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчета.Получить();
		//Счет организации	0000, ООО "Ф-СТОР"
		Договор.Партнер = Контрагент.Партнер;
		Договор.Статус	= Перечисления.СтатусыДоговоровКонтрагентов.Действует;
		Договор.Согласован = Истина;
		Договор.СтавкаНДС = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(СкорректироватьСтавкуНДСПоДате(Перечисления.СтавкиНДС.НДС20,Договор.Дата));//Ставка НДС	20%
				Договор.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		Договор.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		Договор.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным;
		Договор.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.Переменный;
		Договор.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента; //Статья движения денежных средств

		Попытка

			Договор.Записать();
		Исключение
			ТекстЖурналаРегистрации = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Договор.ОбменДанными.Загрузка = Истина;
			Договор.Записать();
			ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации()+".ОшибкаПриЗаписиДогов",УровеньЖурналаРегистрации.Ошибка,Метаданные.Справочники.ДоговорыКонтрагентов,Договор.Ссылка,
			ТекстЖурналаРегистрации);
		КонецПопытки;
		Возврат Договор.Ссылка;
	КонецЕсли;
КонецФункции //

#КонецОбласти

Функция exchange(prut)

	ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации(),УровеньЖурналаРегистрации.Информация,,"Подключение: "+ТекущаяДата());

	ТипОбъектаПРУТ = ФабрикаXDTO.Тип("http://exchangeprokatut","prut");
	оОтвет = ФабрикаXDTO.Создать(ТипОбъектаПРУТ);
	оОтвет.IdDestination 	= "";
	оОтвет.IdSource			= "";
	оОтвет.MdDestination    = "";
	оОтвет.MdSource		    = "";
	оОтвет.Object			= "";
	оОтвет.Result			= "неизвестная ошибка";
	оОтвет.Action			= "";
	Попытка
		Если prut.Action = "УправленческаяРеализацияДляСклада" Тогда
			ПолученУправленческаяРеализацияТоваровУслуг(prut,оОтвет); //++
		ИначеЕсли prut.Action = "ЗапросСостоянияДокументов" Тогда
			ЗапросСостоянияДокументов(prut,оОтвет);
		ИначеЕсли prut.MdDestination = "Справочник.СерииНоменклатуры" Тогда
			ПолученСерийныйНомер(prut,оОтвет);
		ИначеЕсли prut.MdDestination = "Справочник.Номенклатура" Тогда
			ПолученНоменклатура(prut,оОтвет);
		ИначеЕсли prut.MdDestination = "Справочник.Контрагенты" Тогда
			ПолученКонтрагент(prut,оОтвет);
		ИначеЕсли prut.MdSource = "Документ.ПродлениеАренды" Тогда
			ПолученПродлениеАренды(prut,оОтвет); // ++
		ИначеЕсли prut.MdSource = "Документ.ПриходныйКассовыйОрдер" Тогда
			ПолученПриходныйКассовыйОрдер(prut,оОтвет); //++
		ИначеЕсли prut.MdSource = "Документ.РасходныйКассовыйОрдер" Тогда
			ПолученРасходныйКассовыйОрдер(prut,оОтвет); //++
		ИначеЕсли prut.MdDestination = "Документ.ВозвратТоваровОтПокупателя" Тогда
			ПолученВозвратТоваровОтПокупателя(prut,оОтвет); //++
		ИначеЕсли prut.MdDestination = "Документ.РеализацияТоваровУслуг" Тогда
			ПолученРеализацияТоваровУслуг(prut,оОтвет); //++
		КонецЕсли;
	Исключение
		оОтвет.Result = "Ошибка:
		|IdDestination: "+prut.IdDestination+
		"|IdSource:"+prut.IdSource+
		"|MdDestination:"+prut.MdDestination+
		"|MdSource:"+prut.MdSource+
		"|Object:"+prut.Object+
		"|Action:"+prut.Action+
		"|ОписаниеОшибки:"+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации(),УровеньЖурналаРегистрации.Ошибка,,,оОтвет.Result);
	КонецПопытки;

	Возврат оОтвет;

КонецФункции

Процедура ПроверитьДокументПоДатеНачалаУчета(оОбъект)
	Если оОбъект.Дата < '20260204' Тогда 
		ВызватьИсключение("Получен документ ранее даты начала учета");
	КонецЕсли;
КонецПроцедуры
