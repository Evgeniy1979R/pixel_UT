Функция ПолучитьВидОплаты(Знач Код)

	КодСтрока = ПреобразоватьВЧисло(Код);
	Результат = Новый Структура("Свойство,Значение",ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка(),
	Справочники.ЗначенияСвойствОбъектов.ПустаяСсылка());
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПодстрокаПоиска", СтрШаблон("%%{%1}%%",КодСтрока));
	Запрос.УстановитьПараметр("ИмяДопСвойстваВидОплаты", ИмяДопСвойстваВидОплаты());
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка,
	|	ЗначенияСвойствОбъектов.Владелец КАК Свойство
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Владелец.Имя = &ИмяДопСвойстваВидОплаты
	|	И ЗначенияСвойствОбъектов.Наименование ПОДОБНО &Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Вставить("Свойство", Выборка.Свойство);
		Результат.Вставить("Значение", Выборка.Значение);
	КонецЕсли;
	Возврат Результат;


КонецФункции

Процедура ПолученПродлениеАренды(Сообщение,оОтвет)

	ЧтениеХМЛ	= Новый ЧтениеXML;
	ЧтениеХМл.УстановитьСтроку(Сообщение.Object);
	сОбъект 	= СериализаторXDTO.ПрочитатьXML(ЧтениеХМЛ);
	Ссылка		= Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Сообщение.IdSource));
	оОбъект		= Ссылка.ПолучитьОбъект();
	Если оОбъект = Неопределено Тогда
		оОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		оОбъект.УстановитьСсылкуНового(Ссылка);
		оОбъект.Дата = сОбъект.Дата;
		оОбъект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыРеализацийТоваровУслуг.Отгружено");
		оОбъект.Подразделение           = Справочники.СтруктураПредприятия.НайтиПоКоду("00-000001"); // прокат
	КонецЕсли;

	оОбъект.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	оОбъект.Комментарий				= сОбъект.Комментарий;

	оОбъект.Организация				= Справочники.Организации.НайтиПоРеквизиту("ИНН",сОбъект.ОрганизацияКод);
	Если не ЗначениеЗаполнено(оОбъект.Номер) Тогда
		//оОбъект.Номер				= сОбъект.Номер;
		оОбъект.УстановитьНовыйНомер();
	КонецЕсли;
	оОбъект.Менеджер				= Справочники.Пользователи.НайтиПоНаименованию("obmenprokat");
	оОбъект.СуммаДокумента			= сОбъект.СуммаДокумента;
	Если СтрДлина(сОбъект.УИДКонтрагент) = 36 Тогда
		оОбъект.Контрагент = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(сОбъект.УИДКонтрагент));
		оОбъект.Партнер = оОбъект.Контрагент.Партнер;
	КонецЕсли; 
	
	оОбъект.Договор					= ПолучитьСоздатьДоговор(оОбъект.Организация,оОбъект.Контрагент,Перечисления.ТипыДоговоров.СПокупателем);
	оОбъект.Соглашение				= ПолучитьТиповоеСоглашениеФизЛица();
	оОбъект.Валюта					= Константы.ВалютаРегламентированногоУчета.Получить();
	оОбъект.НалогообложениеНДС		= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	оОбъект.ЦенаВключаетНДС			= Истина;
	оОбъект.КурсЧислитель			= 1;
	оОбъект.КурсЗнаменатель			= 1;

	Если Не сОбъект.др_ВидыОплатыКод = "" Тогда
		сВидОплаты = ПолучитьВидОплаты(сОбъект.др_ВидыОплатыКод);
		Если сВидОплаты.Значение.Пустая() = Ложь Тогда
			сДопРеквизиты			= оОбъект.ДополнительныеРеквизиты.Найти(сВидОплаты.Свойство,"Свойство");
			Если сДопРеквизиты = Неопределено Тогда
				сДопРеквизиты			= оОбъект.ДополнительныеРеквизиты.Добавить();
				сДопРеквизиты.Свойство	= сВидОплаты.Свойство;
			КонецЕсли;
			сДопРеквизиты.Значение = сВидОплаты.Значение;
		КонецЕсли;
	КонецЕсли;
	тУслуги = оОбъект.Товары;
	тУслуги.Очистить();
	Для Каждого Элемент из сОбъект.Услуги Цикл
		стрУслуги						= тУслуги.Добавить();
		стрУслуги.Количество			= Элемент.Количество;
		стрУслуги.КоличествоУпаковок	= стрУслуги.Количество;
		стрУслуги.Номенклатура			= Справочники.Номенклатура.НайтиПоКоду(Элемент.НоменклатураКод);
		стрУслуги.СтавкаНДС				= УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(СкорректироватьСтавкуНДСПоДате(СтавкаНДС(Элемент.СтавкаНДС),оОбъект.Дата));
		стрУслуги.Сумма					= Элемент.Сумма;
		стрУслуги.СуммаНДС				= Элемент.СуммаНДС;
		стрУслуги.Цена					= Элемент.Цена;
		стрУслуги.СуммаСНДС				= стрУслуги.Сумма;
	КонецЦикла;

	Ошибка = "true";
	ПроверитьДокументПоДатеНачалаУчета(оОбъект);
	Попытка
		оОбъект.Записать();
	Исключение
		Ошибка = "Ошибка при записи документа. "+ОписаниеОшибки();
	КонецПопытки;
	Если Ошибка = "" Тогда
		Попытка
			оОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Ошибка = "Ошибка при проведении документа. "+ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;

	оОтвет.IdDestination	= XMLСтрока(Ссылка.УникальныйИдентификатор());
	оОтвет.IdSource			= Сообщение.IdSource;
	оОтвет.MdDestination	= XMLСтрока(оОбъект.Метаданные().ПолноеИмя());;
	оОтвет.MdSource			= Сообщение.MdSource;
	оОтвет.Result			= Ошибка;
	оОтвет.Object			= ВернутьПустуюСтруктуруXDTO();

КонецПроцедуры

