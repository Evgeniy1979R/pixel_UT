	оОбъект.КПП						= сОбъект.КПП;
	оОбъект.КодПоОКПО				= сОбъект.КодПоОКПО;
	оОбъект.Наименование			= сОбъект.Наименование;
	оОбъект.НаименованиеПолное		= сОбъект.НаименованиеПолное;
	ЮрФизЛицо = "";
	сОбъект.Свойство("ЮрФизЛицо",ЮрФизЛицо);
	Если ЮрФизЛицо = "ЮрЛицо" Тогда
		оОбъект.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо"); 
		оОбъект.ЮрФизЛицо =  ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо"); 
	ИначеЕсли ЮрФизЛицо = "ФизЛицо" Тогда 
		оОбъект.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо"); 
		оОбъект.ЮрФизЛицо =  ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо"); 		
	ИначеЕсли ЮрФизЛицо = "ИндивидуальныйПредприниматель"  Тогда
		оОбъект.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо"); 
		оОбъект.ЮрФизЛицо =  ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель"); 		
	КонецЕсли;
	
	оОбъект.ОбменДанными.Загрузка	= Истина;
	//тчКонтактнаяИнформация = оОбъект.КонтактнаяИнформация;

	//Для сч = 1 - тчКонтактнаяИнформация.Количество() по 0 Цикл
	//	Если тчКонтактнаяИнформация[-сч].Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента Тогда 
	//		тчКонтактнаяИнформация.Удалить(- сч);
	//	КонецЕсли;
	//КонецЦикла;

	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(оОбъект, ЗначениеНомераТелефона, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента,'00010101', Истина,Ложь);			
	Пикс_Сервер.ОбработатьСтрокуКИТелефон(ЗначениеНомераТелефона,оОбъект.КонтактнаяИнформация[оОбъект.КонтактнаяИнформация.Количество()-1]);
	
	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(оОбъект, сОбъект.АдресЭП, Справочники.ВидыКонтактнойИнформации.EmailКонтрагента,'00010101', Истина,Ложь);			
	//КИ	= оОбъект.КонтактнаяИнформация;
	//сКИ	= КИ.Найти(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,"Тип");
	//Если сКИ = Неопределено Тогда
	//	сКИ 		= КИ.Добавить();
	//	сКИ.Тип		= Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	//	сКИ.Вид		= Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
	//КонецЕсли;
	//сКИ.Представление	= сОбъект.АдресЭП;
	//сКИ.Значение		= сОбъект.АдресЭП;
	//сКИ.АдресЭП        = сОбъект.АдресЭП;
	Если оОбъект.Партнер.Пустая() Тогда
		оОбъект.Партнер	= СоздатьПартнераПоКонрагенту(оОбъект);
	ИначеЕсли оОбъект.Наименование <> оОбъект.Партнер.Наименование Тогда 
		Попытка
		оПартнер = оОбъект.Партнер.ПолучитьОбъект();
		оПартнер.НаименованиеПолное	= оОбъект.НаименованиеПолное;
		оПартнер.Наименование		= оОбъект.НаименованиеПолное;
		оПартнер.Записать();
			
		Исключение
			
		КонецПопытки;
	КонецЕсли;

	оОбъект.Записать();



	оОтвет.IdDestination	= XMLСтрока(оОбъект.Ссылка.УникальныйИдентификатор());
	оОтвет.IdSource			= Сообщение.IdSource;
	оОтвет.MdDestination	= XMLСтрока(оОбъект.Метаданные().ПолноеИмя());;
	оОтвет.MdSource			= Сообщение.MdSource;
	оОтвет.Result			= "true";
	оОтвет.Object			= ВернутьПустуюСтруктуруXDTO();

КонецПроцедуры

Функция СоздатьПартнераПоКонрагенту(оКонтрагент)

	оПартнер= Справочники.Партнеры.СоздатьЭлемент();

	оПартнер.ГруппаДоступа		= Справочники.ГруппыДоступаПартнеров.ПолучитьСсылку(Новый УникальныйИдентификатор("b1efb695-255d-11e5-9756-002590a813d8")); //Группа доступа партнеров
	оПартнер.ДатаРегистрации	= ТекущаяДатаСеанса();
	оПартнер.Клиент				=Истина; //Булево
	оПартнер.Поставщик			=Истина; //Булево
	оПартнер.НаименованиеПолное	= оКонтрагент.НаименованиеПолное;
	оПартнер.Наименование		= оПартнер.НаименованиеПолное;
	оПартнер.ГруппаДоступа = Справочники.ГруппыДоступаПартнеров.ПолучитьСсылку(
			Новый УникальныйИдентификатор("b1efb695-255d-11e5-9756-002590a813d8"));

	Если оКонтрагент.ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда 
		оПартнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	Иначе
		оПартнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	КонецЕсли;
	
	КИ = оПартнер.КонтактнаяИнформация;
	Для Каждого сКи из оКонтрагент.КонтактнаяИнформация Цикл
		НоваяСтрокаКИ = Ки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаКИ,сКи);
		Если НоваяСтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента Тогда
			НоваяСтрокаКИ.Вид  = Справочники.ВидыКонтактнойИнформации.EmailПартнера;
		ИначеЕсли НоваяСтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента Тогда
			НоваяСтрокаКИ.Вид  = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
		Иначе
			КИ.Удалить(НоваяСтрокаКИ);
		КонецЕсли;
	КонецЦикла;
	оПартнер.Записать();
	Возврат оПартнер.Ссылка;

КонецФункции

Функция   ПолучитьКонтрагентаПоАдресуЭП(АдресЭП,Наименование = "") Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтрагентыКонтактнаяИнформация.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Представление = &АдресЭП
	|	И КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И КонтрагентыКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтрагента)");
	Запрос.УстановитьПараметр("АдресЭП",АдресЭП);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		Возврат Выборка.Ссылка.ПолучитьОбъект();

	Иначе

		Возврат Неопределено;

	КонецЕсли;

