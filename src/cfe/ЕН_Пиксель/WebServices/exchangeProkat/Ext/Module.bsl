Функция  ПреобразоватьВЧисло(Знач ЧислоСтрока, Ошибка = Ложь)
	Попытка
		_ЧислоСтрока = СтрЗаменить(ЧислоСтрока,",",".");
		ДопустимыеСимволыЧисла = "-0123456789.";
		СтрокаРезультат ="";
		Для НСимвола = 1 По СтрДлина(_ЧислоСтрока) Цикл
			Если СтрНайти(ДопустимыеСимволыЧисла,Сред(_ЧислоСтрока,НСимвола,1))> 0 Тогда
				СтрокаРезультат = СтрокаРезультат + Сред(_ЧислоСтрока,НСимвола,1);
			КонецЕсли;
		КонецЦикла;
		Результат = ?(СтрокаРезультат = "",0,Число(СтрокаРезультат));
	Исключение
		ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации(),УровеньЖурналаРегистрации.Ошибка,
		,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + "
		|Значение: "+ЧислоСтрока);
		Ошибка = Истина;
	КонецПопытки;
	Возврат Результат;
КонецФункции //ПреобразоватьВЧисло

Функция СтавкаНДС(Знач СтавкаНДС)
	
	СтавкаНДС = Врег(СтавкаНДС);
	Результат = Перечисления.СтавкиНДС.БезНДС;
	//Если СтавкаНДС = "БЕЗНДС" Тогда
	Если СтавкаНДС = "НДС20" Тогда
		Результат = Перечисления.СтавкиНДС.НДС20;
	ИначеЕсли СтавкаНДС = "НДС10_110" Тогда
		Результат = Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли СтавкаНДС = "НДС18" Тогда
		Результат = Перечисления.СтавкиНДС.НДС18;
	ИначеЕсли СтавкаНДС = "НДС10" Тогда
		Результат = Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли СтавкаНДС = "НДС0" Тогда
		Результат = Перечисления.СтавкиНДС.НДС0;
	ИначеЕсли СтавкаНДС = "НДС18_118" Тогда
		Результат = Перечисления.СтавкиНДС.НДС18_118;
	ИначеЕсли СтавкаНДС = "НДС20_120" Тогда
		Результат = Перечисления.СтавкиНДС.НДС20_120;
	ИначеЕсли СтавкаНДС = "НДС22" Тогда
		Результат = Перечисления.СтавкиНДС.НДС22;
	ИначеЕсли СтавкаНДС = "НДС22_122" Тогда
		Результат = Перечисления.СтавкиНДС.НДС22_122;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПолученСерийныйНомер(Сообщение,оОтвет)
	
	Ссылка = Справочники.СерииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Сообщение.IdSource));
	оСерияНоменклатуры = Ссылка.ПолучитьОбъект();
																					
																																  
																			  
																								  
					
	
	ЧтениеХМЛ = Новый ЧтениеXML;
	ЧтениеХМл.УстановитьСтроку(Сообщение.Object);
	сОбъект = СериализаторXDTO.ПрочитатьXML(ЧтениеХМЛ);
	
	НоменклатураВладелец = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(сОбъект.Владелец));
	ВидНоменклатуры = НоменклатураВладелец.ВидНоменклатуры;
	
	Если оСерияНоменклатуры = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СерииНоменклатуры.Ссылка КАК Ссылка,
		|	СерииНоменклатуры.Номер КАК Номер
		|ИЗ
		|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
		|ГДЕ
		|	СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
		|	И СерииНоменклатуры.Номер = &Номер";
		
		Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры);
		Запрос.УстановитьПараметр("Номер", сОбъект.Код);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Уид = Выборка.Ссылка.УникальныйИдентификатор();
		Иначе
			
			
			оСерияНоменклатуры = Справочники.СерииНоменклатуры.СоздатьЭлемент();
			оСерияНоменклатуры.ВидНоменклатуры = ВидНоменклатуры;
			оСерияНоменклатуры.УстановитьНовыйКод();
			оСерияНоменклатуры.УстановитьСсылкуНового(Ссылка);
			оСерияНоменклатуры.Наименование = сОбъект.Код;
			оСерияНоменклатуры.Номер = сОбъект.Код;
			
																																   
			оСерияНоменклатуры.Записать();		
			УИД = Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	
	
	оОтвет.IdDestination 	= XMLСтрока(Ссылка.УникальныйИдентификатор());
	оОтвет.IdSource			= Сообщение.IdSource;
	оОтвет.MdDestination    = XMLСтрока(оСерияНоменклатуры.Метаданные().ПолноеИмя());;
	оОтвет.MdSource		    = Сообщение.MdSource;
	оОтвет.Result			= "true";
	оОтвет.Object 			= ВернутьПустуюСтруктуруXDTO();
КонецПроцедуры

Процедура ПолученНоменклатура(Сообщение,оОтвет)

	НовыйОбъект 	= Ложь;
	ЧтениеХМЛ 		= Новый ЧтениеXML;
	ЧтениеХМл.УстановитьСтроку(Сообщение.Object);
	сОбъект 		= СериализаторXDTO.ПрочитатьXML(ЧтениеХМЛ);
	Ссылка 			= Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Сообщение.IdSource));
	оОбъект			= Ссылка.ПолучитьОбъект();
	Если оОбъект = Неопределено Тогда
		Если сОбъект.ЭтоГруппа Тогда
			оОбъект = Справочники.Номенклатура.СоздатьГруппу();
		Иначе

			оОбъект = Справочники.Номенклатура.СоздатьЭлемент();
		КонецЕсли;
		оОбъект.УстановитьСсылкуНового(Ссылка);
		НовыйОбъект = Истина;
	КонецЕсли;
	оОбъект.Родитель		= Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(сОбъект.УИДРодителя));
	оОбъект.Наименование	= сОбъект.Наименование;
	оОбъект.Код 			= сОбъект.Код;

	Если Не оОбъект.ЭтоГруппа Тогда
		оОбъект.НаименованиеПолное	= сОбъект.НаименованиеПолное;
		оОбъект.Артикул 			= сОбъект.Артикул;
		//		оОбъект.Комментарий			= сОбъект.Комментарий;
		оОбъект.ВидНоменклатуры		= Справочники.ВидыНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор("2e01c417-d8d1-11ef-b01a-00155d010b04"));
		оОбъект.СтавкаНДС			= УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(СкорректироватьСтавкуНДСПоДате( СтавкаНДС(сОбъект.СтавкаНДС),ТекущаяДата()));

	КонецЕсли;
	оОбъект.ОбменДанными.Загрузка 	= Истина;
	оОбъект.Записать();
	Если НовыйОбъект = Истина и оОбъект.ЭтоГруппа = Ложь Тогда
		оОбъект.ВариантОформленияПродажи= Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг; //Варианты оформления продажи
		оОбъект.ВестиУчетПоГТД			= Истина; //Булево
		оОбъект.ЕдиницаИзмерения				= Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор("dcc5aed5-450e-11de-8d2f-00e04d823046")); //Упаковка
		оОбъект.ЕдиницаДляОтчетов 				= оОбъект.ЕдиницаИзмерения;
		оОбъект.ИспользоватьУпаковки			= Истина; //Булево
		оОбъект.Качество						= Перечисления.ГрадацииКачества.Новый; //Градации качества
		оОбъект.ТипНоменклатуры					= Перечисления.ТипыНоменклатуры.Товар; //Типы номенклатуры
		оОбъект.КоэффициентЕдиницыДляОтчетов	= 1;
		оОбъект.ОсобенностьУчета				= Перечисления.ОсобенностиУчетаНоменклатуры.БезОсобенностейУчета;
		оОбъект.Записать();
	КонецЕсли;
	оОтвет.IdDestination	= XMLСтрока(Ссылка.УникальныйИдентификатор());
	оОтвет.IdSource			= Сообщение.IdSource;
	оОтвет.MdDestination	= XMLСтрока(оОбъект.Метаданные().ПолноеИмя());;
	оОтвет.MdSource			= Сообщение.MdSource;
	оОтвет.Result			= "true";
	оОтвет.Object 			= ВернутьПустуюСтруктуруXDTO();

КонецПроцедуры

Процедура ПолученКонтрагент(Сообщение,оОтвет)
	ЭтоНовый	= Ложь;
	ЧтениеХМЛ	= Новый ЧтениеXML;
	ЧтениеХМл.УстановитьСтроку(Сообщение.Object);
	сОбъект		= СериализаторXDTO.ПрочитатьXML(ЧтениеХМЛ);
	Ссылка		= Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Сообщение.IdSource));
	оОбъект		= Ссылка.ПолучитьОбъект();
	НомерТелефона = сОбъект.НомерТелефона;
	ЗначениеНомераТелефона = "";
	Цифры = "0123456789";
	Для сч = 1 по СтрДлина(НомерТелефона) Цикл
		Если СтрНайти(Цифры,Сред(НомерТелефона,сч,1)) > 0 Тогда 
			ЗначениеНомераТелефона = ЗначениеНомераТелефона + Сред(НомерТелефона,сч,1);
		КонецЕсли;
	КонецЦикла;
	
		
	
	Если оОбъект = Неопределено и Сообщение.MdDestination = "Справочник.Контрагенты" Тогда	// поиск контрагента по адресу ЭП
		оОбъект		= ПолучитьКонтрагентаПоАдресуЭП(сОбъект.АдресЭП);
	КонецЕсли;

	Если оОбъект	= Неопределено Тогда
		ЭтоНовый	= Истина;
		оОбъект		= Справочники.Контрагенты.СоздатьЭлемент();
		оОбъект.УстановитьСсылкуНового(Ссылка);
	КонецЕсли;


