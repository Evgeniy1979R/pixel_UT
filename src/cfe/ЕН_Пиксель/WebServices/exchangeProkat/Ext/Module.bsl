	Исключение
		ЗаписьЖурналаРегистрации(ПрефиксЖурналаРегистрации()+".ЗапросСостоянияДокументов",УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		оОтвет.Result			= "false";
	КонецПопытки;
	
	
КонецПроцедуры

Функция ПолучитьМенеджерОбъектаПоТипу(СсылкаНаОбъект)

	ТипИсточника =  СсылкаНаОбъект;//
	Если НАйти(ТипИсточника,"Документ.") Тогда
		ИмяМенеджера = "Документы";
		ИмяОбъекта = СтрЗаменить(ТипИсточника,"Документ.","");
