	ИначеЕсли ТипСтрока = "РеализацияТоваровУслуг"  Тогда
		Возврат "РеализацияТоваровУслуг";
	ИначеЕсли ТипСтрока = "ВозвратТоваровОтПокупателя"  Тогда
		Возврат "ВозвратТоваровОтПокупателя";
	ИначеЕсли ТипСтрока = "РеализацияТоваровУслуг"  Тогда
