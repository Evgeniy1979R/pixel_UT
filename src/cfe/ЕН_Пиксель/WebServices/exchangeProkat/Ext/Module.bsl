	оОбъект.Дата					= сОбъект.Дата;
	оОбъект.Номер					= сОбъект.Номер;
	оОбъект.Организация 			= Справочники.Организации.НайтиПоРеквизиту("ИНН",сОбъект.ОрганизацияКод);
	оОбъект.Касса					= Справочники.Кассы.ПолучитьСсылку(Новый УникальныйИдентификатор("bf66b169-028e-11f1-bc00-6c92bfa4d953")); // // Справочники.Кассы.НайтиПоНаименованию("Касса ЗАЛОГ"); // ()
	оОбъект.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
	оОбъект.Валюта 					= Константы.ВалютаРегламентированногоУчета.Получить();
	оОбъект.Комментарий 			= сОбъект.Комментарий;
	оОбъект.Автор					= Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор("b8537ff4-fa58-11ef-b01a-00155d010b04"));
	оОбъект.Подразделение			= Справочники.СтруктураПредприятия.ПолучитьСсылку(Новый УникальныйИдентификатор("d8521d4c-123e-11f1-bc03-6c92bfa4d953"));
	оОбъект.Контрагент				= Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(сОбъект.УИДКонтрагент));
	оОбъект.Договор					= ПолучитьСоздатьДоговор(оОбъект.Организация,оОбъект.Контрагент,Перечисления.ТипыДоговоров.СПокупателем);
	оОбъект.Партнер					= оОбъект.Контрагент.Партнер;
	оОбъект.СуммаДокумента 			= сОбъект.СуммаДокумента;
	оОбъект.НалогообложениеНДС		= Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	
	Если Не сОбъект.ОснованиеМетаданные = "" и Не сОбъект.ОснованиеУИД = ""  Тогда

		оОбъект.ДокументОснование = Документы[ПолучитьМенеджерОбъектаПоТипу(сОбъект.ОснованиеМетаданные).ИмяОбъекта].ПолучитьСсылку(Новый УникальныйИдентификатор (сОбъект.ОснованиеУИД));

	КонецЕсли;

	ТабличнаяЧасть = оОбъект.РасшифровкаПлатежа;
	ТабличнаяЧасть.Очистить();
	НоваяСтрока 								= ТабличнаяЧасть.Добавить();
	НоваяСтрока.Партнер							= оОбъект.Партнер;
	НоваяСтрока.СтатьяДвиженияДенежныхСредств	= Справочники.СтатьиДвиженияДенежныхСредств.ПолучитьСсылку(Новый УникальныйИдентификатор("1c5597e9-0014-11f0-b01a-00155d010b04"));  // // Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Залог за прокат"); // (00-000001)
	НоваяСтрока.Сумма							= оОбъект.СуммаДокумента;
	НоваяСтрока.СтатьяРасходов					= ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию("Залог за прокат");  // // Залог за прокат (00-000003)
	НоваяСтрока.АналитикаРасходов				= Справочники.СтруктураПредприятия.ПолучитьСсылку(Новый УникальныйИдентификатор("ae419e23-d72a-11ef-b477-00155d010b04"));  // // Справочники.СтруктураПредприятия.НайтиПоНаименованию("Основное"); // (00-000001)
	НоваяСтрока.ВалютаВзаиморасчетов			= оОбъект.Валюта;
	НоваяСтрока.СуммаВзаиморасчетов				= оОбъект.СуммаДокумента;
	НоваяСтрока.СтавкаНДС						= Справочники.СтавкиНДС.БезНДС;
	НоваяСтрока.КурсЧислительВзаиморасчетов		= 1;
	НоваяСтрока.КурсЗнаменательВзаиморасчетов	= 1;
	НоваяСтрока.Организация						= оОбъект.Организация;

	Ошибка = "true";
	ПроверитьДокументПоДатеНачалаУчета(оОбъект);
	Попытка
		оОбъект.Записать();
	Исключение
		Ошибка = "Ошибка при записи документа. "+ОписаниеОшибки();
	КонецПопытки;

	оОтвет.IdDestination 	= XMLСтрока(Ссылка.УникальныйИдентификатор());
	оОтвет.IdSource			= Сообщение.IdSource;
	оОтвет.MdDestination    = XMLСтрока(оОбъект.Метаданные().ПолноеИмя());;
	оОтвет.MdSource		    = Сообщение.MdSource;
	оОтвет.Result			= Ошибка;
	оОтвет.Object 			= ВернутьПустуюСтруктуруXDTO();

КонецПроцедуры

Процедура ПолученРеализацияТоваровУслуг(Сообщение,оОтвет)

	ЧтениеХМЛ	= Новый ЧтениеXML;
	ЧтениеХМл.УстановитьСтроку(Сообщение.Object);
	сОбъект		= СериализаторXDTO.ПрочитатьXML(ЧтениеХМЛ);
	Ссылка		= Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Сообщение.IdSource));
	оОбъект		= Ссылка.ПолучитьОбъект();
	Если оОбъект = Неопределено Тогда
		оОбъект	= Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		оОбъект.УстановитьСсылкуНового(Ссылка);
		оОбъект.Дата = сОбъект.Дата; // 20211116 дату устанавливаем один раз, в дальнейшем дата может в ут поменяться и она уже будет верной.
		оОбъект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыРеализацийТоваровУслуг.Отгружено");
	КонецЕсли;
	//оОбъект.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров[сОбъект.ВидОперации];
	оОбъект.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	оОбъект.Комментарий				= сОбъект.Комментарий;

	оОбъект.Организация				= Справочники.Организации.НайтиПоРеквизиту("ИНН",сОбъект.ОрганизацияКод);
	Если Не ЗначениеЗаполнено(оОбъект.Номер) Тогда 
	//оОбъект.Номер					= сОбъект.Номер;
	оОбъект.УстановитьНовыйНомер();
	КонецЕсли;
	оОбъект.Менеджер				= Справочники.Пользователи.НайтиПоНаименованию("obmenprokat");
	оОбъект.СуммаДокумента			= сОбъект.СуммаДокумента;
	Если Не СокрЛП(сОбъект.УИДКонтрагент) = "" Тогда
		оОбъект.Контрагент				= Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(сОбъект.УИДКонтрагент));
		оОбъект.Договор					= ПолучитьСоздатьДоговор(оОбъект.Организация,оОбъект.Контрагент,Перечисления.ТипыДоговоров.СПокупателем);
		оОбъект.Соглашение				= ПолучитьТиповоеСоглашениеФизЛица();
		оОбъект.Партнер = оОбъект.Контрагент.Партнер;
	КонецЕсли;
	оОбъект.Валюта					= Константы.ВалютаРегламентированногоУчета.Получить();
	оОбъект.ВалютаВзаиморасчетов	= Константы.ВалютаРегламентированногоУчета.Получить();
	оОбъект.НалогообложениеНДС		= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	оОбъект.ЦенаВключаетНДС			= Истина;
	оОбъект.КурсЧислитель			= 1;
	оОбъект.КурсЗнаменатель			= 1;
	оОбъект.Склад 					= Справочники.Склады.НайтиПоНаименованию("Основной склад");
	оОбъект.СпособДоставки			= Перечисления.СпособыДоставки.Самовывоз;
	оОбъект.СкидкиРассчитаны		= Истина;
	оОбъект.Согласован				= Истина;
	оОбъект.Подразделение           = Справочники.СтруктураПредприятия.НайтиПоКоду("00-000001"); // прокат
	Если сОбъект.Свойство("Услуги") = Истина Тогда
		Услуги = оОбъект.Товары;
		Услуги.Очистить();
		Для Каждого Элемент из сОбъект.Услуги Цикл
			сУслуги 					= Услуги.Добавить();
			сУслуги.Количество			= Элемент.Количество;
			сУслуги.КоличествоУпаковок	= Элемент.Количество;
			сУслуги.Номенклатура		= Справочники.Номенклатура.НайтиПоКоду(Элемент.НоменклатураКод);
			//сУслуги.Содержание	 = сУслуги.Номенклатура.НаименованиеПолное;
			сУслуги.СтавкаНДС			= УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(СкорректироватьСтавкуНДСПоДате(сУслуги.Номенклатура.СтавкаНДС,оОбъект.Дата));
			
			сУслуги.Сумма				= Элемент.Сумма;
			сУслуги.СуммаНДС			= Элемент.СуммаНДС;
			сУслуги.СуммаСНДС			= Элемент.Сумма;
			сУслуги.Цена				= Элемент.Цена;
			сУслуги.Склад				= оОбъект.Склад;
		КонецЦикла;
	КонецЕсли;

	Ошибка = "true";
	ПроверитьДокументПоДатеНачалаУчета(оОбъект);	
	Попытка
		оОбъект.Записать();
	Исключение
		Ошибка = "Ошибка при записи документа. "+ОписаниеОшибки();
	КонецПопытки;
	Если Ошибка = "true" Тогда

		Попытка
			Если оОбъект.Проведен = Истина Тогда
				оОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;

			оОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Ошибка = "Ошибка при проведении документа.";
		КонецПопытки;
	КонецЕсли;


	оОтвет.IdDestination 	= XMLСтрока(Ссылка.УникальныйИдентификатор());
	оОтвет.IdSource			= Сообщение.IdSource;
	оОтвет.MdDestination    = XMLСтрока(оОбъект.Метаданные().ПолноеИмя());;
	оОтвет.MdSource		    = Сообщение.MdSource;
	оОтвет.Result			= Ошибка;
	оОтвет.Object 			= ВернутьПустуюСтруктуруXDTO();


КонецПроцедуры

Процедура ПолученУправленческаяРеализацияТоваровУслуг(Сообщение,оОтвет)


	//оОтвет.IdDestination 	= XMLСтрока(Новый УникальныйИдентификатор());
	//оОтвет.IdSource			= Сообщение.IdSource;
	//оОтвет.MdDestination    = XMLСтрока(Метаданные.Документы.РеализацияТоваровУслуг.ПолноеИмя());;
	//оОтвет.MdSource		    = Сообщение.MdSource;
	//оОтвет.Result			= "В УТ 11 не поддерживается";
	//оОтвет.Object 			= ВернутьПустуюСтруктуруXDTO();
	//Возврат;

	// особенность этой реализации в том, что при получении она не должна искаться по уид источнка, у нее собственный уид
	ЧтениеХМЛ = Новый ЧтениеXML;
	ЧтениеХМл.УстановитьСтроку(Сообщение.Object);
	сОбъект = СериализаторXDTO.ПрочитатьXML(ЧтениеХМЛ);
	Ссылка = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Сообщение.IdDestination));
	оОбъект= Ссылка.ПолучитьОбъект();
	Если оОбъект = Неопределено Тогда
		оОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		оОбъект.УстановитьСсылкуНового(Ссылка);
		оОбъект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыРеализацийТоваровУслуг.Отгружено");
	КонецЕсли;
	//оОбъект.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров[сОбъект.ВидОперации];
	оОбъект.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	оОбъект.Дата 		= сОбъект.Дата;
	оОбъект.Комментарий = сОбъект.Комментарий;
	оОбъект.Номер		= сОбъект.Номер;
	
	оОбъект.Организация = Справочники.Организации.НайтиПоНаименованию("Прокат",Истина);
	оОбъект.Менеджер				= Справочники.Пользователи.НайтиПоНаименованию("obmenprokat");
	оОбъект.Склад 			= Справочники.Склады.НайтиПоКоду(сОбъект.СкладКод);
	оОбъект.СуммаДокумента  = сОбъект.СуммаДокумента;
	Если Не СокрЛП(сОбъект.УИДКонтрагент) = "" Тогда
		оОбъект.Контрагент				= Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(сОбъект.УИДКонтрагент));
		оОбъект.Договор					= ПолучитьСоздатьДоговор(оОбъект.Организация,оОбъект.Контрагент,Перечисления.ТипыДоговоров.СПокупателем);
		оОбъект.Соглашение				= ПолучитьТиповоеСоглашение_ЮрЛицаИФизЛицаСДоговорами();
		оОбъект.Партнер = оОбъект.Контрагент.Партнер;
	КонецЕсли;
	оОбъект.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	оОбъект.ПорядокРасчетов 		 = оОбъект.Договор.ПорядокРасчетов;
	оОбъект.Валюта					= Константы.ВалютаРегламентированногоУчета.Получить();
	оОбъект.ВалютаВзаиморасчетов	= Константы.ВалютаРегламентированногоУчета.Получить();
	оОбъект.НалогообложениеНДС		= Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	оОбъект.ЦенаВключаетНДС			= Истина;
	оОбъект.КурсЧислитель			= 1;
	оОбъект.КурсЗнаменатель			= 1;
	оОбъект.Склад 					= Справочники.Склады.НайтиПоНаименованию("ПРОКАТ");
	оОбъект.СпособДоставки			= Перечисления.СпособыДоставки.Самовывоз;
	оОбъект.СкидкиРассчитаны		= Истина;
	оОбъект.Согласован				= Истина;
	тТовары = оОбъект.Товары;
	тТовары.Очистить();
	тСерии = оОбъект.Серии;
	тСерии.Очистить();
	Для Каждого Элемент из сОбъект.Товары Цикл
		сТовары = тТовары.Добавить();
		сТовары.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Элемент.НоменклатураУид));
		сТовары.Количество   = Элемент.Количество;
		сТовары.КоличествоУпаковок   = Элемент.Количество;
		
		
		
		сТовары.Цена = Элемент.Цена;
		сТовары.Сумма = Элемент.Сумма;
		сТовары.СтавкаНДС = УчетНДСРФВызовСервера.СтавкаНДСПоЗначениюПеречисления(СкорректироватьСтавкуНДСПоДате(СтавкаНДС(Элемент.СтавкаНДС),оОбъект.Дата));
		сТовары.СуммаНДС  = Элемент.СуммаНДС;
		сТовары.СуммаСНДС			= Элемент.Сумма;
		сТовары.Склад = оОбъект.Склад;
		
		Если ПустаяСтрока(элемент.СерияНоменклатуры) = Ложь Тогда 
			сСерия = тСерии.Добавить();
			сСерия.Серия = Справочники.СерииНоменклатуры.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Элемент.СерияНоменклатуры));
			сСерия.Количество = сТовары.Количество;
			сСерия.Номенклатура = сТовары.Номенклатура;
			сСерия.Склад 		= оОбъект.Склад;
		КонецЕсли;
	//	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", сТовары.Склад, ПараметрыУказанияСерий));
	//	ПакетнаяОбработкаТабличнойЧастиКлиентСерверЛокализация.ДополнитьСтруктуруДействийПриИзмененииЭлемента(ЭтотОбъект, "Номенклатура", СтруктураДействий);		
	КонецЦикла;
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(оОбъект, Документы.РеализацияТоваровУслуг));
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(оОбъект, ПараметрыУказанияСерий);
	Ошибка = "true";
	СтароеЗначение = ПараметрыСеанса.ПроводитьБезКонтроляОстатковТоваровОрганизаций ;
	ПараметрыСеанса.ПроводитьБезКонтроляОстатковТоваровОрганизаций = Истина;
	ПроверитьДокументПоДатеНачалаУчета(оОбъект);	
	Попытка
		оОбъект.Записать();
		оОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Ошибка = "Ошибка при записи документа. "+ОписаниеОшибки();
	КонецПопытки;
	
	ПараметрыСеанса.ПроводитьБезКонтроляОстатковТоваровОрганизаций = СтароеЗначение;

	оОтвет.IdDestination 	= XMLСтрока(Ссылка.УникальныйИдентификатор());
	оОтвет.IdSource			= Сообщение.IdSource;
	оОтвет.MdDestination    = XMLСтрока(оОбъект.Метаданные().ПолноеИмя());;
	оОтвет.MdSource		    = Сообщение.MdSource;
	оОтвет.Result			= Ошибка;
	оОтвет.Object 			= ВернутьПустуюСтруктуруXDTO();


КонецПроцедуры

