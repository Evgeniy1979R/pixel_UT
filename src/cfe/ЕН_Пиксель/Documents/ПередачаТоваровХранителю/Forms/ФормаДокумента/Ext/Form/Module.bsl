
&НаСервере
Процедура Пикс_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
		
	мДобавляемыеРеквизиты = Новый Массив;	
	Реквизит = Новый РеквизитФормы("РазрешитьДобавлениеТоваровСканером",Новый ОписаниеТипов("Булево"));
	мДобавляемыеРеквизиты.Добавить(Реквизит);
	Реквизит = Новый РеквизитФормы("ПИКС_РежимПроверки",Новый ОписаниеТипов("Булево"));
	мДобавляемыеРеквизиты.Добавить(Реквизит);
	Реквизит = Новый РеквизитФормы("Пикс_ЕстьРасхождение",Новый ОписаниеТипов("Булево"),"Объект.Товары");
	мДобавляемыеРеквизиты.Добавить(Реквизит);
	ИзменитьРеквизиты(мДобавляемыеРеквизиты);
	ЭлементРазрешитьДобавлениеТоваровСканером = Элементы.Добавить("ЭлементРазрешитьДобавлениеТоваровСканером",Тип("ПолеФормы"),Элементы.ГруппаПараметрыПраво);
	ЭлементРазрешитьДобавлениеТоваровСканером.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементРазрешитьДобавлениеТоваровСканером.ПутьКДанным = "РазрешитьДобавлениеТоваровСканером";
	
	ЕН_ДФИ.СздКолонкаТаблицыФормы(ЭтаФорма,"ЕН_ТоварыКоличествоОтсканировано",Элементы.Товары,0,"Отсканировано","Объект.Товары.Пикс_КоличествОтсканировано",,,Новый Структура("ТолькоПросмотр",Истина));	
	сСвойстваКнопки = Новый Структура("Картинка,Отображение",БиблиотекаКартинок.Пикс_СтрелкаВправоСиняя,ОтображениеКнопки.Картинка);
	
	ЕН_ДФИ.СоздатьКоманду(ЭтаФорма,"РежимПроверкиНажатие",,"ПиксКнопкаРежимПроверки");
	сСвойстваКнопки = Новый Структура("Картинка,Отображение",БиблиотекаКартинок.Пикс_ЕстьРасхождения,ОтображениеКнопки.Картинка);
	ЕН_ДФИ.СздКнопка(ЭтаФорма,"ПиксКнопкаРежимПроверки",Элементы.ТоварыКоманднаяПанель,"Режим проверки","РежимПроверкиНажатие",1,сСвойстваКнопки,Элементы.ГруппаТорговоеОборудование);
	ЕН_ДФИ.СздПолеФлажок(ЭтаФорма,"ФлажокПикс_ЗапретитьПроведениеБезПроверки","ГруппаПараметрыПраво",,1,"Объект.Пикс_ЗапретитьПроведениеБезПроверки");
	Объект["Пикс_ЗапретитьПроведениеБезПроверки"] = Не Объект.Проведен;
	Пикс_ЗаполнитьСлужебныеРеквизиты();

КонецПроцедуры

&НаСервере
Процедура Пикс_ЗаполнитьСлужебныеРеквизиты()

	Для каждого сТовары из Объект.Товары Цикл
		
		Если Не сТовары.КоличествоУпаковок = сТовары.Пикс_КоличествОтсканировано Тогда 
			
			сТовары["Пикс_ЕстьРасхождение"] = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПиксКнопкаРежимПроверки(Команда)
	
	ЭтаФорма["ПИКС_РежимПроверки"] = Не ЭтаФорма["ПИКС_РежимПроверки"];
	Элементы["ПиксКнопкаРежимПроверки"].Пометка = ЭтаФорма["ПИКС_РежимПроверки"];
	Пикс_УстановитьОтборСобранныхПозиций();
	
КонецПроцедуры

&НаСервере
Процедура Пикс_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	
	Пикс_ЗаполнитьСлужебныеРеквизиты();
	
КонецПроцедуры

&НаКлиенте
Процедура Пикс_УстановитьОтборСобранныхПозиций()
	
	Если ЭтаФорма["ПИКС_РежимПроверки"] = Истина Тогда
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Пикс_ЕстьРасхождение", Истина);
		
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура(ПараметрыОтбора);

	
	Иначе
		
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте                                                                         
Процедура УвеличитьПроверенноеКоличество(Штрихкод)
	ПараметрыОбработкиШтрихкодов = ШтрихкодированиеНоменклатурыКлиентСервер.ПараметрыОбработкиШтрихкодов();
	ПараметрыОбработкиШтрихкодов.Штрихкоды = Новый Структура("Штрихкод", Штрихкод);
	Номенклатура = НоменклатураПоШтрихкоду(ПараметрыОбработкиШтрихкодов,Неопределено);
	Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Или Номенклатура.Пустая() Тогда
		ПоказатьПредупреждение(,СтрШаблон("Не найдена номенклатура с штрихкодом %1", Штрихкод));
		Возврат;
	КонецЕсли;
	НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура",Номенклатура));
	Если НайденныеСтроки.Количество() = 0 Тогда
		ПоказатьПредупреждение(,СтрШаблон("Номенклатура %1 не найдена в документе",Номенклатура));
		Возврат;
	КонецЕсли;
	Добавлено= Ложь;
	
	Для Каждого сТовары из НайденныеСтроки Цикл
		Если сТовары.Пикс_КоличествОтсканировано  < сТовары.КоличествоУпаковок Тогда 
			сТовары.Пикс_КоличествОтсканировано = сТовары.Пикс_КоличествОтсканировано + 1;
			Если сТовары.КоличествоУпаковок = сТовары.Пикс_КоличествОтсканировано Тогда 
				сТовары["Пикс_ЕстьРасхождение"] = Ложь;
			Иначе
				сТовары["Пикс_ЕстьРасхождение"] = Истина;
			КонецЕсли;
			Добавлено = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	Если Добавлено = Ложь Тогда 
		сТовары = НайденныеСтроки[0];
		сТовары.Пикс_КоличествОтсканировано = НайденныеСтроки[0].Пикс_КоличествОтсканировано + 1;
		Если сТовары.КоличествоУпаковок = сТовары.Пикс_КоличествОтсканировано Тогда 
			сТовары["Пикс_ЕстьРасхождение"] = Ложь;
		Иначе
			сТовары["Пикс_ЕстьРасхождение"] = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НоменклатураПоШтрихкоду(ПараметрыОбработки, КэшированныеЗначения = Неопределено)
	
	Возврат ШтрихкодированиеНоменклатурыСервер.НоменклатураПоШтрихкоду(ПараметрыОбработки, КэшированныеЗначения);
	
КонецФункции

&НаКлиенте
Процедура ПИКС_РежимПроверки_ДобавитьПроверенноеКоличество(ДанныеШтрихкодов)
	// в данных штрихкодов может содежраться массив или структура.
	Если ТипЗнч(ДанныеШтрихкодов) =Тип("Массив") Тогда
		
		Для каждого эл из ДанныеШтрихкодов Цикл
			
			УвеличитьПроверенноеКоличество(эл.Штрихкод);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДанныеШтрихкодов) =Тип("Структура") Тогда
		
		УвеличитьПроверенноеКоличество(ДанныеШтрихкодов.Штрихкод);
		
	Иначе
		ВызватьИсключение(СтрШаблон("Не предусмотренный тип данных %1", ТипЗнч(ДанныеШтрихкодов)));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("ОбработатьШтрихкоды")
Процедура Пикс_ОбработатьШтрихкоды(ДанныеШтрихкодов)


	ОчиститьСообщения();

	Если Не ШтрихкодированиеНоменклатурыКлиент.ШтрихкодыВалидны(ДанныеШтрихкодов) Тогда
		Возврат;
	КонецЕсли;

	#Вставка
	Если ЭтаФорма["ПИКС_РежимПроверки"] = Истина Тогда
		
		ПИКС_РежимПроверки_ДобавитьПроверенноеКоличество(ДанныеШтрихкодов);
		Возврат;
		
	ИначеЕсли ЭтаФорма["РазрешитьДобавлениеТоваровСканером"] = Ложь Тогда
		Если ТипЗнч(ДанныеШтрихкодов) = Тип("Массив") Тогда
			Для Каждого эл из ДанныеШтрихкодов Цикл
				эл.Количество = 0;
			КонецЦикла;
		Иначе
			//	ДанныеШтрихкодов.Вставить("Количество",0);
		КонецЕсли;
	КонецЕсли;
	#КонецВставки	

	ЗаполнитьПризнакАртикул         = Новый Структура("Номенклатура", "Артикул");
	ЗаполнитьПризнакТипНоменклатуры = Новый Структура("Номенклатура", "ТипНоменклатуры");

	ПроверитьЗаполнитьСклад = ПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСкладаВСтрокеТЧ(Объект,
	СкладГруппа);

	СтруктураДействийСДобавленнымиСтроками = Новый Структура;
	СтруктураДействийСДобавленнымиСтроками.Вставить("ЗаполнитьПризнакАртикул",         ЗаполнитьПризнакАртикул);
	СтруктураДействийСДобавленнымиСтроками.Вставить("ЗаполнитьПризнакТипНоменклатуры", ЗаполнитьПризнакТипНоменклатуры);

	СтруктураДействийСДобавленнымиСтроками.Вставить("ЗаполнитьПризнакБезВозвратнойТары",
	Объект.ВернутьМногооборотнуюТару);

	СтруктураДействийСДобавленнымиСтроками.Вставить("ПроверитьЗаполнитьСклад", ПроверитьЗаполнитьСклад);

	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействийСДобавленнымиСтроками, Объект);
	ДобавитьВСтруктуруДействияЗаполненияЦен(СтруктураДействийСДобавленнымиСтроками, Объект,
	ИспользоватьСоглашенияСКлиентами, ИспользуетсяЦенообразование25, ДоговорПоНовойКомиссии);
	НаправленияДеятельностиКлиентСервер.СтруктураДействийВставитьПриДобавленииСтроки(ЭтотОбъект,
	СтруктураДействийСДобавленнымиСтроками);
	ПакетнаяОбработкаТабличнойЧастиКлиентСерверЛокализация.ДополнитьСтруктуруДействийПриИзмененииЭлемента(
	ЭтотОбъект, "Номенклатура", СтруктураДействийСДобавленнымиСтроками);

	СтруктураДействийСИзмененнымиСтроками = Новый Структура;
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействийСИзмененнымиСтроками, Объект);

	СтруктураДействий = ШтрихкодированиеНоменклатурыКлиент.ПараметрыОбработкиШтрихкодов();
	СтруктураДействий.Штрихкоды                              = ДанныеШтрихкодов;
	СтруктураДействий.СтруктураДействийСДобавленнымиСтроками = СтруктураДействийСДобавленнымиСтроками;
	СтруктураДействий.СтруктураДействийСИзмененнымиСтроками  = СтруктураДействийСИзмененнымиСтроками;

	#Вставка
	Если ЭтаФорма["РазрешитьДобавлениеТоваровСканером"] = Ложь Тогда
		СтруктураДействий.СтруктураДействийСИзмененнымиСтроками  = Новый Структура;
	КонецЕсли;
	#КонецВставки
	
	СтруктураДействий.ПараметрыУказанияСерий                 = ПараметрыУказанияСерий;
	СтруктураДействий.ТолькоТовары                           = Истина;
	СтруктураДействий.РассчитыватьНаборы                     = Истина;
	СтруктураДействий.ДобавлятьТолькоТоварСверхЗаказа        = Истина;

	#Вставка
	Если ЭтаФорма["РазрешитьДобавлениеТоваровСканером"] = Ложь Тогда
	СтруктураДействий.ДобавлятьТолькоТоварСверхЗаказа        = Ложь;
	КонецЕсли;
	#КонецВставки
	
	ОбработатьШтрихкодыСервер(СтруктураДействий, КэшированныеЗначения);

	ШтрихкодированиеНоменклатурыКлиент.ОбработатьНеизвестныеШтрихкоды(СтруктураДействий, КэшированныеЗначения, ЭтотОбъект);

	ОткрытьФормуУказанияСерий = ШтрихкодированиеНоменклатурыКлиент.НужноОткрытьФормуУказанияСерийПослеОбработкиШтрихкодов(
	СтруктураДействий);

	Если ОткрытьФормуУказанияСерий Тогда
		ТекущиеДанныеИдентификатор = СтруктураДействий.МассивСтрокССериями[0];

		ПодключитьОбработчикОжидания("ОткрытьПодборСерийПриСканированииШтрихкодаНоменклатуры", 0.1, Истина);
	КонецЕсли;
	
	#Вставка
	Если ЭтаФорма["РазрешитьДобавлениеТоваровСканером"] = Ложь 
		И СтруктураДействий.МассивСтрокССериями.Количество() > 1
		И НоменклатураКлиентСервер.НеобходимоРегистрироватьСерии(
		СтруктураДействий.ПараметрыУказанияСерий) Тогда
		ТекущиеДанныеИдентификатор = СтруктураДействий.МассивСтрокССериями[0];
		ПодключитьОбработчикОжидания("ОткрытьПодборСерийПриСканированииШтрихкодаНоменклатуры",0.1,Истина);
	КонецЕсли;		
	#КонецВставки
	
	РассчитатьИтоговыеПоказатели(ЭтотОбъект);

	Если СтруктураДействий.ТекущаяСтрока <> Неопределено Тогда
		Элементы.Товары.ТекущаяСтрока = СтруктураДействий.ТекущаяСтрока;
	КонецЕсли;

КонецПроцедуры
