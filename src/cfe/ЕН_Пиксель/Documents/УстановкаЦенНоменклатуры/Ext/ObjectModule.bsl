
&После("ОбработкаПроведения")
Процедура Пикс_ОбработкаПроведения(Отказ, РежимПроведения)

	ЗарегистрироватьИзмененияНоменклатуры(Отказ);

КонецПроцедуры

&После("ОбработкаУдаленияПроведения")
Процедура Пикс_ОбработкаУдаленияПроведения(Отказ)

	ЗарегистрироватьИзмененияНоменклатуры(Отказ);

КонецПроцедуры

Процедура ЗарегистрироватьИзмененияНоменклатуры(Отказ)

	Если Дата >= '20260209'  Тогда 
		Если Отказ = Ложь Тогда 
			мНоменклатура = Новый Массив;
			Для Каждого эл из Товары Цикл
				мНоменклатура.Добавить(эл.Номенклатура);
			КонецЦикла;
			Для Каждого эл из Товары2_5 Цикл
				мНоменклатура.Добавить(эл.Номенклатура);
			КонецЦикла;
			мНоменклатура = ОбщегоНазначенияУТ.УдалитьПовторяющиесяЭлементыМассива(мНоменклатура);
			Для Каждого эл из мНоменклатура Цикл 
				нз = РегистрыСведений.ЕН_ИзмененнаяНоменклатура.СоздатьНаборЗаписей();
				нз.Отбор.Номенклатура.Использование = Истина;
				нз.Отбор.Номенклатура.Значение		= эл;
				Запись = нз.Добавить();
				Запись.Номенклатура = эл;
				нз.Записать(Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры