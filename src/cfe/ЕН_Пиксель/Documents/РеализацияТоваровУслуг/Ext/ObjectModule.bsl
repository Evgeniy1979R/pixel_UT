
&После("ПриЗаписи")
Процедура Пикс_ПриЗаписи(Отказ)
	Если Проведен = Истина и ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") и ЗаказКлиента.Пустая() = Ложь Тогда 
		оДокументЗаказ = ЗаказКлиента.ПолучитьОбъект();
		ДополнительныеРеквизитыЗаказа = оДокументЗаказ.ДополнительныеРеквизиты;
		сДополнительныеРеквизитыЗаказа = ДополнительныеРеквизитыЗаказа.Найти(Пикс_Сервер.Свойство_ЗаказНомерНаСайте(),"Свойство");
		Если сДополнительныеРеквизитыЗаказа <> Неопределено и сДополнительныеРеквизитыЗаказа.Значение <> "" Тогда 
			сДополнительныеРеквизитыЗаказа = ДополнительныеРеквизитыЗаказа.Найти(Пикс_Сервер.Свойство_ЗаказОтгружен(),"Свойство");
			Если сДополнительныеРеквизитыЗаказа = Неопределено Тогда 
				сДополнительныеРеквизитыЗаказа = ДополнительныеРеквизитыЗаказа.Добавить();
				сДополнительныеРеквизитыЗаказа.Свойство = Пикс_Сервер.Свойство_ЗаказОтгружен();
			КонецЕсли;
			Если сДополнительныеРеквизитыЗаказа.Значение <> Истина Тогда 
				сДополнительныеРеквизитыЗаказа.Значение = Истина;
				оДокументЗаказ.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Проведен = Истина Тогда 
		сДополнительныеРеквизиты = ДополнительныеРеквизиты.Найти(Пикс_Сервер.Свойство_ВариантОплаты(),"Свойство");
		НЗ = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		НЗ.Отбор.Объект.Установить(Ссылка);
		НЗ.Отбор.Свойство.Установить(Пикс_ПовторноеИспользование.Свойство_ВидОплатыДопСведение());
		
		
		Если сДополнительныеРеквизиты = Неопределено или ЗначениеЗаполнено(сДополнительныеРеквизиты.Значение) = Ложь Тогда 
			
		Иначе
			Запись = НЗ.Добавить();
			Запись.Объект = Ссылка;
			Запись.Свойство = Пикс_ПовторноеИспользование.Свойство_ВидОплатыДопСведение();
			Запись.Значение = Пикс_ПовторноеИспользование.ВернутьЗначениеВидаОплатыДопСведениеПоЗначениюРеквизита(сДополнительныеРеквизиты.Значение);
		КонецЕсли;
		НЗ.ОбменДанными.Загрузка = Истина; // чтобы не создавать версию объекта
		НЗ.Записать(Истина);
		
	КонецЕсли;
	
	Попытка	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОписаниеНоменклатурыИС.Номенклатура КАК Номенклатура,
		|	ОписаниеНоменклатурыИС.КлючВидовПродукции КАК КлючВидовПродукции,
		|	ОписаниеНоменклатурыИС.ИдентификаторыВидовПродукции КАК ИдентификаторыВидовПродукции
		|ИЗ
		|	РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|ГДЕ
		|	ОписаниеНоменклатурыИС.Номенклатура В(&Номенклатура)";
		Запрос.УстановитьПараметр("Номенклатура", Товары.ВыгрузитьКолонку("Номенклатура"));
		Выборка = Запрос.Выполнить().Выбрать();
		
		нз_ДополнительныеСведения = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		нз_ДополнительныеСведения.Отбор.Объект.Установить(Ссылка);
		нз_ДополнительныеСведения.Отбор.Свойство.Установить(Пикс_ПовторноеИспользование.Свойство_ЕстьМаркируемаяПродукция_594b77a647944ddab22a2f732b670b93());
		Если Выборка.Следующий() Тогда
			Запись = нз_ДополнительныеСведения.Добавить();
			Запись.Объект = Ссылка;
			Запись.Свойство = Пикс_ПовторноеИспользование.Свойство_ЕстьМаркируемаяПродукция_594b77a647944ddab22a2f732b670b93();
			Запись.Значение = Истина;
		КонецЕсли;
		нз_ДополнительныеСведения.Записать(Истина);
	Исключение
		ЗаписьЖурналаРегистрации(Пикс_Сервер.ИмяСобытияЖурналаРегистрации("Ошибка"),УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура Пикс_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если РольДоступна("Пикс_ЗапретПроведенияРеализации") и не ДополнительныеСвойства.Свойство("ПечатУПДНеПроведен") = Истина  Тогда 
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение или Проведен = Истина или ЭтотОбъект.Ссылка.Проведен = Истина Тогда 
			Отказ = Истина;
			ВызватьИсключение("Проведение, изменение проведенных Вам недоступно.",КатегорияОшибки.НарушениеПравДоступа);
		КонецЕсли;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение или Проведен = Истина Тогда
		
		Попытка	
			ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
			
			т = Товары.Выгрузить(,"НомерСтроки,Номенклатура,ЕН_КатегорияВознаграждения,КоличествоУпаковок,СуммаСНДС");
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("т",т);
			Запрос.УстановитьПараметр("ВидЦены", Пикс_ПовторноеИспользование.ВидЦен_Себестоимость());
			Запрос.УстановитьПараметр("Период",КонецДня(Дата));
			Запрос.Текст =
			"ВЫБРАТЬ
			|	т.НомерСтроки КАК НомерСтроки,
			|	т.Номенклатура КАК Номенклатура,
			|	т.КоличествоУпаковок КАК КоличествоУпаковок,
			|	т.СуммаСНДС КАК СуммаСНДС,
			|	т.ЕН_КатегорияВознаграждения КАК ЕН_КатегорияВознаграждения
			|ПОМЕСТИТЬ т
			|ИЗ
			|	&т КАК т
			|ГДЕ
			|	т.ЕН_КатегорияВознаграждения = 0
			|;			
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	т.НомерСтроки КАК НомерСтроки,
			|	т.Номенклатура КАК Номенклатура,
			|	ВЫБОР
			|		КОГДА ВЫБОР
			|				КОГДА ЦЕЛ(LOG(т.СуммаСНДС / ВЫБОР
			|								КОГДА т.КоличествоУпаковок = 0
			|									ТОГДА 1
			|								ИНАЧЕ т.КоличествоУпаковок
			|							КОНЕЦ * 0.05 / 10) / LOG(2) - 2) > ВЫБОР
			|						КОГДА ВложенныйЗапрос.Цена ЕСТЬ NULL
			|								ИЛИ т.КоличествоУпаковок = 0
			|								ИЛИ т.СуммаСНДС / т.КоличествоУпаковок - ВложенныйЗапрос.Цена <= 0
			|							ТОГДА 0
			|						ИНАЧЕ ЦЕЛ(LOG((т.СуммаСНДС / т.КоличествоУпаковок - ВложенныйЗапрос.Цена) / 10) / LOG(2) - 2)
			|					КОНЕЦ
			|					ТОГДА ЦЕЛ(LOG(т.СуммаСНДС / ВЫБОР
			|									КОГДА т.КоличествоУпаковок = 0
			|										ТОГДА 1
			|									ИНАЧЕ т.КоличествоУпаковок
			|								КОНЕЦ * 0.05 / 10) / LOG(2) - 2)
			|				ИНАЧЕ ВЫБОР
			|						КОГДА ВложенныйЗапрос.Цена ЕСТЬ NULL
			|								ИЛИ т.КоличествоУпаковок = 0
			|								ИЛИ т.СуммаСНДС / т.КоличествоУпаковок - ВложенныйЗапрос.Цена <= 0
			|							ТОГДА 0
			|						ИНАЧЕ ЦЕЛ(LOG((т.СуммаСНДС / т.КоличествоУпаковок - ВложенныйЗапрос.Цена) / 10) / LOG(2) - 2)
			|					КОНЕЦ
			|			КОНЕЦ = 0
			|			ТОГДА 1
			|		ИНАЧЕ ВЫБОР
			|				КОГДА ЦЕЛ(LOG(т.СуммаСНДС / ВЫБОР
			|								КОГДА т.КоличествоУпаковок = 0
			|									ТОГДА 1
			|								ИНАЧЕ т.КоличествоУпаковок
			|							КОНЕЦ * 0.05 / 10) / LOG(2) - 2) > ВЫБОР
			|						КОГДА ВложенныйЗапрос.Цена ЕСТЬ NULL
			|								ИЛИ т.КоличествоУпаковок = 0
			|								ИЛИ т.СуммаСНДС / т.КоличествоУпаковок - ВложенныйЗапрос.Цена <= 0
			|							ТОГДА 0
			|						ИНАЧЕ ЦЕЛ(LOG((т.СуммаСНДС / т.КоличествоУпаковок - ВложенныйЗапрос.Цена) / 10) / LOG(2) - 2)
			|					КОНЕЦ
			|					ТОГДА ЦЕЛ(LOG(т.СуммаСНДС / ВЫБОР
			|									КОГДА т.КоличествоУпаковок = 0
			|										ТОГДА 1
			|									ИНАЧЕ т.КоличествоУпаковок
			|								КОНЕЦ * 0.05 / 10) / LOG(2) - 2)
			|				ИНАЧЕ ВЫБОР
			|						КОГДА ВложенныйЗапрос.Цена ЕСТЬ NULL
			|								ИЛИ т.КоличествоУпаковок = 0
			|								ИЛИ т.СуммаСНДС / т.КоличествоУпаковок - ВложенныйЗапрос.Цена <= 0
			|							ТОГДА 0
			|						ИНАЧЕ ЦЕЛ(LOG((т.СуммаСНДС / т.КоличествоУпаковок - ВложенныйЗапрос.Цена) / 10) / LOG(2) - 2)
			|					КОНЕЦ
			|			КОНЕЦ
			|	КОНЕЦ КАК ЕН_КатегорияВознаграждения
			|ИЗ
			|	т КАК т
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
			|			МАКСИМУМ(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)) КАК Цена
			|		ИЗ
			|			РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			|					&Период,
			|					ВидЦены = &ВидЦены
			|						И Номенклатура В
			|							(ВЫБРАТЬ
			|								т.Номенклатура КАК Номенклатура
			|							ИЗ
			|								т КАК т)) КАК ЦеныНоменклатурыСрезПоследних
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ЦеныНоменклатурыСрезПоследних.Номенклатура
			|		
			|		ИМЕЮЩИЕ
			|			МАКСИМУМ(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)) > 0) КАК ВложенныйЗапрос
			|		ПО т.Номенклатура = ВложенныйЗапрос.Номенклатура";
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Товары[Выборка.НомерСтроки-1].ЕН_КатегорияВознаграждения = ?(Выборка.ЕН_КатегорияВознаграждения > 8,8,Выборка.ЕН_КатегорияВознаграждения); 
			КонецЦикла;
			ОценкаПроизводительности.ЗакончитьЗамерВремени("ОперацияРасчетаМотивации_ДокументРеализацияТоваровУслуг",ВремяНачалаЗамера);		
		Исключение       
			ЗаписьЖурналаРегистрации("ДР.Мотивация_ПриПроведенииРеализации",,,Ссылка,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;		
КонецПроцедуры

&Перед("ОбработкаПроведения")
Процедура Пикс_ОбработкаПроведения(Отказ, РежимПроведения)
	Попытка
	Если Пикс_ЗапретитьПроведениеБезПроверки = Истина Тогда
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслугТовары.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |ГДЕ
	               |	РеализацияТоваровУслугТовары.Пикс_КоличествОтсканировано <> РеализацияТоваровУслугТовары.КоличествоУпаковок
	               |	И РеализацияТоваровУслугТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	               |	И РеализацияТоваровУслугТовары.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю("Не весь товар отсканирован. Проверьте количество отсканированного товара! Проведение невозможно!")
	КонецЕсли;
КонецЕсли;
Исключение   
	ЗаписьЖурналаРегистрации("ДР.Ошибка",УровеньЖурналаРегистрации.Ошибка,,Ссылка,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;
	
КонецПроцедуры
