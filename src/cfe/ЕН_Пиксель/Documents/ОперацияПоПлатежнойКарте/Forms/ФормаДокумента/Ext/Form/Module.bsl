&НаСервере
Процедура Пикс_СБППолучитьИнформациюОбОплатеПослеНаСервере()

	Соединение = Пикс_ПолучитьСоединение();
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	Заголовки.Вставить("Authorization","Bearer "+SecretKey);
								
	Запрос = Новый HTTPЗапрос("api/payment/v1/orders/"+XMLСтрока(Объект.Ссылка.УникальныйИдентификатор()),Заголовки);
	//Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	HttpОтвет = Соединение.Получить(Запрос);
	Если HttpОтвет.КодСостояния <> 200 Тогда 
		Сообщить("Ошибка при выполнении запроса.");
		Сообщить(HttpОтвет.ПолучитьТелоКакСтроку());
		
		Возврат;
	Иначе
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(HttpОтвет.ПолучитьТелоКакСтроку());
		Данные =ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		СтруктураОтвета = Новый Структура("id,amount,comment,expirationDate,status");
		СтруктураСтатус = Новый Структура("value,date" );
		ЗаполнитьЗначенияСвойств(СтруктураОтвета,Данные);
		ЗаполнитьЗначенияСвойств(СтруктураСтатус,СтруктураОтвета.status);
		Сообщить(
		"Идентификатор заказа	:"+СтруктураОтвета.id+"
		|Сумма заказа			:"+СтруктураОтвета.amount+"
		|Комментарий			:"+СтруктураОтвета.comment+"
		|Статус					:"+СтруктураСтатус.value+"
		|Дата создания			:"+СтруктураСтатус.date+"
		|Дата истечения срока	:"+СтруктураОтвета.expirationDate);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Пикс_СБППолучитьИнформациюОбОплатеПосле(Команда)
	Пикс_СБППолучитьИнформациюОбОплатеПослеНаСервере();
КонецПроцедуры


