&НаСервере
Процедура Пикс_СБПЗапросОплатыПослеНаСервере()
	

	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗначенияСвойствОбъектов.Значение КАК Значение
	                      |ИЗ
	                      |	РегистрСведений.ДополнительныеСведения КАК ЗначенияСвойствОбъектов
	                      |ГДЕ
	                      |	ЗначенияСвойствОбъектов.Объект = &Объект
	                      |	И ЗначенияСвойствОбъектов.Свойство = &Свойство");
	Запрос.УстановитьПараметр("Объект", Объект.Организация);
	Запрос.УстановитьПараметр("Свойство",Свойство_ДанныеКуарРайфайзенБанк());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий()  Тогда 
		ВызватьИсключение("Не найдена информация об ид qr-кода Райфайзен банка");
		Возврат;
	КонецЕсли;
	идQR = Выборка.Значение;
	//	{
	//"id": "c5b3fd07-c66b-4f11-a8a2-1cc5d319f9e3",
	//"amount": 1000.1,
	//"comment": "Шоколадный торт",
	//"extra": {
	//"customParameter1": "Additional information",
	//"customParameter2": "Additional information",
	//"customParameter3": "Additional information"
	//},
	//"expirationDate": "+10M",
	//"qr": {
	//"id": "AD100004BAL7227F9BNP6KNE007J9B3K",
	//"additionalInfo": "Доп. информация",
	//"paymentDetails": "Назначение платежа"
	//}
	//}
	ТелоЗаказа = Новый Соответствие;
	
	ТелоЗаказа.Вставить("amount",Формат(Объект.СуммаДокумента,"ЧРД=.; ЧГ="));
	ТелоЗаказа.Вставить("comment","");
	ТелоЗаказа.Вставить("expirationDate","+15M");
	ТелоQr = Новый Соответствие;
	ТелоQr.Вставить("id",идQR);
	ТелоQr.Вставить("additionalInfo","Срок действия Qr:"+Формат(ТекущаяДата()+15*60,"ДФ='dd.MM.yy HH:mm:ss'"));
	ТелоQr.Вставить("paymentDetails","оплата за товары");
	ТелоЗаказа.Вставить("qr",ТелоQr);
	ТелоЗаказа.Вставить("id",XMLСтрока(Объект.Ссылка.УникальныйИдентификатор()));
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоЗаказа);
	ТелоЗапроса =    ЗаписьJSON.Закрыть();
	Соединение = Пикс_ПолучитьСоединение();
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	Заголовки.Вставить("Authorization","Bearer "+SecretKey);
	Запрос = Новый HTTPЗапрос("api/payment/v1/orders",Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	HttpОтвет = Соединение.ОтправитьДляОбработки(Запрос);
	Если HttpОтвет.КодСостояния <> 200 Тогда 
		Сообщить("Ошибка при выполнении запроса.");
		Сообщить(HttpОтвет.ПолучитьТелоКакСтроку());
		Сообщить(ТелоЗапроса);
		Возврат;
	Иначе
		Сообщить("Создан заказ на оплату на сумму "+Объект.СуммаДокумента);
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура Пикс_СБПЗапросОплатыПосле(Команда)
	Если Модифицированность = Истина или Объект.Проведен = Ложь Тогда 
		Сообщить("Перед оплатой документ должен быть записан и проведен");
		Возврат;
	КонецЕсли;	
	Пикс_СБПЗапросОплатыПослеНаСервере();
КонецПроцедуры

&НаСервере
Процедура Пикс_СБП_ОтменитьЗапросОплатыПослеНаСервере()
	
	Соединение = Пикс_ПолучитьСоединение();
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type","application/json");
	Заголовки.Вставить("Authorization","Bearer "+SecretKey);
								
	Запрос = Новый HTTPЗапрос("api/payment/v1/orders/"+XMLСтрока(Объект.Ссылка.УникальныйИдентификатор()),Заголовки);
	//Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	HttpОтвет = Соединение.Удалить(Запрос);
	Если HttpОтвет.КодСостояния <> 200 Тогда 
		Сообщить("Ошибка при выполнении запроса.");
		Сообщить(HttpОтвет.ПолучитьТелоКакСтроку());
		
		Возврат;
	Иначе
		Сообщить("Заказ на оплату отменен");
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура Пикс_СБП_ОтменитьЗапросОплатыПосле(Команда)
	Пикс_СБП_ОтменитьЗапросОплатыПослеНаСервере();
КонецПроцедуры
