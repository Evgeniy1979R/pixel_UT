
&НаСервере
Функция Пикс_ПолучитьСоединение()
	//Прод https://e-commerce.raiffeisen.ru/
	//Тест https://test.ecom.raiffeisen.ru/	
	Если ТестовыйКонтур = Истина Тогда
		Сервер = "test.ecom.raiffeisen.ru";
	Иначе
		Сервер = "e-commerce.raiffeisen.ru";
	КонецЕсли;
	
	Возврат  Новый HTTPСоединение(Сервер,,,,,30,Новый ЗащищенноеСоединениеOpenSSL());
	
КонецФункции

