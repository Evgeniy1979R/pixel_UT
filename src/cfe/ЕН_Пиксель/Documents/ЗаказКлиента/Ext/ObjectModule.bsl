
	&После("ПриЗаписи")
	Процедура Пикс_ПриЗаписи(Отказ)
		Если ДополнительныеСвойства.Свойство("НеРегистрироватьКОтправкеНаСайт")  Тогда 
		Иначе
			НЗ_ИзмененныеЗаказы = РегистрыСведений.ЕН_ИзмененныеЗаказы.СоздатьНаборЗаписей();
			НЗ_ИзмененныеЗаказы.Отбор.Объект.Использование = Истина;
			НЗ_ИзмененныеЗаказы.Отбор.Объект.Значение = Ссылка;
			Запись = НЗ_ИзмененныеЗаказы.Добавить();
			Запись.Объект = Ссылка;
			НЗ_ИзмененныеЗаказы.Записать(Истина);
		КонецЕсли;
	КонецПроцедуры
	
	&После("ПередЗаписью")
	Процедура Пикс_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение
			и Не (Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаказовКлиентов.НеСогласован") или Статус.Пустая())
			Тогда 
			Если  Менеджер = Справочники.Пользователи.ПустаяСсылка() Тогда
				Менеджер = ПараметрыСеанса.ТекущийПользователь;
			КонецЕсли;
			СтрокаДопРеквизита = ДополнительныеРеквизиты.Найти(Пикс_Сервер.Свойство_ЗаказОбработан(),"Свойство");
			Если СтрокаДопРеквизита = Неопределено Тогда 
				СтрокаДопРеквизита = ДополнительныеРеквизиты.Добавить();
				СтрокаДопРеквизита.Свойство = Пикс_Сервер.Свойство_ЗаказОбработан();
			КонецЕсли;
			СтрокаДопРеквизита.Значение = Истина;
			
		КонецЕсли;
	КонецПроцедуры


