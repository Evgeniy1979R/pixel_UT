
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЕН_Предавторизация") Тогда 
		Контрагент = ДанныеЗаполнения.Контрагент;
		ДокументОснование = ДанныеЗаполнения;
		Сумма		= ДанныеЗаполнения.Сумма;
		СсылкаНаRRNПреавторизации = ДокументОснование.КодRRN;
		ВидОперации = Перечисления.ВариантыПреавторизаций.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	КодRRN = "";
	ДанныеСлипЧека = "";
	ВидОперации = Перечисления.ВариантыПреавторизаций.Преавторизация;
	ДокументОснование = Документы.ЕН_Предавторизация.ПустаяСсылка();
	СсылкаНаRRNПреавторизации = "";
	ДанныеСлипЧека = "";
	
КонецПроцедуры


Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ВидОперации = Перечисления.ВариантыПреавторизаций.Предавторизация Тогда 
	 эл = ПроверяемыеРеквизиты.Найти("СсылкаНаRRNПреавторизации");
	 Если эл <> Неопределено Тогда 
		 ПроверяемыеРеквизиты.Удалить(эл);
		 КонецЕсли;
	КонецЕсли;

КонецПроцедуры

