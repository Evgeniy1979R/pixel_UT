
&ИзменениеИКонтроль("ЗаполнитьВидыФискальныхЧековПоДокументу")
Процедура Пикс_ЗаполнитьВидыФискальныхЧековПоДокументу(ВидыЧеков, Операция, ИмяКомандыПробитияЧека)
	
	#Удаление
	ВидЧека = ВидыЧеков.Добавить();
	ВидЧека.ТипФискальногоДокумента = Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции;
	ВидЧека.ТипРасчетаДенежнымиСредствами = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	ВидЧека.ВидЧекаКоррекции = Перечисления.ВидыЧековКоррекции.ИсправлениеОшибки;
	#КонецУдаления
	
	#Вставка
	
	ВидЧека = ВидыЧеков.Добавить();
	ВидЧека.ТипФискальногоДокумента = Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек;
	ВидЧека.ТипРасчетаДенежнымиСредствами = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	ВидЧека.ВидЧекаКоррекции = Неопределено;
	
	#КонецВставки
	
КонецПроцедуры

&ИзменениеИКонтроль("ОсновныеПараметрыОперации")
Функция Пикс_ОсновныеПараметрыОперации(Форма)
	
	ОсновныеПараметрыОперации = ФормированиеФискальныхЧековСерверПереопределяемый.СтруктураОсновныхПараметровОперации();
	
	ОсновныеПараметрыОперации.ДокументСсылка       = Форма.Объект.Ссылка;
	ОсновныеПараметрыОперации.Организация          = Форма.Объект.Организация;
	ОсновныеПараметрыОперации.Контрагент           = Форма.Объект.Контрагент;
	ОсновныеПараметрыОперации.Партнер              = Форма.Объект.Партнер;
	ОсновныеПараметрыОперации.Валюта               = Форма.Объект.Валюта;
	#Удаление	
	ОсновныеПараметрыОперации.СуммаДокумента       = Форма.Объект.СуммаДокумента;
	#КонецУдаления	
	#Вставка
	//имяформы = Документ.КорректировкаРеализации.Форма.ФормаДокумента
	СуммаДокумента = 0;
	Для каждого с из Форма.Объект.Расхождения Цикл
		Если с.СуммаСНДС < 0 Тогда 
			СуммаДокумента = СуммаДокумента - с.СуммаСНДС;
		КонецЕсли;
		
	КонецЦикла;
	ОсновныеПараметрыОперации.СуммаДокумента       = СуммаДокумента;
	#КонецВставки
	
	
	Возврат ОсновныеПараметрыОперации;
	
КонецФункции

&ИзменениеИКонтроль("ПредметыРасчетовПоДокументу")
Функция Пикс_ПредметыРасчетовПоДокументу(ДокументСсылка, ЧекКоррекцииИсправленииОшибки)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ДокументОснование, ЦенаВключаетНДС, Организация, Дата");
	
	Страна = ЗначениеНастроекКлиентСерверПовтИсп.СтранаРегистрацииОрганизации(РеквизитыДокумента.Организация);
	
	ПараметрыЗалогаЗаТару = Новый Структура("ТребуетсяЗалогЗаТару, ВернутьМногооборотнуюТару", Ложь, Ложь);
	Если ТипЗнч(РеквизитыДокумента.ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		РеквизитыДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.ДокументОснование, "ТребуетсяЗалогЗаТару, ВернутьМногооборотнуюТару");
		ЗаполнитьЗначенияСвойств(ПараметрыЗалогаЗаТару, РеквизитыДокументаОснования);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабличнаяЧасть.Номенклатура КАК Номенклатура,
	|	ТабличнаяЧасть.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ТабличнаяЧасть.Номенклатура.КодВидаНоменклатурнойКлассификации КАК КодВидаНоменклатурнойКлассификации,
	|	ТабличнаяЧасть.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ТабличнаяЧасть.Номенклатура.ОсобенностьУчета КАК ОсобенностьУчета,
	|	ТабличнаяЧасть.Номенклатура.Принципал КАК Принципал,
	|	ТабличнаяЧасть.Номенклатура.Контрагент КАК Контрагент,
	|	ТабличнаяЧасть.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	ТабличнаяЧасть.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины КАК ТипИзмеряемойВеличины
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	#Удаление
	|	Документ.КорректировкаРеализации.Товары КАК ТабличнаяЧасть
	#КонецУдаления
	#Вставка
	|	Документ.КорректировкаРеализации.Расхождения КАК ТабличнаяЧасть
	#КонецВставки
	
	|ГДЕ
	|	ТабличнаяЧасть.Ссылка = &Ссылка
	|	И (НЕ &ВернутьМногооборотнуюТару
	|			ИЛИ НЕ &ТребуетсяЗалогЗаТару
	|				И ТабличнаяЧасть.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
	|			ИЛИ &ТребуетсяЗалогЗаТару)
	|
	|ИНДЕКСИРОВАТЬ ПО Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|" + УчетПодакцизныхТоваров.ТекстЗапросаВтПодакцизныеТовары("ТаблицаНоменклатуры")
	+ ОбщегоНазначения.РазделительПакетаЗапросов() + "
	|ВЫБРАТЬ
	|	ТабличнаяЧасть.НомерСтроки КАК НомерСтроки,
	|	ТабличнаяЧасть.ЗаказКлиента КАК Заказ,
	|	ТабличнаяЧасть.Номенклатура КАК Номенклатура,
	|	ТабличнаяЧасть.Характеристика КАК Характеристика,
	|	ТабличнаяЧасть.Серия КАК Серия,
	|	ТабличнаяЧасть.СтатусУказанияСерий КАК СтатусУказанияСерий,
	|	ТабличнаяЧасть.Упаковка КАК Упаковка,
	|	СпрНоменклатура.ЕдиницаИзмерения КАК БазоваяУпаковка,
	|	СпрНоменклатура.КодВидаНоменклатурнойКлассификации КАК КодВидаНоменклатурнойКлассификации,
	|	ЕСТЬNULL(СпрНоменклатура.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) КАК ТипНоменклатуры,
	|	ЕСТЬNULL(ВтПодакцизныеТовары.ПодакцизныйТовар, ЛОЖЬ) КАК ПодакцизныйТовар,
	|	ЕСТЬNULL(СпрНоменклатура.ОсобенностьУчета, ЗНАЧЕНИЕ(Перечисление.ОсобенностиУчетаНоменклатуры.ПустаяСсылка)) КАК ОсобенностьУчета,
	|	ЕСТЬNULL(ОписаниеНоменклатурыИС.КлючВидовПродукции, ЗНАЧЕНИЕ(Справочник.КлючиВидовПродукцииИС.ПустаяСсылка)) КАК ВидПродукцииИС,
	|	ВЫБОР
	|		КОГДА СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|				И ЕСТЬNULL(ТабличнаяЧасть.Характеристика.Принципал, СпрНоменклатура.Принципал) <> НЕОПРЕДЕЛЕНО
	|				И ЕСТЬNULL(ТабличнаяЧасть.Характеристика.Принципал, СпрНоменклатура.Принципал) <> &Организация
	|			ТОГДА ЕСТЬNULL(ТабличнаяЧасть.Характеристика.Контрагент, СпрНоменклатура.Контрагент)
	|		ИНАЧЕ ЕСТЬNULL(СпрНоменклатура.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|	КОНЕЦ КАК Агент,
	|	ЕСТЬNULL(СпрНоменклатура.НаименованиеПолное, ТабличнаяЧасть.Содержание) КАК НоменклатураНаименование,
	|	ЕСТЬNULL(ТабличнаяЧасть.Характеристика.НаименованиеПолное, """") КАК ХарактеристикаНаименование,
	|	ТабличнаяЧасть.Упаковка КАК УпаковкаНаименование,
	|	ВЫБОР
	|		КОГДА ТабличнаяЧасть.Количество = 0
	|			ТОГДА 1
	#Удаление
	|		ИНАЧЕ ТабличнаяЧасть.Количество
	#КонецУдаления
	#Вставка
	|		ИНАЧЕ -ТабличнаяЧасть.Количество
	#КонецВставки
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ТабличнаяЧасть.КоличествоУпаковок = 0
	|			ТОГДА 1
	#Удаление
	|		ИНАЧЕ ТабличнаяЧасть.КоличествоУпаковок
	#КонецУдаления
	#Вставка
	|		ИНАЧЕ -ТабличнаяЧасть.КоличествоУпаковок
	#КонецВставки
	|	КОНЕЦ КАК КоличествоУпаковок,
	#Удаление
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА &ЦенаВключаетНДС
	|				ТОГДА ТабличнаяЧасть.Цена
	|			КОГДА ТабличнаяЧасть.КоличествоУпаковок = 0
	|				ТОГДА ТабличнаяЧасть.СуммаСНДС
	|			ИНАЧЕ ТабличнаяЧасть.СуммаСНДС / ТабличнаяЧасть.КоличествоУпаковок
	#КонецУдаления
	#Вставка
	|	ВЫРАЗИТЬ(ВЫБОР
	|			КОГДА ТабличнаяЧасть.КоличествоУпаковок = 0
	|				ТОГДА -ТабличнаяЧасть.СуммаСНДС
	|			ИНАЧЕ ТабличнаяЧасть.СуммаСНДС / ТабличнаяЧасть.КоличествоУпаковок
	#КонецВставки
	|		КОНЕЦ КАК ЧИСЛО(31, 2)) КАК Цена,
	|	0 КАК СуммаСкидки,
	|	ТабличнаяЧасть.СтавкаНДС КАК СтавкаНДС,
	#Удаление	
	|	ТабличнаяЧасть.СуммаНДС КАК СуммаНДС,
	|	ТабличнаяЧасть.СуммаСНДС КАК СуммаСНДС,
	#КонецУдаления
	#Вставка
	|	-ТабличнаяЧасть.СуммаНДС КАК СуммаНДС,
	|	-ТабличнаяЧасть.СуммаСНДС КАК СуммаСНДС,
	#КонецВставки
	
	|	СпрНоменклатура.ТипИзмеряемойВеличины В (&МерныеТипыЕдиницИзмерений) КАК МернаяЕдиницаИзмерения
	|ПОМЕСТИТЬ ТаблицаТовары
	|ИЗ
	#Удаление
	|	Документ.КорректировкаРеализации.Товары КАК ТабличнаяЧасть
	#КонецУдаления
	#Вставка
	|	Документ.КорректировкаРеализации.Расхождения КАК ТабличнаяЧасть
	#КонецВставки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНоменклатуры КАК СпрНоменклатура
	|		ПО (ТабличнаяЧасть.Номенклатура = СпрНоменклатура.Номенклатура)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПодакцизныеТовары КАК ВтПодакцизныеТовары
	|		ПО ТабличнаяЧасть.Номенклатура = ВтПодакцизныеТовары.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО ТабличнаяЧасть.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	ТабличнаяЧасть.Ссылка = &Ссылка
	|	И (НЕ &ВернутьМногооборотнуюТару
	|			ИЛИ НЕ &ТребуетсяЗалогЗаТару
	|				И СпрНоменклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)
	|			ИЛИ &ТребуетсяЗалогЗаТару)
	#Вставка
	|	И ВЫБОР
	|			КОГДА ТабличнаяЧасть.Количество = 0
	|				ТОГДА 1
	|			ИНАЧЕ -ТабличнаяЧасть.Количество
	|		КОНЕЦ > 0
	#КонецВставки			   
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Серия,
	|	Упаковка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	#Удаление
	|ВЫБРАТЬ
	|	ШтрихкодыУпаковок.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|	ШтрихкодыУпаковок.ЧастичноеВыбытиеВариантУчета КАК ЧастичноеВыбытиеВариантУчета,
	|	ШтрихкодыУпаковок.ЧастичноеВыбытиеНоменклатура КАК ЧастичноеВыбытиеНоменклатура,
	|	ШтрихкодыУпаковок.ЧастичноеВыбытиеХарактеристика КАК ЧастичноеВыбытиеХарактеристика,
	|	ШтрихкодыУпаковок.ЧастичноеВыбытиеКоличество КАК ЧастичноеВыбытиеКоличество
	|ПОМЕСТИТЬ ТаблицаАкцизныеМарки
	|ИЗ
	|	Документ.КорректировкаРеализации.ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
	|ГДЕ
	|	ШтрихкодыУпаковок.Ссылка = &Ссылка
	#КонецУдаления
	#Вставка
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|	ВложенныйЗапрос.ЧастичноеВыбытиеВариантУчета КАК ЧастичноеВыбытиеВариантУчета,
	|	ВложенныйЗапрос.ЧастичноеВыбытиеНоменклатура КАК ЧастичноеВыбытиеНоменклатура,
	|	ВложенныйЗапрос.ЧастичноеВыбытиеХарактеристика КАК ЧастичноеВыбытиеХарактеристика,
	|	СУММА(ВложенныйЗапрос.ЧастичноеВыбытиеКоличество) КАК ЧастичноеВыбытиеКоличество,
	|	СУММА(ВложенныйЗапрос.КоличествоУбрать) КАК КоличествоУбрать
	|ПОМЕСТИТЬ ТаблицаАкцизныеМарки
	|ИЗ
	|	(ВЫБРАТЬ
	|		ШтрихкодыУпаковок.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|		ШтрихкодыУпаковок.ЧастичноеВыбытиеВариантУчета КАК ЧастичноеВыбытиеВариантУчета,
	|		ШтрихкодыУпаковок.ЧастичноеВыбытиеНоменклатура КАК ЧастичноеВыбытиеНоменклатура,
	|		ШтрихкодыУпаковок.ЧастичноеВыбытиеХарактеристика КАК ЧастичноеВыбытиеХарактеристика,
	|		-ШтрихкодыУпаковок.ЧастичноеВыбытиеКоличество КАК ЧастичноеВыбытиеКоличество,
	|		-1 КАК КоличествоУбрать
	|	ИЗ
	|		Документ.КорректировкаРеализации.ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
	|	ГДЕ
	|		ШтрихкодыУпаковок.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки,
	|		РеализацияТоваровУслугШтрихкодыУпаковок.ЧастичноеВыбытиеВариантУчета,
	|		РеализацияТоваровУслугШтрихкодыУпаковок.ЧастичноеВыбытиеНоменклатура,
	|		РеализацияТоваровУслугШтрихкодыУпаковок.ЧастичноеВыбытиеХарактеристика,
	|		РеализацияТоваровУслугШтрихкодыУпаковок.ЧастичноеВыбытиеКоличество,
	|		1
	|	ИЗ
	|		Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК РеализацияТоваровУслугШтрихкодыУпаковок
	|	ГДЕ
	|		РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка В
	|				(ВЫБРАТЬ
	|					КорректировкаРеализации.ДокументОснование КАК ДокументОснование
	|				ИЗ
	|					Документ.КорректировкаРеализации КАК КорректировкаРеализации
	|				ГДЕ
	|					КорректировкаРеализации.Ссылка = &Ссылка)) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ШтрихкодУпаковки,
	|	ВложенныйЗапрос.ЧастичноеВыбытиеХарактеристика,
	|	ВложенныйЗапрос.ЧастичноеВыбытиеНоменклатура,
	|	ВложенныйЗапрос.ЧастичноеВыбытиеВариантУчета
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ВложенныйЗапрос.ЧастичноеВыбытиеКоличество) > 0
	|		ИЛИ СУММА(ВложенныйЗапрос.КоличествоУбрать) > 0)
	#КонецВставки	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика,
	|	ТаблицаТовары.Серия КАК Серия,
	|	ТаблицаТовары.Упаковка КАК Упаковка,
