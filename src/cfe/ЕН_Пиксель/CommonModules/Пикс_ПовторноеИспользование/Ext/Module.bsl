Функция ВернутьЗначениеВидаОплатыДопСведениеПоЗначениюРеквизита(ВидОплатыЗначениеРеквизита)  Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Владелец = &Свойство
	|	И ЗначенияСвойствОбъектов.Наименование В
	|			(ВЫБРАТЬ
	|				Справочник.ЗначенияСвойствОбъектов.Наименование
	|			ИЗ
	|				Справочник.ЗначенияСвойствОбъектов
	|			ГДЕ
	|				Справочник.ЗначенияСвойствОбъектов.Ссылка = &ВидОплатыЗначениеРеквизита)";
	
	Запрос.УстановитьПараметр("Свойство", Свойство_ВидОплатыДопСведение());
	Запрос.УстановитьПараметр("ВидОплатыЗначениеРеквизита", ВидОплатыЗначениеРеквизита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе
		оЗначенияСвойствОбъектов = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
		оЗначенияСвойствОбъектов.Наименование = ВидОплатыЗначениеРеквизита.Наименование;
		оЗначенияСвойствОбъектов.ПолноеНаименование = ВидОплатыЗначениеРеквизита.ПолноеНаименование;
		оЗначенияСвойствОбъектов.Владелец 			=  Свойство_ВидОплатыДопСведение();
		оЗначенияСвойствОбъектов.Записать();
		Возврат оЗначенияСвойствОбъектов.Ссылка;
	КонецЕсли;
	
КонецФункции

