Процедура УстановитьСтатусЗаказаОтгружен(Заказ,Статус)
	
	оЗаказ = Заказ.ПолучитьОбъект();
	Отгружен = ПолучитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство_ЗаказОтгружен()) = Истина;
	
	Если Отгружен <> Статус тогда
		
		ЗаказССайта = ПолучитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство_ЗаказССайта()) = Истина;
		
		Если ЗаказССайта = Истина тогда	

			УстановитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство_ЗаказОтгружен(),Статус);
			оЗаказ.ОбменДанными.Загрузка = Истина;
			оЗаказ.Записать(РежимЗаписиДокумента.Запись);

		КонецЕсли;
		
	КонецЕсли;			
	
	
КонецПроцедуры

Процедура Пикс_ОбработкаУдаленияПроведенияОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
		// обработка статусов инет магазина 
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") 
		и ТипЗнч(Источник.ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента")
		и Источник.ЗаказКлиента.Пустая() = ЛОжь тогда
		
		УстановитьСтатусЗаказаОтгружен(Источник.ЗаказКлиента,Ложь);	
		
	ИначеЕсли 
		ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств")
		Или ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") 
		Или ТипЗнч(Источник) = Тип("ДокументОбъект.ОперацияПоПлатежнойКарте") 
		И Источник.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента")
		Тогда
		
		Для каждого стр из Источник.РасшифровкаПлатежа цикл   
			Если стр.ОбъектРасчетов.Пустая() = Ложь Тогда 
				Если ТипЗнч(стр.ОбъектРасчетов.Объект) = Тип("ДокументСсылка.ЗаказКлиента")
					и стр.ОбъектРасчетов.Объект.Пустая() = Ложь Тогда 
					оЗаказ = стр.ОбъектРасчетов.Объект.ПолучитьОбъект();
					
					Оплачен = ПолучитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство_ЗаказОплачен()) = Истина;
					Если Оплачен = Истина	Тогда
						УстановитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство_ЗаказОплачен(),Ложь);
						оЗаказ.ОбменДанными.Загрузка = Истина;
						оЗаказ.Записать(РежимЗаписиДокумента.Запись);

						
					КонецЕсли;	
					
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;		
		
	ИначеЕсли (ТипЗнч(Источник) = Тип("ДокументОбъект.ВозвратТоваровОтКлиента")) тогда
		// заказ определяем из реализации в  первой строке документа
		Реализация = Источник.Товары[0].ДокументРеализации;
		Если ЗначениеЗаполнено(Реализация) Тогда 
			ЗаказКлиента = Реализация.ЗаказКлиента;
		Иначе
			ЗаказКлиента = Неопределено;
		КонецЕсли;
		
		Если (ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента"))  тогда
			оЗаказ = ЗаказКлиента.ПолучитьОбъект();
			Отгружен = ПолучитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство_ЗаказОтгружен()) = Истина;
			Если  Отгружен = Ложь	тогда
				ЗаказССайта = ПолучитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство_ЗаказССайта()) = Истина;	
				Если ЗаказССайта = Истина  тогда	
					УстановитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство_ЗаказОтгружен(),Истина);
					
					оЗаказ.ОбменДанными.Загрузка = Истина;
					оЗаказ.Записать(РежимЗаписиДокумента.Запись);

				КонецЕсли;
				
			КонецЕсли;	
		КонецЕсли;			
	
		
	
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказКлиента") тогда
		ЗаказССайта = ПолучитьЗначениеДополнительногоРеквизита(Источник,Свойство_ЗаказССайта());
		Если ЗаказССайта = Истина тогда	
			Обработан = ПолучитьЗначениеДополнительногоРеквизита(Источник,Свойство_ЗаказОбработан());
			Отменен		= ПолучитьЗначениеДополнительногоРеквизита(Источник,Свойство_ЗаказОтменен());
			Если Обработан <> Истина или Отменен <> Истина Тогда
				
				УстановитьЗначениеДополнительногоРеквизита(Источник,Свойство_ЗаказОбработан(),Истина);
				УстановитьЗначениеДополнительногоРеквизита(Источник,Свойство_ЗаказОтменен(),Истина);
				
				//Источник.Автор = ПараметрыСеанса.ТекущийПользователь;
				Источник.Записать(РежимЗаписиДокумента.Запись);

			КонецЕсли;
		КонецЕсли;	
	
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьПорциюДанных(тДанные, ДатаИзменения) Экспорт
  //НомерТелефона
  //Партнер 
  Свойство_МногопоточнаяОбработкаДатаОбработки = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту(
	"Имя","МногопоточнаяОбработкаДатаОбработки_e50beef1fadb482b8d1b7075c33b3e6e");

  Для Каждого с из тДанные Цикл
	оПартнер = с.Партнер.ПолучитьОбъект();
	НадоЗаписывать = Ложь;
	Для Каждого ски из оПартнер.КонтактнаяИнформация Цикл
		Если ски.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера Тогда 
			ОбработатьСтрокуКИТелефон(с.НомерТелефона,ски);
			НадоЗаписывать = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НадоЗаписывать = Истина Тогда 
		оПартнер.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии","Нормализация телефона");
		оПартнер.Записать();
		нз = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		Нз.Отбор.Объект.Установить(оПартнер.Ссылка);
		нз.Отбор.Свойство.Установить(Свойство_МногопоточнаяОбработкаДатаОбработки);
		Запись = Нз.Добавить();
		Запись.Объект = оПартнер.Ссылка;
		Запись.Свойство = Свойство_МногопоточнаяОбработкаДатаОбработки;
		Запись.Значение = ДатаИзменения;
		Нз.Записать(Истина);
	КонецЕсли;
  КонецЦикла;
КонецПроцедуры

Процедура ОбработатьСтрокуКИТелефон(Значение, сКИ) Экспорт
	Если СтрДлина(Значение) = 11 И Лев(Значение, 1) = "8" Тогда
		Значение = "7" + Сред(Значение, 2);
	КонецЕсли;
	Если СтрДлина(Значение) = 11 И Лев(Значение, 1) = "7" Тогда
		КодСтраны = "+" + Лев(Значение, 1);
		КодГорода = Сред(Значение, 2, 3);
		НомерТелефона = Сред(Значение, 5, 7);
		СведенияТелефона = УправлениеКонтактнойИнформацией.СведенияОТелефоне(сКИ.ЗначенияПолей);
		СведенияТелефона.КодСтраны = КодСтраны;
		СведенияТелефона.КодГорода = КодГорода;
		ПредставлениеТелефона = СтрШаблон("%1-%2-%3", Лев(НомерТелефона, 3), Сред(НомерТелефона, 4, 2), Сред(НомерТелефона, 6, 2));
		СведенияТелефона.НомерТелефона = ПредставлениеТелефона;
		ПредставлениеТелефона = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(
			СведенияТелефона.КодСтраны, СведенияТелефона.КодГорода, ПредставлениеТелефона,
			СведенияТелефона.Добавочный, СведенияТелефона.Комментарий);
		СведенияТелефона.Представление = ПредставлениеТелефона;
		сКИ.ЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВXML(СведенияТелефона, "", Перечисления.ТипыКонтактнойИнформации.Телефон);
		сКИ.Значение = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияВJSON(СведенияТелефона, Перечисления.ТипыКонтактнойИнформации.Телефон);
		сКИ.Представление = ПредставлениеТелефона;
		сКИ.НомерТелефона = Значение;
		сКИ.НомерТелефонаБезКодов = НомерТелефона;
	КонецЕсли;
КонецПроцедуры

Функция ИмяСобытияЖурналаРегистрации(ИмяСобытия) Экспорт
	
	Если ПустаяСтрока(ИмяСобытия) = Истина Тогда
		ИмяСобытия = "Общее";
	КонецЕсли;
	
	Возврат СтрШаблон("ДР.%1",ИмяСобытия);
	
КонецФункции
	