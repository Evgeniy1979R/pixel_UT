Процедура СоздатьВариантыОплаты ()   Экспорт
	Перем ТабличныйДокумент;
	ТабличныйДокумент = ПолучитьОбщийМакет("ЗначенияВидовОплат");
	// в ут 10 у этого реквизита был код. Для обращения по коду его необходимо сохранить.
	// вставляем код в конец в фигурных скобках
	т = Новый ТаблицаЗначений;
	к = т.Колонки;
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(1024,ДопустимаяДлина.Переменная));
	к.Добавить("Код",ОписаниеТиповСтрока);
	к.Добавить("Наименование",ОписаниеТиповСтрока);
	к.Добавить("ПометкаУдаления", Новый ОписаниеТипов("Булево"));
	нСтр = 1;
	ошибок = 0;
	
	Пока Истина Цикл                                    
		нСтр = нСтр + 1;
		Код = 	СокрЛП(ТабличныйДокумент.Область(нСтр,1).Текст);
		Если Код = "" Тогда 
			ошибок = ошибок +1;
			Если ошибок > 100 Тогда 
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Ошибок = 0;
		с = т.Добавить();
		с.Код = СтрШаблон("{%1}",Код);
		с.Наименование = Лев(СокрЛп(ТабличныйДокумент.Область(нСтр,2).Текст),130) + " "+с.Код;
		с.ПометкаУдаления = СокрЛп(ТабличныйДокумент.Область(нСтр,3).Текст)<> "";
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СвойствоВариантОплаты", Свойство_ВариантОплаты());
		Запрос.УстановитьПараметр("т",т);
		Запрос.Текст = "ВЫБРАТЬ
		|	т.Код КАК Код,
		|	т.Наименование КАК Наименование,
		|	т.ПометкаУдаления КАК ПометкаУдаления
		|ПОМЕСТИТЬ т
		|ИЗ
		|	&т КАК т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	т.Код КАК Код,
		|	т.Наименование КАК Наименование,
		|	т.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	т КАК т
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗначенияСвойствОбъектов.Ссылка КАК Ссылка,
		|			ЗначенияСвойствОбъектов.Наименование КАК Наименование
		|		ИЗ
		|			Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|		ГДЕ
		|			ЗначенияСвойствОбъектов.Владелец = &СвойствоВариантОплаты) КАК ВТ_ЗначенияВидовОплаты
		|		ПО (ВТ_ЗначенияВидовОплаты.Наименование ПОДОБНО ""%"" + т.Код)
		|ГДЕ
		|	ВТ_ЗначенияВидовОплаты.Ссылка ЕСТЬ NULL";
		т = Запрос.Выполнить().Выгрузить();
		Для Каждого с из т Цикл
			оЗначенияСвойств = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
			оЗначенияСвойств.Наименование = с.Наименование;
			оЗначенияСвойств.ПометкаУдаления = с.ПометкаУдаления;
			оЗначенияСвойств.Владелец = Свойство_ВариантОплаты();
			оЗначенияСвойств.Записать();
		КонецЦикла;
		
		
	КонецЦикла;
	
КонецПроцедуры


