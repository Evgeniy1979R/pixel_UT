Функция  ПреобразоватьВЧисло(Знач ЧислоСтрока, Ошибка = Ложь) 
	Попытка 
		_ЧислоСтрока = СтрЗаменить(ЧислоСтрока,",","."); 
		ДопустимыеСимволыЧисла = "-0123456789."; 
		СтрокаРезультат =""; 
		Для НСимвола = 1 По СтрДлина(_ЧислоСтрока) Цикл 
			Если СтрНайти(ДопустимыеСимволыЧисла,Сред(_ЧислоСтрока,НСимвола,1))> 0 Тогда 
				СтрокаРезультат = СтрокаРезультат + Сред(_ЧислоСтрока,НСимвола,1); 
			КонецЕсли; 
		КонецЦикла; 
		Результат = ?(СтрокаРезультат = "",0,Число(СтрокаРезультат)); 
	Исключение 
		Сообщить(СтрШаблон("Ошибка преобразования числа %1",ЧислоСтрока)); 
		Ошибка = Истина; 
	КонецПопытки; 
	Возврат Результат; 
КонецФункции //ПреобразоватьВЧисло

Процедура СоздатьПланВидовХарактеристик(СсылкаНаПВХ,Наименование,НаборСвойств,ТипЗначения,ЭтоДополнительноеСведение,Комментарий="",Имя = "")
	ПВХОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
	ПВХОбъект.Наименование = Наименование;
	ПвхОбъект .Заголовок = Наименование;
	ПвхОбъект.НаборСвойств = НаборСвойств;
	Пвхобъект.ЭтоДополнительноеСведение = ЭтоДополнительноеСведение;
	ПвхОбъект.УстановитьСсылкуНового(СсылкаНаПВХ);
	ПвхОбъект.ОбменДанными.Загрузка = Истина;
	ПвхОбъект.ТипЗначения = ТипЗначения;
	ПВХОбъект.Комментарий	= Комментарий;
	ПВХОбъект.Имя = Имя;
	ПвхОбъект.Записать();
	ДобавитьСвойствоВНаборСвойств(СсылкаНаПВХ,НаборСвойств,ЭтоДополнительноеСведение);
КонецПроцедуры

Процедура ДобавитьСвойствоВНаборСвойств (СсылкаНаПВх,НаборСвойств, ЭтоДополнительноеСведение )
	
	НаборСвойствОбъект = НаборСвойств.ПолучитьОбъект();
	Если ЭтоДополнительноеСведение Тогда
		НаборСвойствОбъект.КоличествоСведений = ПреобразоватьВЧисло(НаборСвойствОбъект.КоличествоСведений)+1;
		СтрокаНаборСвойств = НаборСвойствОбъект.ДополнительныеСведения.Добавить();
		СтрокаНаборСвойств.Свойство = СсылкаНаПвх;
		СтрокаНаборСвойств.ПометкаУдаления = Ложь;
	Иначе
		НаборСвойствОбъект.КоличествоРеквизитов = ПреобразоватьВЧисло(НаборСвойствОбъект.КоличествоРеквизитов)+1;
		СтрокаНаборРеквизитов = НаборСвойствОбъект.ДополнительныеРеквизиты.Добавить();
		СтрокаНаборРеквизитов.Свойство = СсылкаНаПвх;
		СтрокаНаборРеквизитов.ПометкаУдаления = Ложь;
		
	КонецЕсли;
	НаборСвойствОбъект.Записать();
	
КонецПроцедуры

