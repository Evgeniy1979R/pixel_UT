функция  ЗаказИзменен(ЗаказПередЗаписью,ЗаказВБазеСсылка)  экспорт
	ЗаказИзменен=ложь;
	оЗаказВБазе = ЗаказВБазеСсылка.ПолчитьОбъект();
	Если ЗначениеЗаполнено(оЗаказВБазе) тогда
		;
		Если  ПолучитьЗначениеДополнительногоРеквизита(ЗаказПередЗаписью,Свойство_ВариантОплаты())
			<>  ПолучитьЗначениеДополнительногоРеквизита(оЗаказВБазе,Свойство_ВариантОплаты()) тогда
			Возврат истина;
		КонецЕсли;	
		ТабИзменения= ЗаказПередЗаписью.Товары.выГрузить(,"Номенклатура,Сумма");
		ТабСтарая= оЗаказВБазе.Товары.выГрузить(,"Номенклатура,Сумма");
		ТабИзменения.свернуть("Номенклатура","Сумма");
		ТабИзменения.Сортировать("Номенклатура,Сумма");
		ТабСтарая.свернуть("Номенклатура","Сумма");
		ТабСтарая.Сортировать("Номенклатура,Сумма");
		Если ТабИзменения.количество()<>ТабСтарая.количество() тогда
			Возврат истина;
		КонецЕсли;
		Для сч = 0 По ТабСтарая.Количество() - 1 Цикл
			Если ТабСтарая[сч].Номенклатура <> ТабИзменения[сч].Номенклатура
				Или ТабСтарая[сч].Сумма <> ТабИзменения[сч].Сумма Тогда 
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	Возврат ЗаказИзменен;
КонецФункции

