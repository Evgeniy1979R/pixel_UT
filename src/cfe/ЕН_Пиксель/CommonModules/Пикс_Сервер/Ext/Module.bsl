Функция ПолучитьЗначениеДополнительногоРеквизита(Источник,Свойство)
	Результат = Неопределено;
	Попытка
		НайденнаяСтрока = Источник.ДополнительныеРеквизиты.Найти(Свойство,"Свойство");
		Если НайденнаяСтрока <> Неопределено Тогда 
			Результат = НайденнаяСтрока.Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

Процедура УстановитьЗначениеДополнительногоРеквизита(оЗаказ,Свойство,Значение) Экспорт
	Попытка 
		ДополнительныеРеквизиты = оЗаказ.ДополнительныеРеквизиты;
		НайденнаяСтрока = ДополнительныеРеквизиты.Найти(Свойство,"Свойство");
		Если НайденнаяСтрока = Неопределено Тогда 
			НайденнаяСтрока = ДополнительныеРеквизиты.Добавить();
			НайденнаяСтрока.Свойство = Свойство;
		КонецЕсли;
		Если ЗначениеЗаполнено(Значение) = Ложь Тогда 
			ДополнительныеРеквизиты.Удалить(НайденнаяСтрока);
		Иначе
			НайденнаяСтрока.Значение = Значение;
		КонецЕсли;
		
	Исключение
		
	КонецПопытки;
КонецПроцедуры

