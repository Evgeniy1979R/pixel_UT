


&ИзменениеИКонтроль("ЗаполнитьПараметрыСканированияДокументаОптовойОтгрузки")
Функция Пикс_ЗаполнитьПараметрыСканированияДокументаОптовойОтгрузки(ПараметрыСканирования, ВидыПродукции, АнализироватьУчитываемыеВидыПродукции, Контекст)

	Если Не ИнтеграцияИСМПКлиентСерверПовтИсп.ВестиУчетМаркируемойПродукции() Тогда
		Возврат Ложь;
	КонецЕсли;

	ВидОперацииИСМП = ОбщегоНазначенияИСМПКлиентСерверПовтИсп.ВидОперацииОптоваяПродажа();

	ВключенаПоддержкаМОТП = ШтрихкодированиеОбщегоНазначенияМОТПКлиентСервер.ВключитьПоддержкуТабачнойПродукции(
	ПараметрыСканирования, ВидыПродукции, АнализироватьУчитываемыеВидыПродукции, ВидОперацииИСМП);
	ВключенаПоддержкаИСМП = ВключитьПоддержкуПродукцииИСМП(ПараметрыСканирования, ВидыПродукции, АнализироватьУчитываемыеВидыПродукции);

	Если ВключенаПоддержкаМОТП Тогда

		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотВозвращен"));
		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Нанесен"));
		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.НанесенОплачен"));

		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотВозвращен"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Нанесен"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.НанесенОплачен"));

		ПараметрыСканирования.ВариантПолученияМРЦ             = "Вычисление";
		ПараметрыСканирования.ДопустимыПроверкиСеройЗоныМОТП  = Истина;

	КонецЕсли;

	Если ВключенаПоддержкаИСМП Тогда

		ПараметрыСканирования.ДопустимыеСтатусыИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ПараметрыСканирования.ДопустимыеСтатусыИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотПриВозврате"));

		ПараметрыСканирования.ДопустимыеСтатусыУпаковокИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотПриВозврате"));

		Для Каждого ВидПродукции Из ПараметрыСканирования.ДопустимыеВидыПродукции Цикл
			ПараметрыСканирования.ПоддерживаетсяОбъемноСортовойУчет = ПараметрыСканирования.ПоддерживаетсяОбъемноСортовойУчет
			Или КонструкторИСМПОбщегоНазначенияКлиентСервер.ПоддерживаетсяОбъемноСортовойУчет(ВидПродукции, ВидОперацииИСМП);
		КонецЦикла;

		ПараметрыСканирования.ЗапрашиватьКоличествоМерногоТовара = ОбщегоНазначенияИСМПКлиентСерверПовтИсп.НастройкиСканированияКодовМаркировки().ЗапрашиватьКоличествоМерногоТовара;
		ПараметрыСканирования.КонтролироватьРазрешительныеДокументыИСМП = Истина;

#Вставка
		// это параметр влияет на сохранение кодов маркировки в пул
		// доработка требуется для печати полных кодов маркировки если они будут повреждены
		ПараметрыСканирования.СохранятьКодыМаркировкиВПулИСМП = Истина;
#КонецВставки




	КонецЕсли;

	Если ВключенаПоддержкаИСМП Или ВключенаПоддержкаМОТП Тогда

		ПараметрыСканирования.СохранятьКодыМаркировкиВПулИСМП = Истина;

		// Для обогащения информации об ошибке при выводе пользователю
		ПараметрыСканирования.ВидОперацииИСМП                 = ВидОперацииИСМП;

		Если Контекст <> Неопределено И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Контекст, "Дата") Тогда
			ПараметрыСканирования.ДатаДокумента = Контекст.Дата;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ПараметрыСканирования.ДатаДокумента) Тогда
			ПараметрыСканирования.ДатаДокумента = ТекущаяДатаСУчетомКонтекста();
		КонецЕсли;

		НастроитьПараметрыСканированияПоРаздельномуКонтролю(ПараметрыСканирования, ВидыПродукции);

	КонецЕсли;

	Возврат ВключенаПоддержкаИСМП Или ВключенаПоддержкаМОТП;

КонецФункции

&ИзменениеИКонтроль("ЗаполнитьПараметрыСканированияДокументаЗакупки")
Функция Пикс_ЗаполнитьПараметрыСканированияДокументаЗакупки(ПараметрыСканирования, ВидыПродукции, Контекст)

	Если Не ИнтеграцияИСМПКлиентСерверПовтИсп.ВестиУчетМаркируемойПродукции() Тогда
		Возврат Ложь;
	КонецЕсли;

	ВидОперацииИСМП = ОбщегоНазначенияИСМПКлиентСерверПовтИсп.ВидОперацииЗакупка();

	ВключенаПоддержкаМОТП = ШтрихкодированиеОбщегоНазначенияМОТПКлиентСервер.ВключитьПоддержкуТабачнойПродукции(ПараметрыСканирования, ВидыПродукции,, ВидОперацииИСМП);
	ВключенаПоддержкаИСМП = ВключитьПоддержкуПродукцииИСМП(ПараметрыСканирования, ВидыПродукции);

	Если ВключенаПоддержкаМОТП Тогда

		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотВозвращен"));
		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Нанесен"));
		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.НанесенОплачен"));
		ПараметрыСканирования.ДопустимыеСтатусыМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.НанесенНеОплачен"));

		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотВозвращен"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.Нанесен"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.НанесенОплачен"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокМОТП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.НанесенНеОплачен"));

		ПараметрыСканирования.ДопустимыПроверкиСеройЗоныМОТП = Истина;

	КонецЕсли;

	Если ВключенаПоддержкаИСМП Тогда

		ПараметрыСканирования.ДопустимыеСтатусыИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ПараметрыСканирования.ДопустимыеСтатусыИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотПриВозврате"));
		ПараметрыСканирования.ДопустимыеСтатусыИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ОжидаетДоставки"));
		ПараметрыСканирования.ДопустимыеСтатусыИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ОжидаетПеремещенияМеждуМОД"));

		ПараметрыСканирования.ДопустимыеСтатусыУпаковокИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборот"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ВведенВОборотПриВозврате"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ОжидаетДоставки"));
		ПараметрыСканирования.ДопустимыеСтатусыУпаковокИСМП.Добавить(ПредопределенноеЗначение("Перечисление.СтатусыКодовМаркировкиИСМП.ОжидаетПеремещенияМеждуМОД"));

		Для Каждого ВидПродукции Из ПараметрыСканирования.ДопустимыеВидыПродукции Цикл
			ПараметрыСканирования.ПоддерживаетсяОбъемноСортовойУчет = ПараметрыСканирования.ПоддерживаетсяОбъемноСортовойУчет
			Или КонструкторИСМПОбщегоНазначенияКлиентСервер.ПоддерживаетсяОбъемноСортовойУчет(ВидПродукции, ВидОперацииИСМП);
		КонецЦикла;

		ПараметрыСканирования.ЗапрашиватьКоличествоМерногоТовара = ОбщегоНазначенияИСМПКлиентСерверПовтИсп.НастройкиСканированияКодовМаркировки().ЗапрашиватьКоличествоМерногоТовара;
		ПараметрыСканирования.КонтролироватьРазрешительныеДокументыИСМП = Истина;

#Вставка
		// это параметр влияет на сохранение кодов маркировки в пул
		// доработка требуется для печати полных кодов маркировки если они будут повреждены
		ПараметрыСканирования.СохранятьКодыМаркировкиВПулИСМП = Истина;
#КонецВставки

	КонецЕсли;

	Если ВключенаПоддержкаИСМП Или ВключенаПоддержкаМОТП Тогда

		// Для обогащения информации об ошибке при выводе пользователю
		ПараметрыСканирования.ВидОперацииИСМП = ВидОперацииИСМП;

		Если Контекст <> Неопределено И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Контекст, "Дата") Тогда
			ПараметрыСканирования.ДатаДокумента = Контекст.Дата;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ПараметрыСканирования.ДатаДокумента) Тогда
			ПараметрыСканирования.ДатаДокумента = ТекущаяДатаСУчетомКонтекста();
		КонецЕсли;

		НастроитьПараметрыСканированияПоРаздельномуКонтролю(ПараметрыСканирования, ВидыПродукции);

	КонецЕсли;

	Возврат ВключенаПоддержкаИСМП Или ВключенаПоддержкаМОТП;

КонецФункции
