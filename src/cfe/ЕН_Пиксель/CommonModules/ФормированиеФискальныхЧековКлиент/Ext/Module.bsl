
&ИзменениеИКонтроль("ДокументПроведен")
Функция Пикс_ДокументПроведен(ДополнительныеПараметры)

	ДокументПроведен = Истина;

#Удаление
	Если Не ДополнительныеПараметры.Форма.Объект.Проведен Или ДополнительныеПараметры.Форма.Модифицированность Тогда
		ДокументПроведен = Ложь;
	КонецЕсли;
#КонецУдаления
#Вставка
// Здесь можно описать новое поведение.
	Если Не ДополнительныеПараметры.Форма.Объект.Проведен и ТипЗнч(ДополнительныеПараметры.Форма.Объект.Ссылка) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") Или ДополнительныеПараметры.Форма.Модифицированность Тогда
		ДокументПроведен = Ложь;
	КонецЕсли;

#КонецВставки

	Возврат ДокументПроведен;

КонецФункции
