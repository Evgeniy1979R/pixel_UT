Функция ПолучитьСоглашениеПользователяПоУмолчанию(Пользователь) Экспорт
	
	Результат = Неопределено;
	РеквизитСоглашениеПоУмолчанию = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту(
		"Имя", "СоглашениеПоУмолчанию_a2a034a3b3374369ad60ceb32b3d8456"); 
	ЗначениеСоглашениеПоУмолчанию = УправлениеСвойствами.ЗначениеСвойства(Пользователь, РеквизитСоглашениеПоУмолчанию);
	Если ЗначениеЗаполнено(ЗначениеСоглашениеПоУмолчанию) Тогда 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СоглашенияСКлиентами.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	               |ГДЕ
	               |	СоглашенияСКлиентами.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", ЗначениеСоглашениеПоУмолчанию.Наименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() = Истина Тогда 
		Результат = Выборка.Ссылка;
	КонецЕсли;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуНаВнешнююОбработку(ИмяОбработки) Экспорт
	
	Результат = Неопределено;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяОбработки", ИмяОбработки);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
	               |ГДЕ
	               |	ДополнительныеОтчетыИОбработки.Наименование = &ИмяОбработки
	               |	И ДополнительныеОтчетыИОбработки.ПометкаУдаления = ЛОЖЬ
	               |	И ДополнительныеОтчетыИОбработки.ЭтоГруппа = Ложь";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Результат = Выборка.Ссылка;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

