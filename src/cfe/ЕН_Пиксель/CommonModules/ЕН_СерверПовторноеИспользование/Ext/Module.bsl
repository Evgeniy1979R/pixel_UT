Функция ПолучитьКассуККМ(Пользователь,Организация) Экспорт
	
	Результат = Неопределено;
	РеквизитНаименованиеКассы = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту(
		"Имя", "НаименованиеКассы_9f05617bfebf45fa9c73003ddd06a3fa"); 
	НаименованиеКассы = УправлениеСвойствами.ЗначениеСвойства(Пользователь, РеквизитНаименованиеКассы);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Кассы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Кассы КАК Кассы
	               |ГДЕ
	               |	Кассы.Наименование = &Наименование
	               |	И Кассы.Владелец = &Владелец
	               |	И Кассы.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Наименование", НаименованиеКассы);
	Запрос.УстановитьПараметр("Владелец", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() = Истина Тогда 
		Результат = Выборка.Ссылка;
	КонецЕсли;
	Возврат Результат;
	
КонецФункции 

