
&ИзменениеИКонтроль("НовоеЗащищенноеСоединение")
Функция Пикс_НовоеЗащищенноеСоединение(Знач СертификатКлиента, Знач СертификатыУдостоверяющихЦентров, Знач ВидСоединения)

	Если ЗначениеЗаполнено(ВидСоединения) Тогда
		ОжидаемыеЗначения = Новый Массив;
		ОжидаемыеЗначения.Добавить("OpenSSL");
		ОжидаемыеЗначения.Добавить("КриптоПро");
		ПроверитьПараметр("ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение", "ВидСоединения", ВидСоединения, Тип("Строка"),, ОжидаемыеЗначения);
	КонецЕсли;

	#Если ВебКлиент Или МобильныйКлиент Тогда

		Если ВидСоединения = "КриптоПро" Тогда
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Защищенное соединение %1 недоступно в веб-клиенте.'"),
			НСтр("ru = 'КриптоПро'"));
		КонецЕсли;

		Возврат Новый ЗащищенноеСоединениеOpenSSL; // Для обратной совместимости.
	#Иначе
		Если СертификатыУдостоверяющихЦентров = Неопределено Тогда
			ВерсииПлатформыДляИспользованияСертификатов = "8.3.24.1446";

			СистемнаяИнформация = Новый СистемнаяИнформация;
			ТекущийНомерВерсии = ВерсияКонфигурацииБезНомераСборки(СистемнаяИнформация.ВерсияПриложения);
			ИспользоватьСертификатыУдостоверяющихЦентров = Истина;

			Если СравнитьВерсииБезНомераСборки(ТекущийНомерВерсии, "8.3.25") < 0 Тогда
				Для Каждого НомерСборки Из СтрРазделить(ВерсииПлатформыДляИспользованияСертификатов, "; ", Ложь) Цикл
					Если СтрНачинаетсяС(НомерСборки, ТекущийНомерВерсии + ".") Тогда
						ИспользоватьСертификатыУдостоверяющихЦентров = 
						СравнитьВерсии(СистемнаяИнформация.ВерсияПриложения, НомерСборки) >= 0;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

			Если ИспользоватьСертификатыУдостоверяющихЦентров Тогда
				СертификатыУдостоверяющихЦентров = Новый СертификатыУдостоверяющихЦентровОС();
			КонецЕсли;
		КонецЕсли;

		Если ВидСоединения = "КриптоПро" Тогда
			СистемнаяИнформация = Новый СистемнаяИнформация;
			ЗащищенноеСоединениеКриптоПро = Неопределено;
			// АПК:547-выкл инструкция препроцессора допустима, так как в выполняемом коде нет обращения к модулям.
			#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
				УстановитьБезопасныйРежим(Истина);
			#КонецЕсли
			// АПК:487-выкл Поддержка новых методов платформы (исполняемый код безопасен)
			Выполнить("ЗащищенноеСоединениеКриптоПро = Новый ЗащищенноеСоединениеКриптоПро(СертификатКлиента, СертификатыУдостоверяющихЦентров, РежимПроверкиОтзываTLSСертификатаСервера.Строгий)");
			// АПК:487-вкл
			#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
				УстановитьБезопасныйРежим(Ложь);
			#КонецЕсли
			// АПК:547-вкл
			Возврат ЗащищенноеСоединениеКриптоПро;
		КонецЕсли;

#Удаление
		Возврат Новый ЗащищенноеСоединениеOpenSSL(СертификатКлиента, СертификатыУдостоверяющихЦентров, РежимПроверкиОтзываTLSСертификатаСервера.Строгий);
	
#КонецУдаления
#Вставка
// Здесь можно описать новое поведение.
		Возврат Новый ЗащищенноеСоединениеOpenSSL(СертификатКлиента, СертификатыУдостоверяющихЦентров, РежимПроверкиОтзываTLSСертификатаСервера.НеПроверять);
	

#КонецВставки
    #КонецЕсли
КонецФункции
