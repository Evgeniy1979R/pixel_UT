КонецПроцедуры

&НаКлиенте
Процедура ЕН_ОткрытФормуРасчетКоличествПоМассе (Команда)
	
	Если Не ЗначениеЗаполнено(Элементы.СписокСтандартныйПоискНоменклатура.ТекущиеДанные.Номенклатура) Тогда 
		
		ПоказатьПредупреждение(,"Не выбрана позиция номенклатуры",15,"Внимание");
		
	Иначе
		
		ОткрытьФорму("ОбщаяФорма.ЕН_ФормаРасчетаКоличестваПоМассе",Новый Структура("ПараметрНоменклатура",Элементы.СписокСтандартныйПоискНоменклатура.ТекущиеДанные.Номенклатура),
		ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЕН_ОткрытФормуРасчетКоличествПоМассеРасширенныйПоиск (Команда)
	
	Если Не ЗначениеЗаполнено(Элементы.СписокРасширенныйПоискНоменклатура.ТекущиеДанные.Номенклатура) Тогда 
		
		ПоказатьПредупреждение(,"Не выбрана позиция номенклатуры",15,"Внимание");
		
	Иначе
		
		ОткрытьФорму("ОбщаяФорма.ЕН_ФормаРасчетаКоличестваПоМассе",Новый Структура("ПараметрНоменклатура",Элементы.СписокРасширенныйПоискНоменклатура.ТекущиеДанные.Номенклатура),
		ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура  ЕН_ОткрытьОтчетДвиженияНоменклатуры(Команда)
	
	Результат = ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмениНаСервере();
	ИмяОбработкиСлужебное = Результат.ИмяОбработкиСлужебное;
	СсылкаНаВнешнийОтчет = Результат.СсылкаНаВнешнийОтчет;

	Если СсылкаНаВнешнийОтчет <> Неопределено Тогда 
		
		Если Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаСтандартныйПоискНоменклатура Тогда 
			СписокДляПечати  = Элементы.СписокСтандартныйПоискНоменклатура;
		ИначеЕсли Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаРасширенныйПоискНоменклатура Тогда 
			СписокДляПечати  = Элементы.СписокРасширенныйПоискНоменклатура;
		Иначе
			Возврат;
		КонецЕсли;

		МассивНоменклатуры = Новый Массив;
		Для Каждого эл из СписокДляПечати.ВыделенныеСтроки Цикл
			МассивНоменклатуры.Добавить(эл);
		КонецЦикла;
		ПараметрыОбработки = Новый Структура("ИдентификаторКоманды, ДополнительнаяОбработкаСсылка, ИмяФормы, КлючСессии,ОбъектыНазначения");
		ПараметрыОбработки.ИдентификаторКоманды          = "ДвиженияПоНоменклатуре";
		ПараметрыОбработки.ДополнительнаяОбработкаСсылка = СсылкаНаВнешнийОтчет;
		ПараметрыОбработки.ИмяФормы                      = Неопределено;
		ПараметрыОбработки.КлючСессии = УникальныйИдентификатор;
		ПараметрыОбработки.ОбъектыНазначения = МассивНоменклатуры;
		ОткрытьФорму("ВнешнийОтчет." + ИмяОбработкиСлужебное + ".Форма",ПараметрыОбработки, ЭтаФорма);
		
	КонецЕсли;			
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмениНаСервере()
	
	Возврат ЕН_СерверПовторноеИспользование.ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмени(ЕН_СерверПовторноеИспользование.ИмяВнешнегоОтчетаДвиженияПоНоменклатуре());
	
КонецФункции
