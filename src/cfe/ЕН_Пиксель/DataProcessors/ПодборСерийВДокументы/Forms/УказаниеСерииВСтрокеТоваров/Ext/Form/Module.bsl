//++НЕВ Без проверки ключа структуры КИЗ происходит ошибка при проверке серийных номеров
Процедура Пикс_ОбработатьШтрихкодыСерверЛокализация(ШтрихкодыПоТипам)
	//++ Локализация
	#Вставка
	Если ШтрихкодыПоТипам.Свойство("КиЗ") Тогда 
		
		#КонецВставки
		Если ШтрихкодыПоТипам.КиЗ.Количество() > 0 Тогда
			
			НомерКиЗГИСМ = ШтрихкодыПоТипам.КиЗ[0].ШтрихКод;
			Модифицированность = Истина;
			ПодобратьСериюСервер("НомерКиЗГИСМ");
			Если ЗначениеЗаполнено(Серия) Тогда
				ЗаполнитьРеквизитыПоСерии(ЭтаФорма, Серия, НастройкиИспользованияСерий);
			КонецЕсли;
			ЗаполнитьФлагиРаботыСМеткой();
			
		КонецЕсли;
		#Вставка
	КонецЕсли;
	#КонецВставки
	
	//-- Локализация
	
	Возврат;
	
КонецПроцедуры
