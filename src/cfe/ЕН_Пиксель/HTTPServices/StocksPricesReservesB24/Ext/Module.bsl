
Функция StocksPricesReservesB24GET(Запрос)
	Попытка
		Если Запрос.Заголовки.Получить("X-Bitrix-Token") = ЗначениеТокенаАвторизации()  Тогда  
			Ответ = Новый HTTPСервисОтвет(200);
			
			Ответ.Заголовки.Вставить("Content-type", "application/JSON; charset=utf-8");
			Ответ.УстановитьТелоИзСтроки(GetStocksAndReservations(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Иначе
			
			Ответ = Новый HTTPСервисОтвет(401,"Unauthorized");
			
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(ЕН_ДФИ.ПрефиксЖурналаРегистрации(),УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
		Ответ = Новый HTTPСервисОтвет(500,"Internal Server Error");
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

// =============================================================================
// Функция GetStocksAndReservations
// Назначение: возвращает полный JSON для веб-сервиса (Stocks + Reservations + Timestamp)
// Параметры:
//   - Нет
// Возвращает: Строка (JSON)
// =============================================================================
Функция GetStocksAndReservations() 
	ДатаВыгрузки = ТекущаяДата();
	МассивStocks = ПолучитьМассивStocks();
	МассивReservations = ПолучитьМассивReservations();
	_МетаДанные = Новый Структура;
	_МетаДанные.Вставить("Timestamp", ДатаВыгрузки);
	_МетаДанные.Вставить("Source", "1C:UT11");
	КорневойОбъект = Новый Структура;
	КорневойОбъект.Вставить("Timestamp", _МетаДанные.Timestamp);
	КорневойОбъект.Вставить("Source", _МетаДанные.Source);
	КорневойОбъект.Вставить("Stocks", МассивStocks);
	КорневойОбъект.Вставить("Reservations", МассивReservations);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, КорневойОбъект);
	Результат = ЗаписьJSON.Закрыть();
	Возврат Результат;
КонецФункции

// =============================================================================
// Функция ПолучитьМассивStocks
// Назначение: формирует массив остатков товаров по складам
// Возвращает: Массив
// =============================================================================
Функция ПолучитьМассивStocks() 
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыИПотребностиОстатки.Номенклатура) КАК ProductID,
	|	ЗапасыИПотребностиОстатки.Номенклатура.Наименование КАК ProductName,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыИПотребностиОстатки.Склад) КАК WarehouseID,
	|	ЗапасыИПотребностиОстатки.Склад.Наименование КАК WarehouseName,
	|	ЗапасыИПотребностиОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыИПотребностиОстатки.Склад КАК Склад,
	|	ЗапасыИПотребностиОстатки.ВНаличииОстаток - ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток КАК QuantityFree,
	|	ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток КАК QuantityReserved,
	|	ЗапасыИПотребностиОстатки.ВНаличииОстаток КАК QuantityOnHand,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних_Основная.Цена, 0) КАК Price,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних_Основная.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяССылка)) КАК Unit,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних_Основная.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))) КАК Currency,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних_ЯМ.Цена, 0) КАК PriceYM,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних_ЯМ.Упаковка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяССылка)) КАК UnitYM,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних_ЯМ.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))) КАК CurrencyYM
	|ИЗ
	|	РегистрНакопления.ЗапасыИПотребности.Остатки КАК ЗапасыИПотребностиОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ПериодЦен, ) КАК ЦеныНоменклатурыСрезПоследних_Основная
	|		ПО ЗапасыИПотребностиОстатки.Номенклатура = ЦеныНоменклатурыСрезПоследних_Основная.Номенклатура
	|			И (&ВидЦеныОсновная = ЦеныНоменклатурыСрезПоследних_Основная.ВидЦены)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ПериодЦен, ) КАК ЦеныНоменклатурыСрезПоследних_ЯМ
	|		ПО ЗапасыИПотребностиОстатки.Номенклатура = ЦеныНоменклатурыСрезПоследних_ЯМ.Номенклатура
	|			И (&ВидЦеныЯМ = ЦеныНоменклатурыСрезПоследних_ЯМ.ВидЦены)";
	Запрос.УстановитьПараметр("ВидЦеныОсновная", Справочники.ВидыЦен.ПолучитьСсылку(Новый УникальныйИдентификатор("f7055553-3f79-11de-a349-00e04d822e28")));
	Запрос.УстановитьПараметр("ВидЦеныЯМ", Справочники.ВидыЦен.ПолучитьСсылку(Новый УникальныйИдентификатор("14288f6d-feff-11e4-a839-002590a813d8")));
	Запрос.УстановитьПараметр("ПериодЦен", ТекущаяДата());
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальные = РезультатЗапроса.Выбрать();
	МассивStocks = Новый Массив;
	Пока ВыборкаДетальные.Следующий() Цикл
		ЗаписьStocks = Новый Структура;
		ЗаписьStocks.Вставить("ProductID",			Строка( ВыборкаДетальные.ProductID));
		ЗаписьStocks.Вставить("ProductName",		Строка(	ВыборкаДетальные.ProductName));
		ЗаписьStocks.Вставить("WarehouseID",		Строка(	ВыборкаДетальные.WarehouseID));
		ЗаписьStocks.Вставить("WarehouseName",		Строка( ВыборкаДетальные.WarehouseName));
		ЗаписьStocks.Вставить("Price",				ВыборкаДетальные.Price);
		ЗаписьStocks.Вставить("Currency",			Строка( ВыборкаДетальные.Currency));
		ЗаписьStocks.Вставить("Unit",				Строка( ВыборкаДетальные.Unit));
		ЗаписьStocks.Вставить("PriceYM",			Формат( ВыборкаДетальные.PriceYM,"ЧГ=0"));
		ЗаписьStocks.Вставить("UnitYM",				Строка( ВыборкаДетальные.UnitYM));
		ЗаписьStocks.Вставить("CurrencyYM",			Строка( ВыборкаДетальные.CurrencyYM));
		ЗаписьStocks.Вставить("QuantityOnHand",		ВыборкаДетальные.QuantityOnHand);
		ЗаписьStocks.Вставить("QuantityFree",		ВыборкаДетальные.QuantityFree);
		ЗаписьStocks.Вставить("QuantityReserved",	ВыборкаДетальные.QuantityReserved);
		МассивStocks.Добавить(ЗаписьStocks);
	КонецЦикла;
	Возврат МассивStocks;
КонецФункции

// =============================================================================
// Функция ПолучитьМассивReservations
// Назначение: формирует массив действующих резервов
// Возвращает: Массив
// =============================================================================
Функция ПолучитьМассивReservations() 
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыИПотребностиОстатки.Заказ) КАК ReservationID,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыИПотребностиОстатки.Номенклатура) КАК ProductID,
	|	ЗапасыИПотребностиОстатки.Номенклатура.Наименование КАК ProductName,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыИПотребностиОстатки.Склад) КАК WarehouseID,
	|	ЗапасыИПотребностиОстатки.Склад.Наименование КАК WarehouseName,
	|	ЗапасыИПотребностиОстатки.Номенклатура КАК Номенклатура,
	|	ЗапасыИПотребностиОстатки.Склад КАК Склад,
	|	ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток КАК QuantityReserved,
	|	ПРЕДСТАВЛЕНИЕ(ЗапасыИПотребностиОстатки.Заказ) КАК OrderID,
	|	ЗапасыИПотребностиОстатки.Заказ.Номер КАК OrderNumber,
	|	ЗапасыИПотребностиОстатки.Заказ.Дата КАК OrderDate,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыИПотребностиОстатки.Заказ.Партнер) КАК ClientID,
	|	ЗапасыИПотребностиОстатки.Заказ.Партнер.Наименование КАК ClientName,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыИПотребностиОстатки.Заказ.Контрагент) КАК KontragentID,
	|	ЗапасыИПотребностиОстатки.Заказ.Контрагент.Наименование КАК KontragentName,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗапасыИПотребностиОстатки.Заказ.Менеджер) КАК ManagerID,
	|	ЗапасыИПотребностиОстатки.Заказ.Менеджер.Наименование КАК ManagerName
	|ИЗ
	|	РегистрНакопления.ЗапасыИПотребности.Остатки КАК ЗапасыИПотребностиОстатки
	|ГДЕ
	|	ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток <> 0";
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальные = РезультатЗапроса.Выбрать();
	МассивReservations = Новый Массив;
	Пока ВыборкаДетальные.Следующий() Цикл
		ЗаписьReservation = Новый Структура;
		ЗаписьReservation.Вставить("ReservationID",		Строка(	ВыборкаДетальные.ReservationID));
		ЗаписьReservation.Вставить("ProductID", 		Строка( ВыборкаДетальные.ProductID));
		ЗаписьReservation.Вставить("ProductName",		Строка(	ВыборкаДетальные.ProductName));
		ЗаписьReservation.Вставить("WarehouseID",		Строка( ВыборкаДетальные.WarehouseID));
		ЗаписьReservation.Вставить("WarehouseName",		Строка( ВыборкаДетальные.WarehouseName));
		ЗаписьReservation.Вставить("QuantityReserved",	ВыборкаДетальные.QuantityReserved);
		ЗаписьReservation.Вставить("OrderID",			Строка( ВыборкаДетальные.OrderID));
		ЗаписьReservation.Вставить("OrderNumber",		Строка( ВыборкаДетальные.OrderNumber));
		ЗаписьReservation.Вставить("OrderDate",			ВыборкаДетальные.OrderDate);
		ЗаписьReservation.Вставить("ClientID",			Строка( ВыборкаДетальные.ClientID));
		ЗаписьReservation.Вставить("ClientName",		Строка(	ВыборкаДетальные.ClientName));
		ЗаписьReservation.Вставить("KontragentID",		Строка( ВыборкаДетальные.KontragentID));
		ЗаписьReservation.Вставить("KontragentName",	Строка( ВыборкаДетальные.KontragentName));
		ЗаписьReservation.Вставить("ManagerID",			Строка( ВыборкаДетальные.ManagerID));
		ЗаписьReservation.Вставить("ManagerName",		Строка( ВыборкаДетальные.ManagerName));
		МассивReservations.Добавить(ЗаписьReservation);
	КонецЦикла;
	Возврат МассивReservations;
КонецФункции

