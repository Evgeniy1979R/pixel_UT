#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
&НаСервере
Процедура Пикс_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	Попытка
		Если Объект.Ссылка.Пустая() Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	МАКСИМУМ(ПОДСТРОКА(КартыЛояльности.Штрихкод, 1, 12)) КАК Штрихкод
			|ИЗ
			|	Справочник.КартыЛояльности КАК КартыЛояльности
			|ГДЕ
			|	КартыЛояльности.Штрихкод ПОДОБНО ""24[2-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]%""";
			Выборка = Запрос.Выполнить().Выбрать();
			Штрихкод = "";
			Если Выборка.Следующий() = Истина Тогда 
				Штрихкод = Выборка.Штрихкод;
			КонецЕсли;
			Если ЗначениеЗаполнено(Штрихкод) = Ложь Тогда 
				Штрихкод = "242000000000";
			КонецЕсли;
			
			Попытка 
				Объект.Штрихкод = Формат(Число(Штрихкод)+1,"ЧГ=0");
			Исключение
				Сообщить(СтрШаблон("Не удалось подобрать номер карты. Предыдущее начение =%1",Штрихкод));
			КонецПопытки;
			Объект.Наименование = Объект.Штрихкод;
			Объект.Владелец		= Справочники.ВидыКартЛояльности.НайтиПоНаименованию("Штриховая");
			ПриВыбореВидаКартыЛояльности();
			СформироватьАвтонаименование(ЭтаФорма);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ЕН.ОшибкаДоработок",УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры
#КонецЕсли