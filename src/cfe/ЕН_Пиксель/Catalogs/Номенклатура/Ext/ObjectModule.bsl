
&После("ПриЗаписи")
Процедура Пикс_ПриЗаписи(Отказ)
	Если ДополнительныеСвойства.Свойство("НеРегистрироватьВОбменеССайтом_Пиксель") = Ложь Тогда 
	Запрос = Новый Запрос;
	
	НЗ_ИзмененнаяНоменклатура = РегистрыСведений.ЕН_ИзмененнаяНоменклатура.СоздатьНаборЗаписей();
	НЗ_ИзмененнаяНоменклатура.Отбор.Номенклатура.Использование = Истина;
	НЗ_ИзмененнаяНоменклатура.Отбор.Номенклатура.Значение = Ссылка;
	Запись = НЗ_ИзмененнаяНоменклатура.Добавить();
	Запись.Номенклатура = Ссылка;
	НЗ_ИзмененнаяНоменклатура.Записать(Истина);
		
	КонецЕсли;

КонецПроцедуры

