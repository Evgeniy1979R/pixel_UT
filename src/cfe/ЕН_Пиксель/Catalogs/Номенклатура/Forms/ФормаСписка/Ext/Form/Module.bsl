
&НаСервере
Процедура ЕНПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Попытка
		ЕН_ДФИ.СоздатьКоманду(ЭтаФорма,"ЕН_ОткрытьОтчетДвиженияНоменклатуры","Движения","ЕН_ОткрытьОтчетДвиженияНоменклатуры",
		Новый Структура("Картинка,Отображение", БиблиотекаКартинок.ЕН_РазделОтчетыИМониторинг16,ОтображениеКнопки.Картинка));
		ЕН_ДФИ.СздКнопка(ЭтаФорма,"ЕН_КнопкаОткрытьОтчетДвиженияНоменклатурыРасширенныйПоиск",Элементы.КоманднаяПанельСписокРасширенныйПоискНоменклатура,,
		"ЕН_ОткрытьОтчетДвиженияНоменклатуры",1,,Элементы.РасширенныйПоискКоманднаяПанельУстановитьФильтр);
		ЕН_ДФИ.СздКнопка(ЭтаФорма,"ЕН_КнопкаОткрытьОтчетДвиженияНоменклатурыСтандартныйПоиск",Элементы.СписокСтандартныйПоискНоменклатура.КоманднаяПанель,,
		"ЕН_ОткрытьОтчетДвиженияНоменклатуры",1,,Элементы.КоманднаяПанельСписокСтандартныйПоискНоменклатураФормаПоискПоШтрихкоду);	
	Исключение
		ЗаписьЖурналаРегистрации("ЕН.Ошибка создания элементов формы",УровеньЖурналаРегистрации.Ошибка,Метаданные.Справочники.Номенклатура,,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура  ЕН_ОткрытьОтчетДвиженияНоменклатуры(Команда)
	
	Результат = ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмениНаСервере();
	ИмяОбработкиСлужебное = Результат.ИмяОбработкиСлужебное;
	СсылкаНаВнешнийОтчет = Результат.СсылкаНаВнешнийОтчет;

	Если СсылкаНаВнешнийОтчет <> Неопределено Тогда 

		СписокДляПечати = ?(Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаРасширенныйПоискНоменклатура,
		Элементы.СписокРасширенныйПоискНоменклатура,
		Элементы.СписокСтандартныйПоискНоменклатура);
		МассивНоменклатуры = Новый Массив;
		Для Каждого эл из СписокДляПечати.ВыделенныеСтроки Цикл
			МассивНоменклатуры.Добавить(эл);
		КонецЦикла;
		ПараметрыОбработки = Новый Структура("ИдентификаторКоманды, ДополнительнаяОбработкаСсылка, ИмяФормы, КлючСессии,ОбъектыНазначения");
		ПараметрыОбработки.ИдентификаторКоманды          = "ДвиженияПоНоменклатуре";
		ПараметрыОбработки.ДополнительнаяОбработкаСсылка = СсылкаНаВнешнийОтчет;
		ПараметрыОбработки.ИмяФормы                      = Неопределено;
		ПараметрыОбработки.КлючСессии = УникальныйИдентификатор;
		ПараметрыОбработки.ОбъектыНазначения = МассивНоменклатуры;
		ОткрытьФорму("ВнешнийОтчет." + ИмяОбработкиСлужебное + ".Форма",ПараметрыОбработки, ЭтаФорма);
		
	КонецЕсли;			
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмениНаСервере()
	
	Возврат ЕН_СерверПовторноеИспользование.ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмени(ЕН_СерверПовторноеИспользование.ИмяВнешнегоОтчетаДвиженияПоНоменклатуре());
	
КонецФункции

