
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиБитыеСсылки(Команда)

	НайтиБитыеСсылкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьЗначение(Команда)

	ПодобратьЗначениеДляЗаменыНаСервере();

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаменитьБитыеСсылки(Команда)

	РезультатПоиска = Элементы.Результаты.ТекущиеДанные;

	Если РезультатПоиска = Неопределено Тогда
		Ждать ПредупреждениеАсинх("Выберите строку с битой ссылкой.", , "Замена битых ссылок");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НовоеЗначение) Тогда
		Ждать ПредупреждениеАсинх("Выберите значение для замены.", , "Замена битых ссылок");
		Возврат;
	КонецЕсли;

	Ответ = Ждать ВопросАсинх("Заменить битые ссылки: " + ОписаниеРезультатаПоиска(РезультатПоиска)
		+ "? Новое значение: " + Строка(НовоеЗначение), РежимДиалогаВопрос.ДаНет, 0, "Замена битых ссылок");

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	КоличествоЗамен = ЗаменитьБитыеСсылкиНаСервере(
		РезультатПоиска.ОбъектМетаданных,
		РезультатПоиска.ИмяПоля,
		РезультатПоиска.ИмяТабличнойЧасти,
		РезультатПоиска.ЭтоИзмерение);

	НайтиБитыеСсылкиНаСервере();

	Протокол = "Заменено записей: " + КоличествоЗамен + "." + Символы.ПС + Протокол;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НайтиБитыеСсылкиНаСервере()

	Результаты.Очистить();

	ТаблицаБитыхСсылок = Обработки.Б24_К_Администрирование.НайтиБитыеСсылки();

	Для Каждого ТекСтрока Из ТаблицаБитыхСсылок Цикл
		НоваяСтрока = Результаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;

	Если Результаты.Количество() = 0 Тогда
		НовоеЗначение = Неопределено;
		Протокол = "Битых ссылок не найдено.";
		Возврат;
	КонецЕсли;

	Протокол = "Найдено строк: " + Результаты.Количество()
		+ ". Выберите строку, подберите новое значение и нажмите «Заменить».";

	Элементы.Результаты.ТекущаяСтрока = Результаты[0];
	ПодобратьЗначениеДляЗаменыНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПодобратьЗначениеДляЗаменыНаСервере()

	РезультатПоиска = Элементы.Результаты.ТекущиеДанные;

	Если РезультатПоиска = Неопределено Тогда
		НовоеЗначение = Неопределено;
		Возврат;
	КонецЕсли;

	ПодобранноеЗначение = Обработки.Б24_К_Администрирование.ПодобратьЗначениеДляЗамены(РезультатПоиска.ТипСсылки);

	Если ПодобранноеЗначение = Неопределено Тогда
		НовоеЗначение = Неопределено;
		Протокол = "Подобрать значение автоматически не удалось: в объекте " + РезультатПоиска.ТипСсылки
			+ " нет единственного элемента. Выберите значение вручную.";
	Иначе
		НовоеЗначение = ПодобранноеЗначение;
		Протокол = "Для замены подобрано значение: " + Строка(ПодобранноеЗначение) + ".";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗаменитьБитыеСсылкиНаСервере(ОбъектМетаданных, ИмяПоля, ИмяТабличнойЧасти, ЭтоИзмерение)

	Возврат Обработки.Б24_К_Администрирование.ЗаменитьБитыеСсылки(
		ОбъектМетаданных,
		ИмяПоля,
		ИмяТабличнойЧасти,
		ЭтоИзмерение,
		НовоеЗначение);

КонецФункции

&НаКлиенте
Функция ОписаниеРезультатаПоиска(РезультатПоиска)

	Описание = РезультатПоиска.ОбъектМетаданных + ", поле «" + РезультатПоиска.ИмяПоля + "»";

	Если ЗначениеЗаполнено(РезультатПоиска.ИмяТабличнойЧасти) Тогда
		Описание = Описание + " (табличная часть " + РезультатПоиска.ИмяТабличнойЧасти + ")";
	КонецЕсли;

	Возврат Описание + ", записей: " + РезультатПоиска.КоличествоЗаписей;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НовоеЗначение = Неопределено;
	Протокол = "Нажмите «Найти битые ссылки» — инструмент проверит объекты модуля интеграции.";

КонецПроцедуры

#КонецОбласти
