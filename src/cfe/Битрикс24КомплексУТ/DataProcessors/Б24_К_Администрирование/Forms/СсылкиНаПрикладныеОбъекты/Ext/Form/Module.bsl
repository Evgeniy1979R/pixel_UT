
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипДекорацияФормы = Тип("ДекорацияФормы");
	
	Для каждого ТекРегистр Из Метаданные.РегистрыСведений Цикл
		
		ПрефИмени = Лев(ТекРегистр.Имя, 5);
		Если ПрефИмени = "Б24_К" ИЛИ ПрефИмени = "Б24_С" ИЛИ  ПрефИмени = "Б24_У" Тогда
			
			ИмяЭлемента = "Декорация_" + ТекРегистр.Имя;
			
			НовыйЭлемент 			= Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"));
			НовыйЭлемент.Вид 		= ВидДекорацииФормы.Надпись;
			НовыйЭлемент.Гиперссылка= Истина;
			НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_ДекорацияНажатие");		
			НовыйЭлемент.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
			
			Если Лев(ТекРегистр.Имя, 6) = "Б24_К_" Тогда
				НовыйЭлемент.Заголовок	= СокрЛП(СтрЗаменить(ТекРегистр.Синоним,"(Битрикс24: Базовая подсистема)",""));
				Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаОбщие); 
			ИначеЕсли Лев(ТекРегистр.Имя, 7) = "Б24_КА_" Тогда
				НовыйЭлемент.Заголовок	= СтрЗаменить(ТекРегистр.Синоним,"(Битрикс24: Автоматизация)","");
				Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаАвтоматизация); 
			ИначеЕсли Лев(ТекРегистр.Имя, 7) = "Б24_КБ_" Тогда
				НовыйЭлемент.Заголовок	= СтрЗаменить(ТекРегистр.Синоним,"(Битрикс24: Интеграция сервисов)","");
				Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаИнтеграцияСервисов); 
			ИначеЕсли Лев(ТекРегистр.Имя, 7) = "Б24_КС_" Тогда
				НовыйЭлемент.Заголовок	= СтрЗаменить(ТекРегистр.Синоним,"(Битрикс24: Синхронизация)","");
				Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаСинхронизация); 
			ИначеЕсли Лев(ТекРегистр.Имя, 7) = "Б24_КЭ_" Тогда
				НовыйЭлемент.Заголовок	= СтрЗаменить(ТекРегистр.Синоним,"(Битрикс24: Экспорт печатных форм в Битрикс24)","");
				Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаЭкспорт); 
			ИначеЕсли Лев(ТекРегистр.Имя, 7) = "Б24_СМ_" Тогда
				НовыйЭлемент.Заголовок	= СтрЗаменить(ТекРегистр.Синоним,"(Битрикс24: Смарт процессы)","");
				Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаСмартПроцессы);           
			ИначеЕсли Лев(ТекРегистр.Имя, 7) = "Б24_СУ_" Тогда
				НовыйЭлемент.Заголовок	= СтрЗаменить(ТекРегистр.Синоним,"(Битрикс24: СУ)","");
				Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаСУ);				
			ИначеЕсли Лев(ТекРегистр.Имя, 7) = "Б24_УП_" Тогда
				ГруппаУП = Элементы.Найти("ГруппаУП");
				Если ГруппаУП <> Неопределено Тогда
					НовыйЭлемент.Заголовок	= СтрЗаменить(ТекРегистр.Синоним,"(Битрикс24: КЭДО)","");
					Элементы.Переместить(НовыйЭлемент, ГруппаУП); 
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияНажатие(Элемент)
	
	ИмяРегистра = Прав(Элемент.Имя, СтрДлина(Элемент.Имя) -10);
	
	ОткрытьФорму("РегистрСведений."+ИмяРегистра+".ФормаСписка");
	
КонецПроцедуры
