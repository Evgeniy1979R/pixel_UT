#КонецОбласти


// Возвращает таблицу переименования объектов старого модуля интеграции в объекты текущей конфигурации.
//
// Таблица берётся из макета ТрансляцияОбъектовИзСтарогоМодуля. Макет есть не во всех расширениях
// (в УНФ его нет), поэтому его отсутствие не должно срывать импорт данных модуля.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки "Старый" и "Новый"; пустая таблица, если макет недоступен.
//
Функция ТаблицаТрансляцииОбъектовИзСтарогоМодуля() Экспорт

	Попытка

		Макет = ПолучитьМакет("ТрансляцияОбъектовИзСтарогоМодуля");
		Данные = Макет.ПолучитьОбласть("Данные");

		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Вывести(Данные);

		Построитель = Новый ПостроительЗапроса;
		Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область());

		Возврат Построитель.Результат.Выгрузить();

	Исключение

		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("Старый");
		Таблица.Колонки.Добавить("Новый");

		Возврат Таблица;

	КонецПопытки;

КонецФункции

#КонецЕсли
