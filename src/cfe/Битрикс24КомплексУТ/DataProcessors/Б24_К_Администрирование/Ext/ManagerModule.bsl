
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ЭкспортИмпортДанных

Процедура ПолучитьДанныеМодуляДляЭкспортаВФайл(СтрокаJson, АдресРезультата) Экспорт

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ОбъектXML = Новый ЗаписьXML();
	ОбъектXML.УстановитьСтроку("UTF-8");
	ОбъектXML.ЗаписатьОбъявлениеXML();

	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("РегистрыСведений"	, Новый Соответствие);
	СтруктураДанных.Вставить("Справочники"		, Новый Соответствие);
	СтруктураДанных.Вставить("Документы"		, Новый Соответствие);
	СтруктураДанных.Вставить("Константы"		, Новый Соответствие);

	Для каждого ТекОбъект Из Метаданные.РегистрыСведений Цикл

		Если Лев(ТекОбъект.Имя, 4) = "Б24_" Тогда

			Если ТекОбъект.Имя = "Б24_К_ЖурналОшибок" ИЛИ ТекОбъект.Имя = "Б24_К_Логирование" Тогда
				ОбщегоНазначения.СообщитьПользователю("Для оптимизации информационный регистр сведений: " + ТекОбъект.Имя + " не выгружается.");
				Продолжить;
			КонецЕсли;

			СтруктураДанных.РегистрыСведений.Вставить(ТекОбъект.Имя, Новый Массив);

			Выборка = РегистрыСведений[ТекОбъект.Имя].Выбрать();
			Пока Выборка.Следующий() Цикл

				ДанныеЗаписи = Новый Структура;

				Для каждого ТекРеквизит Из Метаданные.РегистрыСведений[ТекОбъект.Имя].СтандартныеРеквизиты Цикл
					ДанныеЗаписи.Вставить(ТекРеквизит.Имя, ЗначениеВСтрокуВнутр(Выборка[ТекРеквизит.Имя]));
				КонецЦикла;

				Для каждого ТекРеквизит Из Метаданные.РегистрыСведений[ТекОбъект.Имя].Измерения Цикл
					ДанныеЗаписи.Вставить(ТекРеквизит.Имя, ЗначениеВСтрокуВнутр(Выборка[ТекРеквизит.Имя]));
				КонецЦикла;

				Для каждого ТекРеквизит Из Метаданные.РегистрыСведений[ТекОбъект.Имя].Ресурсы Цикл
					ДанныеЗаписи.Вставить(ТекРеквизит.Имя, ЗначениеВСтрокуВнутр(Выборка[ТекРеквизит.Имя]));
				КонецЦикла;

				Для каждого ТекРеквизит Из Метаданные.РегистрыСведений[ТекОбъект.Имя].Реквизиты Цикл
					ДанныеЗаписи.Вставить(ТекРеквизит.Имя, ЗначениеВСтрокуВнутр(Выборка[ТекРеквизит.Имя]));
				КонецЦикла;

				СтруктураДанных.РегистрыСведений[ТекОбъект.Имя].Добавить(ДанныеЗаписи);

			КонецЦикла;

		КонецЕсли;

	КонецЦикла;

	Для каждого ТекОбъект Из Метаданные.Справочники Цикл

		Если Лев(ТекОбъект.Имя, 4) = "Б24_" Тогда

			СтруктураДанных.Справочники.Вставить(ТекОбъект.Имя, Новый Массив);

			Выборка = Справочники[ТекОбъект.Имя].Выбрать();
			Пока Выборка.Следующий() Цикл

				ДанныеЗаписи = Новый Структура;
				ДанныеЗаписи.Вставить("Ссылка"			, ЗначениеВСтрокуВнутр(XMLСтрока(Выборка.Ссылка)));
				ДанныеЗаписи.Вставить("Код"				, ЗначениеВСтрокуВнутр(Выборка.Код));
				ДанныеЗаписи.Вставить("Наименование"	, ЗначениеВСтрокуВнутр(Выборка.Наименование));
				ДанныеЗаписи.Вставить("Владелец"		, ЗначениеВСтрокуВнутр(Выборка.Владелец));
				ДанныеЗаписи.Вставить("ЭтоГруппа"		, ЗначениеВСтрокуВнутр(Выборка.ЭтоГруппа));
				ДанныеЗаписи.Вставить("Реквизиты"		, Новый Структура);
				ДанныеЗаписи.Вставить("ТабличныеЧасти"	, Новый Структура);

				Для каждого ТекРеквизит Из Метаданные.Справочники[ТекОбъект.Имя].СтандартныеРеквизиты Цикл

					Если ТекРеквизит.Имя = "Предопределенный" ИЛИ ТекРеквизит.Имя = "ИмяПредопределенныхДанных" ИЛИ ТекРеквизит.Имя = "Ссылка" Тогда
						Продолжить;
					КонецЕсли;

					ДанныеЗаписи.Реквизиты.Вставить(ТекРеквизит.Имя, ЗначениеВСтрокуВнутр(Выборка[ТекРеквизит.Имя]));

				КонецЦикла;

				Для каждого ТекРеквизит Из Метаданные.Справочники[ТекОбъект.Имя].Реквизиты Цикл
					ДанныеЗаписи.Реквизиты.Вставить(ТекРеквизит.Имя, ЗначениеВСтрокуВнутр(Выборка[ТекРеквизит.Имя]));
				КонецЦикла;

				Для Каждого ТабличнаяЧасть Из Метаданные.Справочники[ТекОбъект.Имя].ТабличныеЧасти Цикл

					ДанныеЗаписи.ТабличныеЧасти.Вставить(ТабличнаяЧасть.Имя, Новый Массив);

					Для Каждого СтрокаТЧ Из Выборка[ТабличнаяЧасть.Имя] Цикл

						ДанныеЗаписиСтроки = Новый Структура;

						Для каждого ТекРеквизит Из Метаданные.Справочники[ТекОбъект.Имя].ТабличныеЧасти[ТабличнаяЧасть.Имя].СтандартныеРеквизиты Цикл
							ДанныеЗаписиСтроки.Вставить(ТекРеквизит.Имя, ЗначениеВСтрокуВнутр(СтрокаТЧ[ТекРеквизит.Имя]));
						КонецЦикла;

						Для каждого ТекРеквизит Из Метаданные.Справочники[ТекОбъект.Имя].ТабличныеЧасти[ТабличнаяЧасть.Имя].Реквизиты Цикл

							ДанныеЗаписиСтроки.Вставить(ТекРеквизит.Имя, ЗначениеВСтрокуВнутр(СтрокаТЧ[ТекРеквизит.Имя]));

						КонецЦикла;

						ДанныеЗаписи.ТабличныеЧасти[ТабличнаяЧасть.Имя].Добавить(ДанныеЗаписиСтроки);

					КонецЦикла;

				КонецЦикла;

				СтруктураДанных.Справочники[ТекОбъект.Имя].Добавить(ДанныеЗаписи);

			КонецЦикла;

		КонецЕсли;

	КонецЦикла;

	Для каждого ТекОбъект Из Метаданные.Константы Цикл
		Если Лев(ТекОбъект.Имя, 4) = "Б24_" Тогда
			СтруктураДанных.Константы.Вставить(ТекОбъект.Имя, ЗначениеВСтрокуВнутр(Константы[ТекОбъект.Имя].Получить()));
		КонецЕсли;
	КонецЦикла;

#Область Документы
Если ТипКонфигурации = "БП" Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СчетНаОплатуПокупателюТовары.Ссылка КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	|ГДЕ
	|	СчетНаОплатуПокупателюТовары.Б24_К_ИдентификаторПозиции <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетНаОплатуПокупателюТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Документ КАК Документ,
	|	СчетНаОплатуПокупателю.Номер КАК Номер,
	|	СчетНаОплатуПокупателю.Дата КАК Дата,
	|	СчетНаОплатуПокупателю.Товары.(
	|		Б24_К_ИдентификаторПозиции КАК Б24_К_ИдентификаторПозиции,
	|		Б24_К_КлючСвязи КАК Б24_К_КлючСвязи,
	|		НомерСтроки КАК НомерСтроки
	|	) КАК Товары
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы
	|		ПО (ВТ_Документы.Документ = СчетНаОплатуПокупателю.Ссылка)";
	ВыполненныйЗапрос = Запрос.Выполнить();

	Если НЕ ВыполненныйЗапрос.Пустой() Тогда

		СтруктураДанных.Документы.Вставить("СчетНаОплатуПокупателю", Новый Массив);

		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл

			ДанныеЗаписи = Новый Структура;
			ДанныеЗаписи.Вставить("Дата"			, ЗначениеВСтрокуВнутр(Выборка.Дата));
			ДанныеЗаписи.Вставить("Номер"			, ЗначениеВСтрокуВнутр(Выборка.Номер));
			ДанныеЗаписи.Вставить("Реквизиты"		, Новый Структура);
			ДанныеЗаписи.Вставить("ТабличныеЧасти"	, Новый Структура);

			ДанныеЗаписи.Вставить("ТабличныеЧасти", Новый Структура);
			ДанныеЗаписи.ТабличныеЧасти.Вставить("Товары", Новый Массив);

			ВыборкаТЧ = Выборка.Товары.Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл
				ДанныеЗаписиСтроки = Новый Структура;
				ДанныеЗаписиСтроки.Вставить("НомерСтроки", ЗначениеВСтрокуВнутр(ВыборкаТЧ.НомерСтроки));
				ДанныеЗаписиСтроки.Вставить("Б24_К_ИдентификаторПозиции", ЗначениеВСтрокуВнутр(ВыборкаТЧ.Б24_К_ИдентификаторПозиции));
				ДанныеЗаписиСтроки.Вставить("Б24_К_КлючСвязи", ЗначениеВСтрокуВнутр(ВыборкаТЧ.Б24_К_КлючСвязи));
				ДанныеЗаписи.ТабличныеЧасти["Товары"].Добавить(ДанныеЗаписиСтроки);
			КонецЦикла;

			СтруктураДанных.Документы["СчетНаОплатуПокупателю"].Добавить(ДанныеЗаписи);

		КонецЦикла;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Ссылка КАК Документ
	|ПОМЕСТИТЬ ВТ_ДокументыВсе
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Б24_К_КлючСвязи <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугТовары.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугУслуги.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	|ГДЕ
	|	РеализацияТоваровУслугУслуги.Б24_К_КлючСвязи <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДокументыВсе.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	ВТ_ДокументыВсе КАК ВТ_ДокументыВсе
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДокументыВсе.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Документ КАК Документ,
	|	РеализацияТоваровУслуг.Номер КАК Номер,
	|	РеализацияТоваровУслуг.Дата КАК Дата,
	|	РеализацияТоваровУслуг.Товары.(
	|		Б24_К_КлючСвязи КАК Б24_К_КлючСвязи,
	|		НомерСтроки КАК НомерСтроки
	|	) КАК Товары,
	|	РеализацияТоваровУслуг.Услуги.(
	|		Б24_К_КлючСвязи КАК Б24_К_КлючСвязи,
	|		НомерСтроки КАК НомерСтроки
	|	) КАК Услуги
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы
	|		ПО (ВТ_Документы.Документ = РеализацияТоваровУслуг.Ссылка)";
	ВыполненныйЗапрос = Запрос.Выполнить();

	Если НЕ ВыполненныйЗапрос.Пустой() Тогда

		СтруктураДанных.Документы.Вставить("РеализацияТоваровУслуг", Новый Массив);

		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл

			ДанныеЗаписи = Новый Структура;
			ДанныеЗаписи.Вставить("Дата"			, ЗначениеВСтрокуВнутр(Выборка.Дата));
			ДанныеЗаписи.Вставить("Номер"			, ЗначениеВСтрокуВнутр(Выборка.Номер));
			ДанныеЗаписи.Вставить("Реквизиты"		, Новый Структура);
			ДанныеЗаписи.Вставить("ТабличныеЧасти"	, Новый Структура);

			ДанныеЗаписи.Вставить("ТабличныеЧасти", Новый Структура);
			ДанныеЗаписи.ТабличныеЧасти.Вставить("Товары", Новый Массив);

			ВыборкаТЧ = Выборка.Товары.Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл
				ДанныеЗаписиСтроки = Новый Структура;
				ДанныеЗаписиСтроки.Вставить("НомерСтроки", ЗначениеВСтрокуВнутр(ВыборкаТЧ.НомерСтроки));
				ДанныеЗаписиСтроки.Вставить("Б24_К_КлючСвязи", ЗначениеВСтрокуВнутр(ВыборкаТЧ.Б24_К_КлючСвязи));
				ДанныеЗаписи.ТабличныеЧасти["Товары"].Добавить(ДанныеЗаписиСтроки);
			КонецЦикла;

			ДанныеЗаписи.ТабличныеЧасти.Вставить("Услуги", Новый Массив);

			ВыборкаТЧ = Выборка.Услуги.Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл
				ДанныеЗаписиСтроки = Новый Структура;
				ДанныеЗаписиСтроки.Вставить("НомерСтроки", ЗначениеВСтрокуВнутр(ВыборкаТЧ.НомерСтроки));
				ДанныеЗаписиСтроки.Вставить("Б24_К_КлючСвязи", ЗначениеВСтрокуВнутр(ВыборкаТЧ.Б24_К_КлючСвязи));
				ДанныеЗаписи.ТабличныеЧасти["Товары"].Добавить(ДанныеЗаписиСтроки);
			КонецЦикла;

			СтруктураДанных.Документы["РеализацияТоваровУслуг"].Добавить(ДанныеЗаписи);

		КонецЦикла;

	КонецЕсли;
ИначеЕсли ТипКонфигурации = "УТ" Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Б24_К_ИдентификаторПозиции <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Документ КАК Документ,
	|	ЗаказКлиента.Дата КАК Дата,
	|	ЗаказКлиента.Номер КАК Номер,
	|	ЗаказКлиента.Товары.(
	|		Б24_К_ИдентификаторПозиции КАК Б24_К_ИдентификаторПозиции,

	|		НомерСтроки КАК НомерСтроки
	|	) КАК Товары
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы
	|		ПО (ВТ_Документы.Документ = ЗаказКлиента.Ссылка)";
	ВыполненныйЗапрос = Запрос.Выполнить();

	Если НЕ ВыполненныйЗапрос.Пустой() Тогда

		СтруктураДанных.Документы.Вставить("ЗаказКлиента", Новый Массив);

		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл

			ДанныеЗаписи = Новый Структура;
			ДанныеЗаписи.Вставить("Дата"			, ЗначениеВСтрокуВнутр(Выборка.Дата));
			ДанныеЗаписи.Вставить("Номер"			, ЗначениеВСтрокуВнутр(Выборка.Номер));
			ДанныеЗаписи.Вставить("Реквизиты"		, Новый Структура);
			ДанныеЗаписи.Вставить("ТабличныеЧасти"	, Новый Структура);
			ДанныеЗаписи.ТабличныеЧасти.Вставить("Товары", Новый Массив);

			ВыборкаТЧ = Выборка.Товары.Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл
				ДанныеЗаписиСтроки = Новый Структура;
				ДанныеЗаписиСтроки.Вставить("НомерСтроки", ЗначениеВСтрокуВнутр(ВыборкаТЧ.НомерСтроки));
				ДанныеЗаписиСтроки.Вставить("Б24_К_ИдентификаторПозиции", ЗначениеВСтрокуВнутр(ВыборкаТЧ.Б24_К_ИдентификаторПозиции));
				ДанныеЗаписи.ТабличныеЧасти["Товары"].Добавить(ДанныеЗаписиСтроки);
			КонецЦикла;

			СтруктураДанных.Документы["ЗаказКлиента"].Добавить(ДанныеЗаписи);

		КонецЦикла;
	КонецЕсли;
