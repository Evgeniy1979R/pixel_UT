	|	ЗаказПокупателя.Запасы.(
	|		Б24_К_ИдентификаторПозиции КАК Б24_К_ИдентификаторПозиции,
	|		НомерСтроки КАК НомерСтроки
	|	) КАК Запасы
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы
	|		ПО (ВТ_Документы.Документ = ЗаказПокупателя.Ссылка)"; 
	ВыполненныйЗапрос = Запрос.Выполнить();

	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		СтруктураДанных.Документы.Вставить("ЗаказПокупателя", Новый Массив);
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ДанныеЗаписи = Новый Структура;    
			ДанныеЗаписи.Вставить("Дата"			, ЗначениеВСтрокуВнутр(Выборка.Дата)); 	 
			ДанныеЗаписи.Вставить("Номер"			, ЗначениеВСтрокуВнутр(Выборка.Номер)); 	 
			ДанныеЗаписи.Вставить("Реквизиты"		, Новый Структура);
			ДанныеЗаписи.Вставить("ТабличныеЧасти"	, Новый Структура);  
			
			
			ДанныеЗаписи.ТабличныеЧасти.Вставить("Запасы", Новый Массив);
			
			ВыборкаТЧ = Выборка.Запасы.Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл    
				ДанныеЗаписиСтроки = Новый Структура;
				ДанныеЗаписиСтроки.Вставить("НомерСтроки", ЗначениеВСтрокуВнутр(ВыборкаТЧ.НомерСтроки)); 
				ДанныеЗаписиСтроки.Вставить("Б24_К_ИдентификаторПозиции", ЗначениеВСтрокуВнутр(ВыборкаТЧ.Б24_К_ИдентификаторПозиции)); 
				ДанныеЗаписи.ТабличныеЧасти["Запасы"].Добавить(ДанныеЗаписиСтроки);
			КонецЦикла;
			
			СтруктураДанных.Документы["ЗаказПокупателя"].Добавить(ДанныеЗаписи);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СчетНаОплатуЗапасы.Ссылка КАК Документ
	|ПОМЕСТИТЬ ВТ_Документы
	|ИЗ
	|	Документ.СчетНаОплату.Запасы КАК СчетНаОплатуЗапасы
	|ГДЕ
	|	СчетНаОплатуЗапасы.Б24_К_ИдентификаторПозиции <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	СчетНаОплатуЗапасы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документы.Документ КАК Документ,
	|	СчетНаОплату.Номер КАК Номер,
	|	СчетНаОплату.Дата КАК Дата,
	|	СчетНаОплату.Запасы.(
	|		Б24_К_ИдентификаторПозиции КАК Б24_К_ИдентификаторПозиции,
	|		НомерСтроки КАК НомерСтроки
	|	) КАК Запасы
	|ИЗ
	|	Документ.СчетНаОплату КАК СчетНаОплату
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Документы КАК ВТ_Документы
	|		ПО (ВТ_Документы.Документ = СчетНаОплату.Ссылка)"; 
	ВыполненныйЗапрос = Запрос.Выполнить();

	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		СтруктураДанных.Документы.Вставить("СчетНаОплату", Новый Массив);
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ДанныеЗаписи = Новый Структура;    
			ДанныеЗаписи.Вставить("Дата"			, ЗначениеВСтрокуВнутр(Выборка.Дата)); 	 
			ДанныеЗаписи.Вставить("Номер"			, ЗначениеВСтрокуВнутр(Выборка.Номер)); 	 
			ДанныеЗаписи.Вставить("Реквизиты"		, Новый Структура);
			ДанныеЗаписи.Вставить("ТабличныеЧасти"	, Новый Структура);
			
			ДанныеЗаписи.Вставить("ТабличныеЧасти", Новый Структура);
			ДанныеЗаписи.ТабличныеЧасти.Вставить("Запасы", Новый Массив);
			
			ВыборкаТЧ = Выборка.Запасы.Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл    
				ДанныеЗаписиСтроки = Новый Структура;            
				ДанныеЗаписиСтроки.Вставить("НомерСтроки", ЗначениеВСтрокуВнутр(ВыборкаТЧ.НомерСтроки)); 
				ДанныеЗаписиСтроки.Вставить("Б24_К_ИдентификаторПозиции", ЗначениеВСтрокуВнутр(ВыборкаТЧ.Б24_К_ИдентификаторПозиции)); 
				ДанныеЗаписи.ТабличныеЧасти["Запасы"].Добавить(ДанныеЗаписиСтроки);
			КонецЦикла;
			
			СтруктураДанных.Документы["СчетНаОплату"].Добавить(ДанныеЗаписи);
			
		КонецЦикла;
		
	КонецЕсли;  
	КонецЕсли;
#КонецОбласти

	Поток = Новый ПотокВПамяти;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьПоток(Поток,,, Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	ЗаписьJSON.Закрыть();

	ДвоичныеДанные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	ИмяФайла = ПолучитьИмяВременногоФайла("json");
	ДвоичныеДанные.Записать(ИмяФайла);

	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	ЗаписьZipФайла.Добавить(ИмяФайла);
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	УдалитьФайлы(ИмяФайла);

	ПоместитьВоВременноеХранилище(ДвоичныеДанные, АдресРезультата);

КонецПроцедуры

Процедура ИмпортДанныхВМодульИзФайла(ЗагружаемыеДанные, АдресРезультата) Экспорт

	// Карта соответствия ссылок и типов старого модуля интеграции текущей конфигурации:
	// объекты модуля версии 5.0 созданы заново, поэтому ссылки из файла выгрузки
	// без трансляции не восстанавливаются.
	КартаСсылок = Новый Соответствие;
	КартаТипов 	= КартаТиповИзСтарогоМодуля();

	ТабДанные = ТаблицаТрансляцииОбъектовИзСтарогоМодуля();

	Если Метаданные.Константы.Найти("Б24_К_ИспользованиеКЭДО") <> Неопределено Тогда
		Константы["Б24_К_ИспользованиеКЭДО"].Установить(Истина);
	КонецЕсли;
	Если Метаданные.Константы.Найти("Б24_УП_ПоказыватьРасчетныеЛисткиОстаткиОтпуска") <> Неопределено Тогда
		Константы["Б24_УП_ПоказыватьРасчетныеЛисткиОстаткиОтпуска"].Установить(Истина);
	КонецЕсли;

	Для каждого ТекВидСправочника Из ЗагружаемыеДанные.Получить("Справочники") Цикл

		Для каждого ТекСправочник Из ТекВидСправочника.Значение Цикл

			КодСправочника 			= ЗначениеИзСтрокиВнутр(ТекСправочник.Получить("Код"));
			НаименованиеСправочника = ЗначениеИзСтрокиВнутр(ТекСправочник.Получить("Наименование"));
			Владелец 				= ЗначениеИзСтрокиВнутр(ТекСправочник.Получить("Владелец"));
			ЭтоГруппа 				= ЗначениеИзСтрокиВнутр(ТекСправочник.Получить("ЭтоГруппа"));
			Ссылка 					= УИДЭлементаИзФайла(ТекСправочник.Получить("Ссылка"));

			ТекВидСправочникаКлюч = ТекВидСправочника.Ключ;

			Найдено = ТабДанные.Найти(ТекВидСправочникаКлюч);
			Если ЗначениеЗаполнено(Найдено) Тогда
				ТекВидСправочникаКлюч = Найдено.Новый;
			КонецЕсли;

			Если ЗначениеЗаполнено(КодСправочника) И ЗначениеЗаполнено(Владелец) Тогда
				СправочникСсылка = Справочники[ТекВидСправочникаКлюч].НайтиПоКоду(КодСправочника,,, Владелец);
			ИначеЕсли ЗначениеЗаполнено(КодСправочника) И НЕ ЗначениеЗаполнено(Владелец) Тогда
				СправочникСсылка = Справочники[ТекВидСправочникаКлюч].НайтиПоКоду(КодСправочника);
			ИначеЕсли НЕ ЗначениеЗаполнено(КодСправочника) И ЗначениеЗаполнено(Владелец) Тогда
				СправочникСсылка = Справочники[ТекВидСправочникаКлюч].НайтиПоНаименованию(НаименованиеСправочника, Истина,, Владелец);
			ИначеЕсли НЕ ЗначениеЗаполнено(КодСправочника) И НЕ ЗначениеЗаполнено(Владелец) Тогда
				СправочникСсылка = Справочники[ТекВидСправочникаКлюч].НайтиПоНаименованию(НаименованиеСправочника, Истина);
			КонецЕсли;

			Если ЗначениеЗаполнено(СправочникСсылка) Тогда
				СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
			Иначе

				Если ЭтоГруппа Тогда
					СправочникОбъект = Справочники[ТекВидСправочникаКлюч].СоздатьГруппу();
				Иначе
					СправочникОбъект = Справочники[ТекВидСправочникаКлюч].СоздатьЭлемент();
				КонецЕсли;

				Если ЗначениеЗаполнено(Ссылка) Тогда
					Попытка
						НовыйУИД = Новый УникальныйИдентификатор(Ссылка);
					Исключение
						НовыйУИД = Неопределено;
					КонецПопытки;
					Если НовыйУИД <> Неопределено Тогда
						СправочникОбъект.УстановитьСсылкуНового(Справочники[ТекВидСправочникаКлюч].ПолучитьСсылку(НовыйУИД));
					КонецЕсли;
				КонецЕсли;

			КонецЕсли;

			ДополнитьКартуСсылокИзСтарогоМодуля(КартаСсылок, Справочники[ТекВидСправочникаКлюч], Ссылка, СправочникОбъект.Ссылка);

			Для каждого ТекРеквизит Из ТекСправочник.Получить("Реквизиты") Цикл
				Попытка
					СправочникОбъект[ТекРеквизит.Ключ] = ЗначениеИзСтрокиВнутр(ПеревестиСсылкуИзСтарогоМодуля(ТекРеквизит.Значение, КартаСсылок, КартаТипов));
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено поле: " + ТекРеквизит.Ключ + " у " + ТекВидСправочникаКлюч);
				КонецПопытки;
			КонецЦикла;

			Для каждого ТекТабЧасть Из ТекСправочник.Получить("ТабличныеЧасти") Цикл

				ТЧОбъекта = СправочникОбъект[ТекТабЧасть.Ключ];

				Для каждого ТекСтрока Из ТекТабЧасть.Значение Цикл

					НомерСтроки = ЗначениеИзСтрокиВнутр(ТекСтрока.Получить("НомерСтроки"));

					НайденнаяСтрока = ТЧОбъекта.Найти(НомерСтроки, "НомерСтроки");
					Если НайденнаяСтрока = Неопределено Тогда
						СтрокаТЧОбъекта = ТЧОбъекта.Добавить();
					Иначе
						СтрокаТЧОбъекта = НайденнаяСтрока;
					КонецЕсли;

					Для каждого ТекРеквизитСтроки Из ТекСтрока Цикл

						Если ТекРеквизитСтроки.Ключ = "НомерСтроки" Тогда
							Продолжить;
						КонецЕсли;

						Попытка
							СтрокаТЧОбъекта[ТекРеквизитСтроки.Ключ] = ЗначениеИзСтрокиВнутр(ПеревестиСсылкуИзСтарогоМодуля(ТекРеквизитСтроки.Значение, КартаСсылок, КартаТипов));
						Исключение
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено поле: " + ТекРеквизитСтроки.Ключ);
						КонецПопытки;

					КонецЦикла;

				КонецЦикла;

			КонецЦикла;

			Если ТекВидСправочникаКлюч = "Б24_К_НастройкиПодключения"
				И Метаданные.Справочники.Б24_К_НастройкиПодключения.Реквизиты.Найти("КЭДО") <> Неопределено Тогда
				СправочникОбъект.КЭДО = Истина;
			КонецЕсли;

			СправочникОбъект.Записать();

		КонецЦикла;

	КонецЦикла;

	Для каждого ТекВидСправочника Из ЗагружаемыеДанные.Получить("Документы") Цикл

		Для каждого ТекСправочник Из ТекВидСправочника.Значение Цикл

			НомерДокумента 			= ЗначениеИзСтрокиВнутр(ТекСправочник.Получить("Номер"));
			ДатаДокумента 			= ЗначениеИзСтрокиВнутр(ТекСправочник.Получить("Дата"));
			Проведен 				= Ложь;
			ЗначениеПроведен 		= ТекСправочник.Получить("Проведен");
			Если ТипЗнч(ЗначениеПроведен) = Тип("Булево") Тогда
				Проведен = ЗначениеПроведен;
			ИначеЕсли ЗначениеПроведен = "Истина" Тогда
				Проведен = Истина;
			КонецЕсли;
			Ссылка 					= УИДЭлементаИзФайла(ТекСправочник.Получить("Ссылка"));

			ДокументСсылка = Документы[ТекВидСправочника.Ключ].НайтиПоНомеру(НомерДокумента, ДатаДокумента);
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда
				ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
			Иначе

				ДокументОбъект = Документы[ТекВидСправочника.Ключ].СоздатьДокумент();

				Если ЗначениеЗаполнено(Ссылка) Тогда
					Попытка
						НовыйУИД = Новый УникальныйИдентификатор(Ссылка);
					Исключение
						НовыйУИД = Неопределено;
					КонецПопытки;
					Если НовыйУИД <> Неопределено Тогда
						ДокументОбъект.УстановитьСсылкуНового(Документы[ТекВидСправочника.Ключ].ПолучитьСсылку(НовыйУИД));
					КонецЕсли;
				КонецЕсли;

			КонецЕсли;

			ДополнитьКартуСсылокИзСтарогоМодуля(КартаСсылок, Документы[ТекВидСправочника.Ключ], Ссылка, ДокументОбъект.Ссылка);

			Для каждого ТекРеквизит Из ТекСправочник.Получить("Реквизиты") Цикл
				Попытка
					ДокументОбъект[ТекРеквизит.Ключ] = ЗначениеИзСтрокиВнутр(ПеревестиСсылкуИзСтарогоМодуля(ТекРеквизит.Значение, КартаСсылок, КартаТипов));
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено поле: " + ТекРеквизит.Ключ + " у " + ТекВидСправочника.Ключ);
				КонецПопытки;
			КонецЦикла;

			Для каждого ТекТабЧасть Из ТекСправочник.Получить("ТабличныеЧасти") Цикл

				ТЧОбъекта = ДокументОбъект[ТекТабЧасть.Ключ];

				Для каждого ТекСтрока Из ТекТабЧасть.Значение Цикл

					НомерСтроки = ЗначениеИзСтрокиВнутр(ТекСтрока.Получить("НомерСтроки"));

					НайденнаяСтрока = ТЧОбъекта.Найти(НомерСтроки, "НомерСтроки");
					Если НайденнаяСтрока = Неопределено Тогда
						СтрокаТЧОбъекта = ТЧОбъекта.Добавить();
					Иначе
						СтрокаТЧОбъекта = НайденнаяСтрока;
					КонецЕсли;

					Для каждого ТекРеквизитСтроки Из ТекСтрока Цикл

						Если ТекРеквизитСтроки.Ключ = "НомерСтроки" Тогда
							Продолжить;
						КонецЕсли;

						Попытка
							СтрокаТЧОбъекта[ТекРеквизитСтроки.Ключ] = ЗначениеИзСтрокиВнутр(ПеревестиСсылкуИзСтарогоМодуля(ТекРеквизитСтроки.Значение, КартаСсылок, КартаТипов));
						Исключение
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено поле: " + ТекРеквизитСтроки.Ключ);
						КонецПопытки;

					КонецЦикла;

				КонецЦикла;

			КонецЦикла;

			Если Проведен = Истина И ДокументОбъект.ПометкаУдаления = Ложь Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Для каждого ТекКонстанта Из ЗагружаемыеДанные.Получить("Константы") Цикл
		ТекКонстантаКлюч = ТекКонстанта.Ключ;
		Найдено = ТабДанные.Найти(ТекКонстантаКлюч);
		Если ЗначениеЗаполнено(Найдено) Тогда
			ТекКонстантаКлюч = Найдено.Новый;
		КонецЕсли;
		Попытка
			Константы[ТекКонстантаКлюч].Установить(ЗначениеИзСтрокиВнутр(ПеревестиСсылкуИзСтарогоМодуля(ТекКонстанта.Значение, КартаСсылок, КартаТипов)));
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось установить константу: " + ТекКонстантаКлюч);
		КонецПопытки;
	КонецЦикла;

	ПодчинениеРегистратору = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;

	Для каждого ТекРегистр Из ЗагружаемыеДанные.Получить("РегистрыСведений") Цикл

		Для каждого ТекЗапись Из ТекРегистр.Значение Цикл

			ТекРегистрКлюч = ТекРегистр.Ключ;
			Найдено = ТабДанные.Найти(ТекРегистрКлюч);
			Если ЗначениеЗаполнено(Найдено) Тогда
				ТекРегистрКлюч = Найдено.Новый;
			КонецЕсли;
			Если Метаданные.РегистрыСведений[ТекРегистрКлюч].РежимЗаписи = ПодчинениеРегистратору Тогда
				Продолжить;
			КонецЕсли;

			НоваяЗапись = РегистрыСведений[ТекРегистрКлюч].СоздатьМенеджерЗаписи();

			Для каждого ТекПолеЗаписи Из ТекЗапись Цикл
				ТекПолеЗаписиЗначение = ПеревестиСсылкуИзСтарогоМодуля(ТекПолеЗаписи.Значение, КартаСсылок, КартаТипов);
				Попытка
					НоваяЗапись[ТекПолеЗаписи.Ключ] = ЗначениеИзСтрокиВнутр(ТекПолеЗаписиЗначение);
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено поле: " + ТекПолеЗаписи.Ключ + " у " + ТекРегистрКлюч);
				КонецПопытки;

			КонецЦикла;

			Попытка
				НоваяЗапись.Записать();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать регистр сведений: " + ТекРегистрКлюч);
			КонецПопытки;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#Область ТрансляцияСсылокИзСтарогоМодуля

// Возвращает уникальный идентификатор объекта из файла выгрузки данных модуля.
//
// В файле поле "Ссылка" записано как ЗначениеВСтрокуВнутр(XMLСтрока(<Ссылка>)),
// то есть имеет вид {"S","<УИД>"}. Модули до версии 5.0 записывали УИД без обёртки,
// поэтому поддерживаются оба варианта.
//
// Параметры:
//  ЗначениеИзФайла - Строка - значение поля "Ссылка" из файла выгрузки.
//
// Возвращаемое значение:
//  Строка - УИД объекта или пустая строка, если разобрать значение не удалось.
//
Функция УИДЭлементаИзФайла(ЗначениеИзФайла) Экспорт

	Если ТипЗнч(ЗначениеИзФайла) <> Тип("Строка") Или НЕ ЗначениеЗаполнено(ЗначениеИзФайла) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		РазобранноеЗначение = ЗначениеИзСтрокиВнутр(ЗначениеИзФайла);
	Исключение
		РазобранноеЗначение = Неопределено;
	КонецПопытки;

	Если ТипЗнч(РазобранноеЗначение) = Тип("Строка") Тогда
		Возврат СокрЛП(РазобранноеЗначение);
	КонецЕсли;

	Возврат СокрЛП(ЗначениеИзФайла);

КонецФункции

// Соответствие идентификаторов ссылочных типов старого модуля интеграции объектам текущей конфигурации.
//
// При переходе на версию 5.0 объекты модуля созданы заново, поэтому у них другие идентификаторы
// типов, а в файле выгрузки значения ссылаются на типы старого модуля. Без трансляции такие
// значения либо не восстанавливаются вовсе, либо восстанавливаются битыми ссылками.
//
// Значения таблицы сняты с выгрузок старого модуля (кадровый модуль Битрикс24_УП_БП и
// Битрикс24_УП_ЗУП): у части объектов идентификаторы различались между конфигурациями, поэтому
// в таблице есть оба варианта. Годные для текущей конфигурации определяются на месте
// (см. КартаТиповИзСтарогоМодуля).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - Строка - идентификатор типа ссылки в старом модуле;
//   * Значение - Строка - имя объекта метаданных текущей конфигурации, "ВидОбъекта.ИмяОбъекта".
//
Функция СоответствиеТиповИзСтарогоМодуля() Экспорт

	Соответствие = Новый Соответствие;

	// Справочник настроек подключения: Б24_УП_НастройкиПодключения -> Б24_К_НастройкиПодключения.
	Соответствие.Вставить("1c77f821-b641-4fcb-a578-295e8fab580c", "Справочник.Б24_К_НастройкиПодключения");

	// Перечисления модуля: часть из них переименована (ТипыДанных -> ТипыДанныхДляОбменаСПорталом),
	// а Б24_УП_СтатусыОтправкиДокументовНаПодписание сохранено под прежним именем, но пересоздано.
	Соответствие.Вставить("0804cbc6-b9ea-445b-8621-894d007a2c64", "Перечисление.Б24_УП_СтатусыОтправкиДокументовНаПодписание");
	Соответствие.Вставить("aa07ea05-74e0-4d2f-a3a2-600462b798f9", "Перечисление.Б24_УП_СтатусыОтправкиДокументовНаПодписание");
	Соответствие.Вставить("67dac517-849a-47e3-a419-252aee8fe3a0", "Перечисление.Б24_К_ТипыДанныхДляОбменаСПорталом");
	Соответствие.Вставить("d7031a3b-a65c-4aaf-a4bd-7b9b90d3605e", "Перечисление.Б24_К_ТипыСообщений");

	// Документ модуля.
	Соответствие.Вставить("ca2df924-2282-491d-8406-8c87d7662136", "Документ.Б24_УП_ФормированиеДанныхРасчетныхЛистковОстатковОтпуска");

	Возврат Соответствие;

КонецФункции

// Карта замены идентификаторов типов ссылок из файла выгрузки на текущие.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ     - Строка - идентификатор типа ссылки в старом модуле;
//   * Значение - Строка - идентификатор типа ссылки в текущей конфигурации.
//
Функция КартаТиповИзСтарогоМодуля() Экспорт

	КартаТипов = Новый Соответствие;

	Для Каждого ТекСоответствие Из СоответствиеТиповИзСтарогоМодуля() Цикл

		СтрокаПустойСсылки = СтрокаЗначенияПустойСсылкиОбъекта(ТекСоответствие.Значение);

		Если НЕ ЗначениеЗаполнено(СтрокаПустойСсылки) Тогда
			Продолжить;
		КонецЕсли;

		КартаТипов.Вставить(НРег(ТекСоответствие.Ключ), ИдентификаторТипаИзСтрокиЗначения(СтрокаПустойСсылки));

	КонецЦикла;

	Возврат КартаТипов;

КонецФункции

// Возвращает сериализованное значение пустой ссылки объекта метаданных текущей конфигурации.
//
// Параметры:
//  ИмяТипа - Строка - имя объекта метаданных в виде "ВидОбъекта.ИмяОбъекта".
//
// Возвращаемое значение:
//  Строка - значение вида {"#",<идентификатор типа>,0:00000000000000000000000000000000};
//           пустая строка, если объект в конфигурации отсутствует.
//
Функция СтрокаЗначенияПустойСсылкиОбъекта(ИмяТипа) Экспорт

	Части = СтрРазделить(ИмяТипа, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат "";
	КонецЕсли;

	ВидОбъекта = Части[0];
	ИмяОбъекта = Части[1];

	Попытка

		Если ВидОбъекта = "Справочник" Тогда
			Если Метаданные.Справочники.Найти(ИмяОбъекта) = Неопределено Тогда
				Возврат "";
			КонецЕсли;
			Возврат ЗначениеВСтрокуВнутр(Справочники[ИмяОбъекта].ПустаяСсылка());
		ИначеЕсли ВидОбъекта = "Документ" Тогда
			Если Метаданные.Документы.Найти(ИмяОбъекта) = Неопределено Тогда
				Возврат "";
			КонецЕсли;
			Возврат ЗначениеВСтрокуВнутр(Документы[ИмяОбъекта].ПустаяСсылка());
		ИначеЕсли ВидОбъекта = "Перечисление" Тогда
			ПеречислениеМетаданные = Метаданные.Перечисления.Найти(ИмяОбъекта);
			Если ПеречислениеМетаданные = Неопределено
				Или ПеречислениеМетаданные.ЗначенияПеречисления.Количество() = 0 Тогда
				Возврат "";
			КонецЕсли;
			Возврат ЗначениеВСтрокуВнутр(Перечисления[ИмяОбъекта][ПеречислениеМетаданные.ЗначенияПеречисления[0].Имя]);
		КонецЕсли;

	Исключение
		Возврат "";
	КонецПопытки;

	Возврат "";

КонецФункции

// Возвращает идентификатор типа из сериализованного значения ссылки.
//
// Параметры:
//  СтрокаЗначения - Строка - значение вида {"#",<идентификатор типа>,<номер>:<УИД>}.
//
// Возвращаемое значение:
//  Строка - идентификатор типа в нижнем регистре или пустая строка.
//
Функция ИдентификаторТипаИзСтрокиЗначения(СтрокаЗначения) Экспорт

	Части = СтрРазделить(СтрокаЗначения, ",");

	Если Части.Количество() < 3 Тогда
		Возврат "";
	КонецЕсли;

	Если Лев(Части[0], 3) <> "{""#" Тогда
		Возврат "";
	КонецЕсли;

	Возврат НРег(СтрЗаменить(Части[1], """", ""));

КонецФункции

// Возвращает уникальный идентификатор объекта из сериализованного значения ссылки.
//
// Параметры:
//  СтрокаЗначения - Строка - значение вида {"#",<идентификатор типа>,<номер>:<УИД>}.
//
// Возвращаемое значение:
//  Строка - УИД объекта, записанный в том же виде, что и в значениях файла выгрузки,
//           или пустая строка, если значение не является ссылкой.
//
Функция УИДЭлементаИзСтрокиЗначения(СтрокаЗначения) Экспорт

	Части = СтрРазделить(СтрокаЗначения, ",");

	Если Части.Количество() <> 3 Тогда
		Возврат "";
	КонецЕсли;

	Если Лев(Части[0], 3) <> "{""#" Тогда
		Возврат "";
	КонецЕсли;

	ЧастиУИД = СтрРазделить(СтрЗаменить(Части[2], "}", ""), ":");

	Если ЧастиУИД.Количество() <> 2 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НРег(СокрЛП(ЧастиУИД[1]));

КонецФункции

// Дополняет карту соответствия ссылок старого модуля фактическим ссылкам текущей базы.
//
// Параметры:
//  КартаСсылок     - Соответствие - карта, которую заполняем;
//  МенеджерОбъекта - СправочникМенеджер, ДокументМенеджер - менеджер объекта, к которому
//                    относится перенесённый элемент;
//  СтарыйУИД       - Строка - УИД элемента в старом модуле;
//  ФактическаяСсылка - СправочникСсылка, ДокументСсылка - ссылка на элемент в текущей базе.
//
Процедура ДополнитьКартуСсылокИзСтарогоМодуля(КартаСсылок, МенеджерОбъекта, СтарыйУИД, ФактическаяСсылка) Экспорт

	Если ТипЗнч(СтарыйУИД) <> Тип("Строка") Или НЕ ЗначениеЗаполнено(СтарыйУИД) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ФактическаяСсылка) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СсылкаСоСтарымУИД = МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(СтарыйУИД));
	Исключение
		Возврат;
	КонецПопытки;

	УИДЭлемента = УИДЭлементаИзСтрокиЗначения(ЗначениеВСтрокуВнутр(СсылкаСоСтарымУИД));

	Если ЗначениеЗаполнено(УИДЭлемента) Тогда
		КартаСсылок.Вставить(УИДЭлемента, ЗначениеВСтрокуВнутр(ФактическаяСсылка));
	КонецЕсли;

КонецПроцедуры

// Переводит сериализованное значение из формата старого модуля в формат текущей конфигурации.
//
// Параметры:
//  СтрокаЗначения - Строка - значение из файла выгрузки;
//  КартаСсылок     - Соответствие - УИД элемента старого модуля -> сериализованная ссылка текущей базы;
//  КартаТипов      - Соответствие - идентификатор типа старого модуля -> идентификатор типа текущей конфигурации.
//
// Возвращаемое значение:
//  Строка - значение, пригодное для ЗначениеИзСтрокиВнутр.
//
Функция ПеревестиСсылкуИзСтарогоМодуля(СтрокаЗначения, КартаСсылок, КартаТипов) Экспорт

	Если ТипЗнч(СтрокаЗначения) <> Тип("Строка") Тогда
		Возврат СтрокаЗначения;
	КонецЕсли;

	ИдентификаторТипа = ИдентификаторТипаИзСтрокиЗначения(СтрЗаменить(СтрокаЗначения, Символы.ПС, ""));

	Если НЕ ЗначениеЗаполнено(ИдентификаторТипа) Тогда
		Возврат СтрокаЗначения;
	КонецЕсли;

	// Элемент перенесён из старого модуля: подставляем фактическую ссылку целиком, тогда
	// восстанавливаются и тип, и элемент, и служебный номер типа.
	УИДЭлемента = УИДЭлементаИзСтрокиЗначения(СтрЗаменить(СтрокаЗначения, Символы.ПС, ""));
	ФактическаяСсылка = КартаСсылок.Получить(УИДЭлемента);

	Если ФактическаяСсылка <> Неопределено Тогда
		Возврат ФактическаяСсылка;
	КонецЕсли;

	// Значение ссылается на объект, которого в файле выгрузки нет (например, значение перечисления):
	// меняем только идентификатор типа.
	НовыйИдентификаторТипа = КартаТипов.Получить(НРег(ИдентификаторТипа));

	Если НовыйИдентификаторТипа = Неопределено Тогда
		Возврат СтрокаЗначения;
	КонецЕсли;

	Возврат СтрЗаменить(СтрокаЗначения, ИдентификаторТипа, НовыйИдентификаторТипа);

КонецФункции

#КонецОбласти

#КонецОбласти

#Область ИмпортЭкспорт

Процедура РазобратьXMLЗагрузитьИдентификаторы(СтрокаXML, АдресРезультата) Экспорт

	ЧтениеXML = Новый ЧтениеXML;

	Попытка
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ТзнДанных = Новый ТаблицаЗначений;
	ТзнДанных.Колонки.Добавить("Портал");
	ТзнДанных.Колонки.Добавить("ТипДанных");
	ТзнДанных.Колонки.Добавить("Объект");
	ТзнДанных.Колонки.Добавить("ПодчиненныйОбъект");
	ТзнДанных.Колонки.Добавить("Идентификатор");
	ТзнДанных.Колонки.Добавить("ДополнительныйИдентификатор");

	лЭтоИдентификаторы	= Ложь;
	Пока ЧтениеXML.Прочитать() Цикл

		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.ЛокальноеИмя = "Идентификаторы" Тогда
			лЭтоИдентификаторы = Истина;
		КонецЕсли;

		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.ЛокальноеИмя = "Идентификаторы" Тогда
			лЭтоИдентификаторы = Ложь;
		КонецЕсли;

		Если лЭтоИдентификаторы Тогда

			Если ЧтениеXML.ТипУзла 	= ТипУзлаXML.НачалоЭлемента И ЧтениеXML.ЛокальноеИмя = "ЭлементИдентификатор" Тогда

				НоваяСтрока = ТзнДанных.Добавить();
				НоваяСтрока.Портал 				= ЧтениеXML.ЗначениеАтрибута("Портал");
				НоваяСтрока.ТипДанных 			= ЧтениеXML.ЗначениеАтрибута("ТипДанных");
				НоваяСтрока.Объект 				= ЧтениеXML.ЗначениеАтрибута("Объект");
				НоваяСтрока.ПодчиненныйОбъект 	= ЧтениеXML.ЗначениеАтрибута("ПодчиненныйОбъект");
				НоваяСтрока.Идентификатор 		= ЧтениеXML.ЗначениеАтрибута("Идентификатор");
				НоваяСтрока.ДополнительныйИдентификатор = ЧтениеXML.ЗначениеАтрибута("ДополнительныйИдентификатор");

			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	СоответствияТиповДанныхДляОбменаСПорталами = Новый Соответствие;

	ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	Для каждого ТекЭлемент Из ТипыДанныхДляОбменаСПорталом Цикл

		Для каждого ТекЗначениеПеречисления Из  Метаданные.Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом.ЗначенияПеречисления Цикл

			Если ТекЭлемент.Значение = Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом[ТекЗначениеПеречисления.Имя] Тогда
				СоответствияТиповДанныхДляОбменаСПорталами.Вставить(ТекЗначениеПеречисления.Синоним, ТекЭлемент.Значение);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Для каждого ТекСтрока Из ТзнДанных Цикл

		Попытка

			ЕстьОшибкаВДанных 	= Ложь;

			Если Лев(ТекСтрока.Объект, 3) = "FT_" Тогда
				ВнешнийИдентификатор = Прав(ТекСтрока.Объект, СтрДлина(ТекСтрока.Объект)-3);
				Объект = XMLЗначение(Тип("СправочникСсылка.Б24_КС_ПользовательскиеГруппыТоваров"), ВнешнийИдентификатор);
			Иначе
				Объект = ЗначениеИзСтрокиВнутр(ТекСтрока.Объект);
			КонецЕсли;

			ПодчиненныйОбъект 	= ЗначениеИзСтрокиВнутр(ТекСтрока.ПодчиненныйОбъект);

			Если ЗначениеЗаполнено(Объект) Тогда
				Если НЕ ЗначениеЗаполнено(Объект.ВерсияДанных) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В базе 1С не найден объект с идентификатором: " + ТекСтрока.Объект);
					ЕстьОшибкаВДанных = Истина;
				КонецЕсли;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В базе 1С не найден объект с идентификатором: " + ТекСтрока.Объект);
				ЕстьОшибкаВДанных = Истина;
			КонецЕсли;

			Если ЗначениеЗаполнено(ПодчиненныйОбъект) Тогда
				Если НЕ ЗначениеЗаполнено(ПодчиненныйОбъект.ВерсияДанных) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В базе 1С не найден объект с идентификатором: " + ТекСтрока.ПодчиненныйОбъект);
					ЕстьОшибкаВДанных = Истина;
				КонецЕсли;
			КонецЕсли;

			Если НЕ ЕстьОшибкаВДанных Тогда

				НоваяЗапись = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.СоздатьМенеджерЗаписи();

				НоваяЗапись.Портал 						= ТекСтрока.Портал;
				НоваяЗапись.ТипДанных 					= СоответствияТиповДанныхДляОбменаСПорталами.Получить(ТекСтрока.ТипДанных);
				НоваяЗапись.Объект						= Объект;
				НоваяЗапись.ПодчиненныйОбъект			= ЗначениеИзСтрокиВнутр(ТекСтрока.ПодчиненныйОбъект);
				НоваяЗапись.Идентификатор				= ЗначениеИзСтрокиВнутр(ТекСтрока.Идентификатор);
				НоваяЗапись.ДополнительныйИдентификатор	= ЗначениеИзСтрокиВнутр(ТекСтрока.ДополнительныйИдентификатор);

				НоваяЗапись.Записать();

			КонецЕсли;
		Исключение

			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

	КонецЦикла;

	ЧтениеXML.Закрыть();

КонецПроцедуры

Процедура СформироватьXMLСИдентификаторами(СтрокаXML, АдресРезультата) Экспорт

	ОбъектXML = Новый ЗаписьXML();
	ОбъектXML.УстановитьСтроку("UTF-8");
	ОбъектXML.ЗаписатьОбъявлениеXML();

	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Портал КАК Портал,
	|	Б24_К_ИдентификаторыОбъектов.ТипДанных КАК ТипДанных,
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.ПодчиненныйОбъект КАК ПодчиненныйОбъект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
	|	Б24_К_ИдентификаторыОбъектов.ДополнительныйИдентификатор КАК ДополнительныйИдентификатор
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов";

	Выборка	= Запрос.Выполнить().Выбрать();

	ОбъектXML.ЗаписатьНачалоЭлемента("Идентификаторы");

		Пока Выборка.Следующий() Цикл

			ОбъектXML.ЗаписатьНачалоЭлемента("ЭлементИдентификатор");

				ОбъектXML.ЗаписатьАтрибут("Портал"		, Выборка.Портал);
				ОбъектXML.ЗаписатьАтрибут("ТипДанных"	, Строка(Выборка.ТипДанных));

				Если ТипЗнч(Выборка.Объект) = Тип("СправочникСсылка.Б24_КС_ПользовательскиеГруппыТоваров") Тогда
					ОбъектXML.ЗаписатьАтрибут("Объект", "FT_" + XMLСтрока(Выборка.Объект));
				Иначе
					ОбъектXML.ЗаписатьАтрибут("Объект", ЗначениеВСтрокуВнутр(Выборка.Объект));
				КонецЕсли;

				ОбъектXML.ЗаписатьАтрибут("ПодчиненныйОбъект"			, ЗначениеВСтрокуВнутр(Выборка.ПодчиненныйОбъект));
				ОбъектXML.ЗаписатьАтрибут("Идентификатор"				, ЗначениеВСтрокуВнутр(Выборка.Идентификатор));
				ОбъектXML.ЗаписатьАтрибут("ДополнительныйИдентификатор"	, ЗначениеВСтрокуВнутр(Выборка.ДополнительныйИдентификатор));

			ОбъектXML.ЗаписатьКонецЭлемента();

		КонецЦикла;

	ОбъектXML.ЗаписатьКонецЭлемента();

	СтрокаXML = ОбъектXML.Закрыть();

	ПоместитьВоВременноеХранилище(СтрокаXML, АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область БитыеСсылки

// Ищет битые (висячие) ссылки в объектах модуля интеграции.
//
// Битой считается ссылка, для которой объект в информационной базе не найден. Так выглядят,
// например, ссылки на настройку подключения после переустановки модуля интеграции и загрузки
// данных, выгруженных другим (старым) модулем.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//   * ОбъектМетаданных  - Строка - например "РегистрСведений.Б24_УП_СтатусыОтправкиДокументовНаПодпись";
//   * ИмяПоля           - Строка - имя измерения, ресурса, реквизита или реквизита табличной части;
//   * ИмяТабличнойЧасти - Строка - имя табличной части или пустая строка;
//   * ЭтоИзмерение      - Булево - Истина для измерений регистра: замена меняет ключ записи;
//   * КоличествоЗаписей - Число  - сколько записей содержат битую ссылку;
//   * ТипСсылки         - Строка - представление типа ссылки, например "СправочникСсылка.Б24_К_НастройкиПодключения".
//
Функция НайтиБитыеСсылки() Экспорт

	Таблица = НоваяТаблицаБитыхСсылок();
	ПараметрыОбработки = НовыеПараметрыОбработкиБитыхСсылок();
	ПараметрыОбработки.ТолькоПоиск = Истина;

	Для Каждого ТекОбъект Из Метаданные.Справочники Цикл
		Если ЭтоОбъектМодуляИнтеграции(ТекОбъект.Имя) Тогда
			ОбработатьСправочник(ТекОбъект, Таблица, ПараметрыОбработки);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТекОбъект Из Метаданные.Документы Цикл
		Если ЭтоОбъектМодуляИнтеграции(ТекОбъект.Имя) Тогда
			ОбработатьДокумент(ТекОбъект, Таблица, ПараметрыОбработки);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТекОбъект Из Метаданные.РегистрыСведений Цикл
		Если ЭтоОбъектМодуляИнтеграции(ТекОбъект.Имя) Тогда
			ОбработатьРегистрСведений(ТекОбъект, Таблица, ПараметрыОбработки);
		КонецЕсли;
	КонецЦикла;

	Таблица.Сортировать("ОбъектМетаданных, ИмяТабличнойЧасти, ИмяПоля");

	Возврат Таблица;

КонецФункции

// Заменяет битые ссылки одного поля, найденные процедурой НайтиБитыеСсылки, существующим значением.
//
// Параметры:
//  ОбъектМетаданных  - Строка - значение колонки ОбъектМетаданных из НайтиБитыеСсылки();
//  ИмяПоля           - Строка - имя поля;
//  ИмяТабличнойЧасти - Строка - имя табличной части или пустая строка;
//  ЭтоИзмерение      - Булево - Истина, если поле является измерением регистра;
//  НовоеЗначение     - СправочникСсылка, ДокументСсылка - существующее значение для замены.
//
// Возвращаемое значение:
//  Число - количество исправленных записей.
//
Функция ЗаменитьБитыеСсылки(ОбъектМетаданных, ИмяПоля, ИмяТабличнойЧасти, ЭтоИзмерение, НовоеЗначение) Экспорт

	Если ПустаяСтрока(ИмяСсылочногоТипа(НовоеЗначение)) Тогда
		ВызватьИсключение "В качестве нового значения ожидается существующая ссылка";
	КонецЕсли;

	ПараметрыОбработки = НовыеПараметрыОбработкиБитыхСсылок();
	ПараметрыОбработки.ТолькоПоиск = Ложь;
	ПараметрыОбработки.ЗаменяемыйОбъектМетаданных = СокрЛП(ОбъектМетаданных);
	ПараметрыОбработки.ЗаменяемоеПоле = СокрЛП(ИмяПоля);
	ПараметрыОбработки.ЗаменяемаяТабличнаяЧасть = СокрЛП(ИмяТабличнойЧасти);
	ПараметрыОбработки.ЗаменяемоеЭтоИзмерение = ЭтоИзмерение;
	ПараметрыОбработки.НовоеЗначение = НовоеЗначение;

	ЧастиИмени = СтрРазделить(ПараметрыОбработки.ЗаменяемыйОбъектМетаданных, ".");

	Если ЧастиИмени.Количество() <> 2 Тогда
		ВызватьИсключение "Неверное имя объекта метаданных: " + ОбъектМетаданных;
	КонецЕсли;

	Таблица = НоваяТаблицаБитыхСсылок();
	ВидОбъектаМетаданных = ЧастиИмени[0];
	ИмяОбъекта = ЧастиИмени[1];

	Если ВидОбъектаМетаданных = "Справочник" Тогда
		ОбработатьСправочник(Метаданные.Справочники[ИмяОбъекта], Таблица, ПараметрыОбработки);
	ИначеЕсли ВидОбъектаМетаданных = "Документ" Тогда
		ОбработатьДокумент(Метаданные.Документы[ИмяОбъекта], Таблица, ПараметрыОбработки);
	ИначеЕсли ВидОбъектаМетаданных = "РегистрСведений" Тогда
		ОбработатьРегистрСведений(Метаданные.РегистрыСведений[ИмяОбъекта], Таблица, ПараметрыОбработки);
	Иначе
		ВызватьИсключение "Замена битых ссылок для " + ВидОбъектаМетаданных + " не поддерживается";
	КонецЕсли;

	Возврат ПараметрыОбработки.КоличествоЗамен;

КонецФункции

// Подбирает значение для замены битых ссылок: единственный элемент справочника нужного типа.
//
// Параметры:
//  ТипСсылки - Строка - представление типа ссылки, например "СправочникСсылка.Б24_К_НастройкиПодключения".
//
// Возвращаемое значение:
//  СправочникСсылка, Неопределено - единственный элемент справочника или Неопределено,
//                                   если такой подбор невозможен.
//
Функция ПодобратьЗначениеДляЗамены(ТипСсылки) Экспорт

	ЧастиТипа = СтрРазделить(СокрЛП(ТипСсылки), ".");

	Если ЧастиТипа.Количество() <> 2 Или ЧастиТипа[0] <> "СправочникСсылка" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка

		Если Метаданные.Справочники.Найти(ЧастиТипа[1]) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Выборка = Справочники[ЧастиТипа[1]].Выбрать();
		КоличествоЭлементов = 0;
		ПодобранноеЗначение = Неопределено;

		Пока Выборка.Следующий() Цикл

			КоличествоЭлементов = КоличествоЭлементов + 1;

			Если КоличествоЭлементов > 1 Тогда
				Возврат Неопределено;
			КонецЕсли;

			ПодобранноеЗначение = Выборка.Ссылка;

		КонецЦикла;

		Возврат ПодобранноеЗначение;

	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция НоваяТаблицаБитыхСсылок()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ОбъектМетаданных", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИмяПоля", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИмяТабличнойЧасти", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЭтоИзмерение", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("КоличествоЗаписей", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ТипСсылки", Новый ОписаниеТипов("Строка"));

	Возврат Таблица;

КонецФункции

Функция НовыеПараметрыОбработкиБитыхСсылок()

	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("ТолькоПоиск", Истина);
	ПараметрыОбработки.Вставить("ЗаменяемыйОбъектМетаданных", "");
	ПараметрыОбработки.Вставить("ЗаменяемоеПоле", "");
	ПараметрыОбработки.Вставить("ЗаменяемаяТабличнаяЧасть", "");
	ПараметрыОбработки.Вставить("ЗаменяемоеЭтоИзмерение", Ложь);
	ПараметрыОбработки.Вставить("НовоеЗначение", Неопределено);
	ПараметрыОбработки.Вставить("КоличествоЗамен", 0);

	Возврат ПараметрыОбработки;

КонецФункции

Функция ЭтоОбъектМодуляИнтеграции(ИмяОбъекта)
	Возврат Лев(ИмяОбъекта, 4) = "Б24_";
КонецФункции

// Возвращает представление ссылочного типа значения или типа, например "СправочникСсылка.Валюты".
// Для значений и типов, не являющихся ссылочными, возвращает пустую строку.
//
Функция ИмяСсылочногоТипа(ЗначениеИлиТип)

	Попытка
		Если ТипЗнч(ЗначениеИлиТип) = Тип("Тип") Тогда
			ПредставлениеТипа = Строка(ЗначениеИлиТип);
		Иначе
			ПредставлениеТипа = Строка(ТипЗнч(ЗначениеИлиТип));
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;

	Для Каждого ТекПрефикс Из ПрефиксыСсылочныхТипов() Цикл
		Если Лев(ПредставлениеТипа, СтрДлина(ТекПрефикс)) = ТекПрефикс Тогда
			Возврат ПредставлениеТипа;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПрефиксыСсылочныхТипов()
	Возврат СтрРазделить("СправочникСсылка,ДокументСсылка,ПланВидовХарактеристикСсылка,ПланОбменаСсылка,"
		+ "ПланСчетовСсылка,ПланВидовРасчетаСсылка,БизнесПроцессСсылка,ЗадачаСсылка", ",");
КонецФункции

// Проверяет, что значение является битой ссылкой: ссылка с непустым уникальным идентификатором,
// для которой объект в информационной базе не найден.
//
Функция ЭтоБитаяСсылка(Значение) Экспорт

	Если ПустаяСтрока(ИмяСсылочногоТипа(Значение)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЧастиЗначения = СтрРазделить(ЗначениеВСтрокуВнутр(Значение), ",");
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если ЧастиЗначения.Количество() <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	// У пустой ссылки уникальный идентификатор нулевой, у битой — нет.
	Если СтрНайти(ЧастиЗначения[2], "00000000000000000000000000000000") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// Платформа считает такую ссылку незаполненной, а её представление начинается
	// с текста "<Объект не найден>".
	Возврат НЕ ЗначениеЗаполнено(Значение) Или СтрНайти(Строка(Значение), "<Объект не найден>") > 0;

КонецФункции

Функция ЭтоРеквизитСсылочногоТипа(МетаданныеРеквизита)

	Для Каждого ТекТип Из МетаданныеРеквизита.Тип.Типы() Цикл
		Если НЕ ПустаяСтрока(ИмяСсылочногоТипа(ТекТип)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает имена реквизитов ссылочных типов.
//
Функция ИменаСсылочныхРеквизитов(РеквизитыМетаданных)

	Имена = Новый Массив;

	Для Каждого ТекРеквизит Из РеквизитыМетаданных Цикл
		Если ЭтоРеквизитСсылочногоТипа(ТекРеквизит) Тогда
			Имена.Добавить(ТекРеквизит.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Возвращает измерения, ресурсы и реквизиты регистра сведений ссылочных типов.
//
Функция СсылочныеПоляРегистраСведений(МетаданныеРегистра)

	Поля = Новый Массив;

	Для Каждого ТекИзмерение Из МетаданныеРегистра.Измерения Цикл
		Если ЭтоРеквизитСсылочногоТипа(ТекИзмерение) Тогда
			Поля.Добавить(НовоеОписаниеПоляРегистра(ТекИзмерение.Имя, Истина));
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТекРесурс Из МетаданныеРегистра.Ресурсы Цикл
		Если ЭтоРеквизитСсылочногоТипа(ТекРесурс) Тогда
			Поля.Добавить(НовоеОписаниеПоляРегистра(ТекРесурс.Имя, Ложь));
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТекРеквизит Из МетаданныеРегистра.Реквизиты Цикл
		Если ЭтоРеквизитСсылочногоТипа(ТекРеквизит) Тогда
			Поля.Добавить(НовоеОписаниеПоляРегистра(ТекРеквизит.Имя, Ложь));
		КонецЕсли;
	КонецЦикла;

	Возврат Поля;

КонецФункции

Функция НовоеОписаниеПоляРегистра(ИмяПоля, ЭтоИзмерение)

	Возврат Новый Структура("Имя, ЭтоИзмерение", ИмяПоля, ЭтоИзмерение);

КонецФункции

Процедура ДобавитьВТаблицуБитыхСсылок(Таблица, ОбъектМетаданных, ИмяПоля, ИмяТабличнойЧасти, ЭтоИзмерение, Значение)

	Отбор = Новый Структура("ОбъектМетаданных, ИмяПоля, ИмяТабличнойЧасти", ОбъектМетаданных, ИмяПоля, ИмяТабличнойЧасти);
	НайденныеСтроки = Таблица.НайтиСтроки(Отбор);

	Если НайденныеСтроки.Количество() > 0 Тогда
		СтрокаТаблицы = НайденныеСтроки[0];
		СтрокаТаблицы.КоличествоЗаписей = СтрокаТаблицы.КоличествоЗаписей + 1;
		Возврат;
	КонецЕсли;

	СтрокаТаблицы = Таблица.Добавить();
	СтрокаТаблицы.ОбъектМетаданных = ОбъектМетаданных;
	СтрокаТаблицы.ИмяПоля = ИмяПоля;
	СтрокаТаблицы.ИмяТабличнойЧасти = ИмяТабличнойЧасти;
	СтрокаТаблицы.ЭтоИзмерение = ЭтоИзмерение;
	СтрокаТаблицы.КоличествоЗаписей = 1;
	СтрокаТаблицы.ТипСсылки = ИмяСсылочногоТипа(Значение);

КонецПроцедуры

// Проверяет, относится ли обрабатываемый объект к выбранной для замены строке.
//
Функция ЭтоОбрабатываемыйОбъект(ПараметрыОбработки, ВидОбъектаМетаданных, МетаданныеОбъекта)

	Если ПараметрыОбработки.ТолькоПоиск Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПараметрыОбработки.ЗаменяемыйОбъектМетаданных = ВидОбъектаМетаданных + "." + МетаданныеОбъекта.Имя;

КонецФункции

// Проверяет, что битую ссылку в поле нужно заменить: поле и табличная часть совпадают с выбранными,
// а тип ссылки совпадает с типом нового значения.
//
Функция ЭтоЗаменяемоеПоле(ПараметрыОбработки, ИмяПоля, ИмяТабличнойЧасти, Значение)

	Если ПараметрыОбработки.ТолькоПоиск Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ИмяПоля <> ПараметрыОбработки.ЗаменяемоеПоле
		Или ИмяТабличнойЧасти <> ПараметрыОбработки.ЗаменяемаяТабличнаяЧасть Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИмяСсылочногоТипа(Значение) = ИмяСсылочногоТипа(ПараметрыОбработки.НовоеЗначение);

КонецФункции

// Возвращает имена ссылочных реквизитов табличных частей объекта в виде соответствия
// "ИмяТабличнойЧасти" -> Массив имён реквизитов.
//
Функция СсылочныеРеквизитыТабличныхЧастей(МетаданныеОбъекта)

	ПоляТабличныхЧастей = Новый Соответствие;

	Для Каждого ТекТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		ИменаРеквизитов = ИменаСсылочныхРеквизитов(ТекТабличнаяЧасть.Реквизиты);

		Если ИменаРеквизитов.Количество() > 0 Тогда
			ПоляТабличныхЧастей.Вставить(ТекТабличнаяЧасть.Имя, ИменаРеквизитов);
		КонецЕсли;
	КонецЦикла;

	Возврат ПоляТабличныхЧастей;

КонецФункции

Процедура ОбработатьСправочник(МетаданныеСправочника, Таблица, ПараметрыОбработки)

	Если НЕ ЭтоОбрабатываемыйОбъект(ПараметрыОбработки, "Справочник", МетаданныеСправочника) Тогда
		Возврат;
	КонецЕсли;

	ПоляРеквизитов = ИменаСсылочныхРеквизитов(МетаданныеСправочника.Реквизиты);
	ПоляТабличныхЧастей = СсылочныеРеквизитыТабличныхЧастей(МетаданныеСправочника);

	Если ПоляРеквизитов.Количество() = 0 И ПоляТабличныхЧастей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОбъектМетаданных = "Справочник." + МетаданныеСправочника.Имя;
	СсылкиДляЗамены = Новый Массив;

	Выборка = Справочники[МетаданныеСправочника.Имя].Выбрать();

	Пока Выборка.Следующий() Цикл

		Для Каждого ТекИмяПоля Из ПоляРеквизитов Цикл

			Значение = Выборка[ТекИмяПоля];

			Если НЕ ЭтоБитаяСсылка(Значение) Тогда
				Продолжить;
			КонецЕсли;

			Если ПараметрыОбработки.ТолькоПоиск Тогда
				ДобавитьВТаблицуБитыхСсылок(Таблица, ОбъектМетаданных, ТекИмяПоля, "", Ложь, Значение);
			ИначеЕсли ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекИмяПоля, "", Значение) Тогда
				ПараметрыОбработки.КоличествоЗамен = ПараметрыОбработки.КоличествоЗамен + 1;
				ДобавитьСсылкуДляЗамены(СсылкиДляЗамены, Выборка.Ссылка);
			КонецЕсли;

		КонецЦикла;

		Для Каждого ТекТабличнаяЧасть Из ПоляТабличныхЧастей Цикл

			Для Каждого ТекИмяПоля Из ТекТабличнаяЧасть.Значение Цикл

				Для Каждого ТекСтрока Из Выборка[ТекТабличнаяЧасть.Ключ] Цикл

					Значение = ТекСтрока[ТекИмяПоля];

					Если НЕ ЭтоБитаяСсылка(Значение) Тогда
						Продолжить;
					КонецЕсли;

					Если ПараметрыОбработки.ТолькоПоиск Тогда
						ДобавитьВТаблицуБитыхСсылок(Таблица, ОбъектМетаданных, ТекИмяПоля, ТекТабличнаяЧасть.Ключ, Ложь, Значение);
					ИначеЕсли ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекИмяПоля, ТекТабличнаяЧасть.Ключ, Значение) Тогда
						ПараметрыОбработки.КоличествоЗамен = ПараметрыОбработки.КоличествоЗамен + 1;
						ДобавитьСсылкуДляЗамены(СсылкиДляЗамены, Выборка.Ссылка);
					КонецЕсли;

				КонецЦикла;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Выборка.Закрыть();

	Для Каждого ТекСсылка Из СсылкиДляЗамены Цикл
		ЗаменитьВСправочнике(МетаданныеСправочника, ТекСсылка, ПараметрыОбработки);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСсылкуДляЗамены(СсылкиДляЗамены, Ссылка)

	Если СсылкиДляЗамены.Найти(Ссылка) = Неопределено Тогда
		СсылкиДляЗамены.Добавить(Ссылка);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаменитьВСправочнике(МетаданныеСправочника, Ссылка, ПараметрыОбработки)

	Объект = Ссылка.ПолучитьОбъект();

	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИзменилсяОбъект = Ложь;

	Для Каждого ТекИмяПоля Из ИменаСсылочныхРеквизитов(МетаданныеСправочника.Реквизиты) Цикл

		Если ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекИмяПоля, "", Объект[ТекИмяПоля])
			И ЭтоБитаяСсылка(Объект[ТекИмяПоля]) Тогда
			Объект[ТекИмяПоля] = ПараметрыОбработки.НовоеЗначение;
			ИзменилсяОбъект = Истина;
		КонецЕсли;

	КонецЦикла;

	Для Каждого ТекТабличнаяЧасть Из СсылочныеРеквизитыТабличныхЧастей(МетаданныеСправочника) Цикл

		Для Каждого ТекИмяПоля Из ТекТабличнаяЧасть.Значение Цикл

			Для Каждого ТекСтрока Из Объект[ТекТабличнаяЧасть.Ключ] Цикл

				Если ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекИмяПоля, ТекТабличнаяЧасть.Ключ, ТекСтрока[ТекИмяПоля])
					И ЭтоБитаяСсылка(ТекСтрока[ТекИмяПоля]) Тогда
					ТекСтрока[ТекИмяПоля] = ПараметрыОбработки.НовоеЗначение;
					ИзменилсяОбъект = Истина;
				КонецЕсли;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Если ИзменилсяОбъект Тогда
		Объект.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьДокумент(МетаданныеДокумента, Таблица, ПараметрыОбработки)

	Если НЕ ЭтоОбрабатываемыйОбъект(ПараметрыОбработки, "Документ", МетаданныеДокумента) Тогда
		Возврат;
	КонецЕсли;

	ПоляРеквизитов = ИменаСсылочныхРеквизитов(МетаданныеДокумента.Реквизиты);
	ПоляТабличныхЧастей = СсылочныеРеквизитыТабличныхЧастей(МетаданныеДокумента);

	Если ПоляРеквизитов.Количество() = 0 И ПоляТабличныхЧастей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОбъектМетаданных = "Документ." + МетаданныеДокумента.Имя;
	СсылкиДляЗамены = Новый Массив;

	Выборка = Документы[МетаданныеДокумента.Имя].Выбрать();

	Пока Выборка.Следующий() Цикл

		Для Каждого ТекИмяПоля Из ПоляРеквизитов Цикл

			Значение = Выборка[ТекИмяПоля];

			Если НЕ ЭтоБитаяСсылка(Значение) Тогда
				Продолжить;
			КонецЕсли;

			Если ПараметрыОбработки.ТолькоПоиск Тогда
				ДобавитьВТаблицуБитыхСсылок(Таблица, ОбъектМетаданных, ТекИмяПоля, "", Ложь, Значение);
			ИначеЕсли ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекИмяПоля, "", Значение) Тогда
				ПараметрыОбработки.КоличествоЗамен = ПараметрыОбработки.КоличествоЗамен + 1;
				ДобавитьСсылкуДляЗамены(СсылкиДляЗамены, Выборка.Ссылка);
			КонецЕсли;

		КонецЦикла;

		Для Каждого ТекТабличнаяЧасть Из ПоляТабличныхЧастей Цикл

			Для Каждого ТекИмяПоля Из ТекТабличнаяЧасть.Значение Цикл

				Для Каждого ТекСтрока Из Выборка[ТекТабличнаяЧасть.Ключ] Цикл

					Значение = ТекСтрока[ТекИмяПоля];

					Если НЕ ЭтоБитаяСсылка(Значение) Тогда
						Продолжить;
					КонецЕсли;

					Если ПараметрыОбработки.ТолькоПоиск Тогда
						ДобавитьВТаблицуБитыхСсылок(Таблица, ОбъектМетаданных, ТекИмяПоля, ТекТабличнаяЧасть.Ключ, Ложь, Значение);
					ИначеЕсли ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекИмяПоля, ТекТабличнаяЧасть.Ключ, Значение) Тогда
						ПараметрыОбработки.КоличествоЗамен = ПараметрыОбработки.КоличествоЗамен + 1;
						ДобавитьСсылкуДляЗамены(СсылкиДляЗамены, Выборка.Ссылка);
					КонецЕсли;

				КонецЦикла;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Выборка.Закрыть();

	Для Каждого ТекСсылка Из СсылкиДляЗамены Цикл
		ЗаменитьВДокументе(МетаданныеДокумента, ТекСсылка, ПараметрыОбработки);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаменитьВДокументе(МетаданныеДокумента, Ссылка, ПараметрыОбработки)

	Объект = Ссылка.ПолучитьОбъект();

	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИзменилсяОбъект = Ложь;

	Для Каждого ТекИмяПоля Из ИменаСсылочныхРеквизитов(МетаданныеДокумента.Реквизиты) Цикл

		Если ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекИмяПоля, "", Объект[ТекИмяПоля])
			И ЭтоБитаяСсылка(Объект[ТекИмяПоля]) Тогда
			Объект[ТекИмяПоля] = ПараметрыОбработки.НовоеЗначение;
			ИзменилсяОбъект = Истина;
		КонецЕсли;

	КонецЦикла;

	Для Каждого ТекТабличнаяЧасть Из СсылочныеРеквизитыТабличныхЧастей(МетаданныеДокумента) Цикл

		Для Каждого ТекИмяПоля Из ТекТабличнаяЧасть.Значение Цикл

			Для Каждого ТекСтрока Из Объект[ТекТабличнаяЧасть.Ключ] Цикл

				Если ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекИмяПоля, ТекТабличнаяЧасть.Ключ, ТекСтрока[ТекИмяПоля])
					И ЭтоБитаяСсылка(ТекСтрока[ТекИмяПоля]) Тогда
					ТекСтрока[ТекИмяПоля] = ПараметрыОбработки.НовоеЗначение;
					ИзменилсяОбъект = Истина;
				КонецЕсли;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Если ИзменилсяОбъект Тогда
		Если Объект.Проведен Тогда
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Объект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Возвращает ключ записи регистра сведений: значения измерений и период, если регистр периодический.
//
Функция КлючЗаписиРегистра(МетаданныеРегистра, Выборка)

	Ключ = Новый Структура;

	Для Каждого ТекИзмерение Из МетаданныеРегистра.Измерения Цикл
		Ключ.Вставить(ТекИзмерение.Имя, Выборка[ТекИзмерение.Имя]);
	КонецЦикла;

	Если МетаданныеРегистра.Периодичность <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Ключ.Вставить("Период", Выборка.Период);
	КонецЕсли;

	Возврат Ключ;

КонецФункции

Процедура ЗаполнитьКлючЗаписиРегистра(Запись, МетаданныеРегистра, Ключ)

	Для Каждого ТекИзмерение Из МетаданныеРегистра.Измерения Цикл
		Запись[ТекИзмерение.Имя] = Ключ[ТекИзмерение.Имя];
	КонецЦикла;

	Если Ключ.Свойство("Период") Тогда
		Запись.Период = Ключ.Период;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьРегистрСведений(МетаданныеРегистра, Таблица, ПараметрыОбработки)

	Если НЕ ЭтоОбрабатываемыйОбъект(ПараметрыОбработки, "РегистрСведений", МетаданныеРегистра) Тогда
		Возврат;
	КонецЕсли;

	Если МетаданныеРегистра.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		// Записи подчинённого регистра изменяются только вместе с регистратором, инструментом не трогаем.
		Возврат;
	КонецЕсли;

	ПоляРегистра = СсылочныеПоляРегистраСведений(МетаданныеРегистра);

	Если ПоляРегистра.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ОбъектМетаданных = "РегистрСведений." + МетаданныеРегистра.Имя;
	КлючиДляЗамены = Новый Массив;

	Выборка = РегистрыСведений[МетаданныеРегистра.Имя].Выбрать();

	Пока Выборка.Следующий() Цикл

		Для Каждого ТекПоле Из ПоляРегистра Цикл

			Значение = Выборка[ТекПоле.Имя];

			Если НЕ ЭтоБитаяСсылка(Значение) Тогда
				Продолжить;
			КонецЕсли;

			Если ПараметрыОбработки.ТолькоПоиск Тогда
				ДобавитьВТаблицуБитыхСсылок(Таблица, ОбъектМетаданных, ТекПоле.Имя, "", ТекПоле.ЭтоИзмерение, Значение);
			ИначеЕсли ЭтоЗаменяемоеПоле(ПараметрыОбработки, ТекПоле.Имя, "", Значение) Тогда
				ПараметрыОбработки.КоличествоЗамен = ПараметрыОбработки.КоличествоЗамен + 1;
				КлючиДляЗамены.Добавить(КлючЗаписиРегистра(МетаданныеРегистра, Выборка));
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Выборка.Закрыть();

	Для Каждого ТекКлюч Из КлючиДляЗамены Цикл
		ЗаменитьВЗаписиРегистра(МетаданныеРегистра, ТекКлюч, ПараметрыОбработки);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаменитьВЗаписиРегистра(МетаданныеРегистра, Ключ, ПараметрыОбработки)

	ИмяРегистра = МетаданныеРегистра.Имя;

	Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	ЗаполнитьКлючЗаписиРегистра(Запись, МетаданныеРегистра, Ключ);
	Запись.Прочитать();

	Если НЕ ЭтоБитаяСсылка(Запись[ПараметрыОбработки.ЗаменяемоеПоле]) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЭтоЗаменяемоеПоле(ПараметрыОбработки, ПараметрыОбработки.ЗаменяемоеПоле, "",
		Запись[ПараметрыОбработки.ЗаменяемоеПоле]) Тогда
		Возврат;
	КонецЕсли;

	СтараяЗапись = Неопределено;

	// Замена измерения меняет ключ записи: сначала записываем запись с новым ключом, затем удаляем старую.
	Если ПараметрыОбработки.ЗаменяемоеЭтоИзмерение Тогда
		СтараяЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		ЗаполнитьКлючЗаписиРегистра(СтараяЗапись, МетаданныеРегистра, Ключ);
	КонецЕсли;

	Запись[ПараметрыОбработки.ЗаменяемоеПоле] = ПараметрыОбработки.НовоеЗначение;
	Запись.Записать();

	Если СтараяЗапись <> Неопределено Тогда
		СтараяЗапись.Удалить();
	КонецЕсли;

КонецПроцедуры

