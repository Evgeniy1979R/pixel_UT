
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ДлительнаяОперацияЗавершение = Новый ОписаниеОповещения("ПослеВыгрузкиИдентификаторов", ЭтотОбъект);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ТекстСообщения             = "Выполняется выгрузка идентификаторов..";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания       = Истина;
	ПараметрыОжидания.ВыводитьСообщения          = Истина;
	
	ДлительнаяОперация = НачатьВыгрузкуИдентификаторов();
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ДлительнаяОперацияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыгрузкиИдентификаторов(Результат, ПараметрыВыгрузки) Экспорт
	
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.Заголовок = "Выберите путь для сохранения файла";
	
	НачатьПолучениеФайлаССервера(Результат.АдресРезультата,  Строка("Идентификаторы модуля")+ ".xml", Диалог);
	
КонецПроцедуры

&НаСервере
Функция НачатьВыгрузкуИдентификаторов()
	
	УникальныйИдентификаторЗадания = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификаторЗадания);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Загрузка идентификаторов Битрикс24";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.Б24_К_Администрирование.СформироватьXMLСИдентификаторами", Неопределено, ПараметрыВыполнения);
	
КонецФункции
