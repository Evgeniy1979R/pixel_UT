
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	УникальныйИдентификатор = Новый УникальныйИдентификатор;
	
	Диалог = Новый ПараметрыДиалогаПомещенияФайлов;
	Диалог.Заголовок = "Выберите файл";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "(*.xml)|*.xml";
	
	ОбработкаОкончанияЗагрузки = Новый ОписаниеОповещения("Обработчик_ПослеПомещения", ЭтотОбъект); 

	НачатьПомещениеФайлаНаСервер(ОбработкаОкончанияЗагрузки,,,, Диалог);
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеПомещения(ОписаниеПомещенногоФайла, ДопПараметры) Экспорт 
	
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Обработчик_Завершения_ЗагрузкиСервер(ОписаниеПомещенногоФайла.Адрес); 
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_Завершения_ЗагрузкиСервер(Адрес) 
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(Адрес);
	
	ТекстXML = Новый ТекстовыйДокумент;  
	
	ПараметрыЧтения = Новый Структура("ТекстXML", ТекстXML);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЧтенияФайла", ЭтотОбъект   , ПараметрыЧтения);
	
	ТекстXML.НачатьЧтение(ОписаниеОповещения, ДвоичныеДанныеФайла.ОткрытьПотокДляЧтения());
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЧтенияФайла(Параметры) Экспорт
	
	СтрокаXML = Параметры.ТекстXML.ПолучитьТекст();
	
	ДлительнаяОперацияЗавершение = Новый ОписаниеОповещения("ПослеЗагрузкиИдентификаторов", ЭтотОбъект);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ТекстСообщения             = "Выполняется загрузка идентификаторов..";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания       = Истина;
	ПараметрыОжидания.ВыводитьСообщения          = Истина;
	
	ДлительнаяОперация = НачатьЗагрузкуИдентификаторов(СтрокаXML);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ДлительнаяОперацияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция НачатьЗагрузкуИдентификаторов(СтрокаXML)
	
	УникальныйИдентификаторЗадания = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификаторЗадания);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Загрузка идентификаторов Битрикс24";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.Б24_К_Администрирование.РазобратьXMLЗагрузитьИдентификаторы", СтрокаXML, ПараметрыВыполнения);
	  
КонецФункции

&НаКлиенте
Процедура ПослеЗагрузкиИдентификаторов(Результат, ПараметрыВыгрузки) Экспорт

	Возврат;
	
КонецПроцедуры
