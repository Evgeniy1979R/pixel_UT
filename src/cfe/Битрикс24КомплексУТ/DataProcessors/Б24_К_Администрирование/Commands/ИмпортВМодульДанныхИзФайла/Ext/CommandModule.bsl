
&НаКлиенте
Асинх Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
    Ответ = Ждать ВопросАсинх("Существующие данные будут перезаписаны. Продолжить?", РежимДиалогаВопрос.ДаНет, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
	
	Диалог = Новый ПараметрыДиалогаПомещенияФайлов;
	Диалог.Заголовок = "Выберите файл";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "(*.zip)|*.zip";
	
	ОбработкаОкончанияЗагрузки = Новый ОписаниеОповещения("Обработчик_ПослеПомещения", ЭтотОбъект);

	НачатьПомещениеФайлаНаСервер(ОбработкаОкончанияЗагрузки,,,, Диалог);
	
КонецПроцедуры

&НаКлиенте
Процедура Обработчик_ПослеПомещения(ОписаниеПомещенногоФайла, ДопПараметры) Экспорт 
	
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ОписаниеПомещенногоФайла.Адрес);
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Перекладываем данные в хранилище с полным адресом temp://, видимым серверу.
	АдресНаСервере = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Новый УникальныйИдентификатор);
	
	ДлительнаяОперацияЗавершение = Новый ОписаниеОповещения("ПослеЗагрузкиДанных", ЭтотОбъект);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Неопределено);
	ПараметрыОжидания.ТекстСообщения             = "Выполняется загрузка данных..";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания       = Истина;
	ПараметрыОжидания.ВыводитьСообщения          = Истина;
	
	ДлительнаяОперация = НачатьЗагрузкуДанных(АдресНаСервере);
	
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ДлительнаяОперацияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция НачатьЗагрузкуДанных(АдресВоВременномХранилище)
	
	ДвоичныеДанныеАрхива = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	Если ДвоичныеДанныеАрхива = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
	ДвоичныеДанныеАрхива.Записать(ИмяФайлаАрхива);
	
	ЧтениеZipФайла = Новый ЧтениеZipФайла(ИмяФайлаАрхива);
	Если ЧтениеZipФайла.Элементы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПлатформаWindows 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипПлатформы();
	КаталогФайлов 		= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПутьДляПлатформы(ПлатформаWindows, КаталогВременныхФайлов() + "\" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0")); 
	ПолноеИмяФайла 		= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПутьДляПлатформы(ПлатформаWindows, КаталогФайлов + "\" + ЧтениеZipФайла.Элементы[0].ПолноеИмя);
	
	ЧтениеZipФайла.ИзвлечьВсе(КаталогФайлов);
	ЧтениеZipФайла.Закрыть();	
	
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПолноеИмяФайла);
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьПоток(ДвоичныеДанныеФайла.ОткрытьПотокДляЧтения());
	ЗагружаемыеДанные = ПрочитатьJSON(ЧтениеJSON, Истина);
	
	УникальныйИдентификаторЗадания = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификаторЗадания);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Загрузка данных Битрикс24";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.Б24_К_Администрирование.ИмпортДанныхВМодульИзФайла", ЗагружаемыеДанные, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ПослеЗагрузкиДанных(Результат, ПараметрыВыгрузки) Экспорт
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьОповещениеПользователя(Результат.КраткоеПредставлениеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
	Иначе                  
			
		ОбновитьИнтерфейс(); 
	    ОбновитьПовторноИспользуемыеЗначения();

		ОбщегоНазначенияКлиент.СообщитьПользователю("Завершено");     
		
	КонецЕсли;
	
	Возврат;
	
КонецПроцедуры
