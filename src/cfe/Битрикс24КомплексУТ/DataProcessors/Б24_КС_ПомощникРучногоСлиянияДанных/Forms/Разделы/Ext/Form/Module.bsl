
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	НастройкаПодключения 					= Параметры.НастройкаПодключения;
	Портал 									= НастройкаПодключения.Портал;
	СтруктураНастроек       				= Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если НЕ СтруктураНастроек = Неопределено Тогда
		Элементы.ЗаписатьРазделыВ1С.Доступность 	= СтруктураНастроек.СинхронизацияТоваров; 
	КонецЕсли;
	
	КоличествоОтображаемыхЭлементов	= ?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" ИЛИ ТипКонфигурации = "УНФ", 50, 100);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) Тогда
		Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаСинхронизацииПоТарифномуПлану();
		Закрыть();	
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя("Информация",,"Скорость загрузки зависит от их количества в Битрикс24", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);   
	
	ЗагрузкаСпискаКаталогов();
	
	ПроверитьЗаполнитьКаталогиПоУмолчанию();
	
	ИсточникИерархии = "Иерархия номенклатуры";
	
	ОбновитьОтображениеЭлементов();   
	
КонецПроцедуры

#КонецОбласти


#Область Прочие 

&НаСервере
Процедура СохранитьСлияниеДанных()
	
	ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	ПередаваемыеДанныеНаСервер = Новый Структура();
	ПередаваемыеДанныеНаСервер.Вставить("Портал"				, Портал);
	ПередаваемыеДанныеНаСервер.Вставить("ТипыОбъектовОбмена"	, ТипыДанныхДляОбменаСПорталом);
		
	мТаблицы = Новый Массив;
	мТаблицы.Добавить(ТаблицаРазделов);
	
	Для каждого ТекТаблица Из мТаблицы Цикл
		
		Если ТекТаблица = ТаблицаРазделов Тогда
			ТипДанных = ТипыДанныхДляОбменаСПорталом.ГруппаТовара2;
		КонецЕсли;
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("Портал", Портал);
		Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_К_ИдентификаторыОбъектов.ТипДанных КАК ТипДанных,
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ИдОбъектов
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
		|ГДЕ
		|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
		|	И Б24_К_ИдентификаторыОбъектов.ТипДанных =&ТипДанных
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор,
		|	ТипДанных";
		Запрос.Выполнить();
			
		Для каждого ТекЭлемент Из ТекТаблица Цикл
			
			Если ТекЭлемент.Изменена Тогда
				
				Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					Продолжить;
				КонецЕсли;
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				Запрос.УстановитьПараметр("Идентификатор", ТекЭлемент.Ид);
				Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
				Запрос.Текст = "ВЫБРАТЬ
				|	ВТ_ИдОбъектов.Идентификатор КАК Идентификатор
				|ИЗ
				|	ВТ_ИдОбъектов КАК ВТ_ИдОбъектов
				|ГДЕ
				|	ВТ_ИдОбъектов.Идентификатор = &Идентификатор
				|	И ВТ_ИдОбъектов.ТипДанных = &ТипДанных";
				ВыполненныйЗапрос = Запрос.Выполнить();
				
				Если НЕ ВыполненныйЗапрос.Пустой() Тогда
					
					Выборка = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.Выбрать(Новый Структура("ТипДанных", ТипДанных));
					Пока Выборка.Следующий() Цикл
						Если Выборка.Идентификатор = ТекЭлемент.Ид И Выборка.Портал = Портал Тогда
							Выборка.ПолучитьМенеджерЗаписи().Удалить();	
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
				
				РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(ПередаваемыеДанныеНаСервер, ТипДанных, ТекЭлемент.Сущность1С, ТекЭлемент.Ид);  
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	БылиИзменения = Ложь;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Ложь;
	
	НайтиСущности1СОбъектовБитрикс24();
	
КонецПроцедуры  

&НаКлиенте
Процедура РазвернутьДеревоСлиянияДанных()
	
	УзелДерева1 = ДеревоСлияния.ПолучитьЭлементы();
	Для каждого ТекСтрока1 Из УзелДерева1 Цикл
		Элементы.ДеревоСлияния.Развернуть(ТекСтрока1.ПолучитьИдентификатор());
		
		УзелДерева2 = ТекСтрока1.ПолучитьЭлементы();
		Для каждого ТекСтрока2 Из УзелДерева2 Цикл
			
			УзелДерева3 = ТекСтрока2.ПолучитьЭлементы();
			Для каждого ТекСтрока3 Из УзелДерева3 Цикл
					
				УзелДерева4 = ТекСтрока3.ПолучитьЭлементы();
				Для каждого ТекСтрока4 Из УзелДерева4 Цикл
					
					Если ТекСтрока4.Изменена Тогда
						Элементы.ДеревоСлияния.Развернуть(ТекСтрока3.ПолучитьИдентификатор());
					КонецЕсли;
					
					УзелДерева5 = ТекСтрока4.ПолучитьЭлементы();
					Для каждого ТекСтрока5 Из УзелДерева5 Цикл
						
						Если ТекСтрока5.Изменена Тогда
							Элементы.ДеревоСлияния.Развернуть(ТекСтрока4.ПолучитьИдентификатор());
						КонецЕсли;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла; 
	КонецЦикла;
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗагрузкаСпискаКаталогов()
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка каталогов на портале.";
	
	Каталоги = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек,	"/rest/catalog.catalog.list", "id", "", "catalogs");
	Если Каталоги.Количество() > 0 Тогда

		Элементы.ИдентификаторКаталогаТоваров.СписокВыбора.Очистить();

		Для Каждого ТекЭлемент Из Каталоги Цикл
			Элементы.ИдентификаторКаталогаТоваров.СписокВыбора.Добавить(Формат(ТекЭлемент.Получить("id"), "ЧГ=0"),
				ТекЭлемент.Получить("name"));
		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнитьКаталогиПоУмолчанию() 
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторКаталогаТоваров) Тогда 
		Для каждого ТекЭлемент Из Элементы.ИдентификаторКаталогаТоваров.СписокВыбора Цикл
			Если СтрНайти(ТекЭлемент.Представление, "(предложения)") = 0 Тогда
				ИдентификаторКаталогаТоваров = ТекЭлемент.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеЭлементов()
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	Элементы.ГруппаДеревоГрупп.Видимость = ИсточникИерархии = "Произвольная иерархия"; 

	Элементы.ДеревоСлиянияСущность1С.ВыборГруппИЭлементов = ГруппыИЭлементы.Авто;

	Если ИсточникИерархии = "Иерархия номенклатуры" Тогда             
		Элементы.ДеревоСлиянияСущность1С.ВыборГруппИЭлементов = ГруппыИЭлементы.Группы;
			Элементы.ДеревоСлиянияСущность1С.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Номенклатура"); 
	ИначеЕсли ИсточникИерархии = "Категории номенклатуры" Тогда   
			Элементы.ДеревоСлиянияСущность1С.ОграничениеТипа = Новый ОписаниеТипов(?(ТипКонфигурации = "УНФ", "СправочникСсылка.КатегорииНоменклатуры", "СправочникСсылка.ВидыНоменклатуры"));
	ИначеЕсли ИсточникИерархии = "Произвольная иерархия" Тогда
			Элементы.ДеревоСлиянияСущность1С.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Б24_КС_ПользовательскиеГруппыТоваров");
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьРазделы(Команда)
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторКаталогаТоваров) Тогда
		ПоказатьОповещениеПользователя("Информация",,"Не выбран каталог Битрикс24", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);   
		Возврат;
	КонецЕсли;

	Если БылиИзменения Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПовторнойЗагрузке", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "Изменения будут потеряны. Продолжить?", Режим, 0);
	Иначе
		ВыполнениеКомандыЗагрузитьРазделы();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПовторнойЗагрузке(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;

	ВыполнениеКомандыЗагрузитьРазделы();	

КонецПроцедуры

&НаКлиенте
Процедура ВыполнениеКомандыЗагрузитьРазделы()
	
	ДобавленныеРазделы.Очистить();
	ТаблицаРазделов.Очистить();
	ДеревоСлияния.ПолучитьЭлементы().Очистить();      
	
	ДлительнаяОперация = ВыполнитьЗагрузкуРазделовБитрикс24НаСервере();
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ФормаВладелец 		= ЭтотОбъект;
	ПараметрыОжидания.ВыводитьОкноОжидания 	= Истина;   
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииОперацииЗагрузки", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры     
	            
&НаСервере
Функция ВыполнитьЗагрузкуРазделовБитрикс24НаСервере()
		     
	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("НастройкаПодключения"			, НастройкаПодключения);
	ПередаваемыеПараметры.Вставить("ИдентификаторКаталогаТоваров"	, ИдентификаторКаталогаТоваров);
	ПередаваемыеПараметры.Вставить("ТаблицаРазделов"				, ТаблицаРазделов.Выгрузить().СкопироватьКолонки()); 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выполнение загрузки данных из Битрикс24' для слияния";
	
	Результат = ДлительныеОперации.ВыполнитьВФоне("Обработки.Б24_КС_ПомощникРучногоСлиянияДанных.ЗагрузитьРазделыПоФоновомуЗаданию", ПередаваемыеПараметры, ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции
 
&НаКлиенте
Процедура ПриЗавершенииОперацииЗагрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПортала = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

	Если ДанныеПортала = Неопределено Тогда                     
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось загрузить данные");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Элементы.ПоискСовпадений.Доступность = Истина;
	НомерПоследнегоЭлемента				 = 0;  
	
	МаксимальныйСквознойНомер = ДанныеПортала.МаксимальныйСквознойНомер;
  
	Для каждого ТекСтрока Из ДанныеПортала.ТаблицаРазделов Цикл
		НоваяСтрока = ТаблицаРазделов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);	
	КонецЦикла;
	
	ПоказатьОповещениеПользователя("Информация",,"Анализ сущностей 1С по ид Битрикс24", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	НайтиСущности1СОбъектовБитрикс24();
	
	ПоказатьОповещениеПользователя("Информация",,"Заполнение дерева", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры


&НаКлиенте
Процедура СледующаяПорцияЭлементов(Команда)
	
	ЗаполнитьДеревоЭлементов("Вперед");
	
	РазвернутьДеревоСлиянияДанных();

КонецПроцедуры

&НаКлиенте
Процедура ПредыдущаяПорцияЭлементов(Команда)
	
	ЗаполнитьДеревоЭлементов("Назад");
	
	РазвернутьДеревоСлиянияДанных();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДеревоЭлементов(Переход = "Вперед")
	
	Если Переход = "Вперед" Тогда
		НомерПоследнегоЭлемента = НомерПоследнегоЭлемента+КоличествоОтображаемыхЭлементов;
	Иначе
		НомерПоследнегоЭлемента = НомерПоследнегоЭлемента-КоличествоОтображаемыхЭлементов;
	КонецЕсли;
	
	Если НомерПоследнегоЭлемента > МаксимальныйСквознойНомер Тогда
		НомерПоследнегоЭлемента = МаксимальныйСквознойНомер;	
	КонецЕсли;
	
	Если Переход = "Вперед" Тогда
		ПервыйЭлемент 	 = НомерПоследнегоЭлемента-КоличествоОтображаемыхЭлементов;
		ПоследнийЭлемент = НомерПоследнегоЭлемента;
	Иначе
		ПервыйЭлемент 	 = НомерПоследнегоЭлемента-КоличествоОтображаемыхЭлементов;
		ПоследнийЭлемент = НомерПоследнегоЭлемента;
	КонецЕсли;
	
	ЭлементовВДереве = 0;
	ДеревоСлияния.ПолучитьЭлементы().Очистить();
	ДобавленныеРазделы.Очистить();   
	
	КорневойУзел 		= ДеревоСлияния.ПолучитьЭлементы();
	СоответствияУзлов 	= Новый Соответствие;
	
#Область ЗаполнениеДереваРазделов
	Для каждого ТекЭлемент Из ТаблицаРазделов Цикл
		
		Если НЕ (ТекЭлемент.СквознойНомер>ПервыйЭлемент И ТекЭлемент.СквознойНомер<=ПоследнийЭлемент) Тогда	
			Продолжить;	
		КонецЕсли;
		
		ЕстьНеСлившиеся = Ложь;
		НовыйУзел		= Неопределено;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) ИЛИ ТекЭлемент.Изменена  Тогда	
			ЕстьНеСлившиеся = Истина;	
		КонецЕсли;
		
		НовыйУзел = ЗаполнитьДеревоЭлементовРекурсивно(КорневойУзел, СоответствияУзлов, ТекЭлемент);
		Если НовыйУзел = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьНеСлившиеся ИЛИ ВТомЧислеУжеСлившиеся ИЛИ ТекЭлемент.Изменена Тогда
			
			ЭлементовВДереве = ЭлементовВДереве + 1;
			Если ЭлементовВДереве = КоличествоОтображаемыхЭлементов Тогда
				Прервать;
			КонецЕсли;
		Иначе   
			
			//КорневойУзел.Удалить(КорневойУзел.Индекс(НовыйУзел));
			
			Если Переход = "Вперед" Тогда
				ПоследнийЭлемент = ПоследнийЭлемент+1;
			Иначе
				ПервыйЭлемент = ПервыйЭлемент-1;
			КонецЕсли;
			
		КонецЕсли;
			                                    
	КонецЦикла;
		
#КонецОбласти	

	Если ЭлементовВДереве = КоличествоОтображаемыхЭлементов Тогда
		Возврат;	
	КонецЕсли;   
	
	Элементы.ДеревоСлияния.Обновить();
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьДеревоЭлементовРекурсивно(КорневойУзел, СоответствияУзлов, СтрокаДанных)
	
	НовыйУзел = Неопределено;
	
	Если ДобавленныеРазделы.НайтиПоЗначению(СтрокаДанных.Ид) <> Неопределено Тогда
		Возврат НовыйУзел;
	КонецЕсли;
	
	
	Если НЕ ЗначениеЗаполнено(СтрокаДанных.ИдРодителя) Тогда
		НовыйУзел = КорневойУзел.Добавить();      
	Иначе 
	
		ИдентификаторУзлаРодителя = СоответствияУзлов.Получить(СтрокаДанных.ИдРодителя);
		Если ИдентификаторУзлаРодителя <> Неопределено Тогда
			УзелРодитель = ДеревоСлияния.НайтиПоИдентификатору(ИдентификаторУзлаРодителя);
		Иначе  
			
			НайденныеСтроки = ТаблицаРазделов.НайтиСтроки(Новый Структура("Ид", СтрокаДанных.ИдРодителя));
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				НайденнаяСтрока = НайденныеСтроки[0];
				УзелРодитель = ЗаполнитьДеревоЭлементовРекурсивно(КорневойУзел, СоответствияУзлов, НайденнаяСтрока);	
			КонецЕсли;
				               
		КонецЕсли;      
		
		Если НЕ УзелРодитель = Неопределено Тогда
			НовыйУзел = УзелРодитель.ПолучитьЭлементы().Добавить();
		Иначе  
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не найден раздел с ид:"+СтрокаДанных.ИдРодителя+". раздел с Ид:"+СтрокаДанных.Ид+ " будет в корне."); 
			НовыйУзел = КорневойУзел.Добавить(); 
		КонецЕсли;
		
	КонецЕсли;    
	
	НовыйУзел.ИдСущности 	= СтрокаДанных.Ид;
	НовыйУзел.Изменена     	= СтрокаДанных.Изменена;
	НовыйУзел.Наименование 	= СтрокаДанных.Наименование;
	НовыйУзел.Сущность1С 	= СтрокаДанных.Сущность1С;
	
	ДопИнфо = "Идентификатор: " + СтрокаДанных.Ид;
	ДопИнфо = ДопИнфо + Символы.ПС + "Внешний идентификатор: " + СтрокаДанных.ВнешнийКод;
	НовыйУзел.ДопИнфСущности = ДопИнфо;
	
	СоответствияУзлов.Вставить(СтрокаДанных.Ид, НовыйУзел.ПолучитьИдентификатор()); 	
	
	ДобавленныеРазделы.Добавить(СтрокаДанных.Ид);
	
	Возврат НовыйУзел;

КонецФункции


&НаКлиенте
Процедура СохранитьИзменения(Команда)
	СохранитьСлияниеДанных();
	
	НомерПоследнегоЭлемента	= 0;
	ЗаполнитьДеревоЭлементов();
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры


&НаКлиенте
Процедура ПоискСовпадений(Команда)
	
	Если ИсточникИерархии = "Произвольная иерархия" И НЕ ЗначениеЗаполнено(ДеревоГрупп) Тогда      
		ПоказатьПредупреждение(,"Не выбрано дерево групп");   
		Возврат; 
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Список.Добавить("Внешний идентификатор"	,, Ложь);
	Список.Добавить("Наименование"			,, Ложь);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзМеню",ЭтотОбъект, Параметры);
	ПоказатьВыборИзМеню(Оповещение, Список, Элементы.ПоискСовпадений);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИзмененныеЭлементы()
	
	ЭлементыВДереве = Новый Структура;
	ЭлементыВДереве.Вставить("Раздел", Новый Массив);
	
	ЭлементыДерева = ДеревоСлияния.ПолучитьЭлементы();
	
	Для каждого ТекЭлемент Из ЭлементыДерева Цикл
		ЭлементыВДереве.Раздел.Добавить(ТекЭлемент.ИдСущности);	
	КонецЦикла;	
		
	Возврат ЭлементыВДереве;	
		
КонецФункции

#КонецОбласти


#Область ПоискСовпадений

&НаКлиенте
Процедура ПослеВыбораИзМеню(ВыбранныйЭлемент, Параметры) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОткрытогоДерева = ПолучитьИзмененныеЭлементы();
	
	Если ВыбранныйЭлемент.Значение = "Внешний идентификатор" Тогда
#Область ВнешнийИдентификатор
		мТаблицы = Новый Массив;
		мТаблицы.Добавить(ТаблицаРазделов);
		
		Для каждого ТекТаблица Из мТаблицы Цикл
			Для каждого ТекЭлемент Из ТекТаблица Цикл
				
				Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					Продолжить;	
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ТекЭлемент.ВнешнийКод) Тогда
					Продолжить;	
				КонецЕсли;
				
				Если ТекТаблица = ТаблицаРазделов Тогда
					Если ДанныеОткрытогоДерева.Раздел.Найти(ТекЭлемент.Ид) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Если ИсточникИерархии = "Иерархия номенклатуры" Тогда
					ТекЭлемент.Сущность1С 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Номенклатура"), ТекЭлемент.ВнешнийКод); 
				ИначеЕсли ИсточникИерархии = "Категории номенклатуры" Тогда   
					ТекЭлемент.Сущность1С 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени(?(ТипКонфигурации = "УНФ", "СправочникСсылка.КатегорииНоменклатуры", "СправочникСсылка.ВидыНоменклатуры")), ТекЭлемент.ВнешнийКод); 
				ИначеЕсли ИсточникИерархии = "Произвольная иерархия" Тогда
					ТекЭлемент.Сущность1С 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Б24_КС_ПользовательскиеГруппыТоваров"), ТекЭлемент.ВнешнийКод); 
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					ТекЭлемент.Изменена	= Истина;
					БылиИзменения = Истина;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
#КонецОбласти
		
	ИначеЕсли ВыбранныйЭлемент.Значение = "Наименование" Тогда	
		ПоискПоНаименованию(ДанныеОткрытогоДерева);
	КонецЕсли;
	
	НомерПоследнегоЭлемента	= НомерПоследнегоЭлемента - КоличествоОтображаемыхЭлементов;    
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
	Если БылиИзменения Тогда
		Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура ПоискПоНаименованию(ДанныеОткрытогоДерева)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ИмяСправочникаКатегорий = ?(ТипКонфигурации = "УНФ", "КатегорииНоменклатуры", "ВидыНоменклатуры");
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;  
	
	Если ИсточникИерархии = "Иерархия номенклатуры" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ИСТИНА";
		
	ИначеЕсли ИсточникИерархии = "Категории номенклатуры" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	" + ИмяСправочникаКатегорий + ".Ссылка КАК Ссылка,
		|	" + ИмяСправочникаКатегорий + ".Наименование КАК Наименование
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	Справочник." + ИмяСправочникаКатегорий + " КАК " + ИмяСправочникаКатегорий + "";
	ИначеЕсли ИсточникИерархии = "Произвольная иерархия" Тогда
		Запрос.УстановитьПараметр("ДеревоГрупп", ДеревоГрупп);
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_КС_ПользовательскиеГруппыТоваров.Ссылка КАК Ссылка,
		|	Б24_КС_ПользовательскиеГруппыТоваров.Наименование КАК Наименование
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	Справочник.Б24_КС_ПользовательскиеГруппыТоваров КАК Б24_КС_ПользовательскиеГруппыТоваров
		|ГДЕ
		|	Б24_КС_ПользовательскиеГруппыТоваров.Ссылка В ИЕРАРХИИ(&ДеревоГрупп)";
	КонецЕсли;
	
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаРазделов Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Наименование) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Раздел.Найти(ТекЭлемент.Ид) = Неопределено 
			И ДанныеОткрытогоДерева.Раздел.Найти(ТекЭлемент.ИдРодителя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
					
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("Наименование", ТекЭлемент.Наименование);
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_Данные.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные
		|ГДЕ
		|	ВТ_Данные.Наименование = &Наименование";
		ВыполненныйЗапрос = Запрос.Выполнить();
			
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			тзнДанных = ВыполненныйЗапрос.Выгрузить();
			Сущность1С = тзнДанных[0].Ссылка;
		
			ТекЭлемент.Сущность1С = Сущность1С; 
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
  
#КонецОбласти


#Область ЗагрузкаДанныхСБитрикс24

&НаСервере
Функция СформироватьВременнуюТаблицуИдентификаторов(ТипДанных)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ТаблицаДанных
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанных
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор";
	Запрос.Выполнить();  	
	
	Возврат МенеджерВременныхТаблиц; 
	
КонецФункции

&НаСервере
Функция НайтиЭлементПоИд(МенеджерВременныхТаблиц, ИдЭлемента)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Идентификатор", ИдЭлемента);
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ТаблицаДанных.Объект КАК Объект
	|ИЗ
	|	ВТ_ТаблицаДанных КАК ВТ_ТаблицаДанных
	|ГДЕ
	|	ВТ_ТаблицаДанных.Идентификатор = &Идентификатор";
	ВыполненныйЗапрос = Запрос.Выполнить();  	
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		тзнВрем = ВыполненныйЗапрос.Выгрузить();
		Результат = тзнВрем[0].Объект;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НайтиСущности1СОбъектовБитрикс24()
	
	ТипыДанных = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	МенеджерВременныхТаблиц = СформироватьВременнуюТаблицуИдентификаторов(ТипыДанных.ГруппаТовара2);
	Для каждого ТекЭлемент Из ТаблицаРазделов Цикл
		ТекЭлемент.Сущность1С 	= НайтиЭлементПоИд(МенеджерВременныхТаблиц, ТекЭлемент.Ид);	
		ТекЭлемент.Изменена		= Ложь;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьРазделыВ1СНаСервере(МассивСтрок)
	МассивОбъектов = Новый Массив;
	МассивИД = Новый Массив;
	
	Для Каждого ЭлМассива из МассивСтрок Цикл
		СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива);
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.Сущность1С) Тогда
			ДанныеОбъекта = Новый Структура;
			ДанныеОбъекта.Вставить("ИдСтроки", ЭлМассива);
			ДанныеОбъекта.Вставить("ИдОбъекта", СтрокаДерева.ИдСущности);
			МассивОбъектов.Добавить(ДанныеОбъекта);
			МассивИД.Добавить(СтрокаДерева.ИдСущности);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураНастроек =  Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
		
	Для Каждого ЭлМассива из МассивОбъектов Цикл		
		ИнформацияОбъекта = Б24_КС_ЗагрузкаСервер.СформироватьРазделПоИдСЗаписью(СтруктураНастроек, ЭлМассива.ИдОбъекта);			
		Если ИнформацияОбъекта <> Неопределено Тогда
			ТекущийОбъект = ИнформацияОбъекта;
		КонецЕсли;		
		
		Если ЗначениеЗаполнено(ТекущийОбъект) Тогда
			СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива.ИдСтроки);
			СтрокаДерева.Сущность1С = ТекущийОбъект;
		КонецЕсли;
	КонецЦикла;		
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДеревоСлиянияПриИзменении(Элемент)
	
	БылиИзменения = Истина;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	
	Элементы.ДеревоСлияния.ТекущиеДанные.Изменена = Истина;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	
	НайденныеСтроки = ТаблицаРазделов.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
		НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСлиянияПриАктивизацииСтроки(Элемент)
		      
	ЭлементДанных = Элементы.ДеревоСлияния.ТекущийЭлемент;
	
	Если ЭлементДанных = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдСущности) Тогда
		ЭлементДанных.ТолькоПросмотр = Истина;	
		Возврат;
	Иначе
		ЭлементДанных.ТолькоПросмотр = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВТомЧислеУжеСлившиесяПриИзменении(Элемент)
	
	НомерПоследнегоЭлемента	= 0;
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьНаСтраницеПриИзменении(Элемент)
		
	НомерПоследнегоЭлемента	= 0;
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();

КонецПроцедуры

