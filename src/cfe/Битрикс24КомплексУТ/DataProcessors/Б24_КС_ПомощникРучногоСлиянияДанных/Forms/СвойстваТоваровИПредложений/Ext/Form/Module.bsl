
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаПодключения 						= Параметры.НастройкаПодключения;
	Портал 										= НастройкаПодключения.Портал;
	СтруктураНастроек       					= Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если НЕ СтруктураНастроек = Неопределено Тогда
		Элементы.ЗаписатьСвойстваВ1С.Доступность 	= СтруктураНастроек.СинхронизацияТоваров; 
	КонецЕсли;
	
	КоличествоОтображаемыхЭлементов	= 50;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	Если НЕ Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) Тогда
		Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаСинхронизацииПоТарифномуПлану();
		Закрыть();	
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя("Информация",,"Скорость загрузки зависит от их количества в Битрикс24", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	
	ЗагрузкаСпискаКаталогов();
	
	ПроверитьЗаполнитьКаталогиПоУмолчанию();

КонецПроцедуры

#КонецОбласти


#Область Прочие


&НаСервере
Процедура СохранитьСлияниеДанных()
	
	ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	ПередаваемыеДанныеНаСервер = Новый Структура();
	ПередаваемыеДанныеНаСервер.Вставить("Портал"				, Портал);
	ПередаваемыеДанныеНаСервер.Вставить("ТипыОбъектовОбмена"	, ТипыДанныхДляОбменаСПорталом);
		
	мТаблицы = Новый Массив;
	мТаблицы.Добавить(ТаблицаСвойств);
	мТаблицы.Добавить(ТаблицаЗначенийСвойств);
	
	Для каждого ТекТаблица Из мТаблицы Цикл
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("Портал", Портал);
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_К_ИдентификаторыОбъектов.ТипДанных КАК ТипДанных,
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ИдОбъектов
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
		|ГДЕ
		|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор,
		|	ТипДанных";
		Запрос.Выполнить();
			
		Для каждого ТекЭлемент Из ТекТаблица Цикл
			
			Если ТекЭлемент.Изменена Тогда
				
				Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТекЭлемент.ТипОбъекта = "Товар" И ТекТаблица = ТаблицаСвойств Тогда 
					ТипДанных = ТипыДанныхДляОбменаСПорталом.СвойствоТовара2;
				ИначеЕсли ТекЭлемент.ТипОбъекта = "Предложение" И ТекТаблица = ТаблицаСвойств Тогда 
					ТипДанных = ТипыДанныхДляОбменаСПорталом.СвойствоПредложения;
				ИначеЕсли ТекЭлемент.ТипОбъекта = "Товар" И ТекТаблица = ТаблицаЗначенийСвойств Тогда 
					ТипДанных = ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваТовара2;
				ИначеЕсли ТекЭлемент.ТипОбъекта = "Предложение" И ТекТаблица = ТаблицаЗначенийСвойств Тогда 
					ТипДанных = ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваПредложения;
				КонецЕсли;	
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				Запрос.УстановитьПараметр("Идентификатор", ТекЭлемент.Ид);
				Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
				Запрос.Текст = "ВЫБРАТЬ
				|	ВТ_ИдОбъектов.Идентификатор КАК Идентификатор
				|ИЗ
				|	ВТ_ИдОбъектов КАК ВТ_ИдОбъектов
				|ГДЕ
				|	ВТ_ИдОбъектов.Идентификатор = &Идентификатор
				|	И ВТ_ИдОбъектов.ТипДанных = &ТипДанных";
				ВыполненныйЗапрос = Запрос.Выполнить();
				
				Если НЕ ВыполненныйЗапрос.Пустой() Тогда
					
					Выборка = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.Выбрать(Новый Структура("ТипДанных", ТипДанных));
					Пока Выборка.Следующий() Цикл
						Если Выборка.Идентификатор = ТекЭлемент.Ид И Выборка.Портал = Портал Тогда
							Выборка.ПолучитьМенеджерЗаписи().Удалить();	
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(ПередаваемыеДанныеНаСервер, ТипДанных, ТекЭлемент.Сущность1С, ТекЭлемент.Ид);  
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	БылиИзменения = Ложь;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Ложь;
	
	НайтиСущности1СОбъектовБитрикс24();
	
КонецПроцедуры  

&НаКлиенте
Процедура РазвернутьДеревоСлиянияДанных()
	
	УзелДерева1 = ДеревоСлияния.ПолучитьЭлементы();
	Для каждого ТекСтрока1 Из УзелДерева1 Цикл
		Элементы.ДеревоСлияния.Развернуть(ТекСтрока1.ПолучитьИдентификатор());
		
		УзелДерева2 = ТекСтрока1.ПолучитьЭлементы();
		Для каждого ТекСтрока2 Из УзелДерева2 Цикл
			
			УзелДерева3 = ТекСтрока2.ПолучитьЭлементы();
			Для каждого ТекСтрока3 Из УзелДерева3 Цикл
					
				УзелДерева4 = ТекСтрока3.ПолучитьЭлементы();
				Для каждого ТекСтрока4 Из УзелДерева4 Цикл
					
					Если ТекСтрока4.Изменена Тогда
						Элементы.ДеревоСлияния.Развернуть(ТекСтрока3.ПолучитьИдентификатор());
					КонецЕсли;
					
					УзелДерева5 = ТекСтрока4.ПолучитьЭлементы();
					Для каждого ТекСтрока5 Из УзелДерева5 Цикл
						
						Если ТекСтрока5.Изменена Тогда
							Элементы.ДеревоСлияния.Развернуть(ТекСтрока4.ПолучитьИдентификатор());
						КонецЕсли;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла; 
	КонецЦикла;
	
КонецПроцедуры  


&НаКлиенте
Процедура ЗагрузкаСпискаКаталогов()
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка каталогов на портале.";
	
	Каталоги = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек,	"/rest/catalog.catalog.list", "id", "", "catalogs");
	Если Каталоги.Количество() > 0 Тогда

		Элементы.ИдентификаторКаталогаТоваров.СписокВыбора.Очистить();
		Элементы.ИдентификаторКаталогаПредложений.СписокВыбора.Очистить();

		Для Каждого ТекЭлемент Из Каталоги Цикл
			Элементы.ИдентификаторКаталогаТоваров.СписокВыбора.Добавить(Формат(ТекЭлемент.Получить("id"), "ЧГ=0"),
				ТекЭлемент.Получить("name"));
			Элементы.ИдентификаторКаталогаПредложений.СписокВыбора.Добавить(Формат(ТекЭлемент.Получить("id"), "ЧГ=0"),
				ТекЭлемент.Получить("name"));
		КонецЦикла;


	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнитьКаталогиПоУмолчанию() 
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторКаталогаТоваров) Тогда 
		Для каждого ТекЭлемент Из Элементы.ИдентификаторКаталогаТоваров.СписокВыбора Цикл
			Если СтрНайти(ТекЭлемент.Представление, "(предложения)") = 0 Тогда
				ИдентификаторКаталогаТоваров = ТекЭлемент.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторКаталогаПредложений) Тогда
		Для каждого ТекЭлемент Из Элементы.ИдентификаторКаталогаПредложений.СписокВыбора Цикл
			Если СтрНайти(ТекЭлемент.Представление, "(предложения)") > 0 Тогда
				ИдентификаторКаталогаПредложений = ТекЭлемент.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьСвойства(Команда)
	
	Если БылиИзменения Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПовторнойЗагрузке", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "Изменения будут потеряны. Продолжить?", Режим, 0);
	Иначе   
		ВыполнениеКомандыЗагрузитьСвойства();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПовторнойЗагрузке(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнениеКомандыЗагрузитьСвойства();	

КонецПроцедуры

&НаКлиенте
Процедура ВыполнениеКомандыЗагрузитьСвойства()
	
	ТаблицаСвойств.Очистить();
	ТаблицаЗначенийСвойств.Очистить();
	ДеревоСлияния.ПолучитьЭлементы().Очистить();      
	
	ДлительнаяОперация = ВыполнитьЗагрузкуСвойствБитрикс24НаСервере();
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ФормаВладелец 		= ЭтотОбъект;
	ПараметрыОжидания.ВыводитьОкноОжидания 	= Истина;   
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииОперацииЗагрузки", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры     
	            
&НаСервере
Функция ВыполнитьЗагрузкуСвойствБитрикс24НаСервере()
	
	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("НастройкаПодключения"				, НастройкаПодключения);
	ПередаваемыеПараметры.Вставить("ИдентификаторКаталогаТоваров"		, ИдентификаторКаталогаТоваров);
	ПередаваемыеПараметры.Вставить("ИдентификаторКаталогаПредложений"	, ИдентификаторКаталогаПредложений);    
	
	ПередаваемыеПараметры.Вставить("ТаблицаСвойств"			, ТаблицаСвойств.Выгрузить().СкопироватьКолонки()); 
	ПередаваемыеПараметры.Вставить("ТаблицаЗначенийСвойств"	, ТаблицаЗначенийСвойств.Выгрузить().СкопироватьКолонки());
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выполнение загрузки данных из Битрикс24' для слияния";
	
	Результат = ДлительныеОперации.ВыполнитьВФоне("Обработки.Б24_КС_ПомощникРучногоСлиянияДанных.ЗагрузитьСвойстваТоваровПредложенийПоФоновомуЗаданию", ПередаваемыеПараметры, ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции
 
&НаКлиенте
Процедура ПриЗавершенииОперацииЗагрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ДанныеПортала = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

	Если ДанныеПортала = Неопределено Тогда                     
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось загрузить данные");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Элементы.ПоискСовпадений.Доступность = Истина;
	НомерПоследнегоЭлемента				 = 0;  
	
	МаксимальныйСквознойНомер = ДанныеПортала.МаксимальныйСквознойНомер;
  
	Для каждого ТекСтрока Из ДанныеПортала.ТаблицаСвойств Цикл
		НоваяСтрока = ТаблицаСвойств.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);	
	КонецЦикла;
	
	Для каждого ТекСтрока Из ДанныеПортала.ТаблицаЗначенийСвойств Цикл
		НоваяСтрока = ТаблицаЗначенийСвойств.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);	
	КонецЦикла;
	
		
	ПоказатьОповещениеПользователя("Информация",,"Анализ сущностей 1С по ид Битрикс24", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	НайтиСущности1СОбъектовБитрикс24();
	
	ПоказатьОповещениеПользователя("Информация",,"Заполнение дерева", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры


&НаКлиенте
Процедура СледующаяПорцияЭлементов(Команда)
	
	ЗаполнитьДеревоЭлементов("Вперед");
	
	РазвернутьДеревоСлиянияДанных();

КонецПроцедуры

&НаКлиенте
Процедура ПредыдущаяПорцияЭлементов(Команда)
	
	ЗаполнитьДеревоЭлементов("Назад");
	
	РазвернутьДеревоСлиянияДанных();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДеревоЭлементов(Переход = "Вперед")
	
	Если Переход = "Вперед" Тогда
		НомерПоследнегоЭлемента = НомерПоследнегоЭлемента+КоличествоОтображаемыхЭлементов;
	Иначе
		НомерПоследнегоЭлемента = НомерПоследнегоЭлемента-КоличествоОтображаемыхЭлементов;
	КонецЕсли;
	
	Если НомерПоследнегоЭлемента > МаксимальныйСквознойНомер Тогда
		НомерПоследнегоЭлемента = МаксимальныйСквознойНомер;	
	КонецЕсли;
	
	Если Переход = "Вперед" Тогда
		ПервыйЭлемент 	 = НомерПоследнегоЭлемента-КоличествоОтображаемыхЭлементов;
		ПоследнийЭлемент = НомерПоследнегоЭлемента;
	Иначе
		ПервыйЭлемент 	 = НомерПоследнегоЭлемента-КоличествоОтображаемыхЭлементов;
		ПоследнийЭлемент = НомерПоследнегоЭлемента;
	КонецЕсли;
	
	ЭлементовВДереве = 0;
	ДеревоСлияния.ПолучитьЭлементы().Очистить();
	КорневойУзел = ДеревоСлияния.ПолучитьЭлементы();
	
	мТипыОбъектовЗагрузки = Новый СписокЗначений;
	мТипыОбъектовЗагрузки.Добавить("Товар"		, "Свойства товаров");
	мТипыОбъектовЗагрузки.Добавить("Предложение", "Свойства предложений");
	
	Для каждого ТекТипОбъекта Из мТипыОбъектовЗагрузки Цикл

		Если ЭлементовВДереве = КоличествоОтображаемыхЭлементов Тогда
			Возврат;	
		КонецЕсли;
		
		УзелСвойствКомпаний = КорневойУзел.Добавить();
		УзелСвойствКомпаний.Наименование = ТекТипОбъекта.Представление;
		ТекУзелСвойствКомпаний = УзелСвойствКомпаний.ПолучитьЭлементы();

		Для каждого ТекЭлемент Из ТаблицаСвойств Цикл
			
			Если ТекЭлемент.ТипОбъекта <> ТекТипОбъекта.Значение Тогда
				Продолжить;
			КонецЕсли;
			  
			Если НЕ (ТекЭлемент.СквознойНомер>ПервыйЭлемент И ТекЭлемент.СквознойНомер<=ПоследнийЭлемент) Тогда	
				Продолжить;	
			КонецЕсли;
			
			ЕстьНеСлившиеся = Ложь;
			
			Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) ИЛИ ТекЭлемент.Изменена Тогда	
				ЕстьНеСлившиеся = Истина;	
			КонецЕсли;
			
			НовоеПоле = ТекУзелСвойствКомпаний.Добавить();
			НовоеПоле.ИдСущности 		= ТекЭлемент.Ид;
			НовоеПоле.ТипСущности      	= ТекЭлемент.ТипОбъекта;
			НовоеПоле.Изменена      	= ТекЭлемент.Изменена;
			НовоеПоле.Наименование 		= ТекЭлемент.Наименование;
			НовоеПоле.Сущность1С 		= ТекЭлемент.Сущность1С;
				
			ДопИнфо = "Базовый тип: " + ТекЭлемент.ТипСвойства;
			ДопИнфо = ДопИнфо + Символы.ПС + "Тип: " + ТекЭлемент.ПользовательскийТип;
			ДопИнфо = ДопИнфо + Символы.ПС + "Идентификатор: " + ТекЭлемент.Ид;
			НовоеПоле.ДопИнфСущности 	= ДопИнфо;
			
			НайденныеЗначенияСвойств = ТаблицаЗначенийСвойств.НайтиСтроки(Новый Структура("ИдВладельца, ТипОбъекта",ТекЭлемент.Ид, ТекТипОбъекта.Значение));
			Если НайденныеЗначенияСвойств.Количество()>0 Тогда
				
				ТекНовоеПоле = НовоеПоле.ПолучитьЭлементы();
				ИнфоЗначенияСвойств = ТекНовоеПоле.Добавить();
				ИнфоЗначенияСвойств.Наименование = "Значения свойств поля";
				
				ТекИнфоЗначенияСвойств = ИнфоЗначенияСвойств.ПолучитьЭлементы();
				
				Для каждого ТекЗначениеСвойства Из НайденныеЗначенияСвойств Цикл
					
					Если НЕ ЗначениеЗаполнено(ТекЗначениеСвойства.Сущность1С) ИЛИ ТекЗначениеСвойства.Изменена Тогда	
						ЕстьНеСлившиеся = Истина;	
					КонецЕсли;
					
					НовоеЗначениеПоля = ТекИнфоЗначенияСвойств.Добавить();
					НовоеЗначениеПоля.ИдСущности 		= ТекЗначениеСвойства.Ид;
					НовоеЗначениеПоля.ТипСущности      	= "ЗН_"+ТекЭлемент.ТипОбъекта;
					НовоеЗначениеПоля.Изменена      	= ТекЗначениеСвойства.Изменена;
					НовоеЗначениеПоля.Наименование 		= ТекЗначениеСвойства.Наименование;
					НовоеЗначениеПоля.Сущность1С 		= ТекЗначениеСвойства.Сущность1С;
					
					ДопИнфо = "Идентификатор: " + ТекЗначениеСвойства.Ид;
					НовоеЗначениеПоля.ДопИнфСущности 	= ДопИнфо;
					
				КонецЦикла;
			КонецЕсли;
			
			Если ЕстьНеСлившиеся ИЛИ ВТомЧислеУжеСлившиеся ИЛИ ТекЭлемент.Изменена Тогда
				
				ЭлементовВДереве = ЭлементовВДереве + 1;
				Если ЭлементовВДереве = КоличествоОтображаемыхЭлементов Тогда
					Прервать;
				КонецЕсли;
			Иначе
				ТекУзелСвойствКомпаний.Удалить(ТекУзелСвойствКомпаний.Индекс(НовоеПоле));
				
				Если Переход = "Вперед" Тогда
					ПоследнийЭлемент = ПоследнийЭлемент+1;
				Иначе
					ПервыйЭлемент = ПервыйЭлемент-1;
				КонецЕсли;
				
			КонецЕсли;
				                                    
		КонецЦикла;
			
		Если ТекУзелСвойствКомпаний.Количество() = 0 Тогда
			КорневойУзел.Удалить(КорневойУзел.Индекс(УзелСвойствКомпаний));
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.ДеревоСлияния.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	СохранитьСлияниеДанных();
	
	НомерПоследнегоЭлемента	= 0;
	ЗаполнитьДеревоЭлементов();
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры


&НаКлиенте
Процедура ПоискСовпадений(Команда)
	
	Список = Новый СписокЗначений;
	Список.Добавить("Внешний идентификатор"	,, Ложь);
	Список.Добавить("Наименование"			,, Ложь);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзМеню",ЭтотОбъект, Параметры);
	ПоказатьВыборИзМеню(Оповещение, Список, Элементы.ПоискСовпадений);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИзмененныеЭлементы()
	
	ЭлементыВДереве = Новый Структура;
	ЭлементыВДереве.Вставить("Свойство"			, Новый Массив);
	ЭлементыВДереве.Вставить("ЗначениеСвойства"	, Новый Массив);
	
	ЭлементыДерева = ДеревоСлияния.ПолучитьЭлементы();
	
	Для каждого ТекЭлемент Из ЭлементыДерева Цикл
		ПолучитьИзмененныеЭлементыРекурсивно(ТекЭлемент.ПолучитьЭлементы(), ЭлементыВДереве);
	КонецЦикла;	
		
	Возврат ЭлементыВДереве;	
		
КонецФункции

&НаКлиенте
Процедура ПолучитьИзмененныеЭлементыРекурсивно(ЭлементыДерева, ЭлементыВДереве)
	
	Для каждого ТекЭлемент Из ЭлементыДерева Цикл
		
		Если Лев(ТекЭлемент.ТипСущности, 3) <> "ЗН_" Тогда
			ЭлементыВДереве.Свойство.Добавить(ТекЭлемент.ИдСущности);	
		Иначе
			ЭлементыВДереве.ЗначениеСвойства.Добавить(ТекЭлемент.ИдСущности);	
		КонецЕсли;
		
		НовыеЭлементы = ТекЭлемент.ПолучитьЭлементы();
		Если НовыеЭлементы.Количество() > 0 Тогда
			ПолучитьИзмененныеЭлементыРекурсивно(НовыеЭлементы, ЭлементыВДереве);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ПоискСовпадений

&НаКлиенте
Процедура ПослеВыбораИзМеню(ВыбранныйЭлемент, Параметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОткрытогоДерева = ПолучитьИзмененныеЭлементы();
	
	Если ВыбранныйЭлемент.Значение = "Внешний идентификатор" Тогда
#Область ВнешнийИдентификатор
		мТаблицы = Новый Массив;
		мТаблицы.Добавить(ТаблицаСвойств);
		мТаблицы.Добавить(ТаблицаЗначенийСвойств);
		
		Для каждого ТекТаблица Из мТаблицы Цикл
			Для каждого ТекЭлемент Из ТекТаблица Цикл
				
				Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					Продолжить;	
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ТекЭлемент.ВнешнийКод) Тогда
					Продолжить;	
				КонецЕсли;
				
				Если ТекТаблица = ТаблицаСвойств Тогда
					Если ДанныеОткрытогоДерева.Свойство.Найти(ТекЭлемент.Ид) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				ИначеЕсли ТекТаблица = ТаблицаЗначенийСвойств Тогда
					Если ДанныеОткрытогоДерева.ЗначениеСвойства.Найти(ТекЭлемент.Ид) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				ТипДанных = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения");
				
				Если ТекТаблица = ТаблицаСвойств Тогда
					ТипДанных = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения");
				ИначеЕсли ТекТаблица = ТаблицаЗначенийСвойств Тогда
					ТипДанных = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.ЗначенияСвойствОбъектов");
				КонецЕсли;
				
				ТекЭлемент.Сущность1С 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(ТипДанных, ТекЭлемент.ВнешнийКод); 
				
				Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					ТекЭлемент.Изменена	= Истина;
					БылиИзменения = Истина;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
#КонецОбласти
		
	ИначеЕсли ВыбранныйЭлемент.Значение = "Наименование" Тогда	
		ПоискСвойствПоНаименованию(ДанныеОткрытогоДерева);
	КонецЕсли;
		  
	НомерПоследнегоЭлемента	= НомерПоследнегоЭлемента - КоличествоОтображаемыхЭлементов;
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
	Если БылиИзменения Тогда
		Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоискСвойствПоНаименованию(ДанныеОткрытогоДерева)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка,
	|	ДополнительныеРеквизитыИСведения.Заголовок КАК Заголовок
	|ПОМЕСТИТЬ ВТ_ДанныеСвойств
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заголовок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Ссылка КАК Ссылка,
	|	ЗначенияСвойствОбъектов.Наименование КАК Наименование,
	|	ЗначенияСвойствОбъектов.Владелец КАК Владелец
	|ПОМЕСТИТЬ ВТ_ДанныеЗначенийСвойств
	|ИЗ
	|	Справочник.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Наименование,
	|	Владелец";
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаСвойств Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Наименование) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Свойство.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
					
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("Заголовок", ТекЭлемент.Наименование);
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_ДанныеСвойств.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ДанныеСвойств КАК ВТ_ДанныеСвойств
		|ГДЕ
		|	ВТ_ДанныеСвойств.Заголовок = &Заголовок";
		ВыполненныйЗапрос = Запрос.Выполнить();
			
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			тзнДанных = ВыполненныйЗапрос.Выгрузить();
			Сущность1С = тзнДанных[0].Ссылка;
		
			ТекЭлемент.Сущность1С = Сущность1С; 
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ТекЭлемент Из ТаблицаЗначенийСвойств Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Наименование) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.ЗначениеСвойства.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
					
		НайденныеСтроки = ТаблицаСвойств.НайтиСтроки(Новый Структура("Ид, ТипОбъекта", ТекЭлемент.ИдВладельца, ТекЭлемент.ТипОбъекта));
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ВладелецЗначенияСвойств = НайденныеСтроки[0].Сущность1С;
			Если ЗначениеЗаполнено(ВладелецЗначенияСвойств) Тогда
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				Запрос.УстановитьПараметр("Наименование", ТекЭлемент.Наименование);
				Запрос.УстановитьПараметр("Владелец"	, ВладелецЗначенияСвойств);
				Запрос.Текст = "ВЫБРАТЬ
				|	ВТ_ДанныеЗначенийСвойств.Ссылка КАК Ссылка
				|ИЗ
				|	ВТ_ДанныеЗначенийСвойств КАК ВТ_ДанныеЗначенийСвойств
				|ГДЕ
				|	ВТ_ДанныеЗначенийСвойств.Наименование = &Наименование
				|	И ВТ_ДанныеЗначенийСвойств.Владелец = &Владелец";
				ВыполненныйЗапрос = Запрос.Выполнить();
					
				Если НЕ ВыполненныйЗапрос.Пустой() Тогда
					тзнДанных = ВыполненныйЗапрос.Выгрузить();
					Сущность1С = тзнДанных[0].Ссылка;
				
					ТекЭлемент.Сущность1С = Сущность1С; 
					Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
						ТекЭлемент.Изменена	= Истина;
						БылиИзменения = Истина;
					КонецЕсли;
				КонецЕсли;
			
			КонецЕсли;
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ЗагрузкаДанныхСБитрикс24

&НаСервере
Функция СформироватьВременнуюТаблицуИдентификаторов(ТипДанных)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ТаблицаДанных
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанных
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор";
	Запрос.Выполнить();  	
	
	Возврат МенеджерВременныхТаблиц; 
	
КонецФункции

&НаСервере
Функция НайтиЭлементПоИд(МенеджерВременныхТаблиц, ИдЭлемента)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Идентификатор", ИдЭлемента);
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ТаблицаДанных.Объект КАК Объект
	|ИЗ
	|	ВТ_ТаблицаДанных КАК ВТ_ТаблицаДанных
	|ГДЕ
	|	ВТ_ТаблицаДанных.Идентификатор = &Идентификатор";
	ВыполненныйЗапрос = Запрос.Выполнить();  	
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		тзнВрем = ВыполненныйЗапрос.Выгрузить();
		Результат = тзнВрем[0].Объект;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НайтиСущности1СОбъектовБитрикс24()
	
	спкАнализДанных = Новый СписокЗначений;
	спкАнализДанных.Добавить(Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом.СвойствоТовара2	, "Товар");
	спкАнализДанных.Добавить(Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом.СвойствоПредложения, "Предложение");
	
	Для каждого ТекЭлементАнализа Из спкАнализДанных Цикл
		МенеджерВременныхТаблиц = СформироватьВременнуюТаблицуИдентификаторов(ТекЭлементАнализа.Значение);
		Для каждого ТекЭлемент Из ТаблицаСвойств Цикл
			Если ТекЭлемент.ТипОбъекта = ТекЭлементАнализа.Представление Тогда 
				ТекЭлемент.Сущность1С 	= НайтиЭлементПоИд(МенеджерВременныхТаблиц, ТекЭлемент.Ид);	
				ТекЭлемент.Изменена		= Ложь;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	спкАнализДанных = Новый СписокЗначений;
	спкАнализДанных.Добавить(Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваТовара2	, "Товар");
	спкАнализДанных.Добавить(Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваПредложения, "Предложение");
	
	Для каждого ТекЭлементАнализа Из спкАнализДанных Цикл
		МенеджерВременныхТаблиц = СформироватьВременнуюТаблицуИдентификаторов(ТекЭлементАнализа.Значение);
		Для каждого ТекЭлемент Из ТаблицаЗначенийСвойств Цикл
			Если ТекЭлемент.ТипОбъекта = ТекЭлементАнализа.Представление Тогда 
				ТекЭлемент.Сущность1С 	= НайтиЭлементПоИд(МенеджерВременныхТаблиц, ТекЭлемент.Ид);	
				ТекЭлемент.Изменена		= Ложь;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСвойстваВ1СНаСервере(МассивСтрок)
	МассивОбъектов = Новый Массив;
	МассивИД = Новый Массив;
	
	Для Каждого ЭлМассива из МассивСтрок Цикл
		СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива);
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.Сущность1С) Тогда
			ДанныеОбъекта = Новый Структура;
			ДанныеОбъекта.Вставить("ИдСтроки", ЭлМассива);
			ДанныеОбъекта.Вставить("ИдОбъекта", СтрокаДерева.ИдСущности);
			МассивОбъектов.Добавить(ДанныеОбъекта);
			МассивИД.Добавить(СтрокаДерева.ИдСущности);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураНастроек =  Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
		
	Для Каждого ЭлМассива из МассивОбъектов Цикл	
		ИнформацияОбъекта = Б24_КС_ЗагрузкаСервер.СформироватьСвойстваТовараПоИдСЗаписью(СтруктураНастроек, ЭлМассива.ИдОбъекта);		
		Если ИнформацияОбъекта <> Неопределено Тогда
			Если ИнформацияОбъекта = Истина Тогда
				ОбщегоНазначения.СообщитьПользователю("Проверьте в настройках синхронизации товаров настройку """"загружать в 1С доп. поля""""!");
			Иначе				
				СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива.ИдСтроки);
				СтрокаДерева.Сущность1С = ИнформацияОбъекта;				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДеревоСлиянияПриИзменении(Элемент)
	
	БылиИзменения = Истина;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	
	Элементы.ДеревоСлияния.ТекущиеДанные.Изменена = Истина;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	
	Если Лев(ДанныеСтроки.ТипСущности, 3) <> "ЗН_" Тогда
		
		НайденныеСтроки = ТаблицаСвойств.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
			НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
		КонецЕсли;
		
	Иначе
		
		НайденныеСтроки = ТаблицаЗначенийСвойств.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
			НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСлиянияПриАктивизацииСтроки(Элемент)
	
	ВыбранноеСвойство = Неопределено;
	
	ЭлементДанных = Элементы.ДеревоСлияния.ТекущийЭлемент;
	
	Если ЭлементДанных = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдСущности) Тогда
		ЭлементДанных.ТолькоПросмотр = Истина;	
		Возврат;
	Иначе
		ЭлементДанных.ТолькоПросмотр = Ложь;	
	КонецЕсли;
	
	Если ЭлементДанных.Имя = "ДеревоСлиянияСущность1С" Тогда
		
		Если Лев(ДанныеСтроки.ТипСущности, 3) <> "ЗН_" Тогда
			
			МассивД = Новый Массив;
			МассивД.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
			ОписаниеТипов = Новый ОписаниеТипов(МассивД);
			ЭлементДанных.ОграничениеТипа = ОписаниеТипов;
			
		Иначе
			
			МассивД = Новый Массив;
			МассивД.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.ЗначенияСвойствОбъектов"));
			ОписаниеТипов = Новый ОписаниеТипов(МассивД);
			ЭлементДанных.ОграничениеТипа = ОписаниеТипов;
			
			ПредРодитель = ДанныеСтроки.ПолучитьРодителя();
			Если ПредРодитель <> Неопределено Тогда
				Родитель = ПредРодитель.ПолучитьРодителя();
				
				Если ЗначениеЗаполнено(Родитель.Сущность1С) Тогда
					ВыбранноеСвойство = Родитель.Сущность1С;
					УстановитьСвязьПараметраВыбора();
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;                     
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязьПараметраВыбора()
	НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Владелец", "ВыбранноеСвойство");
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НоваяСвязь);
	НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.ДеревоСлиянияСущность1С.СвязиПараметровВыбора = НовыеСвязи;			
КонецПроцедуры

&НаКлиенте
Процедура ВТомЧислеУжеСлившиесяПриИзменении(Элемент)
	
	НомерПоследнегоЭлемента	= 0;
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьНаСтраницеПриИзменении(Элемент)
		
	НомерПоследнегоЭлемента	= 0;
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСвойстваВ1С(Команда)
	МассивСтрок = Элементы.ДеревоСлияния.ВыделенныеСтроки;
	Если МассивСтрок.Количество() Тогда
		ЗаписатьСвойстваВ1СНаСервере(МассивСтрок);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
