
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаПодключения 					= Параметры.НастройкаПодключения;
	Портал 									= НастройкаПодключения.Портал;  
	СтруктураНастроек       				= Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если НЕ СтруктураНастроек = Неопределено Тогда
		Элементы.ЗаписатьТоварВ1С.Доступность 	= СтруктураНастроек.СинхронизацияТоваров; 
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)  
	
	Если НЕ Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) Тогда
		Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаСинхронизацииПоТарифномуПлану();
		Закрыть();	
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя("Информация",,"Скорость загрузки зависит от их количества в Битрикс24", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);   
	
	ЗагрузкаСпискаКаталогов();
	
	ПроверитьЗаполнитьКаталогиПоУмолчанию();
	
	ЗагрузкаСвойств();
	
КонецПроцедуры

#КонецОбласти


#Область ЗагрузкаСвойств 

&НаКлиенте
Процедура ЗагрузкаСвойств()
	
	ТаблицаСвойств.Очистить();
	
	ДлительнаяОперация = ВыполнитьЗагрузкуСвойствБитрикс24НаСервере();
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ФормаВладелец 		= ЭтотОбъект;
	ПараметрыОжидания.ВыводитьОкноОжидания 	= Истина;   
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииОперацииЗагрузкиСвойств", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры     
	            
&НаСервере
Функция ВыполнитьЗагрузкуСвойствБитрикс24НаСервере()
	
	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("НастройкаПодключения"				, НастройкаПодключения);
	ПередаваемыеПараметры.Вставить("ИдентификаторКаталогаТоваров"		, ИдентификаторКаталогаТоваров);
	ПередаваемыеПараметры.Вставить("ИдентификаторКаталогаПредложений"	, "999");         
		                                     
	ПередаваемыеПараметры.Вставить("ТаблицаСвойств"			, ТаблицаСвойств.Выгрузить().СкопироватьКолонки()); 
	ПередаваемыеПараметры.Вставить("ТаблицаЗначенийСвойств"	, Неопределено);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выполнение загрузки данных из Битрикс24' для слияния";
	
	Результат = ДлительныеОперации.ВыполнитьВФоне("Обработки.Б24_КС_ПомощникРучногоСлиянияДанных.ЗагрузитьСвойстваТоваровПредложенийПоФоновомуЗаданию", ПередаваемыеПараметры, ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции
 
&НаКлиенте
Процедура ПриЗавершенииОперацииЗагрузкиСвойств(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	ДанныеПортала = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

	Если ДанныеПортала = Неопределено Тогда                     
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось загрузить данные по свойствам");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Элементы.ПоискСовпадений.Доступность = Истина;
	
	Для каждого ТекСтрока Из ДанныеПортала.ТаблицаСвойств Цикл  
		Если ТекСтрока.ТипСвойства = "S" ИЛИ ТекСтрока.ТипСвойства = "N" Тогда 
			НоваяСтрока = ТаблицаСвойств.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область Прочие   

&НаСервере
Функция СписокПакетовЭлементов()
	
	Возврат Обработки.Б24_КС_ПомощникРучногоСлиянияДанных.СписокПакетовЭлементов(НастройкаПодключения, "/rest/catalog.product.list", "&select[]=id&select[]=iblockId&filter[iblockId]=" + ИдентификаторКаталогаТоваров); 

КонецФункции

&НаСервере
Процедура СохранитьСлияниеДанных()
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	ПередаваемыеДанныеНаСервер = Новый Структура();
	ПередаваемыеДанныеНаСервер.Вставить("Портал"				, Портал);
	ПередаваемыеДанныеНаСервер.Вставить("ТипыОбъектовОбмена"	, ТипыДанныхДляОбменаСПорталом);
	
	ТипДанных = ТипыДанныхДляОбменаСПорталом.Товар2;  
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал"		, Портал);
	Запрос.УстановитьПараметр("ТипДанных"	, ТипДанных);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.ТипДанных КАК ТипДанных,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ИдОбъектов
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных =&ТипДанных
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор,
	|	ТипДанных";
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаТоваров Цикл
		
		Если ТекЭлемент.Изменена Тогда
			
			Товар = ТекЭлемент.Сущность1С;
			
			Если НЕ ЗначениеЗаполнено(Товар) Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			Запрос.УстановитьПараметр("Идентификатор", ТекЭлемент.Ид);
			Запрос.УстановитьПараметр("ТипДанных"	 , ТипДанных);
			Запрос.Текст = "ВЫБРАТЬ
			|	ВТ_ИдОбъектов.Идентификатор КАК Идентификатор
			|ИЗ
			|	ВТ_ИдОбъектов КАК ВТ_ИдОбъектов
			|ГДЕ
			|	ВТ_ИдОбъектов.Идентификатор = &Идентификатор
			|	И ВТ_ИдОбъектов.ТипДанных = &ТипДанных";
			ВыполненныйЗапрос = Запрос.Выполнить();
			
			Если НЕ ВыполненныйЗапрос.Пустой() Тогда
				
				Выборка = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.Выбрать(Новый Структура("ТипДанных", ТипДанных));
				Пока Выборка.Следующий() Цикл
					Если Выборка.Идентификатор = ТекЭлемент.Ид И Выборка.Портал = Портал Тогда
						Выборка.ПолучитьМенеджерЗаписи().Удалить();	
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
			Данные = Новый Структура;
			Данные.Вставить("Объект"			, Товар);	
			Данные.Вставить("ПодчиненныйОбъект"	, ?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", Неопределено, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка()));	
			
			РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(ПередаваемыеДанныеНаСервер, ТипДанных, Данные, ТекЭлемент.Ид);  
			
		КонецЕсли;
		
	КонецЦикла;
	
	БылиИзменения = Ложь;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Ложь;
	
	НайтиСущности1СОбъектовБитрикс24();
	
КонецПроцедуры  

&НаКлиенте
Процедура РазвернутьДеревоСлиянияДанных()
	
	УзелДерева1 = ДеревоСлияния.ПолучитьЭлементы();
	Для каждого ТекСтрока1 Из УзелДерева1 Цикл
		Элементы.ДеревоСлияния.Развернуть(ТекСтрока1.ПолучитьИдентификатор());
		
		УзелДерева2 = ТекСтрока1.ПолучитьЭлементы();
		Для каждого ТекСтрока2 Из УзелДерева2 Цикл
			
			УзелДерева3 = ТекСтрока2.ПолучитьЭлементы();
			Для каждого ТекСтрока3 Из УзелДерева3 Цикл
					
				УзелДерева4 = ТекСтрока3.ПолучитьЭлементы();
				Для каждого ТекСтрока4 Из УзелДерева4 Цикл
					
					Если ТекСтрока4.Изменена Тогда
						Элементы.ДеревоСлияния.Развернуть(ТекСтрока3.ПолучитьИдентификатор());
					КонецЕсли;
					
					УзелДерева5 = ТекСтрока4.ПолучитьЭлементы();
					Для каждого ТекСтрока5 Из УзелДерева5 Цикл
						
						Если ТекСтрока5.Изменена Тогда
							Элементы.ДеревоСлияния.Развернуть(ТекСтрока4.ПолучитьИдентификатор());
						КонецЕсли;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла; 
	КонецЦикла;
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗагрузкаСпискаКаталогов()
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка каталогов на портале.";
	
	Каталоги = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек,	"/rest/catalog.catalog.list", "id", "", "catalogs");
	Если Каталоги.Количество() > 0 Тогда

		Элементы.ИдентификаторКаталогаТоваров.СписокВыбора.Очистить();

		Для Каждого ТекЭлемент Из Каталоги Цикл
			Элементы.ИдентификаторКаталогаТоваров.СписокВыбора.Добавить(Формат(ТекЭлемент.Получить("id"), "ЧГ=0"),
				ТекЭлемент.Получить("name"));
		КонецЦикла;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнитьКаталогиПоУмолчанию() 
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторКаталогаТоваров) Тогда 
		Для каждого ТекЭлемент Из Элементы.ИдентификаторКаталогаТоваров.СписокВыбора Цикл
			Если СтрНайти(ТекЭлемент.Представление, "(предложения)") = 0 Тогда
				ИдентификаторКаталогаТоваров = ТекЭлемент.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьТовары(Команда)
	
	Если БылиИзменения Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОПовторнойЗагрузке", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "Изменения будут потеряны. Продолжить?", Режим, 0);
	Иначе
		ВыборСпискаЗагружаемыхПакетов();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПовторнойЗагрузке(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ВыборСпискаЗагружаемыхПакетов();	

КонецПроцедуры

&НаКлиенте
Процедура ВыборСпискаЗагружаемыхПакетов()
	
	СписокПакетов = СписокПакетовЭлементов();
	
	Если СписокПакетов.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Нет элементов");
		Возврат;
	КонецЕсли;    
	
	Оповещение = Новый ОписаниеОповещения("ПослеОтметкиПакетов", ЭтотОбъект);  
	
	ПараметрыДляФормы = Новый Структура;
	ПараметрыДляФормы.Вставить("Список"		, СписокПакетов);
	
	ОткрытьФорму("Обработка.Б24_КС_ПомощникРучногоСлиянияДанных.Форма.ФормаВыбораПакетов", ПараметрыДляФормы, ЭтотОбъект,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтметкиПакетов(Список, Параметры) Экспорт
	
	Если Список = Неопределено Тогда
		ПоказатьОповещениеПользователя("Пакеты не выбраны");
	Иначе       
		ВыполнениеКомандыЗагрузитьТовары(Список);
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнениеКомандыЗагрузитьТовары(ВыбранныеПакеты)
	
	ТаблицаТоваров.Очистить();
	ТаблицаЗначенийСвойств.Очистить();
	ДеревоСлияния.ПолучитьЭлементы().Очистить();      
	
	ДлительнаяОперация = ВыполнитьЗагрузкуТоваровБитрикс24НаСервере(ВыбранныеПакеты);
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ФормаВладелец 		= ЭтотОбъект;
	ПараметрыОжидания.ВыводитьОкноОжидания 	= Истина;   
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииОперацииЗагрузки", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры     
	            
&НаСервере
Функция ВыполнитьЗагрузкуТоваровБитрикс24НаСервере(ВыбранныеПакеты)
	
	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПередаваемыеПараметры.Вставить("ВыбранныеПакеты"		, ВыбранныеПакеты);
	ПередаваемыеПараметры.Вставить("ТаблицаТоваров"			, ТаблицаТоваров.Выгрузить().СкопироватьКолонки()); 
	ПередаваемыеПараметры.Вставить("ТаблицаСвойств"			, ТаблицаСвойств.Выгрузить());
	ПередаваемыеПараметры.Вставить("ТаблицаЗначенийСвойств"	, ТаблицаЗначенийСвойств.Выгрузить().СкопироватьКолонки());
	ПередаваемыеПараметры.Вставить("ИдентификаторКаталогаТоваров", ИдентификаторКаталогаТоваров);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выполнение загрузки данных из Битрикс24' для слияния";
	
	Результат = ДлительныеОперации.ВыполнитьВФоне("Обработки.Б24_КС_ПомощникРучногоСлиянияДанных.ЗагрузитьТоварыПоФоновомуЗаданию", ПередаваемыеПараметры, ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПриЗавершенииОперацииЗагрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ДанныеПортала = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

	Если ДанныеПортала = Неопределено Тогда                     
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось загрузить данные");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Элементы.ПоискСовпадений.Доступность = Истина;
  
	Для каждого ТекСтрока Из ДанныеПортала.ТаблицаТоваров Цикл
		НоваяСтрока = ТаблицаТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);	
	КонецЦикла;
	
	Для каждого ТекСтрока Из ДанныеПортала.ТаблицаЗначенийСвойств Цикл
		НоваяСтрока = ТаблицаЗначенийСвойств.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);	
	КонецЦикла;         
	
	ПоказатьОповещениеПользователя("Информация",,"Анализ сущностей 1С по ид Битрикс24", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	НайтиСущности1СОбъектовБитрикс24();
	
	ПоказатьОповещениеПользователя("Информация",,"Заполнение дерева", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДеревоЭлементов(Переход = "Вперед")
	
	ДеревоСлияния.ПолучитьЭлементы().Очистить();
	
	КорневойУзел = ДеревоСлияния.ПолучитьЭлементы();
	
	Для каждого ТекЭлемент Из ТаблицаТоваров Цикл
		
		ЕстьНеСлившиеся = Ложь;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) ИЛИ ТекЭлемент.Изменена  Тогда	
			ЕстьНеСлившиеся = Истина;	
		КонецЕсли;
		
		НовыйТовар = КорневойУзел.Добавить();
		НовыйТовар.ИдСущности 		= ТекЭлемент.Ид;
		НовыйТовар.ТипСущности     	= "Товар";
		НовыйТовар.Изменена      	= ТекЭлемент.Изменена;
		НовыйТовар.Наименование 	= ТекЭлемент.Наименование;
		НовыйТовар.Сущность1С 		= ТекЭлемент.Сущность1С;
			
		ДопИнфо = "Детальное описание: " + ТекЭлемент.ДетальноеОписание;
		ДопИнфо = ДопИнфо + Символы.ПС + "Описание анонса: " + ТекЭлемент.ОписаниеАнонса;
		ДопИнфо = ДопИнфо + Символы.ПС + "Символьный код: " + ТекЭлемент.СимвольныйКод;
		ДопИнфо = ДопИнфо + Символы.ПС + "Идентификатор: " + ТекЭлемент.Ид;
		ДопИнфо = ДопИнфо + Символы.ПС + "xmlId: " + ТекЭлемент.ВнешнийКод;
		НовыйТовар.ДопИнфСущности 	= ДопИнфо;
		
		Если НЕ (ЕстьНеСлившиеся ИЛИ ВТомЧислеУжеСлившиеся ИЛИ ТекЭлемент.Изменена) Тогда
			
			КорневойУзел.Удалить(КорневойУзел.Индекс(НовыйТовар));
			
		КонецЕсли;
			                                    
	КонецЦикла; 
	
	Элементы.ДеревоСлияния.Обновить();
	
КонецПроцедуры


&НаКлиенте
Процедура СохранитьИзменения(Команда)
	
	СохранитьСлияниеДанных();
	
	ЗаполнитьДеревоЭлементов();
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры


&НаКлиенте
Процедура ПоискСовпадений(Команда)
	
	Список = Новый СписокЗначений;
	Список.Добавить("Внешний идентификатор"	,, Ложь);
	Список.Добавить("Наименование"			,, Ложь);   
	Список.Добавить("Артикул"				,, Ложь);
	Список.Добавить("Код"					,, Ложь);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзМеню",ЭтотОбъект, Параметры);
	ПоказатьВыборИзМеню(Оповещение, Список, Элементы.ПоискСовпадений);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИзмененныеЭлементы()
	
	ЭлементыВДереве = Новый Структура;
	ЭлементыВДереве.Вставить("Товар"		, Новый Массив);
	
	ЭлементыДерева = ДеревоСлияния.ПолучитьЭлементы();
	
	ПолучитьИзмененныеЭлементыРекурсивно(ЭлементыДерева, ЭлементыВДереве);
		
	Возврат ЭлементыВДереве;	
		
КонецФункции

&НаКлиенте
Процедура ПолучитьИзмененныеЭлементыРекурсивно(ЭлементыДерева, ЭлементыВДереве)
	
	Для каждого ТекЭлемент Из ЭлементыДерева Цикл
		
		Если ТекЭлемент.ТипСущности = "Товар" Тогда
			ЭлементыВДереве.Товар.Добавить(ТекЭлемент.ИдСущности);	
		КонецЕсли;
		
		НовыеЭлементы = ТекЭлемент.ПолучитьЭлементы();
		Если НовыеЭлементы.Количество() > 0 Тогда
			ПолучитьИзмененныеЭлементыРекурсивно(НовыеЭлементы, ЭлементыВДереве);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ПоискСовпадений

&НаКлиенте
Процедура ПослеВыбораИзМеню(ВыбранныйЭлемент, Параметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОткрытогоДерева = ПолучитьИзмененныеЭлементы();
	
	Если ВыбранныйЭлемент.Значение = "Внешний идентификатор" Тогда
#Область ВнешнийИдентификатор
		Для каждого ТекЭлемент Из ТаблицаТоваров Цикл
			
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				Продолжить;	
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекЭлемент.ВнешнийКод) Тогда
				Продолжить;	
			КонецЕсли;
			
			Если ДанныеОткрытогоДерева.Товар.Найти(ТекЭлемент.Ид) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ВнешнийКод = "";   
			СтруктураИдентификаторовТовара = Б24_КС_ОбщегоНазначенияВызовСервера.ПолучитьДвеСоставныеЧастиИзСтроки(ТекЭлемент.ВнешнийКод, "#");
			
			ТипДанных 	= Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Номенклатура");
			ВнешнийКод 	= СтруктураИдентификаторовТовара.ПерваяЧасть; 
			
			Если ЗначениеЗаполнено(ВнешнийКод) Тогда  
				ТекЭлемент.Сущность1С = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(ТипДанных, ВнешнийКод); 
			КонецЕсли;  
			
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения 		= Истина;
			КонецЕсли;
			
		КонецЦикла;
#КонецОбласти
		
	ИначеЕсли ВыбранныйЭлемент.Значение = "Наименование" Тогда	 
		
		ПоискПоНаименованию(ДанныеОткрытогоДерева);   
		
	ИначеЕсли ВыбранныйЭлемент.Значение = "Артикул" ИЛИ ВыбранныйЭлемент.Значение = "Код" Тогда
		ПередаваемыеПараметры = Новый Структура("ДанныеОткрытогоДерева, Операция", ДанныеОткрытогоДерева, ВыбранныйЭлемент.Значение);
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ВыполнитьПослеВыбораСвойства", ЭтотОбъект, ПередаваемыеПараметры), ПолучитьСписокСвойств(), Элементы.ПоискСовпадений);		
	КонецЕсли;
	

	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
	Если БылиИзменения Тогда
		Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоискПоНаименованию(ДанныеОткрытогоДерева)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	СправочникСсылка.Ссылка КАК Ссылка,
	|	СправочникСсылка.Наименование КАК Наименование
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникСсылка";
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаТоваров Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Наименование) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева["Товар"].Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("Наименование", ТекЭлемент.Наименование);
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_Данные.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные
		|ГДЕ
		|	ВТ_Данные.Наименование = &Наименование";
		ВыполненныйЗапрос = Запрос.Выполнить();
		
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			Выборка = ВыполненныйЗапрос.Выбрать();  
			Выборка.Следующий();
			Сущность1С = Выборка.Ссылка;
			
			ТекЭлемент.Сущность1С = Сущность1С;  
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения 		= Истина;  
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокСвойств()

	Результат = Новый СписокЗначений;
	
	Для каждого ТекСтрока Из ТаблицаСвойств Цикл
		
		НаименованиеЭлемента = "Свойство товара: '"+ТекСтрока.Наименование+"'";
		
		Результат.Добавить(ТекСтрока.Ид, НаименованиеЭлемента);
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции


&НаКлиенте
Процедура ВыполнитьПослеВыбораСвойства(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт  
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;       
	
	ДанныеОткрытогоДерева 	= ДополнительныеПараметры.ДанныеОткрытогоДерева;	
	Операция 				= ДополнительныеПараметры.Операция;	
	
	ПоискПоСвойству(Операция, ДанныеОткрытогоДерева.Товар, ВыбранныйЭлемент.Значение);

	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
	Если БылиИзменения Тогда
		Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоискПоСвойству(ИмяПоля, ДанныеДереваСлияния, ИдСвойства) 
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	|	СправочникСсылка.Ссылка КАК Ссылка,
	|	СправочникСсылка.Артикул КАК Артикул,
	|	СправочникСсылка.Код КАК Код
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникСсылка";
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаТоваров Цикл
			
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
			
		Если ДанныеДереваСлияния.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
						
		НайденныеСтроки = ТаблицаЗначенийСвойств.НайтиСтроки(Новый Структура("ИдВладельца, ИдСвойства", ТекЭлемент.Ид, ИдСвойства));
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ЗначениеСвойства = НайденныеСтроки[0].Значение; 
			Если ЗначениеЗаполнено(ЗначениеСвойства) Тогда
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;    
				
				Запрос.УстановитьПараметр("ЗначениеСвойства", ЗначениеСвойства);
				Запрос.Текст = "ВЫБРАТЬ
				|	ВТ_Данные.Ссылка КАК Ссылка
				|ИЗ
				|	ВТ_Данные КАК ВТ_Данные
				|ГДЕ
				|	ВТ_Данные."+ИмяПоля+" = &ЗначениеСвойства";
				ВыполненныйЗапрос = Запрос.Выполнить();
					
				Если НЕ ВыполненныйЗапрос.Пустой() Тогда    
					
					Выборка = ВыполненныйЗапрос.Выбрать(); 
					Выборка.Следующий();
					Сущность1С = Выборка.Ссылка;
				
					ТекЭлемент.Сущность1С = Сущность1С; 
					Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда 
						ТекЭлемент.Изменена	= Истина;
						БылиИзменения 		= Истина;  
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ЗагрузкаДанныхСБитрикс24

&НаСервере
Функция СформироватьВременнуюТаблицуИдентификаторов(ТипДанных)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
	|	Б24_К_ИдентификаторыОбъектов.ПодчиненныйОбъект КАК ПодчиненныйОбъект
	|ПОМЕСТИТЬ ВТ_ТаблицаДанных
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанных
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор";
	Запрос.Выполнить();  	
	
	Возврат МенеджерВременныхТаблиц; 
	
КонецФункции

&НаСервере
Функция НайтиЭлементПоИд(МенеджерВременныхТаблиц, ИдЭлемента)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Идентификатор", ИдЭлемента);
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ТаблицаДанных.Объект КАК Объект,
	|	ВТ_ТаблицаДанных.ПодчиненныйОбъект КАК ПодчиненныйОбъект
	|ИЗ
	|	ВТ_ТаблицаДанных КАК ВТ_ТаблицаДанных
	|ГДЕ
	|	ВТ_ТаблицаДанных.Идентификатор = &Идентификатор";
	ВыполненныйЗапрос = Запрос.Выполнить();  	
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда  
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Выборка.Следующий();
		
		Если ЗначениеЗаполнено(Выборка.ПодчиненныйОбъект) Тогда
			Результат = Выборка.ПодчиненныйОбъект; 	
		Иначе
			Результат = Выборка.Объект; 	
		КонецЕсли;  
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НайтиСущности1СОбъектовБитрикс24()
	
	ТипыДанных = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	МенеджерВременныхТаблиц = СформироватьВременнуюТаблицуИдентификаторов(ТипыДанных.Товар2);
	Для каждого ТекЭлемент Из ТаблицаТоваров Цикл
		ТекЭлемент.Сущность1С 	= НайтиЭлементПоИд(МенеджерВременныхТаблиц, ТекЭлемент.Ид);	
		ТекЭлемент.Изменена		= Ложь;     
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьТоварВ1СНаСервере(МассивСтрок) 
ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	МассивТоваров = Новый Массив;
	МассивИД = Новый Массив;
	
	Для Каждого ЭлМассива из МассивСтрок Цикл
		СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива);
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.Сущность1С) Тогда
			ДанныеТовара = Новый Структура;
			ДанныеТовара.Вставить("ИдСтроки", ЭлМассива);
			ДанныеТовара.Вставить("ИдТовара", СтрокаДерева.ИдСущности);
			МассивТоваров.Добавить(ДанныеТовара);
			МассивИД.Добавить(СтрокаДерева.ИдСущности);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураНастроек =  Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Запрос = Новый Запрос;	
	Запрос.УстановитьПараметр("Идентификатор", МассивИД);
	Запрос.УстановитьПараметр("Портал"						, СтруктураНастроек.Портал);	
	Запрос.УстановитьПараметр("ТипДанныхТоваров"			, СтруктураНастроек.ТипыОбъектовОбмена.Товар);
	Запрос.УстановитьПараметр("ТипДанныхТоваров2"			, СтруктураНастроек.ТипыОбъектовОбмена.Товар2);
	Запрос.УстановитьПараметр("ТипДанныхПредложений"		, СтруктураНастроек.ТипыОбъектовОбмена.Предложение);
	Запрос.УстановитьПараметр("ЭтоТовар2"					, СтруктураНастроек.ВерсияТоваров = "v.2");
	
	Если ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" Тогда
		Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура) КАК Объект,
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура) КАК ПодчиненныйОбъект
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	НЕ &ЭтоТовар2
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхТоваров
	               |	И Б24_К_ИдентификаторыОбъектов.Идентификатор В(&Идентификатор)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура),
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор,
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура)
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	&ЭтоТовар2
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхТоваров2
	               |	И Б24_К_ИдентификаторыОбъектов.Идентификатор В(&Идентификатор)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура),
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор,
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура)
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	&ЭтоТовар2
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхПредложений
	               |	И Б24_К_ИдентификаторыОбъектов.Идентификатор В(&Идентификатор)";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура) КАК Объект,
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.ПодчиненныйОбъект КАК Справочник.ХарактеристикиНоменклатуры) КАК ПодчиненныйОбъект
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	НЕ &ЭтоТовар2
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхТоваров
	               |	И Б24_К_ИдентификаторыОбъектов.Идентификатор В(&Идентификатор)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура),
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор,
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.ПодчиненныйОбъект КАК Справочник.ХарактеристикиНоменклатуры)
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	&ЭтоТовар2
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхТоваров2
	               |	И Б24_К_ИдентификаторыОбъектов.Идентификатор В(&Идентификатор)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура),
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор,
	               |	ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.ПодчиненныйОбъект КАК Справочник.ХарактеристикиНоменклатуры)
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	&ЭтоТовар2
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхПредложений
	               |	И Б24_К_ИдентификаторыОбъектов.Идентификатор В(&Идентификатор)";
	КонецЕсли;
	ВыполненныйЗапрос = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ЭлМассива из МассивТоваров Цикл
		НайденаНоменклатура = ВыполненныйЗапрос.Найти(ЭлМассива.ИдТовара,"Идентификатор");	
		Если НайденаНоменклатура = Неопределено Тогда
			ИнформацияТовара = Б24_КС_ЗагрузкаСервер.СформироватьНоменклатуруХарактеристикуПоИд(СтруктураНастроек, ЭлМассива.ИдТовара); 
			Если ИнформацияТовара <> Неопределено Тогда  
				Номенклатура 	= ИнформацияТовара.Объект;				
			КонецЕсли;	
		Иначе
			Номенклатура = НайденаНоменклатура.Объект;
		КонецЕсли;
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива.ИдСтроки);
			СтрокаДерева.Сущность1С = Номенклатура;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы
	                              
&НаКлиенте
Процедура ДеревоСлиянияПриИзменении(Элемент)
	
	БылиИзменения = Истина;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	
	Элементы.ДеревоСлияния.ТекущиеДанные.Изменена = Истина;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	
	Если ДанныеСтроки.ТипСущности = "Товар" Тогда
		
		НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
			НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСлиянияПриАктивизацииСтроки(Элемент)
		      
	ЭлементДанных = Элементы.ДеревоСлияния.ТекущийЭлемент;
	
	Если ЭлементДанных = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдСущности) Тогда
		ЭлементДанных.ТолькоПросмотр = Истина;	
		Возврат;
	Иначе
		ЭлементДанных.ТолькоПросмотр = Ложь;	
	КонецЕсли;
	
	Если ЭлементДанных.Имя = "ДеревоСлиянияСущность1С" Тогда
			
		МассивД = Новый Массив;
		МассивД.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Номенклатура"));
		ОписаниеТипов = Новый ОписаниеТипов(МассивД);
		
		ЭлементДанных.ОграничениеТипа = ОписаниеТипов;
		
	КонецЕсли;                     
	
КонецПроцедуры

&НаКлиенте
Процедура ВТомЧислеУжеСлившиесяПриИзменении(Элемент)
	
	ЗаполнитьДеревоЭлементов();

	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторКаталогаТоваровПриИзменении(Элемент)  
	
	ЗагрузкаСвойств();
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗаписатьТоварВ1С(Команда)
	МассивСтрок = Элементы.ДеревоСлияния.ВыделенныеСтроки;
	Если МассивСтрок.Количество() Тогда
		ЗаписатьТоварВ1СНаСервере(МассивСтрок);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
