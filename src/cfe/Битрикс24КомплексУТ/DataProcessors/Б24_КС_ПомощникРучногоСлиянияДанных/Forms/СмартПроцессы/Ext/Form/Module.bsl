
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаПодключения 	= Параметры.НастройкаПодключения;
	Портал 					= НастройкаПодключения.Портал;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)   
	
	Если НЕ Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) Тогда
		Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаСинхронизацииПоТарифномуПлану();
		Закрыть();	
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура();   
	ПараметрыОтбора.Вставить("НастройкаПодключения"	, НастройкаПодключения);
		
	ОткрытьФорму("Обработка.Б24_КС_ПомощникРучногоСлиянияДанных.Форма.СмартПроцессыСопоставлениеСущностей", ПараметрыОтбора,, Новый УникальныйИдентификатор,,, Новый ОписаниеОповещения("ВыполнитьПослеСопоставленияСущностейСП", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеСопоставленияСущностейСП(Результат, ДополнительныеПараметры) Экспорт
	
	ОтветФормы = Результат;
	
	Если ОтветФормы <> Неопределено Тогда
		
		СмартПроцесс 	= ОтветФормы.СмартПроцесс;
		ТипСущности1С 	= ОтветФормы.ТипСущности1С;
		Сущность1С 		= ОтветФормы.Сущность1С;
		
		Элементы.ДеревоСлиянияСущность1С.ОграничениеТипа = Новый ОписаниеТипов(ТипСущности1С + "Ссылка." + Сущность1С); 
		
		ВыборСпискаЗагружаемыхПакетов();
		
	КонецЕсли;  
	
КонецПроцедуры

#КонецОбласти


#Область Прочие 

&НаСервере
Процедура СохранитьСлияниеДанных()

	Если НЕ ЗначениеЗаполнено(СмартПроцесс) Тогда Возврат КонецЕсли;

	мДанные = СтрРазделить(СмартПроцесс, "#");    
	Если мДанные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипВладельцаСмартПроцесса 	= мДанные[0]; 
	ИдСмартПроцесса 			= мДанные[1]; 
	
	СтруктураНастроек = Новый Структура();
	СтруктураНастроек.Вставить("Портал", Портал);
		
	мТаблицы = Новый Массив;
	мТаблицы.Добавить(ТаблицаСП);
	
	Для каждого ТекТаблица Из мТаблицы Цикл
		
		Для каждого ТекЭлемент Из ТекТаблица Цикл
		
			Если ТекЭлемент.Изменена Тогда
				
				Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					Продолжить;
				КонецЕсли;
				
				СтруктураДляЗаписиИдентификатора = РегистрыСведений.Б24_СМ_ИдентификаторыОбъектов.ПолучитьСтруктуруДляЗаписиИдентификатора();
				СтруктураДляЗаписиИдентификатора.ТипВладельцаСмартПроцесса 	= ТипВладельцаСмартПроцесса;
				СтруктураДляЗаписиИдентификатора.ИдСмартПроцесса 			= ИдСмартПроцесса;
				СтруктураДляЗаписиИдентификатора.ТипСущности1С 				= ТипСущности1С;
				СтруктураДляЗаписиИдентификатора.Сущность1С 				= Сущность1С;
				СтруктураДляЗаписиИдентификатора.Объект 					= ТекЭлемент.Сущность1С;
				СтруктураДляЗаписиИдентификатора.Идентификатор 				= ТекЭлемент.Ид;
				
				РегистрыСведений.Б24_СМ_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураДляЗаписиИдентификатора); 
				
			КонецЕсли;
				
		КонецЦикла;
	КонецЦикла;
	
	БылиИзменения = Ложь;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Ложь;
	
	НайтиСущности1СОбъектовБитрикс24();
	
КонецПроцедуры  

&НаКлиенте
Процедура РазвернутьДеревоСлиянияДанных()
	
	УзелДерева1 = ДеревоСлияния.ПолучитьЭлементы();
	Для каждого ТекСтрока1 Из УзелДерева1 Цикл
		Элементы.ДеревоСлияния.Развернуть(ТекСтрока1.ПолучитьИдентификатор());
		
		УзелДерева2 = ТекСтрока1.ПолучитьЭлементы();
		Для каждого ТекСтрока2 Из УзелДерева2 Цикл
			
			УзелДерева3 = ТекСтрока2.ПолучитьЭлементы();
			Для каждого ТекСтрока3 Из УзелДерева3 Цикл
					
				УзелДерева4 = ТекСтрока3.ПолучитьЭлементы();
				Для каждого ТекСтрока4 Из УзелДерева4 Цикл
					
					Если ТекСтрока4.Изменена Тогда
						Элементы.ДеревоСлияния.Развернуть(ТекСтрока3.ПолучитьИдентификатор());
					КонецЕсли;
					
					УзелДерева5 = ТекСтрока4.ПолучитьЭлементы();
					Для каждого ТекСтрока5 Из УзелДерева5 Цикл
						
						Если ТекСтрока5.Изменена Тогда
							Элементы.ДеревоСлияния.Развернуть(ТекСтрока4.ПолучитьИдентификатор());
						КонецЕсли;
						
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла; 
	КонецЦикла;
	
КонецПроцедуры  

&НаСервере
Функция СписокПакетовЭлементов()
	
	мДанные = СтрРазделить(СмартПроцесс, "#");    
	Если мДанные.Количество() = 0 Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	ТипВладельцаСП = мДанные[0]; 
	
	Возврат Обработки.Б24_КС_ПомощникРучногоСлиянияДанных.СписокПакетовЭлементов(НастройкаПодключения, "/rest/crm.item.list", "&entityTypeId="+ТипВладельцаСП+"&select[]=ID"); 

КонецФункции

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ЗагрузитьЭлементы(Команда)

	Если НЕ ЗначениеЗаполнено(СмартПроцесс) Тогда
		ПоказатьПредупреждение(,"Не выбран смарт-процесс");
		Возврат;
	КонецЕсли;
	
	Если БылиИзменения Тогда           
		
		Обещание = ВопросАсинх("Изменения будут потеряны. Продолжить?", РежимДиалогаВопрос.ДаНет, 0);
		
		Результат = Ждать обещание;
		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;   
		
	КонецЕсли;

	ВыборСпискаЗагружаемыхПакетов();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОПовторнойЗагрузке(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;

	ВыборСпискаЗагружаемыхПакетов();	

КонецПроцедуры

&НаКлиенте
Процедура ВыборСпискаЗагружаемыхПакетов()
	
	СписокПакетов = СписокПакетовЭлементов();
	
	Если СписокПакетов.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Нет элементов");
		Возврат;
	КонецЕсли;    
	
	Оповещение = Новый ОписаниеОповещения("ПослеОтметкиПакетов", ЭтотОбъект);  
	
	ПараметрыДляФормы = Новый Структура;
	ПараметрыДляФормы.Вставить("Список"		, СписокПакетов);
	
	ОткрытьФорму("Обработка.Б24_КС_ПомощникРучногоСлиянияДанных.Форма.ФормаВыбораПакетов", ПараметрыДляФормы, ЭтотОбъект,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтметкиПакетов(Список, Параметры) Экспорт
	
	Если Список = Неопределено Тогда
		ПоказатьОповещениеПользователя("Пакеты не выбраны");
	Иначе       
		ВыполнениеКомандыЗагрузитьЭлементы(Список);
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнениеКомандыЗагрузитьЭлементы(ВыбранныеПакеты)
	
	ТаблицаСП.Очистить();
	ДеревоСлияния.ПолучитьЭлементы().Очистить();      
	
	ДлительнаяОперация = ВыполнитьЗагрузкуСПБитрикс24НаСервере(ВыбранныеПакеты);
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ФормаВладелец 		= ЭтотОбъект;
	ПараметрыОжидания.ВыводитьОкноОжидания 	= Истина;   
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗавершенииОперацииЗагрузки", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОписаниеОповещения, ПараметрыОжидания);

КонецПроцедуры     
	            
&НаСервере
Функция ВыполнитьЗагрузкуСПБитрикс24НаСервере(ВыбранныеПакеты)
	
	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПередаваемыеПараметры.Вставить("ТаблицаСП"				, ТаблицаСП.Выгрузить().СкопироватьКолонки()); 
	ПередаваемыеПараметры.Вставить("СмартПроцесс"			, СмартПроцесс); 
	ПередаваемыеПараметры.Вставить("ВыбранныеПакеты"		, ВыбранныеПакеты); 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выполнение загрузки данных из Битрикс24' для слияния";
	
	Результат = ДлительныеОперации.ВыполнитьВФоне("Обработки.Б24_КС_ПомощникРучногоСлиянияДанных.ЗагрузитьСППоФоновомуЗаданию", ПередаваемыеПараметры, ПараметрыВыполнения);
	
	Возврат Результат;
	
КонецФункции

 
&НаКлиенте
Процедура ПриЗавершенииОперацииЗагрузки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;       
	
	ДанныеПортала = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

	Если ДанныеПортала = Неопределено Тогда                     
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось загрузить данные");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Элементы.ПоискСовпадений.Доступность = Истина;
  
	Для каждого ТекСтрока Из ДанныеПортала.ТаблицаСП Цикл
		НоваяСтрока = ТаблицаСП.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);	
	КонецЦикла;
	
	ПоказатьОповещениеПользователя("Информация",,"Анализ сущностей 1С по ид Битрикс24", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	НайтиСущности1СОбъектовБитрикс24();
	
	ПоказатьОповещениеПользователя("Информация",,"Заполнение дерева", БиблиотекаКартинок.Б24_К_ЗначокБитрикс);
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьДеревоЭлементов(Переход = "Вперед")

	ДеревоСлияния.ПолучитьЭлементы().Очистить();
	
	КорневойУзел = ДеревоСлияния.ПолучитьЭлементы();
	
#Область ЗаполнениеДереваСП
	Для каждого ТекЭлемент Из ТаблицаСП Цикл
		
		ЕстьНеСлившиеся = Ложь;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) ИЛИ ТекЭлемент.Изменена  Тогда	
			ЕстьНеСлившиеся = Истина;	
		КонецЕсли;
		
		НовыйСП = КорневойУзел.Добавить();
		НовыйСП.ИдСущности 		= ТекЭлемент.Ид;
		НовыйСП.Изменена     	= ТекЭлемент.Изменена;
		НовыйСП.Наименование 	= ТекЭлемент.Наименование;
		НовыйСП.Сущность1С 		= ТекЭлемент.Сущность1С;
			
		ДопИнфо = "Идентификатор: " + ТекЭлемент.Ид;
		НовыйСП.ДопИнфСущности = ДопИнфо;
		
		Если НЕ (ЕстьНеСлившиеся ИЛИ ВТомЧислеУжеСлившиеся ИЛИ ТекЭлемент.Изменена) Тогда
			
			КорневойУзел.Удалить(КорневойУзел.Индекс(НовыйСП));
			
		КонецЕсли;
			                                    
	КонецЦикла;
		
#КонецОбласти	
	
	Элементы.ДеревоСлияния.Обновить();
	
КонецПроцедуры


&НаКлиенте
Процедура СохранитьИзменения(Команда)
	
	СохранитьСлияниеДанных();
	
	ЗаполнитьДеревоЭлементов();
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры


&НаКлиенте
Асинх Процедура ПоискСовпадений(Команда)
	
	Список = Новый СписокЗначений;
	Список.Добавить("Внешний идентификатор"	,, Ложь);
	Список.Добавить("Наименование"			,, Ложь);
	
	ДозаполнитьСписокАлгоритмовСопоставления(Список);
	
	Обещание = ВыбратьИзМенюАсинх(Список, Элементы.ПоискСовпадений); 
	
	ВыбранныйЭлемент = Ждать обещание;
		
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОткрытогоДерева = ПолучитьИзмененныеЭлементы();
	
	Если ВыбранныйЭлемент.Значение = "Внешний идентификатор" Тогда
		ПоискПоВнешнемуИдентификатору(ДанныеОткрытогоДерева);		
	ИначеЕсли ВыбранныйЭлемент.Значение = "Наименование" Тогда	
		ПоискПоНаименованию(ДанныеОткрытогоДерева);      
	ИначеЕсли ТипЗнч(ВыбранныйЭлемент.Значение) = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения") Тогда
		
		СпкСвойств = СвойстваСПДляСопоставления();
		
		Если СпкСвойств.Количество() = 0 Тогда
			ПоказатьОповещениеПользователя("Нет подходящих пользовательских полей",, "Поддерживаются пользовательские поля типа строка и число");
			Возврат;
		КонецЕсли;
		
		обещание = СпкСвойств.ВыбратьЭлементАсинх("Выберите пользовательское поле смарт-процесса");
		
		ВыбранноеПП = Ждать обещание;
			
		Если ВыбранноеПП = Неопределено Тогда
			Возврат;
		КонецЕсли;
	
		ПоискПоПользовательскомуПолю(ДанныеОткрытогоДерева, ВыбранныйЭлемент.Значение, ВыбранноеПП.Значение); 
		
		вв=4;
	КонецЕсли;
	
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
	Если БылиИзменения Тогда
		Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СопоставитьСущности(Команда)
	
	Если ДеревоСлияния.ПолучитьЭлементы().Количество() > 0 Тогда
	
		Обещание = ВопросАсинх("Изменения будут потеряны. Продолжить?", РежимДиалогаВопрос.ДаНет, 0);
		
		Результат = Ждать обещание;
		
		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;   
		
	КонецЕсли;   
	
	ТаблицаСП.Очистить();
	ДеревоСлияния.ПолучитьЭлементы().Очистить();      
	
	ПараметрыОтбора = Новый Структура();   
	ПараметрыОтбора.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПараметрыОтбора.Вставить("СмартПроцесс"			, СмартПроцесс);
	ПараметрыОтбора.Вставить("ТипСущности1С"		, ТипСущности1С);
	ПараметрыОтбора.Вставить("Сущность1С"			, Сущность1С);
	
	ОткрытьФорму("Обработка.Б24_КС_ПомощникРучногоСлиянияДанных.Форма.СмартПроцессыСопоставлениеСущностей", ПараметрыОтбора,, Новый УникальныйИдентификатор,,, Новый ОписаниеОповещения("ВыполнитьПослеСопоставленияСущностейСП", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры   

#КонецОбласти


#Область ПоискСовпадений

&НаСервере
Процедура ДозаполнитьСписокАлгоритмовСопоставления(СписокАлгоритмов)
	
	НаборСвойств = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств(ТипСущности1С + "_" + Сущность1С); 
	Если ЗначениеЗаполнено(НаборСвойств) Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НаборСвойств, "ДополнительныеРеквизиты, ДополнительныеСведения");  
		
		Выборка = ЗначенияРеквизитов.ДополнительныеРеквизиты.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(Выборка.Свойство) Тогда Продолжить КонецЕсли;
			
			РеквизитыСвойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выборка.Свойство, "Ссылка, Заголовок, ТипЗначения");
			
			Если РеквизитыСвойства.ТипЗначения.СодержитТип(Тип("Строка")) ИЛИ РеквизитыСвойства.ТипЗначения.СодержитТип(Тип("Число")) Тогда
				СписокАлгоритмов.Добавить(РеквизитыСвойства.Ссылка, "(Доп. рек.) " + РеквизитыСвойства.Заголовок, Ложь);   
			КонецЕсли;
			
		КонецЦикла;
		
		Выборка = ЗначенияРеквизитов.ДополнительныеСведения.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(Выборка.Свойство) Тогда Продолжить КонецЕсли;
			
			РеквизитыСвойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выборка.Свойство, "Ссылка, Заголовок, ТипЗначения");
			
			Если РеквизитыСвойства.ТипЗначения.СодержитТип(Тип("Строка")) ИЛИ РеквизитыСвойства.ТипЗначения.СодержитТип(Тип("Число")) Тогда
				СписокАлгоритмов.Добавить(РеквизитыСвойства.Ссылка, "(Доп. свед.) " + РеквизитыСвойства.Заголовок, Ложь);
			КонецЕсли;  
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИзмененныеЭлементы()
	
	ЭлементыВДереве = Новый Структура;
	ЭлементыВДереве.Вставить("Элементы", Новый Массив);
	
	ЭлементыДерева = ДеревоСлияния.ПолучитьЭлементы();
	
	Для каждого ТекЭлемент Из ЭлементыДерева Цикл
		ЭлементыВДереве.Элементы.Добавить(ТекЭлемент.ИдСущности);	
	КонецЦикла;	
		
	Возврат ЭлементыВДереве;	
		
КонецФункции

&НаСервере
Процедура ПоискПоВнешнемуИдентификатору(ДанныеОткрытогоДерева)
	
	ТипОбъекта = РегистрыСведений.Б24_СМ_ИдентификаторыОбъектов.ТипОбъектаПоТипуСущностиСП(ТипСущности1С, Сущность1С);
	
	мТаблицы = Новый Массив;
	мТаблицы.Добавить(ТаблицаСП);
	
	Для каждого ТекТаблица Из мТаблицы Цикл
		Для каждого ТекЭлемент Из ТекТаблица Цикл
			
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				Продолжить;	
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекЭлемент.ВнешнийКод) Тогда
				Продолжить;	
			КонецЕсли;
			
			Если ТекТаблица = ТаблицаСП Тогда
				Если ДанныеОткрытогоДерева.Элементы.Найти(ТекЭлемент.Ид) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ТекЭлемент.Сущность1С = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(ТипОбъекта, ТекЭлемент.ВнешнийКод); 
			
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПоискПоНаименованию(ДанныеОткрытогоДерева)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	
	Если ТипСущности1С = "Справочник" Тогда      
		Запрос.Текст = "ВЫБРАТЬ
		|	Данные1С.Ссылка КАК Ссылка,
		|	Данные1С.Наименование КАК Наименование
		|ИЗ
		|	Справочник."+Сущность1С+" КАК Данные1С";
		тзнДанных = Запрос.Выполнить().Выгрузить();
	ИначеЕсли ТипСущности1С = "Документ" Тогда  
		Запрос.Текст = "ВЫБРАТЬ
		|	Данные1С.Ссылка КАК Ссылка,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Данные1С.Ссылка) КАК Наименование
		|ИЗ
		|	Документ."+Сущность1С+" КАК Данные1С";
		тзнДанных = Запрос.Выполнить().Выгрузить();
	Иначе  
		Возврат;
	КонецЕсли;
	
	тзнДанных.Индексы.Добавить("Наименование");
	
	Для каждого ТекЭлемент Из ТаблицаСП Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Наименование) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Элементы.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НайденноеЗначение = тзнДанных.Найти(ТекЭлемент.Наименование, "Наименование");
		Если НайденноеЗначение <> Неопределено Тогда
			
			ТекЭлемент.Сущность1С = НайденноеЗначение.Ссылка; 
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СвойстваСПДляСопоставления()

	Результат = Новый СписокЗначений;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	
	мДанные = СтрРазделить(СмартПроцесс, "#");    
	Если мДанные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыЗапроса = "&start=-1&&moduleId=crm&filter[entityId]=CRM_" + мДанные[0] + "&filter[userTypeId][1]=double&filter[userTypeId][2]=string";
	
	ДанныеПортала = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/userfieldconfig.list", ПараметрыЗапроса); 
	Если ДанныеПортала = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	мЗапросы = Новый Массив;
	МассивПользовательскихПолей = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/userfieldconfig.list", "id", ПараметрыЗапроса, "fields"); 
	Для каждого ТекЭлемент Из МассивПользовательскихПолей Цикл
		
		ИдЭлемента =  Формат(ТекЭлемент.Получить("id"), "ЧГ=0");
		
		мЗапросы.Добавить("cmd["+ИдЭлемента+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("userfieldconfig.get?moduleId=crm&id="+ИдЭлемента));
		
	КонецЦикла;
	
	МассивДанныхПользовательскихПолей = Б24_К_RestApiВызовСервера.ОбработатьМассивЗапросовБатч(СтруктураНастроек, мЗапросы);
	Для каждого ТекЭлемент Из МассивДанныхПользовательскихПолей Цикл
		
		ДанныеПоля = ТекЭлемент.Значение.Получить("field");  
		
		КлючПоля = ДанныеПоля.Получить("fieldName");
		
		НаименованиеПоля = "";
		ОписаниеКлюча = ДанныеПоля.Получить("editFormLabel");
		Если ОписаниеКлюча <> Неопределено Тогда
			НаименованиеПоля = ОписаниеКлюча.Получить(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЛокализациюБитрикс24());
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлючПоля) И ЗначениеЗаполнено(НаименованиеПоля) Тогда
			Результат.Добавить(КлючПоля, НаименованиеПоля);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПоискПоПользовательскомуПолю(ДанныеОткрытогоДерева, ДопРеквизитСвойство, КлючПП)

	РеквизитыСвойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДопРеквизитСвойство, "ЭтоДополнительноеСведение, ТипЗначения");
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Свойство", ДопРеквизитСвойство);
	
	Если РеквизитыСвойства.ЭтоДополнительноеСведение Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	ДополнительныеСведения.Объект КАК Объект,
		|	ДополнительныеСведения.Значение КАК Значение
		|ПОМЕСТИТЬ ВТ_ЗначенияСвойств
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Свойство = &Свойство           
		|	И ТИПЗНАЧЕНИЯ(ДополнительныеСведения.Объект) = ТИП("+ТипСущности1С+"."+Сущность1С+")";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|	ДополнительныеРеквизитыОбъекта.Ссылка КАК Объект,
		|	ДополнительныеРеквизитыОбъекта.Значение КАК Значение  
		|ПОМЕСТИТЬ ВТ_ЗначенияСвойств
		|ИЗ
		|	"+ТипСущности1С+"."+Сущность1С+".ДополнительныеРеквизиты КАК ДополнительныеРеквизитыОбъекта
		|ГДЕ
		|	ДополнительныеРеквизитыОбъекта.Свойство = &Свойство   
		|	И ТИПЗНАЧЕНИЯ(ДополнительныеРеквизитыОбъекта.Ссылка) = ТИП("+ТипСущности1С+"."+Сущность1С+")";
	КонецЕсли;
	
	Запрос.Выполнить();
	
	мТаблицы = Новый Массив;
	мТаблицы.Добавить(ТаблицаСП);
	
	Для каждого ТекТаблица Из мТаблицы Цикл
		Для каждого ТекЭлемент Из ТекТаблица Цикл
			
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				Продолжить;	
			КонецЕсли;
			
			Если ТекТаблица = ТаблицаСП Тогда
				Если ДанныеОткрытогоДерева.Элементы.Найти(ТекЭлемент.Ид) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Попытка
				
				Если НЕ ЗначениеЗаполнено(ТекЭлемент.ДанныеЭлемента) Тогда Продолжить КонецЕсли;       
				
				ДанныеЭлемента = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(ТекЭлемент.ДанныеЭлемента, Истина);
				
				КлючПП = СтрЗаменить(КлючПП, "UF_CRM_", "ufCrm"); //баги..
				Если РеквизитыСвойства.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
					ЗначениеПП = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ДанныеЭлемента.Получить(КлючПП)); 
				ИначеЕсли РеквизитыСвойства.ТипЗначения.СодержитТип(Тип("Число")) Тогда
					ЗначениеПП = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"), ДанныеЭлемента.Получить(КлючПП)); 
				Иначе
					Продолжить;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ЗначениеПП) Тогда Продолжить КонецЕсли;	
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				Запрос.УстановитьПараметр("Значение", ЗначениеПП);
				Запрос.Текст = "ВЫБРАТЬ
				|	ВТ_ЗначенияСвойств.Объект КАК Объект
				|ИЗ
				|	ВТ_ЗначенияСвойств КАК ВТ_ЗначенияСвойств
				|ГДЕ
				|	ВТ_ЗначенияСвойств.Значение = &Значение";
				ВыполненныйЗапрос = Запрос.Выполнить();
				Если НЕ ВыполненныйЗапрос.Пустой() Тогда
					Выборка = ВыполненныйЗапрос.Выбрать();
					Выборка.Следующий();
					ТекЭлемент.Сущность1С = Выборка.Объект;	
				КонецЕсли;
				
			Исключение       
				Продолжить;
			КонецПопытки;    
			
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ЗагрузкаДанныхСБитрикс24

&НаСервере
Функция СформироватьВременнуюТаблицуИдентификаторов()
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	мДанные = СтрРазделить(СмартПроцесс, "#");    
	Если мДанные.Количество() = 0 Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	ТипВладельцаСП = мДанные[0]; 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("ТипВладельцаСмартПроцесса", ТипВладельцаСП);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_СМ_ИдентификаторыОбъектов.ТипСущности1С КАК ТипСущности1С,
	|	Б24_СМ_ИдентификаторыОбъектов.Сущность1С КАК Сущность1С,
	|	Б24_СМ_ИдентификаторыОбъектов.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
	|	Б24_СМ_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ТаблицаДанных
	|ИЗ
	|	РегистрСведений.Б24_СМ_ИдентификаторыОбъектов КАК Б24_СМ_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_СМ_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_СМ_ИдентификаторыОбъектов.ТипВладельцаСмартПроцесса = &ТипВладельцаСмартПроцесса
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор";
	Запрос.Выполнить();  	
	
	Возврат МенеджерВременныхТаблиц; 
	
КонецФункции

&НаСервере
Функция НайтиЭлементПоИд(МенеджерВременныхТаблиц, ИдЭлемента)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Идентификатор", ИдЭлемента);
	Запрос.Текст = "ВЫБРАТЬ         
	|	ВТ_ТаблицаДанных.ТипСущности1С КАК ТипСущности1С,
	|	ВТ_ТаблицаДанных.Сущность1С КАК Сущность1С,
	|	ВТ_ТаблицаДанных.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
	|	ВТ_ТаблицаДанных.Идентификатор КАК Идентификатор
	|ИЗ
	|	ВТ_ТаблицаДанных КАК ВТ_ТаблицаДанных
	|ГДЕ
	|	ВТ_ТаблицаДанных.Идентификатор = &Идентификатор";
	ВыполненныйЗапрос = Запрос.Выполнить();  	
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Выборка.Следующий();
		
		ТипОбъекта = РегистрыСведений.Б24_СМ_ИдентификаторыОбъектов.ТипОбъектаПоТипуСущностиСП(Выборка.ТипСущности1С, Выборка.Сущность1С);
		
		Результат = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(ТипОбъекта, Выборка.ИдентификаторОбъекта);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НайтиСущности1СОбъектовБитрикс24()
	
	МенеджерВременныхТаблиц = СформироватьВременнуюТаблицуИдентификаторов();
	Для каждого ТекЭлемент Из ТаблицаСП Цикл
		ТекЭлемент.Сущность1С 	= НайтиЭлементПоИд(МенеджерВременныхТаблиц, ТекЭлемент.Ид);	
		ТекЭлемент.Изменена		= Ложь;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСмартПроцессВ1СНаСервере(МассивСтрок)
	МассивОбъектов = Новый Массив;
	
	Для Каждого ЭлМассива из МассивСтрок Цикл
		СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива);
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.Сущность1С) Тогда
			ДанныеОбъекта = Новый Структура;
			ДанныеОбъекта.Вставить("ИдСтроки", ЭлМассива);
			ДанныеОбъекта.Вставить("ИдОбъекта", СтрокаДерева.ИдСущности);
			ДанныеОбъекта.Вставить("ТипСущности", СтрокаДерева.ТипСущности);
			МассивОбъектов.Добавить(ДанныеОбъекта);			
		КонецЕсли;
	КонецЦикла;
	
	СтруктураНастроек =  Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения); 	
		
	Для Каждого ЭлМассива из МассивОбъектов Цикл		
		СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива.ИдСтроки);
		Если Не ЗначениеЗаполнено(СтрокаДерева.Сущность1С) Тогда
			Если НЕ ЗначениеЗаполнено(СмартПроцесс) Тогда Возврат КонецЕсли;			
			мДанные = СтрРазделить(СмартПроцесс, "#");    
			Если мДанные.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;			
			ТипВладельцаСмартПроцесса 	= мДанные[0]; 
			ИдСмартПроцесса 			= мДанные[1];			
			
			МодульЗагрузкаСервер = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СМ_ЗагрузкаСервер");
			Результат = МодульЗагрузкаСервер.ПолучитьЭлементСмартПроцессаПоИдДляДругихПодсистем(СтруктураНастроек, ТипВладельцаСмартПроцесса, СтрокаДерева.ИдСущности);
			
			СтрокаДерева.Сущность1С = Результат;
		КонецЕсли;		
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДеревоСлиянияПриИзменении(Элемент)
	
	БылиИзменения = Истина;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	
	Элементы.ДеревоСлияния.ТекущиеДанные.Изменена = Истина;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	
	НайденныеСтроки = ТаблицаСП.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
		НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСлиянияПриАктивизацииСтроки(Элемент)
		      
	ЭлементДанных = Элементы.ДеревоСлияния.ТекущийЭлемент;
	
	Если ЭлементДанных = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдСущности) Тогда
		ЭлементДанных.ТолькоПросмотр = Истина;	
		Возврат;
	Иначе
		ЭлементДанных.ТолькоПросмотр = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВТомЧислеУжеСлившиесяПриИзменении(Элемент)
	
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСмартПроцессВ1С(Команда)
	МассивСтрок = Элементы.ДеревоСлияния.ВыделенныеСтроки;
	Если МассивСтрок.Количество() Тогда
		ЗаписатьСмартПроцессВ1СНаСервере(МассивСтрок);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти








