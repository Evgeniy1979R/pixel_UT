	
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
			
	НастройкаПодключения 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("РучноеСлияние","НастройкаПодключения");
	Портал 	 				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("РучноеСлияние","Портал");
	ОтображатьНаСтранице 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("РучноеСлияние","ОтображатьНаСтранице");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если НЕ ЗавершениеРаботы Тогда
		Результат = Новый Структура;
		Результат.Вставить("Портал"	 				, Портал);
		Результат.Вставить("НастройкаПодключения"	, НастройкаПодключения);
		Результат.Вставить("ОтображатьНаСтранице"	, ОтображатьНаСтранице);
		
		Б24_К_ОбщегоНазначенияВызовСервера.УстановитьЗначениеВХранилищаНастроек("РучноеСлияние", Результат)
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НастройкаПодключенияПриИзменении(Элемент)
	Портал = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(НастройкаПодключения, "Портал");
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы  

&НаКлиенте
Процедура ОткрытьФормуСлиянияДанных(ИмяФормы, ТипСущности = "")
	
	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		ПоказатьПредупреждение(, "Не указан настройка подключения");
		Возврат;
	КонецЕсли;
	
	Если НЕ Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) Тогда
		Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаСинхронизацииПоТарифномуПлану();
		Закрыть();	
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура();   
	ПараметрыОтбора.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПараметрыОтбора.Вставить("ТипСущности"			, ТипСущности);
	
	ОткрытьФорму(ИмяФормы, ПараметрыОтбора,, Новый УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.Независимый);

КонецПроцедуры

&НаКлиенте
Процедура Компании(Команда)
	
	Если НЕ НастройкаСуществует() Тогда Возврат КонецЕсли;   
	
	ОткрытьФормуСлиянияДанных("Обработка.Б24_КС_ПомощникРучногоСлиянияДанных.Форма.КонтактыКомпании", "Компании"); 
	
