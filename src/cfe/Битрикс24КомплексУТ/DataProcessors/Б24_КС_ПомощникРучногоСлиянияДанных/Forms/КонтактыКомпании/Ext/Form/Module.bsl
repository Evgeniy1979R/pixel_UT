			МассивД.Добавить(Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", "СправочникСсылка.КонтактныеЛица", "СправочникСсылка.КонтактныеЛицаПартнеров")));
