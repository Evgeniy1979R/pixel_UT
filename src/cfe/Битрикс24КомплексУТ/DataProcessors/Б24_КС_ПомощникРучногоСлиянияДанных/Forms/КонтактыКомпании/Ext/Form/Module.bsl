&НаКлиенте
Процедура ДеревоСлиянияПриИзменении(Элемент)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	БылиИзменения = Истина;
	Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	
	Элементы.ДеревоСлияния.ТекущиеДанные.Изменена = Истина;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	
	Если ДанныеСтроки.ТипСущности = "Компания" ИЛИ ДанныеСтроки.ТипСущности = "Организация" Тогда
		
		НайденныеСтроки = ТаблицаКомпаний.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
			НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
		КонецЕсли;
		
	ИначеЕсли ДанныеСтроки.ТипСущности = "Реквизит организации" ИЛИ ДанныеСтроки.ТипСущности = "Реквизит компании" ИЛИ ДанныеСтроки.ТипСущности = "Реквизит контакта" Тогда
		
		НайденныеСтроки = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
			НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
		КонецЕсли;
		
	ИначеЕсли ДанныеСтроки.ТипСущности = "Счет" Тогда
		
		НайденныеСтроки = ТаблицаСчетов.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
			НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
		КонецЕсли;
		
	ИначеЕсли ДанныеСтроки.ТипСущности = "Контакт" ИЛИ ДанныеСтроки.ТипСущности = "Контакт компании" Тогда
		
		НайденныеСтроки = ТаблицаКонтактов.НайтиСтроки(Новый Структура("Ид", ДанныеСтроки.ИдСущности));	
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Изменена 	= ?(НайденныеСтроки[0].Сущность1С = ДанныеСтроки.Сущность1С, НайденныеСтроки[0].Изменена, Истина); 	
			НайденныеСтроки[0].Сущность1С 	= ДанныеСтроки.Сущность1С; 	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСлиянияПриАктивизацииСтроки(Элемент)
		      
			ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ЭлементДанных = Элементы.ДеревоСлияния.ТекущийЭлемент;
	
	Если ЭлементДанных = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ДанныеСтроки = Элементы.ДеревоСлияния.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ИдСущности) Тогда
		ЭлементДанных.ТолькоПросмотр = Истина;	
		Возврат;
	Иначе
		ЭлементДанных.ТолькоПросмотр = Ложь;	
	КонецЕсли;
	
	Если ЭлементДанных.Имя = "ДеревоСлиянияСущность1С" Тогда
		
		Если ДанныеСтроки.ТипСущности = "Счет" Тогда
			
			МассивД = Новый Массив;
			МассивД.Добавить(Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", "СправочникСсылка.БанковскиеСчета", "СправочникСсылка.БанковскиеСчетаКонтрагентов")));
			МассивД.Добавить(Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", "СправочникСсылка.БанковскиеСчета", "СправочникСсылка.БанковскиеСчетаОрганизаций")));
			ОписаниеТипов = Новый ОписаниеТипов(МассивД);
			
			ЭлементДанных.ОграничениеТипа = ОписаниеТипов;	
			
		ИначеЕсли ДанныеСтроки.ТипСущности = "Организация" ИЛИ ДанныеСтроки.ТипСущности = "Реквизит организации" Тогда
			
			МассивД = Новый Массив;
			МассивД.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Организации"));
			ОписаниеТипов = Новый ОписаниеТипов(МассивД);
			
			ЭлементДанных.ОграничениеТипа = ОписаниеТипов;
			
