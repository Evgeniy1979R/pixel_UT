&НаСервере
Процедура ОбновлениеРеквизитаПоИд(ИдЭлемента, Сущность1С)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	НайденныеСтроки = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("Ид", ИдЭлемента));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Если ЗначениеЗаполнено(НайденнаяСтрока.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		НайденнаяСтрока.Сущность1С 	= Сущность1С; 
		Если ЗначениеЗаполнено(НайденнаяСтрока.Сущность1С) Тогда
			НайденнаяСтрока.Изменена = Истина;
			БылиИзменения = Истина;
			
			Если НайденнаяСтрока.ТипВладельца = "4" Тогда
				ОбновлениеКомпанииПоИд(НайденнаяСтрока.ИдВладельца, Сущность1С, Ложь);	
			Иначе
				ОбновлениеКонтактаПоИд(НайденнаяСтрока.ИдВладельца, Сущность1С, Ложь);	
