&НаСервере
Процедура ОбновлениеРеквизитаПоВладельцу(ТипВладельца, ИдВладельца, Сущность1С)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Реквизит = Неопределено;	
	
	ТипСущности = ТипЗнч(Сущность1С);   	
	Если ТипСущности = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Организации") Тогда
		Реквизит = Сущность1С;
	ИначеЕсли ТипСущности = Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", "СправочникСсылка.Контрагенты", "СправочникСсылка.Партнеры")) Тогда
		
		Выборка = Справочники.Контрагенты.Выбрать(,,Новый Структура("Партнер",Сущность1С));
		КоличествоРеквизитов = 0;
		Пока Выборка.Следующий() Цикл
			КоличествоРеквизитов = КоличествоРеквизитов + 1;
			Реквизит = Выборка.Ссылка; 
		КонецЦикла;
		
		Если КоличествоРеквизитов > 1 Тогда Возврат КонецЕсли;	
		
	Иначе
		Возврат;	
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаРеквизитов.НайтиСтроки(Новый Структура("ТипВладельца, ИдВладельца", ТипВладельца, ИдВладельца));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Если ЗначениеЗаполнено(НайденнаяСтрока.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		НайденнаяСтрока.Сущность1С 	= Реквизит; 
		Если ЗначениеЗаполнено(Реквизит) Тогда
			НайденнаяСтрока.Изменена = Истина;
			БылиИзменения = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ЗагрузкаДанныхСБитрикс24

&НаСервере
Функция СформироватьВременнуюТаблицуИдентификаторов(ТипДанных)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ТаблицаДанных
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанных
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор";
	Запрос.Выполнить();  	
	
	Возврат МенеджерВременныхТаблиц; 
	
КонецФункции

&НаСервере
Функция НайтиЭлементПоИд(МенеджерВременныхТаблиц, ИдЭлемента)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Идентификатор", ИдЭлемента);
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_ТаблицаДанных.Объект КАК Объект
	|ИЗ
	|	ВТ_ТаблицаДанных КАК ВТ_ТаблицаДанных
	|ГДЕ
	|	ВТ_ТаблицаДанных.Идентификатор = &Идентификатор";
	ВыполненныйЗапрос = Запрос.Выполнить();  	
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		тзнВрем = ВыполненныйЗапрос.Выгрузить();
		Результат = тзнВрем[0].Объект;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НайтиСущности1СОбъектовБитрикс24()
	
	ТипыДанных = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();

	мДанных = Новый Массив;
	мДанных.Добавить(Новый Структура("ТаблицаДанных, ТипДанных", ТаблицаКомпаний	, ТипыДанных.Компания));
	мДанных.Добавить(Новый Структура("ТаблицаДанных, ТипДанных", ТаблицаКонтактов	, ТипыДанных.Контакт));
	мДанных.Добавить(Новый Структура("ТаблицаДанных, ТипДанных", ТаблицаРеквизитов	, ТипыДанных.Реквизит));
	мДанных.Добавить(Новый Структура("ТаблицаДанных, ТипДанных", ТаблицаСчетов		, ТипыДанных.БанковскийСчетРеквизита));
	
	Для каждого ТекЭлемент Из мДанных Цикл
		
		МенеджерВременныхТаблиц = СформироватьВременнуюТаблицуИдентификаторов(ТекЭлемент.ТипДанных);
		Для каждого ТекСтрока Из ТекЭлемент.ТаблицаДанных Цикл  
			
			ИдПоиска = ТекСтрока.Ид;
			Если ТекЭлемент.ТипДанных = ТипыДанных.Контакт И ЗначениеЗаполнено(ТекСтрока.ИдКомпании) Тогда ИдПоиска = "#"+ТекСтрока.Ид КонецЕсли;
			
			ТекСтрока.Сущность1С 	= НайтиЭлементПоИд(МенеджерВременныхТаблиц, ИдПоиска);	
			ТекСтрока.Изменена		= Ложь; 
			
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКомпанииКонтактыВ1СНаСервере(МассивСтрок)
	МассивОбъектов = Новый Массив;
	
	Для Каждого ЭлМассива из МассивСтрок Цикл
		СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива);
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.Сущность1С) Тогда
			ДанныеОбъекта = Новый Структура;
			ДанныеОбъекта.Вставить("ИдСтроки", ЭлМассива);
			ДанныеОбъекта.Вставить("ИдОбъекта", СтрокаДерева.ИдСущности);
			МассивОбъектов.Добавить(ДанныеОбъекта);			
		КонецЕсли;
	КонецЦикла;
	
	СтруктураНастроек =  Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения); 	
	
	Если ТипСущности = "Компании" Тогда
		ТипВладельца = "Компания"
	Иначе ТипВладельца = "Контакт";
	КонецЕсли;
	
	Для Каждого ЭлМассива из МассивОбъектов Цикл		
		СтрокаДерева = ДеревоСлияния.НайтиПоИдентификатору(ЭлМассива.ИдСтроки);
		Если Не ЗначениеЗаполнено(СтрокаДерева.Сущность1С) Тогда
			ИнформацияОбъекта = Б24_КС_ЗагрузкаСервер.СформироватьКомпаниюКонтактПоИд(СтруктураНастроек, ТипВладельца,ЭлМассива.ИдОбъекта);
			СтрокаДерева.Сущность1С = ИнформацияОбъекта;
		КонецЕсли;		
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти


