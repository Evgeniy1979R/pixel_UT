&НаКлиенте
Процедура ПоискСовпадений(Команда)
	
	Список = Новый СписокЗначений;
	Список.Добавить("Внешний идентификатор"	,, Ложь);
	Список.Добавить("Телефон"				,, Ложь);
	Список.Добавить("Email"					,, Ложь);
	Список.Добавить("ИНН+КПП"				,, Ложь);
	Список.Добавить("ФИО"					,, Ложь);
	Список.Добавить("Номер счета"			,, Ложь);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзМеню",ЭтотОбъект, Параметры);
	ПоказатьВыборИзМеню(Оповещение, Список, Элементы.ПоискСовпадений);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИзмененныеЭлементы()
	
	ЭлементыВДереве = Новый Структура;
	ЭлементыВДереве.Вставить("Компания"	, Новый Массив);
	ЭлементыВДереве.Вставить("Контакт"	, Новый Массив);
	ЭлементыВДереве.Вставить("Реквизит"	, Новый Массив);
	ЭлементыВДереве.Вставить("БанкСчет"	, Новый Массив);
	
	ЭлементыДерева = ДеревоСлияния.ПолучитьЭлементы();
	
	Для каждого ТекЭлемент Из ЭлементыДерева Цикл
		ПолучитьИзмененныеЭлементыРекурсивно(ТекЭлемент.ПолучитьЭлементы(), ЭлементыВДереве);
	КонецЦикла;	
		
	Возврат ЭлементыВДереве;	
		
КонецФункции

&НаКлиенте
Процедура ПолучитьИзмененныеЭлементыРекурсивно(ЭлементыДерева, ЭлементыВДереве)
	
	Для каждого ТекЭлемент Из ЭлементыДерева Цикл
		
		Если (ТекЭлемент.ТипСущности = "Компания" ИЛИ ТекЭлемент.ТипСущности = "Организация") Тогда
			ЭлементыВДереве.Компания.Добавить(ТекЭлемент.ИдСущности);	
		ИначеЕсли (ТекЭлемент.ТипСущности = "Реквизит организации" ИЛИ ТекЭлемент.ТипСущности = "Реквизит компании" ИЛИ ТекЭлемент.ТипСущности = "Реквизит контакта") Тогда			
			ЭлементыВДереве.Реквизит.Добавить(ТекЭлемент.ИдСущности);	
		ИначеЕсли (ТекЭлемент.ТипСущности = "Контакт" ИЛИ ТекЭлемент.ТипСущности = "Контакт компании") Тогда			
			ЭлементыВДереве.Контакт.Добавить(ТекЭлемент.ИдСущности);	
		ИначеЕсли (ТекЭлемент.ТипСущности = "Счет") Тогда
			ЭлементыВДереве.БанкСчет.Добавить(ТекЭлемент.ИдСущности);	
		КонецЕсли;
		
		НовыеЭлементы = ТекЭлемент.ПолучитьЭлементы();
		Если НовыеЭлементы.Количество() > 0 Тогда
			ПолучитьИзмененныеЭлементыРекурсивно(НовыеЭлементы, ЭлементыВДереве);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область ПоискСовпадений

&НаКлиенте
Процедура ПослеВыбораИзМеню(ВыбранныйЭлемент, Параметры) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОткрытогоДерева = ПолучитьИзмененныеЭлементы();
	
	Если ВыбранныйЭлемент.Значение = "Внешний идентификатор" Тогда
#Область ВнешнийИдентификатор
		мТаблицы = Новый Массив;
		мТаблицы.Добавить(ТаблицаКомпаний);
		мТаблицы.Добавить(ТаблицаКонтактов);
		мТаблицы.Добавить(ТаблицаРеквизитов);
		мТаблицы.Добавить(ТаблицаСчетов);
		
		Для каждого ТекТаблица Из мТаблицы Цикл
			Для каждого ТекЭлемент Из ТекТаблица Цикл
				
				Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					Продолжить;	
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(ТекЭлемент.ВнешнийКод) Тогда
					Продолжить;	
				КонецЕсли;
				
				Если ТекТаблица = ТаблицаКомпаний Тогда
					Если ДанныеОткрытогоДерева.Компания.Найти(ТекЭлемент.Ид) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				ИначеЕсли ТекТаблица = ТаблицаКонтактов Тогда
					Если ДанныеОткрытогоДерева.Контакт.Найти(ТекЭлемент.Ид) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				ИначеЕсли ТекТаблица = ТаблицаРеквизитов Тогда
					Если ДанныеОткрытогоДерева.Реквизит.Найти(ТекЭлемент.Ид) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				ИначеЕсли ТекТаблица = ТаблицаСчетов Тогда
					Если ДанныеОткрытогоДерева.БанкСчет.Найти(ТекЭлемент.Ид) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				ТипДанных = Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", "СправочникСсылка.Контрагенты", "СправочникСсылка.Партнеры"));
				Если ТекТаблица = ТаблицаКомпаний Тогда
					Если ТекЭлемент.ЭтоНашаКомпания	Тогда
						ТипДанных = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Организации");
					КонецЕсли;
				ИначеЕсли ТекТаблица = ТаблицаРеквизитов Тогда
					ТипДанных = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Контрагенты");
				ИначеЕсли ТекТаблица = ТаблицаСчетов Тогда
					ТипДанных = Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", "СправочникСсылка.БанковскиеСчета", "СправочникСсылка.БанковскиеСчетаКонтрагентов"));
					
				ИначеЕсли ТекТаблица = ТаблицаКонтактов Тогда
					Если ЗначениеЗаполнено(ТекЭлемент.ИдКомпании) Тогда
						ТипДанных = Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", "СправочникСсылка.КонтактныеЛица", "СправочникСсылка.КонтактныеЛицаПартнеров"));
					КонецЕсли;
				КонецЕсли;
				
				ТекЭлемент.Сущность1С 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(ТипДанных, ТекЭлемент.ВнешнийКод); 
				
				Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
					ТекЭлемент.Изменена	= Истина;
					БылиИзменения = Истина;
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
#КонецОбласти
		
	ИначеЕсли ВыбранныйЭлемент.Значение = "Телефон" Тогда	
		ПоискПоКИ("Телефон", ДанныеОткрытогоДерева);
	ИначеЕсли ВыбранныйЭлемент.Значение = "Email" Тогда	
		ПоискПоКИ("Почта", ДанныеОткрытогоДерева);
	ИначеЕсли ВыбранныйЭлемент.Значение = "ИНН+КПП" Тогда	
		ПоискРеквизитовПоИНН(ДанныеОткрытогоДерева);
	ИначеЕсли ВыбранныйЭлемент.Значение = "ФИО" Тогда	
		ПоискРеквизитовПоФИО(ДанныеОткрытогоДерева);
	ИначеЕсли ВыбранныйЭлемент.Значение = "Номер счета" Тогда	
		ПоискБанкСчетовПоНомерамСчетов(ДанныеОткрытогоДерева);
	КонецЕсли;
	
	ЗаполнитьДеревоЭлементов();
	
	РазвернутьДеревоСлиянияДанных();
	
	Если БылиИзменения Тогда
		Элементы.ФормаСохранитьСлияниеДанных.Доступность = Истина;
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоискБанкСчетовПоНомерамСчетов(ДанныеОткрытогоДерева)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ТипыДанных = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал"		, Портал);
	Запрос.УстановитьПараметр("БанковскийСчетРеквизита"	, ТипыДанных.БанковскийСчетРеквизита);
	
	Если ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ИдентификаторыОбъектов
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
		|ГДЕ
		|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
		|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &БанковскийСчетРеквизита
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка КАК Ссылка,
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	ВТ_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
		|	Банки.Код КАК БИК
		|ПОМЕСТИТЬ ВТ_БанкСчетаПром
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО (ВТ_ИдентификаторыОбъектов.Объект = БанковскиеСчета.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки ПО БанковскиеСчета.Банк = Банки.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка,
		|	БанковскиеСчета.НомерСчета,
		|	ВТ_ИдентификаторыОбъектов.Идентификатор,
		|	Банки.Код
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО (ВТ_ИдентификаторыОбъектов.Объект = БанковскиеСчета.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки ПО БанковскиеСчета.Банк = Банки.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ИдентификаторыОбъектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_БанкСчетаПром.Ссылка КАК Ссылка,
		|	ВТ_БанкСчетаПром.НомерСчета КАК НомерСчета,
		|	ВТ_БанкСчетаПром.БИК КАК БИК
		|ПОМЕСТИТЬ ВТ_БанкСчета
		|ИЗ
		|	ВТ_БанкСчетаПром КАК ВТ_БанкСчетаПром
		|ГДЕ
		|	ВТ_БанкСчетаПром.Идентификатор ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	НомерСчета,
		|	БИК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_БанкСчетаПром";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ИдентификаторыОбъектов
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
		|ГДЕ
		|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
		|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &БанковскийСчетРеквизита
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка КАК Ссылка,
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	ВТ_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
		|	ВЫБОР
		|		КОГДА БанковскиеСчета.БИКБанка = """"
		|			ТОГДА КлассификаторБанков.Код
		|		ИНАЧЕ БанковскиеСчета.БИКБанка
		|	КОНЕЦ КАК БИК
		|ПОМЕСТИТЬ ВТ_БанкСчетаПром
		|ИЗ
		|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО (ВТ_ИдентификаторыОбъектов.Объект = БанковскиеСчета.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК КлассификаторБанков ПО БанковскиеСчета.Банк = КлассификаторБанков.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка,
		|	БанковскиеСчета.НомерСчета,
		|	ВТ_ИдентификаторыОбъектов.Идентификатор,
		|	ВЫБОР
		|		КОГДА БанковскиеСчета.БИКБанка = """"
		|			ТОГДА КлассификаторБанков.Код
		|		ИНАЧЕ БанковскиеСчета.БИКБанка
		|	КОНЕЦ
		|ИЗ
		|	Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО (ВТ_ИдентификаторыОбъектов.Объект = БанковскиеСчета.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК КлассификаторБанков ПО БанковскиеСчета.Банк = КлассификаторБанков.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ИдентификаторыОбъектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_БанкСчетаПром.Ссылка КАК Ссылка,
		|	ВТ_БанкСчетаПром.НомерСчета КАК НомерСчета,
		|	ВТ_БанкСчетаПром.БИК КАК БИК
		|ПОМЕСТИТЬ ВТ_БанкСчета
		|ИЗ
		|	ВТ_БанкСчетаПром КАК ВТ_БанкСчетаПром
		|ГДЕ
		|	ВТ_БанкСчетаПром.Идентификатор ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	НомерСчета,
		|	БИК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_БанкСчетаПром";
	КонецЕсли;
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаСчетов Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.НомерСчета) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.БанкСчет.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("НомерСчета"	, ТекЭлемент.НомерСчета);
		Запрос.УстановитьПараметр("БИК"			, ТекЭлемент.БИК);
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_БанкСчета.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_БанкСчета КАК ВТ_БанкСчета
		|ГДЕ
		|	ВТ_БанкСчета.НомерСчета = &НомерСчета
		|	И ВТ_БанкСчета.БИК = &БИК";
		ВыполненныйЗапрос = Запрос.Выполнить();
			
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			тзнДанных = ВыполненныйЗапрос.Выгрузить();
			Сущность1С = тзнДанных[0].Ссылка;
		
			ТекЭлемент.Сущность1С = Сущность1С; 
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
				
				ОбновлениеРеквизитаПоИд(ТекЭлемент.ИдВладельца, ТекЭлемент.Сущность1С.Владелец);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПоискРеквизитовПоИНН(ДанныеОткрытогоДерева)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ТипыДанных = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал"		, Портал);
	Запрос.УстановитьПараметр("ТипРеквизит"	, ТипыДанных.Реквизит);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ИдентификаторыОбъектов
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипРеквизит
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП,
	|	ВТ_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ДанныеРеквизитовПром
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
	|		ПО (ВТ_ИдентификаторыОбъектов.Объект = Контрагенты.Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Организации.Ссылка,
	|	Организации.ИНН,
	|	Организации.КПП,
	|	ВТ_ИдентификаторыОбъектов.Идентификатор
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
	|		ПО ВТ_ИдентификаторыОбъектов.Объект = Организации.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ИдентификаторыОбъектов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеРеквизитовПром.Ссылка КАК Ссылка,
	|	ВТ_ДанныеРеквизитовПром.ИНН КАК ИНН,
	|	ВТ_ДанныеРеквизитовПром.КПП КАК КПП
	|ПОМЕСТИТЬ ВТ_ДанныеРеквизитов
	|ИЗ
	|	ВТ_ДанныеРеквизитовПром КАК ВТ_ДанныеРеквизитовПром
	|ГДЕ
	|	ВТ_ДанныеРеквизитовПром.Идентификатор ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИНН,
	|	КПП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДанныеРеквизитовПром";
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаРеквизитов Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.ИНН) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Реквизит.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("ИНН", ТекЭлемент.ИНН);
		ТекстЗапроса = "ВЫБРАТЬ
		|	ВТ_ДанныеРеквизитов.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_ДанныеРеквизитов КАК ВТ_ДанныеРеквизитов
		|ГДЕ
		|	ВТ_ДанныеРеквизитов.ИНН = &ИНН";
		
		Если ЗначениеЗаполнено(ТекЭлемент.КПП) Тогда
			Запрос.УстановитьПараметр("КПП", ТекЭлемент.КПП);
			ТекстЗапроса = ТекстЗапроса + "
			| И ВТ_ДанныеРеквизитов.КПП = &КПП";
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		ВыполненныйЗапрос = Запрос.Выполнить();
			
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			тзнДанных = ВыполненныйЗапрос.Выгрузить();
			Сущность1С = тзнДанных[0].Ссылка;
		
			ТекЭлемент.Сущность1С = Сущность1С; 
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ТекЭлемент Из ТаблицаРеквизитов Цикл
		
		Если НЕ ТекЭлемент.Изменена	Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Реквизит.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ТекЭлемент.ТипВладельца = "4" Тогда 
			ОбновлениеКомпанииПоИд(ТекЭлемент.ИдВладельца, ТекЭлемент.Сущность1С, Ложь);
		Иначе
			ОбновлениеКонтактаПоИд(ТекЭлемент.ИдВладельца, ТекЭлемент.Сущность1С, Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

