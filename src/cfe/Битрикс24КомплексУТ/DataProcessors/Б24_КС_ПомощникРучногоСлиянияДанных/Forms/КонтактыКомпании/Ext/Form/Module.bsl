		|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаКонтактнаяИнформация
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО КонтактныеЛицаКонтактнаяИнформация.Ссылка = ВТ_ИдентификаторыОбъектов.Объект
		|ГДЕ
		|	КонтактныеЛицаКонтактнаяИнформация.Тип = &ТипТелефона
		|	И &ПоискПоТелефону = ИСТИНА
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеТелефонПром.Ссылка КАК Ссылка,
		|	ВТ_ДанныеТелефонПром.ЗначениеКИ КАК ЗначениеКИ,
		|	ВТ_ДанныеТелефонПром.ТипСущности КАК ТипСущности
		|ПОМЕСТИТЬ ВТ_ДанныеТелефон
		|ИЗ
		|	ВТ_ДанныеТелефонПром КАК ВТ_ДанныеТелефонПром
		|ГДЕ
		|	ВТ_ДанныеТелефонПром.Идентификатор ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ТипСущности,
		|	ЗначениеКИ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ДанныеТелефонПром
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ИдентификаторыОбъектов";
	КонецЕсли;
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаКомпаний Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Компания.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		КИЭлементы = ?(ТипКИ = "Почта", ТекЭлемент.Почта, ТекЭлемент.Телефоны); 
		
		Если КИЭлементы.Количество()=0 Тогда
			Продолжить;	
		КонецЕсли;
		
		ЗначенияКИ = Новый Массив;
	
		Для каждого ТекКИ Из КИЭлементы Цикл
			ЗначенияКИ.Добавить(ТекКИ.Значение.Значение);	
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("ЗначенияКИ", ЗначенияКИ);
		Если ТекЭлемент.ЭтоНашаКомпания Тогда 
			Запрос.УстановитьПараметр("ТипСущности", 2);
		Иначе
			Запрос.УстановитьПараметр("ТипСущности", 1);
		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_ДанныеКИ.Ссылка КАК Ссылка
		|ИЗ
		|	"+ИмяТаблицы+" КАК ВТ_ДанныеКИ
		|ГДЕ
		|	ВТ_ДанныеКИ.ТипСущности = &ТипСущности
		|	И ВТ_ДанныеКИ.ЗначениеКИ В(&ЗначенияКИ)";
		ВыполненныйЗапрос = Запрос.Выполнить();
			
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			тзнДанных = ВыполненныйЗапрос.Выгрузить();
			Сущность1С = тзнДанных[0].Ссылка;
		
			ТекЭлемент.Сущность1С = Сущность1С; 
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		ОбновлениеРеквизитаПоВладельцу("4", ТекЭлемент.Ид, ТекЭлемент.Сущность1С);
		
	КонецЦикла;
	
	Для каждого ТекЭлемент Из ТаблицаКонтактов Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Контакт.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		КИЭлементы = ?(ТипКИ = "Почта", ТекЭлемент.Почта, ТекЭлемент.Телефоны); 
		
		Если КИЭлементы.Количество()=0 Тогда
			Продолжить;	
		КонецЕсли;
		
		ЗначенияКИ = Новый Массив;
	
		Для каждого ТекКИ Из КИЭлементы Цикл
			ЗначенияКИ.Добавить(ТекКИ.Значение.Значение);	
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("ЗначенияКИ", ЗначенияКИ);
		Если ЗначениеЗаполнено(ТекЭлемент.ИдКомпании) Тогда 
			Запрос.УстановитьПараметр("ТипСущности", 3);
		Иначе
			Запрос.УстановитьПараметр("ТипСущности", 1);
		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_ДанныеКИ.Ссылка КАК Ссылка
		|ИЗ
		|	"+ИмяТаблицы+" КАК ВТ_ДанныеКИ
		|ГДЕ
		|	ВТ_ДанныеКИ.ТипСущности = &ТипСущности
		|	И ВТ_ДанныеКИ.ЗначениеКИ В(&ЗначенияКИ)";
		ВыполненныйЗапрос = Запрос.Выполнить();
			
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			тзнДанных = ВыполненныйЗапрос.Выгрузить();
			Сущность1С = тзнДанных[0].Ссылка;
		
			ТекЭлемент.Сущность1С = Сущность1С; 
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекЭлемент.ИдКомпании) Тогда
		
			Если НЕ ТекЭлемент.Изменена	Тогда
				Продолжить;	
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				Продолжить;	
			КонецЕсли;                  
			
			ОбновлениеКомпанииПоИд(ТекЭлемент.ИдКомпании, ТекЭлемент.Сущность1С);  

		Иначе
			ОбновлениеРеквизитаПоВладельцу("3", ТекЭлемент.Ид, ТекЭлемент.Сущность1С);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПоискРеквизитовПоФИО(ДанныеОткрытогоДерева)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ТипыДанных = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал"		, Портал);
	Запрос.УстановитьПараметр("ТипКомпания"	, ТипыДанных.Компания);
	Запрос.УстановитьПараметр("ТипКонтакт"	, ТипыДанных.Контакт);
	Если ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ИдентификаторыОбъектов
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
		|ГДЕ
		|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
		|	И (Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипКомпания
		|			ИЛИ Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипКонтакт)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Партнеры.Ссылка КАК Ссылка,
		|	Партнеры.Наименование КАК ФИО,
		|	1 КАК ТипСущности,
		|	ВТ_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ДанныеПром
		|ИЗ
		|	Справочник.Контрагенты КАК Партнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО (ВТ_ИдентификаторыОбъектов.Объект = Партнеры.Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтактныеЛица.Ссылка,
		|	КонтактныеЛица.Наименование,
		|	3,
		|	ВТ_ИдентификаторыОбъектов.Идентификатор
		|ИЗ
		|	Справочник.КонтактныеЛица КАК КонтактныеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО (ВТ_ИдентификаторыОбъектов.Объект = КонтактныеЛица.Ссылка)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ИдентификаторыОбъектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеПром.Ссылка КАК Ссылка,
		|	ВТ_ДанныеПром.ФИО КАК ФИО,
		|	ВТ_ДанныеПром.ТипСущности КАК ТипСущности
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	ВТ_ДанныеПром КАК ВТ_ДанныеПром
		|ГДЕ
		|	ВТ_ДанныеПром.Идентификатор ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ТипСущности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ДанныеПром";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ИдентификаторыОбъектов
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
		|ГДЕ
		|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
		|	И (Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипКомпания
		|			ИЛИ Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипКонтакт)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Партнеры.Ссылка КАК Ссылка,
		|	Партнеры.Наименование КАК ФИО,
		|	1 КАК ТипСущности,
		|	ВТ_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ДанныеПром
		|ИЗ
		|	Справочник.Партнеры КАК Партнеры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО (ВТ_ИдентификаторыОбъектов.Объект = Партнеры.Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтактныеЛица.Ссылка,
		|	КонтактныеЛица.Наименование,
		|	3,
		|	ВТ_ИдентификаторыОбъектов.Идентификатор
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыОбъектов КАК ВТ_ИдентификаторыОбъектов
		|		ПО (ВТ_ИдентификаторыОбъектов.Объект = КонтактныеЛица.Ссылка)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ИдентификаторыОбъектов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеПром.Ссылка КАК Ссылка,
		|	ВТ_ДанныеПром.ФИО КАК ФИО,
		|	ВТ_ДанныеПром.ТипСущности КАК ТипСущности
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	ВТ_ДанныеПром КАК ВТ_ДанныеПром
		|ГДЕ
		|	ВТ_ДанныеПром.Идентификатор ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ТипСущности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_ДанныеПром";
	КонецЕсли;
	Запрос.Выполнить();
	
	Для каждого ТекЭлемент Из ТаблицаКонтактов Цикл
		
		Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Фамилия) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Контакт.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Если ЗначениеЗаполнено(ТекЭлемент.ИдКомпании) и НЕ ТекЭлемент.ИдКомпании = "0" Тогда 
			Запрос.УстановитьПараметр("ТипСущности", 3);
		Иначе
			Запрос.УстановитьПараметр("ТипСущности", 1);
		КонецЕсли;
		Запрос.УстановитьПараметр("Фамилия"	, "%"+ТекЭлемент.Фамилия+"%");
		Запрос.УстановитьПараметр("Имя"		, "%"+ТекЭлемент.Имя+"%");
		Запрос.УстановитьПараметр("Отчество", "%"+ТекЭлемент.Отчество+"%");
		ТекстЗапроса = "ВЫБРАТЬ
		|	ВТ_Данные.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные
		|ГДЕ
		|	ВТ_Данные.ТипСущности = &ТипСущности
		|	И ВТ_Данные.ФИО ПОДОБНО &Фамилия
		|	И ВТ_Данные.ФИО ПОДОБНО &Имя
		|	И ВТ_Данные.ФИО ПОДОБНО &Отчество";
		
		Запрос.Текст = ТекстЗапроса;
		ВыполненныйЗапрос = Запрос.Выполнить();
			
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			тзнДанных = ВыполненныйЗапрос.Выгрузить();
			Сущность1С = тзнДанных[0].Ссылка;
		
			ТекЭлемент.Сущность1С = Сущность1С; 
			Если ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				ТекЭлемент.Изменена	= Истина;
				БылиИзменения = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ТекЭлемент Из ТаблицаКонтактов Цикл
		
		Если НЕ ТекЭлемент.Изменена	Тогда
			Продолжить;	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ДанныеОткрытогоДерева.Контакт.Найти(ТекЭлемент.Ид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ТекЭлемент.ИдКомпании) Тогда
			
			Если НЕ ТекЭлемент.Изменена	Тогда
				Продолжить;	
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(ТекЭлемент.Сущность1С) Тогда
				Продолжить;	
			КонецЕсли;
			
			ОбновлениеКомпанииПоИд(ТекЭлемент.ИдКомпании, ТекЭлемент.Сущность1С); 
			
		Иначе	
			ОбновлениеРеквизитаПоВладельцу("3", ТекЭлемент.Ид, ТекЭлемент.Сущность1С);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновлениеКомпанииПоИд(ИдЭлемента, Сущность1С, ОбновлятьРеквизиты = Истина)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ТипСущности = ТипЗнч(Сущность1С);
	
	Если ТипСущности = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Организации") Тогда
		Компания = Сущность1С;	
	ИначеЕсли ТипСущности = Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", "СправочникСсылка.Контрагенты", "СправочникСсылка.Партнеры")) Тогда
		Компания = Сущность1С;	
	ИначеЕсли ТипСущности = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Контрагенты") Тогда
