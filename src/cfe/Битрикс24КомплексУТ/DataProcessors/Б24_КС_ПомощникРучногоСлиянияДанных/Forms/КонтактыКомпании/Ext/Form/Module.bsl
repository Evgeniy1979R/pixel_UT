				МассивД.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.КонтактныеЛица"));
			КонецЕсли;
			ОписаниеТипов = Новый ОписаниеТипов(МассивД);
			
			ЭлементДанных.ОграничениеТипа = ОписаниеТипов;
			
		ИначеЕсли ДанныеСтроки.ТипСущности = "Контакт компании" Тогда
			
