			Продолжить;	
		КонецЕсли;
		
		НайденнаяСтрока.Сущность1С 	= Контакт; 
		Если ЗначениеЗаполнено(НайденнаяСтрока.Сущность1С) Тогда
			НайденнаяСтрока.Изменена = Истина;
			БылиИзменения = Истина;
			
			Если ОбновлятьРеквизиты Тогда
				ОбновлениеРеквизитаПоВладельцу("3", НайденнаяСтрока.Ид, Контакт);
