
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаПодключения 	= Параметры.НастройкаПодключения;
	Портал 					= НастройкаПодключения.Портал;
	
	Если Параметры.Свойство("ТипСущности1С") Тогда
		ТипСущности1С = Параметры.ТипСущности1С;	
	Иначе
		ТипСущности1С = "Справочник";    
	КонецЕсли;
	
	Если Параметры.Свойство("Сущность1С") Тогда ВыбраннаяСущность1С = Параметры.Сущность1С КонецЕсли;
	
	Если Параметры.Свойство("СмартПроцесс") Тогда ВыбранныйСмартПроцесс = Параметры.СмартПроцесс КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)       
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Ложь);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;      
	
	СтруктураНастроек.Логирование.Измерение2 = "Сопоставление смарт-процессов";
	
	ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.type.list", "id", "", "types");
	Для каждого ТекЭлемент Из ДанныеПортала Цикл   
		
		ИдСП = Формат(ТекЭлемент.Получить("entityTypeId"), "ЧГ=0") + "#" + Формат(ТекЭлемент.Получить("id"), "ЧГ=0"); 
		
		Элементы.СмартПроцесс.СписокВыбора.Добавить(ИдСП, ТекЭлемент.Получить("title")); 
		
	КонецЦикла;

	Если ЗначениеЗаполнено(ВыбранныйСмартПроцесс) Тогда
		СмартПроцесс = ВыбранныйСмартПроцесс;  
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыбраннаяСущность1С) Тогда  
		
		СписокСущностей1С 	= ПолучитьСписокСущностей1С();  
		
		НайденныйЭлемент = СписокСущностей1С.НайтиПоЗначению(ВыбраннаяСущность1С);
		Если НайденныйЭлемент <> Неопределено Тогда
			Сущность1С.Добавить(НайденныйЭлемент.Значение, НайденныйЭлемент.Представление);   
		КонецЕсли;  
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область СобытияКомандФормы

&НаКлиенте
Процедура ПерейтиКСлиянию(Команда)
	
	Если НЕ ЗначениеЗаполнено(СмартПроцесс) Тогда     
		ПоказатьПредупреждение(,"Не указан смарт-процесс");
		Возврат;
	КонецЕсли;
	
	ИмяСущности = "";
	Если Сущность1С.Количество() > 0 Тогда ИмяСущности = Сущность1С[0].Значение КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ИмяСущности) Тогда     
		ПоказатьПредупреждение(,"Не указана сущность 1С");
		Возврат;
	КонецЕсли;
	
	РезультатЗакрытия = Новый Структура;
	
	РезультатЗакрытия.Вставить("СмартПроцесс"	, СмартПроцесс);
	РезультатЗакрытия.Вставить("ТипСущности1С"	, ТипСущности1С);
	РезультатЗакрытия.Вставить("Сущность1С"		, ИмяСущности);
	
	Закрыть(РезультатЗакрытия);
	
КонецПроцедуры

#КонецОбласти


#Область СобытияЭлементовФормы

&НаКлиенте
Процедура ТипСущности1СПриИзменении(Элемент)
	
	Сущность1С.Очистить();
	
КонецПроцедуры	

&НаКлиенте
Процедура Сущность1СНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Сущность1С 			= Сущность1С;
	СписокСущностей1С 	= ПолучитьСписокСущностей1С();
	
	Если Сущность1С.Количество() > 0 Тогда
		ВыбраннаяСущность = СписокСущностей1С.НайтиПоЗначению(Сущность1С[0].Значение);	
	Иначе
		ВыбраннаяСущность = Неопределено;	
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораСущности", ЭтотОбъект, Параметры);
	ПоказатьВыборИзСписка(Оповещение, СписокСущностей1С, Элементы.Сущность1С, ВыбраннаяСущность);

	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСущности(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Сущность1С.Очистить();
	Сущность1С.Добавить(Результат.Значение, Результат.Представление);
	
КонецПроцедуры

&НаКлиенте
Процедура Сущность1СОчистка(Элемент, СтандартнаяОбработка)
	
	Сущность1С.Очистить();
	
КонецПроцедуры

#КонецОбласти    


#Область Прочее
 
&НаСервере
Функция ПолучитьСписокСущностей1С()
	
	Результат = Новый СписокЗначений;
	
	Если ТипСущности1С = "Справочник" Тогда
		
		Для каждого ТекЭлемент Из Метаданные.Справочники Цикл
			Результат.Добавить(ТекЭлемент.Имя, ТекЭлемент.Синоним); 
		КонецЦикла;
		
	ИначеЕсли ТипСущности1С = "Документ" Тогда
		
		Для каждого ТекЭлемент Из Метаданные.Документы Цикл
			Результат.Добавить(ТекЭлемент.Имя, ТекЭлемент.Синоним); 
		КонецЦикла;
		
	КонецЕсли;
	
	Результат.СортироватьПоПредставлению();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
