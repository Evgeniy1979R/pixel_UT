#Область Прайсы

Процедура ЗагрузитьПрайсыПоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйСквознойНомер 	= 0;
	
	ТаблицаПрайсов 		= ПередаваемыеПараметры.ТаблицаПрайсов;
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка прайсов");
	
	ИнформацияПрайсов = ПолучитьПрайсы(СтруктураНастроек);
		
	Для каждого ТекЭлемент Из ИнформацияПрайсов Цикл
		
		ИдЭлемента 		= Формат(ТекЭлемент.Получить("id"),"ЧГ=0"); 
		ВнешнийКод		= ТекЭлемент.Получить("xmlId");
		Наименование 	= ТекЭлемент.Получить("name");
		
		Если ЗначениеЗаполнено(Наименование) Тогда
			
			МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;
			НоваяСтрока = ТаблицаПрайсов.Добавить();
			НоваяСтрока.СквознойНомер	= МаксимальныйСквознойНомер;
			НоваяСтрока.Ид 				= ИдЭлемента;
			НоваяСтрока.ВнешнийКод 		= ВнешнийКод;  
			НоваяСтрока.Наименование	= Наименование; 
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер"	, МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаПрайсов"		, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаПрайсов));
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры
 
Функция ПолучитьПрайсы(СтруктураНастроек)
	
	Результат = Новый Массив;
	
	Фильтр 				= "&select[]=id";	
	НазваниеПараметра 	= "id";
	
	СтруктураНастроек.Логирование.Измерение1 = "Помощник ручного слияния";
	
	Метод 		= "/rest/catalog.pricetype.list";
	МетодBatch 	= "catalog.pricetype.get";
		
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка прайсов Б24";	 
	
	Следующие = "Начало"; 
	Пока ЗначениеЗаполнено(Следующие) Цикл
		
		Если Следующие = "Начало" Тогда
			ТелоHTTPЗапроса = Фильтр;	 
		Иначе
			Следующие = Формат(Следующие, "ЧГ=0");
			ТелоHTTPЗапроса = "&start="+Следующие + Фильтр;	 
		КонецЕсли;
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		Если СтруктураОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result = СтруктураОтвета.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		priceTypes = result.Получить("priceTypes");
		Если priceTypes = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		ТелоHTTPBatchЗапроса = "";
		Для каждого ТекЭлемент Из priceTypes Цикл
				
			ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
			ИдЭлемента = ?(ЗначениеЗаполнено(ИдЭлемента), ИдЭлемента, Формат(ТекЭлемент.Получить("id"), "ЧГ=0"));
						
			ТелоHTTPBatchЗапроса = ТелоHTTPBatchЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодBatch + "?"+НазваниеПараметра+"=" + ИдЭлемента);
				
		КонецЦикла;
		
		СтруктураОтветаBatch = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPBatchЗапроса);
				
		Если СтруктураОтветаBatch = Неопределено Тогда
			Прервать;
		КонецЕсли;
				
		result = СтруктураОтветаBatch.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result2 = result.Получить("result");
		Если result2 = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Для каждого ТекЭлемент Из result2 Цикл
			Результат.Добавить(ТекЭлемент.Получить("priceType"));	
		КонецЦикла;
		
	   Следующие = СтруктураОтвета.Получить("next");
	   
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

#КонецОбласти                   

 
#Область Разделы

Процедура ЗагрузитьРазделыПоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйСквознойНомер 	= 0;
	
	ТаблицаРазделов 			 = ПередаваемыеПараметры.ТаблицаРазделов;
	ИдентификаторКаталогаТоваров = ПередаваемыеПараметры.ИдентификаторКаталогаТоваров;

	ОбщегоНазначения.СообщитьПользователю("Загрузка прайсов");

	ИнформацияРазделов = ПолучитьРазделы(СтруктураНастроек, ИдентификаторКаталогаТоваров);
		
	Для каждого ТекЭлемент Из ИнформацияРазделов Цикл
		
		ИдЭлемента 		= Формат(ТекЭлемент.Получить("id"),"ЧГ=0");  
		ИдРодителя 		= Формат(ТекЭлемент.Получить("iblockSectionId"),"ЧГ=0");
		ВнешнийКод		= ТекЭлемент.Получить("xmlId");
		Наименование 	= ТекЭлемент.Получить("name");
		Активность 		= ТекЭлемент.Получить("active");
		
		Если Активность <> "N" И ЗначениеЗаполнено(Наименование) Тогда
			
			МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;
			НоваяСтрока = ТаблицаРазделов.Добавить();
			НоваяСтрока.СквознойНомер	= МаксимальныйСквознойНомер;
			НоваяСтрока.Ид 				= ИдЭлемента;
			НоваяСтрока.ИдРодителя 		= ИдРодителя;
			НоваяСтрока.ВнешнийКод 		= ВнешнийКод;  
			НоваяСтрока.Наименование	= Наименование; 
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер"	, МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаРазделов"			, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаРазделов));
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры
 
Функция ПолучитьРазделы(СтруктураНастроек, ИдентификаторКаталогаТоваров)
	
	Результат = Новый Массив;
	
	Фильтр 				= "&filter[iblockId]="+ИдентификаторКаталогаТоваров;	
	НазваниеПараметра 	= "id";
	   
	СтруктураНастроек.Логирование.Измерение1 = "Помощник ручного слияния";
	
	Метод 		= "/rest/catalog.section.list";
	МетодBatch 	= "catalog.section.get";
		
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка разделов Б24";	 
	
	Следующие = "Начало"; 	
	Пока ЗначениеЗаполнено(Следующие) Цикл
		
		Если Следующие = "Начало" Тогда
			ТелоHTTPЗапроса = Фильтр;	 
		Иначе
			Следующие = Формат(Следующие, "ЧГ=0");
			ТелоHTTPЗапроса = "&start="+Следующие + Фильтр;	 
		КонецЕсли;
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		Если СтруктураОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result = СтруктураОтвета.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		sections = result.Получить("sections");
		Если sections = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		ТелоHTTPBatchЗапроса = "";
		Для каждого ТекЭлемент Из sections Цикл
				
			ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
			ИдЭлемента = ?(ЗначениеЗаполнено(ИдЭлемента), ИдЭлемента, Формат(ТекЭлемент.Получить("id"), "ЧГ=0"));
						
			ТелоHTTPBatchЗапроса = ТелоHTTPBatchЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодBatch + "?"+НазваниеПараметра+"=" + ИдЭлемента);
				
		КонецЦикла;
		
		СтруктураОтветаBatch = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPBatchЗапроса);
		Если СтруктураОтветаBatch = Неопределено Тогда
			Прервать;
		КонецЕсли;
				
		result = СтруктураОтветаBatch.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result2 = result.Получить("result");
		Если result2 = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Для каждого ТекЭлемент Из result2 Цикл
			Результат.Добавить(ТекЭлемент.Получить("section"));	
		КонецЦикла;
		
	   Следующие = СтруктураОтвета.Получить("next");
	   
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

