#Область ЕдиницыИзмерения

Процедура ЗагрузитьЕдиницыИзмеренияПоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйСквознойНомер 	= 0;
	
	ТаблицаЕдиницИзмерения 		= ПередаваемыеПараметры.ТаблицаЕдиницИзмерения;
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка единиц измерения");
	
	ИнформацияЕдиницИзмерения = ПолучитьЕдиницыИзмерения(СтруктураНастроек);
		
	Для каждого ТекЭлемент Из ИнформацияЕдиницИзмерения Цикл
		
		ИдЭлемента 		= Формат(ТекЭлемент.Получить("id"),"ЧГ=0"); 
		Код 			= Формат(ТекЭлемент.Получить("code"),"ЧГ=0"); 
		ВнешнийКод		= "";
		Наименование 	= ТекЭлемент.Получить("symbol");
		НаименованиеП 	= ТекЭлемент.Получить("measureTitle");
		НаименованиеМ 	= ТекЭлемент.Получить("symbolIntl");
		
		Если НЕ ЗначениеЗаполнено(Наименование) Тогда Наименование = НаименованиеМ КонецЕсли; 
		
		Если ЗначениеЗаполнено(Наименование) ИЛИ ЗначениеЗаполнено(НаименованиеП) Тогда
			
			МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;
			НоваяСтрока = ТаблицаЕдиницИзмерения.Добавить();
			НоваяСтрока.СквознойНомер		= МаксимальныйСквознойНомер;
			НоваяСтрока.Ид 					= ИдЭлемента;
			НоваяСтрока.Код 				= Код;
			НоваяСтрока.ВнешнийКод 			= ВнешнийКод;  
			
			НоваяСтрока.Наименование			= Наименование; 
			НоваяСтрока.НаименованиеПолное		= НаименованиеП; 
			НоваяСтрока.МеждународноеСокращение	= НаименованиеМ;   
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Некорретно заполнено наименование единицы измерения с кодом: " + Строка(Код));
		КонецЕсли;
		
	КонецЦикла; 
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер"	, МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаЕдиницИзмерения"		, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаЕдиницИзмерения));
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры
 
Функция ПолучитьЕдиницыИзмерения(СтруктураНастроек)
	
	Результат = Новый Массив;
	
	Фильтр 				= "&select[]=id";	
	НазваниеПараметра 	= "id";
	
	СтруктураНастроек.Логирование.Измерение1 = "Помощник ручного слияния";
	
	Метод 		= "/rest/catalog.measure.list";
	МетодBatch 	= "catalog.measure.get";
		
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка единиц измерения Б24";	 
		
	Следующие = "Начало"; 	
	Пока ЗначениеЗаполнено(Следующие) Цикл
		
		Если Следующие = "Начало" Тогда
			ТелоHTTPЗапроса = Фильтр;	 
		Иначе
			Следующие = Формат(Следующие, "ЧГ=0");
			ТелоHTTPЗапроса = "&start="+Следующие + Фильтр;	 
		КонецЕсли;		
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		Если СтруктураОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result = СтруктураОтвета.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;

		measures = result.Получить("measures");
		Если measures = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		ТелоHTTPBatchЗапроса = "";
		Для каждого ТекЭлемент Из measures Цикл
				
			ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
			ИдЭлемента = ?(ЗначениеЗаполнено(ИдЭлемента), ИдЭлемента, Формат(ТекЭлемент.Получить("id"), "ЧГ=0"));
						
			ТелоHTTPBatchЗапроса = ТелоHTTPBatchЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодBatch + "?"+НазваниеПараметра+"=" + ИдЭлемента);
				
		КонецЦикла;
		
		СтруктураОтветаBatch = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPBatchЗапроса);
		Если СтруктураОтветаBatch = Неопределено Тогда
			Прервать;
		КонецЕсли;
				
		result = СтруктураОтветаBatch.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result2 = result.Получить("result");
		Если result2 = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Для каждого ТекЭлемент Из result2 Цикл
			Результат.Добавить(ТекЭлемент.Получить("measure"));	
		КонецЦикла;
		
	   Следующие = СтруктураОтвета.Получить("next");
	   
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

