#Область Товары

Процедура ЗагрузитьТоварыПоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйСквознойНомер 			= 0;
	
	ИдентификаторКаталогаТоваров 		= ПередаваемыеПараметры.ИдентификаторКаталогаТоваров;
	ТаблицаТоваров 						= ПередаваемыеПараметры.ТаблицаТоваров;
	ТаблицаСвойств 						= ПередаваемыеПараметры.ТаблицаСвойств;
	ТаблицаЗначенийСвойств 				= ПередаваемыеПараметры.ТаблицаЗначенийСвойств;  
	
	ВыбранныеПакеты 					= ПередаваемыеПараметры.ВыбранныеПакеты;  
	
#Область ЗагрузкаТоваров              
	НайденныеСтрокиСвойств = ТаблицаСвойств.НайтиСтроки(Новый Структура("ТипОбъекта", "Товар"));

	ОбщегоНазначения.СообщитьПользователю("Загрузка товаров");
	ИнформацияТоваров = ПолучитьЭлементыПакетов(СтруктураНастроек, "Товары", "&select[]=id&select[]=iblockId&filter[iblockId]=" + ИдентификаторКаталогаТоваров, ВыбранныеПакеты);	
	Для каждого ТекЭлемент Из ИнформацияТоваров Цикл
		    
		ИдЭлемента 			= Формат(ТекЭлемент.Получить("id"),"ЧГ=0"); 
		ВнешнийКод			= ТекЭлемент.Получить("xmlId");
		Наименование 		= ТекЭлемент.Получить("name");
		ОписаниеАнонса 		= ТекЭлемент.Получить("previewText");    
		ДетальноеОписание 	= ТекЭлемент.Получить("detailText");    
		СимвольныйКод 		= ТекЭлемент.Получить("code");    
		ПризнакДоступности 	= ТекЭлемент.Получить("available");    
		ПризнакАктивности 	= ТекЭлемент.Получить("active");    
		
		МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;  
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		НоваяСтрока.СквознойНомер		= МаксимальныйСквознойНомер;
		НоваяСтрока.Ид 					= ИдЭлемента;
		НоваяСтрока.ВнешнийКод 			= ВнешнийКод;        
		НоваяСтрока.Наименование 		= Наименование;   
		НоваяСтрока.ОписаниеАнонса 		= ОписаниеАнонса;   
		НоваяСтрока.ДетальноеОписание 	= ДетальноеОписание;   
		НоваяСтрока.СимвольныйКод		= СимвольныйКод; 
		НоваяСтрока.Доступный			= ПризнакДоступности = "Y"; 
		НоваяСтрока.Активный			= ПризнакАктивности = "Y";   
		
		Для каждого ТекСвойство Из НайденныеСтрокиСвойств Цикл 
			
			ЗначениеСвойства = Неопределено;
			
			ДанныеЗначения = ТекЭлемент.Получить("property"+ТекСвойство.Ид);
			Если НЕ ДанныеЗначения = Неопределено Тогда
				ЗначениеСвойства = ДанныеЗначения.Получить("value"); 
			КонецЕсли;   
			
			Если ЗначениеСвойства = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаЗС = ТаблицаЗначенийСвойств.Добавить();
           	НоваяСтрокаЗС.ИдВладельца 	= ИдЭлемента; 
           	НоваяСтрокаЗС.ИдСвойства 	= ТекСвойство.Ид; 
           	НоваяСтрокаЗС.ТипОбъекта 	= "Товар"; 
			
			Если ТипЗнч(ЗначениеСвойства) = Тип("Число") Тогда 
				НоваяСтрокаЗС.Значение = Формат(ЗначениеСвойства,"ЧГ=0"); 
			Иначе
				НоваяСтрокаЗС.Значение = ЗначениеСвойства;	
			КонецЕсли;
			
		КонецЦикла; 
		               
	КонецЦикла; 
#КонецОбласти                   

	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер"	, МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаТоваров"				, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаТоваров));
	Результат.Вставить("ТаблицаЗначенийСвойств"		, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаЗначенийСвойств));

	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

Процедура ЗагрузитьПредложенияПоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйСквознойНомер 			= 0;
	
	ИдентификаторКаталогаПредложений 	= ПередаваемыеПараметры.ИдентификаторКаталогаПредложений;
	ТаблицаПредложений 					= ПередаваемыеПараметры.ТаблицаПредложений;
	ТаблицаСвойств 						= ПередаваемыеПараметры.ТаблицаСвойств;
	ТаблицаЗначенийСвойств 				= ПередаваемыеПараметры.ТаблицаЗначенийСвойств;  
	
	ВыбранныеПакеты 					= ПередаваемыеПараметры.ВыбранныеПакеты;  
	
#Область ЗагрузкаПредложений        
	НайденныеСтрокиСвойств = ТаблицаСвойств.НайтиСтроки(Новый Структура("ТипОбъекта", "Предложение")); 
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка предложений");     
	ИнформацияПредложений = ПолучитьЭлементыПакетов(СтруктураНастроек, "Предложения", "&select[]=id&select[]=iblockId&filter[iblockId]=" + ИдентификаторКаталогаПредложений, ВыбранныеПакеты);	
	Для каждого ТекЭлемент Из ИнформацияПредложений Цикл
		
		ИдЭлемента 			= Формат(ТекЭлемент.Получить("id"),"ЧГ=0"); 
		
		parentId		= ТекЭлемент.Получить("parentId");
		Если ТипЗнч(parentId) = Тип("Соответствие") Тогда
			ИдВладельца = Формат(parentId.Получить("value"),"ЧГ=0"); 
		Иначе
			ИдВладельца = Формат(parentId,"ЧГ=0"); 
		КонецЕсли;
		
		ВнешнийКод			= ТекЭлемент.Получить("xmlId");
		Наименование 		= ТекЭлемент.Получить("name");
		ОписаниеАнонса 		= ТекЭлемент.Получить("previewText");    
		ДетальноеОписание 	= ТекЭлемент.Получить("detailText");    
		СимвольныйКод 		= ТекЭлемент.Получить("code");                    
		ПризнакДоступности 	= ТекЭлемент.Получить("available");    
		ПризнакАктивности 	= ТекЭлемент.Получить("active");    
		
		МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;  
		
		НоваяСтрока = ТаблицаПредложений.Добавить();  
		НоваяСтрока.СквознойНомер		= МаксимальныйСквознойНомер;
		НоваяСтрока.Ид 					= ИдЭлемента;
		НоваяСтрока.ИдВладельца 		= ИдВладельца;
		НоваяСтрока.ВнешнийКод 			= ВнешнийКод;        
		НоваяСтрока.Наименование 		= Наименование;   
		НоваяСтрока.ОписаниеАнонса 		= ОписаниеАнонса;   
		НоваяСтрока.ДетальноеОписание 	= ДетальноеОписание;   
		НоваяСтрока.СимвольныйКод		= СимвольныйКод; 
		НоваяСтрока.Доступный			= ПризнакДоступности = "Y"; 
		НоваяСтрока.Активный			= ПризнакАктивности = "Y";            
		
		Для каждого ТекСвойство Из НайденныеСтрокиСвойств Цикл 
			
			ЗначениеСвойства = Неопределено;
			
			ДанныеЗначения = ТекЭлемент.Получить("property"+ТекСвойство.Ид);
			Если НЕ ДанныеЗначения = Неопределено Тогда
				ЗначениеСвойства = ДанныеЗначения.Получить("value"); 
			КонецЕсли;   
			
			Если ЗначениеСвойства = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаЗС = ТаблицаЗначенийСвойств.Добавить();
           	НоваяСтрокаЗС.ИдВладельца 	= ИдЭлемента; 
           	НоваяСтрокаЗС.ИдСвойства 	= ТекСвойство.Ид; 
           	НоваяСтрокаЗС.ТипОбъекта 	= "Предложение"; 
			
			Если ТипЗнч(ЗначениеСвойства) = Тип("Число") Тогда 
				НоваяСтрокаЗС.Значение = Формат(ЗначениеСвойства,"ЧГ=0"); 
			Иначе
				НоваяСтрокаЗС.Значение = ЗначениеСвойства;	
			КонецЕсли;
			
		КонецЦикла; 
		               
	КонецЦикла; 
#КонецОбласти                   
	 
	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер"	, МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаПредложений"			, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаПредложений));
	Результат.Вставить("ТаблицаЗначенийСвойств"		, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаЗначенийСвойств));

	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

#КонецОбласти                   


#Область СмартПроцессы

Процедура ЗагрузитьСППоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	ВыбранныеПакеты = ПередаваемыеПараметры.ВыбранныеПакеты;  
	
	мДанные = СтрРазделить(ПередаваемыеПараметры.СмартПроцесс, "#");    
	ИдВладельцаСП 	= мДанные[0]; 
	//ИдСП 			= мДанные[1]; 
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйСквознойНомер 	= 0;
	
	ТаблицаСП = ПередаваемыеПараметры.ТаблицаСП;
	
	ОбщегоНазначения.СообщитьПользователю("Загрузка элементов смарт-процесса");
	
	ИнформацияЭлементовСП = ПолучитьЭлементыПакетов(СтруктураНастроек, "Смарт-процессы", "&select[]=id", ВыбранныеПакеты, "&entityTypeId="+ИдВладельцаСП);	
	Для каждого ТекЭлемент Из ИнформацияЭлементовСП Цикл
		
		ДанныеЭлемента = ТекЭлемент.Получить("item");
		
		
		ИдЭлемента 		= Формат(ДанныеЭлемента.Получить("id"),"ЧГ=0"); 
		ВнешнийКод		= ДанныеЭлемента.Получить("xmlId");
		Наименование 	= ДанныеЭлемента.Получить("title");
		
		Если ЗначениеЗаполнено(Наименование) Тогда
			
			МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;
			НоваяСтрока = ТаблицаСП.Добавить();
			НоваяСтрока.СквознойНомер	= МаксимальныйСквознойНомер;
			НоваяСтрока.Ид 				= ИдЭлемента;
			НоваяСтрока.ВнешнийКод 		= ВнешнийКод;  
			НоваяСтрока.Наименование	= Наименование; 
			
			НоваяСтрока.ДанныеЭлемента = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеЭлемента);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер", МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаСП", Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаСП));
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

#КонецОбласти                   

#КонецЕсли