Функция РазобратьТелефоныИЕмейлКомпанийКонтактов(Телефоны, Почта)
	
	Результат = Новый Структура;
	Результат.Вставить("Телефоны"	, Новый СписокЗначений);
	Результат.Вставить("Почта"		, Новый СписокЗначений);
	
	Если Телефоны <> Неопределено Тогда
		Для Каждого ТекТелефон Из Телефоны Цикл
			
			НомерТелефона = ТекТелефон.Получить("VALUE");
			Если Не ЗначениеЗаполнено(НомерТелефона) Тогда
				Продолжить;					
			КонецЕсли;
			
			ЗаписьОТелефоне = Новый Структура;
			ЗаписьОТелефоне.Вставить("Значение", НомерТелефона);
			
			ВидТелефона = ТекТелефон.Получить("VALUE_TYPE");
			Если ВидТелефона = "WORK" Тогда
				ЗаписьОТелефоне.Вставить("Тип", "Рабочий");
			ИначеЕсли ВидТелефона = "MOBILE" Тогда 
				ЗаписьОТелефоне.Вставить("Тип", "Мобильный");
			Иначе 
				ЗаписьОТелефоне.Вставить("Тип", "Домашний");
			КонецЕсли;
			
			Результат.Телефоны.Добавить(ЗаписьОТелефоне);
			
		КонецЦикла;
	КонецЕсли;
	
	Если Почта <> Неопределено Тогда
		Для Каждого ТекПочта Из Почта Цикл
			
			АдресПочты = ТекПочта.Получить("VALUE");
			
			Если Не ЗначениеЗаполнено(АдресПочты) Тогда
				Продолжить;					
			КонецЕсли;
			
			ЗаписьОПочте = Новый Структура;
			ЗаписьОПочте.Вставить("Значение", АдресПочты);
			
			ВидПочты = ТекПочта.Получить("VALUE_TYPE");
			
			Если ВидПочты = "WORK" Тогда
				ЗаписьОПочте.Вставить("Тип", "Рабочий");
			Иначе 
				ЗаписьОПочте.Вставить("Тип", "Домашний");
			КонецЕсли;
			
			Результат.Почта.Добавить(ЗаписьОПочте);
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

