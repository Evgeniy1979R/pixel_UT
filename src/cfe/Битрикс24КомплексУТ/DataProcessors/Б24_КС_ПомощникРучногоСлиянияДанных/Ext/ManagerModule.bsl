#Область ОбщегоНазначения
	
Функция СписокПакетовЭлементов(НастройкаПодключения, РестМетод, ПараметрыМетода) Экспорт
	
	СписокПакетов = Новый СписокЗначений;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат СписокПакетов;
	КонецЕсли;
	
	ВсегоЭлементов = 0;
	
	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Получение количество элементов";
	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, РестМетод, ПараметрыМетода); 
	Если СтруктураОтвета <> Неопределено Тогда
		ВсегоЭлементов = Число(СтруктураОтвета.Получить("total"));
	КонецЕсли;    
	
	Если ВсегоЭлементов = 0 Тогда
		Возврат СписокПакетов;
	КонецЕсли;
	
	СписокПакетов = Новый СписокЗначений;
	
	ЭлементовВПакете 	= 50;
	Итератор 			= 1;
	ИтераторПакетов 	= 0;
	Пока ИтераторПакетов < ВсегоЭлементов Цикл 
		СписокПакетов.Добавить(ИтераторПакетов, Итератор); 
		
		Итератор 		= Итератор + 1;
		ИтераторПакетов = ИтераторПакетов + ЭлементовВПакете;
		
	КонецЦикла; 
	
	Возврат СписокПакетов;
	
КонецФункции

Функция ПолучитьЭлементыПакетов(СтруктураНастроек, ТипСущности, Фильтр, ВыбранныеПакеты, ДополнительныйФильтр = "")
	
	Результат = Новый Массив;
	
	Если ВыбранныеПакеты = Неопределено Тогда Возврат Результат КонецЕсли;
	
	СтруктураНастроек.Логирование.Измерение1 = "Помощник ручного слияния";
	
	Если ТипСущности = "Компании" Тогда
		Метод 		= "/rest/crm.company.list";
		СтруктураНастроек.Логирование.Измерение2 = "Получение компаний Б24";	 
	ИначеЕсли ТипСущности = "Контакты" Тогда
		Метод 		= "/rest/crm.contact.list";
		СтруктураНастроек.Логирование.Измерение2 = "Получение контактов Б24";	 
	ИначеЕсли ТипСущности = "Товары" Тогда
		Метод 		= "/rest/catalog.product.list";
		СтруктураНастроек.Логирование.Измерение2 = "Получение товаров Б24";	 
	ИначеЕсли ТипСущности = "Предложения" Тогда
		Метод 		= "/rest/catalog.product.offer.list";
		СтруктураНастроек.Логирование.Измерение2 = "Получение предложений Б24";   
	ИначеЕсли ТипСущности = "Смарт-процессы" Тогда
		Метод 		= "/rest/crm.item.list";
		СтруктураНастроек.Логирование.Измерение2 = "Получение элементов смарт-процессов Б24";   
	КонецЕсли;
	
	Для каждого ТекЭлемент Из ВыбранныеПакеты Цикл
		
		Если НЕ ТекЭлемент.Пометка Тогда
			Продолжить;	
		КонецЕсли;
		
		ТелоHTTPЗапроса = "&start="+ XMLСтрока(ТекЭлемент.Значение) + Фильтр + ДополнительныйФильтр;	
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		
		Если СтруктураОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;   
		
		РезультатОбработки = ОбработатьЭлементыПакета(СтруктураНастроек, СтруктураОтвета, ТипСущности, Результат, ДополнительныйФильтр);
		Если РезультатОбработки = Ложь Тогда	
			Возврат Результат;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

Функция ОбработатьЭлементыПакета(СтруктураНастроек, СтруктураОтвета, ТипСущности, Результат, ДополнительныйФильтр)
	
	НазваниеПараметра 	= "id";
	
	Если ТипСущности = "Компании" Тогда
		МетодBatch 	= "crm.company.get";   
		НазваниеПараметра 	= "ID";
	ИначеЕсли ТипСущности = "Контакты" Тогда
		МетодBatch 	= "crm.contact.get"; 
		НазваниеПараметра 	= "ID";
	ИначеЕсли ТипСущности = "Товары" Тогда
		МетодBatch 	= "catalog.product.get";
	ИначеЕсли ТипСущности = "Предложения" Тогда
		МетодBatch 	= "catalog.product.offer.get";   
	ИначеЕсли ТипСущности = "Смарт-процессы" Тогда
		МетодBatch 	= "crm.item.get";   
	КонецЕсли;
	
	result = СтруктураОтвета.Получить("result");
	Если result = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипСущности = "Товары" Тогда  
		ДанныеПортала = result.Получить("products");
		Если ДанныеПортала = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ТипСущности = "Предложения" Тогда
		ДанныеПортала = result.Получить("offers");
		Если ДанныеПортала = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;   
	ИначеЕсли ТипСущности = "Смарт-процессы" Тогда
		ДанныеПортала = result.Получить("items");
		Если ДанныеПортала = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;   
	Иначе       
		
		ДанныеПортала = result;
		
	КонецЕсли;  
	
	ТелоHTTPBatchЗапроса = "";
	Для каждого ТекЭлемент Из ДанныеПортала Цикл
			
		ИдЭлемента = Формат(ТекЭлемент.Получить(НазваниеПараметра), "ЧГ=0");
					
		ТелоHTTPBatchЗапроса = ТелоHTTPBatchЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодBatch + "?"+НазваниеПараметра+"=" + ИдЭлемента + ДополнительныйФильтр);
			
	КонецЦикла;
	
	СтруктураОтветаBatch = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPBatchЗапроса);
	Если СтруктураОтветаBatch = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
			
	result = СтруктураОтветаBatch.Получить("result");
	Если result = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
		
	result2 = result.Получить("result");
	Если result2 = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипСущности = "Товары" Тогда  
		Для каждого ТекЭлемент Из result2 Цикл  
			
			Если ТипЗнч(ТекЭлемент) = Тип("Соответствие") Тогда  		
				Результат.Добавить(ТекЭлемент.Получить("product"));	
			ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("КлючИЗначение") Тогда
				Результат.Добавить(ТекЭлемент.Значение.Получить("product"));	
			КонецЕсли;
			
		КонецЦикла;
	ИначеЕсли ТипСущности = "Предложения" Тогда                     
		Для каждого ТекЭлемент Из result2 Цикл   
			
			Если ТипЗнч(ТекЭлемент) = Тип("Соответствие") Тогда  		
				Результат.Добавить(ТекЭлемент.Получить("offer"));	
			ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("КлючИЗначение") Тогда
				Результат.Добавить(ТекЭлемент.Значение.Получить("offer"));	
			КонецЕсли;   
			
		КонецЦикла;
	Иначе       
		Для каждого ТекЭлемент Из result2 Цикл
			Результат.Добавить(ТекЭлемент);	
		КонецЦикла;
	КонецЕсли;  
	
	Возврат Истина;

КонецФункции

#КонецОбласти 


#Область СвойстваТоваровПредложений

Процедура ЗагрузитьСвойстваТоваровПредложенийПоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйСквознойНомер 			= 0;
	
	ИдентификаторКаталогаТоваров 		= ПередаваемыеПараметры.ИдентификаторКаталогаТоваров;
	ИдентификаторКаталогаПредложений 	= ПередаваемыеПараметры.ИдентификаторКаталогаПредложений;
	ТаблицаСвойств 						= ПередаваемыеПараметры.ТаблицаСвойств;
	ТаблицаЗначенийСвойств 				= ПередаваемыеПараметры.ТаблицаЗначенийСвойств;
	
	мТипыОбъектовЗагрузки = Новый Массив;
	мТипыОбъектовЗагрузки.Добавить("Товар");
	мТипыОбъектовЗагрузки.Добавить("Предложение");

	Для каждого ТипОбъектаЗагрузки Из мТипыОбъектовЗагрузки Цикл 
		
		ОбщегоНазначения.СообщитьПользователю("Загрузка свойств товаров и предложений");
		ИнформацияОПользПолях = ПолучитьСвойстваТоваровПредложений(СтруктураНастроек, ТипОбъектаЗагрузки, ИдентификаторКаталогаТоваров, ИдентификаторКаталогаПредложений);
		
		Для каждого ТекЭлемент Из ИнформацияОПользПолях Цикл
			
			ИдЭлемента 		= Формат(ТекЭлемент.Получить("id"),"ЧГ=0"); 
			ИдИнфоблока 	= Формат(ТекЭлемент.Получить("iblockId"),"ЧГ=0"); 
			Наименование 	= ТекЭлемент.Получить("name");
			
			Если Наименование = "MORE_PHOTO" Тогда
				Продолжить;
			КонецЕсли; 
			
			Если ТекЭлемент.Получить("multiple") = "Y" Тогда
				ОбщегоНазначения.СообщитьПользователю("Свойство: " + Наименование + " не будет добавлено/обновлено. т.к. является множественным");
				Продолжить;
			КонецЕсли;
			
			ТипЭлемента 		= ТекЭлемент.Получить("listType");    
			ТипСвойства 		= ТекЭлемент.Получить("propertyType");    
			ПользовательскийТип = ТекЭлемент.Получить("userType");    
			
			ПропуститьСвойство = Ложь;
			Если НЕ ЗначениеЗаполнено(ПользовательскийТип) Тогда   
				
				Если ТипСвойства = "S" Тогда
				ИначеЕсли ТипСвойства = "N" Тогда
				ИначеЕсли ТипСвойства = "L" Тогда
				Иначе
					ПропуститьСвойство = Истина;
				КонецЕсли;   
			
			ИначеЕсли ПользовательскийТип = "HTML" Тогда
			ИначеЕсли ПользовательскийТип = "DateTime" Тогда
			ИначеЕсли ПользовательскийТип = "Date" Тогда
			ИначеЕсли ПользовательскийТип = "BoolEnum" Тогда
			Иначе
				ПропуститьСвойство = Истина;
			КонецЕсли;
			
			Если ПропуститьСвойство Тогда
				ОбщегоНазначения.СообщитьПользователю("Свойство: " + Наименование + " не будет добавлено/обновлено. т.к. не поддерживается тип");
				Продолжить;
			КонецЕсли;
			
			МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;
			НоваяСтрока = ТаблицаСвойств.Добавить();
			НоваяСтрока.СквознойНомер		= МаксимальныйСквознойНомер;
			НоваяСтрока.ТипОбъекта          = ТипОбъектаЗагрузки;
			НоваяСтрока.Ид 					= ИдЭлемента;
			НоваяСтрока.ИдИнфоблока 		= ИдИнфоблока;
			НоваяСтрока.ВнешнийКод 			= ТекЭлемент.Получить("xmlId"); 
			НоваяСтрока.ПользовательскийТип	= ПользовательскийТип; 
			НоваяСтрока.ТипСвойства			= ТипСвойства; 
			НоваяСтрока.ТипЭлемента			= ТипЭлемента; 
			НоваяСтрока.Наименование 		= Наименование;   
			
			Если НЕ ТаблицаЗначенийСвойств = Неопределено И ТипСвойства = "L" И ТипЭлемента <> "C" Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Загрузка значений свойства:" + Наименование);      
				
				ЗначенияСвойства = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/catalog.productPropertyEnum.list", "id", "&filter[propertyId]="+ИдЭлемента, "productPropertyEnums");
				Для каждого ЗначениеСвойства Из ЗначенияСвойства Цикл           
					
					НоваяСтрокаЗначения = ТаблицаЗначенийСвойств.Добавить();
					НоваяСтрокаЗначения.Ид 			= Формат(ЗначениеСвойства.Получить("id"),"ЧГ=0");
					НоваяСтрокаЗначения.ИдВладельца	= ИдЭлемента;
					НоваяСтрокаЗначения.ИдИнфоблока	= ИдИнфоблока; 
					НоваяСтрокаЗначения.ВнешнийКод 	= ЗначениеСвойства.Получить("xmlId"); 
					НоваяСтрокаЗначения.Наименование= ЗначениеСвойства.Получить("value"); 
					НоваяСтрокаЗначения.ТипОбъекта	= ТипОбъектаЗагрузки; 
					
				КонецЦикла;   
			
			КонецЕсли;  
			
		КонецЦикла; 
		
	КонецЦикла;      
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер"	, МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаСвойств"				, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаСвойств));
	Результат.Вставить("ТаблицаЗначенийСвойств"		, ?(ТаблицаЗначенийСвойств = Неопределено, Неопределено, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаЗначенийСвойств)));
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры
 
Функция ПолучитьСвойстваТоваровПредложений(СтруктураНастроек, ТипСущности, ИдентификаторКаталогаТоваров, ИдентификаторКаталогаПредложений)
	
	Результат = Новый Массив;
	
	Фильтр 				= "&select[]=id";	
	НазваниеПараметра 	= "id";
	
	СтруктураНастроек.Логирование.Измерение1 = "Помощник ручного слияния";
	
	Если ТипСущности = "Товар" Тогда
		Метод 		= "/rest/catalog.productProperty.list";
		МетодBatch 	= "catalog.productProperty.get";
		
		Фильтр = Фильтр + "&filter[iblockId]="+ИдентификаторКаталогаТоваров; 
		СтруктураНастроек.Логирование.Измерение2 = "Получение списка свойств товаров Б24";	 
		
	ИначеЕсли ТипСущности = "Предложение" Тогда
		Метод 		= "/rest/catalog.productProperty.list";
		МетодBatch 	= "catalog.productProperty.get";
		
		Фильтр = Фильтр + "&filter[iblockId]="+ИдентификаторКаталогаПредложений; 
		СтруктураНастроек.Логирование.Измерение2 = "Получение списка свойств предложений Б24";
		
	КонецЕсли;
	
	Следующие = "Начало";  
	Пока ЗначениеЗаполнено(Следующие) Цикл
		
		Если Следующие = "Начало" Тогда
			ТелоHTTPЗапроса = Фильтр;	 
		Иначе
			Следующие = Формат(Следующие, "ЧГ=0");
			ТелоHTTPЗапроса = "&start="+Следующие + Фильтр;	 
		КонецЕсли;
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		Если СтруктураОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result = СтруктураОтвета.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		productProperties = result.Получить("productProperties");
		Если productProperties = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		ТелоHTTPBatchЗапроса = "";
		Для каждого ТекЭлемент Из productProperties Цикл
				
			ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
			ИдЭлемента = ?(ЗначениеЗаполнено(ИдЭлемента), ИдЭлемента, Формат(ТекЭлемент.Получить("id"), "ЧГ=0"));
						
			ТелоHTTPBatchЗапроса = ТелоHTTPBatchЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодBatch + "?"+НазваниеПараметра+"=" + ИдЭлемента);
				
		КонецЦикла;
		
		СтруктураОтветаBatch = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPBatchЗапроса);
		Если СтруктураОтветаBatch = Неопределено Тогда
			Прервать;
		КонецЕсли;
				
		result = СтруктураОтветаBatch.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result2 = result.Получить("result");
		Если result2 = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Для каждого ТекЭлемент Из result2 Цикл
			Результат.Добавить(ТекЭлемент.Получить("productProperty"));	
		КонецЦикла;
		
	   Следующие = СтруктураОтвета.Получить("next");
	   
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

#КонецОбласти                   


#Область СвойстваПользовательскихПолей

Процедура ЗагрузитьПользовательскиеПоляПоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МаксимальныйСквознойНомер 			= 0;
	
	ТаблицаСвойств 						= ПередаваемыеПараметры.ТаблицаСвойств;
	ТаблицаЗначенийСвойств 				= ПередаваемыеПараметры.ТаблицаЗначенийСвойств;
	
	ИспользуемыеТипыСвойствБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеТипыСвойствБитрикс24();
	
	мТипыОбъектовЗагрузки = Новый Массив;
	мТипыОбъектовЗагрузки.Добавить("Компания");
	мТипыОбъектовЗагрузки.Добавить("Контакт");
	мТипыОбъектовЗагрузки.Добавить("Счет");
	мТипыОбъектовЗагрузки.Добавить("Сделка");

	Для каждого ТипОбъектаЗагрузки Из мТипыОбъектовЗагрузки Цикл 

		ОбщегоНазначения.СообщитьПользователю("Загрузка пользовательских полей");
		ИнформацияОПользПолях 			= ПолучитьПользовательскиеПоля(СтруктураНастроек, ТипОбъектаЗагрузки);
		
		Для каждого ТекЭлемент Из ИнформацияОПользПолях Цикл
			
			ДанныеПоля = ТекЭлемент.Получить("field");
			
			ИдЭлемента = Формат(ДанныеПоля.Получить("id"),"ЧГ=0"); 
			                        
			Наименование = "";

			НаименованияНаФормах = ДанныеПоля.Получить("editFormLabel");
			Если НаименованияНаФормах <> Неопределено Тогда
				Наименование = НаименованияНаФормах.Получить(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЛокализациюБитрикс24());		
			КонецЕсли;
			
			ПользовательскийТип = ДанныеПоля.Получить("userTypeId");    
			Если ИспользуемыеТипыСвойствБитрикс24.Найти(ПользовательскийТип) = Неопределено Тогда
				ОбщегоНазначения.СообщитьПользователю("Свойство: " + Наименование + " не будет добавлено/обновлено. т.к. не поддерживается тип");
				Продолжить;
			КонецЕсли;
			
			Если ДанныеПоля.Получить("multiple") = "Y" Тогда
				ОбщегоНазначения.СообщитьПользователю("Свойство: " + Наименование + " не будет добавлено/обновлено. т.к. является множественным");
				Продолжить;
			КонецЕсли;
			
			МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;
			НоваяСтрока = ТаблицаСвойств.Добавить();
			НоваяСтрока.СквознойНомер		= МаксимальныйСквознойНомер;
			НоваяСтрока.ТипОбъекта          = ТипОбъектаЗагрузки;
			НоваяСтрока.Ид 					= ИдЭлемента;
			НоваяСтрока.ИмяПоля 			= ДанныеПоля.Получить("fieldName");
			НоваяСтрока.ВнешнийКод 			= ДанныеПоля.Получить("xmlId"); 
			НоваяСтрока.ПользовательскийТип	= ПользовательскийТип; 
			НоваяСтрока.Наименование 		= Наименование; 
			
			ЗначенияСвойств = ДанныеПоля.Получить("enum");
			Если ЗначенияСвойств <> Неопределено Тогда
				Для Каждого ТекЗначениеСвойства Из ЗначенияСвойств Цикл
					НоваяСтрокаЗначения = ТаблицаЗначенийСвойств.Добавить();
					НоваяСтрокаЗначения.Ид 			= Формат(ТекЗначениеСвойства.Получить("id"),"ЧГ=0");
					НоваяСтрокаЗначения.ИдВладельца	= ИдЭлемента;
					НоваяСтрокаЗначения.ВнешнийКод 	= ТекЗначениеСвойства.Получить("xmlId"); 
					НоваяСтрокаЗначения.Наименование= ТекЗначениеСвойства.Получить("value"); 
					НоваяСтрокаЗначения.ТипОбъекта	= ТипОбъектаЗагрузки; 
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер"	, МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаСвойств"				, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаСвойств));
	Результат.Вставить("ТаблицаЗначенийСвойств"		, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаЗначенийСвойств));
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры

Функция ПолучитьПользовательскиеПоля(СтруктураНастроек, ТипСущности)
	
	Результат = Новый Массив;
	
	Фильтр = "&moduleId=crm&select[]=id";	
	
	СтруктураНастроек.Логирование.Измерение1 = "Помощник ручного слияния";
	
	Если ТипСущности = "Компания" Тогда    
		СтруктураНастроек.Логирование.Измерение2 = "Получение списка полей компаний Б24";	
		Фильтр = Фильтр + "&filter[entityId]=CRM_COMPANY";
	ИначеЕсли ТипСущности = "Контакт" Тогда
		СтруктураНастроек.Логирование.Измерение2 = "Получение списка полей контактов Б24";
		Фильтр = Фильтр + "&filter[entityId]=CRM_CONTACT";
	ИначеЕсли ТипСущности = "Счет" Тогда
		СтруктураНастроек.Логирование.Измерение2 = "Получение списка полей счетов Б24";	  
		Фильтр = Фильтр + "&filter[entityId]=CRM_SMART_INVOICE";
	ИначеЕсли ТипСущности = "Сделка" Тогда    
		Фильтр = Фильтр + "&filter[entityId]=CRM_DEAL";
	КонецЕсли;
	
	Следующие = "Начало"; 
	Пока ЗначениеЗаполнено(Следующие) Цикл
		
		Если Следующие = "Начало" Тогда
			ТелоHTTPЗапроса = Фильтр;	 
		Иначе
			Следующие = Формат(Следующие, "ЧГ=0");
			ТелоHTTPЗапроса = Фильтр + "&start="+Следующие;	 
		КонецЕсли;
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/userfieldconfig.list", ТелоHTTPЗапроса); 
		Если СтруктураОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		result = СтруктураОтвета.Получить("result");
		Если result = Неопределено Тогда
			Прервать;
		КонецЕсли;
			
		КоличествоЭлементов 	= 0;
		ТелоHTTPBatchЗапроса 	= "";    
		
		ПоляПортала = result.Получить("fields");	
		Для каждого ТекЭлемент Из ПоляПортала Цикл
			
			Если КоличествоЭлементов = 50 Тогда 
				ОбработатьПользовательскиеПоля(СтруктураНастроек, ТелоHTTPBatchЗапроса, Результат);
				КоличествоЭлементов 	= 0;
				ТелоHTTPBatchЗапроса 	= "";    
			КонецЕсли;
			
			ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
			ИдЭлемента = ?(ЗначениеЗаполнено(ИдЭлемента), ИдЭлемента, Формат(ТекЭлемент.Получить("id"), "ЧГ=0"));
						
			ТелоHTTPBatchЗапроса = ТелоHTTPBatchЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("userfieldconfig.get?moduleId=crm&id=" + ИдЭлемента);
		
			КоличествоЭлементов = КоличествоЭлементов + 1;
		
		КонецЦикла;
		
		Если КоличествоЭлементов > 0 Тогда
			ОбработатьПользовательскиеПоля(СтруктураНастроек, ТелоHTTPBatchЗапроса, Результат);    
		КонецЕсли;
		
	   Следующие = СтруктураОтвета.Получить("next");
	   
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

Процедура ОбработатьПользовательскиеПоля(СтруктураНастроек, ТелоHTTPBatchЗапроса, Результат)
	
	СтруктураОтветаBatch = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPBatchЗапроса);
	Если СтруктураОтветаBatch = Неопределено Тогда
		Возврат;
	КонецЕсли;
			
	result = СтруктураОтветаBatch.Получить("result");
	Если result = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	result2 = result.Получить("result");
	Если result2 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ТекЭлемент Из result2 Цикл
		Результат.Добавить(ТекЭлемент);	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 


#Область КомпанииКонтакты   

Процедура ЗагрузитьКомпанииКонтактыПоФоновомуЗаданию(ПередаваемыеПараметры, АдресРезультата = Неопределено) Экспорт
	
	ТипДанных 				= ПередаваемыеПараметры.ТипДанных;
	ВыбранныеПакеты 		= ПередаваемыеПараметры.ВыбранныеПакеты;       
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;    
	
	Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоЭлементов 		= 0;
	МаксимальныйСквознойНомер 	= 0;
	
	ТаблицаКомпаний 			= ПередаваемыеПараметры.ТаблицаКомпаний;
	ТаблицаКонтактов 			= ПередаваемыеПараметры.ТаблицаКонтактов;
	ТаблицаРеквизитов 			= ПередаваемыеПараметры.ТаблицаРеквизитов;
	ТаблицаСчетов 				= ПередаваемыеПараметры.ТаблицаСчетов;
	
	
#Область ЗагрузкаКомпаний
	Если ТипДанных = "Компании" Тогда
	
		ОбщегоНазначения.СообщитьПользователю("Загрузка компаний");
		ИнформацияКомпаний = ПолучитьЭлементыПакетов(СтруктураНастроек, "Компании", "&select[]=ID", ВыбранныеПакеты);
		Для каждого ТекЭлемент Из ИнформацияКомпаний Цикл
			
			КоличествоЭлементов 		= КоличествоЭлементов + 1;
			МаксимальныйСквознойНомер 	= МаксимальныйСквознойНомер + 1;
			
			НоваяСтрока = ТаблицаКомпаний.Добавить();
			НоваяСтрока.СквознойНомер		= МаксимальныйСквознойНомер;
			НоваяСтрока.Ид 					= Формат(ТекЭлемент.Получить("ID"),"ЧГ=0");
			НоваяСтрока.ВнешнийКод 			= ТекЭлемент.Получить("ORIGIN_ID"); 
			НоваяСтрока.ЗаголовокКомпании 	= Строка(ТекЭлемент.Получить("TITLE"));
			НоваяСтрока.ЭтоНашаКомпания 	= ТекЭлемент.Получить("IS_MY_COMPANY")="Y";
			
			Телефоны 		= ТекЭлемент.Получить("PHONE");
			Почта 			= ТекЭлемент.Получить("EMAIL");
			ИнформацияКИ 	= РазобратьТелефоныИЕмейлКомпанийКонтактов(Телефоны, Почта);		
			НоваяСтрока.Телефоны 	= ИнформацияКИ.Телефоны;
			НоваяСтрока.Почта 		= ИнформацияКИ.Почта; 
		
		КонецЦикла;        
		
		ОбщегоНазначения.СообщитьПользователю("Загрузка реквизитов компаний");
		ИнформацияОРеквизитахКомпаний 	= ПолучитьРеквизитыКомпанийКонтактов(СтруктураНастроек, "4", ИнформацияКомпаний);
		Для каждого ТекЭлемент Из ИнформацияОРеквизитахКомпаний Цикл 
			
			КоличествоЭлементов = КоличествоЭлементов + 1;
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			НоваяСтрока.Ид 					= Формат(ТекЭлемент.Получить("ID"),"ЧГ=0");
			НоваяСтрока.ИдВладельца 		= Формат(ТекЭлемент.Получить("ENTITY_ID"),"ЧГ=0");
			НоваяСтрока.ТипВладельца 		= Строка(ТекЭлемент.Получить("ENTITY_TYPE_ID"));
			НоваяСтрока.ВнешнийКод 			= ТекЭлемент.Получить("XML_ID"); 
			НоваяСтрока.Активный 			= ТекЭлемент.Получить("ACTIVE") = "Y";
			НоваяСтрока.ИНН 				= Строка(ТекЭлемент.Получить("RQ_INN"));
			НоваяСтрока.КПП 				= Строка(ТекЭлемент.Получить("RQ_KPP"));
			
			Фамилия 	= Строка(ТекЭлемент.Получить("RQ_LAST_NAME")); 
			Имя 		= Строка(ТекЭлемент.Получить("RQ_FIRST_NAME")); 
			Отчество	= Строка(ТекЭлемент.Получить("RQ_SECOND_NAME")); 
			ФИО			= Фамилия + " " + Имя + " " + Отчество; 
			
			Наименование 		= Строка(ТекЭлемент.Получить("RQ_COMPANY_NAME"));
			Наименование		= ?(ЗначениеЗаполнено(Наименование), Наименование, ФИО);
			НаименованиеПолное 	= Строка(ТекЭлемент.Получить("RQ_COMPANY_FULL_NAME"));
			НаименованиеПолное	= ?(ЗначениеЗаполнено(НаименованиеПолное), НаименованиеПолное, Наименование);
			
			НоваяСтрока.Наименование 		= Наименование;
			НоваяСтрока.НаименованиеПолное 	= НаименованиеПолное;    
			
		КонецЦикла;    
		
		ОбщегоНазначения.СообщитьПользователю("Загрузка банк. счетов реквизитов компаний");
		ИнформацияОСчетахКомпаний 		= ПолучитьСчетаКомпанийКонтактов(СтруктураНастроек, "4", ИнформацияОРеквизитахКомпаний);
		Для каждого ТекЭлемент Из ИнформацияОСчетахКомпаний Цикл  
			
			КоличествоЭлементов = КоличествоЭлементов + 1;
			
			НоваяСтрока = ТаблицаСчетов.Добавить();
			НоваяСтрока.Ид 					= Формат(ТекЭлемент.Получить("ID"),"ЧГ=0");
			НоваяСтрока.ИдВладельца 		= Формат(ТекЭлемент.Получить("ENTITY_ID"),"ЧГ=0");
			НоваяСтрока.ВнешнийКод 			= ТекЭлемент.Получить("XML_ID"); 
			НоваяСтрока.НомерСчета 			= Строка(ТекЭлемент.Получить("RQ_ACC_NUM")); 
			НоваяСтрока.БИК 				= Строка(ТекЭлемент.Получить("RQ_BIK"));   
			
		КонецЦикла;    
		
		
	КонецЕсли;
#КонецОбласти

#Область ЗагрузкаКомпаний
	Если ТипДанных = "Контакты" Тогда

		ОбщегоНазначения.СообщитьПользователю("Загрузка контактов");
		ИнформацияКонтактов = ПолучитьЭлементыПакетов(СтруктураНастроек, "Контакты", "&select[]=ID", ВыбранныеПакеты);
		Для каждого ТекЭлемент Из ИнформацияКонтактов Цикл
		
			ИдКомпании = Формат(ТекЭлемент.Получить("COMPANY_ID"),"ЧГ=0");
			
			КоличествоЭлементов = КоличествоЭлементов + 1;
			
			Если НЕ ЗначениеЗаполнено(ИдКомпании) Тогда
				МаксимальныйСквознойНомер = МаксимальныйСквознойНомер + 1;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаКонтактов.Добавить();
			НоваяСтрока.СквознойНомер	= МаксимальныйСквознойНомер;
			НоваяСтрока.Ид 				= Формат(ТекЭлемент.Получить("ID"),"ЧГ=0");
			НоваяСтрока.ВнешнийКод 		= ТекЭлемент.Получить("ORIGIN_ID"); 
			НоваяСтрока.ИдКомпании 		= Формат(ТекЭлемент.Получить("COMPANY_ID"),"ЧГ=0");
			
			НоваяСтрока.Имя 			= Строка(ТекЭлемент.Получить("NAME"));
			НоваяСтрока.Фамилия 		= Строка(ТекЭлемент.Получить("LAST_NAME"));
			НоваяСтрока.Отчество 		= Строка(ТекЭлемент.Получить("SECOND_NAME"));
			
			НоваяСтрока.Должность 		= Строка(ТекЭлемент.Получить("POST"));
		
			Телефоны 		= ТекЭлемент.Получить("PHONE");
			Почта 			= ТекЭлемент.Получить("EMAIL");
			ИнформацияКИ 	= РазобратьТелефоныИЕмейлКомпанийКонтактов(Телефоны, Почта);		
			НоваяСтрока.Телефоны 	= ИнформацияКИ.Телефоны;
			НоваяСтрока.Почта 		= ИнформацияКИ.Почта;
		
		КонецЦикла;

		ОбщегоНазначения.СообщитьПользователю("Загрузка реквизитов контактов");
		ИнформацияОРеквизитахКонтактов 	= ПолучитьРеквизитыКомпанийКонтактов(СтруктураНастроек, "3", ИнформацияКонтактов);
		Для каждого ТекЭлемент Из ИнформацияОРеквизитахКонтактов Цикл  
			
			КоличествоЭлементов = КоличествоЭлементов + 1;
			
			НоваяСтрока = ТаблицаРеквизитов.Добавить();
			НоваяСтрока.Ид 					= Формат(ТекЭлемент.Получить("ID"),"ЧГ=0");
			НоваяСтрока.ИдВладельца 		= Формат(ТекЭлемент.Получить("ENTITY_ID"),"ЧГ=0");
			НоваяСтрока.ТипВладельца 		= Строка(ТекЭлемент.Получить("ENTITY_TYPE_ID"));
			НоваяСтрока.ВнешнийКод 			= ТекЭлемент.Получить("XML_ID"); 
			НоваяСтрока.Активный 			= ТекЭлемент.Получить("ACTIVE") = "Y";
			НоваяСтрока.ИНН 				= Строка(ТекЭлемент.Получить("RQ_INN"));
			НоваяСтрока.КПП 				= Строка(ТекЭлемент.Получить("RQ_KPP"));
			
			Фамилия 	= Строка(ТекЭлемент.Получить("RQ_LAST_NAME")); 
			Имя 		= Строка(ТекЭлемент.Получить("RQ_FIRST_NAME")); 
			Отчество	= Строка(ТекЭлемент.Получить("RQ_SECOND_NAME")); 
			ФИО			= Фамилия + " " + Имя + " " + Отчество; 
			
			Наименование		= ФИО;
			Наименование		= ?(ЗначениеЗаполнено(Наименование), Наименование, Строка(ТекЭлемент.Получить("RQ_NAME")));
			
			НоваяСтрока.Наименование 		= Наименование;
			НоваяСтрока.НаименованиеПолное 	= Наименование;  
			
		КонецЦикла;  
		
		ОбщегоНазначения.СообщитьПользователю("Загрузка банк. счетов реквизитов контактов");
		ИнформацияОСчетахКонтактов 		= ПолучитьСчетаКомпанийКонтактов(СтруктураНастроек, "3", ИнформацияОРеквизитахКонтактов);
		Для каждого ТекЭлемент Из ИнформацияОСчетахКонтактов Цикл 
			
			КоличествоЭлементов = КоличествоЭлементов + 1;
			
			НоваяСтрока = ТаблицаСчетов.Добавить();
			НоваяСтрока.Ид 					= Формат(ТекЭлемент.Получить("ID"),"ЧГ=0");
			НоваяСтрока.ИдВладельца 		= Формат(ТекЭлемент.Получить("ENTITY_ID"),"ЧГ=0");
			НоваяСтрока.ВнешнийКод 			= ТекЭлемент.Получить("XML_ID"); 
			НоваяСтрока.НомерСчета 			= Строка(ТекЭлемент.Получить("RQ_ACC_NUM")); 
			НоваяСтрока.БИК 				= Строка(ТекЭлемент.Получить("RQ_BIK")); 
			
		КонецЦикла; 
		
	КонецЕсли;
#КонецОбласти
	
	Результат = Новый Структура;
	Результат.Вставить("МаксимальныйСквознойНомер"	, МаксимальныйСквознойНомер);
	Результат.Вставить("ТаблицаКомпаний"			, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаКомпаний));
	Результат.Вставить("ТаблицаКонтактов"			, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаКонтактов));
	Результат.Вставить("ТаблицаРеквизитов"			, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаРеквизитов));
	Результат.Вставить("ТаблицаСчетов"				, Б24_К_ОбщегоНазначенияВызовСервера.ПреобразоватьТаблицуВМассив(ТаблицаСчетов));
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);

КонецПроцедуры  

Функция ПолучитьРеквизитыКомпанийКонтактов(СтруктураНастроек,ТипРеквизита, МассивВладельцев)
	
	Результат = Новый Массив;
	
	СтруктураНастроек.Логирование.Измерение1 = "Помощник ручного слияния";
	Если ТипРеквизита = "4" Тогда
		СтруктураНастроек.Логирование.Измерение2 = "Получение реквизитов компаний Б24";	
	Иначе
		СтруктураНастроек.Логирование.Измерение2 = "Получение реквизитов контактов Б24";	
	КонецЕсли;
	
	МетодBatch 			= "crm.requisite.list";
	
	Итератор 			 = 0;
	ТелоHTTPBatchЗапроса = "";
	
	Для каждого ТекЭлемент Из МассивВладельцев Цикл
		
		Итератор	= Итератор + 1;
		
		ИдЭлемента	= Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
		ИдЭлемента 	= ?(ЗначениеЗаполнено(ИдЭлемента), ИдЭлемента, Формат(ТекЭлемент.Получить("id"), "ЧГ=0"));
		
		ТелоHTTPBatchЗапроса = ТелоHTTPBatchЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодBatch + "?filter[ENTITY_ID]=" + ИдЭлемента + "&filter[ENTITY_TYPE_ID]=" + ТипРеквизита + "&start=-1");
		
		Если Итератор = 50 Тогда
			
			СтруктураОтветаBatch = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPBatchЗапроса);
					
			Если СтруктураОтветаBatch = Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
					
			result = СтруктураОтветаBatch.Получить("result");
			Если result = Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
				
			result2 = result.Получить("result");
			Если result2 = Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
			
			Для каждого ТекЭлементМассива Из result2 Цикл
				Для каждого ТекЭлемент Из ТекЭлементМассива Цикл
					Результат.Добавить(ТекЭлемент);	
				КонецЦикла;
			КонецЦикла;
					
			Итератор 			 = 0;
			ТелоHTTPBatchЗапроса = "";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ	ТелоHTTPBatchЗапроса = "" Тогда
			
		СтруктураОтветаBatch = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPBatchЗапроса);
		
		Если СтруктураОтветаBatch = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		result = СтруктураОтветаBatch.Получить("result");
		Если result = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		result2 = result.Получить("result");
		Если result2 = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		
		Для каждого ТекЭлементМассива Из result2 Цикл
			Для каждого ТекЭлемент Из ТекЭлементМассива Цикл
				Результат.Добавить(ТекЭлемент);	
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

