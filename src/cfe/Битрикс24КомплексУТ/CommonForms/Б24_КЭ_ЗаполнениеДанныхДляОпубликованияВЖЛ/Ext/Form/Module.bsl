

#Область ОбработчикиСобытийФормы

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТабличныйДокумент 	= Параметры.ТабличныйДокумент;
	НаименованиеОбъекта = Параметры.НаименованиеОбъекта; 
	ТипОбъекта			= Параметры.ТипОбъекта; 
    НастройкаПодключения= Параметры.НастройкаПодключения;
	
	ОбъектыОтправки.ЗагрузитьЗначения(Параметры.ОбъектыОтправки);
		
	АдресПортала = НастройкаПодключения.Портал;
	
	Заголовок = Заголовок + ": " + АдресПортала; 
	
	
	НоваяСтрокаВсеПользователи = ВыбранныеЭлементы.Добавить();
	НоваяСтрокаВсеПользователи.Тип 				= "Все пользователи";
	НоваяСтрокаВсеПользователи.Идентификатор 	= "Все пользователи";
	НоваяСтрокаВсеПользователи.Наименование 	= "Все пользователи";
	
	Если ТипОбъекта = "Документ" Тогда
		
		ТекстСообщения = "Отправлено из 1С в Битрикс24. Печатная форма сформирована " + Формат(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса(),"ДЛФ=DDT");
		Элементы.Инфо3.Заголовок = "Печатная форма будет приложена к публикации в виде файла в формате pdf";
		
	ИначеЕсли ТипОбъекта = "Отчет" Тогда
		
		ТекстСообщения = "Отправлено из 1С в Битрикс24. Отчет сформирован " + Формат(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса(),"ДЛФ=DDT");
		Элементы.Инфо3.Заголовок = "Отчет будет приложен к публикации в виде файла в формате pdf";	
		
	КонецЕсли;
	                                
	тзнСпискаПользователейИГрупп = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("КЭ_ИндивидСохраненныеНастройки", "СохраненныйСписокПользователейИГрупп");
	
	Если ЗначениеЗаполнено(тзнСпискаПользователейИГрупп) Тогда 
	
		ВыбранныеЭлементы.Загрузить(тзнСпискаПользователейИГрупп.Получить());
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ
&НаКлиенте
Процедура ДобавитьПользователей(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	
	ОткрытьФорму("РегистрСведений.Б24_К_ПользователиБитрикс24.Форма.ФормаСписка", ПараметрыФормы, ЭтотОбъект,,,, Новый ОписаниеОповещения("ВыполнитьПослеВыбораПользователей", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораПользователей(Результат, ДополнительныеПараметры) Экспорт
    
    ОтветФормы = Результат;
    
    Если ОтветФормы <> Неопределено Тогда
		
		ДобавитьЭлементыВТаблицуВыбора("Пользователь", ОтветФормы);
		
    КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьГруппы(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПараметрыФормы.Вставить("ТипДанных"				, "Группы");
	
	ОткрытьФорму("РегистрСведений.Б24_К_ОтделыГруппыБитрикс24.Форма.ФормаСписка", ПараметрыФормы, ЭтотОбъект,,,, Новый ОписаниеОповещения("ВыполнитьПослеВыбораГрупп", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораГрупп(Результат, ДополнительныеПараметры) Экспорт
    
    ОтветФормы = Результат;
    
    Если ОтветФормы <> Неопределено Тогда
		
		ДобавитьЭлементыВТаблицуВыбора("Группа", ОтветФормы)
		
    КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьОтделы(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПараметрыФормы.Вставить("ТипДанных"				, "Отделы");
	ОткрытьФорму("РегистрСведений.Б24_К_ОтделыГруппыБитрикс24.Форма.ФормаСписка", ПараметрыФормы, ЭтотОбъект,,,, Новый ОписаниеОповещения("ВыполнитьПослеВыбораОтделов", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораОтделов(Результат, ДополнительныеПараметры) Экспорт
    
    ОтветФормы = Результат;
    
    Если ОтветФормы <> Неопределено Тогда
		
		ДобавитьЭлементыВТаблицуВыбора("Отдел", ОтветФормы)
		
    КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура Закончить(Команда)
	Закрыть(ЗакончитьВыборНаСервере());
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
&НаСервере
Функция ЗакончитьВыборНаСервере()
	
	СохраненныеНастройки = Новый Структура;
	СохраненныеНастройки.Вставить("ТипОбъекта"			, ТипОбъекта);	
	СохраненныеНастройки.Вставить("НаименованиеОбъекта"	, НаименованиеОбъекта);	
	СохраненныеНастройки.Вставить("СохраненныйСписокПользователейИГрупп", Новый ХранилищеЗначения(ВыбранныеЭлементы.Выгрузить()));	
	
	Б24_К_ОбщегоНазначенияВызовСервера.УстановитьЗначениеВХранилищаНастроек("КЭ_ИндивидСохраненныеНастройки", СохраненныеНастройки);
	
	мПользователи 	= Новый Массив;
	мГруппы 		= Новый Массив;
	мОтделы			= Новый Массив;
	
	Для Каждого ТекСтрока Из ВыбранныеЭлементы Цикл
		
		Если ТекСтрока.Тип = "Группа" Тогда
			мГруппы.Добавить(ТекСтрока.Идентификатор);	
		ИначеЕсли ТекСтрока.Тип = "Отдел" Тогда
			мОтделы.Добавить(ТекСтрока.Идентификатор);	
		Иначе
			мПользователи.Добавить(ТекСтрока.Идентификатор);	
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстСообщения"		, ТекстСообщения);
	ПараметрыФормы.Вставить("ОбъектыОтправки"		, ОбъектыОтправки.ВыгрузитьЗначения());
	ПараметрыФормы.Вставить("ТабличныйДокумент"		, ТабличныйДокумент);
	ПараметрыФормы.Вставить("НаименованиеОбъекта"	, НаименованиеОбъекта);
	ПараметрыФормы.Вставить("ТипОбъекта"			, ТипОбъекта);
	ПараметрыФормы.Вставить("Пользователи"			, мПользователи);
	ПараметрыФормы.Вставить("Группы"				, мГруппы);
	ПараметрыФормы.Вставить("Отделы"				, мОтделы);
	
	Возврат ПараметрыФормы;
	 
КонецФункции

&НаСервере
Процедура ДобавитьЭлементыВТаблицуВыбора(Тип, ОтветФормы)
	
	Для каждого ТекСтрока Из ОтветФормы Цикл
		
		НовСтрока = ВыбранныеЭлементы.Добавить();
		
		НовСтрока.Тип 			= Тип;
		НовСтрока.Идентификатор = ТекСтрока.Значение;
		НовСтрока.Наименование 	= ТекСтрока.Представление;
		
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти



