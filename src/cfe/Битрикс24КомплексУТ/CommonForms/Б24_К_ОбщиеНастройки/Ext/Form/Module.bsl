&НаКлиенте
Процедура ЗадатьВопросОВыгрузкеНастроекПодключения()
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения();
	
	Если КоличествоНастроек > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОВыгрузкеНастроекПодключения", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, "Для принятия изменений нужно перевыгрузить настройки подключения в Битрикс24. Перевыгрузить?", Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОВыгрузкеНастроекПодключения(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	НастройкиПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьМассивНастроекПодключения();

	Для каждого ТекНастройкаВзаимодействия Из НастройкиПодключения Цикл
		
		ОтключитьОтБитрикс24(ТекНастройкаВзаимодействия);
		
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ТекстСообщения             = "Выполняется выгрузка настроек..";
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
		ПараметрыОжидания.ВыводитьОкноОжидания       = Истина;
		ПараметрыОжидания.ВыводитьСообщения          = Истина;
		
		ДлительнаяОперация = НачатьВыгрузкуНастройки(ТекНастройкаВзаимодействия);
		
		Если ДлительнаяОперация <> Ложь Тогда
			ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, , ПараметрыОжидания);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НачатьВыгрузкуНастройки(НастройкаПодключения)
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	
	Если СтруктураНастроек = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось подключиться к Битрикс24");
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураНастроек.Логирование.Измерение2 = "Выгрузка настроек для настройки подключения";
	
	УникальныйИдентификаторЗадания = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификаторЗадания);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выгрузка настроек Битрикс24";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПараметрыВыгрузки.Вставить("Наименование"			, Строка(НастройкаПодключения));
	ПараметрыВыгрузки.Вставить("СтруктураНастроек"		, СтруктураНастроек);
		
	Возврат ДлительныеОперации.ВыполнитьВФоне("Б24_К_ОбщегоНазначенияВызовСервера.ВыгрузитьВсеНастройкиНаПортал", ПараметрыВыгрузки, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура УдалениеЗаписейЛоговОбщая(Команда)
	
	Если Команда.Имя = "УдалитьЗаписиЛога" Тогда
		ЭтоЛог = 1;
		ТекстЛога = "лог";
	ИначеЕсли Команда.Имя = "УдалитьЗаписиЛогаИИ" Тогда
		ЭтоЛог = 2;
		ТекстЛога = "лог ИИ";
	Иначе
		ЭтоЛог = 3;
		ТекстЛога = "Ошибки";
	КонецЕсли;
	
	ДатаНапоминания = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса() - 60*60*24*7;
	Подсказка = "Введите дату, по которую будет удален " + ТекстЛога;
	ЧастьДаты = ЧастиДаты.Дата;
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ЭтоЛог",ЭтоЛог);
	Оповещение = Новый ОписаниеОповещения("ПослеВводаДатыУдаленияЛогов", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВводДаты(Оповещение, ДатаНапоминания, Подсказка, ЧастьДаты);
	
КонецПроцедуры                                           

&НаКлиенте
Процедура ПослеВводаДатыУдаленияЛогов(Дата, ПараметрыОповещения) Экспорт
    Если НЕ Дата = Неопределено Тогда
		УдалениеЛога(Дата,ПараметрыОповещения.ЭтоЛог);
		ПроверитьЗаполненияЖурналов();
    КонецЕсли;
КонецПроцедуры   

&НаСервереБезКонтекста
Процедура УдалениеЛога(Дата,ЭтоЛог)
	Если ЭтоЛог = 1 Тогда
		РегистрыСведений.Б24_К_Логирование.УдалениеЛогаСервер(Дата); 
	ИначеЕсли ЭтоЛог = 2 Тогда
		РегистрыСведений.Б24_К_ЛогиИИ.УдалениеЛогаСервер(Дата);
	Иначе
		РегистрыСведений.Б24_К_ЖурналОшибок.УдалитьЗаписиСервер(Дата);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНастройкуРасписанияОповещенияОбОшибках()

	Если ТипЗнч(РасписаниеРегламентногоЗаданияОповещенияОбОшибках) <> Тип("РасписаниеРегламентногоЗадания") Тогда
		РасписаниеРегламентногоЗаданияОповещенияОбОшибках = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;

	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеРегламентногоЗаданияОповещенияОбОшибках);

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьИзменятьРасписаниеОповещенияОбОшибках", ЭтотОбъект);

	Диалог.Показать(ОписаниеОповещения);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьИзменятьРасписаниеОповещенияОбОшибках(РасписаниеЗадания,	ДополнительныеПараметры) Экспорт

	Если РасписаниеЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РасписаниеРегламентногоЗаданияОповещенияОбОшибках = РасписаниеЗадания;
	
	СохранитьРасписаниеРегламентногоЗаданияОповещенииОбОшибках();
	
	УстановитьНадписьРасписанияОповещенияОбОшибках();

КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюОРегламентномЗаданииОповещенииОбОшибках()
	
УстановитьПривилегированныйРежим(Истина); //Для возможности всем пользователям с правами устанавливать расписания
	ИменаИспользуемыхРеглЗаданий = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИменаИспользуемыхРеглЗаданий.РассылкаПисемСОшибками);		
	Если ОбщегоНазначения.РазделениеВключено() Тогда		
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);			
	КонецЕсли;	
	
	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);	
	Если НайденныеРеглЗадания.Количество() > 0 Тогда	
		РасписаниеРегламентногоЗаданияОповещенияОбОшибках = НайденныеРеглЗадания[0].Расписание
	Иначе
		РасписаниеРегламентногоЗаданияОповещенияОбОшибках = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры

&НаСервере
Процедура СохранитьРасписаниеРегламентногоЗаданияОповещенииОбОшибках()
		
	ИменаИспользуемыхРеглЗаданий 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();
	СтруктураРеглЗаданий 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеРеглЗадания();	
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Возврат;
	КонецЕсли;
	
УстановитьПривилегированныйРежим(Истина); //Для возможности всем пользователям с правами устанавливать расписания	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИменаИспользуемыхРеглЗаданий.РассылкаПисемСОшибками);		
	Если ОбщегоНазначения.РазделениеВключено() Тогда		
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);			
	КонецЕсли;	
	
	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);	
	
	ПараметрыЗапуска = Новый Массив();
	ПараметрыЗапуска.Добавить(СтруктураРеглЗаданий.РассылкаПисемСОшибками);
	ПараметрыЗапуска.Добавить(Неопределено);
	
	Если НайденныеРеглЗадания.Количество() = 0 Тогда	
		
		Если ОповещатьООшибкахНаПочту Тогда			
			
			ПараметрыЗадания = Новый Структура();
			ПараметрыЗадания.Вставить("Метаданные"					, Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
			ПараметрыЗадания.Вставить("Наименование"				, ИменаИспользуемыхРеглЗаданий.РассылкаПисемСОшибками);
			ПараметрыЗадания.Вставить("Ключ"						, ИменаИспользуемыхРеглЗаданий.РассылкаПисемСОшибками);
			ПараметрыЗадания.Вставить("Использование"				, Истина);
			ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение"	, Ложь);
			ПараметрыЗадания.Вставить("Параметры"					, ПараметрыЗапуска);
			ПараметрыЗадания.Вставить("Расписание"					, РасписаниеРегламентногоЗаданияОповещенияОбОшибках);		
			ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
			ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);
			
			РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);	
		
		КонецЕсли;
		
	Иначе
	
		ПараметрыИзмененияЗадания = Новый Структура();
		ПараметрыИзмененияЗадания.Вставить("Использование"	, Истина);
		ПараметрыИзмененияЗадания.Вставить("Параметры"		, ПараметрыЗапуска);
		ПараметрыИзмененияЗадания.Вставить("Расписание"		, РасписаниеРегламентногоЗаданияОповещенияОбОшибках);
		ПараметрыИзмененияЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
		ПараметрыИзмененияЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);		
		
		Если ОповещатьООшибкахНаПочту Тогда
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
		Иначе
			ПараметрыИзмененияЗадания.Использование = Ложь;
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
		КонецЕсли;
		
	КонецЕсли;
УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРасписаниеОчисткиИсторииСинхронизации()

	РегистрыСведений.Б24_К_Логирование.СохранитьРасписаниеОчисткиИсторииСинхронизации(ОбрезатьИсториюОбменов, ВидПериодаУдаленияИстории);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРасписаниеКонтроляСопоставленияПользователей()
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаИспользуемыхРеглЗаданий 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();
	СтруктураРеглЗаданий 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеРеглЗадания();	
	
УстановитьПривилегированныйРежим(Истина); //Для возможности всем пользователям с правами устанавливать расписания	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИменаИспользуемыхРеглЗаданий.КонтрольСП);		
	Если ОбщегоНазначения.РазделениеВключено() Тогда		
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);			
	КонецЕсли;	
	
	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);	
	
	ПараметрыЗапуска = Новый Массив();
	ПараметрыЗапуска.Добавить(СтруктураРеглЗаданий.КонтрольСП);
	ПараметрыЗапуска.Добавить(Неопределено);
	
	
	РасписаниеРегламентногоЗаданияКонтроляСП = Новый РасписаниеРегламентногоЗадания;
	РасписаниеРегламентногоЗаданияКонтроляСП.ПериодПовтораДней = 1;
	РасписаниеРегламентногоЗаданияКонтроляСП.ПериодНедель = 1;
	
	ДниРасписания = Новый Массив;
	ДниРасписания.Добавить(1);
	ДниРасписания.Добавить(2);
	ДниРасписания.Добавить(3);
	ДниРасписания.Добавить(4);
	ДниРасписания.Добавить(5);
	ДниРасписания.Добавить(6);
	ДниРасписания.Добавить(7);
	
	РасписаниеРегламентногоЗаданияКонтроляСП.ДниНедели = ДниРасписания;
	
	РасписаниеРегламентногоЗаданияКонтроляСП.ВремяНачала = Дата("00010101") + 60*60*4;      
	
	Если НайденныеРеглЗадания.Количество() = 0 Тогда	
		
		Если КонтролироватьСопоставлениеПользователей Тогда			
			
			ПараметрыЗадания = Новый Структура();
			ПараметрыЗадания.Вставить("Метаданные"					, Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
			ПараметрыЗадания.Вставить("Наименование"				, ИменаИспользуемыхРеглЗаданий.КонтрольСП);
			ПараметрыЗадания.Вставить("Ключ"						, ИменаИспользуемыхРеглЗаданий.КонтрольСП);
			ПараметрыЗадания.Вставить("Использование"				, Истина);
			ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение"		, Ложь);
			ПараметрыЗадания.Вставить("Параметры"					, ПараметрыЗапуска);
			ПараметрыЗадания.Вставить("Расписание"					, РасписаниеРегламентногоЗаданияКонтроляСП);		
			ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
			ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);
			
			РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);	
		
		КонецЕсли;
		
	Иначе
	
		ПараметрыИзмененияЗадания = Новый Структура();
		ПараметрыИзмененияЗадания.Вставить("Использование"	, Истина);
		ПараметрыИзмененияЗадания.Вставить("Параметры"		, ПараметрыЗапуска);
		ПараметрыИзмененияЗадания.Вставить("Расписание"		, РасписаниеРегламентногоЗаданияКонтроляСП);
		ПараметрыИзмененияЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
		ПараметрыИзмененияЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);		
		
		Если КонтролироватьСопоставлениеПользователей И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
		Иначе
			ПараметрыИзмененияЗадания.Использование = Ложь;
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
		КонецЕсли;
		
	КонецЕсли;
УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеЭлементовФормы()
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Элементы.СпособВзаимодействияСБитрикс24.Доступность = Ложь;	
		СпособВзаимодействияСБитрикс24 = "Через http-сервисы";
	КонецЕсли;
	
	Элементы.ГруппаИдентификацияВ1С.Видимость = СпособВзаимодействияСБитрикс24 = "Через http-сервисы"; 
	
	Элементы.ЗапускатьВРежимеРабочегоСтола.Видимость 	= ВебАдрес1С <> "<Введите https адрес информационной базы 1С на веб-сервере>" И ЗначениеЗаполнено(ВебАдрес1С);
	Элементы.ГруппаЗапуск.Видимость 					= ВебАдрес1С <> "<Введите https адрес информационной базы 1С на веб-сервере>" И ЗначениеЗаполнено(ВебАдрес1С);
	
	Элементы.ОповещающиесяПользователи1С.Видимость 			= ОповещатьООшибкахПользователей1С;
	
	Элементы.УчетнаяЗаписьЭлектроннойПочты.Видимость 		= ОповещатьООшибкахНаПочту;
	Элементы.ГруппаРасписаниеОповещенияОбОшибках.Видимость 	= ОповещатьООшибкахНаПочту;
	Элементы.ЭлектронныеПочтыПолучатели.Видимость 			= ОповещатьООшибкахНаПочту;
	
	Элементы.АдресЗапросаНаВнешнийСервис.Видимость 			= ДелатьЗапросНаВнешнийСервис;
	Элементы.ДекорацияОповещениеВнешнегоСервиса.Видимость 	= ДелатьЗапросНаВнешнийСервис;
	
	Элементы.ГруппаОповещениеПользователей1СПраво.Видимость = ХранитьИнформациюОбОшибках;
	Элементы.ОбщаяГруппаОповещениеПоПочте.Видимость 		= ХранитьИнформациюОбОшибках;
	
	Элементы.ОтветственныеЗаКонтрольСопоставленияПользователей.Видимость = КонтролироватьСопоставлениеПользователей;
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Элементы.ГруппаРасписаниеОповещенияОбОшибках.Видимость = Ложь;         
		Элементы.ГруппаКонтрольСопоставленияПользователей.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаХраненияИсторииВзаимодействия.Видимость 	= ХранитьИсториюВзаимодействия;
	
	Элементы.ЧислоХраненияИстории.Видимость 		= ОбрезатьИсториюОбменов;
	Элементы.ВидПериодаУдаленияИстории.Видимость 	= ОбрезатьИсториюОбменов;
	
	Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "УНФ" Тогда
		ЭлементРасчетныхЛистков = Элементы.Найти("ОтчетРасчетныхЛистков");
		Если ЭлементРасчетныхЛистков <> Неопределено Тогда
			ЭлементРасчетныхЛистков.Видимость = ЭтотОбъект["СвойОтчетРасчетныхЛистков"];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеЭлементовФормыНаСервере()
	Если Метаданные.ФункциональныеОпции.Найти("Б24_К_ИспользованиеКЭДО") <> Неопределено Тогда
		ИспользованиеКЭДО 	= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ФункциональнаяОпцияВключена("Б24_К_ИспользованиеКЭДО");
	Иначе
		ИспользованиеКЭДО 	= Ложь;
	КонецЕсли;
	// CRM используется всегда и без условий — группы не скрываются.
	Элементы.ГруппаОткрытие1СИзБитрикс24.Видимость 				= Истина;
	Элементы.ГруппаОткрытиеБитрикс24Из1С.Видимость 				= Истина;
	Элементы.ГруппаКонтрольСопоставленияПользователей.Видимость = Истина;
	Элементы.ГруппаФлагСинхронизированности.Видимость 			= Истина;
	Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "УНФ" Тогда
		ЭлементГруппаРасчетныеЛистки = Элементы.Найти("ГруппаРасчетныеЛистки");
		Если ЭлементГруппаРасчетныеЛистки <> Неопределено Тогда
			ЭлементГруппаРасчетныеЛистки.Видимость = ИспользованиеКЭДО;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНадписьРасписанияОповещенияОбОшибках()

	Если РасписаниеРегламентногоЗаданияОповещенияОбОшибках = НеОпределено Тогда
		ТекстЗаголовка = НСтр("ru='Настроить расписание оповещения об ошибках'");
	Иначе
		ТекстЗаголовка = РасписаниеРегламентногоЗаданияОповещенияОбОшибках;
	КонецЕсли;

	Элементы.НастроитьРасписаниеОповещенияОбОшибках.Заголовок = ТекстЗаголовка;
	
	Элементы.ГруппаРасписаниеОповещенияОбОшибках.Видимость = НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса();
	
КонецПроцедуры

&НаСервере	
Процедура ОтключитьОтБитрикс24(НастройкаПодключения)            
	
	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураНастроек = Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);
	
	Если СтруктураНастроек <> Неопределено Тогда
		СтруктураНастроек.Логирование.Измерение1 = "Отключение канала от Битрикс24";
		//ТелоЗапроса = "&COMMAND=closePPSession1C&MODULE_ID=1ctotal&params[idAdress]=" + XMLСтрока(НастройкаПодключения.ИдентификаторПодключения) + "&params[B24]=" + XMLСтрока(НастройкаПодключения.Портал);
		//Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
		ТелоЗапроса = "&COMMAND=closePPSession1C&MODULE_ID="+Б24_К_RestApiВызовСервера.ИдПриложенияБитрикс24()+"&params[idAdress]=" + XMLСтрока(НастройкаПодключения.ИдентификаторПодключения) + "&params[portal]=" + XMLСтрока(НастройкаПодключения.Портал);
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	КонецЕсли;
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ИнформационнаяБазаФайловая() Тогда
		
		Б24_К_ЛонгПуллингВызовСервера.УстановитьНастройкуЛонгПуллинг(НастройкаПодключения, Ложь);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Зависший клиент станет активным в течении минуты.");
		
	Иначе
		
		Б24_К_ЛонгПуллингВызовСервера.УстановитьНастройкуЛонгПуллинг(НастройкаПодключения, Ложь);
		
		НаименованиеФоновогоЗадания = Б24_К_ЛонгПуллингКлиентСервер.ПолучитьНазваниеФоновогоЗаданияСоединенияСБитрикс24(НастройкаПодключения);
		
		МассивФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый структура("Наименование", НаименованиеФоновогоЗадания));
		
		Для каждого ТекЭлемент Из МассивФоновыеЗадания Цикл
			
			Если ТекЭлемент.Состояние = СостояниеФоновогоЗадания.Активно Тогда		
				Попытка
					ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ТекЭлемент.УникальныйИдентификатор);
					Если ФоновоеЗадание <> Неопределено Тогда
						РегламентныеЗаданияСлужебный.ОтменитьФоновоеЗадание(ФоновоеЗадание);
					КонецЕсли;
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось отменить фоновое задание: " + ОписаниеОшибки());
				КонецПопытки;

			КонецЕсли;			

		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТекущаяДатаНаСервере()

	Возврат ТекущаяДатаСеанса();

КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ЭлементПриИзменении(Элемент)
	
	СохранитьНастройки();
	
	ОбновитьОтображениеЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИИ_ЛимитПередачиПриИзменении(Элемент)
	
	СохранитьНастройки();
	
	ОбновитьОтображениеЭлементовФормы();
	ОбновитьИнтерфейс();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	
	ОбщиеНастройки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки");

	ЗаполнитьЗначенияСвойств(ОбщиеНастройки, ЭтотОбъект);
	
	ОбщиеНастройки.Вставить("КонтролироватьСопоставлениеПользователей"			, КонтролироватьСопоставлениеПользователей);
	ОбщиеНастройки.Вставить("ОтветственныеЗаКонтрольСопоставленияПользователей"	, ОтветственныеЗаКонтрольСопоставленияПользователей);
	ОбщиеНастройки.Вставить("ХранитьФлагСинхронизированности"					, ХранитьФлагСинхронизированности);
	
	
	ОбщиеНастройки.Вставить("ХранитьИсториюВзаимодействия"	, ХранитьИсториюВзаимодействия);
	ОбщиеНастройки.Вставить("ЧислоХраненияИстории"			, ЧислоХраненияИстории);
	ОбщиеНастройки.Вставить("ВидПериодаУдаленияИстории"		, ВидПериодаУдаленияИстории);
	
	ОбщиеНастройки.Вставить("ПредоставитьДоступИИ"		, ПредоставитьДоступИИ);
	ИИ_ЛимитПередачи = ?(ЗначениеЗаполнено(ИИ_ЛимитПередачи),ИИ_ЛимитПередачи,100);	
	ОбщиеНастройки.Вставить("ИИ_ЛимитПередачи"				, ИИ_ЛимитПередачи);
	
	Б24_К_ОбщегоНазначенияВызовСервера.УстановитьЗначениеВХранилищаНастроек("ОбщиеНастройки", ОбщиеНастройки);

	Константы.Б24_К_ПодключениеПоHTTP.Установить(СпособВзаимодействияСБитрикс24 = "Через push&pull сервер");
	Константы.Б24_К_ЖурналОшибок.Установить(ХранитьИнформациюОбОшибках И ХранитьИсториюВзаимодействия);
	Константы.Б24_ИИ_ИспользованиеИИ.Установить(ПредоставитьДоступИИ);
	Константы.Б24_ИИ_ЛимитПередачи.Установить(ИИ_ЛимитПередачи);		
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры  

&НаСервере	
Процедура ПроверитьЗаполненияЖурналов()
	
	МаксимальноеКоличетсвоЗаписей = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОграничениеЗаписейЛогов();
	Элементы.ЗаполнениеЛогирования.МаксимальноеЗначение = МаксимальноеКоличетсвоЗаписей;
	Элементы.ЗаполнениеОшибок.МаксимальноеЗначение = МаксимальноеКоличетсвоЗаписей;
	Элементы.ЗаполнениеЛогаИИ.МаксимальноеЗначение = МаксимальноеКоличетсвоЗаписей;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
	               |ИЗ
	               |	(ВЫБРАТЬ ПЕРВЫЕ 1000000
	               |		Б24_К_ЖурналОшибок.НомерСообщения КАК НомерСообщения
	               |	ИЗ
	               |		РегистрСведений.Б24_К_ЖурналОшибок КАК Б24_К_ЖурналОшибок) КАК Б24_К_ЖурналОшибок
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
	               |ИЗ
	               |	(ВЫБРАТЬ ПЕРВЫЕ 1000000
	               |		Б24_К_Логирование.НомерСообщения КАК НомерСообщения
	               |	ИЗ
	               |		РегистрСведений.Б24_К_Логирование КАК Б24_К_Логирование) КАК Б24_К_Логирование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
	               |ИЗ
	               |	(ВЫБРАТЬ ПЕРВЫЕ 1000000
	               |		Б24_К_ЛогиИИ.НомерСообщения КАК НомерСообщения
	               |	ИЗ
	               |		РегистрСведений.Б24_К_ЛогиИИ КАК Б24_К_ЛогиИИ) КАК Б24_К_ЛогиИИ";
	МассивРезультатов = Запрос.ВыполнитьПакет();
	Рез = МассивРезультатов[0].Выбрать();
	ЗаполнениеОшибок = 0;
	ЗаполнениеЛогирования = 0;
	ЗаполнениеЛогированияИИ = 0;
	Если Рез.Следующий() и ЗначениеЗаполнено(Рез.КоличествоЗаписей) Тогда 
		ЗаполнениеОшибок = Рез.КоличествоЗаписей;				
	КонецЕсли;
	Рез = МассивРезультатов[1].Выбрать();
	Если Рез.Следующий() и ЗначениеЗаполнено(Рез.КоличествоЗаписей) Тогда
		ЗаполнениеЛогирования = Рез.КоличествоЗаписей;		
	КонецЕсли;
	Рез = МассивРезультатов[2].Выбрать();
	Если Рез.Следующий() и ЗначениеЗаполнено(Рез.КоличествоЗаписей) Тогда
		ЗаполнениеЛогированияИИ = Рез.КоличествоЗаписей;		
	КонецЕсли;	
	
	Элементы.ЗаполнениеЛогирования.Подсказка = "" + ЗаполнениеЛогирования + " из " + Элементы.ЗаполнениеЛогирования.МаксимальноеЗначение; 
	Элементы.ЗаполнениеОшибок.Подсказка = "" + ЗаполнениеОшибок + " из " + Элементы.ЗаполнениеОшибок.МаксимальноеЗначение;
	Элементы.ЗаполнениеЛогаИИ.Подсказка = "" + ЗаполнениеЛогированияИИ + " из " + Элементы.ЗаполнениеЛогаИИ.МаксимальноеЗначение;
	
	ШрифтЖирный = Новый Шрифт(,,Истина);
		
	Если ЗаполнениеЛогирования >= Элементы.ЗаполнениеЛогирования.МаксимальноеЗначение Тогда
		Элементы.ЗаполнениеЛогирования.ЦветРамки = WebЦвета.Красный;
		Элементы.ЗаполнениеЛогирования.ЦветТекстаЗаголовка = WebЦвета.Красный;
		Элементы.ЗаполнениеЛогирования.ШрифтЗаголовка = ШрифтЖирный;
		Элементы.ЗаполнениеЛогированияРасширеннаяПодсказка.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	Если ЗаполнениеОшибок >= Элементы.ЗаполнениеОшибок.МаксимальноеЗначение Тогда
		Элементы.ЗаполнениеОшибок.ЦветРамки = WebЦвета.Красный;
		Элементы.ЗаполнениеОшибок.ЦветТекстаЗаголовка = WebЦвета.Красный;
		Элементы.ЗаполнениеОшибок.ШрифтЗаголовка = ШрифтЖирный;    
		Элементы.ЗаполнениеОшибокРасширеннаяПодсказка.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	Если ЗаполнениеЛогированияИИ >= Элементы.ЗаполнениеОшибок.МаксимальноеЗначение Тогда
		Элементы.ЗаполнениеЛогаИИ.ЦветРамки = WebЦвета.Красный;
		Элементы.ЗаполнениеЛогаИИ.ЦветТекстаЗаголовка = WebЦвета.Красный;
		Элементы.ЗаполнениеЛогаИИ.ШрифтЗаголовка = ШрифтЖирный;    
		Элементы.ЗаполнениеЛогаИИРасширеннаяПодсказка.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;	
	
КонецПроцедуры
