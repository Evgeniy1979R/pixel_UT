
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщиеНастройки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки");
	
	Если ОбщиеНастройки = Неопределено Тогда 
		ОбщиеНастройки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОбщиеНастройкиПоУмолчанию();
		Б24_К_ОбщегоНазначенияВызовСервера.УстановитьЗначениеВХранилищаНастроек("ОбщиеНастройки", ОбщиеНастройки);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОбщиеНастройки);

	// Ключ «Предоставить доступ Битрикс AI» в сохранённой структуре мог остаться
	// под старым именем (ПредоставитьДоступМартеИИ), а реквизит формы - Булево без
	// значения заполнения: без этого блока галка показывалась бы снятой, а первое
	// же изменение любого поля формы выключило бы Константу ИИ.
	Если НЕ ОбщиеНастройки.Свойство("ПредоставитьДоступИИ") Тогда
		ЗначениеДоступаИИ = Неопределено;
		Если ОбщиеНастройки.Свойство("ПредоставитьДоступМартеИИ") Тогда
			ЗначениеДоступаИИ = ОбщиеНастройки["ПредоставитьДоступМартеИИ"];
		КонецЕсли;
		Если ЗначениеДоступаИИ = Неопределено Тогда
			// Ключа нет вовсе: достоверный источник - константа, по ней же работает
			// функциональная опция вендорского Битрикс AI.
			ЗначениеДоступаИИ = Константы.Б24_ИИ_ИспользованиеИИ.Получить();
		КонецЕсли;
		ПредоставитьДоступИИ = (ЗначениеДоступаИИ = Истина);
	КонецЕсли;
	
	БылиКонвертированыНастройки = Ложь;
	Если НЕ ОбщиеНастройки.Свойство("ХранитьИсториюВзаимодействия") Тогда 
		ХранитьИсториюВзаимодействия = Истина;
		БылиКонвертированыНастройки = Истина;	
	КонецЕсли;       
	
	Если НЕ ОбщиеНастройки.Свойство("ВидПериодаУдаленияИстории") Тогда ВидПериодаУдаленияИстории = "Дней" КонецЕсли;
	Если НЕ ОбщиеНастройки.Свойство("ЧислоХраненияИстории") Тогда ЧислоХраненияИстории = 7 КонецЕсли;
	
	Если БылиКонвертированыНастройки Тогда  
		СохранитьНастройки();
	КонецЕсли;
	
	ОбновитьИнформациюОРегламентномЗаданииОповещенииОбОшибках();
	ОбновитьОтображениеЭлементовФормыНаСервере();
	ПроверитьЗаполненияЖурналов();
	
КонецПроцедуры

