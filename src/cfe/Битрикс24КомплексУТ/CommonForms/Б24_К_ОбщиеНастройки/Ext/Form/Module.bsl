&НаКлиенте
Процедура ВебАдрес1СОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Текст = СокрЛП(Текст);
	
	Если НРег(Лев(Текст, 8)) <> "https://" И ЗначениеЗаполнено(Текст) Тогда
		ПоказатьПредупреждение(, "Необходимо указывать https адрес");
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	Если НРег(Прав(Текст, 4)) = "/ru/" Тогда
		Текст = Лев(Текст, СтрДлина(Текст)-3);	
		СтандартнаяОбработка = Ложь;
        ВебАдрес1С = Текст; 
	КонецЕсли;
	
