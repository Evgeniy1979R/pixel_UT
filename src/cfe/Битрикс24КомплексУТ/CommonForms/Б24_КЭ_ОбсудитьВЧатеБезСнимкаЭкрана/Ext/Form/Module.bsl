
#Область ОбработчикиСобытийФормы  

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастройкаПодключения = Параметры.НастройкаПодключения;	
	ОбъектСсылка		 = Параметры.ОбъектСсылка;
	
	ТемаЧата = "Новый чат";
	
	ТекстСообщенияЧата = "Ссылка на объект в базе 1С: " + ПолучитьНавигационнуюСсылку(Параметры.ОбъектСсылка);    
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Портал = ЗначениеРеквизитаОбъекта(НастройкаПодключения, "Портал");
	
	СотрудникиНовогоЧата = Б24_КЭ_ЭкспортДанныхВызовСервера.СотрудникиДляНовогоЧата(Портал, ПолноеИмяОбъекта(ОбъектСсылка));
	Для каждого ТекЭлемент Из СотрудникиНовогоЧата Цикл 
		
		НоваяСтрока = ВыбранныеЭлементы.Добавить();
		
		НоваяСтрока.Тип 			= "Пользователь";
		НоваяСтрока.Идентификатор 	= ТекЭлемент.Идентификатор;
		НоваяСтрока.Наименование 	= ТекЭлемент.Наименование;
		
	КонецЦикла;	

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы 

&НаКлиенте
Процедура ДобавитьПользователей(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	
	ОткрытьФорму("РегистрСведений.Б24_К_ПользователиБитрикс24.Форма.ФормаСписка", ПараметрыФормы, ЭтотОбъект,,,, Новый ОписаниеОповещения("ВыполнитьПослеВыбораПользователей", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораПользователей(Результат, ДополнительныеПараметры) Экспорт
    
    ОтветФормы = Результат;
    
    Если ОтветФормы <> Неопределено Тогда
		
		ДобавитьЭлементыВТаблицуВыбора("Пользователь", ОтветФормы);
		
    КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗакрытьБезЧата(Команда)  
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)           
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда  
		ПоказатьОповещениеПользователя("Не удалось получить данные портала");
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек.Логирование.Измерение1 = "Обсуждение в чате";
			
	ИдентификаторЧата = Б24_КЭ_ЭкспортДанныхКлиент.СоздатьЧат(СтруктураНастроек, ВыбранныеЭлементы, ТемаЧата);     
	Если ИдентификаторЧата <> Неопределено Тогда
		Б24_КЭ_ЭкспортДанныхВызовСервера.ДобавитьИнформациюУчастниковЧата(СтруктураНастроек.Портал, ИдентификаторЧата, ТемаЧата, СотрудникиЧата(), ПолноеИмяОбъекта(ОбъектСсылка));
	КонецЕсли;
			
	Если НЕ ЗначениеЗаполнено(ИдентификаторЧата) Тогда   
		ПоказатьОповещениеПользователя("Не определен чат");
		Возврат; 
	КонецЕсли;
	
	РезультатОтправки = Б24_КЭ_ЭкспортДанныхКлиент.ДобавитьСообщениеВЧат(СтруктураНастроек, ИдентификаторЧата, ТекстСообщенияЧата);	
	Если РезультатОтправки = Истина Тогда
		Закрыть();
	Иначе
		ПоказатьОповещениеПользователя("Не удалось отправить в чат");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы 

#КонецОбласти


#Область Прочие


&НаСервере
Процедура ДобавитьЭлементыВТаблицуВыбора(Тип, ОтветФормы)
	
	Для каждого ТекСтрока Из ОтветФормы Цикл
		
		НовСтрока = ВыбранныеЭлементы.Добавить();
		
		НовСтрока.Тип 			= Тип;
		НовСтрока.Идентификатор = ТекСтрока.Значение;
		НовСтрока.Наименование 	= ТекСтрока.Представление;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция СотрудникиЧата()
	
	Результат = Новый Массив;
	
	Для каждого ТекСтрока Из ВыбранныеЭлементы Цикл  
		Результат.Добавить(Новый Структура("Идентификатор, Наименование", ТекСтрока.Идентификатор ,ТекСтрока.Наименование));
	КонецЦикла;  
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолноеИмяОбъекта(Объект)
	
	Возврат Объект.Метаданные().ПолноеИмя()  
	
КонецФункции

&НаСервере
Функция ЗначениеРеквизитаОбъекта(Объект, ИмяРеквизита)
	            
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, ИмяРеквизита);

КонецФункции

#КонецОбласти


     