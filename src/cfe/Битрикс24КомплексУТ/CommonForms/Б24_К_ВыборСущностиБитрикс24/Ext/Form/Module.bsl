
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ТипСущности") Тогда
		
		Если Параметры.ТипСущности = "Лид" Тогда    
			Заголовок = "Выберите лид Битрикс24";
		ИначеЕсли Параметры.ТипСущности = "Компания" Тогда
			Заголовок = "Выберите компанию Битрикс24";   
		ИначеЕсли Параметры.ТипСущности = "Контакт" Тогда
			Заголовок = "Выберите контакт Битрикс24";   
		ИначеЕсли Параметры.ТипСущности = "Сделка" Тогда
			Заголовок = "Выберите сделку Битрикс24";   
		ИначеЕсли Параметры.ТипСущности = "Счет" Тогда
			Заголовок = "Выберите счет Битрикс24";   
		Иначе
			Заголовок = "Выберите смарт процесс Битрикс24";   
		КонецЕсли;
		
	КонецЕсли;

	Если Параметры.Свойство("ДанныеПортала") Тогда
		
		Для каждого ТекЭлемент Из Параметры.ДанныеПортала Цикл
			
			НоваяСтрока = ДанныеПортала.Добавить();
			НоваяСтрока.Идентификатор 	= ТекЭлемент.Ид;
			НоваяСтрока.Наименование 	= ТекЭлемент.Наименование;
			НоваяСтрока.ДатаСоздания 	= ТекЭлемент.ДатаСоздания;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПорталаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  

	ТекущиеДанные = Элементы.ДанныеПортала.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Закрыть(ТекущиеДанные.Идентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЭлемент(Команда)

	ТекущиеДанные = Элементы.ДанныеПортала.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Закрыть(ТекущиеДанные.Идентификатор);
	КонецЕсли;
	
КонецПроцедуры
