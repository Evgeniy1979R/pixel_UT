
#Область СобытияФормы

&НаСервере
Процедура Б24_К_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
УстановитьПривилегированныйРежим(Истина);

	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РольДоступнаНаКлиенте("Б24_К_Администратор") 
		И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РольДоступнаНаКлиенте("Б24_К_Пользователь")
		И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РольДоступнаНаКлиенте("ПолныеПрава") Тогда
		Возврат;
	КонецЕсли;  
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения("ЭкспортПечатныхФормОтчетов", Истина);
	Б24_КЭ_ЭкспортПечатныхФорм = КоличествоНастроек > 0;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_К_ПриОткрытииПосле(Отказ)
		
	Если Б24_КЭ_ЭкспортПечатныхФорм Тогда
	
		Б24_КЭ_ДобавлениеЭлементовФормы();
		Б24_КЭ_ОбновитьОтображениеНаличияПубликации();	
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Б24_КЭ_ДобавлениеЭлементовФормы()
	                                          
	ИмяГруппы = "Б24_КЭ_ГруппаКомандБитрикс24";
	НовыйЭлемент 			= Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Элементы.ГруппаНастройкиОтчета);
	НовыйЭлемент.Заголовок 	= "Битрикс24";     
	НовыйЭлемент.Картинка 	= БиблиотекаКартинок.Б24_К_Лого;
	НовыйЭлемент.Отображение= ОтображениеКнопки.КартинкаИТекст;
	Элементы.Переместить(НовыйЭлемент, Элементы.ГруппаНастройкиОтчета, Элементы.Печать); 
	
	ИмяКоманды = "Б24_КЭ_КомандаОтправитьВБитрикс24";
	Команда = Команды.Добавить(ИмяКоманды);
	Команда.Действие 		= "Б24_КЭ_КомандаОтправитьВБитрикс24";
	НовыйЭлемент 			= Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы[ИмяГруппы]);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.Заголовок 	= "В живую ленту";     
	НовыйЭлемент.Отображение= ОтображениеКнопки.Текст;
	Элементы.Переместить(НовыйЭлемент, Элементы[ИмяГруппы]); 
	ПостоянныеКоманды.Добавить(ИмяКоманды, ИмяКоманды);
	
	ИмяКоманды = "Б24_КЭ_ОбсудитьВБитрикс24";
	Команда = Команды.Добавить(ИмяКоманды);
	Команда.Действие 		= "Б24_КЭ_ОбсудитьВБитрикс24";
	НовыйЭлемент 			= Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы[ИмяГруппы]);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.Заголовок 	= "Обсудить в Битрикс24";     
	НовыйЭлемент.Отображение= ОтображениеКнопки.Текст;
	Элементы.Переместить(НовыйЭлемент, Элементы[ИмяГруппы]); 
	ПостоянныеКоманды.Добавить(ИмяКоманды, ИмяКоманды);
	
	ИмяКоманды = "Б24_КЭ_РегулярноОтправлятьВБитрикс24";
	Команда = Команды.Добавить(ИмяКоманды);
	Команда.Действие 		= "Б24_КЭ_РегулярноОтправлятьВБитрикс24";
	НовыйЭлемент 			= Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы[ИмяГруппы]);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.Заголовок 	= "Публиковать в Битрикс24 регулярно";     
	НовыйЭлемент.Отображение= ОтображениеКнопки.Текст;
	Элементы.Переместить(НовыйЭлемент, Элементы[ИмяГруппы]); 
	ПостоянныеКоманды.Добавить(ИмяКоманды, ИмяКоманды);
	
КонецПроцедуры

#КонецОбласти


#Область ПроцедурыИФункцииПоПубликацииДанныхВБ24

&НаКлиенте
Процедура Б24_КЭ_КомандаОтправитьВБитрикс24(Команда)
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения("ЭкспортПечатныхФормОтчетов", Истина);
	
	Если КоличествоНастроек > 1 Тогда
		
		ВыбЗнач = Неопределено;
		
		Массив = Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("Б24_КЭ_ПослеВводаЗначения",ЭтотОбъект );

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку синхронизации", ОписаниеТипов);	
		
	ИначеЕсли КоличествоНастроек = 1 Тогда
		
		лПараметры = Новый Структура;	
		Б24_КЭ_ПослеВводаЗначения(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию("ЭкспортПечатныхФормОтчетов", Истина), лПараметры);	

	КонецЕсли;
	
КонецПроцедуры 	

&НаКлиенте
Процедура Б24_КЭ_ПослеВводаЗначения(ВыбЗнач, ПередаваемыеПараметры) Экспорт
	
	Если ВыбЗнач <> Неопределено Тогда
		
		ЭкспортПечатныхФормОтчетов = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(ВыбЗнач, "ЭкспортПечатныхФормОтчетов");
		Если ЭкспортПечатныхФормОтчетов = Истина Тогда
			
			Б24_КЭ_НастройкаПодключения = ВыбЗнач;
			
			Если НЕ Б24_К_СлужебныйВызовСервера.МодульЭкспортаПечатныхФормДоступен(Б24_КЭ_НастройкаПодключения) Тогда
				Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаЭкспортаПечатныхФорм();
				Возврат;
			КонецЕсли;                          
			
			мОбъект = Новый Массив;
			мОбъект.Добавить(Неопределено);	 
			
			Б24_КЭ_ЭкспортДанныхКлиент.ЭкспортПечатнойФормыОтчетаОпубликовать(Б24_КЭ_НастройкаПодключения, мОбъект, ОтчетТабличныйДокумент, НастройкиОтчета.Наименование, "Отчет");
			
			Б24_КЭ_ОбновитьОтображениеНаличияПубликации();
			
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю("У настройки не включен функионал экпорта печатных форм в живую ленту");
			Б24_КЭ_КомандаОтправитьВБитрикс24(Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура Б24_КЭ_ОбновитьОтображениеНаличияПубликации()
	
УстановитьПривилегированныйРежим(Истина);  

	Если Элементы.Найти("Б24_КЭ_ОбсудитьВБитрикс24") = Неопределено Тогда Возврат КонецЕсли;

	ДатаПубликации = Неопределено;
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения("ЭкспортПечатныхФормОтчетов", Истина);
	
	Если КоличествоНастроек = 1 Тогда
		
		Б24_КЭ_НастройкаПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию("ЭкспортПечатныхФормОтчетов", Истина); 
		ДатаПубликации = Б24_КЭ_ЭкспортДанныхВызовСервера.ПроверитьНаличиеПубликацийОтчета(Б24_КЭ_НастройкаПодключения, НастройкиОтчета.Наименование, Справочники.Б24_КЭ_РегулярныеПубликацииОтчетовВБитрикс24.ПустаяСсылка());

	ИначеЕсли ЗначениеЗаполнено(Б24_КЭ_НастройкаПодключения) Тогда
		ДатаПубликации = Б24_КЭ_ЭкспортДанныхВызовСервера.ПроверитьНаличиеПубликацийОтчета(Б24_КЭ_НастройкаПодключения, НастройкиОтчета.Наименование, Справочники.Б24_КЭ_РегулярныеПубликацииОтчетовВБитрикс24.ПустаяСсылка());
	КонецЕсли;
	

	Если ДатаПубликации = Неопределено Тогда
		Элементы.Б24_КЭ_ОбсудитьВБитрикс24.Доступность = Ложь;
	Иначе
		Элементы.Б24_КЭ_ОбсудитьВБитрикс24.Заголовок = """Перейти к последней публикации (от " + Формат(ДатаПубликации,"ДФ=dd.MM.yyyy") + ")";
		Элементы.Б24_КЭ_ОбсудитьВБитрикс24.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область РегулярнаяПубликация

&НаКлиенте
Процедура Б24_КЭ_РегулярноОтправлятьВБитрикс24(Команда)
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения("ЭкспортПечатныхФормОтчетов", Истина);
	
	Если КоличествоНастроек > 1 Тогда
		
		ВыбЗнач = Неопределено;
		
		Массив = Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("Б24_КЭ_ПослеВводаНастройкиДляРегулярногоОпубликования",ЭтотОбъект );

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку синхронизации", ОписаниеТипов);	
		
	ИначеЕсли КоличествоНастроек = 1 Тогда
		
		лПараметры = Новый Структура;	
		Б24_КЭ_ПослеВводаНастройкиДляРегулярногоОпубликования(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию("ЭкспортПечатныхФормОтчетов", Истина), лПараметры);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_КЭ_ПослеВводаНастройкиДляРегулярногоОпубликования(ВыбЗнач, ПередаваемыеПараметры) Экспорт
	
	Если ВыбЗнач <> Неопределено Тогда
		
		Б24_КЭ_НастройкаПодключения = ВыбЗнач;
			
		Если НЕ Б24_К_СлужебныйВызовСервера.МодульЭкспортаПечатныхФормДоступен(Б24_КЭ_НастройкаПодключения) Тогда
			Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаЭкспортаПечатныхФорм();
			Возврат;
		КонецЕсли;                          
		
		стрПараметры = Б24_КЭ_ПолучитьСтруктуруПараметров();

		ОткрытьФорму("Справочник.Б24_КЭ_РегулярныеПубликацииОтчетовВБитрикс24.Форма.КраткаяФормаНастроек", стрПараметры,, Новый УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция Б24_КЭ_ПолучитьСтруктуруПараметров()
	
	стрПараметры = Новый Структура;
	
	стрПараметры.Вставить("НастройкаПодключения", Б24_КЭ_НастройкаПодключения);
	стрПараметры.Вставить("СинонимОтчета"		, НастройкиОтчета.Наименование);
	стрПараметры.Вставить("ИмяОтчета"			, НастройкиОтчета.ОтчетСсылка.Имя);
	
	ОтборыДляКомпоновки = Неопределено;
	ОтборыДляКомпоновки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	стрПараметры.Вставить("НастройкиОтчета"		, ПоместитьВоВременноеХранилище(ОтборыДляКомпоновки, УникальныйИдентификатор));

	Возврат стрПараметры;
	
КонецФункции

#КонецОбласти


#Область Обсуждение

&НаКлиенте
Процедура Б24_КЭ_ОбсудитьВБитрикс24(Команда)
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения("ЭкспортПечатныхФормОтчетов", Истина);
	
	Если КоличествоНастроек > 1 Тогда
		
		ВыбЗнач = Неопределено;
		
		Массив = Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("Б24_КЭ_ПослеВводаНастройкиДляОпубликования",ЭтотОбъект );

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку синхронизации", ОписаниеТипов);	
		
	ИначеЕсли КоличествоНастроек = 1 Тогда
		
		лПараметры = Новый Структура;	
		Б24_КЭ_ПослеВводаНастройкиДляОпубликования(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию("ЭкспортПечатныхФормОтчетов", Истина), лПараметры);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_КЭ_ПослеВводаНастройкиДляОпубликования(ВыбЗнач, ПередаваемыеПараметры) Экспорт
	
	Если ВыбЗнач <> Неопределено Тогда
		
		Б24_КЭ_НастройкаПодключения = ВыбЗнач;	
		
		Если НЕ Б24_К_СлужебныйВызовСервера.МодульЭкспортаПечатныхФормДоступен(Б24_КЭ_НастройкаПодключения) Тогда
			Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаЭкспортаПечатныхФорм();
			Возврат;
		КонецЕсли;                          
		
		Попытка
			
			АдресСсылки = Б24_КЭ_ЭкспортДанныхВызовСервера.ПолучитьСсылкуНаПоследнийПост(Б24_КЭ_НастройкаПодключения, НастройкиОтчета.Наименование);	
			
			#Если ВебКлиент Тогда
				ПерейтиПоНавигационнойСсылке(АдресСсылки); 	
			#Иначе			
				ОбщиеНастройки 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки");
				ОбщиеНастройки = ?(ОбщиеНастройки = Неопределено, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОбщиеНастройкиПоУмолчанию(), ОбщиеНастройки);
				СпособОткрытияОбъектовБитрикс24 = ОбщиеНастройки.ИспользуемыйБраузер;
				
				Если СпособОткрытияОбъектовБитрикс24 <> "Браузер ОС по умолчанию" Тогда
					
					СтраницаHTML = "
					|<html>
					|<script type=""text/javascript"">
					|location.replace("""+АдресСсылки+""");
					|</script>
					|</html>";
					
					Б24_К_ОбщегоНазначенияКлиент.ПерейтиПоWebСсылке(СтраницаHTML, "Битрикс24");
				Иначе
					ПерейтиПоНавигационнойСсылке(АдресСсылки); 	
				КонецЕсли;
			#КонецЕсли
			
		Исключение
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_К_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПубликацияЗавершена" Тогда
		Б24_КЭ_ОбновитьОтображениеНаличияПубликации();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
