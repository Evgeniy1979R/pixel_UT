#Область ЭкспортПечатныхФорм

&НаКлиенте
Процедура Б24_КБС_КомандаЭкспорт(Команда)
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения();
	
	Если КоличествоНастроек > 1 Тогда
		
		ВыбЗнач = Неопределено;
		
		Массив = Новый Массив;
		Массив.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("Б24_КБС_ПослеВводаНастройкиДляЭкспорта",ЭтотОбъект );

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку подключения", ОписаниеТипов);	
		
	ИначеЕсли КоличествоНастроек = 1 Тогда
		
		лПараметры = Новый Структура;	
		Б24_КБС_ПослеВводаНастройкиДляЭкспорта(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию(), лПараметры);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_КБС_ПослеВводаНастройкиДляЭкспорта(НастройкаПодключения, ПередаваемыеПараметры) Экспорт
	
	Если НастройкаПодключения <> Неопределено Тогда
		
		Если НЕ Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) И НЕ Б24_К_СлужебныйВызовСервера.МодульРаботыИзОдногоОкнаДоступен(НастройкаПодключения) Тогда
			Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаСинхронизацииПоТарифномуПлану();
			Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаРаботыИзОдногоОкнаПоТарифномуПлану();
			Возврат;
		КонецЕсли;                          
		
		Если Б24_КБС_ПроверитьНаличиеСвязиСБ24(НастройкаПодключения) = Истина Тогда
			
			Результат = Б24_К_RestApiВызовСервера.ВыгрузитьПечатнуюФормуВТаймЛайн(НастройкаПодключения, Б24_К_ОбъектДляЭкспорта, Б24_К_НазваниеПечатнойФормы, ТекущаяПечатнаяФорма);   
			Если Результат.Выгружено = Истина Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Печатная форма выгружена в Битрикс24");	
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось выгрузить печатную форму  в Битрикс24");	
			КонецЕсли;
			
		Иначе
			ПоказатьОповещениеПользователя("Не найдена связь с Битрикс24");	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция Б24_КБС_ПроверитьНаличиеСвязиСБ24(НастройкаПодключения)
	
УстановитьПривилегированныйРежим(Истина);

	ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал"				, НастройкаПодключения.Портал);
	Запрос.УстановитьПараметр("ТипыДанных"			, Б24_К_RestApiВызовСервера.ПолучитьТипыДанныхДел());
	Запрос.УстановитьПараметр("ТипОбъекта"			, Б24_К_ОбъектДляЭкспорта.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", XMLСтрока(Б24_К_ОбъектДляЭкспорта));
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.Портал = &Портал
	|	И Б24_К_ИдентификаторыДел.ТипДанных В(&ТипыДанных)
	|	И Б24_К_ИдентификаторыДел.ТипОбъекта = &ТипОбъекта
	|	И Б24_К_ИдентификаторыДел.ИдентификаторОбъекта = &ИдентификаторОбъекта";
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Результат = НЕ ВыполненныйЗапрос.Пустой();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти 


#Область ВыгрузкаПечатныхФормВЖивуюЛенту

&НаКлиенте
Процедура Б24_КЭ_КомандаОтправитьВБитрикс24(Команда)
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения("ЭкспортПечатныхФормОтчетов", Истина);
	
	Если КоличествоНастроек > 1 Тогда
		
		ВыбЗнач = Неопределено;
		
		Массив = Новый Массив;
		Массив.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("Б24_КЭ_ПослеВводаНастройкиДляЭкспорта",ЭтотОбъект );

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку подключения", ОписаниеТипов);	
		
	ИначеЕсли КоличествоНастроек = 1 Тогда
		
		лПараметры = Новый Структура;	
		Б24_КЭ_ПослеВводаНастройкиДляЭкспорта(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию("ЭкспортПечатныхФормОтчетов", Истина), лПараметры);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_КЭ_ПослеВводаНастройкиДляЭкспорта(НастройкаПодключения, ПередаваемыеПараметры) Экспорт
	
	Если НастройкаПодключения <> Неопределено Тогда
		
		Если НЕ Б24_К_СлужебныйВызовСервера.МодульЭкспортаПечатныхФормДоступен(НастройкаПодключения) Тогда
			Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаЭкспортаПечатныхФорм();
			Возврат;
		КонецЕсли;                          
		
		ЭкспортПечатныхФормОтчетов = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(НастройкаПодключения, "ЭкспортПечатныхФормОтчетов");
		Если ЭкспортПечатныхФормОтчетов = Истина Тогда
			
			Для Каждого НастройкаПечатнойФормы Из НастройкиПечатныхФорм Цикл
				
				РезультатОтправки = Истина;
				 
				ПечатнаяФорма 	= ЭтотОбъект[НастройкаПечатнойФормы.ИмяРеквизита];
				лОбъектыПечати 	= ОбъектыПечати.ВыгрузитьЗначения();	

				Б24_КЭ_ЭкспортДанныхКлиент.ЭкспортПечатнойФормыОтчетаОпубликовать(НастройкаПодключения, лОбъектыПечати, ПечатнаяФорма, НастройкаПечатнойФормы.Название, "Документ");
				
			КонецЦикла;
				
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю("У настройки не включен функионал экпорта печатных форм в живую ленту");
			Б24_КЭ_КомандаОтправитьВБитрикс24(Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 
