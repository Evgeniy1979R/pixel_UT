
#Область СобытияФормы

&НаСервере   
Процедура Б24_К_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	УстановитьПривилегированныйРежим(Истина);

	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РольДоступнаНаКлиенте("Б24_К_Администратор") 
		И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РольДоступнаНаКлиенте("Б24_К_Пользователь")
		И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РольДоступнаНаКлиенте("ПолныеПрава") Тогда
		Возврат;
	КонецЕсли;

	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения("ЭкспортПечатныхФормОтчетов", Истина);
	Б24_КЭ_ЭкспортПечатныхФорм = КоличествоНастроек > 0;
	
	КоличествоНастроек = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьКоличествоНастроекПодключенияИнтеграцииСервисов();
	Б24_КБ_ВыгрузкаПечатныхФорм = КоличествоНастроек > 0;

	КоличествоНастроек = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьКоличествоНастроекПодключенияИнтеграцииСервисов("РеестрПечатныхФорм", Истина);
	Б24_КБ_ВестиРеестрПечатныхФорм = КоличествоНастроек > 0;
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
		КоличествоНастроек = РегистрыСведений["Б24_КС_НастройкиСинхронизации"].ПолучитьКоличествоНастроекПодключенияСинхронизации();
		Б24_КС_ВыгрузкаПечатныхФорм = КоличествоНастроек > 0; 
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		КоличествоНастроек = РегистрыСведений["Б24_КС_НастройкиСинхронизации"].ПолучитьКоличествоНастроекПодключенияСинхронизации();
		Б24_КС_ВыгрузкаПечатныхФорм = КоличествоНастроек > 0;
	Иначе
		Б24_КС_ВыгрузкаПечатныхФорм = Ложь;
	КонецЕсли;
	
	Если Б24_КБ_ВестиРеестрПечатныхФорм = Ложь И Б24_КБ_ВыгрузкаПечатныхФорм = Ложь И Б24_КС_ВыгрузкаПечатныхФорм = Ложь И Б24_КЭ_ЭкспортПечатныхФорм = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Б24_К_ОбъектДляЭкспорта = Б24_К_НайтиВладельцаПечатнойФормы();
	Если НЕ ЗначениеЗаполнено(Б24_К_ОбъектДляЭкспорта) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипКонфигурации = "УТ" Тогда
		Если ТипЗнч(Б24_К_ОбъектДляЭкспорта) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетФактураВыданный") Тогда
			Б24_К_ОбъектДляЭкспорта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Б24_К_ОбъектДляЭкспорта, "ДокументОснование");
		ИначеЕсли ТипЗнч(Б24_К_ОбъектДляЭкспорта) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетФактураВыданныйАванс") Тогда
			Б24_К_ОбъектДляЭкспорта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Б24_К_ОбъектДляЭкспорта, "ДокументОснование");
		КонецЕсли;		
		Б24_К_НазваниеПечатнойФормы = НастройкиПечатныхФорм[0].Название + " для " + Строка(Б24_К_ОбъектДляЭкспорта);
	КонецЕсли;	
	
	Если Метаданные.Документы.Найти(Б24_К_ОбъектДляЭкспорта.Метаданные().Имя)= Неопределено Тогда
		
		Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" ИЛИ ТипКонфигурации = "УНФ" Тогда
			Если ТипЗнч(Б24_К_ОбъектДляЭкспорта) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Контрагенты") Тогда
				Б24_К_КонтрагентДляЭкспорта = Б24_К_ОбъектДляЭкспорта; 
			КонецЕсли; 
			
			Если НастройкиПечатныхФорм.Количество() > 0 Тогда
				Б24_К_НазваниеПечатнойФормы = НастройкиПечатныхФорм[0].Название + " для " + Строка(Б24_К_ОбъектДляЭкспорта);  
			Иначе
				Если Параметры.Свойство("ИсточникДанных") И ЗначениеЗаполнено(Параметры.ИсточникДанных) Тогда
					Б24_К_НазваниеПечатнойФормы = Строка(Параметры.ИсточникДанных) + " для " + Строка(Б24_К_ОбъектДляЭкспорта);  
				Иначе
					Б24_К_НазваниеПечатнойФормы = "Для " + Строка(Б24_К_ОбъектДляЭкспорта);  
				КонецЕсли;
			КонецЕсли;				
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			Если ТипЗнч(Б24_К_ОбъектДляЭкспорта) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Партнеры") Тогда
				
				Б24_К_ПартнерДляЭкспорта 		= Б24_К_ОбъектДляЭкспорта; 
				Б24_К_КонтрагентДляЭкспорта 	= Справочники.Контрагенты.НайтиПоРеквизиту("Партнер", Б24_К_ПартнерДляЭкспорта);
				
				Если НастройкиПечатныхФорм.Количество() > 0 Тогда
					Б24_К_НазваниеПечатнойФормы = НастройкиПечатныхФорм[0].Название + " для " + Строка(Б24_К_ОбъектДляЭкспорта);  
				Иначе
					Если Параметры.Свойство("ИсточникДанных") И ЗначениеЗаполнено(Параметры.ИсточникДанных) Тогда
						Б24_К_НазваниеПечатнойФормы = Строка(Параметры.ИсточникДанных) + " для " + Строка(Б24_К_ОбъектДляЭкспорта);  
					Иначе
						Б24_К_НазваниеПечатнойФормы = "Для " + Строка(Б24_К_ОбъектДляЭкспорта);  
					КонецЕсли;
				КонецЕсли;				
			КонецЕсли;				
		КонецЕсли;
	Иначе
		
		Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" ИЛИ ТипКонфигурации = "УНФ" Тогда
			Если Б24_К_ОбъектДляЭкспорта.Метаданные().Реквизиты.Найти("Контрагент") <> Неопределено Тогда
				Б24_К_КонтрагентДляЭкспорта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Б24_К_ОбъектДляЭкспорта, "Контрагент");
			КонецЕсли;				
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			Если Б24_К_ОбъектДляЭкспорта.Метаданные().Реквизиты.Найти("Партнер") <> Неопределено Тогда
				Б24_К_ПартнерДляЭкспорта 	= Б24_К_ОбъектДляЭкспорта.Партнер;
			КонецЕсли;
			
			Если Б24_К_ОбъектДляЭкспорта.Метаданные().Реквизиты.Найти("Контрагент") <> Неопределено Тогда
				
				Б24_К_КонтрагентДляЭкспорта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Б24_К_ОбъектДляЭкспорта, "Контрагент");
				
				Если НЕ ЗначениеЗаполнено(Б24_К_ПартнерДляЭкспорта) Тогда
					Б24_К_ПартнерДляЭкспорта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Б24_К_КонтрагентДляЭкспорта, "Партнер");	
				КонецЕсли
				
			ИначеЕсли ЗначениеЗаполнено(Б24_К_ПартнерДляЭкспорта) Тогда
				
				Б24_К_КонтрагентДляЭкспорта = Справочники.Контрагенты.НайтиПоРеквизиту("Партнер", Б24_К_ПартнерДляЭкспорта);
				
			КонецЕсли;				
		КонецЕсли;		
		
		Если НастройкиПечатныхФорм.Количество() > 0 Тогда
			Б24_К_НазваниеПечатнойФормы = НастройкиПечатныхФорм[0].Название + " № " + Строка(Б24_К_ОбъектДляЭкспорта.Номер) + " от " + Формат(Б24_К_ОбъектДляЭкспорта.Дата,"ДЛФ=DD");
		Иначе
			Если Параметры.Свойство("ИсточникДанных") И ЗначениеЗаполнено(Параметры.ИсточникДанных) Тогда
				Б24_К_НазваниеПечатнойФормы = Строка(Параметры.ИсточникДанных) + " № " + Строка(Б24_К_ОбъектДляЭкспорта.Номер) + " от " + Формат(Б24_К_ОбъектДляЭкспорта.Дата,"ДЛФ=DD");  
			Иначе         
				Б24_К_НазваниеПечатнойФормы = "№ " + Строка(Б24_К_ОбъектДляЭкспорта.Номер) + " от " + Формат(Б24_К_ОбъектДляЭкспорта.Дата,"ДЛФ=DD");
			КонецЕсли;
		КонецЕсли;   
		
	КонецЕсли;
	
	Б24_К_ДобавлениеЭлементовФормы();

КонецПроцедуры
		
&НаСервере
Функция Б24_К_НайтиВладельцаПечатнойФормы()
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	Результат = Неопределено;
	
	Если ОбъектыПечати.количество() = 1 Тогда 
		Результат = ОбъектыПечати[0].Значение;
	Иначе
		Если Параметры.ПараметрыИсточника <> Неопределено Тогда
			лОбъектыНазначения = Параметры.ПараметрыИсточника.ОбъектыНазначения;	
			Если лОбъектыНазначения.количество() = 1 Тогда 
				Результат = лОбъектыНазначения[0];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипКонфигурации = "УНФ" И ТипЗнч(Результат) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетФактура") Тогда  
		ОтгрузкиСФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат, "ДокументыОснования");
		Если НЕ ОтгрузкиСФ.Пустой() Тогда
			Выборка = ОтгрузкиСФ.Выбрать(); 
			Выборка.Следующий();
			Результат = Выборка.ДокументОснование;
		КонецЕсли;
	ИначеЕсли НЕ ТипКонфигурации = "ЗУП" И НЕ ТипКонфигурации = "УНФ" Тогда
		Если ТипЗнч(Результат) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетФактураВыданный") Тогда
			Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат, "ДокументОснование");
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура Б24_К_ДобавлениеЭлементовФормы()
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ИмяПодменю = "Б24_К_ПодГруппаКомандБитрикс24";	
	Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" Тогда
		НовыйЭлемент 			= Элементы.Добавить(ИмяПодменю, Тип("ГруппаФормы"), Элементы.КоманднаяПанельЛеваяЧасть);
	ИначеЕсли ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
		ИмяГруппы = "Б24_К_ГруппаКомандБитрикс24";
		НоваяКоманднаяПанель = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Элементы.ГруппаКоманднаяПанель);
		НоваяКоманднаяПанель.Вид = ВидГруппыФормы.КоманднаяПанель;
		НоваяКоманднаяПанель.Ширина = ?(ТипКонфигурации = "УНФ", 2, 3);
		Элементы.Переместить(НоваяКоманднаяПанель, Элементы.ГруппаКоманднаяПанель, Элементы.НастройкаКоличестваКопий); 
		НовыйЭлемент 			= Элементы.Добавить(ИмяПодменю, Тип("ГруппаФормы"), НоваяКоманднаяПанель);
	КонецЕсли;	
	НовыйЭлемент.Вид 		= ВидГруппыФормы.Подменю;
	НовыйЭлемент.Заголовок 	= "Битрикс24";     
	НовыйЭлемент.Картинка 	= БиблиотекаКартинок.Б24_К_Лого;
	НовыйЭлемент.Отображение= ОтображениеКнопки.КартинкаИТекст;
	
	Если Б24_КБ_ВестиРеестрПечатныхФорм = Истина Тогда  
		
		ИмяКоманды = "Б24_КБ_КомандаОтправитьВРеестр";
		НовыйЭлемент 			= Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы[ИмяПодменю]);
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;
		НовыйЭлемент.Заголовок 	= "В реестр";     
		Элементы.Переместить(НовыйЭлемент, Элементы[ИмяПодменю]); 
		
	КонецЕсли;
	
	Если Б24_КЭ_ЭкспортПечатныхФорм = Истина Тогда  
		                        
		ИмяКоманды = "Б24_КЭ_КомандаОтправитьВБитрикс24";
		НовыйЭлемент 			= Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы[ИмяПодменю]);
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;
		НовыйЭлемент.Заголовок 	= "В живую ленту";     
		Элементы.Переместить(НовыйЭлемент, Элементы[ИмяПодменю]); 
		
	КонецЕсли;
	
	
	Если Б24_КБ_ВыгрузкаПечатныхФорм ИЛИ Б24_КС_ВыгрузкаПечатныхФорм Тогда
		
		ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТипыДанных"			, Б24_К_RestApiВызовСервера.ПолучитьТипыДанныхДел());    
		Запрос.УстановитьПараметр("ТипОбъекта"			, Б24_К_ОбъектДляЭкспорта.Метаданные().ПолноеИмя());
		Запрос.УстановитьПараметр("ИдентификаторОбъекта", XMLСтрока(Б24_К_ОбъектДляЭкспорта));
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор КАК Идентификатор
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
		|ГДЕ
		|	Б24_К_ИдентификаторыДел.ТипДанных В(&ТипыДанных)
		|	И Б24_К_ИдентификаторыДел.ТипОбъекта = &ТипОбъекта
		|	И Б24_К_ИдентификаторыДел.ИдентификаторОбъекта = &ИдентификаторОбъекта";
		ВыполненныйЗапрос = Запрос.Выполнить();
		
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			ИмяКоманды = "Б24_КБС_КомандаЭкспорт";
			НовыйЭлемент 			= Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы[ИмяПодменю]);
			НовыйЭлемент.ИмяКоманды = ИмяКоманды;
			НовыйЭлемент.Заголовок 	= "В таймлайн Битрикс24";     
			Элементы.Переместить(НовыйЭлемент, Элементы[ИмяПодменю]); 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Реестр

&НаКлиенте
Процедура Б24_КБ_КомандаОтправитьВРеестр(Команда)
	
	КоличествоНастроек = ПолучитьКоличествоНастроекПодключенияИнтеграцииСервисов("РеестрПечатныхФорм", Истина);
	
	Если КоличествоНастроек > 1 Тогда
		
		ВыбЗнач = Неопределено;
		
		Массив = Новый Массив;
		Массив.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("Б24_КБ_ЭкспортПечФорм_ПослеВводаНастройкиДляРеестра",ЭтотОбъект );

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку подключения", ОписаниеТипов);	
		
	ИначеЕсли КоличествоНастроек = 1 Тогда
		
		лПараметры = Новый Структура;	
		Б24_КБ_ЭкспортПечФорм_ПослеВводаНастройкиДляРеестра(ПолучитьНастройкуПодключенияПоУмолчаниюИнтеграцииСервиса("РеестрПечатныхФорм", Истина), лПараметры);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_КБ_ЭкспортПечФорм_ПослеВводаНастройкиДляРеестра(НастройкаПодключения, ПередаваемыеПараметры) Экспорт
	
	Если НастройкаПодключения <> Неопределено Тогда
		
		Если НЕ Б24_К_СлужебныйВызовСервера.МодульРеестраПечатныхФормДоступен(НастройкаПодключения) Тогда
			Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаРеестраПечатныхФормПоТарифномуПлану();
			Возврат;
		КонецЕсли;                          
		
		НастройкиИнтеграцииСервисов = ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
		Если НЕ НастройкиИнтеграцииСервисов.РеестрПечатныхФорм Тогда
			ПоказатьОповещениеПользователя("В настройке недоступен функционал реестра печатных форм.");
			Б24_КБ_КомандаОтправитьВРеестр(Неопределено);
			Возврат;
		КонецЕсли;
		
		Результат = Б24_КБ_РеестрПечатныхФормВызовСервера.ДобавитьВРеестр(НастройкаПодключения, Б24_К_КонтрагентДляЭкспорта, Б24_К_ОбъектДляЭкспорта, Б24_К_НазваниеПечатнойФормы, ТекущаяПечатнаяФорма);
		
		Если Результат = Истина Тогда
			ПоказатьОповещениеПользователя("В реестр добавлено");
		Иначе
			ПоказатьОповещениеПользователя("Не удалось добавить в реестр");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

