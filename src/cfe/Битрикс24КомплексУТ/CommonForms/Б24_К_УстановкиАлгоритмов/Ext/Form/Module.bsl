
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КлючРезультат 			= "[Результат]";
	КлючОбщиеНастройки 		= "[СтруктураНастроек]";
	КлючОбъект 				= "[Объект1С]";
	КлючСтрокаТаблицыОбъект = "[СтрокаТаблицыОбъекта1С]";
	КлючОтказ 				= "[Отказ]";
	
	Элементы.ГруппаРезультат.Видимость 				= Параметры.Тип = "Функция";
	Элементы.ГруппаСтрокаТаблицыОбъекта1С.Видимость = Параметры.Свойство("ЭтоСтрокаТЧ");
	
	СоставныеКлючи = Ложь;
	Если Параметры.Свойство("СоставныеКлючи") Тогда СоставныеКлючи = Параметры.СоставныеКлючи КонецЕсли;
	
	Если Параметры.Свойство("Алгоритм") Тогда
		Алгоритм = Параметры.Алгоритм	
	Иначе
		     
		Если Параметры.Тип = "Функция" Тогда
			Алгоритм = "//  Пример алгоритма:
			|
			|[Результат] = [Объект1С].Наименование;";
		Иначе
			Алгоритм = "//  Примеры алгоритма:
			|
			|[Объект1С].УстановитьНовыйКод();   // При загрузке в 1С устанавливается новый код    
			|
			|[СтруктураДанных].TITLE = [СтруктураДанных].TITLE  + "" Новый""; // при выгрузке на портал в заголовок добавляется слово 'Новый'";
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.Свойство("КлючиПортала") Тогда //для совместимости
		
		Для каждого ТекЭлемент Из Параметры.КлючиПортала Цикл 
			
			Если СоставныеКлючи Тогда 
				Если Параметры.Назначение = "Загрузка" Тогда
					ТаблицаКлючейПортала.Добавить("[ОбъектПортала]."+ТекЭлемент.Значение, ТекЭлемент.Представление);
				Иначе
				КонецЕсли;
			Иначе
				Если Параметры.Назначение = "Загрузка" Тогда
					ТаблицаКлючейПортала.Добавить("[ОбъектПортала].Получить("""+ТекЭлемент.Значение+""")", ТекЭлемент.Представление);
				Иначе
					ТаблицаКлючейПортала.Добавить("[СтруктураДанных]."+ТекЭлемент.Значение, ТекЭлемент.Представление);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	
		Элементы.ГруппаКлючиПортала.Видимость = Истина;
	Иначе
		Элементы.ГруппаКлючиПортала.Видимость = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("КлючиШапкиПортала") Тогда
		
		Для каждого ТекЭлемент Из Параметры.КлючиШапкиПортала Цикл 
			
			Если СоставныеКлючи Тогда 
				Если Параметры.Назначение = "Загрузка" Тогда
					ТаблицаКлючейШапкиПортала.Добавить("[КлючиШапкиПортала]."+ТекЭлемент.Значение, ТекЭлемент.Представление);
				Иначе
				КонецЕсли;
			Иначе
				Если Параметры.Назначение = "Загрузка" Тогда
					ТаблицаКлючейШапкиПортала.Добавить("[КлючиШапкиПортала].Получить("""+ТекЭлемент.Значение+""")", ТекЭлемент.Представление);
				Иначе
					ТаблицаКлючейШапкиПортала.Добавить("[СтруктураДанных]."+ТекЭлемент.Значение, ТекЭлемент.Представление);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	
		Элементы.ГруппаКлючиШапкиПортала.Видимость = Истина;
	Иначе
		Элементы.ГруппаКлючиШапкиПортала.Видимость = Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("КлючиТЧПортала") Тогда
		
		Для каждого ТекЭлемент Из Параметры.КлючиТЧПортала Цикл 
			
			Если СоставныеКлючи Тогда 
				Если Параметры.Назначение = "Загрузка" Тогда
					ТаблицаКлючейТЧПортала.Добавить("[КлючиТЧПортала]."+ТекЭлемент.Значение, ТекЭлемент.Представление);
				Иначе
				КонецЕсли;
			Иначе
				Если Параметры.Назначение = "Загрузка" Тогда
					ТаблицаКлючейТЧПортала.Добавить("[КлючиТЧПортала].Получить("""+ТекЭлемент.Значение+""")", ТекЭлемент.Представление);
				Иначе
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Элементы.ГруппаКлючиТЧПортала.Видимость = Истина;
	Иначе
		Элементы.ГруппаКлючиТЧПортала.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаОтказ.Видимость = НЕ Параметры.Тип = "Функция";
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаОтмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрименить(Команда)
	Закрыть(Алгоритм);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПараметрКлючаПортала(Команда)   
	
	ТекущиеДанные = Элементы.ТаблицаКлючейПортала.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Алгоритм = Алгоритм + ТекущиеДанные.Значение;
	КонецЕсли;
	
	ТекущийЭлемент = Элементы.Алгоритм;
	Длина = СтрДлина(Алгоритм) + 1;
	ОбновитьОтображениеДанных(Элементы.Алгоритм);
	Элементы.Алгоритм.УстановитьГраницыВыделения(Длина, Длина);
	
КонецПроцедуры

