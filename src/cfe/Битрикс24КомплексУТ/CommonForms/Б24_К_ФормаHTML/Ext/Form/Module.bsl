
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПолеHTML 			= Параметры.Адрес;
	Объект	            = Параметры.Объект;
	
	Если ЗначениеЗаполнено(Параметры.ЗаголовокФормы) Тогда
		Заголовок 	= Параметры.ЗаголовокФормы;
	Иначе
		ОтображатьЗаголовок = Ложь;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект) Тогда
		ПервоначальнаяВерсия = Объект.ВерсияДанных;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ПервоначальнаяВерсия) Тогда
		ПодключитьОбработчикОжидания("ПроверитьМодифицированностьДанных", 5);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМодифицированностьДанных()
	
	НоваяВерсияДанных = ПолучитьВерсиюДанных();
	Если ПервоначальнаяВерсия <> НоваяВерсияДанных Тогда
		ПолеHTML = ПолеHTML + " ";
		ПервоначальнаяВерсия = НоваяВерсияДанных;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВерсиюДанных() 
	
	Возврат Объект.ВерсияДанных;
	
КонецФункции
