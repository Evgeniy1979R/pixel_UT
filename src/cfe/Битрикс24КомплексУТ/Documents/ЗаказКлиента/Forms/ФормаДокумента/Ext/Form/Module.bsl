
#Область СобытияФормы

&НаСервере
Процедура Б24_К_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

#Область Автоматизация			
	Б24_КА_РоботыИТриггерыСервер.ДобавлениеЭлементовФормыДляТриггеров(ЭтотОбъект);
#КонецОбласти 

#Область РаботаИзОдногоОкна
	Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ДобавлениеЭлементовФормыНастроекИнтеграцииСервисов(ЭтотОбъект);
#КонецОбласти

КонецПроцедуры

&НаСервере
Процедура Б24_К_ПриЗаписиНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект,"ПараметрыБ24") 
		и НЕ ЭтотОбъект.ПараметрыБ24 = Неопределено
		и ЭтотОбъект.ПараметрыБ24.Свойство("ДанныеСущностиБитрикс24") Тогда
		
		ДанныеСущностиБитрикс24 = ЭтотОбъект.ПараметрыБ24.ДанныеСущностиБитрикс24;	
		СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(ДанныеСущностиБитрикс24.НастройкаПодключения);
		НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(ДанныеСущностиБитрикс24.НастройкаПодключения);		
		Если НастройкиИнтеграцииСервисов.Настройки.Получить() = Неопределено Тогда
			НастройкиИнтеграцииСервисов.Настройки = Новый ХранилищеЗначения(РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоУмолчанию());	
		КонецЕсли;		
		СохраненныеНастройки = НастройкиИнтеграцииСервисов.Настройки.Получить();
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СохраненныеНастройки, "ПривязыватьЗаказКСделке") Тогда
			ПривязыватьЗаказКСделке = СохраненныеНастройки.ПривязыватьЗаказКСделке;
		Иначе
			ПривязыватьЗаказКСделке = Ложь;
		КонецЕсли;	
		Если ПривязыватьЗаказКСделке и ДанныеСущностиБитрикс24.ТипВладельца = "2" Тогда 
			РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(
			СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.Сделка, ТекущийОбъект.Ссылка, ДанныеСущностиБитрикс24.ИдентификаторВладельца);
			ПараметрыЗапроса = Б24_К_ВыгрузкаДелСервер.ПолучитьТелоЗапросаДела(СтруктураНастроек, "Стандартное", ДанныеСущностиБитрикс24.ТипВладельца,
			ДанныеСущностиБитрикс24.ИдентификаторВладельца, "", ТекущийОбъект.Ссылка,, Истина);
			ДелоСоздано = Б24_К_ВыгрузкаДелСервер.ДелоСозданоВБитрикс24(СтруктураНастроек, "Стандартное", ПараметрыЗапроса,
			ТекущийОбъект.Ссылка, ДанныеСущностиБитрикс24.ТипВладельца, ДанныеСущностиБитрикс24.ИдентификаторВладельца, СтруктураНастроек.ТипыОбъектовОбмена.ДелоСделки);  
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область РаботаСТриггерамиИРоботами

&НаКлиенте
Процедура Б24_КА_ОтправитьСообщениеОК(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Б24_КА_РоботыИТриггерыКлиент.ОтправкаСообщенияВСущность(Объект.Ссылка, Объект.Контрагент, "ДокументКорректный"); 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Б24_КА_ОтправитьСообщениеОшибка(Команда)	
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Б24_КА_РоботыИТриггерыКлиент.ОтправкаСообщенияВСущность(Объект.Ссылка, Объект.Контрагент, "ОшибкаВДокументе"); 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти     
