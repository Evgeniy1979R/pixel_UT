#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("ПриКопировании")
Процедура Б24_К_ПриКопировании(ОбъектКопирования)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ИмяТабличнойЧасти = ?(ТипКонфигурации = "УНФ", "Запасы", "Товары");
	
	Для каждого ТекСтрока Из ЭтотОбъект[ИмяТабличнойЧасти] Цикл
		ТекСтрока.Б24_К_ИдентификаторПозиции = "";	
	КонецЦикла;
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура Б24_К_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ИмяТабличнойЧасти = ?(ТипКонфигурации = "УНФ", "Запасы", "Товары");
	
	мИдентификаторы = Новый Массив;
	Для каждого ТекТовар Из ЭтотОбъект[ИмяТабличнойЧасти] Цикл
		
		Если мИдентификаторы.Найти(ТекТовар.Б24_К_ИдентификаторПозиции) <> Неопределено Тогда
			ТекТовар.Б24_К_ИдентификаторПозиции = "";	
			Продолжить;
		КонецЕсли;
		
		мИдентификаторы.Добавить(ТекТовар.Б24_К_ИдентификаторПозиции);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Б24_К_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	Если ТипКонфигурации = "УНФ" Тогда
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект["ВидОперации"]) Тогда
			Если ТипЗнч(ДанныеЗаполнения) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплату") ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Контрагенты") Тогда
				ЭтотОбъект["ВидОперации"] = Перечисления["ВидыОперацийЗаказПокупателя"]["ЗаказНаПродажу"];
				ДатаОтгрузки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса()+7*24*60*60;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&Перед("ОбработкаПроведения")
Процедура Б24_К_ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  	

	Б24_КС_ОбщегоНазначенияВызовСервера.УстановитьДопСвойствоЗагрузкаСБитрикс24ПодчРегистрам(Движения, ДополнительныеСвойства); 
	
КонецПроцедуры

&Перед("ОбработкаУдаленияПроведения")
Процедура Б24_К_ОбработкаУдаленияПроведения(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  	

	Б24_КС_ОбщегоНазначенияВызовСервера.УстановитьДопСвойствоЗагрузкаСБитрикс24ПодчРегистрам(Движения, ДополнительныеСвойства); 
	
КонецПроцедуры

#КонецЕсли
