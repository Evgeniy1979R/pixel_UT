
#Область СобытияФормы

&НаСервере
Процедура Б24_К_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
#Область Автоматизация			
	Б24_КА_РоботыИТриггерыСервер.ДобавлениеЭлементовФормыДляТриггеров(ЭтотОбъект);
#КонецОбласти

КонецПроцедуры

#КонецОбласти


#Область РаботаСоСлайдером

&НаСервере
Процедура Б24_КБ_ЗаполнитьДанныеДокумента(ДанныеДокумента)
	  
	Объект.Партнер 	= ДанныеДокумента.Партнер;	
	Объект.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("Партнер", Объект.Партнер); 	
	
	Б24_КБ_ИдентификаторВладельца 	= ДанныеДокумента.ИдентификаторВладельца;
	Б24_КБ_ТипВладельца 			= ДанныеДокумента.ТипВладельца;
	
	Если ДанныеДокумента.Свойство("Товары") Тогда
		
		Для каждого ТекСтрока Из ДанныеДокумента.Товары Цикл 
			НоваяСтрока = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область РаботаСТриггерамиИРоботами

&НаКлиенте
Процедура Б24_КА_ОтправитьСообщениеОК(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Б24_КА_РоботыИТриггерыКлиент.ОтправкаСообщенияВСущность(Объект.Ссылка, Объект.Контрагент, "ДокументКорректный"); 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Б24_КА_ОтправитьСообщениеОшибка(Команда)	
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Б24_КА_РоботыИТриггерыКлиент.ОтправкаСообщенияВСущность(Объект.Ссылка, Объект.Контрагент, "ОшибкаВДокументе"); 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти     
