
#Область СобытияФормы

&НаСервере
Процедура Б24_К_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
#Область Автоматизация			
	Б24_КА_РоботыИТриггерыСервер.ДобавлениеЭлементовФормыДляТриггеров(ЭтотОбъект);
#КонецОбласти

КонецПроцедуры

#КонецОбласти


#Область РаботаСТриггерамиИРоботами

&НаКлиенте
Процедура Б24_КА_ОтправитьСообщениеОК(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Б24_КА_РоботыИТриггерыКлиент.ОтправкаСообщенияВСущность(Объект.Ссылка, Объект.Контрагент, "ДокументКорректный"); 
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Б24_КА_ОтправитьСообщениеОшибка(Команда)	
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Б24_КА_РоботыИТриггерыКлиент.ОтправкаСообщенияВСущность(Объект.Ссылка, Объект.Контрагент, "ОшибкаВДокументе"); 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти     
