#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура Б24_К_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	лОснование = ДанныеЗаполнения; 
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Объект = ЭтотОбъект;
	
	Если ТипКонфигурации = "УНФ" Тогда
		ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
		
		Если НЕ ЗначениеЗаполнено(Объект["Статья"]) Тогда
			Объект["Статья"] = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.СтатьиДвиженияДенежныхСредств.ОплатаОтПокупателей");
		КонецЕсли;
	Иначе
		Если ТипЗнч(лОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
			ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"]["ВозвратДенежныхСредствОтПоставщика"];
		Иначе
			ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"]["ПоступлениеОплатыОтКлиента"];
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект["ТипПлатежногоДокумента"]) Тогда
			Объект["ТипПлатежногоДокумента"]	= Перечисления["ТипыПлатежныхДокументов"]["ПлатежноеПоручение"];
		КонецЕсли;
		
		ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
		
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			Контрагент	= лОснование.Контрагент;  
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			Организация	= лОснование.Организация;  
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект["Валюта"]) Тогда
			Объект["Валюта"]	= лОснование.Валюта;  
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(БанковскийСчет) Тогда
			БанковскийСчетОснования = Неопределено;
			РеквизитыОснования = лОснование.Метаданные().Реквизиты;
			Если РеквизитыОснования.Найти("БанковскийСчет") <> Неопределено Тогда
				БанковскийСчетОснования	= лОснование.БанковскийСчет;
			ИначеЕсли РеквизитыОснования.Найти("БанковскийСчетОрганизации") <> Неопределено Тогда
				БанковскийСчетОснования	= лОснование.БанковскийСчетОрганизации;
			КонецЕсли;
	
			БанковскийСчет 	= Б24_КС_ОбщегоНазначенияВызовСервера.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(
				лОснование.Организация, Неопределено, БанковскийСчетОснования, Неопределено, Неопределено);
		КонецЕсли;
		
		
		Если НЕ ЗначениеЗаполнено(Объект["СтатьяДвиженияДенежныхСредств"]) Тогда
			Объект["СтатьяДвиженияДенежныхСредств"]	= Справочники["СтатьиДвиженияДенежныхСредств"]["ПоступлениеОплатыОтКлиента"];
		КонецЕсли;
		
		Для каждого ТекСтрока Из Объект.РасшифровкаПлатежа Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрока["СтатьяДвиженияДенежныхСредств"]) Тогда
				ТекСтрока["СтатьяДвиженияДенежныхСредств"] = Объект["СтатьяДвиженияДенежныхСредств"];
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекСтрока.Организация) Тогда
				ТекСтрока.Организация = Организация;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекСтрока["ВалютаВзаиморасчетов"]) Тогда
				ТекСтрока["ВалютаВзаиморасчетов"] = Объект["Валюта"];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли
