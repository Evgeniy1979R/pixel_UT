#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("ПриКопировании")
Процедура Б24_К_ПриКопировании(ОбъектКопирования)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УНФ" Тогда
		Для каждого ТекСтрока Из ЭтотОбъект["Запасы"] Цикл
			ТекСтрока["Б24_К_ИдентификаторПозиции"] = "";
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура Б24_К_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
КонецПроцедуры

&Перед("ОбработкаПроведения")
Процедура Б24_К_ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  	

	Б24_КС_ОбщегоНазначенияВызовСервера.УстановитьДопСвойствоЗагрузкаСБитрикс24ПодчРегистрам(Движения, ДополнительныеСвойства); 
	
КонецПроцедуры

&Перед("ОбработкаУдаленияПроведения")
Процедура Б24_К_ОбработкаУдаленияПроведения(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  	

	Б24_КС_ОбщегоНазначенияВызовСервера.УстановитьДопСвойствоЗагрузкаСБитрикс24ПодчРегистрам(Движения, ДополнительныеСвойства); 
	
КонецПроцедуры

#КонецЕсли
