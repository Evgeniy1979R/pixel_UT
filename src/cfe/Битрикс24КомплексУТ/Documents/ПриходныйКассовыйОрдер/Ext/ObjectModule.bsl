#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура Б24_К_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	лОснование = ДанныеЗаполнения; 
	Объект = ЭтотОбъект;
	ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	
	Если ТипКонфигурации = "УТ" Тогда
		Если ТипЗнч(лОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
			Объект["ХозяйственнаяОперация"] = Перечисления["ХозяйственныеОперации"]["ВозвратДенежныхСредствОтПоставщика"];
		Иначе
			Объект["ХозяйственнаяОперация"] = Перечисления["ХозяйственныеОперации"]["ПоступлениеОплатыОтКлиента"];
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
			Объект.Контрагент	= лОснование.Контрагент;  
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			Объект.Организация	= лОснование.Организация;  
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект["Валюта"]) Тогда
			Объект["Валюта"]	= лОснование.Валюта;  
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект["Касса"]) Тогда
			СтруктураПараметров = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ДенежныеСредстваСервер").ПараметрыЗаполненияКассыОрганизацииПоУмолчанию();
			СтруктураПараметров.Организация = лОснование.Организация;
			Если лОснование.Метаданные().Реквизиты.Найти("ФормаОплаты") <> Неопределено Тогда
				СтруктураПараметров.ФормаОплаты	= лОснование.ФормаОплаты;
			КонецЕсли;
			Если лОснование.Метаданные().Реквизиты.Найти("Касса") <> Неопределено Тогда
				СтруктураПараметров["Касса"] = лОснование["Касса"];
			КонецЕсли;
			Объект["Касса"] = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ЗначениеНастроекПовтИсп").ПолучитьКассуОрганизацииПоУмолчанию(СтруктураПараметров);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект["СтатьяДвиженияДенежныхСредств"]) Тогда
			Объект["СтатьяДвиженияДенежныхСредств"]	= Справочники["СтатьиДвиженияДенежныхСредств"]["ПоступлениеОплатыОтКлиента"];
		КонецЕсли;
		
		Для каждого ТекСтрока Из Объект.РасшифровкаПлатежа Цикл
			Если НЕ ЗначениеЗаполнено(ТекСтрока["СтатьяДвиженияДенежныхСредств"]) Тогда
				ТекСтрока["СтатьяДвиженияДенежныхСредств"] = Объект["СтатьяДвиженияДенежныхСредств"];
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекСтрока.Организация) Тогда
				ТекСтрока.Организация = Объект.Организация;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекСтрока["ВалютаВзаиморасчетов"]) Тогда
				ТекСтрока["ВалютаВзаиморасчетов"] = Объект["Валюта"];
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		Если НЕ ЗначениеЗаполнено(Объект["Статья"]) Тогда
			Объект["Статья"] = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.СтатьиДвиженияДенежныхСредств.ОплатаОтПокупателей");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли
