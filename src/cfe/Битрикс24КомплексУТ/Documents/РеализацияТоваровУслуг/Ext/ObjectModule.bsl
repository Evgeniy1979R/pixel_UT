
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("ПриКопировании")
Процедура Б24_К_ПриКопировании(ОбъектКопирования)

	// «Б24_К_КлючСвязи» — собственный реквизит табличных частей, добавленный сборками линейки БП.
	// В УТ, КА (в том числе в ERP) и их Фреш-сборках реквизита нет, и обращение к нему роняло
	// копирование документа с «Поле объекта не обнаружено (Б24_К_КлючСвязи)».
	Если НЕ Б24_К_ЕстьРеквизитКлючСвязи() Тогда
		Возврат;
	КонецЕсли;

	Для каждого ТекСтрока Из Товары Цикл
		ТекСтрока.Б24_К_КлючСвязи = "";	
	КонецЦикла;
	
	Если Метаданные().ТабличныеЧасти.Найти("Услуги") <> Неопределено Тогда
		Для каждого ТекСтрока Из ЭтотОбъект["Услуги"] Цикл
			ТекСтрока.Б24_К_КлючСвязи = "";	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, объявлен ли реквизит «Б24_К_КлючСвязи» в табличной части «Товары» документа.
// Реквизит есть только в сборках линейки БП; в УТ/КА/ERP его нет, и очищать при копировании нечего.
//
// Возвращаемое значение:
//  Булево - Истина, если реквизит есть и его нужно очищать при копировании.
//
Функция Б24_К_ЕстьРеквизитКлючСвязи()

	ТЧТовары = Метаданные().ТабличныеЧасти.Найти("Товары");
	Если ТЧТовары = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТЧТовары.Реквизиты.Найти("Б24_К_КлючСвязи") <> Неопределено;

КонецФункции

Процедура Б24_К_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	лОснование = ДанныеЗаполнения; 
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Объект = ЭтотОбъект;
	
	ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	
	Если ТипКонфигурации = "УТ" Тогда
		Если ТипЗнч(ДанныеЗаполнения) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказКлиента") Тогда
		
			Если НЕ ЗначениеЗаполнено(Объект["СпособДоставки"]) Тогда
				Объект["СпособДоставки"]	= лОснование["СпособДоставки"];  
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ВозвратТоваровОтКлиента") Тогда
			Объект["Статус"] 							= Перечисления["СтатусыРеализацийТоваровУслуг"]["КПредоплате"];
			Объект["СпособДоставки"] 					= Перечисления["СпособыДоставки"]["Самовывоз"];
			Объект["ВариантОформленияПродажи"] 		= Перечисления["ВариантыОформленияПродажи"]["РеализацияТоваровУслуг"];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли             
