#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура Б24_К_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	
	Если ТипКонфигурации = "УНФ" Тогда
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект["ВидОперации"]) Тогда
			Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
				ЭтотОбъект["ВидОперации"] = Перечисления["ВидыОперацийЗаказПоставщику"]["ЗаказНаЗакупку"];
				ДатаПоступления = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса()+7*24*60*60;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли
