
#Область Триггеры

Процедура ОтправкаСообщенияВСущность(Объект, Контрагент, ТипСообщения) Экспорт
	
	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("Объект"			, Объект);
	ПередаваемыеПараметры.Вставить("Контрагент"		, Контрагент);
	ПередаваемыеПараметры.Вставить("ТипСообщения"	, ТипСообщения);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаОписанияСообщенияВСущность", ЭтотОбъект, ПередаваемыеПараметры);
	
	Если ТипСообщения = "ОшибкаВДокументе" Тогда
		
		Подсказка = "Введите описание ошибки";
		
		ПоказатьВводСтроки(Оповещение, "", Подсказка, 0, Истина);
		
	Иначе
		
		Подсказка = "Введите текст подтверждения";
		
		ПоказатьВводСтроки(Оповещение, "Подтверждение корректности", Подсказка, 0, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеВводаОписанияСообщенияВСущность(Строка, Параметры) Экспорт
	
	Если НЕ Строка = Неопределено Тогда 				
		Б24_КА_РоботыИТриггерыВызовСервера.ВыгрузкаСообщенияВБитрикс24(Строка, Параметры);		
	КонецЕсли;
	
КонецПроцедуры

