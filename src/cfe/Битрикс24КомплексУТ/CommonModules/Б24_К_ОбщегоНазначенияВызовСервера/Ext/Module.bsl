	Результат.Вставить("РассылкаПисемСОшибками"	, "(Битрикс24: Базовая подсистема УП) Выполнение оповещения об ошибках во время синхронизации с Битрикс24");
	Результат.Вставить("ОчисткаЛога"			, "(Битрикс24: Базовая подсистема УП) Удаление устаревших записей истории взаимодействия с Битрикс24");
	Результат.Вставить("ОбменДанных"			, "(Битрикс24: КЭДО) Выгрузка в Битрикс24: ");
	Результат.Вставить("ВыгрузкаВРежимеРВ"		, "(Битрикс24: КЭДО) Выгрузка элементов в режиме реального времени");
	Возврат Результат;

КонецФункции

Функция СейчасВыполняетсяЗадание(НазваниеЗадания) Экспорт

	НачалоОтбораФоновыхЗаданий = ТекущаяДатаСеанса() - 60*60*12;

	мФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Начало, Состояние, Наименование", НачалоОтбораФоновыхЗаданий, СостояниеФоновогоЗадания.Активно, НазваниеЗадания));

	Если мФоновыеЗадания.Количество() > 0 Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ВыгрузитьВсеНастройкиНаПортал(ПараметрыНастроек, АдресРезультата = "") Экспорт

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипЗнч(ПараметрыНастроек) = Тип("Структура") Тогда
		НастройкаПодключения 	= ПараметрыНастроек.НастройкаПодключения;
		СтруктураНастроек 		= ПараметрыНастроек.СтруктураНастроек;
	Иначе
		НастройкаПодключения 	= ПараметрыНастроек;
		СтруктураНастроек 		= Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	КонецЕсли;

	Успешно = Справочники.Б24_К_НастройкиПодключения.ВыгрузитьНастройки(НастройкаПодключения);

	Если НЕ Успешно Тогда
		ВызватьИсключение("НеУдалосьВыгрузитьНАстройкиПодключения");
	КонецЕсли;

	// Реквизита "КЭДО" нет в сборках без блока КЭДО (УНФ): запрашиваем его только при наличии,
	// иначе платформа падает с «Поле объекта "КЭДО" не существует».
	ЕстьРеквизитКЭДО = Метаданные.Справочники.Б24_К_НастройкиПодключения.Реквизиты.Найти("КЭДО") <> Неопределено;

	РеквизитыНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаПодключения,
		?(ЕстьРеквизитКЭДО, "КЭДО, Наименование", "Наименование"));
	КЭДО = Ложь;
	Если ЕстьРеквизитКЭДО Тогда
		КЭДО = РеквизитыНастройки.КЭДО;
	КонецЕсли;

	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО") И КЭДО Тогда
		РегистрыСведений["Б24_УП_НастройкиКЭДО"].ВыгрузитьНастройки(НастройкаПодключения);
	КонецЕсли;

	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("РаботаИзОдногоОкна") Тогда

		НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
		Если НастройкиИнтеграцииСервисов.Настройки <> Неопределено Тогда

			НастройкиОбмена = НастройкиИнтеграцииСервисов.Настройки.Получить();
			ЭтоЗУП = ТипКонфигурации = "ЗУП";
			ВыгружатьЗУП = ЭтоЗУП и НастройкиОбмена.Свойство("СущностиДляРаботыИзОдногоОкна");
			ВыгружатьОстальное = НЕ ЭтоЗУП и НастройкиОбмена.Свойство("ВстройкиСсылочныхДанных");
			Если НастройкиОбмена <> Неопределено и (ВыгружатьЗУП или ВыгружатьОстальное) Тогда

				ПараметрыВыгрузки = Новый Структура;
				ПараметрыВыгрузки.Вставить("НастройкаПодключения"	, НастройкаПодключения);
				ПараметрыВыгрузки.Вставить("Наименование"			, РеквизитыНастройки.Наименование);
				ПараметрыВыгрузки.Вставить("СтруктураНастроек"		, СтруктураНастроек);
				Если ЭтоЗУП Тогда
					ПараметрыВыгрузки.Вставить("СущностиДляРаботыИзОдногоОкна"	, НастройкиОбмена.СущностиДляРаботыИзОдногоОкна);
					ПараметрыВыгрузки.Вставить("УдалитьВстройки"				, Ложь);
				Иначе
					ПараметрыВыгрузки.Вставить("ВстройкиСсылочныхДанных", НастройкиОбмена.ВстройкиСсылочныхДанных);
					ПараметрыВыгрузки.Вставить("ВстройкиОтчетов"		, НастройкиОбмена.ВстройкиОтчетов);
				КонецЕсли;

				РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьУдалитьВстройкиБитрикс24(ПараметрыВыгрузки);

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда

		ПараметрыВыгрузки = Новый Структура;
		ПараметрыВыгрузки.Вставить("НастройкаПодключения" , НастройкаПодключения);

		РегистрыСведений["Б24_КС_НастройкиСинхронизации"].ВыгрузитьНастройкиВФоне(ПараметрыВыгрузки);

	КонецЕсли;

	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СмартПроцессы") Тогда

		ПараметрыВыгрузки = Новый Структура;
		ПараметрыВыгрузки.Вставить("НастройкаПодключения" , НастройкаПодключения);

		РегистрыСведений["Б24_СМ_НастройкиСмартПроцессов"].ВыгрузитьНастройкиВФоне(ПараметрыВыгрузки);

	КонецЕсли;

	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СкладскойУчет") Тогда

		МодульСУ = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ОбщегоНазначенияВызовСервераПовтИсп");

		НастройкаСинхронизации = МодульСУ.ПолучитьНастройкуПоНастройкеПодключения(НастройкаПодключения);

		СохраненныеНастройки = НастройкаСинхронизации.Настройки.Получить();
		Если СохраненныеНастройки = Неопределено Тогда
			Возврат истина;
		КонецЕсли;

		ПараметрыВыгрузки = Новый Структура;
		ПараметрыВыгрузки.Вставить("НастройкаПодключения"	, НастройкаПодключения);
		ПараметрыВыгрузки.Вставить("Наименование"			, РеквизитыНастройки.Наименование);
		ПараметрыВыгрузки.Вставить("РезервироватьТовары"	, СохраненныеНастройки.НастройкииЗаказов.РезервироватьТовары);
		ПараметрыВыгрузки.Вставить("ОтгружатьТовары"		, СохраненныеНастройки.НастройкииЗаказов.ОтгружатьТовары);

		РегистрыСведений["Б24_СУ_Настройки"].ВыгрузитьНастройкиВФоне(ПараметрыВыгрузки);

	КонецЕсли;

	// Перерегистрируем HCM Link события после всех подсистем,
	// т.к. некоторые модули (КС, СМ, СУ) сбрасывают их через event.get -> unbind all
	ПараметрыПеререгистрации = Новый Структура;
	ПараметрыПеререгистрации.Вставить("НастройкаПодключения", НастройкаПодключения);
	ПараметрыПеререгистрации.Вставить("Наименование", РеквизитыНастройки.Наименование);
	ПараметрыПеререгистрации.Вставить("СтруктураНастроек", СтруктураНастроек);

	Справочники.Б24_К_НастройкиПодключения.ДобавитьУдалитьВстройкиБитрикс24_КЭДО(ПараметрыПеререгистрации, Ложь);

	// Проверяем регистрацию событий после перерегистрации
	ПараметрыЗапросаСобытий = "&" + СтруктураНастроек.ПараметрКоннектора;
	РезультатСобытий = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/event.get", ПараметрыЗапросаСобытий);
	Если РезультатСобытий <> Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "События после выгрузки: " + Строка(РезультатСобытий));
	КонецЕсли;

	Возврат Истина

КонецФункции

