КонецФункции

// Возвращает структуру типов данных для обмена с порталом.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - структура, где ключ - имя значения перечисления Б24_УП_ТипыДанных,
//                        а значение - соответствующее значение перечисления Б24_УП_ТипыДанных.
//
Функция ТипыДанныхДляОбменаСПорталом() Экспорт

	СтруктураТиповДанных = Новый Структура;
	Для каждого ТекЭлемент Из Метаданные.Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом.ЗначенияПеречисления Цикл
		СтруктураТиповДанных.Вставить(ТекЭлемент.Имя, Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом[ТекЭлемент.Имя]);
	КонецЦикла;

	Результат = Новый ФиксированнаяСтруктура(СтруктураТиповДанных);

	Возврат Результат;

КонецФункции

// Возвращает соответствие ключей и структур с информацией об используемых падежах.
//
// Возвращаемое значение:
//  Соответствие - где ключ соответствует падежу, а значение - структура с полями "Имя" и "Значение",
//               где "Имя" - полное наименование падежа, "Значение" - сокращенное наименование падежа.
Функция КлючиИспользуемыхПадежей() Экспорт

	Результат = Новый Соответствие;

	Результат.Вставить("_IM",  Новый Структура("Имя, Значение", "ИменительныйПадеж"	, "(им.)"));
	Результат.Вставить("_RD",  Новый Структура("Имя, Значение", "РодительныйПадеж"	, "(род.)"));
	Результат.Вставить("_DT",  Новый Структура("Имя, Значение", "ДательныйПадеж"	, "(дат.)"));
	Результат.Вставить("_VN",  Новый Структура("Имя, Значение", "ВинительныйПадеж"	, "(вин.)"));
	Результат.Вставить("_TV",  Новый Структура("Имя, Значение", "ТворительныйПадеж"	, "(тв.)"));
	Результат.Вставить("_PR",  Новый Структура("Имя, Значение", "ПредложныйПадеж"	, "(пр.)"));

	Возврат Результат;

КонецФункции

// Возвращает структуру типов операций.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Структура типов операций:
//   * СопоставлениеСотрудников - Строка - "Отправка данных для сопоставления сотрудников".
//   * ОбработкаРезультатаСопоставления - Строка - "Обработка результата сопоставления сотрудников".
//   * ВыгрузкаПараметровСотрудников - Строка - "Отправка значений параметров КЭДО сотрудников".
//   * ЗагрузитьПодписанныеДокументы - Строка - "Загрузка подписанных документов".
//   * УдалитьПривязкиСотрудников - Строка - "Удаление привязок сотрудников к КЭДО".
//
Функция ТипыОпераций() Экспорт

	лСтруктура = Новый Структура;
	лСтруктура.Вставить("СопоставлениеСотрудников"			, "Отправка данных для сопоставления сотрудников");
	лСтруктура.Вставить("ОбработкаРезультатаСопоставления"	, "Обработка результата сопоставления сотрудников");
	лСтруктура.Вставить("ВыгрузкаПараметровСотрудников"		, "Отправка значений параметров КЭДО сотрудников");
	лСтруктура.Вставить("ЗагрузитьПодписанныеДокументы"		, "Загрузка подписанных документов");
	лСтруктура.Вставить("УдалитьПривязкиСотрудников"		, "Удаление привязок сотрудников к КЭДО");
	лСтруктура.Вставить("ОбновлениеСтатусовДокументовКЭДО"	, "Обновление статусов документов КЭДО");
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО") Тогда
		лСтруктура.Вставить("ЗапросПинКода"							, "Запрос пин кода");
		лСтруктура.Вставить("ЗапросРасчетногоЛистаОтпусков"			, "Запрос расчетного листка или отпусков");
	КонецЕсли;
	Результат = Новый ФиксированнаяСтруктура(лСтруктура);

	Возврат Результат;

КонецФункции

Функция ПолучитьТекущийSeanceId() Экспорт

    // 1. Помещаем пустое значение во временное хранилище.
    // УникальныйИдентификатор (второй параметр) нужен для привязки к форме,
    // но для простого получения адреса можно передать Новый УникальныйИдентификатор
    АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);

    // 2. АдресХранилища содержит строку вида "e1cib/tempstorage/GUID?seanceId=TOKEN"
    // Нам нужно найти начало параметра seanceId
    ПоисковаяСтрока = "seanceId=";
    ПозицияПараметра = СтрНайти(АдресХранилища, ПоисковаяСтрока);

    Если ПозицияПараметра = 0 Тогда
        // Если параметра нет, возможно, мы не в веб-клиенте или формат URL изменился
        Возврат "";
    КонецЕсли;

    // 3. Вычисляем начало самого токена
    НачалоТокена = ПозицияПараметра + СтрДлина(ПоисковаяСтрока);

    // 4. Извлекаем подстроку до конца строки (обычно seanceId идет последним параметром)
    // Если есть другие параметры (через &), нужно будет доработать парсинг
    ТекущийSeanceId = Сред(АдресХранилища, НачалоТокена);

    // Очищаем хвост, если вдруг там есть другие параметры (например &beaconAPI=true)
    ПозицияАмперсанда = СтрНайти(ТекущийSeanceId, "&");
    Если ПозицияАмперсанда > 0 Тогда
        ТекущийSeanceId = Лев(ТекущийSeanceId, ПозицияАмперсанда - 1);
    КонецЕсли;

    Возврат ТекущийSeanceId;

КонецФункции

#КонецОбласти

#Область ПредопределенныеАлгоритмы

// Функция СтруктураПараметровПредопределенногоАлгоритма возвращает структуру параметров для предопределенного алгоритма.
//
// Возвращаемое значение:
//  Структура - структура параметров, содержащая следующие ключи:
//   * Результат - Неопределено - значение результата выполнения алгоритма;
//   * СтруктураНастроек - Неопределено - структура настроек алгоритма;
//   * Организация - Неопределено - организация, для которой выполняется алгоритм;
//   * ФизическоеЛицо - Неопределено - физическое лицо, для которого выполняется алгоритм;
//   * Сотрудник - Неопределено - сотрудник, для которого выполняется алгоритм;
//   * ДатаПолученияДанных - Неопределено - дата получения данных для алгоритма.
//
Функция СтруктураПараметровПредопределенногоАлгоритма() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Результат"				, Неопределено);
	Результат.Вставить("СтруктураНастроек"		, Неопределено);
	Результат.Вставить("Организация"			, Неопределено);
	Результат.Вставить("ФизическоеЛицо"			, Неопределено);
	Результат.Вставить("Сотрудник"				, Неопределено);
	Результат.Вставить("ДатаПолученияДанных"	, Неопределено);

	Возврат Результат;

КонецФункции

// Выполняет предопределенный алгоритм и возвращает результат его выполнения.
//
// Параметры:
//  Алгоритм - Строка - Текст алгоритма для выполнения.
//  ПараметрыАлгоритма - Структура - Параметры для выполнения алгоритма.
//  ТипАлгоритма - Строка - Тип алгоритма ("Функция" или "Процедура").
//
// Возвращаемое значение:
// 	Неопределено
//  Структура - Результат выполнения алгоритма. Ключ Результат выполнения алгоритма, если ТипАлгоритма = "Функция".
//
Функция ЗначениеПредопределенногоАлгоритма(Алгоритм, ПараметрыАлгоритма, ТипАлгоритма) Экспорт

	Если ТипАлгоритма = "Функция" Тогда
		РезультатВыполнения = Новый Структура("Результат, Ошибка", ПараметрыАлгоритма.Результат, "");
	Иначе
		РезультатВыполнения = Неопределено;
	КонецЕсли;

Попытка

	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда

		АлгоритмКлюча = стрЗаменить(Алгоритм, "[Результат]"	, "Параметры.Результат");
		АлгоритмКлюча = стрЗаменить(АлгоритмКлюча, "[СтруктураНастроек]"	, "Параметры.СтруктураНастроек");
		АлгоритмКлюча = стрЗаменить(АлгоритмКлюча, "[Организация]"			, "Параметры.Организация");
		АлгоритмКлюча = стрЗаменить(АлгоритмКлюча, "[ФизическоеЛицо]"		, "Параметры.ФизическоеЛицо");
		АлгоритмКлюча = стрЗаменить(АлгоритмКлюча, "[Сотрудник]"			, "Параметры.Сотрудник");
		АлгоритмКлюча = стрЗаменить(АлгоритмКлюча, "[ДатаПолученияДанных]"	, "Параметры.ДатаПолученияДанных");

		ОбщегоНазначения.ВыполнитьВБезопасномРежиме(АлгоритмКлюча, ПараметрыАлгоритма);

		Если ТипАлгоритма = "Функция" Тогда
			РезультатВыполнения.Результат = ПараметрыАлгоритма.Результат;
		КонецЕсли;

	КонецЕсли;

Исключение

	ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	РезультатВыполнения.Ошибка = ПодробноеПредставлениеОшибки;

	ЗаписьЖурналаРегистрации("ОтправкаПисемСОшибкамиСинхронизации", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось выполнить пользовательский алгоритм");
	ЗаписьЖурналаРегистрации("ОтправкаПисемСОшибкамиСинхронизации", УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки);

КонецПопытки;

	Возврат РезультатВыполнения;

КонецФункции

#КонецОбласти
