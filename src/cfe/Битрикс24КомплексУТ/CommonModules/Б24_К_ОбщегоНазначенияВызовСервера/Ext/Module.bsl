// Возвращает структуру с ключами регламентных заданий, используемых в конфигурации.
//
// Возвращаемое значение:
//  Структура - Ключ - Строка - Имя регламентного задания в метаданных. Значение - Строка - Идентификатор регламентного задания в коде. Содержит следующие ключи:
//   * МониторингРТ - Строка - Мониторинг проверки соединения с Битрикс24.
//   * РассылкаПисемСОшибками - Строка - Выполнение оповещения об ошибках во время синхронизации с Битрикс24.
//   * ОчисткаЛога - Строка - Удаление устаревших записей истории взаимодействия с Битрикс24.
//   * ОбменДанных - Строка - Выгрузка в Битрикс24.
//   * ВыгрузкаВРежимеРВ - Строка - Выгрузка элементов в режиме реального времени.
//
Функция ИспользуемыеРеглЗадания() Экспорт

	Результат = Новый Структура();
	Результат.Вставить("МониторингРТ"			, "Б24_УП_МониторингРТ");
	Результат.Вставить("РассылкаПисемСОшибками"	, "Б24_УП_РассылкаПисемСОшибками");
	Результат.Вставить("ОчисткаЛога"			, "Б24_УП_ОчисткаЛога");
	Результат.Вставить("ОбменДанных"			, "Б24_УП_ОбменДанных");
	Результат.Вставить("ВыгрузкаВРежимеРВ"		, "Б24_К_ВыгрузкаВРежимеРВ");
		Результат.Вставить("АвтоФормированиеРасчетныхЛистков", "Б24_УП_ОбменВызовСервера");
	Возврат Результат;

КонецФункции

// Возвращает структуру с названиями регламентных заданий, используемых в конфигурации.
//
// Возвращаемое значение:
//  Структура - Ключ - Строка, имя регламентного задания. Содержит следующие ключи:
//   * МониторингРТ - Строка - Мониторинг проверки соединения с Битрикс24.
//   * РассылкаПисемСОшибками - Строка - Выполнение оповещения об ошибках во время синхронизации с Битрикс24.
//   * ОчисткаЛога - Строка - Удаление устаревших записей истории взаимодействия с Битрикс24.
//   * ОбменДанных - Строка - Выгрузка в Битрикс24.
//   * ВыгрузкаВРежимеРВ - Строка - Выгрузка элементов в режиме реального времени.
//
Функция ИменаИспользуемыхРеглЗаданий() Экспорт

	Результат = Новый Структура();
