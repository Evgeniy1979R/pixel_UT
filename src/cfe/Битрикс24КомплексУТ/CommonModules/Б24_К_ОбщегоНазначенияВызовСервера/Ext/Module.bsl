Функция ПолучитьПрефиксВнешнихКодов1С()

	Результат = Новый Структура;
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();

	Если ТипКонфигурации = "ЗУП" Тогда

		Результат.Вставить("ORG_"	, Тип("СправочникСсылка.Организации"));
		Результат.Вставить("B_ORG_"	, Тип("СправочникСсылка.БанковскиеСчетаКонтрагентов"));
		Результат.Вставить("CL_"	, Тип("СправочникСсылка.ФизическиеЛица"));

	ИначеЕсли ТипКонфигурации = "БП" Тогда

		Результат.Вставить("ORG_"	, Тип("СправочникСсылка.Организации"));
		Результат.Вставить("B_ORG_"	, Тип("СправочникСсылка.БанковскиеСчета"));
		Результат.Вставить("CL_"	, Тип("СправочникСсылка.КонтактныеЛица"));
		Результат.Вставить("PC_"	, Тип("ДокументСсылка.ОплатаПлатежнойКартой"));
		Результат.Вставить("CR_"	, Тип("ДокументСсылка.ПриходныйКассовыйОрдер"));
		Результат.Вставить("SA_"	, Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет"));

	ИначеЕсли ТипКонфигурации = "УТ" Тогда

		Результат.Вставить("ORG_"	, Тип("СправочникСсылка.Организации"));
		Результат.Вставить("B_ORG_"	, Тип("СправочникСсылка.БанковскиеСчетаОрганизаций"));
		Результат.Вставить("CL_"	, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.КонтактныеЛицаПартнеров"));
		Результат.Вставить("PC_"	, Тип("ДокументСсылка.ОперацияПоПлатежнойКарте"));
		Результат.Вставить("CR_"	, Тип("ДокументСсылка.ПриходныйКассовыйОрдер"));
		Результат.Вставить("SA_"	, Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств"));

	ИначеЕсли ТипКонфигурации = "УНФ" Тогда

		Результат.Вставить("ORG_"	, Тип("СправочникСсылка.Организации"));
		Результат.Вставить("B_ORG_"	, Тип("СправочникСсылка.БанковскиеСчета"));
		Результат.Вставить("CL_"	, Тип("СправочникСсылка.КонтактныеЛица"));
		Результат.Вставить("PC_"	, Тип("ДокументСсылка.ОперацияПоПлатежнымКартам"));
		Результат.Вставить("CR_"	, Тип("ДокументСсылка.ПоступлениеВКассу"));
		Результат.Вставить("SA_"	, Тип("ДокументСсылка.ПоступлениеНаСчет"));

	КонецЕсли;

	Возврат Результат;

КонецФункции



