Функция ПолучитьЗначениеХранилищаНастроек(Настройка, НаименованиеКлюча = "", Пользователь = "Общие") Экспорт

УстановитьПривилегированныйРежим(Истина);

	Результат = Неопределено;

	СохраненныеНастройки = ХранилищеОбщихНастроек.Загрузить(ПолучитьНазваниеМодуля(), Настройка, , Пользователь);
	Если СохраненныеНастройки = Неопределено Тогда
		СохраненныеНастройки = ХранилищеОбщихНастроек.Загрузить("1С:Бэкофис 2.0", Настройка, , Пользователь);
	КонецЕсли;

	Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") И НЕ НаименованиеКлюча = "" Тогда

		Если СохраненныеНастройки.Свойство(НаименованиеКлюча) <> Ложь Тогда
			Результат = СохраненныеНастройки[НаименованиеКлюча];
		Иначе
			СохраненныеНастройки.Вставить(НаименованиеКлюча, Неопределено);
			УстановитьЗначениеВХранилищаНастроек(Настройка, СохраненныеНастройки);
		КонецЕсли;
	Иначе

		Если СохраненныеНастройки = Неопределено Тогда
			УстановитьЗначениеВХранилищаНастроек(Настройка, Неопределено);
		Иначе
			Результат = СохраненныеНастройки;
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Переносит значение галки «Предоставить доступ Битрикс AI» со старого ключа
// структуры общих настроек (ПредоставитьДоступМартеИИ) на новый
// (ПредоставитьДоступИИ). Нужно базам, которые обновляются с версии, где ключ
// назывался иначе: пока нового ключа нет, форма настроек показывает галку снятой,
// а первое же сохранение настроек выключает Константу.Б24_ИИ_ИспользованиеИИ.
// Старый ключ оставляем как есть - он больше никем не читается, зато откат на
// предыдущую версию расширения не теряет значение.
Процедура ПеренестиНастройкуДоступаИИ()

	УстановитьПривилегированныйРежим(Истина);

	ОбщиеНастройки = ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки");
	Если ТипЗнч(ОбщиеНастройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если ОбщиеНастройки.Свойство("ПредоставитьДоступИИ") Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ОбщиеНастройки.Свойство("ПредоставитьДоступМартеИИ") Тогда
		Возврат;
	КонецЕсли;

	ЗначениеДоступаИИ = ОбщиеНастройки["ПредоставитьДоступМартеИИ"];
	Если ЗначениеДоступаИИ = Неопределено Тогда
		// Ключ есть, а значения в нём нет - берём умолчание (Истина).
		ЗначениеДоступаИИ = Истина;
	КонецЕсли;
	ОбщиеНастройки.Вставить("ПредоставитьДоступИИ", ЗначениеДоступаИИ);
	УстановитьЗначениеВХранилищаНастроек("ОбщиеНастройки", ОбщиеНастройки);

	// Константа - то, по чему платформа включает функциональную опцию
	// Б24_ИИ_ИспользованиеИИ. Приводим её к перенесённому значению.
	Попытка
		Константы.Б24_ИИ_ИспользованиеИИ.Установить(ЗначениеДоступаИИ);
	Исключение
		// Нет прав на запись константы - не повод срывать обновление версии.
	КонецПопытки;

КонецПроцедуры

Процедура УстановитьЗначениеВХранилищаНастроек(Настройка, ЗначениеНастройки, Пользователь = "Общие") Экспорт

