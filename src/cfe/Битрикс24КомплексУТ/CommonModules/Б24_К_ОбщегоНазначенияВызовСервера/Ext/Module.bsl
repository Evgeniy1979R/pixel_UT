Функция ПолучитьСтавкуНДСПоСтавке(Ставка) Экспорт

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();

	Если ТипКонфигурации = "ЗУП"
		или ТипКонфигурации = "БП" Тогда

		Если Ставка = 0 Тогда
			СтавкаНДС = Перечисления.СтавкиНДС.НДС0;
		ИначеЕсли Ставка = 18 Тогда
			СтавкаНДС = Перечисления.СтавкиНДС.НДС18;
		ИначеЕсли Ставка = 10 Тогда
			СтавкаНДС  	= Перечисления.СтавкиНДС.НДС10;
		ИначеЕсли Ставка = 20 Тогда
			СтавкаНДС  	= Перечисления.СтавкиНДС.НДС20;
		ИначеЕсли Ставка = 22 Тогда
			СтавкаНДС  	= Перечисления.СтавкиНДС.НДС22;
		ИначеЕсли Ставка = 7 Тогда
			СтавкаНДС  	= Перечисления.СтавкиНДС.НДС7;
		ИначеЕсли Ставка = 5 Тогда
			СтавкаНДС  	= Перечисления.СтавкиНДС.НДС5;
		Иначе
			СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		КонецЕсли;

	ИначеЕсли ТипКонфигурации = "УНФ" Тогда

		СтавкаНДС = Справочники["СтавкиНДС"].ПустаяСсылка();
		Если Ставка = "Без НДС" Тогда
			СтавкаНДС = Справочники["СтавкиНДС"].СтавкаНДС(Перечисления["ВидыСтавокНДС"].БезНДС);
		ИначеЕсли Ставка = 0 Тогда
			СтавкаНДС = Справочники["СтавкиНДС"].СтавкаНДС(Перечисления["ВидыСтавокНДС"].Нулевая)
		Иначе
			Выборка = Справочники["СтавкиНДС"].Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.Ставка = Ставка И НЕ Выборка.Расчетная Тогда
					СтавкаНДС = Выборка.Ссылка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	Иначе

		СтавкаНДС = Справочники["СтавкиНДС"].ПустаяСсылка();
		Если Ставка = "Без НДС" Тогда
			СтавкаНДС = Справочники["СтавкиНДС"].БезНДС;
		Иначе
			Выборка = Справочники["СтавкиНДС"].Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.Ставка = Ставка
					И НЕ Выборка.РасчетнаяСтавка
					И НЕ Выборка.Ссылка = Справочники["СтавкиНДС"].БезНДС Тогда
					СтавкаНДС = Выборка.Ссылка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Возврат СтавкаНДС;

КонецФункции


Функция ПолучитьСтавкуПоНДС(СсылкаНаСтавкуНДС) Экспорт

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();

	Если ТипКонфигурации = "ЗУП"
		или ТипКонфигурации = "БП" Тогда

		Если СсылкаНаСтавкуНДС = Перечисления.СтавкиНДС.НДС18 Тогда
			СтавкаНДС = 18;
		ИначеЕсли СсылкаНаСтавкуНДС = Перечисления.СтавкиНДС.НДС10 Тогда
			СтавкаНДС = 10;
		ИначеЕсли СсылкаНаСтавкуНДС = Перечисления.СтавкиНДС.НДС20 Тогда
			СтавкаНДС = 20;
		ИначеЕсли СсылкаНаСтавкуНДС = Перечисления.СтавкиНДС.НДС22 Тогда
			СтавкаНДС = 22;
		ИначеЕсли СсылкаНаСтавкуНДС = Перечисления.СтавкиНДС.НДС0 Тогда
			СтавкаНДС = 0;
		ИначеЕсли СсылкаНаСтавкуНДС = Перечисления.СтавкиНДС.НДС7 Тогда
			СтавкаНДС = 7;
		ИначеЕсли СсылкаНаСтавкуНДС = Перечисления.СтавкиНДС.НДС5 Тогда
			СтавкаНДС = 5;
		Иначе
			СтавкаНДС = "";
		КонецЕсли;

	ИначеЕсли ТипКонфигурации = "УНФ" Тогда

		Если СсылкаНаСтавкуНДС.ВидСтавкиНДС = Перечисления["ВидыСтавокНДС"].БезНДС Тогда
			Возврат "";
		Иначе
			Возврат СсылкаНаСтавкуНДС.Ставка;
		КонецЕсли;

	Иначе

		Если СсылкаНаСтавкуНДС = Справочники["СтавкиНДС"].БезНДС Тогда
			Возврат "";
		Иначе
			Возврат СсылкаНаСтавкуНДС.Ставка;
		КонецЕсли;
		СтавкаНДС = "";
	КонецЕсли;

	Возврат СтавкаНДС;

КонецФункции


Функция ДанныеВСтрокуJSON(Данные) Экспорт

