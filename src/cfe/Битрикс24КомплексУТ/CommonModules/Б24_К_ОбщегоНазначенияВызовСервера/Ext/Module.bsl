Функция КонвертацияИмёнКлючей(ТипСущности, ИмяКлюча, ЭтоТЧ = Ложь) Экспорт

	Результат = ИмяКлюча;

	Если ТипСущности = "Сделка" И ЭтоТЧ Тогда

		Если ИмяКлюча = "ID" Тогда Результат = "id"
		ИначеЕсли ИмяКлюча = "PRODUCT_ID" Тогда Результат = "productId"
		ИначеЕсли ИмяКлюча = "PRODUCT_NAME" Тогда Результат = "productName"
		ИначеЕсли ИмяКлюча = "PRICE" Тогда Результат = "price"
		ИначеЕсли ИмяКлюча = "MEASURE_CODE" Тогда Результат = "measureCode"
		ИначеЕсли ИмяКлюча = "MEASURE_NAME" Тогда Результат = "measureName"
		ИначеЕсли ИмяКлюча = "QUANTITY" Тогда Результат = "quantity"
		ИначеЕсли ИмяКлюча = "DISCOUNT_TYPE_ID" Тогда Результат = "discountTypeId"
		ИначеЕсли ИмяКлюча = "DISCOUNT_RATE" Тогда Результат = "discountRate"
		ИначеЕсли ИмяКлюча = "DISCOUNT_SUM" Тогда Результат = "discountSum"
		ИначеЕсли ИмяКлюча = "TAX_RATE" Тогда Результат = "taxRate"
		ИначеЕсли ИмяКлюча = "TAX_INCLUDED" Тогда Результат = "taxIncluded"
		ИначеЕсли ИмяКлюча = "CUSTOMIZED" Тогда Результат = "customized"
		ИначеЕсли ИмяКлюча = "XML_ID" Тогда Результат = "xmlId" КонецЕсли;

	ИначеЕсли ТипСущности = "Сделка" И НЕ ЭтоТЧ Тогда

		Если ИмяКлюча = "ID" Тогда Результат = "id"
		ИначеЕсли ИмяКлюча = "ORIGIN_ID" Тогда Результат = "originId"
		ИначеЕсли ИмяКлюча = "BEGINDATE" Тогда Результат = "begindate"

		ИначеЕсли ИмяКлюча = "CLOSED" Тогда Результат = "closed"
		ИначеЕсли ИмяКлюча = "CLOSEDATE" Тогда Результат = "closedate"
		ИначеЕсли ИмяКлюча = "COMPANY_ID" Тогда Результат = "companyId"
		ИначеЕсли ИмяКлюча = "CONTACT_ID" Тогда Результат = "contactId"
		ИначеЕсли ИмяКлюча = "CATEGORY_ID" Тогда Результат = "categoryId"
		ИначеЕсли ИмяКлюча = "STAGE_ID" Тогда Результат = "stageId"
		ИначеЕсли ИмяКлюча = "ASSIGNED_BY_ID" Тогда Результат = "assignedById"
		ИначеЕсли ИмяКлюча = "COMMENTS" Тогда Результат = "comments"
		ИначеЕсли ИмяКлюча = "TITLE" Тогда Результат = "title"
		ИначеЕсли ИмяКлюча = "CURRENCY_ID" Тогда Результат = "currencyId"
		ИначеЕсли ИмяКлюча = "OPPORTUNITY" Тогда Результат = "opportunity"
		ИначеЕсли ИмяКлюча = "TAX_VALUE" Тогда Результат = "taxValue"

		ИначеЕсли ИмяКлюча = "UTM_CONTENT" Тогда Результат = "utmContent"
		ИначеЕсли ИмяКлюча = "UTM_TERM" Тогда Результат = "utmTerm"
		ИначеЕсли ИмяКлюча = "UTM_MEDIUM" Тогда Результат = "utmMedium"
		ИначеЕсли ИмяКлюча = "UTM_SOURCE" Тогда Результат = "utmSource"
		ИначеЕсли ИмяКлюча = "UTM_CAMPAIGN" Тогда Результат = "utmCampaign"

		ИначеЕсли ИмяКлюча = "ADDITIONAL_INFO" Тогда Результат = "additionalInfo"
		ИначеЕсли ИмяКлюча = "IS_NEW" Тогда Результат = "isNew"
		ИначеЕсли ИмяКлюча = "LEAD_ID" Тогда Результат = "leadId"
		ИначеЕсли ИмяКлюча = "OPENED" Тогда Результат = "opened"
		ИначеЕсли ИмяКлюча = "SOURCE_ID" Тогда Результат = "sourceId"
		ИначеЕсли ИмяКлюча = "SOURCE_DESCRIPTION" Тогда Результат = "sourceDescription"
		ИначеЕсли ИмяКлюча = "TYPE_ID" Тогда Результат = "typeId"

		ИначеЕсли Лев(ИмяКлюча, 7) = "UF_CRM_" Тогда Результат = СтрЗаменить(Результат, "UF_CRM_", "ufCrm_");
		ИначеЕсли Лев(ИмяКлюча, 10) = "PARENT_ID_" Тогда Результат = СтрЗаменить(Результат, "PARENT_ID_", "parentId");

		КонецЕсли;

	ИначеЕсли ТипСущности = "Счет2" И НЕ ЭтоТЧ Тогда

		Результат = СтрЗаменить(Результат, "UF_CRM_", "ufCrm_");
		Результат = СтрЗаменить(Результат, "ufCrmSmartInvoice", "ufCrm_SMART_INVOICE_");

	КонецЕсли;

	Возврат Результат;

КонецФункции

