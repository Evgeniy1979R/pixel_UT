Функция Версия() Экспорт

	Результат = "";

	УстановитьПривилегированныйРежим(Истина);
	НайденныеРасширения = РасширенияКонфигурации.Получить(Новый Структура("Имя", ПолучитьИмяРасширения()));
	Если НайденныеРасширения.Количество() > 0 Тогда
		Результат = НайденныеРасширения[0].Версия;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

Функция ПроверкаОбновленияДанныхМодуляОбменаСБитрикс24() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ПроверитьСоздатьПрофилиГруппДоступа();

	Версия = Версия();

	КлючХранилищаВерсии = "ВерсияМодуляБиблиотеки";

	ПредыдущаяВерсия =  ПолучитьЗначениеХранилищаНастроек(КлючХранилищаВерсии);

	ПервыйЗапуск = НЕ ПредыдущаяВерсия = Версия;

	Если НЕ ПервыйЗапуск Тогда
		ВыполнитьМиграциюКоннектораКЭДО();
		Возврат Истина;
	КонецЕсли;

	Пока ПредыдущаяВерсия <> Версия Цикл

		ПредыдущаяВерсия =  ПолучитьЗначениеХранилищаНастроек(КлючХранилищаВерсии);

		Если НЕ ЗначениеЗаполнено(ПредыдущаяВерсия) Тогда

			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, Версия)

		ИначеЕсли ПредыдущаяВерсия = "4.3.1.15" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "4.3.1.19");
		ИначеЕсли ПредыдущаяВерсия = "4.3.1.19" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "4.3.1.20");
		ИначеЕсли ПредыдущаяВерсия = "4.3.1.20" Тогда
			Попытка
				Справочники.Б24_ИИ_ИнструментыИИ.ИнициализироватьОбновитьТиповыеТулы();
			Исключение
			КонецПопытки;
			Константы.Б24_ИИ_ИспользованиеИИ.Установить(Истина);
			Константы.Б24_ИИ_ЛимитПередачи.Установить(100);
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "4.4.0.1");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.3" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.4");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.4" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.5");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.5" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.6");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.6" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.7");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.7" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.8");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.8" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.9");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.9" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.10");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.10" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.11");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.11" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.12");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.12" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.13");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.13" Тогда

			// Ключ галки «Предоставить доступ Битрикс AI» переименован
			// (ПредоставитьДоступМартеИИ -> ПредоставитьДоступИИ): переносим
			// значение, иначе в форме настроек галка оказалась бы снятой и
			// первое же сохранение настроек выключило бы Константу ИИ.
			ПеренестиНастройкуДоступаИИ();

			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "5.0.0.14");
		ИначеЕсли ПредыдущаяВерсия = "5.0.0.14" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "6.0.0.1");
		ИначеЕсли ПредыдущаяВерсия = "6.0.0.1" Тогда
			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, "6.0.0.2");
		Иначе

			УстановитьЗначениеВХранилищаНастроек(КлючХранилищаВерсии, Версия);

			ПеререгистрироватьПодпискиПослеОбновленияВерсии();

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Однократная миграция: подписки обмена КЭДО переводятся на отдельный коннектор портала
// (<ИдентификаторПодключения>_HR). Иначе обмен КЭДО и синхронизация CRM делят одну очередь
// офлайн-событий, и события теряются. Признак выполнения хранится в хранилище настроек.
//
Процедура ВыполнитьМиграциюКоннектораКЭДО()

	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО") Тогда
		Возврат;
	КонецЕсли;

	КлючХранилищаМиграции = "КоннекторКЭДОРазведен";
	Если ПолучитьЗначениеХранилищаНастроек(КлючХранилищаМиграции) = Истина Тогда
		Возврат;
	КонецЕсли;

	Попытка

		НастройкиПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьМассивНастроекПодключения();

		Для Каждого НастройкаПодключения Из НастройкиПодключения Цикл

			СтруктураНастроек = СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);
			Если СтруктураНастроек = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ПараметрыВыгрузки = Новый Структура;
			ПараметрыВыгрузки.Вставить("НастройкаПодключения"	, НастройкаПодключения);
			ПараметрыВыгрузки.Вставить("Наименование"			, Строка(НастройкаПодключения));
			ПараметрыВыгрузки.Вставить("СтруктураНастроек"		, СтруктураНастроек);
			ПараметрыВыгрузки.Вставить("УдалитьВстройки"		, Ложь);

			ЗапуститьЗадание("РегистрыСведений.Б24_УП_НастройкиКЭДО.ДобавитьУдалитьВстройкиБитрикс24ВФоне",
				"Удаление/Добавление встроек Битрикс24", ПараметрыВыгрузки, 0, Истина);

		КонецЦикла;

		УстановитьЗначениеВХранилищаНастроек(КлючХранилищаМиграции, Истина);

	Исключение
		ЗаписьЖурналаРегистрации("ОбменСБитрикс24.ОбновлениеВерсии", УровеньЖурналаРегистрации.Предупреждение,
			"", "",
			"Не удалось перевести подписки КЭДО на отдельный коннектор: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ПеререгистрироватьПодпискиПослеОбновленияВерсии()

	// Пересчёт функциональной опции КЭДО из фактических настроек подключения: константа
	// выставляется при сохранении настройки подключения, поэтому после обновления модуля
	// (где она могла сброситься) её нужно восстановить — иначе пропадёт раздел КЭДО.
	Попытка
		Справочники.Б24_К_НастройкиПодключения.ЗаполнитьКонстантыКЭДО();
	Исключение
		ЗаписьЖурналаРегистрации("ОбменСБитрикс24.ОбновлениеВерсии", УровеньЖурналаРегистрации.Предупреждение,
			"", "",
			"Не удалось пересчитать константы КЭДО из настроек подключения: " + ОписаниеОшибки());
	КонецПопытки;

	// После обновления версии модуля обмена Битрикс24 обязательно перерегистрируем
	// подписки на события портала (event.bind / event.unbind) для всех активных
	// настроек подключения. Это чинит ситуацию, когда после обновления расширения
	// обработчики офлайн-событий на портале отвязаны и event.offline.get
	// возвращает пусто: загрузка из Битрикс24 в 1С молчит при живой выгрузке.

	Попытка

		НастройкиПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьМассивНастроекПодключения();

		Для Каждого НастройкаПодключения Из НастройкиПодключения Цикл
			НачатьВыгрузкуНастроек(НастройкаПодключения);
		КонецЦикла;

	Исключение
		ЗаписьЖурналаРегистрации("ОбменСБитрикс24.ОбновлениеВерсии", УровеньЖурналаРегистрации.Предупреждение,
			"", "",
			"Не удалось перерегистрировать подписки и запустить выгрузку настроек после обновления версии модуля: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьСлужебныеДанныеДляПроверкиНаОбновление() Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;

	СлужебныеДанные = Новый Структура;
	СлужебныеДанные.Вставить("ВерсияПлатформы1С"			, СистемнаяИнформация.ВерсияПриложения);
	СлужебныеДанные.Вставить("НазваниеПрикладногоРешения"	, Метаданные.Синоним);
	СлужебныеДанные.Вставить("ИмяПрикладногоРешения"		, Метаданные.Имя);
	СлужебныеДанные.Вставить("ВерсияПрикладногоРешения"		, Метаданные.Версия);
	СлужебныеДанные.Вставить("ВерсияМодуляСинхронизации"	, Версия());
	СлужебныеДанные.Вставить("МодульПервогоПоколения"		, Ложь);
	СлужебныеДанные.Вставить("ХешСумма"						, "");

	ДанныеОМодуле = Новый Структура;
	ДанныеОМодуле.Вставить("ИдПрикладногоРешения"		, "1C_Complex");
	ДанныеОМодуле.Вставить("МинимальныйРелиз" 			, "");
	ДанныеОМодуле.Вставить("МодульНеОпределен" 			, Ложь);
	ДанныеОМодуле.Вставить("СсылкаНаУстановленныйМодуль", "");
	ДанныеОМодуле.Вставить("МодульДоработан" 			, Ложь);

	ДанныеОМодуле.Вставить("ЭтоРасширение" 				, Истина);
	ДанныеОМодуле.Вставить("ИдСтраны" 					, "RU");
	ДанныеОМодуле.Вставить("ИдМодуля" 					, "UT_11");

	Результат = Новый Структура;
	Результат.Вставить("СлужебныеДанные", СлужебныеДанные);
	Результат.Вставить("ДанныеОМодуле"	, ДанныеОМодуле);

	Возврат Результат;

КонецФункции

Функция ПолучитьИнформациюОМодулях(ДанныеОМодуле) Экспорт

	Результат = Неопределено;

	НастройкиПодключения = Новый Структура;
	Б24_К_RestApiВызовСервера.РазобратьАдресСайта("https://util.1c-bitrix.ru/onec/modules_info.php", НастройкиПодключения);

	Соединение = Б24_К_RestApiВызовСервера.УстановитьСоединениеССервером(НастройкиПодключения);

	ПустойПараметр = "&LastParam=last";    // 1С может резать символы, поэтому добавляем параметр, который можно спокойно резать.

	HTTPЗапрос = Новый HTTPЗапрос;
	HTTPЗапрос.АдресРесурса = "onec/modules_info.php";

	ТелоHTTPЗапроса = "q=1&module="+ДанныеОМодуле.ИдПрикладногоРешения+"&country="+ДанныеОМодуле.ИдСтраны+"&app="+ДанныеОМодуле.ИдМодуля+ ПустойПараметр;

	// Module - IdModule (символьный код раздела 1 уровня),
	// Country - IdCountry (символьный код раздела 2 уровня),
	// App - IdAppSolution (символьный код раздела 2 уровня).

	HTTPЗапрос.Заголовки.Вставить("Content-Type"	,"application/x-www-form-urlencoded; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("Content-Length"	, Формат(СтрДлина(ТелоHTTPЗапроса), "ЧГ=0"));

	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоHTTPЗапроса);

	Попытка

		Ответ 				= Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		ОтветСтрокой 		= Ответ.ПолучитьТелоКакСтроку();

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ОтветСтрокой);

		ИнформацияОМодулях =  ПрочитатьJSON(ЧтениеJSON, Истина);

		Результат = ИнформацияОМодулях.Получить("result").Получить("modules");

	Исключение
		ОбщегоНазначения.СообщитьПользователю(ИнформацияОбОшибке().Описание);
	КонецПопытки;

	Возврат Результат;

КонецФункции

Процедура ПроверитьСоздатьПрофилиГруппДоступа()

	Попытка

		ИмяПрофиля = "(Коннектор к Битрикс24) Пользователь";
		НайденныйПрофиль = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(ИмяПрофиля);
		Если НайденныйПрофиль.Пустая() Тогда

