
#Область ListOfDocuments

Процедура ListOfDocuments(ПередаваемыеПараметры, АдресРезультата) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Портал 					= ПередаваемыеПараметры.Портал;
	ИдВладельца 			= ПередаваемыеПараметры.ИдВладельца;
	ТипВладельца 			= ПередаваемыеПараметры.ТипВладельца;
	ИдСессии 				= ПередаваемыеПараметры.ИдСессии;
	
	НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
	Если НЕ НастройкиИнтеграцииСервисов.РеестрПечатныхФорм Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	Результат = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПолучитьСписокДокументовДляОтправкиНаПортал(НастройкаПодключения, Портал, ИдВладельца, ТипВладельца));
	
	ТелоЗапроса = "&COMMAND=ListOfDocumentsResult&MODULE_ID=1ctotal&PARAMS[session]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСессии)+"&PARAMS[RESULT]="+Результат;
	
	Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	
~КонецПроцедурыВФоне:

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);
	
КонецПроцедуры

Функция ПолучитьСписокДокументовДляОтправкиНаПортал(НастройкаПодключения, Портал, ИдВладельца, ТипВладельца)
	
УстановитьПривилегированныйРежим(Истина);

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб); 	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписьJSON.ЗаписатьНачалоОбъекта();	
	
	Если НЕ ЗначениеЗаполнено(Портал) Тогда
		
		ЗаписьJSON.ЗаписатьИмяСвойства("errors");
		
		ЗаписьJSON.ЗаписатьНачалоМассива();
			ЗаписьJSON.ЗаписатьНачалоОбъекта();	
		
				ЗаписьJSON.ЗаписатьИмяСвойства("description");	
				ЗаписьJSON.ЗаписатьЗначение("Unknown Bitrix24");
				
				ЗаписьJSON.ЗаписатьИмяСвойства("code");	
				ЗаписьJSON.ЗаписатьЗначение("1");
		
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		ЗаписьJSON.ЗаписатьКонецМассива();
		
		ЗаписьJSON.ЗаписатьКонецОбъекта();	
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		Возврат СтрокаJSON;
		
	КонецЕсли;
	
	ТипыДанных = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	
	ТипДанных = Неопределено;
	ИдЭлемента=	ИдВладельца;
	Если ТипВладельца = "3" Тогда
		ТипДанных = ТипыДанных.Контакт;
	ИначеЕсли  ТипВладельца = "4" Тогда
		ТипДанных = ТипыДанных.Компания;
	ИначеЕсли  ТипВладельца = "1" Тогда
		
		СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
		
		Если СтруктураНастроек <> Неопределено Тогда
			
			ТелоHTTPЗапроса = "&entityTypeId=1&id=" + Формат(ИдВладельца, "ЧГ=0");	
			СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm.item.get", ТелоHTTPЗапроса); 
			
			Если СтруктураОтвета <> Неопределено Тогда      
				
				result = СтруктураОтвета.Получить("result");
				Если result <> Неопределено Тогда     

					ТекЛид = result.Получить("item");
					Если ТекЛид <> Неопределено Тогда     
						
						ИдКомпании    	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЛид.Получить("companyId"),"ЧГ=0"));
						ИдКонтакта     	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЛид.Получить("contactId"),"ЧГ=0"));
						
						Если ЗначениеЗаполнено(ИдКомпании) И ИдКомпании <> "0" Тогда
							ТипДанных = ТипыДанных.Компания;
							ИдЭлемента=	ИдКомпании;
						ИначеЕсли ЗначениеЗаполнено(ИдКонтакта) И ИдКонтакта <> "0" Тогда
							ТипДанных = ТипыДанных.Контакт;
							ИдЭлемента=	ИдКонтакта;
						КонецЕсли;
						
					КонецЕсли;

				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли  ТипВладельца = "2" Тогда  
		
		СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
				
		Если СтруктураНастроек <> Неопределено Тогда
			
			ТелоHTTPЗапроса = "&entityTypeId=2&filter[ID]="+Формат(ИдВладельца, "ЧГ=0") + "&start=-1";	
			СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm.item.list", ТелоHTTPЗапроса); 
			
			Если СтруктураОтвета <> Неопределено Тогда
				result = СтруктураОтвета.Получить("result");
				Если result <> Неопределено Тогда     
					
					МассивЭлементов = result.Получить("items");
					Если МассивЭлементов <> Неопределено Тогда     
						
						Для каждого ТекСделка Из МассивЭлементов Цикл
				
							ИдКомпании    	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекСделка.Получить("companyId"),"ЧГ=0"));
							ИдКонтакта     	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекСделка.Получить("contactId"),"ЧГ=0"));
							
							Если ЗначениеЗаполнено(ИдКомпании) И ИдКомпании <> "0" Тогда
								ТипДанных = ТипыДанных.Компания;
								ИдЭлемента=	ИдКомпании;
							ИначеЕсли ЗначениеЗаполнено(ИдКонтакта) И ИдКонтакта <> "0" Тогда
								ТипДанных = ТипыДанных.Контакт;
								ИдЭлемента=	ИдКонтакта;
							КонецЕсли;
							
						КонецЦикла;	 	
						
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТипДанных = Неопределено;
	КонецЕсли;
	
	Если ТипДанных <> Неопределено Тогда 
		мОбъектыВладельцы = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьМассивЗначенийПоИдБ24Объекта(Портал, ТипДанных, ИдЭлемента);
	Иначе
		мОбъектыВладельцы = Новый Массив;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал"				, Портал);
	Запрос.УстановитьПараметр("ТелефонКонтрагента"	, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента"));
	Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" Тогда
		Запрос.УстановитьПараметр("EmailКонтрагента"	, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ВидыКонтактнойИнформации.EmailКонтрагенты"));
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		Запрос.УстановитьПараметр("EmailКонтрагента"	, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ВидыКонтактнойИнформации.EmailКонтрагента"));
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		Запрос.УстановитьПараметр("EmailКонтрагента"	, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ВидыКонтактнойИнформации.EmailКонтрагента"));
	КонецЕсли;
	Запрос.УстановитьПараметр("ФактАдресКонтрагента", Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента"));
	Запрос.УстановитьПараметр("ЮрАдресКонтрагента"	, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента"));
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	КонтрагентыКонтактнаяИнформация.Ссылка КАК Ссылка,
	|	КонтрагентыКонтактнаяИнформация.Тип КАК Тип,
	|	КонтрагентыКонтактнаяИнформация.Вид КАК Вид,
	|	КонтрагентыКонтактнаяИнформация.Представление КАК Представление,
	|	КонтрагентыКонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолей,
	|	КонтрагентыКонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
	|	КонтрагентыКонтактнаяИнформация.АдресЭП КАК АдресЭП,
	|	КонтрагентыКонтактнаяИнформация.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов
	|ПОМЕСТИТЬ ВТ_КИ
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Ссылка В
	|			(ВЫБРАТЬ
	|				Б24_КБ_РеестрДокументов.Контрагент
	|			ИЗ
	|				РегистрСведений.Б24_КБ_РеестрДокументов КАК Б24_КБ_РеестрДокументов
	|			ГДЕ
	|				Б24_КБ_РеестрДокументов.Выгружено = ЛОЖЬ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Вид
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_КИ.Ссылка КАК Контрагент,
	|	ВТ_КИ.Представление КАК Представление,
	|	ВТ_КИ.ЗначенияПолей КАК ЗначенияПолей,
	|	ВТ_КИ.НомерТелефона КАК НомерТелефона,
	|	ВТ_КИ.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов
	|ПОМЕСТИТЬ ВТ_Телефоны
	|ИЗ
	|	ВТ_КИ КАК ВТ_КИ
	|ГДЕ
	|	ВТ_КИ.Вид = &ТелефонКонтрагента
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_КИ.Ссылка КАК Контрагент,
	|	ВТ_КИ.Представление КАК Представление,
	|	ВТ_КИ.ЗначенияПолей КАК ЗначенияПолей,
	|	ВТ_КИ.АдресЭП КАК АдресЭП
	|ПОМЕСТИТЬ ВТ_Емейлы
	|ИЗ
	|	ВТ_КИ КАК ВТ_КИ
	|ГДЕ
	|	ВТ_КИ.Вид = &EmailКонтрагента
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_КИ.Ссылка КАК Контрагент,
	|	ВТ_КИ.Представление КАК Представление,
	|	ВТ_КИ.ЗначенияПолей КАК ЗначенияПолей
	|ПОМЕСТИТЬ ВТ_ФактАдреса
	|ИЗ
	|	ВТ_КИ КАК ВТ_КИ
	|ГДЕ
	|	ВТ_КИ.Вид = &ФактАдресКонтрагента
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_КИ.Ссылка КАК Контрагент,
	|	ВТ_КИ.Представление КАК Представление,
	|	ВТ_КИ.ЗначенияПолей КАК ЗначенияПолей
	|ПОМЕСТИТЬ ВТ_ЮрАдреса
	|ИЗ
	|	ВТ_КИ КАК ВТ_КИ
	|ГДЕ
	|	ВТ_КИ.Вид = &ЮрАдресКонтрагента
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_КИ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_КБ_РеестрДокументов.Контрагент КАК Контрагент,
	|	Б24_КБ_РеестрДокументов.Наименование КАК Наименование,
	|	Б24_КБ_РеестрДокументов.ПечатнаяФорма КАК ПечатнаяФорма,
	|	Б24_КБ_РеестрДокументов.Идентификатор КАК Идентификатор,
	|	Б24_КБ_РеестрДокументов.Владелец КАК Владелец,
	|	Б24_КБ_РеестрДокументов.ДатаСортировки КАК ДатаСортировки
	|ПОМЕСТИТЬ ВТ_РеестрДокументов
	|ИЗ
	|	РегистрСведений.Б24_КБ_РеестрДокументов КАК Б24_КБ_РеестрДокументов
	|ГДЕ
	|	Б24_КБ_РеестрДокументов.Выгружено = ЛОЖЬ
	|	И Б24_КБ_РеестрДокументов.Портал = &Портал
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РеестрДокументов.Контрагент КАК Контрагент,
	|	ВТ_РеестрДокументов.Наименование КАК Наименование,
	|	ВТ_РеестрДокументов.Идентификатор КАК Идентификатор,
	|	ВТ_РеестрДокументов.Владелец КАК Владелец,
	|	Контрагенты.Наименование КАК НаименованиеКонтрагента,
	|	Контрагенты.НаименованиеПолное КАК НаименованиеПолноеКонтрагента,
	|	Контрагенты.ИНН КАК ИННКонтрагента,
	|	Контрагенты.КПП КАК КППКонтрагента,
	|	ВТ_Емейлы.АдресЭП КАК АдресЭП,
	|	ВТ_Телефоны.НомерТелефона КАК НомерТелефона,
	|	ВТ_ФактАдреса.Представление КАК ФактАдресПредставление,
	|	ВТ_ЮрАдреса.Представление КАК ЮрАдресПредставление,
	|	ВТ_РеестрДокументов.ДатаСортировки КАК ДатаСортировки
	|ИЗ
	|	ВТ_РеестрДокументов КАК ВТ_РеестрДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Телефоны КАК ВТ_Телефоны
	|			ПО Контрагенты.Ссылка = ВТ_Телефоны.Контрагент
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Емейлы КАК ВТ_Емейлы
	|			ПО Контрагенты.Ссылка = ВТ_Емейлы.Контрагент
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ФактАдреса КАК ВТ_ФактАдреса
	|			ПО Контрагенты.Ссылка = ВТ_ФактАдреса.Контрагент
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЮрАдреса КАК ВТ_ЮрАдреса
	|			ПО Контрагенты.Ссылка = ВТ_ЮрАдреса.Контрагент
	|		ПО ВТ_РеестрДокументов.Контрагент = Контрагенты.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСортировки";
	
	Если ТипКонфигурации = "УТ" Тогда
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "Контрагенты.КПП КАК КППКонтрагента,"
		, "Контрагенты.КПП КАК КППКонтрагента, Контрагенты.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо,");
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "Контрагенты.КПП КАК КППКонтрагента,"
		, "Контрагенты.КПП КАК КППКонтрагента, Контрагенты.ВидКонтрагента КАК ВидКонтрагента,");
	Иначе
		Запрос.Текст = ТекстЗапроса;
	КонецЕсли;
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	ЗаписьJSON.ЗаписатьИмяСвойства("filter");
	Если мОбъектыВладельцы.Количество()>0 Тогда
		ЗаписьJSON.ЗаписатьЗначение("Y");
	Иначе
		ЗаписьJSON.ЗаписатьЗначение("N");
	КонецЕсли;
	
	ТипыКонтрагентовДляКомпаний = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипыКонтрагентовДляКомпаний(НастройкаПодключения);			
	
	ЗаписьJSON.ЗаписатьИмяСвойства("documents");		
	ЗаписьJSON.ЗаписатьНачалоМассива();		
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда			
		Выборка = ВыполненныйЗапрос.Выбрать();				
		Пока Выборка.Следующий() Цикл					
			ЗаписьJSON.ЗаписатьНачалоОбъекта();				
			ЗаписьJSON.ЗаписатьИмяСвойства("id");	
			ЗаписьJSON.ЗаписатьЗначение(Формат(Выборка.Идентификатор, "ЧГ=0"));
			ЗаписьJSON.ЗаписатьИмяСвойства("buyer");	
			ЗаписьJSON.ЗаписатьНачалоОбъекта();	
			
			ЗаписьJSON.ЗаписатьИмяСвойства("type");
			Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" Тогда
				ВидКлиента = Б24_К_ОбменКомпанийКонтактовСервер.ВидКлиентаПоОбъекту(Выборка.Контрагент);
				ЗаписьJSON.ЗаписатьЗначение(?(ТипыКонтрагентовДляКомпаний.Найти(ВидКлиента) <> Неопределено, "4", "3"));
			ИначеЕсли ТипКонфигурации = "УТ" Тогда
				ЗаписьJSON.ЗаписатьЗначение(?(Выборка.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо, "4", "3"));
			ИначеЕсли ТипКонфигурации = "УНФ" Тогда
				ЗаписьJSON.ЗаписатьЗначение(?(Выборка.ВидКонтрагента = Перечисления["ВидыКонтрагентов"].ЮридическоеЛицо, "4", "3"));
			КонецЕсли;														
			Если ЗначениеЗаполнено(Выборка.НаименованиеКонтрагента) Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("name");	
				ЗаписьJSON.ЗаписатьЗначение(Лев(Выборка.НаименованиеКонтрагента, 100));
			КонецЕсли; 							
			Если ЗначениеЗаполнено(Выборка.НаименованиеПолноеКонтрагента) Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("fullName");	
				ЗаписьJSON.ЗаписатьЗначение(Лев(Выборка.НаименованиеПолноеКонтрагента, 100));
			КонецЕсли;  							
			Если ЗначениеЗаполнено(Выборка.ИННКонтрагента) Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("INN");	
				ЗаписьJSON.ЗаписатьЗначение(Выборка.ИННКонтрагента);
			КонецЕсли; 							
			Если ЗначениеЗаполнено(Выборка.КППКонтрагента) Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("KPP");	
				ЗаписьJSON.ЗаписатьЗначение(Выборка.КППКонтрагента);
			КонецЕсли;   							
			Если ЗначениеЗаполнено(Выборка.НомерТелефона) Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("phone");	
				ЗаписьJSON.ЗаписатьЗначение(Выборка.НомерТелефона);
			КонецЕсли;   							
			Если ЗначениеЗаполнено(Выборка.АдресЭП) Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("email");	
				ЗаписьJSON.ЗаписатьЗначение(Выборка.АдресЭП);
			КонецЕсли;   							
			Если ЗначениеЗаполнено(Выборка.ФактАдресПредставление) Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("factAdress");	
				ЗаписьJSON.ЗаписатьЗначение(Выборка.ФактАдресПредставление);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ЮрАдресПредставление) Тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("legAdress");	
				ЗаписьJSON.ЗаписатьЗначение(Выборка.ЮрАдресПредставление);
			КонецЕсли;
			
			ЗаписьJSON.ЗаписатьКонецОбъекта();						
			ЗаписьJSON.ЗаписатьИмяСвойства("name");	
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Наименование);
			ЗаписьJSON.ЗаписатьКонецОбъекта();					
		КонецЦикла;				
	КонецЕсли;
	ЗаписьJSON.ЗаписатьКонецМассива();	
	ЗаписьJSON.ЗаписатьКонецОбъекта();	
	СтрокаJSON = ЗаписьJSON.Закрыть();   	
	
	Возврат СтрокаJSON;

КонецФункции

#КонецОбласти


#Область GetDocuments

Процедура GetDocuments(ПередаваемыеПараметры, АдресРезультата) Экспорт

	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	Портал 					= ПередаваемыеПараметры.Портал;
	ИдВладельца 			= ПередаваемыеПараметры.ИдВладельца;
	ТипВладельца 			= ПередаваемыеПараметры.ТипВладельца;
	ИдСессии 				= ПередаваемыеПараметры.ИдСессии;
	ВыбранныеПечФормы 		= ПередаваемыеПараметры.ПечФормы;
	
	НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
	Если НЕ НастройкиИнтеграцииСервисов.РеестрПечатныхФорм Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранныеПечФормы) = Тип("Массив") Тогда
		
		НомерЭлемента = 0;
		Для каждого ТекПараметры Из ВыбранныеПечФормы Цикл 
			
			НомерЭлемента = НомерЭлемента+1; 
			
			idDocument 		= ТекПараметры.Получить("idDocument");
			
			ДанныеPDF = ПолучитьПечатнуюФормуРеестра(Портал, idDocument);
			
			Если ДанныеPDF <> Неопределено Тогда 
			
				ТелоHTTPЗапроса ="&fields[title]="+ДанныеPDF.Наименование+"&fields[number]=2&fields[entityTypeId]="+ТипВладельца+"&fields[entityId]="+Формат(ИдВладельца, "ЧГ=0") + "&fields[region]="+Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЛокализациюБитрикс24();
				
				ВыгружаемыйФайл = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ДанныеPDF.ВыгружаемыйФайл);
				
				ТелоHTTPЗапроса = ТелоHTTPЗапроса +"&fields[fileContent]="+ВыгружаемыйФайл;
				ТелоHTTPЗапроса = ТелоHTTPЗапроса +"&fields[pdfContent]="+ВыгружаемыйФайл;  
				
				ДанныеСПортала = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm.documentgenerator.document.upload", ТелоHTTPЗапроса); 
				
				Если ДанныеСПортала <> Неопределено Тогда
					Если ДанныеСПортала.Получить("result") <> Неопределено Тогда
						
						Выборка = РегистрыСведений.Б24_КБ_РеестрДокументов.Выбрать(Новый Структура("Выгружено", Ложь));
						Пока Выборка.Следующий() Цикл
							Для каждого ТекПараметры Из ВыбранныеПечФормы Цикл  
								Если Формат(Выборка.Идентификатор, "ЧГ=0") = idDocument И Выборка.Портал = Портал Тогда
									ТекЗапись = Выборка.ПолучитьМенеджерЗаписи();
									ТекЗапись.Выгружено = Истина;
									ТекЗапись.Записать();
									
									//Если ТипВладельца = "3" Тогда
									//	РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, ТипыДанных.Контакт, ТекЗапись.Контрагент, ИдВладельца); 
									//ИначеЕсли  ТипВладельца = "4" Тогда
									//	РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, ТипыДанных.Компания, ТекЗапись.Контрагент, ИдВладельца); 
									//КонецЕсли;
									
								КонецЕсли;
							КонецЦикла;
						КонецЦикла;
						
					КонецЕсли;
				КонецЕсли;	
			
			КонецЕсли;
			
		КонецЦикла;
		
		ТелоЗапроса = "&COMMAND=GetDocumentsResult&MODULE_ID=1ctotal&PARAMS[session]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСессии);
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
		
	КонецЕсли;
	
~КонецПроцедурыВФоне:

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);
	
КонецПроцедуры

Функция ПолучитьПечатнуюФормуРеестра(Портал, ИдДокумента) 
	
УстановитьПривилегированныйРежим(Истина);
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("Идентификатор", Число(ИдДокумента));
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_КБ_РеестрДокументов.ПечатнаяФорма КАК ПечатнаяФорма,
	|	Б24_КБ_РеестрДокументов.Наименование КАК Наименование
	|ИЗ
	|	РегистрСведений.Б24_КБ_РеестрДокументов КАК Б24_КБ_РеестрДокументов
	|ГДЕ
	|	Б24_КБ_РеестрДокументов.Портал = &Портал
	|	И Б24_КБ_РеестрДокументов.Идентификатор = &Идентификатор";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		ТзнДанных = ВыполненныйЗапрос.Выгрузить();
		
		ВыгружаемыйФайл = ТзнДанных[0].ПечатнаяФорма.Получить();
		
		Если ВыгружаемыйФайл <> Неопределено Тогда
			
			Результат = Новый Структура;
			Результат.Вставить("Наименование"	, ТзнДанных[0].Наименование);
			Результат.Вставить("ВыгружаемыйФайл", ВыгружаемыйФайл);
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

#КонецОбласти


#Область ФормированиеПечатныхФормДляРеестра

Функция ДобавитьВРеестр(НастройкаПодключения, КонтрагентДляЭкспорта, ДокументДляЭкспорта, НазваниеПечатнойФормы, ПечатнаяФорма) Экспорт
	
УстановитьПривилегированныйРежим(Истина);
	
	Идентификатор = 1;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал", НастройкаПодключения.Портал);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Б24_КБ_РеестрДокументов.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.Б24_КБ_РеестрДокументов КАК Б24_КБ_РеестрДокументов
	|ГДЕ
	|	Б24_КБ_РеестрДокументов.Портал = &Портал
	|
	|УПОРЯДОЧИТЬ ПО
	|	Идентификатор УБЫВ";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		тзнДанных = ВыполненныйЗапрос.Выгрузить();	
		Идентификатор = тзнДанных[0].Идентификатор + 1;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".pdf");
	
	Попытка
		ПечатнаяФорма.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	
	НоваяЗапись = РегистрыСведений.Б24_КБ_РеестрДокументов.СоздатьМенеджерЗаписи();
	НоваяЗапись.Выгружено 		= Ложь;
	НоваяЗапись.Портал			= НастройкаПодключения.Портал;
	НоваяЗапись.Контрагент		= КонтрагентДляЭкспорта;
	НоваяЗапись.Наименование	= НазваниеПечатнойФормы;
	НоваяЗапись.ПечатнаяФорма	= Новый ХранилищеЗначения(Base64Строка(Новый ДвоичныеДанные(ИмяВременногоФайла)));
	НоваяЗапись.Идентификатор	= Идентификатор;
	НоваяЗапись.Владелец		= Новый ХранилищеЗначения(ДокументДляЭкспорта);	    
	
	Если ЗначениеЗаполнено(ДокументДляЭкспорта) И Метаданные.Документы.Содержит(ДокументДляЭкспорта.Метаданные()) = Истина Тогда
		НоваяЗапись.ДатаСортировки	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументДляЭкспорта, "Дата");	    
	Иначе
		НоваяЗапись.ДатаСортировки	= ТекущаяДатаСеанса();	    
	КонецЕсли;
	
	НоваяЗапись.Записать();	
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Истина;
	
КонецФункции

#КонецОбласти
