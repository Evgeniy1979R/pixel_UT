
// Описание данных, переданных в заполнение нового документа, для лога интеграции сервисов.
//
// Параметры:
//  ПараметрыОбъекта - Структура - параметры заполнения (см. ЗаполнениеОбъекта1С).
//
// Возвращаемое значение:
//  Строка - значения ключевых реквизитов заполнения.
//
&НаКлиенте
Функция ОписаниеДанныхЗаполнения(ПараметрыОбъекта)

	Если ТипЗнч(ПараметрыОбъекта) <> Тип("Структура")
		ИЛИ НЕ ПараметрыОбъекта.Свойство("ДанныеСущностиБитрикс24")
		ИЛИ ТипЗнч(ПараметрыОбъекта.ДанныеСущностиБитрикс24) <> Тип("Структура") Тогда
		Возврат "данные не переданы";
	КонецЕсли;

	ДанныеСущности = ПараметрыОбъекта.ДанныеСущностиБитрикс24;
	Описание = "";

	Для Каждого ИмяРеквизита Из СтрРазделить("Организация,Партнер,Контрагент", ",") Цикл

		ЗначениеРеквизита = "<нет>";
		Если ДанныеСущности.Свойство(ИмяРеквизита) Тогда
			ЗначениеРеквизита = Строка(ДанныеСущности[ИмяРеквизита]);
		КонецЕсли;

		Описание = Описание + ?(Описание = "", "", ", ") + ИмяРеквизита + "='" + ЗначениеРеквизита + "'";

	КонецЦикла;

	Возврат Описание;

КонецФункции

Процедура ЗакрытиеСлайдера(СессияБитрикс24, НастройкаПодключения) Экспорт 
	
	Если ЗначениеЗаполнено(СессияБитрикс24) Тогда
		Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗакрытиеСлайдера(СессияБитрикс24, НастройкаПодключения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Б24_К_НастройкиСеанса.НастройкиГорячегоЗапуска.ИдПользователяБитрикс24) И НЕ Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ИспользуетсяРежимСлайдера() Тогда
		
		Если СтрНайти(Б24_К_НастройкиСеанса.НастройкиГорячегоЗапуска.Браузер, "BitrixDesktop") > 0 Тогда
			ВернутьПредыдущуюВкладкуМессенджера(НастройкаПодключения);
		Иначе
			СвернутьМессенджер(НастройкаПодключения);
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(СессияБитрикс24) Тогда
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПерейтиПоСсылке(ДанныеСеанса) Экспорт
	
	Если Лев(ДанныеСеанса.АдресНавигационнойСсылки, 6) = "Отчет." ИЛИ Лев(ДанныеСеанса.АдресНавигационнойСсылки, 18) = "ПроизвольныйОтчет." Тогда
		ОткрытьФорму("РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов.Форма.ФормаДлительнойОбработки", ДанныеСеанса,, Истина);
	Иначе     
		ОткрытьФорму("РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов.Форма.ФормаФормированиеДанных1С", ДанныеСеанса,, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура СвернутьМессенджер(НастройкаПодключения) 
	
	АдресДоБазы1С = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "ВебАдрес1С");

	ДанныеДляФормы = Новый Структура;
	
	лСкрипт = "<html>
	|<body>
	|	<script>
	|		location = 'http://127.0.0.1:20141/v3/hide/"+АдресДоБазы1С+"';
	|	</script>
	|</body>
	|</html>";
	
	ДанныеДляФормы.Вставить("СкриптДля1С", лСкрипт);
	
	ОткрытьФорму("РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов.Форма.ЗапускСкриптов", ДанныеДляФормы);
	
КонецПроцедуры

Процедура ВернутьПредыдущуюВкладкуМессенджера(НастройкаПодключения) 
	
	АдресДоБазы1С = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "ВебАдрес1С");
	
	ДанныеДляФормы = Новый Структура;
	
	лСкрипт = "<html>
	|<body>
	|	<script>
	|		location = 'http://127.0.0.1:20141/v3/prev/"+АдресДоБазы1С+"';
	|	</script>
	|</body>
	|</html>";                                                      
	
	ДанныеДляФормы.Вставить("СкриптДля1С", лСкрипт);
	
	ОткрытьФорму("РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов.Форма.ЗапускСкриптов", ДанныеДляФормы);
	
КонецПроцедуры

Процедура ЗаполнениеОбъекта1С(Форма, ВидОбъекта, ИмяОбъекта, СлужебноеИмяОбъекта, ПараметрыОбъекта) Экспорт
	
	// Настройка подключения нужна для диагностики: заполнение реквизитов обёрнуто в
	// Попытка/КонецПопытки, поэтому без этих записей сбой присвоения не виден ни в журнале, ни в логе.
	НастройкаПодключения = Неопределено;
	Если ТипЗнч(ПараметрыОбъекта) = Тип("Структура") И ПараметрыОбъекта.Свойство("ДанныеСущностиБитрикс24")
		И ТипЗнч(ПараметрыОбъекта.ДанныеСущностиБитрикс24) = Тип("Структура")
		И ПараметрыОбъекта.ДанныеСущностиБитрикс24.Свойство("НастройкаПодключения") Тогда
		НастройкаПодключения = ПараметрыОбъекта.ДанныеСущностиБитрикс24.НастройкаПодключения;
	КонецЕсли;

	Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения,
		"ЗаполнениеОбъекта1С: старт. Объект='" + ВидОбъекта + "." + ИмяОбъекта + "', " + ОписаниеДанныхЗаполнения(ПараметрыОбъекта));

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" Тогда
		КонтрагентПартнер = "Контрагент";	
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		КонтрагентПартнер = "Партнер";		
	КонецЕсли;
	Если ТипКонфигурации = "УНФ" Тогда

		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизита(ВидОбъекта, ИмяОбъекта, "Организация") Тогда
			Попытка      
				Форма.Объект.Организация = ПараметрыОбъекта.ДанныеСущностиБитрикс24.Организация;	   
				Форма.ОрганизацияПриИзменении(Форма.Элементы.Организация);
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		КонецЕсли;
		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизита(ВидОбъекта, ИмяОбъекта, "Контрагент") Тогда
			Попытка      
				Форма.Объект.Контрагент = ПараметрыОбъекта.ДанныеСущностиБитрикс24.Контрагент;	   
				Форма.КонтрагентПриИзменении(Неопределено);
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		КонецЕсли;
	
		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизита(ВидОбъекта, ИмяОбъекта, "Договор") Тогда
			Попытка  
				Форма.Объект.Договор = Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПолучитьДоговорПоКонтрагенту(ПараметрыОбъекта.ДанныеСущностиБитрикс24.Контрагент
				,ПараметрыОбъекта.ДанныеСущностиБитрикс24.Организация ,ПараметрыОбъекта.ДанныеСущностиБитрикс24.Валюта);	 
				Форма.ДоговорПриИзменении(Неопределено);
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		КонецЕсли;

		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизита(ВидОбъекта, ИмяОбъекта, "ВалютаДокумента") Тогда
			Попытка      
				Форма.Объект.ВалютаДокумента = ПараметрыОбъекта.ДанныеСущностиБитрикс24.Валюта;	   
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		КонецЕсли;

		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизита(ВидОбъекта, ИмяОбъекта, "ВалютаДенежныхСредств") Тогда
			Попытка      
				Форма.Объект.ВалютаДенежныхСредств = ПараметрыОбъекта.ДанныеСущностиБитрикс24.Валюта;	   
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		КонецЕсли;
	
		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизита(ВидОбъекта, ИмяОбъекта, "СуммаДокумента") Тогда
			Попытка      
				Форма.Объект.СуммаДокумента = ПараметрыОбъекта.ДанныеСущностиБитрикс24.СуммаДокумента;
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		КонецЕсли;
	
		ЕстьРеквизитСуммаВключаетНДС = Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизита(ВидОбъекта, ИмяОбъекта, "СуммаВключаетНДС");
		Если ЕстьРеквизитСуммаВключаетНДС И ПараметрыОбъекта.ДанныеСущностиБитрикс24.Свойство("Товары") И ПараметрыОбъекта.ДанныеСущностиБитрикс24.Товары.Количество() > 0 Тогда
			Форма.Объект.СуммаВключаетНДС = ПараметрыОбъекта.ДанныеСущностиБитрикс24.Товары[0].СуммаВключаетНДС;
		КонецЕсли;
	
		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеТабличнойЧасти(ВидОбъекта, ИмяОбъекта, "Запасы") И СлужебноеИмяОбъекта <> "ЗаказПокупателяНаряд" Тогда  
		
			Попытка            
				Форма.ЗапрашиватьСбросКоличества = Ложь;	
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		
			Попытка
		
				Если ПараметрыОбъекта.ДанныеСущностиБитрикс24.Свойство("Товары") Тогда   
				
					пер	= 0;
				
					Для каждого ТекСтрока Из ПараметрыОбъекта.ДанныеСущностиБитрикс24.Товары Цикл 
					
						НоваяСтрока = Форма.Объект.Запасы.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
						Попытка
							НоваяСтрока.ИспользоватьХарактеристики = ЗначениеЗаполнено(НоваяСтрока.Характеристика);
							НоваяСтрока.ЗаполнениеХарактеристикиПроверено = Истина;     
						Исключение
							Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения строки табличной части. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
						КонецПопытки;
					
						Форма.Элементы.Запасы.ТекущаяСтрока = Пер; 
						//Форма.ЗапасыНоменклатураПриИзменении(Форма.Элементы.ЗапасыНоменклатура); 
					
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);  
						Форма.ЗапасыКоличествоПриИзменении(Неопределено);
					
						Пер = Пер + 1;
						
					КонецЦикла;  
				
				КонецЕсли;
		
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		
		КонецЕсли;
	
		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеТабличнойЧасти(ВидОбъекта, ИмяОбъекта, "Работы") И СлужебноеИмяОбъекта <> "ЗаказПокупателя" Тогда  
		
			Попытка            
				Форма.ЗапрашиватьСбросКоличества = Ложь;	
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		
			Попытка
		
				Если ПараметрыОбъекта.ДанныеСущностиБитрикс24.Свойство("Товары") Тогда   
				
					пер	= 0;
				
					Для каждого ТекСтрока Из ПараметрыОбъекта.ДанныеСущностиБитрикс24.Товары Цикл 
					
						НоваяСтрока = Форма.Объект.Работы.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
						Попытка
							НоваяСтрока.ИспользоватьХарактеристики = ЗначениеЗаполнено(НоваяСтрока.Характеристика);
							НоваяСтрока.ЗаполнениеХарактеристикиПроверено = Истина;     
						Исключение
							Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения строки табличной части. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
						КонецПопытки;
					
						Форма.Элементы.Работы.ТекущаяСтрока = Пер; 
						Форма.РаботыНоменклатураПриИзменении(Неопределено);
					
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);  
						Форма.РаботыКоличествоПриИзменении(Неопределено);
					
						Пер = Пер + 1;
					
					КонецЦикла;  
				
				КонецЕсли;
		
			Исключение
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения реквизита. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
			КонецПопытки;
		
		КонецЕсли;
	
		Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеТабличнойЧасти(ВидОбъекта, ИмяОбъекта, "РаботыИУслуги") Тогда  
		
			Попытка

				Если ПараметрыОбъекта.ДанныеСущностиБитрикс24.Свойство("Товары") Тогда 
				
					пер	= 0;
				
					Для каждого ТекСтрока Из ПараметрыОбъекта.ДанныеСущностиБитрикс24.Товары Цикл 
						НоваяСтрока = Форма.Объект.РаботыИУслуги.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
						Попытка
							НоваяСтрока.ИспользоватьХарактеристики = ЗначениеЗаполнено(НоваяСтрока.Характеристика);
