							Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизитаТЧ(ВидОбъекта, ИмяОбъекта, "Услуги", "ВидЦены") Тогда
								НоваяСтрока.ВидЦены = Неопределено;	
							КонецЕсли;
						
							Если Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьНаличиеРеквизитаТЧ(ВидОбъекта, ИмяОбъекта, "Услуги", "ВидЦеныПоставщика") Тогда
								НоваяСтрока.ВидЦеныПоставщика = Неопределено;	
							КонецЕсли;
						
							Форма.ТоварыКоличествоУпаковокПриИзменении(Неопределено);           
						
							Пер = Пер + 1;						
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
			
			Исключение   
				Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ЗаписатьЛогЗаполненияДокумента(НастройкаПодключения, "ЗаполнениеОбъекта1С: сбой заполнения строки табличной части. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
					ОбщегоНазначенияКлиент.СообщитьПользователю(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры   
