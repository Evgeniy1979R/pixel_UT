				ВыгружатьЦены = СохраненныеНастройки.НастройкиСинхронизацииТоваров.Прайсы.Количество() > 0;
			КонецЕсли;
		Иначе  
			Если СохраненныеНастройки.НастройкиСинхронизацииТоваров.Свойство("Склад") Тогда
				ВыгружатьОстатки = ЗначениеЗаполнено(СохраненныеНастройки.НастройкиСинхронизацииТоваров.Склад);
			КонецЕсли;
			Если СохраненныеНастройки.НастройкиСинхронизацииТоваров.Свойство("ТипЦены") Тогда
				ВыгружатьЦены = ЗначениеЗаполнено(СохраненныеНастройки.НастройкиСинхронизацииТоваров.ТипЦены);
			КонецЕсли;
		КонецЕсли;
		СтруктураДанных.Вставить("ВыгружатьЦены"	, ВыгружатьЦены);
		СтруктураДанных.Вставить("ВыгружатьОстатки"	, ВыгружатьОстатки);
		
		Если ТипКонфигурации = "УТ" Тогда
			ИспользуютсяСостоянияЗаказов	= Ложь;
			Если СтруктураДанных.ВыгружатьСделки И СохраненныеНастройки.НастройкиСинхронизацииСделок.Свойство("ИнформацияОСтатусах") Тогда   
				ИнформацияОСтатусах = СохраненныеНастройки.НастройкиСинхронизацииСделок.ИнформацияОСтатусах;
				Если ИнформацияОСтатусах <> Неопределено Тогда
					ИспользуютсяСостоянияЗаказов = ИнформацияОСтатусах.ИсточникСтатусов1С = "СостоянияЗаказов";	
				КонецЕсли;
			КонецЕсли;
			СтруктураДанных.Вставить("ИспользуютсяСостоянияЗаказов"	, ИспользуютсяСостоянияЗаказов);
		КонецЕсли;
		
		Результат.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

