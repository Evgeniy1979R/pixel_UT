			НастройкиСинхронизации = Выборка.Настройки.Получить();	
			Если НастройкиСинхронизации <> Неопределено Тогда
				
				Для каждого ТекЭлемент Из НастройкиСинхронизации.Сущности Цикл
					
					Если ЗначениеЗаполнено(ТекЭлемент.ПравилаПоискаПриВыгрузкеНаПортал) Тогда
						
						лДеревоГрупп = ЗначениеИзСтрокиВнутр(ТекЭлемент.ПравилаПоискаПриВыгрузкеНаПортал);  
						Если лДеревоГрупп.Колонки.Найти("Идентификатор") = Неопределено Тогда      
							лДеревоГрупп.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
						КонецЕсли;
						
						ТекЭлемент.ПравилаПоискаПриВыгрузкеНаПортал = ЗначениеВСтрокуВнутр(лДеревоГрупп);	
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ТекЭлемент.ПравилаПоискаПриЗагрузкеВ1С) Тогда
						
						лДеревоГрупп = ЗначениеИзСтрокиВнутр(ТекЭлемент.ПравилаПоискаПриЗагрузкеВ1С);  
						Если лДеревоГрупп.Колонки.Найти("Идентификатор") = Неопределено Тогда      
