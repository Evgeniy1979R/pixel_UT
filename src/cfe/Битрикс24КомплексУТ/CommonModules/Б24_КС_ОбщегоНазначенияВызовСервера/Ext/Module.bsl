Функция ДанныеПоКомпаниямКонтактам(СтруктураНастроек, мДанных, ТипДанных) Экспорт
	
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("ИнформацияОКомпаниях"	, Новый Массив);
	ДополнительныеДанные.Вставить("ИнформацияОКонтактах"	, Новый Массив);
	ДополнительныеДанные.Вставить("ИнформацияОРеквизитах"	, Новый Массив);
	
	мЗапросы = Новый Массив;
	Для каждого ТекЭлемент Из мДанных Цикл     
		
		ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
		
		Если ТипДанных = "4" Тогда
			мЗапросы.Добавить("cmd[K_"+ИдЭлемента+"]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.company.get?ID=" + ИдЭлемента));  
		Иначе
			мЗапросы.Добавить("cmd[K_"+ИдЭлемента+"]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.contact.get?ID=" + ИдЭлемента));  
		КонецЕсли;
		
		мЗапросы.Добавить("cmd[R_"+ИдЭлемента+"]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.requisite.list?filter[ENTITY_ID]=" + ИдЭлемента + "&filter[ENTITY_TYPE_ID]=" + ТипДанных + "&start=-1"));
		
	КонецЦикла;                                                                                                            
	
	ДанныеЗапросов = Б24_К_RestApiВызовСервера.ОбработатьМассивЗапросовБатч(СтруктураНастроек, мЗапросы);
	
	Для каждого ТекЭлемент Из ДанныеЗапросов Цикл
		
		Если ТекЭлемент.Значение = Неопределено Тогда Продолжить КонецЕсли;
		
		Если Лев(ТекЭлемент.Ключ, 2) = "K_" Тогда
			Клиент = ТекЭлемент.Значение;
			Если ТипЗнч(Клиент) = Тип("Соответствие") Тогда   
				Если ТипДанных = "4" Тогда	
					ДополнительныеДанные.ИнформацияОКомпаниях.Добавить(Клиент);	 
				Иначе  
					ДополнительныеДанные.ИнформацияОКонтактах.Добавить(Клиент);	 
				КонецЕсли;    
			КонецЕсли;    
		ИначеЕсли Лев(ТекЭлемент.Ключ, 2) = "R_" Тогда
			РеквизитКлиента = ТекЭлемент.Значение;
			ДополнительныеДанные.ИнформацияОРеквизитах.Добавить(РеквизитКлиента);	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДополнительныеДанные;
	
КонецФункции

Функция ДанныеПоСделкам(СтруктураНастроек, мДанных) Экспорт
	
	ДополнительныеДанные = Новый Соответствие;
	
	ДанныеДляПостраничнойЗагрузки = Новый Соответствие;
	
	мЗапросы = Новый Массив;
	Для каждого ТекЭлемент Из мДанных Цикл     
		
		ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
		Если НЕ ЗначениеЗаполнено(ИдЭлемента) Тогда
			ИдЭлемента = Формат(ТекЭлемент.Получить("id"), "ЧГ=0");  
		КонецЕсли;
		
		мЗапросы.Добавить("cmd[S_"+ИдЭлемента+"]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.item.get?entityTypeId=2&id=" + ИдЭлемента));  
		мЗапросы.Добавить("cmd[R_"+ИдЭлемента+"]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.requisite.link.get?entityTypeId=2&entityId=" + ИдЭлемента));  
		мЗапросы.Добавить("cmd[Z_"+ИдЭлемента+"]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.orderentity.list?filter[ownerTypeId]=2&filter[ownerId]=" + ИдЭлемента + "&start=-1"));  
		мЗапросы.Добавить("cmd[TZ_"+ИдЭлемента+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("sale.order.get?id=$result[Z_"+ИдЭлемента+"][orderEntity][0][orderId]"));  
		
		ДанныеДляПостраничнойЗагрузки.Вставить("TS_" + ИдЭлемента, 0);
		
	КонецЦикла;  
	
	ДанныеЗапросов = Б24_К_RestApiВызовСервера.ОбработатьМассивЗапросовБатч(СтруктураНастроек, мЗапросы, ДанныеДляПостраничнойЗагрузки);
	Для Каждого ТекЭлемент Из ДанныеЗапросов Цикл

		Если Лев(ТекЭлемент.Ключ, 2) = "S_" Тогда

			Ид = Прав(ТекЭлемент.Ключ, СтрДлина(ТекЭлемент.Ключ) - 2);

			ЗначениеПоИд = ОписаниеСделкиПоИд(ДополнительныеДанные, Ид);

			ЗначениеПоИд.Вставить("item", ТекЭлемент.Значение.Получить("item"));

			ДополнительныеДанные.Вставить(Ид, ЗначениеПоИд);

		ИначеЕсли
		
			Лев(ТекЭлемент.Ключ, 2) = "R_" Тогда

			Ид = Прав(ТекЭлемент.Ключ, СтрДлина(ТекЭлемент.Ключ) - 2);

			ЗначениеПоИд = ОписаниеСделкиПоИд(ДополнительныеДанные, Ид);

			ЗначениеПоИд.Вставить("requisite", ТекЭлемент.Значение);

			ДополнительныеДанные.Вставить(Ид, ЗначениеПоИд);

		ИначеЕсли
		
			Лев(ТекЭлемент.Ключ, 2) = "Z_" Тогда

			Ид = Прав(ТекЭлемент.Ключ, СтрДлина(ТекЭлемент.Ключ) - 2);

			ЗначениеПоИд = ОписаниеСделкиПоИд(ДополнительныеДанные, Ид);

			ЗначениеПоИд.Вставить("orderEntity", ТекЭлемент.Значение.Получить("orderEntity"));

			ДополнительныеДанные.Вставить(Ид, ЗначениеПоИд);
				
		ИначеЕсли

			Лев(ТекЭлемент.Ключ, 3) = "TZ_" Тогда

			Ид = Прав(ТекЭлемент.Ключ, СтрДлина(ТекЭлемент.Ключ) - 3);

			ЗначениеПоИд = ОписаниеСделкиПоИд(ДополнительныеДанные, Ид);

			ЗначениеПоИд.Вставить("order", ТекЭлемент.Значение.Получить("order"));

			ДополнительныеДанные.Вставить(Ид, ЗначениеПоИд);
				
		КонецЕсли;

	КонецЦикла; 
		
	Для каждого ТекЭлемент Из ДополнительныеДанные Цикл   
	
		ИдЭлемента = Формат(ТекЭлемент.Ключ, "ЧГ=0");
	
		ТелоHTTPЗапроса = "&filter[%3DownerType]=D&filter[%3DownerId]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдЭлемента);  
		ДанныеЭлементаТЧСделки = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.item.productrow.list", "id", ТелоHTTPЗапроса, "productRows");
	
		ЗначениеПоИд = ОписаниеСделкиПоИд(ДополнительныеДанные, ИдЭлемента);
					
		ПозицииСделки = ЗначениеПоИд.Получить("productrow");
		Для Каждого ТекСтрокаТЧ Из ДанныеЭлементаТЧСделки Цикл
			ПозицииСделки.Добавить(ТекСтрокаТЧ);	
		КонецЦикла;
		
		ДополнительныеДанные.Вставить(ИдЭлемента, ЗначениеПоИд);
				
	КонецЦикла;	
		
	Возврат ДополнительныеДанные;
	
КонецФункции

Функция ДанныеПоСчетам(СтруктураНастроек, мДанных) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ДополнительныеДанные = Новый Соответствие;	
	ДанныеДляПостраничнойЗагрузки = Новый Соответствие;
	
	мЗапросы = Новый Массив;
	Для каждого ТекЭлемент Из мДанных Цикл     
		
		ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
		Если НЕ ЗначениеЗаполнено(ИдЭлемента) Тогда
			ИдЭлемента = Формат(ТекЭлемент.Получить("id"), "ЧГ=0");  
		КонецЕсли;  
		
		мЗапросы.Добавить("cmd[S_"+ИдЭлемента+"]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.item.get?entityTypeId=31&id=" + ИдЭлемента));  
		
		ДанныеДляПостраничнойЗагрузки.Вставить("TS_" + ИдЭлемента, 0); 
		
	КонецЦикла;  
	
	Если ТипКонфигурации = "БП" Тогда
		Пока Истина Цикл
			
			Для каждого ТекЭлемент Из ДанныеДляПостраничнойЗагрузки Цикл
				
				Если Лев(ТекЭлемент.Ключ, 3) = "TS_" Тогда
					
					ИдЭлемента 		= СтрЗаменить(ТекЭлемент.Ключ, "TS_", "");  
					ПозицияСтраницы = "&start=" + Формат(ТекЭлемент.Значение, "ЧГ=0");
					
					мЗапросы.Добавить("cmd[TS_"+ИдЭлемента+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.item.productrow.list?filter[%3DownerType]=SI&filter[%3DownerId]=" + ИдЭлемента + ПозицияСтраницы));  
					
				КонецЕсли;
				
			КонецЦикла;
			
			ДанныеЗапросов = Б24_К_RestApiВызовСервера.ОбработатьМассивЗапросовБатч(СтруктураНастроек, мЗапросы, ДанныеДляПостраничнойЗагрузки);
			Для каждого ТекЭлемент Из ДанныеЗапросов Цикл
				
				Если Лев(ТекЭлемент.Ключ, 2) = "S_" Тогда                
					
					Ид = Прав(ТекЭлемент.Ключ, СтрДлина(ТекЭлемент.Ключ)-2);  
					
					ЗначениеПоИд = ДополнительныеДанные.Получить(Ид);      
					Если ЗначениеПоИд = Неопределено Тогда 
						ЗначениеПоИд = Новый Соответствие;
						ЗначениеПоИд.Вставить("item", Новый Соответствие);
						ЗначениеПоИд.Вставить("productrow", Новый Массив);
					КонецЕсли;
					
					ЗначениеПоИд.Вставить("item", ТекЭлемент.Значение.Получить("item")); 
					
					ДополнительныеДанные.Вставить(Ид, ЗначениеПоИд)
					
				ИначеЕсли Лев(ТекЭлемент.Ключ, 3) = "TS_" Тогда           
					
					Ид = Прав(ТекЭлемент.Ключ, СтрДлина(ТекЭлемент.Ключ)-3); 
					
					Если ТипЗнч(ТекЭлемент.Значение) = Тип("Соответствие") Тогда 
						
						ЗначениеПоИд = ДополнительныеДанные.Получить(Ид);  
						Если ЗначениеПоИд = Неопределено Тогда 
							ЗначениеПоИд = Новый Соответствие;
							ЗначениеПоИд.Вставить("item", Новый Соответствие);
							ЗначениеПоИд.Вставить("productrow", Новый Массив);
						КонецЕсли;
						
						ПозицииСчета = ЗначениеПоИд.Получить("productrow");
						Для Каждого ТекСтрокаТЧ Из ТекЭлемент.Значение.Получить("productRows") Цикл
							ПозицииСчета.Добавить(ТекСтрокаТЧ);	
						КонецЦикла;
						
						ЗначениеПоИд.Вставить("productrow", ПозицииСчета);
						
						ДополнительныеДанные.Вставить(Ид, ЗначениеПоИд)
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла; 
			
			Если мЗапросы.Количество() = 0 Тогда  
				Прервать;	
			КонецЕсли;  
			
			мЗапросы = Новый Массив;
			
		КонецЦикла;	
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		ДанныеЗапросов = Б24_К_RestApiВызовСервера.ОбработатьМассивЗапросовБатч(СтруктураНастроек, мЗапросы, ДанныеДляПостраничнойЗагрузки);
		Для Каждого ТекЭлемент Из ДанныеЗапросов Цикл
			
			Если Лев(ТекЭлемент.Ключ, 2) = "S_" Тогда
				
				Ид = Прав(ТекЭлемент.Ключ, СтрДлина(ТекЭлемент.Ключ) - 2);
				
				ЗначениеПоИд = ДополнительныеДанные.Получить(Ид);
				Если ЗначениеПоИд = Неопределено Тогда
					ЗначениеПоИд = Новый Соответствие;
					ЗначениеПоИд.Вставить("item", Новый Соответствие);
					ЗначениеПоИд.Вставить("productrow", Новый Массив);
				КонецЕсли;
				
				ЗначениеПоИд.Вставить("item", ТекЭлемент.Значение.Получить("item"));
				
				ДополнительныеДанные.Вставить(Ид, ЗначениеПоИд);
				
				
			КонецЕсли;
			
		КонецЦикла; 	
		
		Для каждого ТекЭлемент Из ДополнительныеДанные Цикл   
			
			ИдЭлемента = Формат(ТекЭлемент.Ключ, "ЧГ=0");
			
			ТелоHTTPЗапроса = "&filter[%3DownerType]=SI&filter[%3DownerId]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдЭлемента);  
			ДанныеЭлементаТЧСделки = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.item.productrow.list", "id", ТелоHTTPЗапроса, "productRows");
			
			ЗначениеПоИд = ОписаниеСделкиПоИд(ДополнительныеДанные, ИдЭлемента);
			
			ПозицииСделки = ЗначениеПоИд.Получить("productrow");
			Для Каждого ТекСтрокаТЧ Из ДанныеЭлементаТЧСделки Цикл
				ПозицииСделки.Добавить(ТекСтрокаТЧ);	
			КонецЦикла;
			
			ДополнительныеДанные.Вставить(ИдЭлемента, ЗначениеПоИд);
		КонецЦикла;	
	КонецЕсли;
		
	Возврат ДополнительныеДанные;
	
КонецФункции

// Устанавливает дополнительное свойство "ЗагрузкаСБитрикс24" для движений документа, 
// если оно установлено в дополнительных свойствах.
//
// Параметры:
//   Движения - РегистрНакопленияНаборЗаписей, РегистрСведенийНаборЗаписей - набор записей регистра, для которых устанавливается свойство
//   ДополнительныеСвойства - Структура - дополнительные свойства документа
Процедура УстановитьДопСвойствоЗагрузкаСБитрикс24ПодчРегистрам(Движения, ДополнительныеСвойства) Экспорт
	
	мПрименяемыеРегистры = Новый Массив;
	
	ЗагрузкаСБитрикс24 = Неопределено;
	ДополнительныеСвойства.Свойство("ЗагрузкаСБитрикс24", ЗагрузкаСБитрикс24);
	Если ЗагрузкаСБитрикс24 = Истина  Тогда
		Для каждого ТекДвижение Из Движения Цикл   
			Если мПрименяемыеРегистры.Найти(ТипЗнч(ТекДвижение)) <> Неопределено Тогда
				ТекДвижение.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);   
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Прочее

Функция ПолучитьДвеСоставныеЧастиИзСтроки(СтрокаЦелая, Разделитель) Экспорт  //стрРазделить работает криво
	
	ПозицияРазделителя = СтрНайти(СтрокаЦелая, Разделитель);
	Если ПозицияРазделителя >0 Тогда
		ПерваяЧасть 	= Лев(СтрокаЦелая, ПозицияРазделителя-1);
		ВтораяЧасть 	= Прав(СтрокаЦелая, СтрДлина(СтрокаЦелая)-ПозицияРазделителя-СтрДлина(Разделитель)+1);
	Иначе
		ПерваяЧасть 	= СтрокаЦелая;
		ВтораяЧасть		= "";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ПерваяЧасть", ПерваяЧасть);
	Результат.Вставить("ВтораяЧасть", ВтораяЧасть);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПрефиксСвойстваХарактеристики() Экспорт
	Возврат "'Характеристика' ";		
КонецФункции
 
Функция ОписаниеСделкиПоИд(ДополнительныеДанные, Ид)
	
	ЗначениеПоИд = ДополнительныеДанные.Получить(Ид);      
	Если ЗначениеПоИд = Неопределено Тогда 
		ЗначениеПоИд = Новый Соответствие;
		ЗначениеПоИд.Вставить("item"			, Новый Соответствие);
		ЗначениеПоИд.Вставить("requisite"		, Новый Соответствие);
		ЗначениеПоИд.Вставить("orderEntity"		, Новый Соответствие);
		ЗначениеПоИд.Вставить("order"			, Новый Соответствие);
		ЗначениеПоИд.Вставить("productrow"		, Новый Массив);
	КонецЕсли;
	
	Возврат ЗначениеПоИд;

КонецФункции

#КонецОбласти
