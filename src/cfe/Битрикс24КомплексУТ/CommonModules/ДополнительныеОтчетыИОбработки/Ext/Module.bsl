
&Перед("ВыполнитьОбработкуПоРегламентномуЗаданию")
Процедура Б24_К_ВыполнитьОбработкуПоРегламентномуЗаданию(ВнешняяОбработка, ИдентификаторКоманды) Экспорт
	
УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Возврат;
	КонецЕсли;
	
УстановитьПривилегированныйРежим(Ложь);	

	СтруктураРеглЗаданий = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеРеглЗадания();	
	
	Если ТипЗнч(ВнешняяОбработка) = Тип("Строка")
		И Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных")
		И ВнешняяОбработка = СтруктураРеглЗаданий.СинхронизацияДанных Тогда		
		
		МодульСинхронизацияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КС_ОбщегоНазначенияВызовСервера");
		МодульСинхронизацияВызовСервера.СинхронизацияПоРасписанию(ИдентификаторКоманды);			
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.РассылкаПисемСОшибками Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ПроверкаОтправкаПисемСОшибками();		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.МониторингРТ Тогда		
		Б24_К_ЛонгПуллингВызовСервера.ПроверитьАктуальностьСоединенияСБитрикс24();		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") 
		И Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СПАРК") 
		И СтруктураРеглЗаданий.Свойство("СПАРК")
		И ВнешняяОбработка = СтруктураРеглЗаданий.СПАРК Тогда		
		
			Модуль1СПАРКВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КБ_1СПАРКВызовСервера");
			Модуль1СПАРКВызовСервера.ОбновитьИнформациюСПАРК();		
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.РоботыБ24 Тогда
		
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Автоматизация") Тогда
			МодульРоботыИТриггерыВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КА_РоботыИТриггерыСервер");
			МодульРоботыИТриггерыВызовСервера.ПроверитьРоботовБитрикс24();	
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.ОчисткаЛога Тогда
		
		РегистрыСведений.Б24_К_Логирование.ЗаданиеПроверитьУдалитьИсториюОбменов();
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.ВыгрузкаОтчетов Тогда
		
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("ЭкспортПечатныхФормОтчетов") Тогда
			МодульЭкспортДанныхВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КЭ_ЭкспортДанныхВызовСервера");
			МодульЭкспортДанныхВызовСервера.ВыполнитьВыгрузкуОтчетовПоРасписанию();	
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.СинхронизацияДанныхСМ Тогда
		
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СмартПроцессы") Тогда
			МодульОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СМ_ОбщегоНазначенияВызовСервера");
			МодульОбщегоНазначенияВызовСервера.СинхронизацияПоРасписанию(ИдентификаторКоманды);	
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") 
		И Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СкладскойУчет")
		И ВнешняяОбработка = СтруктураРеглЗаданий.ВыгрузкаОстатков Тогда
		
		МодульОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ОбщегоНазначенияВызовСервера");
		МодульОбщегоНазначенияВызовСервера.ОбменПоРасписанию(ИдентификаторКоманды, "Остатки");	
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка")
		И Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СкладскойУчет")
		И ВнешняяОбработка = СтруктураРеглЗаданий.ВыгрузкаЦен Тогда		
		
		МодульОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ОбщегоНазначенияВызовСервера");
		МодульОбщегоНазначенияВызовСервера.ОбменПоРасписанию(ИдентификаторКоманды, "Цены");			
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка")
		И Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СкладскойУчет")
		И ВнешняяОбработка = СтруктураРеглЗаданий.ВыгрузкаКартинок Тогда		
		
		МодульОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ОбщегоНазначенияВызовСервера");
		МодульОбщегоНазначенияВызовСервера.ОбменПоРасписанию(ИдентификаторКоманды, "Картинки");	
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.КонтрольСП Тогда
		
		РегистрыСведений.Б24_К_ПользователиБитрикс24.ЗаданиеКонтроляСопоставленияПользователей();
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.РассылкаПисемСОшибками Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ПроверкаОтправкаПисемСОшибками();		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.МониторингРТ Тогда
		Б24_К_ЛонгПуллингВызовСервера.ПроверитьАктуальностьСоединенияСБитрикс24();	
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") И ВнешняяОбработка = СтруктураРеглЗаданий.ОчисткаЛога Тогда
		РегистрыСведений.Б24_К_Логирование.ЗаданиеПроверитьУдалитьИсториюОбменов();
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка")
		И СтруктураРеглЗаданий.Свойство("АвтоФормированиеРасчетныхЛистков")
		И ВнешняяОбработка = СтруктураРеглЗаданий.АвтоФормированиеРасчетныхЛистков Тогда
		
		МодульАвтоФормированияРасчетныхЛистков = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОбменВызовСервера");
		Если МодульАвтоФормированияРасчетныхЛистков <> Неопределено Тогда
			МодульАвтоФормированияРасчетныхЛистков.ВыполнитьАвтоФормированиеРасчетныхЛистков();
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка")
		И СтруктураРеглЗаданий.Свойство("ОбменДанных")
		И ВнешняяОбработка = СтруктураРеглЗаданий.ОбменДанных Тогда
		МодульОбменВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОбменВызовСервера");
		Если МодульОбменВызовСервера <> Неопределено Тогда
			МодульОбменВызовСервера.ОбменПоРасписанию(ИдентификаторКоманды);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ВнешняяОбработка) = Тип("Строка") Тогда

		// Задание VibeCode: дополнительная обработка Б24_ИИ_ЗаданиеVibeCode с расписанием
		// запускает фоновый long-poll опрос команд. Модуль Б24_ИИ_ИнтеграцияСервер есть
		// только в базе УТ, поэтому доступ динамический (ОбщийМодуль вернёт Неопределено,
		// и в остальных базах ветка ничего не делает).
		МодульИнтеграцииИИ = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_ИИ_ИнтеграцияСервер");
		Если МодульИнтеграцииИИ <> Неопределено
			И ВнешняяОбработка = МодульИнтеграцииИИ.ИмяЗадания() Тогда
			МодульИнтеграцииИИ.ПроверитьИЗапуститьЗадание();
		КонецЕсли;

	КонецЕсли;	
	
КонецПроцедуры
