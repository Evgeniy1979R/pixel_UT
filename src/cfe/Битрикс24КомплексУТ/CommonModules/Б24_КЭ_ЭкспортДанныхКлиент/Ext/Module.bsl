
Процедура ЭкспортПечатнойФормыОтчетаОпубликовать(пНастройкаПодключения, пОбъекты, пПечатнаяФорма, пНаименованиеОбъекта, пТипОбъекта) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОбъектыОтправки"		, пОбъекты);
	ПараметрыФормы.Вставить("ТабличныйДокумент"		, пПечатнаяФорма);
	ПараметрыФормы.Вставить("НаименованиеОбъекта"	, пНаименованиеОбъекта);
	ПараметрыФормы.Вставить("ТипОбъекта"			, пТипОбъекта);
	ПараметрыФормы.Вставить("НастройкаПодключения"	, пНастройкаПодключения);
	
	ОткрытьФорму("ОбщаяФорма.Б24_КЭ_ЗаполнениеДанныхДляОпубликованияВЖЛ", ПараметрыФормы,,,,, Новый ОписаниеОповещения("ПослеВыбораГруппИПользователей", ЭтотОбъект, ПараметрыФормы), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

Процедура ПослеВыбораГруппИПользователей(Результат, Параметры) Экспорт
	
	ОтветФормы = Результат;
    
	Если ОтветФормы <> Неопределено Тогда
		  
		ПередаваемыеПараметры = Новый Структура;
		ПередаваемыеПараметры.Вставить("НастройкаПодключения"	, Параметры.НастройкаПодключения);
		ПередаваемыеПараметры.Вставить("ТекстСообщения"			, ОтветФормы.ТекстСообщения);
		ПередаваемыеПараметры.Вставить("ОбъектыОтправки"		, ОтветФормы.ОбъектыОтправки);
		ПередаваемыеПараметры.Вставить("ТабличныйДокумент"		, ОтветФормы.ТабличныйДокумент);
		ПередаваемыеПараметры.Вставить("НаименованиеОбъекта"	, ОтветФормы.НаименованиеОбъекта);
		ПередаваемыеПараметры.Вставить("ТипОбъекта"				, ОтветФормы.ТипОбъекта);
		ПередаваемыеПараметры.Вставить("МассивГрупп"			, ОтветФормы.Группы);
		ПередаваемыеПараметры.Вставить("МассивПользователей"	, ОтветФормы.Пользователи);
		ПередаваемыеПараметры.Вставить("МассивОтделов"			, ОтветФормы.Отделы);
			
		РезультатОтправки =  Б24_КЭ_ЭкспортДанныхВызовСервера.ОпубликоватьТабличныйДокументВБ24НаСервере(ПередаваемыеПараметры);
		
		Если РезультатОтправки.УспешнаяВыгрузка Тогда
			
			Оповестить("ПубликацияЗавершена");

			Оповещение = Новый ОписаниеОповещения("ПослеПубликацииНаПортале",ЭтотОбъект, РезультатОтправки.СсылкаНаОбъект);
			
			ПоказатьОповещениеПользователя("Опубликован в Битрикс24", Оповещение, "Публикацию можно посмотреть по ссылке", БиблиотекаКартинок.Информация32);
		Иначе
			ПоказатьОповещениеПользователя("НЕ опубликован в Битрикс24",,, БиблиотекаКартинок.Ошибка32);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПослеПубликацииНаПортале(АдресСсылки) Экспорт
	
#Если НЕ ВебКлиент Тогда
		
	СпособОткрытияОбъектовБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "ИспользуемыйБраузер");
	Если СпособОткрытияОбъектовБитрикс24 = "Браузер ОС по умолчанию" ИЛИ СпособОткрытияОбъектовБитрикс24 = Неопределено Тогда
		Б24_К_ОбщегоНазначенияКлиент.ПерейтиПоWebСсылке(АдресСсылки, "Битрикс24");
	Иначе

		СтраницаHTML = "
		|<html>
		|<script type=""text/javascript"">
		|location.replace("""+АдресСсылки+""");
		|</script>
		|</html>";
		
		Б24_К_ОбщегоНазначенияКлиент.ПерейтиПоWebСсылке(СтраницаHTML, "Битрикс24");
	КонецЕсли;
	
#Иначе	
	
	Б24_К_ОбщегоНазначенияКлиент.ПерейтиПоWebСсылке(АдресСсылки, "Битрикс24");

#КонецЕсли
	
КонецПроцедуры         

Функция СнимокЭкранаКлиента() Экспорт
	
	Результат = Неопределено;
	
    #Если НЕ ВебКлиент Тогда

        ВременныйФайл = ПолучитьИмяВременногоФайла("zip");

        ОтчетОбОшибке = Новый ОтчетОбОшибке(ИнформацияОбОшибке());
        ОтчетОбОшибке.Записать(ВременныйФайл, Ложь);

        КаталогФайлов = КаталогВременныхФайлов() + СтрЗаменить(Новый УникальныйИдентификатор, "-", "");

        ZipАрхив  = Новый ЧтениеZipФайла(ВременныйФайл);
        ZipАрхив.ИзвлечьВсе(КаталогФайлов, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		
        АдресСнимка = КаталогФайлов + "\screenshot.png";
		
		СистемнаяИнформация = Новый СистемнаяИнформация;
		ПлатформаWindows = СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86
		ИЛИ СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64;
		
		Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПутьДляПлатформы(ПлатформаWindows, АдресСнимка);
		Результат = Новый ДвоичныеДанные(АдресСнимка);

		УдалитьФайлы(ВременныйФайл);
        УдалитьФайлы(КаталогФайлов);  

	#КонецЕсли  
	
	Возврат Результат;

КонецФункции


Функция СоздатьЧат(СтруктураНастроек, Получатели, НаименованиеЧата) Экспорт
	
	ИдентификаторЧата = Неопределено;
	
	ТелоHTTPЗапроса = "";
	Для Каждого ТекСтрока Из Получатели Цикл      
		
		Если Не ЗначениеЗаполнено(ТекСтрока.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		
		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&USERS[]="+ТекСтрока.Идентификатор; 
		
	КонецЦикла;
		
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&COLOR=SAND";
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&TITLE=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(НаименованиеЧата);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&AVATAR=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Б24_КЭ_ЭкспортДанныхВызовСервера.Base64АватаркиЧата());
		
	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/im.chat.add", ТелоHTTPЗапроса);       
	Если СтруктураОтвета <> Неопределено Тогда   
		ИдентификаторЧата = Формат(СтруктураОтвета.Получить("result"), "ЧГ=0");          
	КонецЕсли;

	Возврат ИдентификаторЧата;
	
КонецФункции	
	
Функция ДобавитьСообщениеВЧат(СтруктураНастроек, ИдентификаторЧата, Сообщение) Экспорт
	
	Результат = Истина;
	
	ТелоHTTPЗапроса = "&DIALOG_ID=chat"+ИдентификаторЧата+"&MESSAGE="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Сообщение);	
	
	лСтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/im.message.add", ТелоHTTPЗапроса, Ложь); 
	Если лСтруктураОтвета <> Неопределено Тогда
		
		error_description 	= лСтруктураОтвета.Получить("error_description");  
		Если error_description = "Вы не можете отправлять сообщения в указанный чат" Тогда 
			ПоказатьОповещениеПользователя("Вы не можете отправлять сообщения в указанный чат" );
        	Результат = Ложь; 
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции
	
Функция ДобавитьФайлВЧат(СтруктураНастроек, ИдентификаторЧата, ДвоичныеДанныеФайла, Сообщение) Экспорт
	
	Результат = Ложь;
	
	ИмяФайла = "Снимок экрана " + Прав(Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(),"ЧГ=0"),9) + ".png";
	
	ТелоHTTPЗапроса = "CHAT_ID=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторЧата);
	СтрокаЗапроса = "cmd[folderGet]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("im.disk.folder.get?"+ТелоHTTPЗапроса);	
	
	ТелоHTTPЗапроса = "id=$result[folderGet][ID]"; 
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&data[NAME]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИмяФайла); 
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&fileContent="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Base64Строка(ДвоичныеДанныеФайла)); 
	СтрокаЗапроса = СтрокаЗапроса + "&cmd[uploadFile]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("disk.folder.uploadfile?"+ТелоHTTPЗапроса);
	
	ТелоHTTPЗапроса = "DIALOG_ID=chat" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторЧата); 
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&MESSAGE="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Сообщение); 
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&DISK_ID=$result[uploadFile][ID]"; 
	СтрокаЗапроса = СтрокаЗапроса + "&cmd[commit]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("im.disk.file.commit?"+ТелоHTTPЗапроса);
	
	ОтветПортала = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, СтрокаЗапроса); 
	Если ОтветПортала <> Неопределено Тогда
		result = ОтветПортала.Получить("result"); 
		Если result <> Неопределено Тогда
			result_error = result.Получить("result_error");  
			Если ТипЗнч(result_error) = Тип("Массив") Тогда
				Если result_error.Количество() = 0 Тогда
					Результат = Истина;	
				КонецЕсли;
			КонецЕсли;     
		КонецЕсли;     
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции