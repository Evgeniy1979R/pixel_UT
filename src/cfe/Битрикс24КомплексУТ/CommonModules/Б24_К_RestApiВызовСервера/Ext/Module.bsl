// Отправляет сообщение в канал Б24.
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Б24_К_НастройкиПодключения - Настройки подключения к Б24.
//  КаналИД - Строка - Идентификатор канала Б24.
//  ТекстСообщения - Строка - Текст сообщения для отправки.
//  ПовторнаяОтправка - Булево - Признак повторной отправки сообщения. Необязательный параметр, по умолчанию Ложь.
//
// Возвращаемое значение:
//  Строка - Результат отправки сообщения.
//
Функция ОтправитьСообщениеВКаналБ24(НастройкаПодключения, КаналИД, ТекстСообщения, ПовторнаяОтправка = Ложь) Экспорт

	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если СтруктураНастроек = Неопределено Тогда
		Возврат "Не удалось отправить в канал";
	КонецЕсли;

	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Выгрузка сообщений в канал";

	ТелоHTTPЗапроса = "&DIALOG_ID="+ЗакодироватьСтрокуСервер(КаналИД);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&MESSAGE="+ЗакодироватьСтрокуСервер(ТекстСообщения);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&SYSTEM=Y";

	СтруктураОтвета = ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/im.message.add", ТелоHTTPЗапроса);
	Если СтруктураОтвета = Неопределено Тогда
		Возврат "Что то пошло не так..";
	КонецЕсли;

	Ошибка = СтруктураОтвета["error"];
	Если Ошибка <> Неопределено Тогда

		ЧтоТоПроТокен = СтрНайти(Ошибка, "token") > 0;

		Если ПовторнаяОтправка ИЛИ НЕ ЧтоТоПроТокен Тогда
			Возврат "Не удалось получить данные с портала по причине: " + Ошибка;
		КонецЕсли;

		Возврат ОтправитьСообщениеВКаналБ24(НастройкаПодключения, КаналИД, ТекстСообщения, Истина);

	КонецЕсли;

	Возврат "Сообщение отправлено в канал";

КонецФункции

// Отправляет системное сообщение в Битрикс24.
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Б24_К_НастройкиПодключения - Настройка подключения к Битрикс24.
//  ИдПользователя - Строка - Идентификатор пользователя, которому отправляется сообщение.
//  ТекстСообщения - Строка - Текст отправляемого сообщения.
//  ПовторнаяОтправка - Булево - Признак повторной отправки сообщения. Необязательный параметр, по умолчанию Ложь.
//
// Возвращаемое значение:
//  Строка - Результат отправки сообщения.
//
Функция ОтправитьСистемноеСообщениеВБ24(НастройкаПодключения, ИдПользователя, ТекстСообщения, ПовторнаяОтправка = Ложь) Экспорт

	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если СтруктураНастроек = Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось отправить системное сообщение");
		Возврат "Не удалось отправить системное сообщение";
	КонецЕсли;

	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Отправка системных сообщений";

	ТелоHTTPЗапроса = "&USER_ID="+ЗакодироватьСтрокуСервер(ИдПользователя);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&MESSAGE="+ЗакодироватьСтрокуСервер(ТекстСообщения);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&SYSTEM=Y";

	СтруктураОтвета = ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/im.notify.system.add", ТелоHTTPЗапроса);

	Ошибка = СтруктураОтвета["error"];
	Если Ошибка <> Неопределено Тогда

		ЧтоТоПроТокен = СтрНайти(Ошибка, "token") > 0;

		Если ПовторнаяОтправка ИЛИ НЕ ЧтоТоПроТокен Тогда
			Возврат "Не удалось получить данные с портала по причине: " + Ошибка;
		КонецЕсли;

		Возврат ОтправитьСистемноеСообщениеВБ24(НастройкаПодключения, ИдПользователя, ТекстСообщения, Истина);

	КонецЕсли;

	Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Системное сообщение отправлено");

	Возврат "Системное сообщение отправлено";

КонецФункции

// Отправляет данные КЭДО в Битрикс24 (расчётные листки, остатки отпуска).
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Б24_К_НастройкиПодключения - Настройка подключения к Битрикс24.
//  field - Строка - Имя поля КЭДО для передачи данных.
//  ИдПользователя - Строка - Идентификатор сотрудника в Битрикс24.
//  ТекстСообщения - Строка - Данные для отправки.
//  company - Строка - Идентификатор компании в Битрикс24.
//  jobId - Строка - Идентификатор рабочего места сотрудника.
//  ПовторнаяОтправка - Булево - Признак повторной отправки сообщения. Необязательный параметр, по умолчанию Ложь.
//
// Возвращаемое значение:
//  Строка - Результат отправки сообщения.
//
Функция ОтправитьКЭДОСообщениеВБ24(НастройкаПодключения, field, ИдПользователя, ТекстСообщения, company, jobId, ПовторнаяОтправка = Ложь) Экспорт

	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если СтруктураНастроек = Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось отправить системное сообщение");
		Возврат "Не удалось отправить системное сообщение";
	КонецЕсли;

	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Отправка системных сообщений";

	ТелоHTTPЗапроса = "&company="+ЗакодироватьСтрокуСервер(company);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&job[id]=" + ЗакодироватьСтрокуСервер(jobId);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&job[fields][status]=DONE&data[0][field]="+ЗакодироватьСтрокуСервер(field);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса +	"&data[0][employee]="+ЗакодироватьСтрокуСервер(ИдПользователя);
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&&data[0][value]="+ЗакодироватьСтрокуСервер(ТекстСообщения);

	СтруктураОтвета = ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/humanresources.hcmlink.field.value.set", ТелоHTTPЗапроса);
	result = СтруктураОтвета.Получить("result");
	errors = ?(result = Неопределено, Новый Массив, result.Получить("errors"));
	Если errors = Неопределено Тогда
		errors = Новый Массив;
	КонецЕсли;
	Ошибка = ?(errors.Количество() > 0, errors[0], Неопределено);
	Если Ошибка <> Неопределено Тогда

		ЧтоТоПроТокен = СтрНайти(Ошибка, "token") > 0;

		Если ПовторнаяОтправка ИЛИ НЕ ЧтоТоПроТокен Тогда
			Возврат "Не удалось получить данные с портала по причине: " + Ошибка;
		КонецЕсли;

		Возврат ОтправитьКЭДОСообщениеВБ24(НастройкаПодключения, field, ИдПользователя, ТекстСообщения, company, jobId, Истина);

	КонецЕсли;

	Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Системное сообщение отправлено: " + field);

	Возврат "Системное сообщение отправлено";

КонецФункции

#КонецОбласти

#Область РаботаС_ИИ

Функция КонвертированноеНаименование(Строка) Экспорт

	НастройкиСоединения = Новый Структура;
	Б24_К_RestApiВызовСервера.РазобратьАдресСайта("https://mcp1c.bitrix24.tech/", НастройкиСоединения);

	Соединение = Неопределено;

	Попытка

		Если НастройкиСоединения.Сервер = "" Тогда
			Возврат Неопределено;
		КонецЕсли;

		Если НЕ НастройкиСоединения.ЗащищенноеСоединение Тогда
			ssl = Неопределено;
		Иначе
			ssl = Б24_К_ОбщегоНазначенияВызовСервера.НовоеЗащищенноеСоединение();
		КонецЕсли;

		Прокси = Неопределено;
 		Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(?(НастройкиСоединения.ЗащищенноеСоединение, "HTTPS", "HTTP"));

		Соединение = Новый HTTPСоединение(НастройкиСоединения.Сервер, НастройкиСоединения.Порт,,, Прокси, 43200, ssl);

	Исключение

		лТекстОшибки = НСтр("ru = 'Не удалось установить соединение с сервером'") + НастройкиСоединения.Сервер + ":" + Строка(НастройкиСоединения.Порт)
		+ НСтр("ru = '.Проверьте правильность токена.'");

		ОбщегоНазначения.СообщитьПользователю(лТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Соединение = Неопределено;

	КонецПопытки;

	Если Соединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос;
	HTTPЗапрос.АдресРесурса = "/translate";

	Данные 			= Новый Структура();
	Данные.Вставить("translate",Строка);
	ТелоЗапроса		= ПростаяЗаписьJSON(Данные);
	ТелоHTTPЗапроса = ТелоЗапроса;
	salt			= "my-very-secret-salt";

	ОбъектХеш = Новый ХешированиеДанных(ХешФункция.MD5);
    ОбъектХеш.Добавить(ТелоЗапроса+salt);
    ХешСумма = ОбъектХеш.ХешСумма;
	ХешСумма = СтрЗаменить(ХешСумма, " ", "");
	ХешСумма = НРег(ХешСумма);

	HTTPЗапрос.Заголовки.Вставить("Content-Type"		,"application/json; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("x-1c-signature"		, ХешСумма);
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);

	Попытка
		Ответ 					= Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		ОтветСтрокой 			= Ответ.ПолучитьТелоКакСтроку();
		// Платформа возвращает Неопределено, если тело ответа отсутствует или не является текстом
		// (например, 403 от защиты перед порталом). Дальше текст разбирается методами СтрНайти/НРег,
		// которые на Неопределено падают, и настоящая причина теряется — приводим к строке.
		Если ТипЗнч(ОтветСтрокой) <> Тип("Строка") Тогда
			ОтветСтрокой = "";
		КонецЕсли;
		КодСостояния 			= Формат(Ответ.КодСостояния, "ЧГ=0");
		ОтветСПорталаДляЛога 	= Б24_К_RestApiВызовСервера.РаскодироватьJSON(ОтветСтрокой);

		Если Ответ.КодСостояния = 200 Тогда
			СтруктураОтвета = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(ОтветСтрокой,Истина);
			ПереводНаименования = СтруктураОтвета.Получить("result");
			Возврат ПереводНаименования;
		КонецЕсли;
	Исключение
		лТекстОшибки = "Не удалось получить перевод наименования на английский";
		ОбщегоНазначения.СообщитьПользователю(лТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Строка;
	КонецПопытки;

	Возврат Строка

КонецФункции

