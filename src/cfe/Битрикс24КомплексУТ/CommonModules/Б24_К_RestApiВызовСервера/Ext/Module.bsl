// Функция для получения подробных данных через GET-запрос с использованием batch-метода.
//
// Параметры:
//  СтруктураНастроек - Структура - Настройки для отправки данных на портал.
//  Метод - Строка - Метод GET-запроса.
//  МассивДанных - Массив - Массив структур данных для отправки.
//  НазваниеПараметра - Строка - Название параметра для передачи в GET-запросе (по умолчанию "id").
//
// Возвращаемое значение:
//  Массив - Массив структур с результатами обработки запросов.
//
Функция ПолучитьПодробныеДанныеЧерезGET(СтруктураНастроек, Метод, МассивДанных, НазваниеПараметра= "id") Экспорт

	РезультатОбработки = Новый Массив;

	ТелоHTTPЗапроса		= "";
	КоличествоЗапросов 	= 0;

	Для каждого ТекЭлемент Из МассивДанных Цикл

		ИдЭлемента = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
		ИдЭлемента = ?(ЗначениеЗаполнено(ИдЭлемента), ИдЭлемента, Формат(ТекЭлемент.Получить("id"), "ЧГ=0"));

		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + "cmd[]=" + ЗакодироватьСтрокуСервер(Метод + "?"+НазваниеПараметра+"=" + ИдЭлемента);

		КоличествоЗапросов = КоличествоЗапросов + 1;

		Если КоличествоЗапросов = 50 Тогда

			СтруктураОтвета = ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
			Если СтруктураОтвета = Неопределено Тогда
				Возврат РезультатОбработки;
			КонецЕсли;

			result = СтруктураОтвета.Получить("result");
			Если result <> Неопределено Тогда
				result2 = result.Получить("result");
				Если result2 <> Неопределено Тогда
					Для каждого ТекЭлементПортала Из result2 Цикл
						РезультатОбработки.Добавить(ТекЭлементПортала);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;

			ТелоHTTPЗапроса		= "";
			КоличествоЗапросов 	= 0;

		КонецЕсли;

	КонецЦикла;

	Если ЗначениеЗаполнено(ТелоHTTPЗапроса) Тогда

		СтруктураОтвета = ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
		Если СтруктураОтвета = Неопределено Тогда
			Возврат РезультатОбработки;
		КонецЕсли;

		result = СтруктураОтвета.Получить("result");
		Если result <> Неопределено Тогда
			result2 = result.Получить("result");
			Если result2 <> Неопределено Тогда
				Для каждого ТекЭлементПортала Из result2 Цикл
					РезультатОбработки.Добавить(ТекЭлементПортала);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	Возврат РезультатОбработки;

КонецФункции

// Функция для получения массива элементов через метод с использованием параметра offset.
//
// Параметры:
//  СтруктураНастроек - Структура - настройки для отправки данных на портал.
//  Метод - Строка - метод для отправки данных на портал.
//  ТелоHTTPЗапроса - Строка - тело HTTP-запроса, может быть пустым.
//  БылиОшибки - Булево - флаг наличия ошибок, возвращается по ссылке.
//  ДатаВыполненияНаПортале - Дата - дата выполнения запроса на портале, возвращается по ссылке.
//
// Возвращаемое значение:
//  Массив - массив элемент
//
Функция МассивЭлементовПоМетодуЧерезOffset(СтруктураНастроек, Метод, ТелоHTTPЗапроса = "", БылиОшибки = Ложь, ДатаВыполненияНаПортале = Неопределено) Экспорт

	Результат = Новый Массив;

	ДатаВыполненияНаПортале = Неопределено;

	РазмерПорций 	= 50;
	СмещениеПозиции = 0;
	ПараметрЛимит 	= "&limit=" + Строка(РазмерПорций);

	ПередаваемоеТелоHTTPЗапроса = ТелоHTTPЗапроса + ПараметрЛимит + "&offset=" + Формат(СмещениеПозиции, "ЧГ=0;");

	СтруктураОтвета = ОтправкаДанныхНаПортал(СтруктураНастроек,Метод, ПередаваемоеТелоHTTPЗапроса);
	Если СтруктураОтвета = Неопределено Тогда
		БылиОшибки = Истина;
		Возврат Результат;
	КонецЕсли;

	Result = СтруктураОтвета.Получить("result");
	Если Result = Неопределено Тогда
		БылиОшибки = Истина;
		Возврат Результат;
	КонецЕсли;

	ДанныеВремениПортала = СтруктураОтвета.Получить("time");
	Если ДанныеВремениПортала <> Неопределено Тогда
		ДатаВыполненияНаПортале = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата"), ДанныеВремениПортала.Получить("date_finish"));
	КонецЕсли;

	Для каждого ТекЭлемент Из Result Цикл
		Результат.Добавить(ТекЭлемент);
	КонецЦикла;

	Пока Result.Количество() = РазмерПорций Цикл

		СмещениеПозиции = СмещениеПозиции + РазмерПорций;

		ПередаваемоеТелоHTTPЗапроса = ТелоHTTPЗапроса + ПараметрЛимит + "&offset=" + Формат(СмещениеПозиции, "ЧГ=0;");
		СтруктураОтвета = ОтправкаДанныхНаПортал(СтруктураНастроек,Метод, ПередаваемоеТелоHTTPЗапроса);
		Если СтруктураОтвета = Неопределено Тогда
			БылиОшибки = Истина;
			Возврат Результат;
		КонецЕсли;

		Result = СтруктураОтвета.Получить("result");
		Если Result = Неопределено Тогда
			БылиОшибки = Истина;
			Возврат Результат;
		КонецЕсли;

		Для каждого ТекЭлемент Из Result Цикл
			Результат.Добавить(ТекЭлемент);
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Виды событий битрикс24.
//
// Возвращаемое значение:
//  Структура - Виды событий битрикс24:
// * ОфлайнСобытие - Строка -
// * ЗапросНаОтправкуСпискаСотрудников - Строка -
// * ЗапросНаОтправкуДанныхКЭДОСотрудников - Строка -
// * ВозвратДанныхСопоставленныхСотрудников - Строка -
// * СсылкаНаПодписанныйДокумент - Строка -
// * СтатусДокументаКЭДОИзменен - Строка -
Функция ВидыСобытийБитрикс24() Экспорт

	Результат = Новый Структура;

	Результат.Вставить("ОфлайнСобытие"							, "onOfflineEvent");
	Результат.Вставить("ЗапросНаОтправкуСпискаСотрудников"		, "OnHumanResourcesHcmLinkEmployeeListRequested");
	Результат.Вставить("ЗапросНаОтправкуДанныхКЭДОСотрудников"	, "OnHumanResourcesHcmLinkFieldValueRequested");
	Результат.Вставить("ВозвратДанныхСопоставленныхСотрудников"	, "OnHumanResourcesHcmLinkEmployeeListMapped");
	Результат.Вставить("СсылкаНаПодписанныйДокумент"			, "OnSignHcmLinkB2eDocumentSigned");
	Результат.Вставить("СтатусДокументаКЭДОИзменен"				, "OnSignB2eDocumentStatusChanged");
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО") Тогда
		Результат.Вставить("ЗапросПинКода"							, "ONHUMANRESOURCESHCMLINKPINREQUESTED");
		Результат.Вставить("ЗапросРасчетногоЛистаОтпусков"			, "ONHUMANRESOURCESHCMLINKSALARYVACATIONREQUESTED");
	КонецЕсли;

	Возврат Результат;
КонецФункции

Функция ПолучитьСуммыПозицииПортала(ДанныеЭлементаТЧБ24, ОблагаетсяНДС, НалогВключен) Экспорт

	Результат = Новый Структура("Цена, Сумма, СуммаНДС, СуммаСНДС, СуммаСкидкиНаценки, ПроцентСкидки, Количество, СтавкаНДС, ТипСкидки", 0, 0, 0, 0, 0, 0, 0, Неопределено, 2);

	СтавкаНалога = ДанныеЭлементаТЧБ24.Получить("taxRate");

	Если СтавкаНалога = Неопределено Тогда
		Результат.СтавкаНДС = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьСтавкуНДСПоСтавке("Без НДС");
	ИначеЕсли ТипЗнч(СтавкаНалога) = Тип("Число") Тогда
		Результат.СтавкаНДС = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьСтавкуНДСПоСтавке(СтавкаНалога);
	КонецЕсли;

	СтавкаНалога 			= ?(ЗначениеЗаполнено(СтавкаНалога), СтавкаНалога, 0);
	Количество 				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"),  ДанныеЭлементаТЧБ24.Получить("quantity"));
	ЦенаБезСкидкиБезНалога 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"),  ДанныеЭлементаТЧБ24.Получить("priceNetto"));
	ЦенаБезСкидкиСНалогом 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"),  ДанныеЭлементаТЧБ24.Получить("priceBrutto"));
	ЦенаСоСкидкойБезНалога 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"),  ДанныеЭлементаТЧБ24.Получить("priceExclusive"));
	ЦенаИтоговая            = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"),  ДанныеЭлементаТЧБ24.Получить("price"));
	СкидкаБезНДС            = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"),  ДанныеЭлементаТЧБ24.Получить("discountSum"));
	ПроцентСкидки         	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"),  ДанныеЭлементаТЧБ24.Получить("discountRate"));

	ТипСкидкиПортала 	 	= ДанныеЭлементаТЧБ24.Получить("discountTypeId");
	Если ТипСкидкиПортала = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТипСкидкиПортала) Тогда
		ТипСкидкиПортала = 2;
	КонецЕсли;
	Результат.ТипСкидки = ОбменСБанкамиКлиентСервер.ЧислоИзСтроки(Строка(ТипСкидкиПортала));

	Результат.Количество = Количество;
	Результат.ПроцентСкидки = ПроцентСкидки;

	Если НалогВключен Тогда
		ЦенаДоСкидки = ЦенаБезСкидкиСНалогом;     // priceBrutto
	Иначе
		ЦенаДоСкидки = ЦенаБезСкидкиБезНалога;     // priceNetto
	КонецЕсли;

	Если ЗначениеЗаполнено(СкидкаБезНДС) Тогда
		Если НалогВключен Тогда
			СкидкаЗаЕдиницу = СкидкаБезНДС * (1 + СтавкаНалога / 100);
		Иначе
			СкидкаЗаЕдиницу = СкидкаБезНДС;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ПроцентСкидки) Тогда
		СкидкаЗаЕдиницу = ЦенаДоСкидки * ПроцентСкидки / 100;
	Иначе
		СкидкаЗаЕдиницу = 0;
	КонецЕсли;

	Результат.Цена = ЦенаДоСкидки;

	Результат.СуммаСкидкиНаценки = СкидкаЗаЕдиницу * Количество;

	СуммаБезНДС = ЦенаСоСкидкойБезНалога * Количество;

	Если ОблагаетсяНДС Тогда
		Результат.СуммаНДС = СуммаБезНДС * СтавкаНалога / 100;
	Иначе
		Результат.СуммаНДС = 0;
	КонецЕсли;

	Если НалогВключен Тогда
		Результат.Сумма = СуммаБезНДС + Результат.СуммаНДС;
	Иначе
		Результат.Сумма = СуммаБезНДС;
	КонецЕсли;

	Результат.СуммаСНДС = Результат.Сумма + ?(НалогВключен, 0, Результат.СуммаНДС);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РаботаСТокенами

Функция ПолучитьТокенДляСоединения(СтруктураНастроек, ОбновитьТокен = Ложь, Токен = "") Экспорт

	Если НЕ ЗначениеЗаполнено(СтруктураНастроек.НастройкаПодключения) Тогда
		НоваяНастройка = Истина;
	Иначе
		НоваяНастройка = Ложь;
		ДанныеТокена = РегистрыСведений.Б24_К_ТокеныПодключений.Получить(Новый Структура("НастройкаПодключения",СтруктураНастроек.НастройкаПодключения));
		СтруктураНастроек.НастройкиПодключения.АдресСайта = "https://" + СтруктураНастроек.Портал + "/rest/";
		СтруктураНастроек.НастройкиПодключенияАвторизации.ВременныйТокен 	= ДанныеТокена.Токен;
		СтруктураНастроек.НастройкиПодключенияАвторизации.НовыйТокен 		= ДанныеТокена.ВременныйТокен;

		Если СтрДлина(ДанныеТокена.ВременныйТокен) > 10 Тогда
			лТокен = ДанныеТокена.ВременныйТокен;
		Иначе
			лТокен = ДанныеТокена.Токен;
		КонецЕсли;
		Если ОбновитьТокен = Ложь Тогда
			Возврат Истина
		КонецЕсли;
	КонецЕсли;

	Если НЕ Токен = "" Тогда
		лТокен = Токен;
	КонецЕсли;

	Соединение = УстановитьСоединениеССервером(СтруктураНастроек.НастройкиПодключенияАвторизации);

	Если Соединение = Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Авторизация не выполнена: не удалось установить соединение с сервисом авторизации " + ИнформацияОПриложении().АдресСайта);
		Возврат Ложь;
	КонецЕсли;

	ПараметрТело  		= "grant_type=refresh_token&client_id=" + СтруктураНастроек.НастройкиПодключенияАвторизации.КодПриложения + "&client_secret=" + СтруктураНастроек.НастройкиПодключенияАвторизации.СекретныйКодПриложения + "&refresh_token=" + лТокен;
	ПараметрНачало 		= "FirstParam=first";
	ПараметрКонец 		= "LastParam=last";

	ТелоHTTPЗапроса = ПараметрНачало + "&" +ПараметрТело + "&" + ПараметрКонец;

	HTTPЗапрос = Новый HTTPЗапрос;
	HTTPЗапрос.АдресРесурса = "/oauth/token/";
	HTTPЗапрос.Заголовки.Вставить("Content-Type"	,"application/x-www-form-urlencoded; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("Content-Length"	, Формат(СтрДлина(ТелоHTTPЗапроса), "ЧГ=0"));
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоHTTPЗапроса);

	Попытка

		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		ОтветСтрокой 	= HTTPОтвет.ПолучитьТелоКакСтроку();
		// Платформа возвращает Неопределено, если тело ответа отсутствует или не является текстом
		// (например, 403 от защиты перед порталом). Дальше текст разбирается методами СтрНайти/НРег,
		// которые на Неопределено падают, и настоящая причина теряется — приводим к строке.
		Если ТипЗнч(ОтветСтрокой) <> Тип("Строка") Тогда
			ОтветСтрокой = "";
		КонецЕсли;
		сОтвета = ПрочитатьJSONНаСервере(ОтветСтрокой, Ложь);

		Если сОтвета.Свойство("error") = истина Тогда
			// Диагностика: причина отказа пишется в журнал при любом коде ошибки, а не только
			// при invalid_grant — иначе шаг получения адреса портала по токену завершается молча.
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка,
				"Авторизация не выполнена. Код ответа: " + Формат(HTTPОтвет.КодСостояния, "ЧГ=0")
				+ ". Портал вернул ошибку: '" + Строка(сОтвета.error) + "'. Ответ сервиса авторизации: " + ОтветСтрокой);

			Если сОтвета.error = "invalid_grant" Тогда
				Если СтруктураНастроек.Свойство("ПопыткаПолученияТокена") Тогда
					НомерПопытки = СтруктураНастроек.ПопыткаПолученияТокена + 1;
				Иначе
					НомерПопытки = 2
				КонецЕсли;
				Если НомерПопытки > 3 Тогда
					Возврат Ложь;
				КонецЕсли;
				СтруктураНастроек.Вставить("ПопыткаПолученияТокена", НомерПопытки);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось произвести авторизацию. Некорректен постоянный ключ авторизации.");
				ПолучитьТокенДляСоединения(СтруктураНастроек,Истина);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Получена новая пара ключей авторизации");
			КонецЕсли;

			Возврат Ложь;

		Иначе

			// Диагностика: сервис авторизации не вернул адрес портала — раньше это давало пустой портал без записи в журнал.
			Если НЕ сОтвета.Свойство("client_endpoint") ИЛИ НЕ ЗначениеЗаполнено(сОтвета.client_endpoint) Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка,
					"Авторизация не выполнена: сервис авторизации не вернул адрес портала (client_endpoint). Код ответа: "
					+ Формат(HTTPОтвет.КодСостояния, "ЧГ=0") + ". Ответ сервиса авторизации: " + ОтветСтрокой);
				Возврат Ложь;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтруктураНастроек.Портал) Тогда
				СтруктураНастроек.НастройкиПодключения.АдресСайта = СокрЛП(сОтвета.client_endpoint);
			Иначе

				Если Лев(сОтвета.client_endpoint,8) = "https://" Тогда
					СтруктураНастроек.НастройкиПодключения.АдресСайта = СокрЛП(Лев(сОтвета.client_endpoint,8) + СтруктураНастроек.Портал + "/rest/");
				Иначе
					СтруктураНастроек.НастройкиПодключения.АдресСайта = СокрЛП(Лев(сОтвета.client_endpoint,7) + СтруктураНастроек.Портал + "/rest/");
				КонецЕсли;

			КонецЕсли;

			СтруктураНастроек.НастройкиПодключенияАвторизации.ВременныйТокен 	= СокрЛП(сОтвета.access_token);
			СтруктураНастроек.НастройкиПодключенияАвторизации.НовыйТокен 		= СокрЛП(сОтвета.refresh_token);

			Если НЕ НоваяНастройка Тогда
				ЗаписатьНовыйТокен(СтруктураНастроек.НастройкаПодключения, СокрЛП(сОтвета.access_token),СокрЛП(сОтвета.refresh_token));
			КонецЕсли;

		КонецЕсли;

	Исключение

		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Ответ сервиса авторизации: " + ?(ТипЗнч(ОтветСтрокой) = Тип("Строка"), ОтветСтрокой, "(ответ не получен)"));
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось произвести авторизацию. Возможно неверно указан постоянный ключ.");

		Возврат Ложь;

	КонецПопытки;

	Возврат Истина;

КонецФункции

Процедура ЗаписатьНовыйТокен(НастройкаПодключения, НовыйТокен, ВременныйТокен) Экспорт

	ТекущаяДата = ТекущаяДатаСеанса();

	ДанныеТокена = РегистрыСведений.Б24_К_ТокеныПодключений.Получить(Новый Структура("НастройкаПодключения",НастройкаПодключения));

	НоваяЗапись = РегистрыСведений.Б24_К_ТокеныПодключений.СоздатьМенеджерЗаписи();
	НоваяЗапись.НастройкаПодключения 	= НастройкаПодключения;
	НоваяЗапись.Токен 					= НовыйТокен;
	НоваяЗапись.ВременныйТокен 			= ВременныйТокен;
	НоваяЗапись.ВремяПолученияТокена 	= ТекущаяДата;
	НоваяЗапись.Записать(Истина);

КонецПроцедуры

