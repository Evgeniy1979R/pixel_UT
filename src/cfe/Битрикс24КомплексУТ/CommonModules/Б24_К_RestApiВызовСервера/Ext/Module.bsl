Функция ПолучитьЗначениеJSONПоКлючу(СтрокаJSON, Ключ)
	// Находит значение любого ключа в JSON-строке
	СтрокаПоиска = """" + Ключ + """:";
	Позиция = СтрНайти(СтрокаJSON, СтрокаПоиска);

	Если Позиция = 0 Тогда
		СтрокаПоиска = """" + Ключ + """: ";
		Позиция = СтрНайти(СтрокаJSON, СтрокаПоиска);
	КонецЕсли;

	Если Позиция > 0 Тогда
		Начало = Позиция + СтрДлина(СтрокаПоиска);
		Конец = СтрНайти(СтрокаJSON, """", Начало);

		Если Конец > Начало Тогда
			Возврат Сред(СтрокаJSON, Начало, Конец - Начало);
		Иначе
			Возврат Сред(СтрокаJSON, Начало);
		КонецЕсли;
	КонецЕсли;

	Возврат "";
КонецФункции

