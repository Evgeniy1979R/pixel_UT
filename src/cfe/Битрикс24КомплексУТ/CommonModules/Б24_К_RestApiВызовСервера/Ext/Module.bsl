Функция РеалтаймИспользуется(НастройкаПодключения) Экспорт

	РеалТаймС = Истина;
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
		Модуль = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп");
		НастройкиС = Модуль.ПолучитьНастройкуСинхронизацииПоНастройкеПодключения(НастройкаПодключения);
		РеалТаймС = НастройкиС.ВРежимеРеальногоВремени;
	КонецЕсли;

	РеалТаймСМ = Истина;
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
		Модуль = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СМ_ОбщегоНазначенияВызовСервераПовтИсп");
		НастройкиСМ	= Модуль.ПолучитьНастройкуСинхронизацииПоНастройкеПодключения(НастройкаПодключения);
		РеалТаймСМ = НастройкиСМ.ВРежимеРеальногоВремени;
	КонецЕсли;

	Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
		РеалТаймСУ = Ложь;
	Иначе
		РеалТаймСУ = Истина;
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
			Модуль = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ОбщегоНазначенияВызовСервераПовтИсп");
			НастройкиСУХЗ = Модуль.ПолучитьНастройкуПоНастройкеПодключения(НастройкаПодключения);
			НастройкиСУ = НастройкиСУХЗ.Настройки.Получить();
			РеалТаймСУ = НастройкиСУ.НастройкииЗаказов.РезервироватьТовары;
		КонецЕсли;
	КонецЕсли;

	Результат = РеалТаймС ИЛИ РеалТаймСМ ИЛИ РеалТаймСУ;

	Возврат Результат;

КонецФункции

// Функция возвращает массив элементов, полученных с портала методом, указанным в параметрах.
//
// Параметры:
//  СтруктураНастроек - Структура - настройки для отправки данных на портал.
//  Метод - Строка - метод для получения данных с портала.
//  ИмяКолонкиИд - Строка - имя колонки идентификатора в полученных данных.
//  ТелоЗапроса - Строка - дополнительный параметр запроса, необязательный.
//  ПодчиненныйКлючРезультата - Строка - ключ для получения массива данных из результата, необязательный.
//
// Возвращаемое значение:
//  Массив - массив элементов, полученных с портала.
//
Функция МассивЭлементовПоМетодуОптимально(СтруктураНастроек, Метод, ИмяКолонкиИд, ТелоЗапроса = Неопределено, ПодчиненныйКлючРезультата = Неопределено) Экспорт

	Результат = Новый Массив;

	ПоследнийИдентификатор = 0;
	Если Лев(ТелоЗапроса, 1) <> "&" И СтрДлина(ТелоЗапроса) > 0 Тогда ТелоЗапроса = "&" + ТелоЗапроса КонецЕсли;

	Пока Истина Цикл

		ПараметрыЗапроса = "&start=-1&order["+ИмяКолонкиИд+"]=ASC&filter[>"+ИмяКолонкиИд+"]="+Строка(ПоследнийИдентификатор) + ТелоЗапроса;

		ДанныеПортала = ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ПараметрыЗапроса);
		Если ДанныеПортала = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Result = ДанныеПортала.Получить("result");
		Если Result = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Если ПодчиненныйКлючРезультата = Неопределено Тогда
			МассивДанных = Result;
		Иначе
			МассивДанных = Result.Получить(ПодчиненныйКлючРезультата);
		КонецЕсли;

		Если типЗнч(МассивДанных) <> Тип("Массив") Тогда
			Возврат Результат;
		КонецЕсли;

		Если МассивДанных.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;

		Для каждого ТекЭлемент Из МассивДанных Цикл
			Результат.Добавить(ТекЭлемент);
			ПоследнийИдентификатор = Формат(ТекЭлемент.Получить(ИмяКолонкиИд), "ЧГ=0");
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

