		Если ИнформацияОбъекта <> Неопределено и НЕ ИнформацияОбъекта["Ид_"+Ид] = Ложь Тогда  
			ТекущийОбъект 	= ИнформацияОбъекта["Ид_"+Ид];				
		КонецЕсли; 
		Возврат ТекущийОбъект
