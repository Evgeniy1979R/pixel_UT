	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("userfieldconfig.get" + "?"+"moduleId=crm&id"+"=" + ИдЭлемента);
