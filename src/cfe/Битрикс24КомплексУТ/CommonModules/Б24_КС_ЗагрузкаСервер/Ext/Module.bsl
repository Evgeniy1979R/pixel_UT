	МетодБанкСчета 	= "catalog.measure.get?id=" + Ид;
	
	ТелоHTTPЗапроса = "";
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + "cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодБанкСчета);
	
	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(пСтруктураНастроек, ТелоHTTPЗапроса);
	
	Если СтруктураОтвета = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ДополнительныйКлюч = "measure";
	result = СтруктураОтвета.Получить("result");
	Если result <> Неопределено Тогда
		result2 = result.Получить("result");
		Если result2 <> Неопределено Тогда	
			Для каждого ТекЭлемент Из result2 Цикл							
				result3 = ТекЭлемент.Получить(ДополнительныйКлюч);
				Если result3 <> Неопределено Тогда					
					СтруктураДанных.ЕдиницыИзмерения.Добавить(result3);					
				КонецЕсли							
			КонецЦикла;						
		КонецЕсли;					
	КонецЕсли;
	
	пСтруктураНастроек.Вставить("ЗначениеСсылка", Истина);
	
	Результат = ЗагрузитьОбновитьЕдиницыИзмерения2(пСтруктураНастроек, СтруктураДанных.ЕдиницыИзмерения);
	
	Если Результат.Количество() тогда
