Функция СформироватьКомпаниюКонтактПоИд(пСтруктураНастроек, ТипВладельца, Ид, Результат = Неопределено) Экспорт 
    	
	ЭлементКлиента = Новый Соответствие;
	ЭлементКлиента.Вставить("ID", Формат(Ид, "ЧГ=0"));
	
	мДанных = Новый Массив; 
	мДанных.Добавить(ЭлементКлиента);
	
	ДанныеПоКомпаниямКонтактам = Б24_КС_ОбщегоНазначенияВызовСервера.ДанныеПоКомпаниямКонтактам(пСтруктураНастроек, мДанных, ?(ТипВладельца = "Компания","4", "3"));
	
	Если Результат = Неопределено Тогда
		Результат = Справочники.Контрагенты.ПустаяСсылка();
		Если ТипВладельца = "Компания" Тогда
			ЗагрузитьОбновитьКомпании(пСтруктураНастроек, ДанныеПоКомпаниямКонтактам);
			ИнформацияОКлиенте = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьЗначениеПоИдБ24Объекта(пСтруктураНастроек.Портал, пСтруктураНастроек.ТипыОбъектовОбмена.Компания, Ид);
		Иначе			
			ЗагрузитьОбновитьКонтакты(пСтруктураНастроек, ДанныеПоКомпаниямКонтактам);	
			ИнформацияОКлиенте = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьЗначениеПоИдБ24Объекта(пСтруктураНастроек.Портал, пСтруктураНастроек.ТипыОбъектовОбмена.Контакт, Ид);
			Если ИнформацияОКлиенте = Неопределено Тогда
				ИнформацияОКлиенте = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьЗначениеПоИдБ24Объекта(пСтруктураНастроек.Портал, пСтруктураНастроек.ТипыОбъектовОбмена.Контакт, "#"+Ид);	
			КонецЕсли;
		КонецЕсли;
		
		Если ИнформацияОКлиенте = Неопределено Тогда
			Возврат Результат;	
		Иначе
			Результат = ИнформацияОКлиенте.Объект; 	
		КонецЕсли;  
	КонецЕсли;
	
	Если ИнформацияОКлиенте = Неопределено Тогда
		Возврат Результат;	
	Иначе
		Результат = ИнформацияОКлиенте.Объект; 	
	КонецЕсли;       
	
	РеквизитыКлиентов	= Новый Массив;
	БанкСчетаРеквизитов = Новый Массив;
	АдресаРеквизитов 	= Новый Массив;
	
	КоличествоЗапросов = 0;
	ТелоHTTPЗапроса = "";
	
	Для каждого ТекРеквизитМ Из ДанныеПоКомпаниямКонтактам.ИнформацияОРеквизитах Цикл 
		Для каждого ТекРеквизит Из ТекРеквизитМ Цикл 

			Если КоличествоЗапросов = 50 Тогда
				Прервать;
			КонецЕсли;
			
			РеквизитыКлиентов.Добавить(ТекРеквизит);
			
			ИдРеквизита 	= Формат(ТекРеквизит.Получить("ID"), "ЧГ=0");  
			
			МетодАдреса 	= "crm.address.list?filter[ENTITY_ID]=" + ИдРеквизита + "&filter[ENTITY_TYPE_ID]=8&start=-1"; 	
			МетодБанкСчета 	= "crm.requisite.bankdetail.list?filter[ENTITY_ID]=" + ИдРеквизита + "&start=-1"; 	
			
			ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + "cmd[A_"+ИдРеквизита+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодАдреса);
			ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + "cmd[B_"+ИдРеквизита+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(МетодБанкСчета);

			КоличествоЗапросов = КоличествоЗапросов + 1;
			
		КонецЦикла;
	КонецЦикла;
	
	
	Если ТелоHTTPЗапроса <> "" Тогда
	
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(пСтруктураНастроек, ТелоHTTPЗапроса);
		
		result = СтруктураОтвета.Получить("result");                                             
		Если result <> Неопределено Тогда                                                         
			result2 = result.Получить("result");
			Если result2 <> Неопределено Тогда 			
				
				Для каждого ТекЭлемент Из result2 Цикл 
					Если Лев(ТекЭлемент.Ключ, 2) = "A_" Тогда
						АдресаРеквизитов.Добавить(ТекЭлемент.Значение);	
					ИначеЕсли Лев(ТекЭлемент.Ключ, 2) = "B_" Тогда  
						БанкСчетаРеквизитов.Добавить(ТекЭлемент.Значение);	
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("ИнформацияОРеквизитах"	, РеквизитыКлиентов);
	ДополнительныеДанные.Вставить("ИнформацияОАдресах"		, АдресаРеквизитов);
	
	ЗагрузитьОбновитьРеквизиты(пСтруктураНастроек, ДополнительныеДанные); 
	
	ЗагрузитьОбновитьБанковскиеСчетаКомпанийКонтактов(пСтруктураНастроек, БанкСчетаРеквизитов);
	
	Возврат Результат;	

