Функция ПолучитьДоговор(СтруктураНастроек, Организация, Контрагент, ВалютаРасчетов)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Если ТипЗнч(Контрагент) <> Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Контрагенты") Тогда
		Возврат Договор;	
	КонецЕсли;
	
	НаименованиеДоговора = "Договор WEB - Битрикс24";
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("Контрагент"			, Контрагент);
	Запрос.УстановитьПараметр("ВалютаРасчетов"		, ВалютаРасчетов);
	
	Если ТипКонфигурации = "БП" Тогда
		#Область ЗапросБП
		Запрос.Текст = "ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
		|	ДоговорыКонтрагентов.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
		|	И ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Владелец = &Контрагент
		|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаРасчетов
		|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)";
		
		#КонецОбласти					
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		#Область ЗапросУТ
		Запрос.УстановитьПараметр("Партнер"				, Контрагент["Партнер"]);
		Запрос.Текст = "ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
		|	ДоговорыКонтрагентов.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
		|	И ДоговорыКонтрагентов.Организация = &Организация
		|	И ДоговорыКонтрагентов.Владелец = &Контрагент
		|	И ДоговорыКонтрагентов.Владелец = &Партнер
		|	И ДоговорыКонтрагентов.ВалютаВзаиморасчетов = &ВалютаРасчетов
		|	И ИСТИНА // ВидДоговора";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоговорыКонтрагентов.Владелец = &Контрагент", "ДоговорыКонтрагентов.Контрагент = &Контрагент");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДоговорыКонтрагентов.Владелец = &Партнер", "ДоговорыКонтрагентов.Партнер = &Партнер");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИСТИНА // ВидДоговора", "И ДоговорыКонтрагентов.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)");
		
		#КонецОбласти					
	КонецЕсли;	
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		тзнДоговоров = ВыполненныйЗапрос.Выгрузить();
		
		Если тзнДоговоров.Количество() = 1 Тогда 
			Договор = тзнДоговоров[0].Ссылка;
		Иначе
			Для каждого ТекДоговор Из тзнДоговоров Цикл	
				Если ТекДоговор.Наименование = НаименованиеДоговора Тогда
					Договор = ТекДоговор.Ссылка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовыйДоговор.Наименование 			= НаименованиеДоговора;		
		НовыйДоговор.Организация  			= Организация;
		НовыйДоговор.ВалютаВзаиморасчетов	= ВалютаРасчетов;		
		Если ТипКонфигурации = "БП" Тогда
			НовыйДоговор.Владелец	 			= Контрагент;
			НовыйДоговор.ВидДоговора			= Перечисления["ВидыДоговоровКонтрагентов"].СПокупателем;
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			НовыйДоговор["Контрагент"]	 			= Контрагент;		
			НовыйДоговор["Партнер"]	 			= Контрагент["Партнер"];
			НовыйДоговор["ПорядокРасчетов"]		= Перечисления["ПорядокРасчетов"].ПоЗаказамНакладным;
			НовыйДоговор["Статус"]					= Перечисления["СтатусыДоговоровКонтрагентов"].Действует;
			НовыйДоговор["ТипДоговора"]            = Перечисления["ТипыДоговоров"].СПокупателем;
		КонецЕсли;

НовыйДоговор.Записать();
		Договор = НовыйДоговор.Ссылка;
	КонецЕсли;
	
	Возврат Договор;
	
КонецФункции

