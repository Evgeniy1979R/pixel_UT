		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, ОписаниеПоля.ВидСущности + "/" + ОписаниеПоля.Значение + "/" + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	
	Возврат Результат;
	
КонецФункции

Функция ВыполнитьАлгоритмПередЗагрузкой(СтруктураНастроек, Объект1С, ОбъектПортала, АлгоритмКлюча)
	
	Параметры = Б24_К_ОбщегоНазначенияСервер.ПолучитьСтруктуруПараметровПредопределенногоАлгоритма();
	Параметры.СтруктураНастроек = СтруктураНастроек;
	Параметры.Объект1С 			= Объект1С;
	Параметры.ОбъектПортала 	= ОбъектПортала;
	Параметры.КлючиШапкиПортала = ОбъектПортала;

	Б24_К_ОбщегоНазначенияСервер.ПолучитьЗначениеПредопределенногоАлгоритма(АлгоритмКлюча, Параметры, "Процедура");		
		
	Возврат Параметры.Отказ = Истина;
	
КонецФункции

#КонецОбласти


#Область ПоискПартнераКомпанииПоРеквизитам
Функция НайтиПартнераКомпанииПоРеквизитамИзПакета(СтруктураНастроек, ДополнительныеДанные, ИдКомпании, МенеджерВременныхТаблиц, СправочникКомпаний)
	Результат = Справочники[СправочникКомпаний].ПустаяСсылка();
	
	Если НЕ ДополнительныеДанные.Свойство("ИнформацияОКомпаниях") Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Находим компанию в пакете обмена по COMPANY_ID
	КомпанияВПакете = Неопределено;
	Для Каждого ТекКомпания Из ДополнительныеДанные.ИнформацияОКомпаниях Цикл
		Если Формат(ТекКомпания.Получить("ID"), "ЧГ=0") = Формат(ИдКомпании, "ЧГ=0") Тогда
			КомпанияВПакете = ТекКомпания;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если КомпанияВПакете = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗаголовокКомпании = СокрЛП(Строка(КомпанияВПакете.Получить("TITLE")));
	Если НЕ ЗначениеЗаполнено(ЗаголовокКомпании) Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Ищем существующего партнера-компанию по наименованию
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", ЗаголовокКомпании);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	Справочник.Ссылка
		|ИЗ
		|	Справочник." + СправочникКомпаний + " КАК Справочник
		|ГДЕ
		|	Справочник.Наименование = &Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции
#КонецОбласти
