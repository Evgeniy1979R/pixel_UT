	Возврат МенеджерВременныхТаблиц;

КонецФункции

Функция ЗагрузитьОбновитьСчета(пСтруктураНастроек, мДанных) Экспорт
	
	Результат = Новый Массив;
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если НЕ (ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "УНФ") Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураНастроек = Новый Структура;
	Для Каждого ЭлементСтруктуры Из пСтруктураНастроек Цикл
		СтруктураНастроек.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;	
	
#Область ИдентификаторыСлужебныхСвойств	

	Если пСтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда 	
		ДопИдСвойстваПометкиУдаления	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоПометкаУдаленияСчетов, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСчета); 
		СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваПометкиУдаленияСчета", ДопИдСвойстваПометкиУдаления);
	КонецЕсли;
	
#КонецОбласти	

	ПрефиксВнешнихКодовБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПрефиксВнешнихКодовБитрикс24();
	
	МенеджерВременныхТаблиц = ПолучитьБазовыйМенеджерТаблицДляДокументов(СтруктураНастроек, Ложь);
#Область ФормированиеВременныхТаблицДанных		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;  
	Запрос.УстановитьПараметр("Портал"					, СтруктураНастроек.Портал);
	Запрос.УстановитьПараметр("ТипДанныхСделка"			, СтруктураНастроек.ТипыОбъектовОбмена.Сделка);
	Запрос.УстановитьПараметр("ТипДанныхСвойств"		, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСчета);
	Запрос.УстановитьПараметр("ТипДанныхЗначенийСвойств", СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваСчета);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ИдентификаторыСделок
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхСделка
	|	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ИдентификаторыЗначенийСвойств
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхЗначенийСвойств
	|	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Объект,
	|	ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение КАК ЭтоДополнительноеСведение,
	|	Б24_К_ИдентификаторыОбъектов.ДополнительныйИдентификатор КАК ДополнительныйИдентификатор,
	|	ДополнительныеРеквизитыИСведения.ТипЗначения КАК ТипЗначения
	|ПОМЕСТИТЬ ВТ_Свойства
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|		ПО Б24_К_ИдентификаторыОбъектов.Объект = ДополнительныеРеквизитыИСведения.Ссылка
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхСвойств
	|	И Б24_К_ИдентификаторыОбъектов.Идентификатор <> """"";
	Запрос.Выполнить();
#КонецОбласти	

	ЗагружатьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "ЗагружатьВ1С");
	ОбновлятьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "ОбновлятьВ1С");
	ОбновлятьТЧВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "ОбновлятьТЧВ1С") <> Ложь;
	АлгоритмПриЗагрузке 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "АлгоритмПриЗагрузкеДанныхВ1С");
	РежимЗаписи 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "РежимЗаписи");
	
	ПоляОбъекта1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю");
	ОтборыДляЗагрузки 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОтборыДляЗагрузкиДанныхВ1С(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю");
	
	ПоляТЧОбъекта1С 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностейТЧ(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю");
	
	ЗагруженныеОбъекты = Новый Массив;
	
	Для каждого ТекЭлемент Из мДанных.ИнформацияОСчетах Цикл
		
		Если ТипЗнч(ТекЭлемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;  
		
		ЕстьКритическиеОшибки 					= Ложь;
		ПринудительноРегистрироватьДокумент 	= Ложь;
		
		ИдЭлемента				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("ID"),"ЧГ=0"));
		ДатаВыставления			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата")	, ТекЭлемент.Получить("DATE_BILL"));
		ИдСтатуса				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("STATUS_ID"),"ЧГ=0"));
		ИдОрганизации			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("UF_MYCOMPANY_ID"),"ЧГ=0"));
		ИдКомпании				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("UF_COMPANY_ID"),"ЧГ=0"));
		ИдКонтакта				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("UF_CONTACT_ID"),"ЧГ=0"));
		
		КомментарийПользователя	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("USER_DESCRIPTION"));
		ТемаСчета				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("ORDER_TOPIC"));
		НомерСчетаБ24			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("ACCOUNT_NUMBER"));
		Оплачен					= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("PAYED"))= "Y";
		ОплатаДо				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата")	, ТекЭлемент.Получить("DATE_PAY_BEFORE"));
		
		Товары 					= ТекЭлемент.Получить("PRODUCT_ROWS");
		
		Если ЗагружатьВ1С = Ложь Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Продолжить;	
		КонецЕсли;			
		
		Если ЗагруженныеОбъекты.Найти(ИдЭлемента) <> Неопределено Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Продолжить;	
		КонецЕсли;
		ЗагруженныеОбъекты.Добавить(ИдЭлемента);
		
		НужноЗагружать = ПроверитьОбъект1СНаОтборыЗагрузки(СтруктураНастроек, ТекЭлемент, ОтборыДляЗагрузки, "Счет");
		Если НЕ НужноЗагружать Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Продолжить;	
		КонецЕсли;
		
		Если ДатаВыставления < СтруктураНастроек.НастройкиСинхронизацииСчетов.ДатаНачалаЗагрузкиСчетов Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Счет с ид:  " + Строка(ИдЭлемента) + " будет пропущена т.к. дата выставления счета  меньше даты, с которой счета  загружаются в 1С.");
			Продолжить;  			
		КонецЕсли;
		
		Если СтруктураНастроек.НастройкиСинхронизацииСчетов.Свойство("ИнформацияОСтатусах") Тогда	
			ИнформацияОСтатусах = СтруктураНастроек.НастройкиСинхронизацииСчетов.ИнформацияОСтатусах;
			Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоСчета" Тогда
				тзнСтатусов = ИнформацияОСтатусах.СоответствияЗначенийСвойств;	
			ИначеЕсли ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" Тогда	
				тзнСтатусов = ИнформацияОСтатусах.СоответствияСтатусов;	
			Иначе
				// режим "СтатусыСчета" поддерживается только в БП/ЗУП (в форме нет страницы статусов)
				тзнСтатусов = Неопределено;	
			КонецЕсли;
		Иначе
			ИнформацияОСтатусах = Неопределено;
		КонецЕсли;
		
		Если ИнформацияОСтатусах <> Неопределено И ТипЗнч(тзнСтатусов) = Тип("ТаблицаЗначений") Тогда
			
			ПропускаемСчетИзЗаСтатуса = Ложь;
			
			НайденнаяСтрока = тзнСтатусов.Найти(ИдСтатуса, "ИдСтатуса");
			
			Если НайденнаяСтрока <> Неопределено Тогда
				ПропускаемСчетИзЗаСтатуса = НайденнаяСтрока.НеЗагружать;	
			КонецЕсли;				
			
			Если ПропускаемСчетИзЗаСтатуса Тогда			
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Счет с ид:  " + Строка(ИдЭлемента) + " будет пропущена т.к. не стоит, что с таким статусом документ не загружается в 1С.");
				Продолжить;  			
			КонецЕсли;					
		КонецЕсли;				
		
		Если Товары = Неопределено Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "В счете с ид: "+ИдЭлемента+" не указаны товары. Счет будет пропущен.");
			Продолжить;  				
		КонецЕсли;
		
		Организация 	= ПолучитьОбъектПоИдентификаторуИзВременнойТаблицы(МенеджерВременныхТаблиц, "ВТ_ИдентификаторыКомпаний", ИдОрганизации);	
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Не найдена организация по ид. Попытка создания организации с Ид: " + ИдОрганизации);
			Организация = СформироватьКомпаниюКонтактПоИд(СтруктураНастроек, "Компания", ИдОрганизации);
			
			Если ЗначениеЗаполнено(Организация) И ТипЗнч(Организация) <> Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Организации") Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Найденная организация с ид: " + ИдОрганизации + " не является элемеметом справочника 'Организации'");
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Скорее всего это контрагент. Необходимо удалить привязку ид к этому контрагенту");
				Организация = Справочники.Организации.ПустаяСсылка();
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(Организация) Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не найдена организация с Ид: " + ИдОрганизации);
				ЕстьКритическиеОшибки = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		ИнформацияОКлиенте 		= ПолучитьИнформациюОКомпанииКонтакте(СтруктураНастроек, МенеджерВременныхТаблиц, ИдКомпании, ИдКонтакта);
		Контрагент				= ИнформацияОКлиенте["Контрагент"];
		//КонтактноеЛицо		= ИнформацияОКлиенте.КонтактноеЛицо;
		ЕстьКритическиеОшибки 	= ИнформацияОКлиенте.ЕстьКритическиеОшибки; 
		
		СимвольныйКодВалюты 	= ТекЭлемент.Получить("CURRENCY");
		КодВалюты = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьКодПоВалюте(СимвольныйКодВалюты);
		Валюта = Справочники.Валюты.НайтиПоКоду(КодВалюты);
		
		ПомеченНаУдаление = Ложь;
#Область ПоискПометкиНаУдаление
		Если пСтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда 	
			ЗначениеПометки  = Формат(ТекЭлемент.Получить(СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияСчета), "ЧГ=0");
			Если ЗначениеПометки = "1" Тогда
				ПомеченНаУдаление = Истина;
			КонецЕсли;         
		КонецЕсли;
#КонецОбласти	
		

		ЭтоНовыйСчет = Ложь;
#Область ПоискСозданиеСчета		
		ВнешнийКод	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("XML_ID"));
		
		Счет = СсылкаПоИдБ24(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Счет, ИдЭлемента);
		Если ЗначениеЗаполнено(ВнешнийКод) И НЕ ЗначениеЗаполнено(Счет) Тогда
			Счет = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплатуПокупателю"), ВнешнийКод);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Счет) Тогда 
			
			Если ОбновлятьВ1С Тогда
				Счет = Счет.ПолучитьОбъект();
			Иначе
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "В настройках указано, что счета не обновляются. Счет: " + Строка(Счет) + " не будет обновлена.");
				Продолжить;  				
			КонецЕсли;
			
		ИначеЕсли ПомеченНаУдаление Тогда
			
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Счет с Ид " + Строка(ИдЭлемента) + " помечен на удаление в Битрикс24. Не будет создан в 1С");
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Продолжить;
			
		Иначе  
			
			Счет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
			ЭтоНовыйСчет = Истина;
			
		КонецЕсли;
#КонецОбласти	

		Если ЭтоНовыйСчет И СтруктураНастроек.НастройкиСинхронизацииСчетов.ИсточникНомераДокумента <> "По данным с Битрикс24" Тогда
			ПринудительноРегистрироватьДокумент = Истина;
		КонецЕсли;

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПоляОбъекта1С"			, ПоляОбъекта1С);
		ДополнительныеПараметры.Вставить("ИдЭлементаБ24"			, ИдЭлемента);
		ДополнительныеПараметры.Вставить("Объект1С"					, Счет);
		ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
		ДополнительныеПараметры.Вставить("ДанныеЭлементаБ24"		, ТекЭлемент);
		ДополнительныеПараметры.Вставить("ПомеченНаУдаление"		, ПомеченНаУдаление);
		ДополнительныеПараметры.Вставить("ЭтоНовыйОбъект"			, ЭтоНовыйСчет);
		ДополнительныеПараметры.Вставить("ТаблицаСвойств"			, РазобратьПользовательскиеПоляВТаблицу(СтруктураНастроек, ТекЭлемент, МенеджерВременныхТаблиц, "Счет"));
		ДополнительныеПараметры.Вставить("Валюта"					, Валюта);
		ДополнительныеПараметры.Вставить("Организация"				, Организация);
		ДополнительныеПараметры.Вставить("Контрагент"				, Контрагент);
		ДополнительныеПараметры.Вставить("ИнформацияОРеквизитах"	, мДанных.ИнформацияОРеквизитахСчетов);
		ДополнительныеПараметры.Вставить("Товары"					, Товары);
		
		ЗаполнитьРеквизитыОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);
		
		Если ДополнительныеПараметры.НеЗагружать = Истина Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден ответственный у счета с  ид: " + ИдЭлемента + ". Будет пропущен.");
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Ложь)));
			Продолжить;
		КонецЕсли;
				
#Область ЗаполнениеТоваров	   

		Если ОбновлятьТЧВ1С Тогда  
		
			тзнТоваровАрх = Счет.Товары.Выгрузить();
			
			Счет.Товары.Очистить();	
			Для Каждого ТоварСчета Из Товары Цикл
				
				ИдПозицииДокумента	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварСчета.Получить("ID"),"ЧГ=0"));
				ИдТовара 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварСчета.Получить("PRODUCT_ID"),"ЧГ=0"));
				ВнешнийКодТовара	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТоварСчета.Получить("PRODUCT_XML_ID"));
				НаименованиеТовара	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТоварСчета.Получить("PRODUCT_NAME"));
				
				Номенклатура 	= Справочники.Номенклатура.ПустаяСсылка();
#Область ПоискТовара	
				СтруктураИдентификаторовТовара = Б24_КС_ОбщегоНазначенияВызовСервера.ПолучитьДвеСоставныеЧастиИзСтроки(ВнешнийКодТовара, "#");
				ИдВнешнийНоменклатуры 	= СтруктураИдентификаторовТовара.ПерваяЧасть;
				ИдВнешнийХарактеристики = СтруктураИдентификаторовТовара.ВтораяЧасть;
			
				Если ЗначениеЗаполнено(ИдТовара) Тогда
					
					ИнформацияОНоменклатуре = Неопределено;	
					
					Запрос = Новый Запрос;
					Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
					Запрос.УстановитьПараметр("Идентификатор", ИдТовара);
					
					Запрос.Текст = "ВЫБРАТЬ
					|	ВТ_Идентификаторы.Объект КАК Объект,
					|	ВТ_Идентификаторы.ПодчиненныйОбъект КАК ПодчиненныйОбъект
					|ИЗ
					|	ВТ_ИдентификаторыТоваров КАК ВТ_Идентификаторы
					|ГДЕ
					|	ВТ_Идентификаторы.Идентификатор = &Идентификатор";
					
					ВыполненныйЗапрос = Запрос.Выполнить();
					
					Если НЕ ВыполненныйЗапрос.Пустой() Тогда
						Выборка = ВыполненныйЗапрос.Выбрать();
						Пока Выборка.Следующий() Цикл
							ИнформацияОНоменклатуре = Выборка;
							Прервать;
						КонецЦикла;
					КонецЕсли;
					
					Номенклатура 	= ?(ИнформацияОНоменклатуре = Неопределено, Номенклатура	, ИнформацияОНоменклатуре.Объект);
					
					Если ЗначениеЗаполнено(ИдВнешнийНоменклатуры) И НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						Номенклатура = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Номенклатура"), ИдВнешнийНоменклатуры);
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Не найден товар по ид. Попытка создания товара с Ид: " + ИдТовара);
						ИнформацияОНоменклатуре = СформироватьНоменклатуруХарактеристикуПоИд(СтруктураНастроек, ИдТовара);
						
						Если ИнформацияОНоменклатуре <> Неопределено Тогда
							Номенклатура   = ИнформацияОНоменклатуре.Объект;	
						КонецЕсли;
					КонецЕсли; 
					
					Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не найдена информация о номенклатуре с Ид: " + ИдТовара);
						ЕстьКритическиеОшибки = Истина;
					КонецЕсли; 
					
				Иначе
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "В счете был указан не товар, а строка. Товар: " + НаименованиеТовара + " в счет: " + Строка(Счет) + " не будет указан.");
				КонецЕсли; 			
#КонецОбласти	
				Номенклатура = ?(ЗначениеЗаполнено(Номенклатура), Номенклатура, Справочники.Номенклатура.ПустаяСсылка());
				
				НоваяСтрока = Счет.Товары.Добавить();                 
				
				НайденныеСтроки = тзнТоваровАрх.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
				Если НайденныеСтроки.Количество() > 0 Тогда   
					ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]); 
				КонецЕсли;
				
				НоваяСтрока.Б24_К_ИдентификаторПозиции = ИдПозицииДокумента;
				
				ДополнительныеПараметрыТЧ = Новый Структура;
				ДополнительныеПараметрыТЧ.Вставить("ПоляТЧОбъекта1С"			, ПоляТЧОбъекта1С);
				ДополнительныеПараметрыТЧ.Вставить("МетаданныеТЧ"				, Метаданные.Документы.СчетНаОплатуПокупателю.ТабличныеЧасти.Товары);
				ДополнительныеПараметрыТЧ.Вставить("Объект1С"					, Счет);
				ДополнительныеПараметрыТЧ.Вставить("СтрокаТЧ"					, НоваяСтрока);
				ДополнительныеПараметрыТЧ.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
				ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаБ24"			, ТекЭлемент);  
				ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаТЧБ24"		, ТоварСчета);  
				ДополнительныеПараметрыТЧ.Вставить("ПомеченНаУдаление"			, ПомеченНаУдаление);
				ДополнительныеПараметрыТЧ.Вставить("ЭтоНовыйОбъект"				, ЭтоНовыйСчет);
				ДополнительныеПараметрыТЧ.Вставить("Номенклатура"				, Номенклатура);
				ДополнительныеПараметрыТЧ.Вставить("Характеристика"				, Неопределено);
				
				ЗаполнитьРеквизитыТЧОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметрыТЧ, "Товары");
				
				Если НайденныеСтроки.Количество() > 0 Тогда   
					тзнТоваровАрх.Удалить(НайденныеСтроки[0]);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли; 
		
#КонецОбласти		

		ДокументБезНДС = Истина;
		Для Каждого ТоварСчета Из Счет.Товары Цикл
			Если ТоварСчета.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
				ДокументБезНДС = Ложь;
				Прервать
			КонецЕсли;
		КонецЦикла;
		Счет.ДокументБезНДС = ДокументБезНДС;

		Если ЗначениеЗаполнено(АлгоритмПриЗагрузке) Тогда
			
			ОтказНаЗапись = ВыполнитьАлгоритмПередЗагрузкой(СтруктураНастроек, Счет, ТекЭлемент, АлгоритмПриЗагрузке);   
			Если ОтказНаЗапись Тогда
				Продолжить;	
			КонецЕсли; 
			
		КонецЕсли;
		
		Если ЭтоНовыйСчет И НЕ ЗначениеЗаполнено(Счет.Номер) Тогда  
			
			Если СтруктураНастроек.НастройкиСинхронизацииСчетов.ИсточникНомераДокумента = "По данным с Битрикс24" Тогда
				Счет.Номер = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("ACCOUNT_NUMBER"));
			Иначе
				Счет.УстановитьНовыйНомер();
			КонецЕсли;	
			
		КонецЕсли;
		
#Область ПроведениеДокумента
		ОтменаЗаписиСОшибкой = Ложь;
		Счет.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
		Если (РежимЗаписи = "Проводить оплаченные" И Оплачен)
			ИЛИ РежимЗаписи = "Проводить" Тогда
			
			Попытка
				Счет.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Проведен документ: " + Строка(Счет), Счет.Ссылка);
			Исключение
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время проведения документа: " + Строка(Счет) + " возникли ошибки.", Счет.Ссылка);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЕстьКритическиеОшибки = Истина;
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Попытка записи документа: " + Строка(Счет), Счет.Ссылка);
				
				Попытка
					Счет.Записать(РежимЗаписиДокумента.Запись);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан документ: " + Строка(Счет), Счет.Ссылка);
				Исключение
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Счет) + " возникли ошибки.", Счет.Ссылка);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
					СтруктураНастроек.ВыполненоБезОшибок = Ложь;
			
				КонецПопытки;
				
			КонецПопытки;
			
		Иначе
			Попытка
				Если ЭтоНовыйСчет Тогда
					Счет.Записать(РежимЗаписиДокумента.Запись); 
				ИначеЕсли Счет.Проведен Тогда
					Счет.Записать(РежимЗаписиДокумента.Проведение); 
				Иначе
					Счет.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
				КонецЕсли;
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан: " + Строка(Счет), Счет.Ссылка);
			Исключение
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Счет) + " возникли ошибки.", Счет.Ссылка);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ОтменаЗаписиСОшибкой 	= Истина;
				ЕстьКритическиеОшибки 	= Истина;
			
				СтруктураНастроек.ВыполненоБезОшибок = Ложь;
	
			КонецПопытки;
		КонецЕсли;
		
		
		Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, НЕ ЕстьКритическиеОшибки)));
#КонецОбласти	
		
		Если ЗначениеЗаполнено(Счет.Ссылка) Тогда
			
			РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.Счет, Счет.Ссылка, ИдЭлемента);
			
			Если ЭтоНовыйСчет И СтруктураНастроек.НастройкиСинхронизацииСчетов.ИсточникНомераДокумента <> "По данным с Битрикс24" ИЛИ ПринудительноРегистрироватьДокумент Тогда     //чтобы в Б24 у счета был номер 1С
				
				Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(СтруктураНастроек.НастройкаПодключения, СтруктураНастроек.ТипыОбъектовОбмена.Счет, Счет.Ссылка);	
			
				//СоответствияТипов = Новый Соответствие;
				//СоответствияТипов.Вставить(СтруктураНастроек.ТипыОбъектовОбмена.Счет, Истина);
				//
				//ПараметрыЗапроса = Новый Структура;
				//ПараметрыЗапроса.Вставить("НастройкаПодключения", СтруктураНастроек.НастройкаПодключения);
				//ПараметрыЗапроса.Вставить("СоответствияТипов"	, СоответствияТипов);
				//ПараметрыЗапроса.Вставить("НастройкаПодключения", СтруктураНастроек.НастройкаПодключения);
				//ПараметрыЗапроса.Вставить("ПолнаяВыгрузка"		, СтруктураНастроек.ПолнаяВыгрузка);
				//ПараметрыЗапроса.Вставить("ПолнаяЗагрузка"		, СтруктураНастроек.ПолнаяЗагрузка);
				//ПараметрыЗапроса.Вставить("ВидСинхронизации"	, СтруктураНастроек.ВидСинхронизации);
				//	
				//Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_КС_ОбщегоНазначенияВызовСервера.ЗапуститьВыполнениеВыгрузкиОпределенныхТиповВФоне", "Обновление информации на портале", ПараметрыЗапроса, 2); 
				
			КонецЕсли;
			
			Если НЕ ОтменаЗаписиСОшибкой Тогда
				
				ЗаполнитьДополнительныеСведенияОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);			

#Область ЗаполнениеСтатуса		
				Если тзнСтатусов <> Неопределено Тогда
					
					Статус 	= Неопределено; 			
					НайденнаяСтрока = тзнСтатусов.Найти(ИдСтатуса, "ИдСтатуса");
					
					Если НайденнаяСтрока <> Неопределено Тогда
						Статус = НайденнаяСтрока["Статус"];	
					КонецЕсли;
					
					Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СтатусыСчета" Тогда
						УстановитьСтатусСчета(Счет.Ссылка, Статус);
					ИначеЕсли ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоСчета" И ЗначениеЗаполнено(ИнформацияОСтатусах.СвойствоСчета) Тогда
						
						НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.Объект.Установить(Счет.Ссылка);
						НаборЗаписей.Отбор.Свойство.Установить(ИнформацияОСтатусах.СвойствоСчета);

						Запись = НаборЗаписей.Добавить();
						Запись.Объект 		= Счет.Ссылка;
						Запись.Свойство    	= ИнформацияОСтатусах.СвойствоСчета;
						Запись.Значение  	= Статус;
						
						НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
						НаборЗаписей.Записать();

						СтатусДокумента = РегистрыСведений.СтатусыДокументов.ПолучитьСтатусыДокумента(Счет.Ссылка, Счет.Организация); 
						
						Если НЕ ЗначениеЗаполнено(СтатусДокумента) Тогда
							УстановитьСтатусСчета(Счет.Ссылка, Перечисления.СтатусОплатыСчета.НеОплачен);
						КонецЕсли;
						
					КонецЕсли
				КонецЕсли;
#КонецОбласти	

#Область ДобавлениеСведенийДокумента		
				Если ЗначениеЗаполнено(Счет.Ссылка) Тогда
					
					ТаблицаПредСвойств = Новый ТаблицаЗначений;
					ТаблицаПредСвойств.Колонки.Добавить("Свойство");
					ТаблицаПредСвойств.Колонки.Добавить("ЗначениеСвойства");
					НовСтрока = ТаблицаПредСвойств.Добавить();
					НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНазваниеТемыСчета; 
					НовСтрока.ЗначениеСвойства 	= ТемаСчета; 
					НовСтрока = ТаблицаПредСвойств.Добавить();
					НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомерСчетаБитрикс24; 
					НовСтрока.ЗначениеСвойства 	= НомерСчетаБ24; 
					НовСтрока = ТаблицаПредСвойств.Добавить();
					НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДатаСчетаБитрикс24; 
					НовСтрока.ЗначениеСвойства 	= ДатаВыставления; 
					НовСтрока = ТаблицаПредСвойств.Добавить();
					НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНазваниеКомментарияСчета; 
					НовСтрока.ЗначениеСвойства 	= КомментарийПользователя; 
					
					НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Объект.Установить(Счет.Ссылка);
					НаборЗаписей.Прочитать();

					Для Каждого ТекСвойство Из ТаблицаПредСвойств Цикл
								
						ЕстьСвойство = Ложь;
								
						Для Каждого ТекСтрока Из НаборЗаписей Цикл
							Если ТекСтрока.Свойство = ТекСвойство.Свойство Тогда
								ЕстьСвойство = Истина;
								ТекСтрока.Значение = ТекСвойство.ЗначениеСвойства;	
							КонецЕсли;
						КонецЦикла;
								
						Если ЕстьСвойство = Ложь Тогда
							НоваяЗапись = НаборЗаписей.Добавить();
							НоваяЗапись.Объект = Счет.Ссылка;
							НоваяЗапись.Свойство = ТекСвойство.Свойство;
							НоваяЗапись.Значение = ТекСвойство.ЗначениеСвойства;
						КонецЕсли;
					КонецЦикла;
				
					НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
					НаборЗаписей.Записать();
					
					НаборЗаписей = РегистрыСведений.СрокиОплатыДокументов.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Документ.Значение = Счет.Ссылка;
					НаборЗаписей.Отбор.Документ.Использование = Истина;
					
					Запись = НаборЗаписей.Добавить();
					Запись.Организация = Счет.Организация;
					Запись.Документ    = Счет.Ссылка;
					Запись.СрокОплаты  = ОплатаДо;
					
					НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
					НаборЗаписей.Записать();
					
				КонецЕсли;
#КонецОбласти		
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	пСтруктураНастроек.Логирование.НомерСообщения = СтруктураНастроек.Логирование.НомерСообщения; 	// чтобы лог не затерся.
	
	Возврат Результат;
	
КонецФункции

Функция ЗагрузитьОбновитьСчета2(пСтруктураНастроек, мДанных) Экспорт
	
	Результат = Новый Массив; 
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если НЕ (ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "УНФ") Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураНастроек = Новый Структура;
	Для Каждого ЭлементСтруктуры Из пСтруктураНастроек Цикл
		СтруктураНастроек.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;	
	
#Область ИдентификаторыСлужебныхСвойств	

	Если пСтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда 	
		ДопИдСвойстваПометкиУдаления	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоПометкаУдаленияСчетов, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСчета2); 
		СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваПометкиУдаленияСчета", ДопИдСвойстваПометкиУдаления);
	КонецЕсли;
	
#КонецОбласти	

	ПрефиксВнешнихКодовБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПрефиксВнешнихКодовБитрикс24();
	
	МенеджерВременныхТаблиц = ПолучитьБазовыйМенеджерТаблицДляДокументов(СтруктураНастроек);	
#Область ФормированиеВременныхТаблицДанных		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;   
	Запрос.УстановитьПараметр("Портал"					, СтруктураНастроек.Портал);
	Запрос.УстановитьПараметр("ТипДанныхСделка"			, СтруктураНастроек.ТипыОбъектовОбмена.Сделка);
	Запрос.УстановитьПараметр("ТипДанныхСвойств"		, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСчета2);
	Запрос.УстановитьПараметр("ТипДанныхЗначенийСвойств", СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваСчета2);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ИдентификаторыСделок
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхСделка
	|	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_ИдентификаторыЗначенийСвойств
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхЗначенийСвойств
	|	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Объект,
	|	ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение КАК ЭтоДополнительноеСведение,
	|	Б24_К_ИдентификаторыОбъектов.ДополнительныйИдентификатор КАК ДополнительныйИдентификатор,
	|	ДополнительныеРеквизитыИСведения.ТипЗначения КАК ТипЗначения
	|ПОМЕСТИТЬ ВТ_Свойства
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|		ПО Б24_К_ИдентификаторыОбъектов.Объект = ДополнительныеРеквизитыИСведения.Ссылка
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхСвойств
	|	И Б24_К_ИдентификаторыОбъектов.Идентификатор <> """"";
	Запрос.Выполнить();
#КонецОбласти	

   	ЗагружатьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "ЗагружатьВ1С");
	ОбновлятьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "ОбновлятьВ1С");
	ОбновлятьТЧВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "ОбновлятьТЧВ1С") <> Ложь;
	АлгоритмПриЗагрузке 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "АлгоритмПриЗагрузкеДанныхВ1С");
	РежимЗаписи 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "РежимЗаписи");
	
	ПоляОбъекта1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю");
	ОтборыДляЗагрузки 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОтборыДляЗагрузкиДанныхВ1С(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю");
	
	ПоляТЧОбъекта1С 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностейТЧ(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю");
	
	ЗагруженныеОбъекты = Новый Массив;
	
	Для каждого ЭлементМассива Из мДанных Цикл
		
		ДанныеСчета = ЭлементМассива;
		Если ТипЗнч(ДанныеСчета) = Тип("КлючИЗначение") Тогда 
			ДанныеСчета = ДанныеСчета.Значение; 
		КонецЕсли;  
		
		Если ТипЗнч(ДанныеСчета) <> Тип("Соответствие") Тогда 
			Продолжить;
		КонецЕсли;  
		
		ШапкаСчета 	= ДанныеСчета.Получить("item");
		ТЧСчета 	= ДанныеСчета.Получить("productrow");
		
		ЕстьКритическиеОшибки 					= Ложь;
		ПринудительноРегистрироватьДокумент 	= Ложь;
		СтрокаСоответствийСтатусов				= Неопределено;
		
		ИдЭлемента 		= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСчета.Получить("id"),"ЧГ=0"));
		
		ДатаВыставления	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата"), ШапкаСчета.Получить("begindate"));
		Если ТипЗнч(ДатаВыставления) <> Тип("Дата") Тогда
			ДатаВыставления = ШапкаСчета.Получить("begindate");
			
			Если ЗначениеЗаполнено(ДатаВыставления) Тогда
				ДатаВыставления = Дата(ДатаВыставления + " 0:00:00");	
			Иначе
				ДатаВыставления = ТекущаяДатаСеанса();	
			КонецЕсли;
		КонецЕсли;
		
		ИдНаправления			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСчета.Получить("categoryId"),"ЧГ=0"));
		ИдСтатуса				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСчета.Получить("stageId"),"ЧГ=0"));
		ИдОрганизации			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСчета.Получить("mycompanyId"),"ЧГ=0"));
		ИдКомпании				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСчета.Получить("companyId"),"ЧГ=0"));
		ИдКонтакта				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСчета.Получить("contactId"),"ЧГ=0"));
		
		ТемаСчета				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ШапкаСчета.Получить("title"));
		НомерСчетаБ24			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ШапкаСчета.Получить("accountNumber"));
		ОплатаДо				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата")	, ШапкаСчета.Получить("closedate"));
		
		Если ЗагружатьВ1С = Ложь Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Продолжить;	
		КонецЕсли;	
		
		Если ЗагруженныеОбъекты.Найти(ИдЭлемента) <> Неопределено Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Продолжить;	
		КонецЕсли;
		ЗагруженныеОбъекты.Добавить(ИдЭлемента);
		
		НужноЗагружать = ПроверитьОбъект1СНаОтборыЗагрузки(СтруктураНастроек, ШапкаСчета, ОтборыДляЗагрузки, "Счет2");
		Если НЕ НужноЗагружать Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Продолжить;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаВыставления) И ДатаВыставления < СтруктураНастроек.НастройкиСинхронизацииСчетов.ДатаНачалаЗагрузкиСчетов Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Счет с ид:  " + Строка(ИдЭлемента) + " будет пропущена т.к. дата выставления счета  меньше даты, с которой счета  загружаются в 1С.");
			Продолжить;  			
		КонецЕсли;
		
		Если СтруктураНастроек.НастройкиСинхронизацииСчетов.Свойство("ИнформацияОСтатусах") Тогда	
			ИнформацияОСтатусах = СтруктураНастроек.НастройкиСинхронизацииСчетов.ИнформацияОСтатусах;
			Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоСчета" Тогда
				тзнСтатусов = ИнформацияОСтатусах.СоответствияЗначенийСвойств;	
			ИначеЕсли ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" Тогда	
				тзнСтатусов = ИнформацияОСтатусах.СоответствияСтатусов;	
			Иначе
				// режим "СтатусыСчета" поддерживается только в БП/ЗУП (в форме нет страницы статусов)
				тзнСтатусов = Неопределено;	
			КонецЕсли;
		Иначе
			ИнформацияОСтатусах = Неопределено;
		КонецЕсли;
		
		Если ИнформацияОСтатусах <> Неопределено И ТипЗнч(тзнСтатусов) = Тип("ТаблицаЗначений") Тогда
			
			ПропускаемСчетИзЗаСтатуса = Ложь;
			
			Если тзнСтатусов.Колонки.Найти("ИдНаправления") <> Неопределено Тогда
				
				НайденныеСтроки = тзнСтатусов.НайтиСтроки(Новый Структура("ИдСтатуса,ИдНаправления",ИдСтатуса,ИдНаправления));
				Если НайденныеСтроки.Количество() > 0 Тогда
					СтрокаСоответствийСтатусов = НайденныеСтроки[0];
					ПропускаемСчетИзЗаСтатуса = СтрокаСоответствийСтатусов.НеЗагружать;	
				КонецЕсли;				
				
				Если ПропускаемСчетИзЗаСтатуса Тогда			
					Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Счет с ид:  " + Строка(ИдЭлемента) + " будет пропущена т.к. не стоит, что с таким статусом документ не загружается в 1С.");
					Продолжить;  			
				КонецЕсли;	
				
			Иначе
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Для счетов не задано сопоставление статусов");
			КонецЕсли;
			
		КонецЕсли;				
		
		Организация 	= ПолучитьОбъектПоИдентификаторуИзВременнойТаблицы(МенеджерВременныхТаблиц, "ВТ_ИдентификаторыКомпаний", ИдОрганизации);	
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			
			Организация = Справочники.Организации.ПустаяСсылка();

			Если ЗначениеЗаполнено(ИдОрганизации) Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Не найдена организация по ид. Попытка создания организации с Ид: " + ИдОрганизации);
				Организация = СформироватьКомпаниюКонтактПоИд(СтруктураНастроек, "Компания", ИдОрганизации);  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Организация) Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не найдена организация с Ид: " + ИдОрганизации);
				ЕстьКритическиеОшибки = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Организация) И ТипЗнч(Организация) <> Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Организации") Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Найденная организация с ид: " + ИдОрганизации + " не является элемеметом справочника 'Организации'");
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Скорее всего это контрагент. Необходимо удалить привязку ид к этому контрагенту");
			Организация = Справочники.Организации.ПустаяСсылка();
			ЕстьКритическиеОшибки = Истина;
		КонецЕсли;
		
		ИнформацияОКлиенте 		= ПолучитьИнформациюОКомпанииКонтакте(СтруктураНастроек, МенеджерВременныхТаблиц, ИдКомпании, ИдКонтакта);
		Контрагент				= ИнформацияОКлиенте["Контрагент"];
		//КонтактноеЛицо		= ИнформацияОКлиенте.КонтактноеЛицо;
		ЕстьКритическиеОшибки 	= ИнформацияОКлиенте.ЕстьКритическиеОшибки; 
		
		СимвольныйКодВалюты 	= ШапкаСчета.Получить("currencyId");
		КодВалюты = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьКодПоВалюте(СимвольныйКодВалюты);
		Валюта = Справочники.Валюты.НайтиПоКоду(КодВалюты);
		
		ПомеченНаУдаление = Ложь;
#Область ПоискПометкиНаУдаление
		Если пСтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда 	            
			
			КлючПоля = СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияСчета;
			КлючПоля = Б24_К_ОбщегоНазначенияВызовСервера.КонвертацияИмёнКлючей("Счет2", КлючПоля);
	
			ЗначениеПометки  = Формат(ШапкаСчета.Получить(КлючПоля),"ЧГ=0");
			Если ЗначениеПометки = "1" ИЛИ ЗначениеПометки = "Y" Тогда
				ПомеченНаУдаление = Истина;
			КонецЕсли; 
			
		КонецЕсли;
#КонецОбласти	

		ЭтоНовыйСчет = Ложь;
#Область ПоискСозданиеСчета		
		ВнешнийКод	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ШапкаСчета.Получить("xmlId"));
		
		Счет = СсылкаПоИдБ24(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Счет2, ИдЭлемента);
		Если ЗначениеЗаполнено(ВнешнийКод) И НЕ ЗначениеЗаполнено(Счет) Тогда
			Счет = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплатуПокупателю"), ВнешнийКод);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Счет) Тогда 
			
			Если ОбновлятьВ1С Тогда
				Счет = Счет.ПолучитьОбъект();
			Иначе           
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "В настройках указано, что счета не обновляются. Счет: " + Строка(Счет) + " не будет обновлена.");
				
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));       
				
				Продолжить; 
				
			КонецЕсли;
			
		ИначеЕсли ПомеченНаУдаление Тогда
			
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Счет с Ид " + Строка(ИдЭлемента) + " помечен на удаление в Битрикс24. Не будет создан в 1С");
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Истина)));
			Продолжить;
			
		Иначе  
			
			Счет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
			ЭтоНовыйСчет = Истина;
			
		КонецЕсли;
#КонецОбласти	

		Если ЭтоНовыйСчет И СтруктураНастроек.НастройкиСинхронизацииСчетов.ИсточникНомераДокумента <> "По данным с Битрикс24" Тогда
			ПринудительноРегистрироватьДокумент = Истина;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПоляОбъекта1С"			, ПоляОбъекта1С);
		ДополнительныеПараметры.Вставить("ИдЭлементаБ24"			, ИдЭлемента);
		ДополнительныеПараметры.Вставить("Объект1С"					, Счет);
		ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
		ДополнительныеПараметры.Вставить("ДанныеЭлементаБ24"		, ШапкаСчета);
		ДополнительныеПараметры.Вставить("ПомеченНаУдаление"		, ПомеченНаУдаление);
		ДополнительныеПараметры.Вставить("ЭтоНовыйОбъект"			, ЭтоНовыйСчет);
		ДополнительныеПараметры.Вставить("ТаблицаСвойств"			, РазобратьПользовательскиеПоляВТаблицу(СтруктураНастроек, ШапкаСчета, МенеджерВременныхТаблиц, "Счет2"));
		ДополнительныеПараметры.Вставить("Валюта"					, Валюта);
		ДополнительныеПараметры.Вставить("Организация"				, Организация);
		ДополнительныеПараметры.Вставить("Контрагент"				, Контрагент);
		ДополнительныеПараметры.Вставить("Товары"					, ТЧСчета);
		
		ЗаполнитьРеквизитыОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);
		
		Если ДополнительныеПараметры.НеЗагружать = Истина Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден ответственный у счета с  ид: " + ИдЭлемента + ". Будет пропущен.");
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, Ложь)));
			Продолжить;
		КонецЕсли;
				
#Область ЗаполнениеТоваров	

		Если ОбновлятьТЧВ1С Тогда   
		
			тзнТоваровАрх = Счет.Товары.Выгрузить();
			
			Счет.Товары.Очистить();	
			Для Каждого ТоварСчета Из ТЧСчета Цикл
				
				Если ТипЗнч(ТоварСчета) <> Тип("Соответствие") Тогда Продолжить КонецЕсли;    
				
				ИдПозицииДокумента	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварСчета.Получить("id"),"ЧГ=0")); 
				ИдТовара			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварСчета.Получить("productId"),"ЧГ=0"));
				НаименованиеТовара	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Строка(ТоварСчета.Получить("productName")));	
					
				Номенклатура 	= Справочники.Номенклатура.ПустаяСсылка();
#Область ПоискТовара	
			
				Если ЗначениеЗаполнено(ИдТовара) Тогда
					
					ИнформацияОНоменклатуре = Неопределено;	
					
					Запрос = Новый Запрос;
					Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
					Запрос.УстановитьПараметр("Идентификатор", ИдТовара);
					
					Запрос.Текст = "ВЫБРАТЬ
					|	ВТ_Идентификаторы.Объект КАК Объект
					|ИЗ
					|	ВТ_ИдентификаторыТоваров КАК ВТ_Идентификаторы
					|ГДЕ
					|	ВТ_Идентификаторы.Идентификатор = &Идентификатор";
					
					ВыполненныйЗапрос = Запрос.Выполнить();
					
					Если НЕ ВыполненныйЗапрос.Пустой() Тогда
						Выборка = ВыполненныйЗапрос.Выбрать();
						Пока Выборка.Следующий() Цикл
							ИнформацияОНоменклатуре = Выборка;
							Прервать;
						КонецЦикла;
					КонецЕсли;
					
					Номенклатура 	= ?(ИнформацияОНоменклатуре = Неопределено, Номенклатура, ИнформацияОНоменклатуре.Объект);
					
					Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Не найден товар по ид. Попытка создания товара с Ид: " + ИдТовара);
						ИнформацияОНоменклатуре = СформироватьНоменклатуруХарактеристикуПоИд(СтруктураНастроек, ИдТовара);
						
						Если ИнформацияОНоменклатуре <> Неопределено Тогда
							Номенклатура   = ИнформацияОНоменклатуре.Объект;	
						КонецЕсли;
					КонецЕсли; 
					
					Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не найдена информация о номенклатуре с Ид: " + ИдТовара);
						ЕстьКритическиеОшибки = Истина;
					КонецЕсли; 
					
				Иначе
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "В счете был указан не товар, а строка. Товар: " + НаименованиеТовара + " в счет: " + Строка(Счет) + " не будет указан.");
				КонецЕсли; 			
#КонецОбласти	
				Номенклатура = ?(ЗначениеЗаполнено(Номенклатура), Номенклатура, Справочники.Номенклатура.ПустаяСсылка());
				
				НоваяСтрока = Счет.Товары.Добавить();
				
				НайденныеСтроки = тзнТоваровАрх.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
				Если НайденныеСтроки.Количество() > 0 Тогда     
					ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);  
				КонецЕсли;
				
				НоваяСтрока.Б24_К_ИдентификаторПозиции = ИдПозицииДокумента;			
				
				ДополнительныеПараметрыТЧ = Новый Структура;
				ДополнительныеПараметрыТЧ.Вставить("ПоляТЧОбъекта1С"			, ПоляТЧОбъекта1С);
				ДополнительныеПараметрыТЧ.Вставить("МетаданныеТЧ"				, Метаданные.Документы.СчетНаОплатуПокупателю.ТабличныеЧасти.Товары);
				ДополнительныеПараметрыТЧ.Вставить("Объект1С"					, Счет);
				ДополнительныеПараметрыТЧ.Вставить("СтрокаТЧ"					, НоваяСтрока);
				ДополнительныеПараметрыТЧ.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц); 
				ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаБ24"			, ШапкаСчета); 
				ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаТЧБ24"		, ТоварСчета);
				ДополнительныеПараметрыТЧ.Вставить("ПомеченНаУдаление"			, ПомеченНаУдаление);
				ДополнительныеПараметрыТЧ.Вставить("ЭтоНовыйОбъект"				, ЭтоНовыйСчет);
				ДополнительныеПараметрыТЧ.Вставить("Номенклатура"				, Номенклатура);
				ДополнительныеПараметрыТЧ.Вставить("Характеристика"				, Неопределено);
				
				ЗаполнитьРеквизитыТЧОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметрыТЧ, "Товары");
				
				Если НайденныеСтроки.Количество() > 0 Тогда     
					тзнТоваровАрх.Удалить(НайденныеСтроки[0]);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли; 
		
		ДокументБезНДС = Истина;
		Для Каждого ТоварСчета Из Счет.Товары Цикл
			Если ТоварСчета.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда
				ДокументБезНДС = Ложь;
				Прервать
			КонецЕсли;
		КонецЦикла;
		Счет.ДокументБезНДС = ДокументБезНДС;

#КонецОбласти		
		
		Если ЗначениеЗаполнено(АлгоритмПриЗагрузке) Тогда
			
			ОтказНаЗапись = ВыполнитьАлгоритмПередЗагрузкой(СтруктураНастроек, Счет, ШапкаСчета, АлгоритмПриЗагрузке);  
			Если ОтказНаЗапись Тогда
				Продолжить;	
			КонецЕсли; 
			
		КонецЕсли;
		
		Если ЭтоНовыйСчет Тогда   // Для выгрузки дела при создании в 1С
			
			Счет.УстановитьСсылкуНового(Документы.СчетНаОплатуПокупателю.ПолучитьСсылку());
			
			Если СтруктураНастроек.КонфигурируемыеДела Тогда
				РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.КонфигурируемоеДелоСчета, Счет.ПолучитьСсылкуНового(), "", ИдЭлемента);
			Иначе			
				РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.ДелоСчета, Счет.ПолучитьСсылкуНового(), "", ИдЭлемента);
			КонецЕсли;
			
		КонецЕсли;		
		
		Если ЭтоНовыйСчет И НЕ ЗначениеЗаполнено(Счет.Номер) Тогда   // Для выгрузки дела при создании в 1С
			
			Если СтруктураНастроек.НастройкиСинхронизацииСчетов.ИсточникНомераДокумента = "По данным с Битрикс24" Тогда
				Счет.Номер = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ШапкаСчета.Получить("accountNumber"));
			Иначе
				Счет.УстановитьНовыйНомер();
			КонецЕсли;	
			
		КонецЕсли;		
		
#Область ПроведениеДокумента
		ОтменаЗаписиСОшибкой = Ложь;
		Счет.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
		
		Если РежимЗаписи = "Проводить" Тогда
			
			Попытка
				Счет.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Проведен документ: " + Строка(Счет), Счет.Ссылка);
			Исключение
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время проведения документа: " + Строка(Счет) + " возникли ошибки.", Счет.Ссылка);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЕстьКритическиеОшибки = Истина;
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Попытка записи документа: " + Строка(Счет), Счет.Ссылка);
				
				Попытка
					Счет.Записать(РежимЗаписиДокумента.Запись);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан документ: " + Строка(Счет), Счет.Ссылка);
				Исключение
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Счет) + " возникли ошибки.", Счет.Ссылка);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
					СтруктураНастроек.ВыполненоБезОшибок = Ложь;
			
				КонецПопытки;
				
			КонецПопытки;
			
		Иначе
			Попытка
				Если ЭтоНовыйСчет Тогда
					Счет.Записать(РежимЗаписиДокумента.Запись); 
				ИначеЕсли Счет.Проведен Тогда
					Счет.Записать(РежимЗаписиДокумента.Проведение); 
				Иначе
					Счет.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
				КонецЕсли;
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан: " + Строка(Счет), Счет.Ссылка);
			Исключение
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Счет) + " возникли ошибки.", Счет.Ссылка);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ОтменаЗаписиСОшибкой 	= Истина;
				ЕстьКритическиеОшибки 	= Истина;
			
				СтруктураНастроек.ВыполненоБезОшибок = Ложь;
	
			КонецПопытки;
		КонецЕсли;
		
		
		Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдЭлемента, НЕ ЕстьКритическиеОшибки)));
#КонецОбласти	
		
		Если ЗначениеЗаполнено(Счет.Ссылка) Тогда
			
			РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.Счет2, Счет.Ссылка, ИдЭлемента);
			
			Если ЭтоНовыйСчет И СтруктураНастроек.НастройкиСинхронизацииСчетов.ИсточникНомераДокумента <> "По данным с Битрикс24" ИЛИ ПринудительноРегистрироватьДокумент Тогда     //чтобы в Б24 у счета был номер 1С
				
				ВремяЗаписиВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах() + 1000*30;				
				Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(СтруктураНастроек.НастройкаПодключения, СтруктураНастроек.ТипыОбъектовОбмена.Счет2, Счет.Ссылка, ВремяЗаписиВМиллисекундах);	
				
				//СоответствияТипов = Новый Соответствие;
				//СоответствияТипов.Вставить(СтруктураНастроек.ТипыОбъектовОбмена.Счет2, Истина);
				//
				//ПараметрыЗапроса = Новый Структура;
				//ПараметрыЗапроса.Вставить("НастройкаПодключения", СтруктураНастроек.НастройкаПодключения);
				//ПараметрыЗапроса.Вставить("СоответствияТипов"	, СоответствияТипов);
				//ПараметрыЗапроса.Вставить("НастройкаПодключения", СтруктураНастроек.НастройкаПодключения);
				//ПараметрыЗапроса.Вставить("ПолнаяВыгрузка"		, СтруктураНастроек.ПолнаяВыгрузка);
				//ПараметрыЗапроса.Вставить("ПолнаяЗагрузка"		, СтруктураНастроек.ПолнаяЗагрузка);
				//ПараметрыЗапроса.Вставить("ВидСинхронизации"	, СтруктураНастроек.ВидСинхронизации);
				//	
				//Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_КС_ОбщегоНазначенияВызовСервера.ЗапуститьВыполнениеВыгрузкиОпределенныхТиповВФоне", "Обновление информации на портале", ПараметрыЗапроса, 2); 
				
			КонецЕсли;
			
			Если НЕ ОтменаЗаписиСОшибкой Тогда
				ЗаполнитьДополнительныеСведенияОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);	
				
#Область ЗаполнениеСтатуса		
				Если тзнСтатусов <> Неопределено Тогда
					
					Статус 	= Неопределено; 			
					НайденнаяСтрока = тзнСтатусов.Найти(ИдСтатуса, "ИдСтатуса");
					
					Если НайденнаяСтрока <> Неопределено Тогда
						Статус = НайденнаяСтрока["Статус"];	
					КонецЕсли;
					
					Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СтатусыСчета" Тогда
						УстановитьСтатусСчета(Счет.Ссылка, Статус);
					ИначеЕсли ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоСчета" И ЗначениеЗаполнено(ИнформацияОСтатусах.СвойствоСчета) Тогда
						
						НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.Объект.Установить(Счет.Ссылка);
						НаборЗаписей.Отбор.Свойство.Установить(ИнформацияОСтатусах.СвойствоСчета);

						Запись = НаборЗаписей.Добавить();
						Запись.Объект 		= Счет.Ссылка;
						Запись.Свойство    	= ИнформацияОСтатусах.СвойствоСчета;
						Запись.Значение  	= Статус;
						
						НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
						НаборЗаписей.Записать();

						СтатусДокумента = РегистрыСведений.СтатусыДокументов.ПолучитьСтатусыДокумента(Счет.Ссылка, Счет.Организация); 
						
						Если НЕ ЗначениеЗаполнено(СтатусДокумента) Тогда
							УстановитьСтатусСчета(Счет.Ссылка, Перечисления.СтатусОплатыСчета.НеОплачен);
						КонецЕсли;
						
					КонецЕсли
				КонецЕсли;
#КонецОбласти					

#Область ДобавлениеСведенийДокумента		
				Если ЗначениеЗаполнено(Счет.Ссылка) Тогда
					
					ТаблицаПредСвойств = Новый ТаблицаЗначений;
					ТаблицаПредСвойств.Колонки.Добавить("Свойство");
					ТаблицаПредСвойств.Колонки.Добавить("ЗначениеСвойства");
					НовСтрока = ТаблицаПредСвойств.Добавить();
					НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНазваниеТемыСчета; 
					НовСтрока.ЗначениеСвойства 	= ТемаСчета; 
					НовСтрока = ТаблицаПредСвойств.Добавить();
					НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомерСчетаБитрикс24; 
					НовСтрока.ЗначениеСвойства 	= НомерСчетаБ24; 
					НовСтрока = ТаблицаПредСвойств.Добавить();
					НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДатаСчетаБитрикс24; 
					НовСтрока.ЗначениеСвойства 	= ДатаВыставления; 
					
					НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Объект.Установить(Счет.Ссылка);
					НаборЗаписей.Прочитать();

					Для Каждого ТекСвойство Из ТаблицаПредСвойств Цикл
								
						ЕстьСвойство = Ложь;
								
						Для Каждого ТекСтрока Из НаборЗаписей Цикл
							Если ТекСтрока.Свойство = ТекСвойство.Свойство Тогда
								ЕстьСвойство = Истина;
								ТекСтрока.Значение = ТекСвойство.ЗначениеСвойства;	
							КонецЕсли;
						КонецЦикла;
								
						Если ЕстьСвойство = Ложь Тогда
							НоваяЗапись = НаборЗаписей.Добавить();
							НоваяЗапись.Объект = Счет.Ссылка;
							НоваяЗапись.Свойство = ТекСвойство.Свойство;
							НоваяЗапись.Значение = ТекСвойство.ЗначениеСвойства;
						КонецЕсли;
					КонецЦикла;
				
					НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
					НаборЗаписей.Записать();
					
					НаборЗаписей = РегистрыСведений.СрокиОплатыДокументов.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Документ.Значение = Счет.Ссылка;
					НаборЗаписей.Отбор.Документ.Использование = Истина;
					
					Запись = НаборЗаписей.Добавить();
					Запись.Организация = Счет.Организация;
					Запись.Документ    = Счет.Ссылка;
					Запись.СрокОплаты  = ОплатаДо;
					
					НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
					НаборЗаписей.Записать();
					
				КонецЕсли;
#КонецОбласти		
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	пСтруктураНастроек.Логирование.НомерСообщения = СтруктураНастроек.Логирование.НомерСообщения; 	// чтобы лог не затерся.
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьСтатусСчета(Счет, Статус)
	
	ПолученныеДанные = РегистрыСведений.СтатусыДокументов.Получить(Новый Структура("Организация, Документ", Счет.Организация, Счет));
	
	НаборЗаписей = РегистрыСведений.СтатусыДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(Счет);
	НаборЗаписей.Отбор.Организация.Установить(Счет.Организация);
	НаборЗаписей.Прочитать();
	
	ЕстьСтатус = Ложь;
	
	Для Каждого ТекСтрока Из НаборЗаписей Цикл
		ЕстьСтатус = Истина;
		ТекСтрока["Статус"] = Статус;	
	КонецЦикла;

	Если ЕстьСтатус = Ложь Тогда
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Документ 			 = Счет;
		НоваяЗапись.Организация 		 = Счет.Организация;
		НоваяЗапись["Статус"] 				 = Статус;
		НоваяЗапись.ДополнительныйСтатус = Перечисления.СтатусыОтгрузки.НеОтгружен;
	КонецЕсли;
	
	НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ЗагрузитьОбновитьСделки(пСтруктураНастроек, мДанных) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Результат = Новый Массив; 
		
	Если ТипКонфигурации = "БП" Тогда
		Возврат Результат;					
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		МодульЗначениеНастроекПовтИсп = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ЗначениеНастроекПовтИсп");
		МодульПакетнаяОбработкаТабличнойЧастиКлиентСервер = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиКлиентСервер");
		МодульВзаиморасчетыСервер = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ВзаиморасчетыСервер");
		
		СтруктураНастроек = Новый Структура;
		Для Каждого ЭлементСтруктуры Из пСтруктураНастроек Цикл
			СтруктураНастроек.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
		КонецЦикла;	
		
		#Область ИдентификаторыСлужебныхСвойств		
		
		ДопИдСвойстваОрганизации 	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоОрганизацияСделки, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСделки); 
		СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваОрганизацииСделки", Б24_К_ОбщегоНазначенияВызовСервера.КонвертацияИмёнКлючей("Сделка", ДопИдСвойстваОрганизации));
		
		Если пСтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда 	
			ДопИдСвойстваПометкиУдаления	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоПометкаУдаленияСделок, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСделки); 
			СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваПометкиУдаленияСделки", Б24_К_ОбщегоНазначенияВызовСервера.КонвертацияИмёнКлючей("Сделка", ДопИдСвойстваПометкиУдаления));
		КонецЕсли;
		
		#КонецОбласти
		
		ПрефиксВнешнихКодовБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПрефиксВнешнихКодовБитрикс24();		
		МенеджерВременныхТаблиц = ПолучитьБазовыйМенеджерТаблицДляДокументов(СтруктураНастроек);
		#Область ФормированиеВременныхТаблицДанных		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;     
		Запрос.УстановитьПараметр("Портал"					, СтруктураНастроек.Портал);
		Запрос.УстановитьПараметр("ТипДанныхСвойств"		, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСделки);
		Запрос.УстановитьПараметр("ТипДанныхЗначенийСвойств", СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваСделки);
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГрафикиОплаты.Ссылка КАК ГрафикОплаты,
		|	ГрафикиОплаты.ФормаОплаты КАК ФормаОплаты
		|ПОМЕСТИТЬ ВТ_ГрафикиОплаты
		|ИЗ
		|	Справочник.ГрафикиОплаты КАК ГрафикиОплаты
		|ГДЕ
		|	ГрафикиОплаты.ПометкаУдаления = ЛОЖЬ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ФормаОплаты
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ИдентификаторыЗначенийСвойств
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
		|ГДЕ
		|	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхЗначенийСвойств
		|	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Идентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор,
		|	ДополнительныеРеквизитыИСведения.Ссылка КАК Объект,
		|	ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение КАК ЭтоДополнительноеСведение,
		|	Б24_К_ИдентификаторыОбъектов.ДополнительныйИдентификатор КАК ДополнительныйИдентификатор,
		|	ДополнительныеРеквизитыИСведения.ТипЗначения КАК ТипЗначения
		|ПОМЕСТИТЬ ВТ_Свойства
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
		|		ПО Б24_К_ИдентификаторыОбъектов.Объект = ДополнительныеРеквизитыИСведения.Ссылка
		|ГДЕ
		|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал	
		|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхСвойств
		|	И Б24_К_ИдентификаторыОбъектов.Идентификатор <> """"";
		Запрос.Выполнить();
		#КонецОбласти	
		
		ЗагружатьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Сделка", "ЗаказКлиента", "ЗагружатьВ1С");
		ОбновлятьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Сделка", "ЗаказКлиента", "ОбновлятьВ1С");
		ОбновлятьТЧВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Сделка", "ЗаказКлиента", "ОбновлятьТЧВ1С") <> Ложь;
		АлгоритмПриЗагрузке 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Сделка", "ЗаказКлиента", "АлгоритмПриЗагрузкеДанныхВ1С");
		РежимЗаписи 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Сделка", "ЗаказКлиента", "РежимЗаписи");		
		ПоляОбъекта1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Сделка", "ЗаказКлиента");
		ОтборыДляЗагрузки 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОтборыДляЗагрузкиДанныхВ1С(СтруктураНастроек.НастройкаПодключения, "Сделка", "ЗаказКлиента");		
		ПоляТЧОбъекта1С 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностейТЧ(СтруктураНастроек.НастройкаПодключения, "Сделка", "ЗаказКлиента");
		
		ЗагруженныеОбъекты = Новый Массив; 
		
		//08.04.26 добавлено на время перехода, удалить через пару месяцев
		ВременнаяПроцедура_ДополнитьНастройкиСделкиСуммами(СтруктураНастроек.НастройкаПодключения);
		
		Для каждого ЭлементМассива Из мДанных Цикл
			
			ДанныеСделки = ЭлементМассива;
			Если ТипЗнч(ДанныеСделки) = Тип("КлючИЗначение") Тогда 
				ДанныеСделки = ДанныеСделки.Значение; 
			КонецЕсли;  
			
			Если ТипЗнч(ДанныеСделки) <> Тип("Соответствие") Тогда 
				Продолжить;
			КонецЕсли;  
			
			ШапкаСделки 	= ДанныеСделки.Получить("item");
			ТЧСделки 		= ДанныеСделки.Получить("productrow");			
			РеквизитыСделки = ДанныеСделки.Получить("requisite");
			ВладелецЗаказов = ДанныеСделки.Получить("orderEntity");
			ДанныеЗаказа 	= ДанныеСделки.Получить("order");			
			ЕстьКритическиеОшибки 					= Ложь;
			ПринудительноРегистрироватьДокумент 	= Ложь;			
			ИдБитрикс24		= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСделки.Получить("id"),"ЧГ=0"));
			ИдЗаказа 		= Формат(ПолучитьЗначениеИзМассиваСоответствий(ВладелецЗаказов, "ownerId", ИдБитрикс24, "orderId"),"ЧГ=0");			
			КорзинаЗаказа	= ДанныеЗаказа.Получить("basketItems");			
			ТемаСделки     	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ШапкаСделки.Получить("title"));			
			ДатаНачала     	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата"),   ШапкаСделки.Получить("createdTime"));
			ИдКомпании    	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСделки.Получить("companyId"),"ЧГ=0"));
			ИдКонтакта     	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСделки.Получить("contactId"),"ЧГ=0"));
			КодВалюты 	   	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьКодПоВалюте(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ШапкаСделки.Получить("currencyId"),"ЧГ=0")));
			
			Если РеквизитыСделки <> Неопределено Тогда
				ИдРеквизита = Формат(РеквизитыСделки.Получить("REQUISITE_ID"),"ЧГ=0");  
			Иначе
				ИдРеквизита = "";
			КонецЕсли;
			
			ИдСтатуса      	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"),   Формат(ШапкаСделки.Получить("stageId"),"ЧГ=0"));
			ИдНаправления  	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"),   Формат(ШапкаСделки.Получить("categoryId"),"ЧГ=0"));
			ИдНаправления	= ?(ИдНаправления = "0", "", ИдНаправления);
			Закрыт         	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ШапкаСделки.Получить("closed")) = "Y";
			
			Если ЗагружатьВ1С = Ложь Тогда
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
				Продолжить;	
			КонецЕсли;	
			
			Если ЗагруженныеОбъекты.Найти(ИдБитрикс24) <> Неопределено Тогда
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
				Продолжить;	
			КонецЕсли;
			ЗагруженныеОбъекты.Добавить(ИдБитрикс24);
			
			НужноЗагружать = ПроверитьОбъект1СНаОтборыЗагрузки(СтруктураНастроек, ШапкаСделки, ОтборыДляЗагрузки, "Сделка");
			Если НЕ НужноЗагружать Тогда
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
				Продолжить;	
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ ДатаНачала < СтруктураНастроек.НастройкиСинхронизацииСделок.ДатаНачалаЗагрузкиСделок Тогда
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Сделка с ид:  " + Строка(ИдБитрикс24) + " будет пропущена т.к. дата сделки меньше даты, с которой сделки загружаются в 1С.");
				Продолжить;  			
			КонецЕсли;		
			
			Если СтруктураНастроек.НастройкиСинхронизацииСделок.Свойство("ИнформацияОСтатусах") Тогда	
				ИнформацияОСтатусах = СтруктураНастроек.НастройкиСинхронизацииСделок.ИнформацияОСтатусах;
				Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СостоянияЗаказов" Тогда
					тзнСтатусов = ИнформацияОСтатусах.СтатусыНаправленийСостояний;	
				ИначеЕсли ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоЗаказов" Тогда
					тзнСтатусов = ИнформацияОСтатусах.СтатусыНаправленийЗначенийСвойств;
				ИначеЕсли ИнформацияОСтатусах.ИсточникСтатусов1С = "СтатусыЗаказов" Тогда
					тзнСтатусов = ИнформацияОСтатусах.СтатусыНаправленийСтатусов;
				КонецЕсли;
			Иначе
				ИнформацияОСтатусах = Неопределено;
			КонецЕсли;
			
			Если ИнформацияОСтатусах <> Неопределено Тогда
				
				ПропускаемСделкуИзЗаСтатуса = Ложь;
				
				НайденныеСтроки = тзнСтатусов.НайтиСтроки(Новый Структура("ИдСтатуса, ИдНаправления", ИдСтатуса, ИдНаправления));
				Если НайденныеСтроки.Количество() >0 Тогда
					ПропускаемСделкуИзЗаСтатуса = НайденныеСтроки[0].НеЗагружать;	
				КонецЕсли;				
				
				Если ПропускаемСделкуИзЗаСтатуса Тогда			
					Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Сделка с ид:  " + Строка(ИдБитрикс24) + " будет пропущена т.к. не стоит, что с таким статусом документ не загружается в 1С.");
					Продолжить;  			
				КонецЕсли;					
			КонецЕсли;
			
			
			Организация = Справочники.Организации.ПустаяСсылка();
			#Область ПоискОрганизации
			ИдОрганизации  = Формат(ШапкаСделки.Получить(СтруктураНастроек.ДопИдПредопределенногоСвойстваОрганизацииСделки),"ЧГ=0");
			Если ЗначениеЗаполнено(ИдОрганизации) Тогда
				ЗнСвОрг = ПолучитьОбъектПоИдентификаторуИзВременнойТаблицы(МенеджерВременныхТаблиц, "ВТ_ИдентификаторыЗначенийСвойств", ИдОрганизации);
				Если ЗначениеЗаполнено(ЗнСвОрг) Тогда
					Организация = Справочники.Организации.НайтиПоНаименованию(ЗнСвОрг.Наименование);	
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Организация) И ТипЗнч(Организация) <> Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Организации") Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Найденная организация с ид: " + ИдОрганизации + " не является элемеметом справочника 'Организации'");
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Скорее всего это контрагент. Необходимо удалить привязку ид к этому контрагенту");
				Организация = Справочники.Организации.ПустаяСсылка();
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Организация) Тогда
				Организация  = СтруктураНастроек.НастройкиСинхронизацииСделок.Организация;
			КонецЕсли;
			#КонецОбласти	
			
			ИнформацияОКлиенте 		= ПолучитьИнформациюОКомпанииКонтакте(СтруктураНастроек, МенеджерВременныхТаблиц, ИдКомпании, ИдКонтакта, ИдРеквизита);
			Партнер					= ИнформацияОКлиенте["Партнер"];
			Контрагент				= ИнформацияОКлиенте["Контрагент"];
			КонтактноеЛицо			= ИнформацияОКлиенте.КонтактноеЛицо;
			ЕстьКритическиеОшибки 	= ИнформацияОКлиенте.ЕстьКритическиеОшибки; 
			
			Валюта = Справочники.Валюты.НайтиПоКоду(КодВалюты);
			Если НЕ ЗначениеЗаполнено(Валюта) Тогда
				Валюта = Справочники.Валюты.НайтиПоКоду("643");
			КонецЕсли;
			
			Склад = Справочники.Склады.ПустаяСсылка();		
			#Область ПоискСклада
			Если ТипЗнч(КорзинаЗаказа) = Тип("Массив") Тогда 
				Для каждого ТекПозиция Из КорзинаЗаказа Цикл
					
					Резерв	= ТекПозиция.Получить("reservations");       
					Если ТипЗнч(Резерв) = Тип("Массив") Тогда
						Для каждого ТекРезерв Из Резерв Цикл  
							ИдСкладаБ24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекРезерв.Получить("storeId"),"ЧГ=0"));  
							НайденныеДанные = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьЗначениеПоИдБ24Объекта(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Склад, ИдСкладаБ24); 
							Если НайденныеДанные <> Неопределено Тогда
								Склад = НайденныеДанные.Объект;   
								Прервать;
							КонецЕсли;
						КонецЦикла; 
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			#КонецОбласти	
			
			ПомеченНаУдаление = Ложь;
			#Область ПоискПометкиНаУдаление
			Если пСтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда 	
				ЗначениеПометки  = Формат(ШапкаСделки.Получить(СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияСделки), "ЧГ=0");
				Если ЗначениеПометки = "1" Тогда
					ПомеченНаУдаление = Истина;
				КонецЕсли;
			КонецЕсли;
			#КонецОбласти			
			
			ЭтоНоваяСделка 	= Ложь;
			#Область ПоискСозданиеСделки	
			ВнешнийКод    	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ШапкаСделки.Получить("originId"));
			
			Сделка = СсылкаПоИдБ24(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Сделка, ПрефиксВнешнихКодовБитрикс24.Сделки + ИдБитрикс24);
			Если ЗначениеЗаполнено(ВнешнийКод) И НЕ ЗначениеЗаполнено(Сделка) Тогда
				Сделка = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказКлиента"), ВнешнийКод);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Сделка) Тогда 
				
				Если ОбновлятьВ1С Тогда  
					
					ЭтоЗаказСУ = РегистрыСведений.Б24_СУ_СозданныеДокументы.ПроверитьНаличиеЗаписиВРегистре(СтруктураНастроек.НастройкаПодключения, Сделка);
					Если ЭтоЗаказСУ Тогда
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Заказ с ид:  " + Строка(ИдБитрикс24) + " будет пропущен т.к.  загружен подсистемой СУ.");
						Продолжить;  			
					КонецЕсли;					
					
					Сделка = Сделка.ПолучитьОбъект();    
					
				Иначе      
					
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "В настройках указано, что сделки не обновляются. Сделка: " + Строка(Сделка) + " не будет обновлена.");
					
					Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
					
					Продолжить;  
					
				КонецЕсли;
				
			ИначеЕсли ПомеченНаУдаление Тогда
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Сделка с ИД " + Строка(ИдБитрикс24) + " помечена на удаление в Битрикс24. Не будет создана в 1С");
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
				Продолжить;		
				
			Иначе 
				// Защита от создания дублей заказов при параллельной работе обменов
				// (Коннектор и БУС). Повторно ищем сделку — её мог уже создать другой обмен.
				Сделка = СсылкаПоИдБ24(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Сделка, ПрефиксВнешнихКодовБитрикс24.Сделки + ИдБитрикс24);
				Если ЗначениеЗаполнено(Сделка) Тогда
					Сделка = Сделка.ПолучитьОбъект();
				Иначе
					Сделка = Документы["ЗаказКлиента"].СоздатьДокумент();
					ЭтоНоваяСделка = Истина;
				КонецЕсли;
			КонецЕсли;
			#КонецОбласти	
			
			Если ЭтоНоваяСделка И СтруктураНастроек.НастройкиСинхронизацииСделок.ИсточникНомераДокумента <> "По данным с Битрикс24" Тогда
				ПринудительноРегистрироватьДокумент = Истина;
			КонецЕсли;                                                                
			
			
			ДанныеДоставки = Новый Структура; 
			ДанныеДоставки.Вставить("Номенклатура"		, Неопределено);
			ДанныеДоставки.Вставить("ИдДоставки"		, "");
			ДанныеДоставки.Вставить("СтоимостьДоставки"	, 0);
			ДанныеДоставки.Вставить("СтавкаНДСДоставки"	, Справочники["СтавкиНДС"].ПустаяСсылка());
			ДанныеДоставки.Вставить("СуммаНДСДоставки"	, 0);
			ДанныеДоставки.Вставить("Стоимость"			, 0);
			ДанныеДоставки.Вставить("СтавкаНДС"			, Справочники["СтавкиНДС"].ПустаяСсылка());     
			ДанныеДоставки.Вставить("ЕдиницаИзмерения"	, Справочники["УпаковкиЕдиницыИзмерения"].ПустаяСсылка());     
			
			#Область ЗаполнениеДоставки       
			СтруктураНастроек.НастройкиСинхронизацииСделок.Свойство("НоменклатураДоставка", ДанныеДоставки.Номенклатура);  
			Если ЗначениеЗаполнено(ДанныеДоставки.Номенклатура) Тогда  
				
				Если СтруктураНастроек.ВерсияТоваров = "v.2" Тогда 
					ДанныеДоставки.ИдДоставки = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Предложение, ДанныеДоставки.Номенклатура, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка()); 
					Если НЕ ЗначениеЗаполнено(ДанныеДоставки.ИдДоставки) Тогда
						ДанныеДоставки.ИдДоставки = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Товар2, ДанныеДоставки.Номенклатура, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка()); 
					КонецЕсли;
				Иначе   
					ДанныеДоставки.ИдДоставки = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Товар, ДанныеДоставки.Номенклатура, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка()); 
				КонецЕсли;
				
				ДоставкаЧерезПозицииСделок = Истина;
				Если СтруктураНастроек.НастройкиСинхронизацииСделок.Свойство("ИсточникДоставок") Тогда
					ДоставкаЧерезПозицииСделок = СтруктураНастроек.НастройкиСинхронизацииСделок.ИсточникДоставок = "Позиции сделок";
				КонецЕсли;
				
				НалогВключен = Истина;
				
				РеквизитыДоставки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДоставки.Номенклатура, "СтавкаНДС, ЕдиницаИзмерения");
				ДанныеДоставки.СтавкаНДСДоставки = РеквизитыДоставки.СтавкаНДС;
				ДанныеДоставки.ЕдиницаИзмерения = РеквизитыДоставки.ЕдиницаИзмерения;
				
				Если ДоставкаЧерезПозицииСделок Тогда			    
					
					//НалогообложениеНДС = НалогиУНФ.НалогообложениеНДС(Организация,, ДатаНачала);
					//ОблагаетсяНДС = НалогообложениеНДС = Перечисления["ТипыНалогообложенияНДС"].ОблагаетсяНДС;
					
					НалогообложениеНДС = МодульЗначениеНастроекПовтИсп.НалогообложениеНДС(Организация, Склад, Сделка.Договор, Сделка.НаправлениеДеятельности, Сделка.Дата);			
					НалогообложениеНДС = ?(ЗначениеЗаполнено(НалогообложениеНДС), НалогообложениеНДС,  Перечисления["ТипыНалогообложенияНДС"].ПродажаОблагаетсяНДС);
					ОблагаетсяНДС = ?(ЗначениеЗаполнено(Сделка.НалогообложениеНДС), Сделка.НалогообложениеНДС, НалогообложениеНДС)= Перечисления["ТипыНалогообложенияНДС"].ПродажаОблагаетсяНДС;
					
					Для Каждого ТоварСделки Из ТЧСделки Цикл
						
						Если ТипЗнч(ТоварСделки) <> Тип("Соответствие") Тогда Продолжить КонецЕсли;    
						
						Если Формат(ТоварСделки.Получить("ownerId"),"ЧГ=0") = ИдБитрикс24 Тогда
							
							ИдТовара = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварСделки.Получить("productId"),"ЧГ=0"));
							Если ДанныеДоставки.ИдДоставки = ИдТовара Тогда
								
								НалогВключен			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Строка(ТоварСделки.Получить("taxIncluded")))= "Y";
								СуммыПозицииПортала 	= Б24_К_RestApiВызовСервера.ПолучитьСуммыПозицииПортала(ТоварСделки, ОблагаетсяНДС, НалогВключен); 			
								
								ДанныеДоставки.СтоимостьДоставки	= ДанныеДоставки.СтоимостьДоставки + СуммыПозицииПортала.Цена - СуммыПозицииПортала.СуммаСкидкиНаценки;
								ДанныеДоставки.СтавкаНДСДоставки 	= СуммыПозицииПортала.СтавкаНДС;
								ДанныеДоставки.СуммаНДСДоставки		= ДанныеДоставки.СуммаНДСДоставки + СуммыПозицииПортала.СуммаНДС;  
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;   
					
				Иначе
					
					Стоимость = 0;
					Отгрузки = ДанныеЗаказа.Получить("shipments");
					Если ТипЗнч(Отгрузки) = Тип("Массив") Тогда 
						Для каждого ТекОтгрузка Из Отгрузки Цикл   
							
							Если ТекОтгрузка.Получить("canceled") = "Y" Тогда
								Продолжить;
							КонецЕсли;
							
							ДанныеДоставки.СтоимостьДоставки = Стоимость + Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"), Формат(ТекОтгрузка.Получить("priceDelivery"),"ЧРД=.; ЧГ=0"));
							
						КонецЦикла;
					КонецЕсли;  
					
				КонецЕсли;
				
			КонецЕсли;  
			#КонецОбласти		
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ПоляОбъекта1С"			, ПоляОбъекта1С);
			ДополнительныеПараметры.Вставить("ИдЭлементаБ24"			, ИдБитрикс24);
			ДополнительныеПараметры.Вставить("Объект1С"					, Сделка);
			ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
			ДополнительныеПараметры.Вставить("ДанныеЭлементаБ24"		, ШапкаСделки);
			ДополнительныеПараметры.Вставить("ПомеченНаУдаление"		, ПомеченНаУдаление);
			ДополнительныеПараметры.Вставить("ЭтоНовыйОбъект"			, ЭтоНоваяСделка);
			ДополнительныеПараметры.Вставить("ТаблицаСвойств"			, РазобратьПользовательскиеПоляВТаблицу(СтруктураНастроек, ШапкаСделки, МенеджерВременныхТаблиц, "Сделка"));
			ДополнительныеПараметры.Вставить("Валюта"					, Валюта);
			ДополнительныеПараметры.Вставить("Организация"				, Организация);
			ДополнительныеПараметры.Вставить("Соглашение"				, СтруктураНастроек.НастройкиСинхронизацииСделок.Соглашение);
			ДополнительныеПараметры.Вставить("Партнер"					, Партнер);
			ДополнительныеПараметры.Вставить("Контрагент"				, Контрагент);
			ДополнительныеПараметры.Вставить("КонтактноеЛицо"			, КонтактноеЛицо);                 
			ДополнительныеПараметры.Вставить("Склад"					, Склад);
			ДополнительныеПараметры.Вставить("ИнформацияОРеквизитах"	, РеквизитыСделки);
			ДополнительныеПараметры.Вставить("Товары"					, ТЧСделки);
			ДополнительныеПараметры.Вставить("ТаблицаСтатусов"			, тзнСтатусов);
			
			ЗаполнитьРеквизитыОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);
			
			Если ДополнительныеПараметры.НеЗагружать = Истина Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден ответственный у сделки с  ид: " + ИдБитрикс24 + ". Будет пропущен.");
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Ложь)));
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьДополнительныеРеквизитыОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);
			
			#Область ДобавлениеДополнительныхРеквизитовДокумента	
			НайденноеСвойствоТЧ = Сделка.ДополнительныеРеквизиты.Найти(СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНазваниеТемыСделки, "Свойство");
			Если НайденноеСвойствоТЧ = Неопределено Тогда
				НовыйРеквизит = Сделка.ДополнительныеРеквизиты.Добавить();
				НовыйРеквизит.Значение = ТемаСделки;
				НовыйРеквизит.Свойство = СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНазваниеТемыСделки;
			Иначе
				НайденноеСвойствоТЧ.Значение = ТемаСделки;	
			КонецЕсли;
			
			НайденноеСвойствоТЧ = Сделка.ДополнительныеРеквизиты.Найти(СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомерСделкиБитрикс24, "Свойство");
			Если НайденноеСвойствоТЧ = Неопределено Тогда
				НовыйРеквизит = Сделка.ДополнительныеРеквизиты.Добавить();
				НовыйРеквизит.Значение = ИдБитрикс24;
				НовыйРеквизит.Свойство = СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомерСделкиБитрикс24;
			Иначе
				НайденноеСвойствоТЧ.Значение = ИдБитрикс24;	
			КонецЕсли;
			
			НайденноеСвойствоТЧ = Сделка.ДополнительныеРеквизиты.Найти(СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДатаСделкиБитрикс24, "Свойство");
			Если НайденноеСвойствоТЧ = Неопределено Тогда
				НовыйРеквизит = Сделка.ДополнительныеРеквизиты.Добавить();
				НовыйРеквизит.Значение = ДатаНачала;
				НовыйРеквизит.Свойство = СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДатаСделкиБитрикс24;
			Иначе
				НайденноеСвойствоТЧ.Значение = ДатаНачала;	
			КонецЕсли;
			
			ЕстьНаправление= НЕ (ИдНаправления = "" ИЛИ ИдНаправления = "0");
			ИдНаправления  = ?(ЕстьНаправление, ИдНаправления, "");		
			// Исправлено: если воронка (направление сделки) удалена в Битрикс24 либо её
			// нет в списке направлений настроек сопоставления статусов, не подставляем
			// название удалённой воронки из регистра идентификаторов, а используем "Общее".
			Если ЕстьНаправление И ИнформацияОСтатусах <> Неопределено Тогда
				Если ИнформацияОСтатусах.Свойство("НаправленияСделок") Тогда
					НаправленияСделокНастроек = ИнформацияОСтатусах.НаправленияСделок;
					Если ТипЗнч(НаправленияСделокНастроек) = Тип("ТаблицаЗначений")
						И НаправленияСделокНастроек.НайтиСтроки(Новый Структура("ИдНаправления", ИдНаправления)).Количество() = 0 Тогда
						ЕстьНаправление = Ложь;
						ИдНаправления  = "";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			НаправлениеСделки = ПолучитьОбъектПоИдентификаторуИзВременнойТаблицы(МенеджерВременныхТаблиц, "ВТ_ИдентификаторыЗначенийСвойств", ?(ЕстьНаправление, "NS_" + ИдНаправления, "NS_"));
			
			НайденноеСвойствоТЧ = Сделка.ДополнительныеРеквизиты.Найти(СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНаправлениеСделки, "Свойство");
			Если НайденноеСвойствоТЧ = Неопределено Тогда
				НовыйРеквизит = Сделка.ДополнительныеРеквизиты.Добавить();
				НовыйРеквизит.Значение = НаправлениеСделки;
				НовыйРеквизит.Свойство = СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНаправлениеСделки;
			Иначе
				НайденноеСвойствоТЧ.Значение = НаправлениеСделки;	
			КонецЕсли;
			#КонецОбласти		
			
			#Область ДобавлениеДополнительногоРеквизитаСтатуса
			Если ИнформацияОСтатусах <>Неопределено Тогда
				
				Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоЗаказов" Тогда
					
					ЗначениеСвойства = Неопределено;
					
					НайденныеСтроки = тзнСтатусов.НайтиСтроки(Новый Структура("ИдСтатуса, ИдНаправления", ИдСтатуса, ИдНаправления));
					Если НайденныеСтроки.Количество() >0 Тогда
						НайденнаяСтрока = НайденныеСтроки[0];	
					Иначе
						НайденнаяСтрока = Неопределено;	
					КонецЕсли;
					
					Если НайденнаяСтрока <> Неопределено Тогда
						ЗначениеСвойства = НайденнаяСтрока["Статус"];	
					КонецЕсли;
					
					НайденноеСвойствоТЧ = Сделка.ДополнительныеРеквизиты.Найти(ИнформацияОСтатусах.СвойствоЗаказов, "Свойство");
					Если НайденноеСвойствоТЧ = Неопределено Тогда
						НовыйРеквизит = Сделка.ДополнительныеРеквизиты.Добавить();
						НовыйРеквизит.Значение = ЗначениеСвойства;
						НовыйРеквизит.Свойство = ИнформацияОСтатусах.СвойствоЗаказов;
					Иначе
						НайденноеСвойствоТЧ.Значение = ЗначениеСвойства;	
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			#КонецОбласти	
			
			
			#Область ЗаполнениеТоваров	         
			
			Если ОбновлятьТЧВ1С Тогда
				
				тзнТоваровАрх = Сделка.Товары.Выгрузить();
				
				Сделка.Товары.Очистить();	
				
				// Костыль для искл дублей
				тзнПроверкаДублейСтрок = Новый ТаблицаЗначений;
				тзнПроверкаДублейСтрок.Колонки.Добавить("ИдТовара");
				тзнПроверкаДублейСтрок.Колонки.Добавить("ИдЕдИзм");
				тзнПроверкаДублейСтрок.Колонки.Добавить("Скидка");
				тзнПроверкаДублейСтрок.Колонки.Добавить("Количество");
				тзнПроверкаДублейСтрок.Колонки.Добавить("Цена");
				
				НалогообложениеНДС = МодульЗначениеНастроекПовтИсп.НалогообложениеНДС(Организация, Склад, Сделка.Договор, Сделка.НаправлениеДеятельности, Сделка.Дата);			
				НалогообложениеНДС = ?(ЗначениеЗаполнено(НалогообложениеНДС), НалогообложениеНДС,  Перечисления["ТипыНалогообложенияНДС"].ПродажаОблагаетсяНДС);
				ОблагаетсяНДС = ?(ЗначениеЗаполнено(Сделка.НалогообложениеНДС), Сделка.НалогообложениеНДС, НалогообложениеНДС) = Перечисления["ТипыНалогообложенияНДС"].ПродажаОблагаетсяНДС;
				
				Для Каждого ТоварСделки Из ТЧСделки Цикл
					
					Если ТипЗнч(ТоварСделки) <> Тип("Соответствие") Тогда Продолжить КонецЕсли;    
					
					Если Формат(ТоварСделки.Получить("ownerId"),"ЧГ=0") = ИдБитрикс24 Тогда
						
					ИдПозицииДокумента	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварСделки.Получить("id"),"ЧГ=0")); 
					Если НЕ ЗначениеЗаполнено(ИдПозицииДокумента) Тогда
						ИдПозицииДокумента	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Строка(ТоварСделки.Получить("xmlId")));
					КонецЕсли;
					ИдТовара			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварСделки.Получить("productId"),"ЧГ=0"));
						НаименованиеТовара	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Строка(ТоварСделки.Получить("productName")));
						
						Если ИдТовара = ДанныеДоставки.ИдДоставки Тогда
							Продолжить;
						КонецЕсли;				
						
						КодЕдИзм				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварСделки.Получить("measureCode"),"ЧГ=0"));
						НалогВключен			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Строка(ТоварСделки.Получить("taxIncluded")))= "Y";
						СуммыПозицииПортала 	= Б24_К_RestApiВызовСервера.ПолучитьСуммыПозицииПортала(ТоварСделки, ОблагаетсяНДС, НалогВключен);
						
						Количество				= СуммыПозицииПортала.Количество;
						ЦенаСоСкидкойСНалогом	= СуммыПозицииПортала.Цена;
						Скидка					= СуммыПозицииПортала.СуммаСкидкиНаценки;
						#Область ИсключениеВозможныхДублей	
						// бывает глюк, когда с б24 приходят дубли строк
						СтруктураОтбора = Новый Структура;
						СтруктураОтбора.Вставить("ИдТовара"		, ИдТовара);
						СтруктураОтбора.Вставить("ИдЕдИзм"		, КодЕдИзм);
						СтруктураОтбора.Вставить("Скидка"		, Скидка);
						СтруктураОтбора.Вставить("Количество"	, Количество);
						СтруктураОтбора.Вставить("Цена"			, ЦенаСоСкидкойСНалогом);
						
						НайденныеСтрокиПроверкиДублей = тзнПроверкаДублейСтрок.НайтиСтроки(СтруктураОтбора);
						
						Если НайденныеСтрокиПроверкиДублей.Количество() > 0 Тогда
							Продолжить;
						Иначе
							ИнфОНовойСтрокеТовара = тзнПроверкаДублейСтрок.Добавить();
							ИнфОНовойСтрокеТовара.ИдТовара 	= ИдТовара; 
							ИнфОНовойСтрокеТовара.ИдЕдИзм 	= КодЕдИзм; 
							ИнфОНовойСтрокеТовара.Скидка 	= Скидка; 
							ИнфОНовойСтрокеТовара.Количество= Количество; 
							ИнфОНовойСтрокеТовара.Цена 		= ЦенаСоСкидкойСНалогом; 
						КонецЕсли;
						#КонецОбласти	
						
						Номенклатура	= Справочники.Номенклатура.ПустаяСсылка();	
						Характеристика  = Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка();
						#Область ПоискТовара	
						Если ЗначениеЗаполнено(ИдТовара) Тогда
							
							ИнформацияОНоменклатуре = Неопределено;	
							
							Запрос = Новый Запрос;
							Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
							Запрос.УстановитьПараметр("Идентификатор", ИдТовара);
							
							Запрос.Текст = "ВЫБРАТЬ
							|	ВТ_Идентификаторы.Объект КАК Объект,
							|	ВТ_Идентификаторы.ПодчиненныйОбъект КАК ПодчиненныйОбъект
							|ИЗ
							|	ВТ_ИдентификаторыТоваров КАК ВТ_Идентификаторы
							|ГДЕ
							|	ВТ_Идентификаторы.Идентификатор = &Идентификатор";
							
							ВыполненныйЗапрос = Запрос.Выполнить();
							
							Если НЕ ВыполненныйЗапрос.Пустой() Тогда
								Выборка = ВыполненныйЗапрос.Выбрать();
								Пока Выборка.Следующий() Цикл
									ИнформацияОНоменклатуре = Выборка;
									Прервать;
								КонецЦикла;
							КонецЕсли;
							
							Если ИнформацияОНоменклатуре = Неопределено Тогда
								
								Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Не найден товар по ид. Попытка создания товара с Ид: " + ИдТовара);
								ИнформацияОНоменклатуре = СформироватьНоменклатуруХарактеристикуПоИд(СтруктураНастроек, ИдТовара);
								
								Если ИнформацияОНоменклатуре = Неопределено Тогда
									Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не найдена информация о номенклатуре с Ид: " + ИдТовара);
									ЕстьКритическиеОшибки = Истина;
								Иначе
									Номенклатура   = ИнформацияОНоменклатуре.Объект;	
									Характеристика = ИнформацияОНоменклатуре.ПодчиненныйОбъект;	
								КонецЕсли;
								
							Иначе
								Номенклатура   = ИнформацияОНоменклатуре.Объект;	
								Характеристика = ИнформацияОНоменклатуре.ПодчиненныйОбъект;	
							КонецЕсли; 
						Иначе
							Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "В сделке был указан не товар, а строка. Товар: " + НаименованиеТовара + " в сделку: " + Строка(Сделка) + " не будет указан.");
						КонецЕсли; 			
						#КонецОбласти	
						Номенклатура = ?(ЗначениеЗаполнено(Номенклатура), Номенклатура, Справочники.Номенклатура.ПустаяСсылка());
						
						НоваяСтрока = Сделка.Товары.Добавить();
						
						НайденныеСтроки = тзнТоваровАрх.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика));
						Если НайденныеСтроки.Количество() > 0 Тогда
							ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);  
						КонецЕсли;
						
						НоваяСтрока.Б24_К_ИдентификаторПозиции = ИдПозицииДокумента;
						
						ДополнительныеПараметрыТЧ = Новый Структура;
						ДополнительныеПараметрыТЧ.Вставить("ПоляТЧОбъекта1С"			, ПоляТЧОбъекта1С);
						ДополнительныеПараметрыТЧ.Вставить("МетаданныеТЧ"				, Метаданные.Документы["ЗаказКлиента"].ТабличныеЧасти.Товары);
						ДополнительныеПараметрыТЧ.Вставить("Объект1С"					, Сделка);
						ДополнительныеПараметрыТЧ.Вставить("СтрокаТЧ"					, НоваяСтрока);
						ДополнительныеПараметрыТЧ.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);     
						ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаБ24"			, ШапкаСделки);  
						ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаТЧБ24"		, ТоварСделки);
						ДополнительныеПараметрыТЧ.Вставить("ПомеченНаУдаление"			, ПомеченНаУдаление);
						ДополнительныеПараметрыТЧ.Вставить("ЭтоНовыйОбъект"				, ЭтоНоваяСделка);
						ДополнительныеПараметрыТЧ.Вставить("Номенклатура"				, Номенклатура);
						ДополнительныеПараметрыТЧ.Вставить("Характеристика"				, Характеристика);
						ДополнительныеПараметрыТЧ.Вставить("ТоварыАрх"					, тзнТоваровАрх);
						ДополнительныеПараметрыТЧ.Вставить("КорзинаЗаказа"				, КорзинаЗаказа);
						
						ЗаполнитьРеквизитыТЧОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметрыТЧ, "Товары");
						
						Если НайденныеСтроки.Количество() > 0 Тогда
							тзнТоваровАрх.Удалить(НайденныеСтроки[0]);
						КонецЕсли;
						
						СтруктураДействий = Новый Структура;					
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;       
			
			Если ДанныеДоставки.СтоимостьДоставки > 0 Тогда
				
				НоваяСтрока = Сделка.Товары.Добавить();
				
				НайденныеСтроки = тзнТоваровАрх.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", ДанныеДоставки.Номенклатура, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка()));
				Если НайденныеСтроки.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);  
				КонецЕсли;
				
				НоваяСтрока.Б24_К_ИдентификаторПозиции = 9999;    
				
				НоваяСтрока.Номенклатура 	= ДанныеДоставки.Номенклатура;
				НоваяСтрока.Характеристика 	= Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка();
				
				НоваяСтрока.ВариантОбеспечения 	= Перечисления["ВариантыОбеспечения"].Отгрузить;
				
				НоваяСтрока.Упаковка		= ДанныеДоставки.ЕдиницаИзмерения;
				НоваяСтрока.СтавкаНДС  		= ДанныеДоставки.СтавкаНДСДоставки;
				
				
				НоваяСтрока.Количество  		= 1;
				НоваяСтрока.КоличествоУпаковок  = 1;
				
				НоваяСтрока.Цена				= ДанныеДоставки.СтоимостьДоставки;
				
				НоваяСтрока.ПроцентАвтоматическойСкидки = 0;
				НоваяСтрока.СуммаАвтоматическойСкидки	= 0;
				
				НоваяСтрока.ПроцентРучнойСкидки = 0;
				НоваяСтрока.ПроцентРучнойСкидки = 0;
				
				СтруктураДействий = Новый Структура;
				
				СтруктураПересчетаСуммы = МодульПакетнаяОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Сделка);
				СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
				СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
				СтруктураДействий.Вставить("ПересчитатьСумму");
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
				
				МодульОбработкиТЧВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиВызовСервера");
				МодульОбработкиТЧВызовСервера.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					тзнТоваровАрх.Удалить(НайденныеСтроки[0]);
				КонецЕсли;
				
			КонецЕсли;
			
			#КонецОбласти		
			
			#Область ПолучениеИнформацииОСостоянииЗаказаДоПроведения
			ИнформацияОСостоянииЗаказа = Новый Структура;
			Если ЗначениеЗаполнено(Сделка.Ссылка) Тогда
				Если ИнформацияОСтатусах <> Неопределено Тогда			
					Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СостоянияЗаказов" Тогда
						
						Запрос = Новый Запрос;
						Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
						Запрос.УстановитьПараметр("Заказ", Сделка.Ссылка);
						Запрос.Текст = "ВЫБРАТЬ *
						|ИЗ
						|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
						|ГДЕ
						|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
						
						тзнСЗ = Запрос.Выполнить().Выгрузить();;
						Если тзнСЗ.Количество()> 0 Тогда
							ИнформацияОСостоянииЗаказа = тзнСЗ[0];	
						КонецЕсли;
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			#КонецОбласти	
			
			#Область ЗаполнениеГрафикаОплаты
			Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ФункциональнаяОпцияВключена("ИспользоватьГрафикиОплаты") Тогда
				
				Сделка.ЭтапыГрафикаОплаты.Очистить();
				МодульВзаиморасчетыСервер.ПроверитьЗаполнитьЭтапыГрафикаОплаты(Сделка);
				
			КонецЕсли;
			#КонецОбласти	
			
			Если ЗначениеЗаполнено(АлгоритмПриЗагрузке) Тогда
				
				ОтказНаЗапись = ВыполнитьАлгоритмПередЗагрузкой(СтруктураНастроек, Сделка, ШапкаСделки, АлгоритмПриЗагрузке); 
				Если ОтказНаЗапись Тогда
					Продолжить;	
				КонецЕсли; 
				
			КонецЕсли;
			
			Если ЭтоНоваяСделка Тогда   // Для выгрузки дела при создании в 1С
				
				Сделка.УстановитьСсылкуНового(Документы["ЗаказКлиента"].ПолучитьСсылку());      
				
				Если СтруктураНастроек.КонфигурируемыеДела Тогда
					РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.КонфигурируемоеДелоСделки, Сделка.ПолучитьСсылкуНового(), "", ИдБитрикс24);
				Иначе
					РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.ДелоСделки, Сделка.ПолучитьСсылкуНового(), "", ИдБитрикс24);
				КонецЕсли;
				
			КонецЕсли;		
			
			Если ЭтоНоваяСделка И НЕ ЗначениеЗаполнено(Сделка.Номер) Тогда   // Для выгрузки дела при создании в 1С
				
				Если СтруктураНастроек.НастройкиСинхронизацииСделок.ИсточникНомераДокумента = "По данным с Битрикс24" Тогда
					Сделка.Номер = ИдБитрикс24;
				Иначе
					Сделка.УстановитьНовыйНомер();
				КонецЕсли;					
				
			КонецЕсли;		
			
			#Область ПроведениеДокумента
			ОтменаЗаписиСОшибкой = Ложь;
			Сделка.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
			Если (РежимЗаписи = "Проводить закрытые" И Закрыт)
				ИЛИ РежимЗаписи = "Проводить" Тогда
				
				Попытка
					Сделка.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Проведен документ: " + Строка(Сделка), Сделка.Ссылка);
				Исключение
					
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время проведения документа: " + Строка(Сделка) + " возникли ошибки.", Сделка.Ссылка);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
					ЕстьКритическиеОшибки = Истина;
					
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Попытка записи документа: " + Строка(Сделка), Сделка.Ссылка);
					
					Попытка
						Сделка.Записать(РежимЗаписиДокумента.Запись);
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан документ: " + Строка(Сделка), Сделка.Ссылка);
					Исключение
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Сделка) + " возникли ошибки.", Сделка.Ссылка);
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						
						СтруктураНастроек.ВыполненоБезОшибок = Ложь;
						
					КонецПопытки;
					
				КонецПопытки;
				
			Иначе
				Попытка
					Если ЭтоНоваяСделка Тогда
						Сделка.Записать(РежимЗаписиДокумента.Запись); 
					ИначеЕсли Сделка.Проведен Тогда
						Сделка.Записать(РежимЗаписиДокумента.Проведение); 
					Иначе
						Сделка.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
					КонецЕсли;
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан: " + Строка(Сделка), Сделка.Ссылка);
				Исключение
					
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Сделка) + " возникли ошибки.", Сделка.Ссылка);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
					ОтменаЗаписиСОшибкой = Истина;
					ЕстьКритическиеОшибки = Истина;
					
					СтруктураНастроек.ВыполненоБезОшибок = Ложь;
					
				КонецПопытки;
			КонецЕсли;
			
			
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, НЕ ЕстьКритическиеОшибки)));
			#КонецОбласти	
			
			Если ЗначениеЗаполнено(Сделка.Ссылка) Тогда
				
				РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.Сделка, Сделка.Ссылка, ИдБитрикс24);
				
				Если ЗначениеЗаполнено(ИдЗаказа) Тогда
					РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.Заказ, Сделка.Ссылка, Формат(ИдЗаказа ,"ЧГ=0"));
				КонецЕсли;   
				
				Если ПринудительноРегистрироватьДокумент Тогда   
					
					ВремяЗаписиВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах() + 1000*30;
					Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(СтруктураНастроек.НастройкаПодключения, СтруктураНастроек.ТипыОбъектовОбмена.Сделка, Сделка.Ссылка, ВремяЗаписиВМиллисекундах);	
					
				КонецЕсли;
				
				Если НЕ ОтменаЗаписиСОшибкой Тогда
					ЗаполнитьДополнительныеСведенияОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);			
				КонецЕсли;
				
			КонецЕсли;
			
			#Область ДобавлениеСостоянияЗаказа
			Если ЗначениеЗаполнено(Сделка.Ссылка) Тогда
				Если ИнформацияОСтатусах <> Неопределено Тогда
					
					Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СостоянияЗаказов" Тогда
						
						тзнСтатусов = ИнформацияОСтатусах.СтатусыНаправленийСостояний;
						
						НайденныеСтроки = тзнСтатусов.НайтиСтроки(Новый Структура("ИдСтатуса, ИдНаправления", ИдСтатуса, ИдНаправления));
						
						Если НайденныеСтроки.Количество() > 0 Тогда
							НайденнаяСтрока = НайденныеСтроки[0];	
						Иначе
							НайденнаяСтрока = Неопределено;	
						КонецЕсли;
						
						Если НайденнаяСтрока <> Неопределено Тогда
							
							НаборЗаписей = РегистрыСведений["СостоянияЗаказовКлиентов"].СоздатьНаборЗаписей();
							НаборЗаписей.Отбор.Заказ.Установить(Сделка.Ссылка);
							НоваяЗапись = НаборЗаписей.Добавить();
							
							ЗаполнитьЗначенияСвойств(НоваяЗапись, ИнформацияОСостоянииЗаказа); 
							
							НоваяЗапись.Заказ 		= Сделка.Ссылка;
							НоваяЗапись.ДатаСобытия = ТекущаяДатаСеанса();
							НоваяЗапись.Состояние 	= НайденнаяСтрока["Статус"];
							
							НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
							НаборЗаписей.Записать(Истина);
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			#КонецОбласти	
			
		КонецЦикла;
		
		пСтруктураНастроек.Логирование.НомерСообщения = СтруктураНастроек.Логирование.НомерСообщения; 	// чтобы лог не затерся.
		
		Возврат Результат;					
	КонецЕсли;
	
КонецФункции

Функция ЗагрузитьОбновитьОплаты(пСтруктураНастроек, мДанных) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" Тогда
		ДокументПоступленияДенег = "ПоступлениеНаРасчетныйСчет";
		ДокументОплатаКартой = "ОплатаПлатежнойКартой";
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		ДокументПоступленияДенег = "ПоступлениеБезналичныхДенежныхСредств";
		ДокументОплатаКартой = "ОперацияПоПлатежнойКарте";
	КонецЕсли;
	Результат = Новый Массив; 
	
	Если НЕ пСтруктураНастроек.Свойство("НастройкиСинхронизацииОплатОтгрузок") Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(пСтруктураНастроек, пСтруктураНастроек.ТипыСообщений.Ошибка, "Не заполнены настройки синхронизации оплат и отгрузки");
		Возврат Результат;	
	КонецЕсли;	
	
	СтруктураНастроек = Новый Структура;
	Для Каждого ЭлементСтруктуры Из пСтруктураНастроек Цикл
		СтруктураНастроек.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;	
	
	ПрефиксВнешнихКодовБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПрефиксВнешнихКодовБитрикс24();
	
	МенеджерВременныхТаблиц = ПолучитьБазовыйМенеджерТаблицДляДокументов(СтруктураНастроек);

	ЗагруженныеОбъекты = Новый Массив;   
	
	Для каждого ТекЭлемент Из мДанных Цикл	
		
		Если ТипЗнч(ТекЭлемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;  
		
		ЕстьКритическиеОшибки = Ложь;
		
		ИдЗаказа				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("orderId"),"ЧГ=0"));
		ИдБитрикс24				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("id"),"ЧГ=0"));
		ВнешнийИдентификатор 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("xmlId"));
		ПлатежнаяСистема 		= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("paySystemId"),"ЧГ=0"));
		Оплачен 				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("paid"))= "Y";
		Отменен					= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("isReturn"))= "Y";
		ДатаНачала 				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата"),   ТекЭлемент.Получить("dateBill"));
		
#Область ФильтрацияПоЗагрузке		
		
		Если ЗагруженныеОбъекты.Найти(ИдБитрикс24) <> Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		ЗагруженныеОбъекты.Добавить(ИдБитрикс24);
		
		Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ ДатаНачала < СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ДатаНачалаЗагрузки Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Оплата с ид:  " + Строка(ИдБитрикс24) + " будет пропущена т.к. дата оплата меньше даты, с которой оплаты загружаются в 1С.");
			Продолжить;  			
		КонецЕсли;		
		
        ОснованиеСсылка = СсылкаПоИдБ24(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Заказ, ПрефиксВнешнихКодовБитрикс24.Заказы + ИдЗаказа);
		Если НЕ ЗначениеЗаполнено(ОснованиеСсылка) Тогда 
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не найден заказ по ид:" + ИдЗаказа + ". Оплата с ид:"+ИдБитрикс24+" не будет загружена.");
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
			Продолжить;	
		КонецЕсли;
		
		ВидОплаты = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("paySystemIsCash"));  // "Y" - наличные, "A" -эквайринг, "N" -безнал
		Если ВидОплаты = "Y" Тогда
			ИмяОбъекта = "ПриходныйКассовыйОрдер";
		ИначеЕсли ВидОплаты = "N" Тогда			
			ИмяОбъекта = ДокументПоступленияДенег;
		Иначе			
			ИмяОбъекта = ДокументОплатаКартой;
		КонецЕсли;

		ОбновлятьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", ИмяОбъекта, "ОбновлятьВ1С");
		АлгоритмПриЗагрузке 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", ИмяОбъекта, "АлгоритмПриЗагрузкеДанныхВ1С");
		РежимЗаписи 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", ИмяОбъекта, "РежимЗаписи");
		ПоляОбъекта1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", ИмяОбъекта);
		ОтборыДляЗагрузки 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОтборыДляЗагрузкиДанныхВ1С(СтруктураНастроек.НастройкаПодключения, "Оплата", ИмяОбъекта);
		ПоляТЧОбъекта1С 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностейТЧ(СтруктураНастроек.НастройкаПодключения, "Оплата", ИмяОбъекта);
		ЗагружатьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", ИмяОбъекта, "ЗагружатьВ1С");
		
		Если ЗагружатьВ1С = Ложь Тогда
			Продолжить;	
		КонецЕсли;
		
		НужноЗагружать = ПроверитьОбъект1СНаОтборыЗагрузки(СтруктураНастроек, ТекЭлемент, ОтборыДляЗагрузки, "Оплата");
		Если НЕ НужноЗагружать Тогда
			Продолжить;	
		КонецЕсли; 
		
#КонецОбласти

#Область ФильтрПС   

		Если СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.Свойство("ИспользуемыеПС") Тогда  
			
			ПропуститьОплату = СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИспользуемыеПС.Количество() > 0;	
			
			Для каждого ТекЭлементПС Из СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИспользуемыеПС Цикл
				
				Если ТекЭлементПС.Значение = ПлатежнаяСистема Тогда 
	    			ПропуститьОплату = Ложь;    
					Прервать
				КонецЕсли;
				
			КонецЦикла;  
			
			Если ПропуститьОплату Тогда
				Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Оплата с ид:  " + Строка(ИдБитрикс24) + " будет пропущена т.к. не подходит под фильтр платежных систем.");
				Продолжить;  			
			КонецЕсли;
			
		КонецЕсли;

#КонецОбласти  

		ЭтоНоваяОплата = Ложь;
#Область ПоискСозданиеОплаты		

		Оплата = СсылкаПоИдБ24(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Оплата, ИдБитрикс24);
		Если ЗначениеЗаполнено(ВнешнийИдентификатор) И НЕ ЗначениеЗаполнено(Оплата) Тогда
			
			Если ВидОплаты = "Y" Тогда
				ВнешнийИдентификатор = Прав(ВнешнийИдентификатор, СтрДлина(ВнешнийИдентификатор)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.ПоступлениеВКассу));	
				Оплата = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПриходныйКассовыйОрдер"), ВнешнийИдентификатор);
			ИначеЕсли ВидОплаты = "N" Тогда
				ВнешнийИдентификатор = Прав(ВнешнийИдентификатор, СтрДлина(ВнешнийИдентификатор)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.ПоступлениеНаСчет));	
				Оплата = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("ДокументСсылка."+ДокументПоступленияДенег), ВнешнийИдентификатор);
			Иначе
				ВнешнийИдентификатор = Прав(ВнешнийИдентификатор, СтрДлина(ВнешнийИдентификатор)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.ОперацияПоПлатежнымКартам));	
				Оплата = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("ДокументСсылка."+ДокументОплатаКартой), ВнешнийИдентификатор);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Оплата) Тогда 
			
			Если ВидОплаты = "Y" Тогда
				Оплата = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
			ИначеЕсли ВидОплаты = "N" Тогда
				Оплата = Документы[ДокументПоступленияДенег].СоздатьДокумент();
			Иначе
				Оплата = Документы[ДокументОплатаКартой].СоздатьДокумент();
			КонецЕсли;
			
			ЭтоНоваяОплата = Истина;
		Иначе
			
			Если ОбновлятьВ1С Тогда
				Оплата = Оплата.ПолучитьОбъект();
			Иначе
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "В настройках указано, что оплаты не обновляются. Документ: " + Строка(Оплата) + " не будет обновлен.");
				Продолжить;  				
			КонецЕсли;
		КонецЕсли; 
		
#КонецОбласти	

		ИнформацияОПлатежнойСистеме = Неопределено;  
#Область ПлатежнаяСистема		
		Если СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.Свойство("ИнформацияОПлатежныхСистемах") Тогда
			
			Для Каждого ТекПлатежнаяСистема Из СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИнформацияОПлатежныхСистемах.СоответствияПлатежныхСистем Цикл
				
				Если ТекПлатежнаяСистема.ПлатежнаяСистема.НайтиПоЗначению(ПлатежнаяСистема)<> Неопределено Тогда
					ИнформацияОПлатежнойСистеме = ТекПлатежнаяСистема;	
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
#КонецОбласти   

		ДанныеОснования = Новый Структура;
		Если ТипКонфигурации = "БП" Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, "Товары, ПометкаУдаления, ВалютаДокумента, Организация, Контрагент, ПодразделениеОрганизации, ДоговорКонтрагента, КурсВзаиморасчетов, КратностьВзаиморасчетов");
			ДанныеОснования.Вставить("ВалютаДокумента"		, ЗначенияРеквизитов.ВалютаДокумента);
			ДанныеОснования.Вставить("Подразделение"		, ЗначенияРеквизитов.ПодразделениеОрганизации);
			ДанныеОснования.Вставить("ДоговорКонтрагента"	, ЗначенияРеквизитов.ДоговорКонтрагента);     
			ДанныеОснования.Вставить("КурсВзаиморасчетов"		, ЗначенияРеквизитов.КурсВзаиморасчетов);     
			ДанныеОснования.Вставить("КратностьВзаиморасчетов"	, ЗначенияРеквизитов.КратностьВзаиморасчетов);      
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, "Товары, ПометкаУдаления, ОбъектРасчетов, Валюта, Организация, Партнер, Контрагент, Склад, Договор, Подразделение, НаправлениеДеятельности");
			ДанныеОснования.Вставить("Валюта"				, ЗначенияРеквизитов.Валюта);     
			ДанныеОснования.Вставить("ОбъектРасчетов"		, ЗначенияРеквизитов.ОбъектРасчетов);     
			ДанныеОснования.Вставить("Партнер"				, ЗначенияРеквизитов["Партнер"]);
			ДанныеОснования.Вставить("Подразделение"		, ЗначенияРеквизитов.Подразделение);
			ДанныеОснования.Вставить("Договор"				, ЗначенияРеквизитов.Договор);     
		КонецЕсли;
		ДанныеОснования.Вставить("Товары"				, ЗначенияРеквизитов.Товары.Выгрузить());
		ДанныеОснования.Вставить("Организация"			, ЗначенияРеквизитов.Организация);
		ДанныеОснования.Вставить("Контрагент"			, ЗначенияРеквизитов["Контрагент"]);
		ДанныеОснования.Вставить("ПометкаУдаления"		, ЗначенияРеквизитов.ПометкаУдаления);     
				
		ДополнительныеПараметры = Новый Структура;
		Если ТипКонфигурации = "БП" Тогда
			ДополнительныеПараметры.Вставить("Валюта"					, ДанныеОснования.ВалютаДокумента);
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			ДополнительныеПараметры.Вставить("ОснованиеОбъект"			, ДанныеОснования);
			ДополнительныеПараметры.Вставить("ОбъектРасчетов"			, ДанныеОснования.ОбъектРасчетов);
			ДополнительныеПараметры.Вставить("Валюта"					, ДанныеОснования.Валюта);
			ДополнительныеПараметры.Вставить("Партнер"					, ДанныеОснования["Партнер"]);
		КонецЕсли;
		ДополнительныеПараметры.Вставить("ПоляОбъекта1С"			, ПоляОбъекта1С);
		ДополнительныеПараметры.Вставить("ИдЭлементаБ24"			, ИдБитрикс24);
		ДополнительныеПараметры.Вставить("Объект1С"					, Оплата);
		ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
		ДополнительныеПараметры.Вставить("ДанныеЭлементаБ24"		, ТекЭлемент);
		ДополнительныеПараметры.Вставить("ЭтоНовыйОбъект"			, ЭтоНоваяОплата);
		ДополнительныеПараметры.Вставить("ИнформацияОПлатежнойСистеме", ИнформацияОПлатежнойСистеме);   
		ДополнительныеПараметры.Вставить("ТипОснования"				, "Заказ"); 
		ДополнительныеПараметры.Вставить("Основание"				, ОснованиеСсылка);  
		ДополнительныеПараметры.Вставить("ПомеченНаУдаление"		, Отменен);
		ДополнительныеПараметры.Вставить("Организация"				, ДанныеОснования.Организация);
		ДополнительныеПараметры.Вставить("Контрагент"				, ДанныеОснования["Контрагент"]);
		ДополнительныеПараметры.Вставить("Подразделение"			, ДанныеОснования.Подразделение);
		
		ЗаполнитьРеквизитыОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);
		
#Область ЗаполнениеРасшифровки	

		ТзнНДС = ДанныеОснования.Товары.Скопировать(); 
		тзнНДС.Свернуть("СтавкаНДС", "СуммаНДС, Сумма");

		Оплата.РасшифровкаПлатежа.Очистить();
		
		ОплатаВсего = Оплата.СуммаДокумента;

		КоличествоСтрок = ТзнНДС.Количество();
		ИтераторСтрок 	= 0;
		
		Для Каждого ТекНДС Из ТзнНДС Цикл 
			
			ИтераторСтрок = ИтераторСтрок + 1;
			
			Если ОплатаВсего = 0 Тогда
				Продолжить;
			ИначеЕсли ОплатаВсего < ТекНДС.Сумма Тогда
				
				СуммаРасшифровка 	= ОплатаВсего;
				ТекНДС.Сумма 		= ТекНДС.Сумма - ОплатаВсего; 
				ОплатаВсего 		= 0;
				
			Иначе
				
				Если КоличествоСтрок = ИтераторСтрок Тогда
					СуммаРасшифровка 	= ОплатаВсего;
					ОплатаВсего			= 0;
				Иначе
					СуммаРасшифровка 	= ТекНДС.Сумма;
					ОплатаВсего 		= ОплатаВсего - ТекНДС.Сумма; 
				КонецЕсли;
				
				ТекНДС.Сумма = 0;
				
			КонецЕсли;
			
			Если СуммаРасшифровка = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаРасшифровки = Оплата.РасшифровкаПлатежа.Добавить();
			
			ДополнительныеПараметрыТЧ = Новый Структура;
			ДополнительныеПараметрыТЧ.Вставить("ПоляТЧОбъекта1С"			, ПоляТЧОбъекта1С);
			ДополнительныеПараметрыТЧ.Вставить("МетаданныеТЧ"				, Метаданные.Документы[ИмяОбъекта].ТабличныеЧасти.РасшифровкаПлатежа);
			ДополнительныеПараметрыТЧ.Вставить("Объект1С"					, Оплата);
			ДополнительныеПараметрыТЧ.Вставить("СтрокаТЧ"					, НоваяСтрокаРасшифровки);
			ДополнительныеПараметрыТЧ.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);  
			ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаБ24"			, ТекЭлемент);  
			ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаТЧБ24"		, ТекНДС);
			ДополнительныеПараметрыТЧ.Вставить("ПомеченНаУдаление"			, ДанныеОснования.ПометкаУдаления);
			ДополнительныеПараметрыТЧ.Вставить("ЭтоНовыйОбъект"				, ЭтоНоваяОплата);
			ДополнительныеПараметрыТЧ.Вставить("Номенклатура"				, Неопределено);
			ДополнительныеПараметрыТЧ.Вставить("Характеристика"				, Неопределено);
			ДополнительныеПараметрыТЧ.Вставить("ТипОснования"				, "Заказ"); 
			ДополнительныеПараметрыТЧ.Вставить("Основание"					, ОснованиеСсылка);
			ДополнительныеПараметрыТЧ.Вставить("ОснованиеОбъект"			, ДанныеОснования);
			ДополнительныеПараметрыТЧ.Вставить("СуммаРасшифровка"			, СуммаРасшифровка);
			Если ТипКонфигурации = "УТ" Тогда
				ДополнительныеПараметрыТЧ.Вставить("ОбъектРасчетов"				, ДанныеОснования.ОбъектРасчетов);
			КонецЕсли;
			
			ЗаполнитьРеквизитыТЧОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметрыТЧ, "РасшифровкаПлатежа");
			
		КонецЦикла;
		
#КонецОбласти		

		Если ЗначениеЗаполнено(АлгоритмПриЗагрузке) Тогда
			
			ОтказНаЗапись = ВыполнитьАлгоритмПередЗагрузкой(СтруктураНастроек, Оплата, ТекЭлемент, АлгоритмПриЗагрузке);    
			Если ОтказНаЗапись Тогда
				Продолжить;	
			КонецЕсли; 
			
		КонецЕсли;
		
		Если ЭтоНоваяОплата  И НЕ ЗначениеЗаполнено(Оплата.Номер) Тогда
			
			НастройкиОперации = СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок;	
			Если НастройкиОперации.ИсточникНомераДокумента = "По данным с Битрикс24" Тогда
				
				НомерОплатыБ24 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("accountNumber"),"ЧГ=0"));
				НомерОплатыБ24	= ?(ЗначениеЗаполнено(НомерОплатыБ24), НомерОплатыБ24, ИдБитрикс24);
				
				Оплата.Номер = НомерОплатыБ24;
				
			Иначе
				Оплата.УстановитьНовыйНомер();
			КонецЕсли;	
			
		КонецЕсли;
		
#Область ПроведениеДокумента
		Оплата.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
		
		Если (РежимЗаписи = "Проводить оплаченные" И Оплачен)
			ИЛИ (РежимЗаписи = "Проводить" И НЕ Отменен) Тогда
			
			Попытка
				Оплата.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Проведен документ: " + Строка(Оплата), Оплата.Ссылка);
			Исключение
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время проведения документа: " + Строка(Оплата) + " возникли ошибки.", Оплата.Ссылка);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЕстьКритическиеОшибки = Истина;
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Попытка записи документа: " + Строка(Оплата), Оплата.Ссылка);
				
				Попытка
					Оплата.Записать(РежимЗаписиДокумента.Запись);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан документ: " + Строка(Оплата), Оплата.Ссылка);
				Исключение
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Оплата) + " возникли ошибки.", Оплата.Ссылка);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
					СтруктураНастроек.ВыполненоБезОшибок = Ложь;
				
				КонецПопытки;
				
			КонецПопытки;
			
		Иначе
			Попытка
				Если ЭтоНоваяОплата ИЛИ НЕ Оплата.Проведен Тогда
					Оплата.Записать(РежимЗаписиДокумента.Запись); 
				Иначе
					Оплата.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
				КонецЕсли;
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан: " + Строка(Оплата), Оплата.Ссылка);
			Исключение
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Оплата) + " возникли ошибки.", Оплата.Ссылка);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
				ЕстьКритическиеОшибки = Истина;
			
				СтруктураНастроек.ВыполненоБезОшибок = Ложь;
	
			КонецПопытки;
		КонецЕсли;
		
		Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, НЕ ЕстьКритическиеОшибки)));
#КонецОбласти		 

		Если ЗначениеЗаполнено(Оплата.Ссылка) Тогда
			РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.Оплата, Оплата.Ссылка, ИдБитрикс24, ИдЗаказа);
		КонецЕсли;
		
	КонецЦикла;
	
	пСтруктураНастроек.Логирование.НомерСообщения = СтруктураНастроек.Логирование.НомерСообщения; 	
	
	Возврат Результат;   
	
КонецФункции

Функция ЗагрузитьОбновитьОтгрузки(пСтруктураНастроек, мДанных) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" Тогда
		ДокументСделки = "СчетНаОплатуПокупателю";
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		ДокументСделки = "ЗаказКлиента";
	КонецЕсли;
	Результат = Новый Массив; 
	
	Если НЕ пСтруктураНастроек.Свойство("НастройкиСинхронизацииОплатОтгрузок") Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(пСтруктураНастроек, пСтруктураНастроек.ТипыСообщений.Ошибка, "Не заполнены настройки синхронизации оплат и отгрузки");
		Возврат Результат;	
	КонецЕсли;	
	
	СтруктураНастроек = Новый Структура;
	Для Каждого ЭлементСтруктуры Из пСтруктураНастроек Цикл
		СтруктураНастроек.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;	
	
	ПрефиксВнешнихКодовБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПрефиксВнешнихКодовБитрикс24();
	
	МенеджерВременныхТаблиц = ПолучитьБазовыйМенеджерТаблицДляДокументов(СтруктураНастроек);
	
	ЗагруженныеОбъекты = Новый Массив;   
	
	Для каждого ТекЭлемент Из мДанных.ИнформацияОтгрузок Цикл	
		
		Если ТипЗнч(ТекЭлемент) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;  
		
		ЕстьКритическиеОшибки = Ложь;
		
		ИдЗаказа				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("orderId"),"ЧГ=0"));
		ИдБитрикс24				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("id"),"ЧГ=0"));
		ВнешнийИдентификатор	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), ТекЭлемент.Получить("xmlId"));
		Отгружен	 			= ТекЭлемент.Получить("deducted") = "Y";   
		Отменен	 				= ТекЭлемент.Получить("canceled") = "Y";   
		ДоставкаРазрешена		= ТекЭлемент.Получить("allowDelivery") = "Y";
		ИдСтатуса				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("statusId"),"ЧГ=0"));
		ИдДоставки				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("deliveryId"),"ЧГ=0"));
		ТрекНомер 				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("trackingNumber"),"ЧГ=0"));
		Если ТипКонфигурации = "УТ" Тогда
			СтоимостьДоставки	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"), Формат(ТекЭлемент.Получить("priceDelivery"),"ЧРД=.; ЧГ=0"));
		КонецЕсли;
		
		ДатаНачала     			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата"),   ТекЭлемент.Получить("dateInsert"));
		Если Не ЗначениеЗаполнено(ДатаНачала) Тогда ДатаНачала = ТекущаяДатаСеанса() КонецЕсли;	
		
		ДатаОтгрузки 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата"),   ТекЭлемент.Получить("deliveryDocDate"));
		Если Не ЗначениеЗаполнено(ДатаОтгрузки) Тогда ДатаОтгрузки = ДатаНачала + 7*24*60*60 КонецЕсли;
		
		ОснованиеСсылка 		= Документы[ДокументСделки].ПустаяСсылка();     
		
		ЗагружатьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Отгрузка", "РеализацияТоваровУслуг", "ЗагружатьВ1С");
		ОбновлятьВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Отгрузка", "РеализацияТоваровУслуг", "ОбновлятьВ1С");
		ОбновлятьТЧВ1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Отгрузка", "РеализацияТоваровУслуг", "ОбновлятьТЧВ1С") <> Ложь;       
		АлгоритмПриЗагрузке 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Отгрузка", "РеализацияТоваровУслуг", "АлгоритмПриЗагрузкеДанныхВ1С");
		РежимЗаписи 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Отгрузка", "РеализацияТоваровУслуг", "РежимЗаписи");
		ПоляОбъекта1С 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Отгрузка", "РеализацияТоваровУслуг");
		ОтборыДляЗагрузки 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОтборыДляЗагрузкиДанныхВ1С(СтруктураНастроек.НастройкаПодключения, "Отгрузка", "РеализацияТоваровУслуг");
		ПоляТЧОбъекта1С 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗагружаемыеПоляСущностейТЧ(СтруктураНастроек.НастройкаПодключения, "Отгрузка", "РеализацияТоваровУслуг");
		
		#Область ФильтрацияПоЗагрузке		
		Если ЗагружатьВ1С = Ложь Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ЗагруженныеОбъекты.Найти(ИдБитрикс24) <> Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		ЗагруженныеОбъекты.Добавить(ИдБитрикс24);
		
		Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ ДатаНачала < СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ДатаНачалаЗагрузки Тогда
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Отгрузка с ид:  " + Строка(ИдБитрикс24) + " будет пропущена т.к. дата отгрузки меньше даты, с которой отгрузки загружаются в 1С.");
			Продолжить;  			
		КонецЕсли;		
		
		НужноЗагружать = ПроверитьОбъект1СНаОтборыЗагрузки(СтруктураНастроек, ТекЭлемент, ОтборыДляЗагрузки, "Отгрузка");
		Если НЕ НужноЗагружать Тогда
			Продолжить;	
		КонецЕсли;
		
		ОснованиеСсылка = СсылкаПоИдБ24(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Заказ, ПрефиксВнешнихКодовБитрикс24.Заказы + ИдЗаказа);
		Если НЕ ЗначениеЗаполнено(ОснованиеСсылка) Тогда 
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не найден заказ по ид:" + ИдЗаказа + ". Отгрузка с ид:"+ИдБитрикс24+" не будет загружена.");
			Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, Истина)));
			Продолжить;	
		КонецЕсли;
		
		Если СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.Свойство("ИнформацияОСтатусах") Тогда	
			ИнформацияОСтатусах = СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИнформацияОСтатусах;
			Если ИнформацияОСтатусах.ИсточникСтатусовОтгрузок = "СвойствоОтгрузок" Тогда
				тзнСтатусов = ИнформацияОСтатусах.СоответствияСЗначениямиСвойствОтгрузки;	
			Иначе	
				тзнСтатусов = ИнформацияОСтатусах.СоответствияССтатусамиОтгрузки;
			КонецЕсли;
		Иначе  
			
			тзнСтатусов = Новый ТаблицаЗначений;
			тзнСтатусов.Колонки.Добавить("ИдСтатуса");
			тзнСтатусов.Колонки.Добавить("Статус");
			тзнСтатусов.Колонки.Добавить("НеЗагружать");
			
			ИнформацияОСтатусах = Неопределено;
		КонецЕсли;                                                        
		
		Если ИнформацияОСтатусах <> Неопределено И ТипЗнч(тзнСтатусов) = Тип("ТаблицаЗначений") Тогда
			
			ПропускаемЗаказИзЗаСтатуса = Ложь;
			
			НайденнаяСтрока = тзнСтатусов.Найти(ИдСтатуса, "ИдСтатуса");
			Если НайденнаяСтрока <> Неопределено Тогда
				ПропускаемЗаказИзЗаСтатуса = НайденнаяСтрока.НеЗагружать;	
			КонецЕсли;				
			
			Если ПропускаемЗаказИзЗаСтатуса Тогда			
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Отгрузка с ид:  " + Строка(ИдБитрикс24) + " будет пропущена т.к.  у нее неподходящий статус");
				Продолжить;  			
			КонецЕсли;					
		КонецЕсли;		
		#КонецОбласти
		
		КорзинаЗаказа = Новый Соответствие;       
		#Область ПолучениеКорзины		       
		Для каждого ТекЭлементКорзины Из мДанных.КорзинаЗаказов Цикл  
			Если ТипЗнч(ТекЭлементКорзины) = Тип("Соответствие") Тогда
				Если ИдЗаказа = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлементКорзины.Получить("orderId"),"ЧГ=0")) Тогда
					ИдПозицииКорзины = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлементКорзины.Получить("id"),"ЧГ=0"));
					КорзинаЗаказа.Вставить(ИдПозицииКорзины,ТекЭлементКорзины);	
				КонецЕсли;
			ИначеЕсли ТипЗнч(ТекЭлементКорзины) = Тип("Массив") Тогда
				Для каждого ТекЭлементКорзины2 Из ТекЭлементКорзины Цикл  
					Если ИдЗаказа = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлементКорзины2.Получить("orderId"),"ЧГ=0")) Тогда
						ИдПозицииКорзины = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлементКорзины2.Получить("id"),"ЧГ=0"));
						КорзинаЗаказа.Вставить(ИдПозицииКорзины,ТекЭлементКорзины2);	
					КонецЕсли;  
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		#КонецОбласти	
		
		ЭлементыКорзины = Неопределено;        
		#Область ПолучениеКорзины		
		ЭлементыКорзины = ТекЭлемент.Получить("shipmentItems");  
		Если ЭлементыКорзины = Неопределено Тогда
			СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/sale.shipmentitem.list", "&filter[orderDeliveryId]=" + ИдБитрикс24 + "&start=-1"); 
			Если СтруктураОтвета <> Неопределено Тогда
				result = СтруктураОтвета.Получить("result");
				Если result <> Неопределено Тогда
					shipmentItems = result.Получить("shipmentItems");
					Если shipmentItems <> Неопределено Тогда
						ЭлементыКорзины = shipmentItems; 
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ЭлементыКорзины = ?(ЭлементыКорзины = Неопределено, Новый Массив, ЭлементыКорзины);
		#КонецОбласти	
		
		ЭтоНоваяОтгрузка = Ложь;
		#Область ПоискСозданиеОтгрузки		
		Отгрузка = СсылкаПоИдБ24(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Отгрузка, ИдБитрикс24);
		Если ЗначениеЗаполнено(ВнешнийИдентификатор) И НЕ ЗначениеЗаполнено(Отгрузка) Тогда
			Отгрузка = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.РеализацияТоваровУслуг"), ВнешнийИдентификатор);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Отгрузка) Тогда 
			
			Если Отменен Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Отгрузка с ид:  " + Строка(ИдБитрикс24) + " будет пропущен т.к.  его в 1С нет и она отменена.");
				Продолжить;  			
			КонецЕсли;					
			
			Отгрузка = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			ЭтоНоваяОтгрузка = Истина;
		Иначе
			
			Если ОбновлятьВ1С Тогда
				Отгрузка = Отгрузка.ПолучитьОбъект();
			Иначе
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "В настройках указано, что заказы и подчиненные данные не обновляются. Отгрузка: " + Строка(Отгрузка) + " не будет обновлена.");
				Продолжить;  				
			КонецЕсли;
		КонецЕсли;
		#КонецОбласти	
		
		Если ТипКонфигурации = "УТ" Тогда
			#Область ДобавлениеДополнительногоРеквизитаДоставки
			ИнформацияОДоставках = Неопределено;
			Если СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.Свойство("ИнформацияОДоставках") Тогда	
				ИнформацияОДоставках = СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИнформацияОДоставках;
			КонецЕсли;                                                        
			
			Если ИнформацияОДоставках <>Неопределено Тогда
				
				Если ИнформацияОДоставках.ИсточникСлужбДоставкиОтгрузок = "СвойствоОтгрузок" Тогда
					Если ЗначениеЗаполнено(ИнформацияОДоставках.СвойствоОтгрузки) Тогда
						тзнДоставок = ИнформацияОДоставках.СоответствияСЗначениямиСвойствОтгрузки;
						
						ЗначениеСвойства = Неопределено;
						
						НайденнаяСтрока = тзнДоставок.Найти(ИдДоставки, "ИдСлужбы");
						Если НайденнаяСтрока <> Неопределено Тогда
							ЗначениеСвойства = НайденнаяСтрока.Служба;	
						КонецЕсли;
						
						НайденноеСвойствоТЧ = Отгрузка.ДополнительныеРеквизиты.Найти(ИнформацияОДоставках.СвойствоОтгрузки, "Свойство");
						Если НайденноеСвойствоТЧ = Неопределено Тогда
							НовыйРеквизит = Отгрузка.ДополнительныеРеквизиты.Добавить();
							НовыйРеквизит.Значение = ЗначениеСвойства;
							НовыйРеквизит.Свойство = ИнформацияОДоставках.СвойствоОтгрузки;
						Иначе
							НайденноеСвойствоТЧ.Значение = ЗначениеСвойства;	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			#КонецОбласти	
			
			ПеревозчикПартнер = Справочники["Партнеры"].ПустаяСсылка();
			#Область ПоискАдресаДоставки	
			Если ИнформацияОДоставках <>Неопределено Тогда
				Если ИнформацияОДоставках.ИсточникСлужбДоставкиОтгрузок = "СпособыДоставкиОтгрузок" Тогда
					НайденнаяСтрока = ИнформацияОДоставках.СоответствияСпособовДоставкиОтгрузки.Найти(ИдДоставки, "ИдСлужбы");
					Если НайденнаяСтрока <> Неопределено Тогда
						ПеревозчикПартнер = НайденнаяСтрока.СлужбаДоставки;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			#КонецОбласти						
		КонецЕсли;
		
		Если ТипКонфигурации = "БП" Тогда
			ЗначенияРеквизитовОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, "ВалютаДокумента, Организация, Контрагент, ПодразделениеОрганизации, Товары");
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			ЗначенияРеквизитовОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, "ОбъектРасчетов, Валюта, Организация, Партнер, Контрагент, Подразделение, Товары, ЭтапыГрафикаОплаты");
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПоляОбъекта1С"			, ПоляОбъекта1С);
		ДополнительныеПараметры.Вставить("ИдЭлементаБ24"			, ИдБитрикс24);
		ДополнительныеПараметры.Вставить("Объект1С"					, Отгрузка);
		ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
		ДополнительныеПараметры.Вставить("ДанныеЭлементаБ24"		, ТекЭлемент);
		ДополнительныеПараметры.Вставить("ПомеченНаУдаление"		, Отменен);
		ДополнительныеПараметры.Вставить("ЭтоНовыйОбъект"			, ЭтоНоваяОтгрузка);
		ДополнительныеПараметры.Вставить("ТипОснования"				, "Заказ");
		ДополнительныеПараметры.Вставить("Основание"				, ОснованиеСсылка);
		ДополнительныеПараметры.Вставить("Организация"				, ЗначенияРеквизитовОснования.Организация);
		ДополнительныеПараметры.Вставить("Контрагент"				, ЗначенияРеквизитовОснования["Контрагент"]);                   
		Если ТипКонфигурации = "БП" Тогда
			ДополнительныеПараметры.Вставить("Валюта"					, ЗначенияРеквизитовОснования.ВалютаДокумента);
			ДополнительныеПараметры.Вставить("Подразделение"			, ЗначенияРеквизитовОснования.ПодразделениеОрганизации);
			ДополнительныеПараметры.Вставить("НоменклатураДоставка"		, СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.НоменклатураДоставка);
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			ДополнительныеПараметры.Вставить("ИнформацияОДоставках"		, ИнформацияОДоставках);	
			ДополнительныеПараметры.Вставить("ОбъектРасчетов"			, ЗначенияРеквизитовОснования.ОбъектРасчетов);    
			ДополнительныеПараметры.Вставить("Валюта"					, ЗначенияРеквизитовОснования.Валюта);
			ДополнительныеПараметры.Вставить("Партнер"					, ЗначенияРеквизитовОснования["Партнер"]);    
			ДополнительныеПараметры.Вставить("Подразделение"			, ЗначенияРеквизитовОснования.Подразделение);
			ДополнительныеПараметры.Вставить("ПеревозчикПартнер"		, ПеревозчикПартнер);
			ДополнительныеПараметры.Вставить("ИдДоставки"				, ИдДоставки);		
		КонецЕсли;

		ЗаполнитьРеквизитыОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметры);        
		
		Если ТипКонфигурации = "УТ" Тогда
			#Область ДобавлениеДополнительныхРеквизитовДокумента	
			НайденноеСвойствоТЧ = Отгрузка.ДополнительныеРеквизиты.Найти(СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомераОтгрузкиБитрикс24, "Свойство");
			Если НайденноеСвойствоТЧ = Неопределено Тогда
				НовыйРеквизит = Отгрузка.ДополнительныеРеквизиты.Добавить();
				НовыйРеквизит.Значение = ИдБитрикс24;
				НовыйРеквизит.Свойство = СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомераОтгрузкиБитрикс24;
			Иначе
				НайденноеСвойствоТЧ.Значение = ИдБитрикс24;	
			КонецЕсли;
			
			НайденноеСвойствоТЧ = Отгрузка.ДополнительныеРеквизиты.Найти(СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДатыОтгрузкиБитрикс24, "Свойство");
			Если НайденноеСвойствоТЧ = Неопределено Тогда
				НовыйРеквизит = Отгрузка.ДополнительныеРеквизиты.Добавить();
				НовыйРеквизит.Значение = ДатаНачала;
				НовыйРеквизит.Свойство = СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДатыОтгрузкиБитрикс24;
			Иначе
				НайденноеСвойствоТЧ.Значение = ДатаНачала;	
			КонецЕсли;
			
			НайденноеСвойствоТЧ = Отгрузка.ДополнительныеРеквизиты.Найти(СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоТрекНомераОтгрузкиБитрикс24, "Свойство");
			Если НайденноеСвойствоТЧ = Неопределено Тогда
				НовыйРеквизит = Отгрузка.ДополнительныеРеквизиты.Добавить();
				НовыйРеквизит.Значение = ТрекНомер;
				НовыйРеквизит.Свойство = СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоТрекНомераОтгрузкиБитрикс24;
			Иначе
				НайденноеСвойствоТЧ.Значение = ТрекНомер;	
			КонецЕсли;
			
			НайденноеСвойствоТЧ = Отгрузка.ДополнительныеРеквизиты.Найти(СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДоставкаРазрешенаОтгрузкиБитрикс24, "Свойство");
			Если НайденноеСвойствоТЧ = Неопределено Тогда
				НовыйРеквизит = Отгрузка.ДополнительныеРеквизиты.Добавить();
				НовыйРеквизит.Значение = ДоставкаРазрешена;
				НовыйРеквизит.Свойство = СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДоставкаРазрешенаОтгрузкиБитрикс24;
			Иначе
				НайденноеСвойствоТЧ.Значение = ДоставкаРазрешена;	
			КонецЕсли;
			#КонецОбласти		
			
			#Область ДобавлениеДополнительногоРеквизитаСтатуса
			Если ИнформацияОСтатусах <> Неопределено И ТипЗнч(тзнСтатусов) = Тип("ТаблицаЗначений") Тогда
				
				Если ИнформацияОСтатусах.ИсточникСтатусовОтгрузок = "СвойствоОтгрузок" Тогда
					Если ЗначениеЗаполнено(ИнформацияОСтатусах.СвойствоОтгрузки) Тогда
						ЗначениеСвойства = Неопределено;
						
						НайденнаяСтрока = тзнСтатусов.Найти(ИдСтатуса, "ИдСтатуса");
						Если НайденнаяСтрока <> Неопределено Тогда
							ЗначениеСвойства = НайденнаяСтрока["Статус"];	
						КонецЕсли;
						
						НайденноеСвойствоТЧ = Отгрузка.ДополнительныеРеквизиты.Найти(ИнформацияОСтатусах.СвойствоОтгрузки, "Свойство");
						Если НайденноеСвойствоТЧ = Неопределено Тогда
							НовыйРеквизит = Отгрузка.ДополнительныеРеквизиты.Добавить();
							НовыйРеквизит.Значение = ЗначениеСвойства;
							НовыйРеквизит.Свойство = ИнформацияОСтатусах.СвойствоОтгрузки;
						Иначе
							НайденноеСвойствоТЧ.Значение = ЗначениеСвойства;	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			#КонецОбласти	
			
			#Область ДобавлениеДополнительногоРеквизитаДоставки
			ИнформацияОДоставках = Неопределено;
			Если СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.Свойство("ИнформацияОДоставках") Тогда	
				ИнформацияОДоставках = СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИнформацияОДоставках;
			КонецЕсли;                                                        
			
			Если ИнформацияОДоставках <>Неопределено Тогда
				
				Если ИнформацияОДоставках.ИсточникСлужбДоставкиОтгрузок = "СвойствоОтгрузок" Тогда
					Если ЗначениеЗаполнено(ИнформацияОДоставках.СвойствоОтгрузки) Тогда
						тзнДоставок = ИнформацияОДоставках.СоответствияСЗначениямиСвойствОтгрузки;
						
						ЗначениеСвойства = Неопределено;
						
						НайденнаяСтрока = тзнДоставок.Найти(ИдДоставки, "ИдСлужбы");
						Если НайденнаяСтрока <> Неопределено Тогда
							ЗначениеСвойства = НайденнаяСтрока.Служба;	
						КонецЕсли;
						
						НайденноеСвойствоТЧ = Отгрузка.ДополнительныеРеквизиты.Найти(ИнформацияОДоставках.СвойствоОтгрузки, "Свойство");
						Если НайденноеСвойствоТЧ = Неопределено Тогда
							НовыйРеквизит = Отгрузка.ДополнительныеРеквизиты.Добавить();
							НовыйРеквизит.Значение = ЗначениеСвойства;
							НовыйРеквизит.Свойство = ИнформацияОДоставках.СвойствоОтгрузки;
						Иначе
							НайденноеСвойствоТЧ.Значение = ЗначениеСвойства;	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			#КонецОбласти				
		КонецЕсли;
		
		#Область ЗаполнениеТоваров	    
		
		Если ОбновлятьТЧВ1С Тогда     
			
			тзнТоваровАрх 	= Отгрузка.Товары.Выгрузить();			
			Отгрузка.Товары.Очистить();		
			
			Если ТипКонфигурации = "БП" Тогда
				тзнУслугАрх 	= Отгрузка.Услуги.Выгрузить();
				Отгрузка.Услуги.Очистить();			
			КонецЕсли;
			
			ТоварыОснования = ЗначенияРеквизитовОснования.Товары.Выгрузить();
			
			Для Каждого ТоварОтгрузки Из ЭлементыКорзины Цикл	
				
				ИдПозицииКорзины	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТоварОтгрузки.Получить("basketId"),"ЧГ=0"));
				Количество 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Число"), Формат(ТоварОтгрузки.Получить("quantity"),"ЧРД=.; ЧГ=0"));
				
				ИнформацияПозицииКорзины = КорзинаЗаказа.Получить(ИдПозицииКорзины);  
				Если ИнформацияПозицииКорзины = Неопределено Тогда
					Продолжить;
				КонецЕсли;      
				
				Номенклатура	= Справочники.Номенклатура.ПустаяСсылка();
				Если ТипКонфигурации = "УТ" Тогда
					Характеристика  = Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка();
				КонецЕсли;
				#Область ПоискТовара	
				ИдТовара 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ИнформацияПозицииКорзины.Получить("productId"),"ЧГ=0"));
				ВнешнийКодПозиции	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Строка(ИнформацияПозицииКорзины.Получить("productXmlId")));
				НаименованиеТовара	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Строка(ИнформацияПозицииКорзины.Получить("name")));			
				
				Если ЗначениеЗаполнено(ВнешнийКодПозиции) Тогда
					
					СтруктураИдентификаторовТовара = Б24_КС_ОбщегоНазначенияВызовСервера.ПолучитьДвеСоставныеЧастиИзСтроки(ВнешнийКодПозиции, "#");
					ИдВнешнийНоменклатуры 	= СтруктураИдентификаторовТовара.ПерваяЧасть;
					
					Если ЗначениеЗаполнено(ИдВнешнийНоменклатуры) Тогда
						Номенклатура = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Номенклатура"), ИдВнешнийНоменклатуры);
					КонецЕсли; 
					
					Если ТипКонфигурации = "УТ" Тогда
						ИдВнешнийХарактеристики = СтруктураИдентификаторовТовара.ВтораяЧасть;
						Если ЗначениеЗаполнено(ИдВнешнийХарактеристики) Тогда
							Характеристика = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.ХарактеристикиНоменклатуры"), ИдВнешнийХарактеристики);
						КонецЕсли;	
					КонецЕсли;
					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ИдТовара) И НЕ ЗначениеЗаполнено(Номенклатура) Тогда
					
					ИнформацияОНоменклатуре = Неопределено;	
					
					Запрос = Новый Запрос;
					Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
					Запрос.УстановитьПараметр("Идентификатор", ИдТовара);
					
					Запрос.Текст = "ВЫБРАТЬ
					|	ВТ_Идентификаторы.Объект КАК Объект,
					|	ВТ_Идентификаторы.ПодчиненныйОбъект КАК ПодчиненныйОбъект
					|ИЗ
					|	ВТ_ИдентификаторыТоваров КАК ВТ_Идентификаторы
					|ГДЕ
					|	ВТ_Идентификаторы.Идентификатор = &Идентификатор";
					
					ВыполненныйЗапрос = Запрос.Выполнить();
					
					Если НЕ ВыполненныйЗапрос.Пустой() Тогда
						Выборка = ВыполненныйЗапрос.Выбрать();
						Пока Выборка.Следующий() Цикл
							ИнформацияОНоменклатуре = Выборка;
							Прервать;
						КонецЦикла;
					КонецЕсли;
					
					Если ИнформацияОНоменклатуре = Неопределено Тогда
						
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Не найден товар по ид. Попытка создания товара с Ид: " + ИдТовара);
						ИнформацияОНоменклатуре = СформироватьНоменклатуруХарактеристикуПоИд(СтруктураНастроек, ИдТовара);
						
						Если ИнформацияОНоменклатуре = Неопределено Тогда
							Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не найдена информация о номенклатуре с Ид: " + ИдТовара);
							ЕстьКритическиеОшибки = Истина;
						Иначе
							Номенклатура   = ИнформацияОНоменклатуре.Объект;
							Если ТипКонфигурации = "УТ" Тогда
								Характеристика = ИнформацияОНоменклатуре.ПодчиненныйОбъект;
							КонецЕсли;
						КонецЕсли;
						
					Иначе
						Номенклатура   = ИнформацияОНоменклатуре.Объект;
						Если ТипКонфигурации = "УТ" Тогда
								Характеристика = ИнформацияОНоменклатуре.ПодчиненныйОбъект;
							КонецЕсли;
					КонецЕсли; 
				КонецЕсли; 		
				
				Если НЕ ЗначениеЗаполнено(ВнешнийКодПозиции) И НЕ ЗначениеЗаполнено(ИдТовара) Тогда
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "В сделке был указан не товар, а строка. Товар: " + НаименованиеТовара + " в заказе: " + Строка(ОснованиеСсылка) + " не будет указан.");
				КонецЕсли; 	
				
				Номенклатура 	= ?(ЗначениеЗаполнено(Номенклатура), Номенклатура, Справочники.Номенклатура.ПустаяСсылка());			
				Если ТипКонфигурации = "УТ" Тогда
					Характеристика 	= ?(ЗначениеЗаполнено(Характеристика), Характеристика, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());			
				КонецЕсли;
				#КонецОбласти	
				
				ПозицияЗаказа = Неопределено;
				Если ТипКонфигурации = "БП" Тогда
					ПозицииЗаказа = ТоварыОснования.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
				ИначеЕсли ТипКонфигурации = "УТ" Тогда
					ПозицииЗаказа = ТоварыОснования.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика));
				КонецЕсли;
				Если ПозицииЗаказа.Количество() > 0 Тогда
					ПозицияЗаказа = ПозицииЗаказа[0];
				КонецЕсли;  
				
				Если ПозицияЗаказа = Неопределено Тогда
					Продолжить;
				КонецЕсли;      
				
				Если ТипКонфигурации = "БП" Тогда
					Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "Услуга") = Истина Тогда
						НоваяСтрока 				= Отгрузка.Услуги.Добавить();
						ЗначениеПустогоКоличества 	= 1;
						ИмяТЧ 						= "Услуги";
						ВремТЗНоменклатуры 			= тзнУслугАрх;
					Иначе
						НоваяСтрока = Отгрузка.Товары.Добавить();
						ЗначениеПустогоКоличества 	= 0;
						ИмяТЧ 						= "Товары";
						ВремТЗНоменклатуры 			= тзнТоваровАрх;
					КонецЕсли;
					НайденныеСтроки = ВремТЗНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
				ИначеЕсли ТипКонфигурации = "УТ" Тогда
					ИмяТЧ = "Товары";
					НоваяСтрока = Отгрузка.Товары.Добавить();
					НайденныеСтроки = тзнТоваровАрх.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика));
				КонецЕсли;				
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныеСтроки[0]);      
				КонецЕсли;
				
				ДополнительныеПараметрыТЧ = Новый Структура;
				ДополнительныеПараметрыТЧ.Вставить("ПоляТЧОбъекта1С"			, ПоляТЧОбъекта1С);
				ДополнительныеПараметрыТЧ.Вставить("МетаданныеТЧ"				, Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти[ИмяТЧ]);
				ДополнительныеПараметрыТЧ.Вставить("Объект1С"					, Отгрузка);
				ДополнительныеПараметрыТЧ.Вставить("СтрокаТЧ"					, НоваяСтрока);
				ДополнительныеПараметрыТЧ.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);   
				ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаБ24"			, ТекЭлемент);  
				ДополнительныеПараметрыТЧ.Вставить("ДанныеЭлементаТЧБ24"		, ТоварОтгрузки);
				ДополнительныеПараметрыТЧ.Вставить("ПомеченНаУдаление"			, Отменен);
				ДополнительныеПараметрыТЧ.Вставить("ЭтоНовыйОбъект"				, ЭтоНоваяОтгрузка);
				ДополнительныеПараметрыТЧ.Вставить("Основание"					, ОснованиеСсылка);
				ДополнительныеПараметрыТЧ.Вставить("Номенклатура"				, Номенклатура);
				ДополнительныеПараметрыТЧ.Вставить("ИнформацияОПозицииТовара"	, ПозицияЗаказа);
				ДополнительныеПараметрыТЧ.Вставить("Количество"					, Количество);
				Если ТипКонфигурации = "БП" Тогда
					ДополнительныеПараметрыТЧ.Вставить("Характеристика"				, Неопределено);         
					ДополнительныеПараметрыТЧ.Вставить("КлючСвязиПозиции"			, ПозицияЗаказа.Б24_К_КлючСвязи);					
				ИначеЕсли ТипКонфигурации = "УТ" Тогда
					ДополнительныеПараметрыТЧ.Вставить("ОснованиеОбъект"			, ЗначенияРеквизитовОснования);
					ДополнительныеПараметрыТЧ.Вставить("ОбъектРасчетов"				, ЗначенияРеквизитовОснования.ОбъектРасчетов);          
					ДополнительныеПараметрыТЧ.Вставить("Характеристика"				, Характеристика);         
					ДополнительныеПараметрыТЧ.Вставить("КлючСвязиПозиции"			, ПозицияЗаказа.КлючСвязи);					
				КонецЕсли;

				ЗаполнитьРеквизитыТЧОбъекта1СПоКонструктору(СтруктураНастроек, ДополнительныеПараметрыТЧ, ИмяТЧ);
				
				Если ТипКонфигурации = "БП" Тогда
					Если НайденныеСтроки.Количество() > 0 Тогда
						ВремТЗНоменклатуры.Удалить(НайденныеСтроки[0]);
					КонецЕсли;					
					ЗначениеПустогоКоличества = ?(Номенклатура.Услуга, 1, 0);
					ПересчитатьСумму(НоваяСтрока, Отгрузка.СуммаВключаетНДС, ЗначениеПустогоКоличества);
				ИначеЕсли ТипКонфигурации = "УТ" Тогда
					Если НайденныеСтроки.Количество() > 0 Тогда
						тзнТоваровАрх.Удалить(НайденныеСтроки[0]);
					КонецЕсли;
					МодульОбработкиТЧ = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиКлиентСервер");
					СтруктураДействий = Новый Структура;					
					СтруктураПересчетаСуммы = МодульОбработкиТЧ.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Отгрузка);
					СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
					СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
					СтруктураДействий.Вставить("ПересчитатьСумму");
					СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
					СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
				КонецЕсли;
				
			КонецЦикла;      
			
		КонецЕсли;
		
		#КонецОбласти
		
		Если ТипКонфигурации = "УТ" Тогда
			#Область ЗаполнениеДоставки	
			Если СтоимостьДоставки <> Неопределено И СтоимостьДоставки > 0 Тогда
				
				НоменклатураДоставки = СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.НоменклатураДоставка;
				СтавкаНДС 			 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураДоставки, "СтавкаНДС");
				
				НоваяЗаписьТовара = Отгрузка.Товары.Добавить();
				#Область ЗаполнениеСтрокиСтарымиДанными	
				НайденныеСтроки = тзнТоваровАрх.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", НоменклатураДоставки, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка()));
				Если НайденныеСтроки.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(НоваяЗаписьТовара, НайденныеСтроки[0]);
					тзнТоваровАрх.Удалить(НайденныеСтроки[0]);
				КонецЕсли;
				#КонецОбласти	
				НоваяЗаписьТовара.КлючСвязи = 9999;
				НоваяЗаписьТовара.КодСтроки = 9999;
				НоваяЗаписьТовара.ЗаказКлиента 		= ОснованиеСсылка;
				НоваяЗаписьТовара.ОбъектРасчетов    = ЗначенияРеквизитовОснования.ОбъектРасчетов;
				НоваяЗаписьТовара.Номенклатура 		= НоменклатураДоставки;				
				НоваяЗаписьТовара.Упаковка			= НоменклатураДоставки.ЕдиницаИзмерения;
				НоваяЗаписьТовара.СтавкаНДС  		= НоменклатураДоставки.СтавкаНДС;				
				НоваяЗаписьТовара.Склад		 		= ?(ЗначениеЗаполнено(НоваяЗаписьТовара.Склад), НоваяЗаписьТовара.Склад, Отгрузка.Склад);				
				НоваяЗаписьТовара.Количество  			= 1;
				НоваяЗаписьТовара.КоличествоУпаковок  	= 1;				
				НоваяЗаписьТовара.Цена					= СтоимостьДоставки;				
				НоваяЗаписьТовара.ПроцентАвтоматическойСкидки 	= 0;
				НоваяЗаписьТовара.СуммаАвтоматическойСкидки		= 0;				
				НоваяЗаписьТовара.ПроцентРучнойСкидки 	= 0;
				НоваяЗаписьТовара.ПроцентРучнойСкидки 	= 0;
				
				СтруктураДействий = Новый Структура;
				МодульОбработкиТЧ = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиКлиентСервер");
				СтруктураПересчетаСуммы = МодульОбработкиТЧ.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Отгрузка);
				СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
				СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
				СтруктураДействий.Вставить("ПересчитатьСумму");
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
				МодульОбработкиТЧВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ПакетнаяОбработкаТабличнойЧастиВызовСервера");
				МодульОбработкиТЧВызовСервера.ОбработатьСтрокуТЧ(НоваяЗаписьТовара, СтруктураДействий, Неопределено);
				
			КонецЕсли;
			#КонецОбласти	
			
			#Область ЗаполнениеГрафикаОплаты
			Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ФункциональнаяОпцияВключена("ИспользоватьГрафикиОплаты") Тогда
				
				Отгрузка.ЭтапыГрафикаОплаты.Очистить();
				ЭтапыГрафикаОплаты = ЗначенияРеквизитовОснования.ЭтапыГрафикаОплаты.Выгрузить();
				Для каждого ТекЭтапыГрафика Из ЭтапыГрафикаОплаты Цикл
					НовыйЭтапГрафикаОплаты = Отгрузка.ЭтапыГрафикаОплаты.Добавить();
					НовыйЭтапГрафикаОплаты.Заказ 				= ОснованиеСсылка;
					НовыйЭтапГрафикаОплаты.ОбъектРасчетов 		= ЗначенияРеквизитовОснования.ОбъектРасчетов;
					НовыйЭтапГрафикаОплаты.ВариантОтсчета 		= ТекЭтапыГрафика.ВариантОтсчета;
					НовыйЭтапГрафикаОплаты.ВариантОплаты 		= ТекЭтапыГрафика.ВариантОплаты;
					НовыйЭтапГрафикаОплаты.ДатаПлатежа 			= ТекЭтапыГрафика.ДатаПлатежа; 	
					НовыйЭтапГрафикаОплаты.Сдвиг 				= ТекЭтапыГрафика.Сдвиг;
					НовыйЭтапГрафикаОплаты.ПроцентПлатежа 		= ТекЭтапыГрафика.ПроцентПлатежа;
					НовыйЭтапГрафикаОплаты.ПроцентЗалогаЗаТару 	= ТекЭтапыГрафика.ПроцентЗалогаЗаТару;
					НовыйЭтапГрафикаОплаты.СуммаПлатежа 		= ТекЭтапыГрафика.СуммаПлатежа;
					НовыйЭтапГрафикаОплаты.СуммаВзаиморасчетов 	= ТекЭтапыГрафика.СуммаПлатежа;
				КонецЦикла;
				
			КонецЕсли;
			#КонецОбласти	
			
			Отгрузка.СуммаДокумента = Отгрузка.Товары.Итог("Сумма");	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АлгоритмПриЗагрузке) Тогда
			
			ОтказНаЗапись = ВыполнитьАлгоритмПередЗагрузкой(СтруктураНастроек, Отгрузка, ТекЭлемент, АлгоритмПриЗагрузке);  
			Если ОтказНаЗапись Тогда
				Продолжить;	
			КонецЕсли; 
			
		КонецЕсли;
		
		Если ЭтоНоваяОтгрузка И НЕ ЗначениеЗаполнено(Отгрузка.Номер) Тогда
			
			НастройкиОперации = СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок;	
			Если НастройкиОперации.ИсточникНомераДокумента = "По данным с Битрикс24" Тогда
				
				НомерОтгрузкиБ24 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Строка"), Формат(ТекЭлемент.Получить("accountNumber"),"ЧГ=0"));
				НомерОтгрузкиБ24	= ?(ЗначениеЗаполнено(НомерОтгрузкиБ24), НомерОтгрузкиБ24, ИдБитрикс24);
				
				Отгрузка.Номер = НомерОтгрузкиБ24;
				
			Иначе  			
				Отгрузка.УстановитьНовыйНомер();  			
			КонецЕсли;	
			
		КонецЕсли;
		
		#Область ПроведениеДокумента
		Отгрузка.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
		
		Если (РежимЗаписи = "Проводить отгруженные" И Отгружен)
			ИЛИ (РежимЗаписи = "Проводить" И НЕ Отменен) Тогда
			
			Попытка
				Отгрузка.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Проведен документ: " + Строка(Отгрузка), Отгрузка.Ссылка);
			Исключение
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время проведения документа: " + Строка(Отгрузка) + " возникли ошибки.", Отгрузка.Ссылка);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЕстьКритическиеОшибки = Истина;
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Попытка записи документа: " + Строка(Отгрузка), Отгрузка.Ссылка);
				
				Попытка
					Отгрузка.Записать(РежимЗаписиДокумента.Запись);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан документ: " + Строка(Отгрузка), Отгрузка.Ссылка);
				Исключение
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Отгрузка) + " возникли ошибки.", Отгрузка.Ссылка);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
					СтруктураНастроек.ВыполненоБезОшибок = Ложь;
					
				КонецПопытки;
				
			КонецПопытки;
			
		Иначе
			Попытка
				Если ЭтоНоваяОтгрузка ИЛИ НЕ Отгрузка.Проведен Тогда
					Отгрузка.Записать(РежимЗаписиДокумента.Запись); 
				Иначе
					Отгрузка.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
				КонецЕсли;
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Записан: " + Строка(Отгрузка), Отгрузка.Ссылка);
			Исключение
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Во время записи документа: " + Строка(Отгрузка) + " возникли ошибки.", Отгрузка.Ссылка);
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ЕстьКритическиеОшибки = Истина;
				
				СтруктураНастроек.ВыполненоБезОшибок = Ложь;
				
			КонецПопытки;
		КонецЕсли;
		
		Результат.Добавить((СформироватьПростуюСтруктуруСИд(ИдБитрикс24, НЕ ЕстьКритическиеОшибки)));
		#КонецОбласти		 
		
		Если ЗначениеЗаполнено(Отгрузка.Ссылка) Тогда
			
			РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.Отгрузка, Отгрузка.Ссылка, ИдБитрикс24, ИдЗаказа);
			
			Если ТипКонфигурации = "БП" Тогда
				
				#Область ДобавлениеСведенийДокумента		
				
				ТаблицаПредСвойств = Новый ТаблицаЗначений;
				ТаблицаПредСвойств.Колонки.Добавить("Свойство");
				ТаблицаПредСвойств.Колонки.Добавить("ЗначениеСвойства");
				
				НовСтрока = ТаблицаПредСвойств.Добавить();
				НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомераОтгрузкиБитрикс24; 
				НовСтрока.ЗначениеСвойства 	= ИдБитрикс24; 
				НовСтрока = ТаблицаПредСвойств.Добавить();
				НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДатыОтгрузкиБитрикс24; 
				НовСтрока.ЗначениеСвойства 	= ДатаНачала; 
				НовСтрока = ТаблицаПредСвойств.Добавить();
				НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоТрекНомераОтгрузкиБитрикс24; 
				НовСтрока.ЗначениеСвойства 	= ТрекНомер; 
				НовСтрока = ТаблицаПредСвойств.Добавить();
				НовСтрока.Свойство 			= СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоДоставкаРазрешенаОтгрузкиБитрикс24; 
				НовСтрока.ЗначениеСвойства 	= ДоставкаРазрешена; 
				
				#Область ЗаполнениеСтатуса
				Если ИнформацияОСтатусах <> Неопределено И ТипЗнч(тзнСтатусов) = Тип("ТаблицаЗначений") Тогда
					
					Если ИнформацияОСтатусах.ИсточникСтатусовОтгрузок = "СвойствоОтгрузок" Тогда
						Если ЗначениеЗаполнено(ИнформацияОСтатусах.СвойствоОтгрузки) Тогда
							ЗначениеСвойства = Неопределено;
							
							НайденнаяСтрока = тзнСтатусов.Найти(ИдСтатуса, "ИдСтатуса");
							Если НайденнаяСтрока <> Неопределено Тогда
								ЗначениеСвойства = НайденнаяСтрока["Статус"];	
							КонецЕсли;
							
							НовСтрока = ТаблицаПредСвойств.Добавить();
							НовСтрока.Свойство 			= ИнформацияОСтатусах.СвойствоОтгрузки; 
							НовСтрока.ЗначениеСвойства 	= ЗначениеСвойства; 
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				#КонецОбласти	
				
				#Область ДобавлениеДополнительногоСведенияДоставки
				
				ИнформацияОДоставках = Неопределено;
				Если СтруктураНастроек.НастройкиСинхронизацииЗаказов.Свойство("ИнформацияОДоставках") Тогда	
					ИнформацияОДоставках = СтруктураНастроек.НастройкиСинхронизацииЗаказов.ИнформацияОДоставках;
				КонецЕсли;                                                        
				
				Если ИнформацияОДоставках <>Неопределено Тогда
					
					Если ИнформацияОДоставках.ИсточникСлужбДоставкиОтгрузок = "СвойствоОтгрузок" Тогда
						Если ЗначениеЗаполнено(ИнформацияОДоставках.СвойствоОтгрузки) Тогда
							тзнДоставок = ИнформацияОДоставках.СоответствияСЗначениямиСвойствОтгрузки;
							
							ЗначениеСвойства = Неопределено;
							
							НайденнаяСтрока = тзнДоставок.Найти(ИдДоставки, "ИдСлужбы");
							Если НайденнаяСтрока <> Неопределено Тогда
								ЗначениеСвойства = НайденнаяСтрока.Служба;	
							КонецЕсли;
							
							НовСтрока = ТаблицаПредСвойств.Добавить();
							НовСтрока.Свойство 			= ИнформацияОДоставках.СвойствоОтгрузки; 
							НовСтрока.ЗначениеСвойства 	= ЗначениеСвойства; 
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				#КонецОбласти	
				
				НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Объект.Установить(Отгрузка.Ссылка);
				НаборЗаписей.Прочитать();
				
				Для Каждого ТекСвойство Из ТаблицаПредСвойств Цикл
					
					ЕстьСвойство = Ложь;
					
					Для Каждого ТекСтрока Из НаборЗаписей Цикл
						Если ТекСтрока.Свойство = ТекСвойство.Свойство Тогда
							ЕстьСвойство = Истина;
							ТекСтрока.Значение = ТекСвойство.ЗначениеСвойства;	
						КонецЕсли;
					КонецЦикла;
					
					Если ЕстьСвойство = Ложь Тогда
						НоваяЗапись = НаборЗаписей.Добавить();
						НоваяЗапись.Объект = Отгрузка.Ссылка;
						НоваяЗапись.Свойство = ТекСвойство.Свойство;
						НоваяЗапись.Значение = ТекСвойство.ЗначениеСвойства;
					КонецЕсли;
				КонецЦикла;
				
				НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
				НаборЗаписей.Записать();
				
				#КонецОбласти		
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	пСтруктураНастроек.Логирование.НомерСообщения = СтруктураНастроек.Логирование.НомерСообщения; 	
	
	Возврат Результат;   
	
КонецФункции

Процедура ПересчитатьСумму(Строка, СуммаВключаетНДС = Ложь, ЗначениеПустогоКоличества = 0) Экспорт
    //Только для БП
	Строка.Сумма = Строка.Цена * ?(Строка.Количество =0, ЗначениеПустогоКоличества, Строка.Количество);
	
	ПересчитатьСуммуНДС(Строка, СуммаВключаетНДС);

КонецПроцедуры

Процедура ПересчитатьСуммуНДС(Строка, СуммаВключаетНДС) Экспорт
	//Только для БП
	ПрименяютсяСтавки4и2 = Ложь;
	МодульУчетНДСКлиентСервер = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("УчетНДСКлиентСервер");
	МодульУчетНДСВызовСервераПовтИсп = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("УчетНДСВызовСервераПовтИсп");
	Сумма = Строка.Сумма;
	Строка.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(Сумма, СуммаВключаетНДС, МодульУчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Строка.СтавкаНДС, ПрименяютсяСтавки4и2));

КонецПроцедуры

Процедура ВременнаяПроцедура_ДополнитьНастройкиСделкиСуммами(НастройкаПодключения)
	
	СохраненныеНастройкиСинхронизации = РегистрыСведений.Б24_КС_НастройкиСинхронизации.ПолучитьНастройкуСинхронизацииПоНастройкеПодключения(НастройкаПодключения);

	Настройки = СохраненныеНастройкиСинхронизации.Настройки.Получить();	 
	
	//МассивАлгоритмовЗагрузкиТЧ = РегистрыСведений.Б24_КС_НастройкиСинхронизации.ПолучитьМассивПредопределенныхАлгоритмовЗагрузкиТЧ("Сделка","ЗаказКлиента");
	
	БылиИзменения = Ложь;
	
	Для Каждого Настройка из Настройки.СоответствияПолейСущностейТабЧастейДляЗагрузкиВ1С Цикл
		Если Настройка.ИмяОбъекта = "ЗаказКлиента" и (Настройка.Значение = "" или Настройка.Значение = Неопределено) Тогда
			БылиИзменения = Истина;
			Если Настройка.Реквизит1С = "СуммаРучнойСкидки" Тогда
				Настройка.ИсточникДанных = "Предопределенный алгоритм";
				Настройка.Значение = "Сумма ручной скидки";
			ИначеЕсли Настройка.Реквизит1С = "Сумма" Тогда
				Настройка.ИсточникДанных = "Предопределенный алгоритм";
				Настройка.Значение = "Сумма";
			ИначеЕсли Настройка.Реквизит1С = "СуммаНДС" Тогда
				Настройка.ИсточникДанных = "Предопределенный алгоритм";
				Настройка.Значение = "Сумма НДС";
			ИначеЕсли Настройка.Реквизит1С = "СуммаСНДС" Тогда
				Настройка.ИсточникДанных = "Предопределенный алгоритм";
				Настройка.Значение = "Сумма с НДС";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если БылиИзменения Тогда
		Выборка = РегистрыСведений.Б24_КС_НастройкиСинхронизации.Выбрать(Новый Структура("НастройкаПодключения", НастройкаПодключения));
		Пока Выборка.Следующий() Цикл
			ТекСохраненныеНастройки = Выборка.ПолучитьМенеджерЗаписи();
			ТекСохраненныеНастройки.Настройки = Новый ХранилищеЗначения(Настройки); 
			ТекСохраненныеНастройки.Записать();	
		КонецЦикла;
		
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


