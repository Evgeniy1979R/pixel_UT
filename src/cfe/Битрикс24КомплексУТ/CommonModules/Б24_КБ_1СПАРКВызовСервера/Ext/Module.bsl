
#Область ОбщиеФункцииИПроцедуры

Процедура ПроверитьДобавитьРасписаниеСПАРК(Использование) Экспорт
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаИспользуемыхРеглЗаданий 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();	
	СтруктураРеглЗаданий 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеРеглЗадания();	
	
УстановитьПривилегированныйРежим(Истина);	 //Для возможности пользователям 1С добавить расписание СПАРК			
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИменаИспользуемыхРеглЗаданий.СПАРК);		
	Если ОбщегоНазначения.РазделениеВключено() Тогда		
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);			
	КонецЕсли;	
	
	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);	
	
	Если НайденныеРеглЗадания.Количество() = 0 Тогда
			
		ПараметрыЗапуска = Новый Массив();
		ПараметрыЗапуска.Добавить(СтруктураРеглЗаданий.СПАРК);
		ПараметрыЗапуска.Добавить(Неопределено);
		
		Расписание = Новый РасписаниеРегламентногоЗадания;			
		Расписание.ПериодПовтораВТечениеДня 	= 86400;         // раз в сутки выгрузка расписания
		Расписание.ПериодПовтораДней 			= 1;	  
		
		ПараметрыЗадания = Новый Структура();
		ПараметрыЗадания.Вставить("Метаданные"					, Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
		ПараметрыЗадания.Вставить("Наименование"				, ИменаИспользуемыхРеглЗаданий.СПАРК);
		ПараметрыЗадания.Вставить("Ключ"						, ИменаИспользуемыхРеглЗаданий.СПАРК);
		ПараметрыЗадания.Вставить("Использование"				, Использование);
		ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение"		, Ложь);
		ПараметрыЗадания.Вставить("Параметры"					, ПараметрыЗапуска);
		ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
		ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);
		
		ПараметрыЗадания.Вставить("Расписание", Расписание);
		РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
	Иначе
		
		НайденноеРеглЗадание = НайденныеРеглЗадания[0];
	
		ПараметрыИзмененияЗадания = Новый Структура();
		ПараметрыИзмененияЗадания.Вставить("Использование"	, Использование);
		
		РегламентныеЗаданияСервер.ИзменитьЗадание(НайденноеРеглЗадание.УникальныйИдентификатор, ПараметрыИзмененияЗадания);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПересоздатьПолеСПАРК(НастройкаПодключения = Неопределено) Экспорт
	
	мМетоды = Новый Массив;
	мМетоды.Добавить("company");
	мМетоды.Добавить("contact");
	
	Если НастройкаПодключения = Неопределено Тогда
		мНастройки = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьМассивНастроекИнтеграцийСервисов();
	Иначе
		мНастройки = Новый Массив;
		мНастройки.Добавить(НастройкаПодключения);
	КонецЕсли;
	
	
	Для каждого ТекНастройка Из мНастройки Цикл
		
		СтруктураНастроек =  Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(ТекНастройка);  
		Если СтруктураНастроек = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ТекТип Из мМетоды Цикл
			
			Фильтр = "&start=-1&filter[XML_ID]=spark1c";
			СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm."+ТекТип+".userfield.list", Фильтр); 
			
			Если СтруктураОтвета = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			result = СтруктураОтвета.Получить("result");
			Если result <> Неопределено Тогда
				Если result.Количество() > 0 Тогда
					
					ИдПоля = Формат(result[0].Получить("ID"), "ЧГ=0");
					
					ТелоЗапроса = "&id="+ИдПоля;
					СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm."+ТекТип+".userfield.delete", ТелоЗапроса); 
					
				КонецЕсли;
			КонецЕсли;
		
		КонецЦикла;
		
		НаборЗаписей = РегистрыСведений.Б24_КБ_ДатаВыгрузкиИндексовСПАРК.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Портал.Установить(ТекНастройка.Портал);	
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры


Функция ПолучитьИдентификаторСвойстваСПАРКБитрикс24(НастройкаПодключения, ТипРеквизита)
	
	Результат = "";
	
	СтруктураНастроек =  Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	АдресДоПриложения 		= Б24_К_RestApiВызовСервера.ПолучитьАдресДоПриложенияБитрикс24() + "?spark1c";
	ИдПользовательскогоТипа = "spark1c";
	
	
	Если ТипРеквизита = "4" Тогда
		МетодСписка 	= "/rest/crm.company.userfield.list";
		МетодСоздания 	= "/rest/crm.company.userfield.add";
		
		МетодЧтенияЭлементовКарточки 	= "/rest/crm.company.details.configuration.get";
		МетодЗаписиЭлементовКарточки 	= "/rest/crm.company.details.configuration.set";
	ИначеЕсли ТипРеквизита = "3" Тогда
		МетодСписка 	= "/rest/crm.contact.userfield.list";
		МетодСоздания 	= "/rest/crm.contact.userfield.add";
		
		МетодЧтенияЭлементовКарточки 	= "/rest/crm.contact.details.configuration.get";
		МетодЗаписиЭлементовКарточки 	= "/rest/crm.contact.details.configuration.set";
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	
	Фильтр = "&filter[XML_ID]=spark1c";
	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, МетодСписка, Фильтр); 
		
	Если СтруктураОтвета = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
		
	result = СтруктураОтвета.Получить("result");
	Если result <> Неопределено Тогда
		Если result.Количество() > 0 Тогда
			Результат = result[0].Получить("FIELD_NAME");
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Результат = "" Тогда
		Возврат Результат;
	Иначе
		
		
		Метод = "/rest/userfieldtype.list";
		ЕстьПользовательскийТип = Ложь;
		
		Фильтр = "&start=-1&filter[USER_TYPE_ID]="+ИдПользовательскогоТипа;
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, Фильтр); 
				
		Если СтруктураОтвета = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
				
		result = СтруктураОтвета.Получить("result");
		Если result <> Неопределено Тогда
					
			Для каждого ТекЭлемент Из result Цикл
				Если ТекЭлемент.Получить("USER_TYPE_ID") = ИдПользовательскогоТипа Тогда
					ЕстьПользовательскийТип = Истина;
				КонецЕсли;
			КонецЦикла;
				
		КонецЕсли;
				
		Если НЕ ЕстьПользовательскийТип Тогда
				
			Метод = "/rest/userfieldtype.add";
				
			ТелоЗапроса = "&USER_TYPE_ID=spark1c&HANDLER="+АдресДоПриложения+"&TITLE=СПАРК 1С";
			СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоЗапроса); 
				
			Если СтруктураОтвета = Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
				
		КонецЕсли;
			
		ТелоЗапроса = "&fields[XML_ID]=spark1c";
		ТелоЗапроса = ТелоЗапроса + "&fields[USER_TYPE_ID]="+ИдПользовательскогоТипа;
		ТелоЗапроса = ТелоЗапроса + "&fields[FIELD_NAME]=UF_CRM_" + Прав(Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(),"ЧГ=0"),13);
			
		НаименованиеСвойства = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("1СПАРК риски");
		ТелоЗапроса = ТелоЗапроса + "&fields[EDIT_FORM_LABEL]="+НаименованиеСвойства;
		ТелоЗапроса = ТелоЗапроса + "&fields[LIST_COLUMN_LABEL]="+НаименованиеСвойства;
		ТелоЗапроса = ТелоЗапроса + "&fields[MANDATORY]=N";
		ТелоЗапроса = ТелоЗапроса + "&fields[MULTIPLE]=N";
			
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, МетодСоздания, ТелоЗапроса); 
			
			
		Фильтр = "&filter[XML_ID]=spark1c";
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, МетодСписка, Фильтр); 
			
		Если СтруктураОтвета = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
			
		result = СтруктураОтвета.Получить("result");
		Если result <> Неопределено Тогда
			Если result.Количество() > 0 Тогда
				Результат  = result[0].Получить("FIELD_NAME");
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат) Тогда
			Б24_К_RestApiВызовСервера.ДобавитьЭлементВШаблонКарточки(СтруктураНастроек, МетодЧтенияЭлементовКарточки, МетодЗаписиЭлементовКарточки, Результат);
		КонецЕсли;
	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область СПАРКИндексы

Процедура ОбновитьИнформациюСПАРК(НастройкаПодключения = Неопределено) Экспорт
	
	Если НастройкаПодключения = Неопределено Тогда
		мНастройки = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьМассивНастроекИнтеграцийСервисов();
	Иначе
		мНастройки = Новый Массив;
		мНастройки.Добавить(НастройкаПодключения);
	КонецЕсли;
	
	
	Для каждого ТекНастройка Из мНастройки Цикл
		
		Если НЕ Б24_К_СлужебныйВызовСервера.МодульСПАРКДоступен(ТекНастройка) Тогда
			Продолжить;	
		КонецЕсли;
		
		ПериодичностьОбновленияИндексаКлиента 	= РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьСохраненнуюНастройкуИнтеграцииСервисовПоНастройкеПодключения(ТекНастройка, "ПериодичностьОбновленияИндексаКлиента", 14);		
		ТочкаАктуальностиВыгрузки 				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса() - ПериодичностьОбновленияИндексаКлиента*60*60*24;
		
		ОбластьДанныхЛокальная = -1;
		Если ОбщегоНазначения.РазделениеВключено() Тогда
			ОбластьДанныхЛокальная = ИнтернетПоддержкаПользователей.ЗначениеРазделителяСеанса();
		КонецЕсли;
		
		
		ДанныеРеквизитов 	= ПолучитьИнформациюОРеквизитахБитрикс24(ТекНастройка);
		мвтДанныхДляСПАРК 	= ПолучитьМенеджерВременныхТаблицСДаннымиДляСПАРК(ТочкаАктуальностиВыгрузки, ТекНастройка.Портал, ДанныеРеквизитов);
		
		мТипыРеквизитов = Новый Массив;
		мТипыРеквизитов.Добавить("4");   //компании
		мТипыРеквизитов.Добавить("3");
		
		Для каждого ТекТипРеквизита Из мТипыРеквизитов Цикл
			
			тзнСтрокДанных 	= Новый ТаблицаЗначений;
			тзнСтрокДанных.Колонки.Добавить("Наименование");
			тзнСтрокДанных.Колонки.Добавить("ИдЭлемента");
			тзнСтрокДанных.Колонки.Добавить("ИдВладельца");
			тзнСтрокДанных.Колонки.Добавить("ИНН");
			тзнСтрокДанных.Колонки.Добавить("КПП");
			тзнСтрокДанных.Колонки.Добавить("ДанныеСпарк", Новый ОписаниеТипов("Массив"));
			
			тзнСтрокДанных.Индексы.Добавить("ИНН");
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = мвтДанныхДляСПАРК;
			Запрос.УстановитьПараметр("ТипРеквизита", ТекТипРеквизита); 
			Запрос.Текст = "ВЫБРАТЬ
			|	ВТ_Данные.ИдВладельца КАК ИдВладельца,
			|	ВТ_Данные.ТипРеквизита КАК ТипРеквизита
			|ПОМЕСТИТЬ ВТ_НужноВыгружать
			|ИЗ
			|	ВТ_Данные КАК ВТ_Данные
			|ГДЕ
			|	ВТ_Данные.ТипРеквизита = &ТипРеквизита
			|	И ВТ_Данные.НадоВыгружать = ИСТИНА
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_Данные.ИдВладельца,
			|	ВТ_Данные.ТипРеквизита
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ИдВладельца
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Данные.Наименование КАК Наименование,
			|	ВТ_Данные.ИдЭлемента КАК ИдЭлемента,
			|	ВТ_Данные.ИдВладельца КАК ИдВладельца,
			|	ВТ_Данные.ИНН КАК ИНН,
			|	ВТ_Данные.КПП КАК КПП
			|ИЗ
			|	ВТ_Данные КАК ВТ_Данные
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НужноВыгружать КАК ВТ_НужноВыгружать
			|		ПО ВТ_Данные.ИдВладельца = ВТ_НужноВыгружать.ИдВладельца
			|			И ВТ_Данные.ТипРеквизита = ВТ_НужноВыгружать.ТипРеквизита
			|ГДЕ
			|	ВТ_Данные.ТипРеквизита = &ТипРеквизита
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ВТ_НужноВыгружать";
			ВыполненныйЗапрос = Запрос.Выполнить();
			Если НЕ ВыполненныйЗапрос.Пустой() Тогда
				
				МассивОписанийКонтрагентов 	= Новый Массив;
				
				Итератор = 0; 				
				ВыборкаДанных = ВыполненныйЗапрос.Выбрать();
				Пока ВыборкаДанных.Следующий() Цикл
					Итератор = Итератор + 1;
					
					НоваяСтрокаДанных = тзнСтрокДанных.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаДанных, ВыборкаДанных); 
					
					ОписаниеКонтрагента = СПАРКРиски.НовыйОписаниеКонтрагента();
					ОписаниеКонтрагента.ОбластьДанных 	= ОбластьДанныхЛокальная;
					ОписаниеКонтрагента.Контрагент 		= Неопределено;
					ОписаниеКонтрагента.ИНН 			= СокрЛП(ВыборкаДанных.ИНН); 
					ОписаниеКонтрагента.ВидКонтрагента  = ?(СтрДлина(ВыборкаДанных.ИНН) = 10, Перечисления.ВидыКонтрагентовСПАРКРиски.ЮридическоеЛицо, Перечисления.ВидыКонтрагентовСПАРКРиски.ИндивидуальныйПредприниматель);
					МассивОписанийКонтрагентов.Добавить(ОписаниеКонтрагента);
					
					Если Итератор = 50 Тогда
						Итератор = 0;
						РезультатСПАРК = СПАРКРискиСервис.ЗагрузитьИндексыКонтрагентов(ОбластьДанныхЛокальная, МассивОписанийКонтрагентов); 	
						
						Для каждого ТекСтрока Из РезультатСПАРК.ЗначенияИндексов Цикл
							НайденнаяСтрока = тзнСтрокДанных.Найти(ТекСтрока.ИНН, "ИНН");
							Если НайденнаяСтрока <> Неопределено Тогда
								
								НайденнаяСтрока.ДанныеСпарк.Добавить(ТекСтрока);	
								
							КонецЕсли;
						КонецЦикла;
						
						МассивОписанийКонтрагентов 	= Новый Массив;
					КонецЕсли;
				КонецЦикла;
				
				Если МассивОписанийКонтрагентов.Количество()> 0 Тогда
					
					РезультатСПАРК = СПАРКРискиСервис.ЗагрузитьИндексыКонтрагентов(ОбластьДанныхЛокальная, МассивОписанийКонтрагентов); 	
					
					Для каждого ТекСтрока Из РезультатСПАРК.ЗначенияИндексов Цикл
						НайденнаяСтрока = тзнСтрокДанных.Найти(ТекСтрока.ИНН, "ИНН");
						Если НайденнаяСтрока <> Неопределено Тогда
							
							НайденнаяСтрока.ДанныеСпарк.Добавить(ТекСтрока);	
							
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
			тзнСтрокДанных.Индексы.Очистить();
			тзнСтрокДанных.Индексы.Добавить("ИдВладельца");
			
			ТаблицаВладельцев = тзнСтрокДанных.Скопировать();
			ТаблицаВладельцев.Свернуть("ИдВладельца");
			ТаблицаВладельцев.Колонки.Добавить("ИнформацияСПАРК", Новый ОписаниеТипов("Массив"));
			
			Для каждого ТекВладелец Из ТаблицаВладельцев Цикл             // группируем по владельцам
				
				НайденныеСтроки = тзнСтрокДанных.НайтиСтроки(Новый Структура("ИдВладельца", ТекВладелец.ИдВладельца));
				
				Для каждого ТекДанныеСПАРК Из НайденныеСтроки Цикл
					Для каждого ТекИнфСПАРК Из ТекДанныеСПАРК.ДанныеСпарк Цикл
						
						стрИнформацияСПАРК = Новый Структура;
						стрИнформацияСПАРК.Вставить("active"					, XMLСтрока(ТекИнфСПАРК.Активен)); 
						стрИнформацияСПАРК.Вставить("typeError"					, Строка(ТекИнфСПАРК.ВидОшибки)); 
						стрИнформацияСПАРК.Вставить("statusDate"				, XMLСтрока(ТекИнфСПАРК.ДатаСтатуса)); 
						стрИнформацияСПАРК.Вставить("INN"						, XMLСтрока(ТекИнфСПАРК.ИНН)); 
						стрИнформацияСПАРК.Вставить("indexDueDiligence"			, XMLСтрока(ТекИнфСПАРК.ИндексДолжнойОсмотрительности)); 
						стрИнформацияСПАРК.Вставить("indexPaymentDiscipline"	, XMLСтрока(ТекИнфСПАРК.ИндексПлатежнойДисциплины)); 
						стрИнформацияСПАРК.Вставить("indexFinancialRisk"		, XMLСтрока(ТекИнфСПАРК.ИндексФинансовогоРиска)); 
						стрИнформацияСПАРК.Вставить("summaryIndicator"			, XMLСтрока(ТекИнфСПАРК.СводныйИндикатор)); 
						стрИнформацияСПАРК.Вставить("summaryIndicatorGraduation", Строка(ТекИнфСПАРК.СводныйИндикаторГрадация)); 
						стрИнформацияСПАРК.Вставить("id"						, ТекДанныеСПАРК.ИдЭлемента); 
						стрИнформацияСПАРК.Вставить("name"						, ТекДанныеСПАРК.Наименование); 
						стрИнформацияСПАРК.Вставить("idAdress"           		, ТекНастройка.ИдентификаторПодключения); 
						
						ТекВладелец.ИнформацияСПАРК.Добавить(стрИнформацияСПАРК);
						
					КонецЦикла;
				КонецЦикла;
				
			КонецЦикла;
			
			Если ТаблицаВладельцев.Количество() > 0 Тогда
				
				ИдентификаторСвойства = ПолучитьИдентификаторСвойстваСПАРКБитрикс24(ТекНастройка, ТекТипРеквизита);
				
				Если ЗначениеЗаполнено(ИдентификаторСвойства) Тогда
					
					Итератор = 0; 	
					мДанныеДляВыгрузки = Новый Массив;
					Для каждого ТекСтрока Из ТаблицаВладельцев Цикл
						Итератор = Итератор + 1;
						
						мДанныеДляВыгрузки.Добавить(ТекСтрока);
						
						Если Итератор = 50 Тогда
							
							ВыгрузитьИнформациюОСПАРК(ТекНастройка, мДанныеДляВыгрузки, ТекТипРеквизита, ИдентификаторСвойства);	
							
							Итератор = 0;
							мДанныеДляВыгрузки.Очистить();
						КонецЕсли;
						
					КонецЦикла;
					
					Если мДанныеДляВыгрузки.Количество()> 0 Тогда
						ВыгрузитьИнформациюОСПАРК(ТекНастройка, мДанныеДляВыгрузки, ТекТипРеквизита, ИдентификаторСвойства);	
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИнформациюОРеквизитахБитрикс24(НастройкаПодключения)
	
	КС = Новый КвалификаторыСтроки(100);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИдЭлемента"		, ОписаниеТиповС);
	Результат.Колонки.Добавить("ИдВладельца"	, ОписаниеТиповС);
	Результат.Колонки.Добавить("ТипРеквизита"	, ОписаниеТиповС);
	Результат.Колонки.Добавить("ИНН"			, ОписаниеТиповС);
	Результат.Колонки.Добавить("КПП"			, ОписаниеТиповС);
	Результат.Колонки.Добавить("Наименование"	, ОписаниеТиповС);
	
	
	СтруктураНастроек = Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	
	Если СтруктураНастроек = Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Не удалось подключиться к порталу для выгрузки индексов СПАРК"); 
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыHTTPЗапроса 	= "&select[]=ID&select[]=ENTITY_ID&select[]=ENTITY_TYPE_ID&select[]=RQ_INN&select[]=RQ_KPP&select[]=RQ_LAST_NAME&select[]=RQ_FIRST_NAME&select[]=RQ_SECOND_NAME&select[]=RQ_NAME&select[]=RQ_COMPANY_NAME&select[]=RQ_COMPANY_FULL_NAME";
	
	мЭлементов = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.requisite.list", "ID", ПараметрыHTTPЗапроса);
	ДобавитьИнформациюОРеквизитахБитрикс24ВМассив(мЭлементов, Результат);
	
	Возврат Результат;
	
КонецФункции

Процедура ВыгрузитьИнформациюОСПАРК(НастройкаПодключения, ДанныеДляВыгрузки, ТипРеквизита, ИдентификаторСвойства)
	
	Если ТипРеквизита = "3" Тогда
		Метод 	= "crm.contact.update";
	ИначеЕсли ТипРеквизита = "4" Тогда
		Метод 	= "crm.company.update";
	КонецЕсли;
	
	ТелоHTTPЗапроса= "";
	Для каждого ТекСтрока Из ДанныеДляВыгрузки Цикл
		
		СтрJSON = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ТекСтрока.ИнформацияСПАРК);
		
		ТелоЕдЗапроса = "?id="+ ТекСтрока.ИдВладельца+ "&fields["+ИдентификаторСвойства+"]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(СтрJSON);
		
		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + "cmd["+ТекСтрока.ИдВладельца+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Метод + ТелоЕдЗапроса)
		
	КонецЦикла;
	
	СтруктураНастроек =  Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек <> Неопределено Тогда
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса); 
		Если СтруктураОтвета = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		result = СтруктураОтвета.Получить("result");
		Если result = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		result2 = result.Получить("result");
		Если result2 = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДатаВыгрузки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
		Для каждого ТекИндекс Из result2 Цикл
			
			Если ТипЗнч(ТекИндекс) = Тип("КлючИЗначение") Тогда
			
				Если ТекИндекс.Значение = Истина Тогда
					
					Для каждого ТекСтрока Из ДанныеДляВыгрузки Цикл
					
						Если ТекСтрока.ИдВладельца = ТекИндекс.Ключ  Тогда
							
							Для каждого ТекИнформацияСПАРК Из ТекСтрока.ИнформацияСПАРК Цикл
							
								НоваяЗапись = РегистрыСведений.Б24_КБ_ДатаВыгрузкиИндексовСПАРК.СоздатьМенеджерЗаписи();
								НоваяЗапись.Портал 			= СтруктураНастроек.Портал; 
								НоваяЗапись.ИдРеквизита 	= ТекИнформацияСПАРК.id; 
								
								НоваяЗапись.ИНН 			= ТекИнформацияСПАРК.INN; 
								НоваяЗапись.ДатаВыгрузки 	= ДатаВыгрузки; 
								
								НоваяЗапись.Записать(Истина);	
					
							КонецЦикла; 					
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьИнформациюОРеквизитахБитрикс24ВМассив(мЭлементов, тИнформацияОРеквизитах)
	
		Для каждого ТекЭлемент Из мЭлементов Цикл
			
			Фамилия 		= Строка(ТекЭлемент.Получить("RQ_LAST_NAME")); 
			Имя 			= Строка(ТекЭлемент.Получить("RQ_FIRST_NAME")); 
			Отчество 		= Строка(ТекЭлемент.Получить("RQ_SECOND_NAME")); 
			ФИО				= Фамилия + " " + Имя + " " + Отчество; 
			ИНН 			= Строка(ТекЭлемент.Получить("RQ_INN"));
			КПП 			= Строка(ТекЭлемент.Получить("RQ_KPP"));
			ИдЭлемента 		= Формат(ТекЭлемент.Получить("ID"),"ЧГ=0");
			ИдВладельца 	= Формат(ТекЭлемент.Получить("ENTITY_ID"),"ЧГ=0");
			ТипРеквизита	= Строка(ТекЭлемент.Получить("ENTITY_TYPE_ID"));
		
			Если ТипРеквизита = "3" Тогда     
				НаименованиеПолное		= ФИО;
				НаименованиеПолное		= ?(ЗначениеЗаполнено(НаименованиеПолное), НаименованиеПолное, Строка(ТекЭлемент.Получить("RQ_NAME")));		
			Иначе
				Наименование 		= Строка(ТекЭлемент.Получить("RQ_COMPANY_NAME"));
				Наименование		= ?(ЗначениеЗаполнено(Наименование), Наименование, ФИО);
				
				НаименованиеПолное 	= Строка(ТекЭлемент.Получить("RQ_COMPANY_FULL_NAME"));
				НаименованиеПолное	= ?(ЗначениеЗаполнено(НаименованиеПолное), НаименованиеПолное, Наименование);
			КонецЕсли;
				
			Если ЗначениеЗаполнено(ИНН) И (ТипРеквизита = "3" ИЛИ ТипРеквизита = "4") Тогда
				
				Если СтрДлина(ИНН) = 10 ИЛИ  СтрДлина(ИНН) = 12 Тогда
					
					НоваяСтрока = тИнформацияОРеквизитах.Добавить();
					НоваяСтрока.Наименование	= НаименованиеПолное;
					НоваяСтрока.ИдЭлемента 		= ИдЭлемента;
					НоваяСтрока.ИдВладельца 	= ИдВладельца;
					НоваяСтрока.ТипРеквизита 	= ТипРеквизита;
					НоваяСтрока.ИНН 			= ИНН;
					НоваяСтрока.КПП 			= КПП;
					
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМенеджерВременныхТаблицСДаннымиДляСПАРК(ТочкаАктуальностиВыгрузки, Портал, ДанныеРеквизитов)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТочкаАктуальностиВыгрузки"	, ТочкаАктуальностиВыгрузки);
	Запрос.УстановитьПараметр("Портал"						, Портал);
	Запрос.УстановитьПараметр("ВнешниеДанные"				, ДанныеРеквизитов);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_КБ_ДатаВыгрузкиИндексовСПАРК.ИдРеквизита КАК ИдРеквизита,
	|	Б24_КБ_ДатаВыгрузкиИндексовСПАРК.ИНН КАК ИНН,
	|	Б24_КБ_ДатаВыгрузкиИндексовСПАРК.ДатаВыгрузки КАК ДатаВыгрузки
	|ПОМЕСТИТЬ ВТ_ДанныеСпаркИсключения
	|ИЗ
	|	РегистрСведений.Б24_КБ_ДатаВыгрузкиИндексовСПАРК КАК Б24_КБ_ДатаВыгрузкиИндексовСПАРК
	|ГДЕ
	|	Б24_КБ_ДатаВыгрузкиИндексовСПАРК.ДатаВыгрузки > &ТочкаАктуальностиВыгрузки
	|	И Б24_КБ_ДатаВыгрузкиИндексовСПАРК.Портал = &Портал
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдРеквизита,
	|	ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВнешниеДанные.Наименование КАК Наименование,
	|	ВнешниеДанные.ИдЭлемента КАК ИдЭлемента,
	|	ВнешниеДанные.ИдВладельца КАК ИдВладельца,
	|	ВнешниеДанные.ТипРеквизита КАК ТипРеквизита,
	|	ВнешниеДанные.ИНН КАК ИНН,
	|	ВнешниеДанные.КПП КАК КПП
	|ПОМЕСТИТЬ ВТ_ДанныеВнешние
	|ИЗ
	|	&ВнешниеДанные КАК ВнешниеДанные
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдЭлемента,
	|	ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеВнешние.Наименование КАК Наименование,
	|	ВТ_ДанныеВнешние.ИдЭлемента КАК ИдЭлемента,
	|	ВТ_ДанныеВнешние.ИдВладельца КАК ИдВладельца,
	|	ВТ_ДанныеВнешние.ТипРеквизита КАК ТипРеквизита,
	|	ВТ_ДанныеВнешние.ИНН КАК ИНН,
	|	ВТ_ДанныеВнешние.КПП КАК КПП,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеСпаркИсключения.ДатаВыгрузки ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НадоВыгружать
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	ВТ_ДанныеВнешние КАК ВТ_ДанныеВнешние
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеСпаркИсключения КАК ВТ_ДанныеСпаркИсключения
	|		ПО ВТ_ДанныеВнешние.ИдЭлемента = ВТ_ДанныеСпаркИсключения.ИдРеквизита
	|			И ВТ_ДанныеВнешние.ИНН = ВТ_ДанныеСпаркИсключения.ИНН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДанныеСпаркИсключения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ДанныеВнешние";
	Запрос.Выполнить();
	
	Возврат МенеджерВременныхТаблиц;
	
КонецФункции

#КонецОбласти


#Область СПАРКСправка

Процедура getSpark1c(ПередаваемыеПараметры, АдресРезультата) Экспорт
	
	Результат = Истина;
	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	//Портал 				= ПередаваемыеПараметры.Портал;
	ИдВладельца 			= ПередаваемыеПараметры.ИдВладельца;
	ТипВладельца 			= ПередаваемыеПараметры.ТипВладельца;
	ТипВладельца			= ?(ТипВладельца = "CRM_COMPANY", "4", ТипВладельца);
	ТипВладельца			= ?(ТипВладельца = "CRM_CONTACT", "3", ТипВладельца);
	ИдСессии 				= ПередаваемыеПараметры.ИдСессии;
	ИНН 					= ПередаваемыеПараметры.ИНН;
	
	
	ФормироватьСправки1СПАРКРиски = Ложь;
	ИспользоватьСервис1СПАРКРиски = Ложь;
	
	НайденнаяНастройка = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения); 
	Если ЗначениеЗаполнено(НайденнаяНастройка) Тогда
		
		ИспользоватьСервис1СПАРКРиски = НайденнаяНастройка.Сервис1СПАРКРиски;
		ФормироватьСправки1СПАРКРиски = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьСохраненнуюНастройкуИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения, "ФормироватьСправки1СПАРКРиски", Ложь)
		
	КонецЕсли;
	
	Если ФормироватьСправки1СПАРКРиски <> Истина ИЛИ ИспользоватьСервис1СПАРКРиски <> Истина Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
		
	
	СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	Если СтрДлина(ИНН) = 10 ИЛИ СтрДлина(ИНН) = 12 Тогда   
		ПолучитьСправкуСПАРК(ИНН, НастройкаПодключения, ИдВладельца, ТипВладельца);
	Иначе
		
		ОписаниеСообщения = "Некорректный ИНН:" + Строка(ИНН);
		ДобавитьКомментарийТаймЛайн(СтруктураНастроек, ИдВладельца, ТипВладельца, ОписаниеСообщения);
		
	КонецЕсли;
	
	Результат = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Истина);
	
	ТелоЗапроса = "&COMMAND=spark1cDone&MODULE_ID=1ctotal&PARAMS[session]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСессии)+"&PARAMS[RESULT]="+Результат;
	Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	
~КонецПроцедурыВФоне:	
	
	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);
	
КонецПроцедуры

Функция ПолучитьСправкуСПАРК(ИНН, НастройкаПодключения, ИдСущности, ТипСущности) 
	
	Результат = Неопределено;
	
	СписокИНН = Новый Массив;
	СписокИНН.Добавить(ИНН);
	
	Если СтрДлина(ИНН) = 10 Тогда
		РезультатВызоваОперации = СПАРКРискиСервис.НачатьПодготовкуСправокЮридическихЛиц(СписокИНН);
	ИначеЕсли СтрДлина(ИНН) = 12 Тогда
		РезультатВызоваОперации = СПАРКРискиСервис.НачатьПодготовкуСправокИндивидуальныхПредпринимателей(СписокИНН);
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Если Не РезультатВызоваОперации.ВидОшибки.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИдентификаторСправки = РезультатВызоваОперации.ИдентификаторыСправок[ИНН];
	Если ЗначениеЗаполнено(ИдентификаторСправки) Тогда
		
		НоваяСправка = Документы.СправкиСПАРКРиски.СоздатьДокумент();
		НоваяСправка.Дата = ТекущаяДатаСеанса();
		НоваяСправка.УстановитьНовыйНомер();
		
		НоваяСправка.Б24_КБ_ИдСущности 					= ИдСущности;
		НоваяСправка.Б24_КБ_ТипСущности 				= ТипСущности;
		НоваяСправка.Б24_КБ_НастройкаПодключения 		= НастройкаПодключения;
		
		НоваяСправка.ИНН 			= ИНН;
		НоваяСправка.Состояние 		= Перечисления.СостоянияСправкиСПАРКРиски.Готовится;
		НоваяСправка.Идентификатор 	= РезультатВызоваОперации.ИдентификаторыСправок[ИНН];
		
		НоваяСправка.Записать();
		
		Справка = НоваяСправка.Ссылка;
		
УстановитьПривилегированныйРежим(Истина);
		
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("Использование", Истина);
		ПараметрыЗадания.Вставить("Метаданные",
			Метаданные.РегламентныеЗадания.ПроверкаГотовностиСправкиСПАРКРиски);
		ПараметрыЗадания.Вставить("Ключ", Строка(НоваяСправка.Идентификатор));
		
		ПараметрыМетода = Новый Массив;
		ПараметрыМетода.Добавить(Справка);
		ПараметрыЗадания.Вставить("Параметры", ПараметрыМетода);
		
		РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьСправкуСПАРК(Справка, НастройкаПодключения, ИдСущности, ТипСущности, Состояние) Экспорт
	
	Если ЗначениеЗаполнено(НастройкаПодключения) И ЗначениеЗаполнено(ИдСущности) И ЗначениеЗаполнено(ТипСущности) Тогда
		
		СтруктураНастроек =  Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
		Если СтруктураНастроек = Неопределено Тогда
			Возврат;
		КонецЕсли;
				
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СправкиСПАРКРиски.Состояние КАК Состояние,
		|	СправкиСПАРКРиски.Идентификатор КАК ИдентификаторСправки,
		|	ЕСТЬNULL(СправкиСПАРКРискиПрисоединенныеФайлы.Ссылка, НЕОПРЕДЕЛЕНО) КАК ФайлСсылка,
		|	СправкиСПАРКРиски.ИНН
		|ИЗ
		|	Документ.СправкиСПАРКРиски КАК СправкиСПАРКРиски
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СправкиСПАРКРискиПрисоединенныеФайлы КАК СправкиСПАРКРискиПрисоединенныеФайлы
		|		ПО СправкиСПАРКРиски.Ссылка = СправкиСПАРКРискиПрисоединенныеФайлы.ВладелецФайла
		|ГДЕ
		|	СправкиСПАРКРиски.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Справка);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		РезультатВызоваОперации = Неопределено;
		Если Выборка.ФайлСсылка = Неопределено Тогда
			
			Если СтрДлина(Справка.ИНН) = 10 Тогда
				РезультатВызоваОперации = СПАРКРискиСервис.ЗагрузитьФайлСправкиЮридическихЛиц(Выборка.ИдентификаторСправки);
			ИначеЕсли СтрДлина(Справка.ИНН) = 12 Тогда
				РезультатВызоваОперации = СПАРКРискиСервис.ЗагрузитьФайлСправкиИндивидуальныхПредпринимателей(Выборка.ИдентификаторСправки);
			Иначе
				Возврат;
			КонецЕсли;
			
			Если РезультатВызоваОперации.ВидОшибки.Пустая() Тогда
				
				ПараметрыФайла = Новый Структура;
				ПараметрыФайла.Вставить("Автор"           , Пользователи.АвторизованныйПользователь());
				ПараметрыФайла.Вставить("ВладелецФайлов"  , Справка);
				ПараметрыФайла.Вставить("ИмяБезРасширения",
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Справка 1СПАРК Риски %1'"),
				Выборка.ИНН));
				ПараметрыФайла.Вставить("РасширениеБезТочки", "pdf");
				ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное",
				ТекущаяУниверсальнаяДата());
				
				РаботаСФайлами.ДобавитьФайл(
				ПараметрыФайла,
				ПоместитьВоВременноеХранилище(РезультатВызоваОперации.ФайлСправки));
			КонецЕсли;
			
		КонецЕсли;
		
		Если Состояние = Перечисления.СостоянияСправкиСПАРКРиски.Получена Тогда
			
			Если НЕ РезультатВызоваОперации = Неопределено Тогда
				ФайлСправки = РезультатВызоваОперации.ФайлСправки;
			ИначеЕсли ЗначениеЗаполнено(Выборка.ФайлСсылка) Тогда
				ФайлСправки = РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.ФайлСсылка);	
			Иначе
				Возврат;
			КонецЕсли;
			
			ВыгружаемыйФайл = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Base64Строка(ФайлСправки));
			
			ТелоHTTPЗапроса ="&fields[title]=Справка 1СПАРК. ИНН:"+Выборка.ИНН+"&fields[number]=2&fields[entityTypeId]="+ТипСущности+"&fields[entityId]="+Формат(ИдСущности, "ЧГ=0") + "&fields[region]="+Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЛокализациюБитрикс24();
			ТелоHTTPЗапроса = ТелоHTTPЗапроса +"&fields[fileContent]="+ВыгружаемыйФайл;
			ТелоHTTPЗапроса = ТелоHTTPЗапроса +"&fields[pdfContent]="+ВыгружаемыйФайл;  
			
			Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm.documentgenerator.document.upload", ТелоHTTPЗапроса); 
			
		ИначеЕсли Состояние = Перечисления.СостоянияСправкиСПАРКРиски.Готовится Тогда
			
		Иначе
			
			Если Состояние = Перечисления.СостоянияСправкиСПАРКРиски.НеизвестныйИНН Тогда
				ОписаниеСообщения = "Не известный ИНН:" + Строка(Выборка.ИНН);
			Иначе
				ОписаниеСообщения = "Ошибка подготовки. ИНН:" + Строка(Выборка.ИНН);
			КонецЕсли;
			
			ДобавитьКомментарийТаймЛайн(СтруктураНастроек, ИдСущности, ТипСущности, ОписаниеСообщения);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКомментарийТаймЛайн(СтруктураНастроек, ИдВладельца, ТипВладельца, Комментарий)
	
	ТипВладельцаСтрокой	= ?(ТипВладельца = "4", "company", ТипВладельца);
	ТипВладельцаСтрокой	= ?(ТипВладельца = "3", "contact", ТипВладельца);
	
	Поля = Новый Структура;
	Поля.Вставить("ENTITY_ID"		, ИдВладельца);
	Поля.Вставить("ENTITY_TYPE"		, ТипВладельцаСтрокой);
	Поля.Вставить("COMMENT"			, Комментарий);
	
	ТелоЗапроса = "&";
	
	Для каждого ТекПоле Из Поля Цикл
		ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
	КонецЦикла;                                                                     
	
	Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm.timeline.comment.add", ТелоЗапроса); 
	
КонецПроцедуры

#КонецОбласти

