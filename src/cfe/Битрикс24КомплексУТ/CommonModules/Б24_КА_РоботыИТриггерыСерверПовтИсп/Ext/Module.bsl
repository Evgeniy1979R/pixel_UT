#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьМассивНастроекАвтоматизации(КлючНастройки = "", ЗначениеНастройки = "") Экспорт

	Возврат РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьМассивНастроекАвтоматизации(КлючНастройки, ЗначениеНастройки); 

КонецФункции

Функция ТребуетсяВыполнениеТриггера(ПолноеИмяОбъекта, ТипОперации) Экспорт
	
	ИдентификаторОбъекта = Неопределено;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Если ОбъектМетаданных = Неопределено Тогда 
		Возврат Ложь 
	КонецЕсли;	

	ИдентификаторОбъекта = РегистрыСведений.Б24_К_ИдентификаторыОбъектовМетаданных.ПолучитьИдентификаторОбъектаМетаданных(ОбъектМетаданных);

	Если НЕ ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураИмен = Б24_КА_РоботыИТриггерыСервер.ПолучитьСтруктуруИменТриггеров();
	
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", ИдентификаторОбъекта);
	Запрос.УстановитьПараметр("ИмяТриггера"			, СтруктураИмен[ТипОперации]);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_КА_ЗарегистрированныеТриггеры.КодТриггера КАК КодТриггера
	|ИЗ
	|	РегистрСведений.Б24_КА_ЗарегистрированныеТриггеры КАК Б24_КА_ЗарегистрированныеТриггеры
	|ГДЕ
	|	Б24_КА_ЗарегистрированныеТриггеры.ИмяТриггера = &ИмяТриггера
	|	И Б24_КА_ЗарегистрированныеТриггеры.ИдДокумента = &ИдентификаторОбъекта"; 
	ВыполненныйЗапрос = Запрос.Выполнить();

	Возврат НЕ ВыполненныйЗапрос.Пустой();
	
КонецФункции


#КонецЕсли
