
#Область ОбработкаСобытий

Процедура ВыгрузкаДелСправочниковПередЗаписьюДанных(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;    
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;    
	
	ОбъектНовый	= Источник.ЭтоНовый();
	ОбъектМодифицирован = Ложь;   
	
	Если ОбъектНовый Тогда
		ОбъектМодифицирован = Истина;
	Иначе
		МассивИсключений = Новый Массив;
		МассивИсключений.Добавить("ДатаИзменения");
		
		МассивДляПроверки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьМассивРеквизитовДляПроверкиМодифицированности();
		
		Если Б24_К_ОбщегоНазначенияСервер.ОбъектМодифицирован(Источник, МассивИсключений, МассивДляПроверки) Тогда
			ОбъектМодифицирован = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектНовый Тогда
		Источник.ДополнительныеСвойства.Вставить("Б24_К_ОбъектНовый");   
	КонецЕсли;

	Если ОбъектМодифицирован Тогда
		Источник.ДополнительныеСвойства.Вставить("Б24_К_ОбъектМодифицирован");   
	КонецЕсли;
	
КонецПроцедуры  

Процедура ВыгрузкаДелДокументовПередЗаписьюДанных(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;    
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;    
	
	ОбъектНовый			= Источник.ЭтоНовый();
	ОбъектМодифицирован = Ложь;
	
	Если ОбъектНовый Тогда
		//ОбъектМодифицирован = Истина;
	Иначе
		МассивИсключений = Новый Массив;
		МассивИсключений.Добавить("ДатаИзменения");
		
		МассивДляПроверки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьМассивРеквизитовДляПроверкиМодифицированности();
		
		Если Б24_К_ОбщегоНазначенияСервер.ОбъектМодифицирован(Источник, МассивИсключений, МассивДляПроверки) Тогда
			ОбъектМодифицирован = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектНовый Тогда
		Источник.ДополнительныеСвойства.Вставить("Б24_К_ОбъектНовый");   
	КонецЕсли;

	Если ОбъектМодифицирован Тогда
		Источник.ДополнительныеСвойства.Вставить("Б24_К_ОбъектМодифицирован");   
	КонецЕсли;
	
	Если Источник.Проведен Тогда
		Источник.ДополнительныеСвойства.Вставить("Б24_К_ДокументУжеПроведен");   
	КонецЕсли; 
	
КонецПроцедуры  

Процедура ВыгрузкаДелПриЗаписиДанных(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 

	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли; 
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;    
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.КлючевыеОперации") Тогда
		Возврат;
	КонецЕсли;  
	
	УстановитьПривилегированныйРежим(Истина);
	
	МетаданныеИсточника = Источник.Метаданные(); 
	Если Метаданные.Документы.Содержит(МетаданныеИсточника) Тогда
		Если МетаданныеИсточника.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			Если Источник.Проведен Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Источник.ДополнительныеСвойства.Свойство("Б24_К_ДелоВыгружено") Тогда  
		Источник.ДополнительныеСвойства.Вставить("Б24_К_ДелоВыгружено", Истина);   
		ВыполнитьСобытиеДела(Источник);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузкаДелОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;  
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;    
	
	Источник.ДополнительныеСвойства.Вставить("Б24_К_ОбъектМодифицирован");   
	
	Если НЕ Источник.ДополнительныеСвойства.Свойство("Б24_К_ДелоВыгружено") Тогда  
		Источник.ДополнительныеСвойства.Вставить("Б24_К_ДелоВыгружено", Истина);   
		ВыполнитьСобытиеДела(Источник);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузкаДелОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;    
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;    
	
	Источник.ДополнительныеСвойства.Вставить("Б24_К_ОбъектМодифицирован");   
	
	Если НЕ Источник.ДополнительныеСвойства.Свойство("Б24_К_ДелоВыгружено") Тогда  
		Источник.ДополнительныеСвойства.Вставить("Б24_К_ДелоВыгружено", Истина);   
		ВыполнитьСобытиеДела(Источник);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ВыгрузкаДел 

Процедура ВыполнитьСобытиеДела(Источник)
	
	Ссылка = Источник.Ссылка;
	ДополнительныеСвойства = Источник.ДополнительныеСвойства;
	
	ДобавленаСвязка = Ложь;
	
	Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
	    ТипИсточникаПРС = Ложь;
	ИначеЕсли Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "БП" Тогда
		ТипПРС = "ДокументОбъект.ПоступлениеНаРасчетныйСчет";
		ТипИсточникаПРС = ТипЗнч(Источник) = Тип(ТипПРС);
	ИначеЕсли Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "УНФ" Тогда
		ТипПРС = "ДокументОбъект.ПоступлениеНаСчет";
		ТипИсточникаПРС = ТипЗнч(Источник) = Тип(ТипПРС);
	Иначе
		ТипПРС = "ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств";
		ТипПРС2 = "ДокументОбъект.АктВыполненныхРабот"; //директ банк не всегда клево работает, акты тоже замечены
		ТипИсточникаПРС = ТипЗнч(Источник) = Тип(ТипПРС)
		или ТипЗнч(Источник) = Тип(ТипПРС2);
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("Б24_К_ОбъектНовый") ИЛИ ТипИсточникаПРС Тогда 
		
		ДобавленаСвязка = ДобавитьСвязкуСДокументомОснования(Ссылка);
		Если ДобавленаСвязка Тогда
			Источник.ДополнительныеСвойства.Вставить("Б24_К_ДобавленаСвязка");   
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДобавленаСвязка ИЛИ ДополнительныеСвойства.Свойство("Б24_К_ОбъектМодифицирован") Тогда
		
		Если НЕ ДополнительныеСвойства.Свойство("Б24_К_НеВыгружатьДело") Тогда
			ВыгрузитьДелоВБитрикс24(Ссылка);     
		КонецЕсли;   
		
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("РаботаИзОдногоОкна") Тогда             
			
			МодульРаботаИзОдногоОкнаВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КБ_РаботаИзОдногоОкнаВызовСервера");
			ВыгрузитьТоварыДокументовВСделкуСмартПроцесс = Ложь;
			Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
				ВыгрузитьТоварыДокументовВСделкуСмартПроцесс = Ложь;	
			ИначеЕсли Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "БП" Тогда
				
				ТипСсылки = ТипЗнч(Ссылка);
				ТипСчетНаОплатуПокупателю 				= "ДокументСсылка.СчетНаОплатуПокупателю";
				ТипСчетНаОплатуПоставщика 				= "ДокументСсылка.СчетНаОплатуПоставщика";
				ТипАктОбОказанииПроизводственныхУслуг 	= "ДокументСсылка.АктОбОказанииПроизводственныхУслуг";
				ТипРеализацияТоваровУслуг 				= "ДокументСсылка.РеализацияТоваровУслуг";
				ТипПоступлениеТоваровУслуг 				= "ДокументСсылка.ПоступлениеТоваровУслуг";
				Если ТипСсылки = Тип(ТипСчетНаОплатуПокупателю) ИЛИ ТипСсылки = Тип(ТипСчетНаОплатуПоставщика) 
					ИЛИ ТипСсылки = Тип(ТипАктОбОказанииПроизводственныхУслуг)
					ИЛИ ТипСсылки = Тип(ТипРеализацияТоваровУслуг) ИЛИ ТипСсылки = Тип(ТипПоступлениеТоваровУслуг) Тогда
					
					ВыгрузитьТоварыДокументовВСделкуСмартПроцесс = Истина;   
					
				КонецЕсли;
				
			ИначеЕсли Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "УНФ" Тогда
				
				ТипСсылки = ТипЗнч(Ссылка);
				Если ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПокупателя") ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплату") ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.АктВыполненныхРабот")
					ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПоставщику") ИЛИ ТипСсылки = Тип("ДокументСсылка.СчетНаОплатуПоставщика") 
					ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.РасходнаяНакладная") ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПриходнаяНакладная") Тогда
					
					ВыгрузитьТоварыДокументовВСделкуСмартПроцесс = Истина;
					
				КонецЕсли;
				
			Иначе
				
				ТипСсылки = ТипЗнч(Ссылка);
				Если ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказКлиента") ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПоставщику") 
					ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.АктВыполненныхРабот") ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.КоммерческоеПредложениеКлиенту")
					ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ВозвратТоваровОтКлиента") ИЛИ ТипСсылки = Тип("ДокументСсылка.ВозвратТоваровПоставщику") 
					ИЛИ ТипСсылки = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПриобретениеТоваровУслуг") ИЛИ ТипСсылки = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
					
					ВыгрузитьТоварыДокументовВСделкуСмартПроцесс = Истина;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ВыгрузитьТоварыДокументовВСделкуСмартПроцесс Тогда
				мНастройкиПодключения = ПолучитьИспользуемыеНастройкиПодключенияОбъектомЧерезДела(Ссылка);
				Для каждого ТекЭлемент Из мНастройкиПодключения Цикл
					МодульРаботаИзОдногоОкнаВызовСервера.ВыгрузитьТоварыДокументовВСделкуСмартПроцесс(ТекЭлемент, ДополнительныеСвойства.Свойство("Б24_К_ДокументНовый"), Ссылка, "", "");	
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;       
	
КонецПроцедуры

// Формирует строку запроса для обновления или добавления дела в Битрикс24.
//
// Параметры:
//  СтруктураНастроек - Структура - настройки интеграции с Битрикс24.
//  ВидДела - Строка - вид дела.
//  КлючДела - Строка - ключ дела.
//  ИдентификаторДела - Строка - идентификатор дела в Битрикс24.
//  ТелоДела - Строка - тело запроса для обновления или добавления дела.
//
// Возвращаемое значение:
//  Строка - строка запроса для обновления или добавления дела в Битрикс24.
//
Функция ПолучитьЗапросДела(СтруктураНастроек, ВидДела, КлючДела, Знач ИдентификаторДела, ТелоДела) Экспорт
	
	Если ВидДела = "Конфигурируемое" Тогда

		Если ЗначениеЗаполнено(ИдентификаторДела) Тогда

			Если СтруктураНастроек.НеОбновлятьДелаБитрикс24 Тогда
				Возврат "";
			КонецЕсли;

			ОбработатьИдентификаторДела(ИдентификаторДела);
			СтрокаЗапроса = "&cmd[" + КлючДела + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.activity.configurable.update?id=" + ИдентификаторДела 
				+ "&" + ТелоДела);

		Иначе
			СтрокаЗапроса = "&cmd[" + КлючДела + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.activity.configurable.add?" + ТелоДела);
		КонецЕсли;

	ИначеЕсли ВидДела = "Стандартное" Тогда

		Если ЗначениеЗаполнено(ИдентификаторДела) Тогда

			Если СтруктураНастроек.НеОбновлятьДелаБитрикс24 Тогда
				Возврат "";
			КонецЕсли;

			ОбработатьИдентификаторДела(ИдентификаторДела);
			СтрокаЗапроса = "&cmd[" + КлючДела + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.activity.update?id=" + ИдентификаторДела + "&"
				+ ТелоДела);

		Иначе
			СтрокаЗапроса = "&cmd[" + КлючДела + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.activity.add?" + ТелоДела);
		КонецЕсли;

	КонецЕсли;

	Возврат СтрокаЗапроса;

КонецФункции

// Формирует тело запроса дела в зависимости от настроек.
//
// Параметры:
//  СтруктураНастроек - Структура - настройки для формирования запроса дела.
//  ВидДела - Строка - вид дела. Конфигурируемое или Стандартное
//  ТипВладельца - Строка - тип владельца дела.
//  ИдентификаторВладельца - Строка - идентификатор владельца дела.
//  КлючВладельца - Строка - ключ владельца дела.
//  ОбъектСсылка - СправочникСсылка, ДокументСсылка - объект, для которого формируется запрос дела.
//  ТекстСообщения - Строка - текст сообщения для дела.
//  ВыгрузкаТЧ - Булево - признак выгрузки табличной части объекта.
//  ЭтоОшибка - Булево - признак ошибки.
//
// Возвращаемое значение:
//  Строка - сформированное тело запроса дела.
//                                
Функция ПолучитьТелоЗапросаДела(СтруктураНастроек, ВидДела, ТипВладельца, ИдентификаторВладельца, КлючВладельца, ОбъектСсылка, ТекстСообщения = "",
	ВыгрузкаТЧ = Ложь, ЭтоОшибка = Ложь) Экспорт

	Результат = "";

	Если ТипЗнч(ОбъектСсылка) = Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Если ВидДела = "Конфигурируемое" Тогда
		Результат = СформироватьТелоЗапросаКонфигурируемогоДела(СтруктураНастроек, ТипВладельца, ИдентификаторВладельца, КлючВладельца, ОбъектСсылка,
			ТекстСообщения, ВыгрузкаТЧ, ЭтоОшибка);
	ИначеЕсли ВидДела = "Стандартное" Тогда
		Результат = СформироватьТелоЗапросаСтандартногоДела(СтруктураНастроек, ТипВладельца, ИдентификаторВладельца, КлючВладельца, ОбъектСсылка,
			ТекстСообщения, ЭтоОшибка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СформироватьТелоЗапросаСтандартногоДела(СтруктураНастроек, ТипВладельца, ИдентификаторВладельца, КлючВладельца, ОбъектСсылка, ТекстСообщения = "",
	ЭтоОшибка = Ложь)
	
	ИдентификаторПодключения = СтрЗаменить(СтруктураНастроек.ИдентификаторПодключения, "_SALE", "");	
	
	Если ТипЗнч(ОбъектСсылка) = Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Поля = Новый Структура;
	Поля.Вставить("OWNER_TYPE_ID"	, ТипВладельца);
	Поля.Вставить("COMPLETED"		, "Y");
	Поля.Вставить("SUBJECT"			, ?(ЗначениеЗаполнено(ОбъектСсылка), Строка(ОбъектСсылка), "Журнал регистрации 1С"));
	Поля.Вставить("PROVIDER_ID"		, "REST_APP");
	Поля.Вставить("DESCRIPTION_TYPE", "3");	
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		Поля.Вставить("DESCRIPTION", ТекстСообщения);
		Если ЭтоОшибка Тогда
			Поля.Вставить("PROVIDER_TYPE_ID", "1CTOTAL_RED");
		Иначе
			Поля.Вставить("PROVIDER_TYPE_ID", "1CTOTAL_GREEN");
		КонецЕсли;
	Иначе
		Если ЭтоОшибка Тогда			
			Поля.Вставить("PROVIDER_TYPE_ID", "1CTOTAL_RED");
		Иначе
			Поля.Вставить("PROVIDER_TYPE_ID", "1CTOTAL");
		КонецЕсли;	
	КонецЕсли;		

	Если НЕ ЗначениеЗаполнено(ТекстСообщения) И ЗначениеЗаполнено(ОбъектСсылка) Тогда

		ОписаниеДела = "";

		РеквизитаОбъекта = "ВерсияДанных";

		МетаданныеОбъекта = ОбъектСсылка.Метаданные();

		Если МетаданныеОбъекта.Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
			РеквизитаОбъекта = РеквизитаОбъекта + ", СуммаДокумента";
		КонецЕсли;
		
		Если МетаданныеОбъекта.Реквизиты.Найти("Валюта") <> Неопределено Тогда
			РеквизитаОбъекта = РеквизитаОбъекта + ", Валюта";
		ИначеЕсли МетаданныеОбъекта.Реквизиты.Найти("ВалютаДокумента") <> Неопределено Тогда
			РеквизитаОбъекта = РеквизитаОбъекта + ", ВалютаДокумента";
		Иначе
			Если МетаданныеОбъекта.Реквизиты.Найти("ВалютаДенежныхСредств") <> Неопределено Тогда
				РеквизитаОбъекта = РеквизитаОбъекта + ", ВалютаДенежныхСредств";
			КонецЕсли;
		КонецЕсли;

		ЗначенияРеквизитовОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, РеквизитаОбъекта);
		Если ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.ВерсияДанных) Тогда     //Предотвращение разбора еще несуществующей ссылки.

			Если ЗначенияРеквизитовОбъекта.Свойство("СуммаДокумента") Тогда

				Сумма = ЗначенияРеквизитовОбъекта.СуммаДокумента;
				
				Если ЗначенияРеквизитовОбъекта.Свойство("Валюта") Тогда
					Валюта = ЗначенияРеквизитовОбъекта.Валюта;
				ИначеЕсли ЗначенияРеквизитовОбъекта.Свойство("ВалютаДокумента") Тогда
					Валюта = ЗначенияРеквизитовОбъекта.ВалютаДокумента;
				КонецЕсли;

				Если Не ЗначениеЗаполнено(Валюта) И ЗначенияРеквизитовОбъекта.Свойство("ВалютаДенежныхСредств") Тогда
					Валюта = ЗначенияРеквизитовОбъекта.ВалютаДенежныхСредств;
				КонецЕсли;

				ОписаниеДела = "<p style=""text-align: left;"">Сумма документа: " + Формат(Сумма, "") + " " + Строка(Валюта) + ".</p>";

			КонецЕсли;

		КонецЕсли;

		Поля.Вставить("DESCRIPTION", ОписаниеДела);

	КонецЕсли;

	ТелоДела = "";
	Для Каждого ТекПоле Из Поля Цикл
		ТелоДела = ТелоДела + ?(СтрДлина(ТелоДела) > 0, "&", "") + "fields[" + ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(
			ТекПоле.Значение);
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ИдентификаторВладельца) Тогда
		ТелоДела = ТелоДела + "&fields[OWNER_ID]=$result[" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КлючВладельца) + "]";
	Иначе
		ТелоДела = ТелоДела + "&fields[OWNER_ID]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторВладельца);
	КонецЕсли;

	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		ТелоДела = ТелоДела + "&fields[PROVIDER_PARAMS][idAdress]=" + ИдентификаторПодключения + "&fields[PROVIDER_PARAMS][relAdress]="
			+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПолучитьНавигационнуюСсылку(ОбъектСсылка));
	Иначе
		ТелоДела = ТелоДела + "&fields[PROVIDER_PARAMS][idAdress]=" + ИдентификаторПодключения + "&fields[PROVIDER_PARAMS][relAdress]="
			+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("e1cib/list/РегистрСведений.Б24_К_Логирование");
	КонецЕсли;

	ТелоДела = ТелоДела + "&fields[PARAMS][ENABLE_AUTHOR_CHANGE]=Y&fields[SETTINGS][ENABLE_AUTHOR_CHANGE]=Y&fields[SETTINGS][PROVIDER_PARAMS]=Y";

	Возврат ТелоДела;

КонецФункции

Функция СформироватьТелоЗапросаКонфигурируемогоДела(СтруктураНастроек, ТипВладельца, ИдентификаторВладельца, КлючВладельца, ОбъектСсылка, ТекстСообщения = "",
	ВыгрузкаТЧ = Ложь, ЭтоОшибка = Ложь)

	ТелоЗапроса = "";
	ИдентификаторПодключения = СтрЗаменить(СтруктураНастроек.ИдентификаторПодключения, "_SALE", "");

	ЗаголовокДела 				= "Дело 1С";
	ТипТэга 					= "success";     //failure
	ЗаголовокТега				= "";
	ОписаниеДела 				= "";
	НавигационнаяСсылкаОбъекта 	= "";
	мТекстТела					= Новый Массив;
	ИконкаТела					= "1cdoc";

#Область ИменаРеквизитов
	ИмяТЧТ 				= "Товары";
	ИмяТЧУ 				= "Услуги";
	ИмяРеквизитаСумма 	= "СуммаДокумента";
	ИмяРеквизитаВалюта 	= "ВалютаДокумента";
#КонецОбласти

	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		мТекстТела.Добавить(Новый Структура("Ключ, Значение", "ПредопределенноеСообщение", ТекстСообщения));
	Иначе
		
		АлгоритмДляДела = РегистрыСведений.Б24_К_АлгоритмыЗаполненияДел.АлгоритмДляДела(СтруктураНастроек.НастройкаПодключения, ОбъектСсылка);		
		Если ЗначениеЗаполнено(АлгоритмДляДела) Тогда		
						
			Параметры = Б24_К_ОбщегоНазначенияСервер.ПолучитьСтруктуруПараметровПредопределенногоАлгоритма();
			Параметры.СтруктураНастроек 	 = СтруктураНастроек;
			Параметры.Объект1С 				 = ОбъектСсылка;
			
			ЗначениеАлгоритма = Б24_К_ОбщегоНазначенияСервер.ПолучитьЗначениеПредопределенногоАлгоритма(АлгоритмДляДела, Параметры, "Функция");		
			Если ЗначениеЗаполнено(ЗначениеАлгоритма) Тогда		
				мТекстТела.Добавить(Новый Структура("Ключ, Значение", "ПредопределенноеСообщение", ЗначениеАлгоритма));
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда

		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			ИконкаТела = "comment";
			Если ЭтоОшибка Тогда
				ЗаголовокТега = "Ошибка";
				ТипТэга 	  = "failure";
			КонецЕсли;
		КонецЕсли;

	Иначе

		НавигационнаяСсылкаОбъекта = ПолучитьНавигационнуюСсылку(ОбъектСсылка);

		МетаданныеОбъекта = ОбъектСсылка.Метаданные();
		Если ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта) Тогда

			ЕстьПроведение 	= МетаданныеОбъекта.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить;
			ЕстьВалюта     	= МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизитаВалюта) <> Неопределено;
			ЕстьСумма     	= МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизитаСумма) <> Неопределено;
			ЕстьТЧТ     	= ВыгрузкаТЧ И МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧТ) <> Неопределено;
			ЕстьТЧУ     	= ВыгрузкаТЧ И МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧУ) <> Неопределено;

			ПереченьПолучаемыхРеквизитов = "Номер, Дата, ПометкаУдаления";
			Если ЕстьПроведение Тогда
				ПереченьПолучаемыхРеквизитов = ПереченьПолучаемыхРеквизитов + ", Проведен";
			КонецЕсли;
			
			Если ЕстьВалюта Тогда
				ПереченьПолучаемыхРеквизитов = ПереченьПолучаемыхРеквизитов + ", " + ИмяРеквизитаВалюта;
			КонецЕсли;
			
			Если ЕстьСумма Тогда
				ПереченьПолучаемыхРеквизитов = ПереченьПолучаемыхРеквизитов + ", " + ИмяРеквизитаСумма;
			КонецЕсли;
			
			Если ЕстьТЧТ Тогда
				ПереченьПолучаемыхРеквизитов = ПереченьПолучаемыхРеквизитов + ", " + ИмяТЧТ;
			КонецЕсли;
			
			Если ЕстьТЧУ Тогда
				ПереченьПолучаемыхРеквизитов = ПереченьПолучаемыхРеквизитов + ", " + ИмяТЧУ;
			КонецЕсли;

			ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, ПереченьПолучаемыхРеквизитов);
			Если ЭтоОшибка Тогда
				ЗаголовокТега = "Ошибка";
				ТипТэга 	  = "failure";
			ИначеЕсли ЗначенияРеквизитовДокумента.ПометкаУдаления = Истина Тогда
				ЗаголовокТега = "Помечен на удаление";
				ТипТэга 	  = "failure";
			Иначе

				Если ЗначенияРеквизитовДокумента.Свойство("Проведен") И ЗначенияРеквизитовДокумента.Проведен = Истина Тогда
					ЗаголовокТега = "Проведен";
				Иначе
					ЗаголовокТега = "Не проведен";
					ТипТэга 	  = "secondary";
				КонецЕсли;
			КонецЕсли;

			ВалютаСтрокой = "";
			Если ЕстьВалюта Тогда
				ВалютаСтрокой = Строка(ЗначенияРеквизитовДокумента[ИмяРеквизитаВалюта]);
			КонецЕсли;

			ОписаниеДела = МетаданныеОбъекта.Синоним + " " + ЗначенияРеквизитовДокумента.Номер + " от " + Формат(ЗначенияРеквизитовДокумента.Дата,
				"ДФ=dd.MM.yyyy");
			Если ЕстьСумма Тогда
				ОписаниеДела = ОписаниеДела + " на сумму " + Формат(ЗначенияРеквизитовДокумента[ИмяРеквизитаСумма]);
			КонецЕсли;
			
			Если ЕстьСумма И ЕстьВалюта Тогда
				ОписаниеДела = ОписаниеДела + " " + ВалютаСтрокой;
			КонецЕсли;

			Если ЕстьТЧТ Тогда

				МетаданныеТЧ = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧТ);
				Если МетаданныеТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено Тогда

					ВыполненныйЗапросТЧ = ЗначенияРеквизитовДокумента[ИмяТЧТ];
					ВыборкаТЧ = ВыполненныйЗапросТЧ.Выбрать();
					Пока ВыборкаТЧ.Следующий() Цикл

						Если ЗначениеЗаполнено(ВыборкаТЧ.Номенклатура) Тогда

							КлючЭлемента 	= Строка(ВыборкаТЧ.Номенклатура);
							ЗначениеКлюча 	= "";
							
							Если МетаданныеТЧ.Реквизиты.Найти("Характеристика") <> Неопределено И ЗначениеЗаполнено(ВыборкаТЧ.Характеристика) Тогда
								КлючЭлемента = КлючЭлемента + " '" + Строка(ВыборкаТЧ.Характеристика) + "'";
							КонецЕсли;

							Если МетаданныеТЧ.Реквизиты.Найти("Количество") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + Формат(ВыборкаТЧ.Количество, "ЧГ=0");
							КонецЕсли;
							
							Если МетаданныеТЧ.Реквизиты.Найти("Упаковка") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + " " + Строка(ВыборкаТЧ.Упаковка);
							КонецЕсли;
							
							Если МетаданныеТЧ.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + " " + Строка(ВыборкаТЧ.ЕдиницаИзмерения);
							КонецЕсли;

							Если МетаданныеТЧ.Реквизиты.Найти("Цена") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + " за " + Формат(ВыборкаТЧ.Цена, "ЧГ=0") + " " + ВалютаСтрокой;
							КонецЕсли;

							Если МетаданныеТЧ.Реквизиты.Найти("Сумма") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + " на " + Формат(ВыборкаТЧ.Сумма, "ЧГ=0") + " " + ВалютаСтрокой;
							КонецЕсли;

							мТекстТела.Добавить(Новый Структура("Ключ, Значение", КлючЭлемента, ЗначениеКлюча));

						КонецЕсли;

					КонецЦикла;

				КонецЕсли;
			КонецЕсли;  
			
			Если ЕстьТЧУ Тогда

				МетаданныеТЧ = МетаданныеОбъекта.ТабличныеЧасти.Найти(ИмяТЧУ);
				Если МетаданныеТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено Тогда

					ВыполненныйЗапросТЧ = ЗначенияРеквизитовДокумента[ИмяТЧУ];
					ВыборкаТЧ = ВыполненныйЗапросТЧ.Выбрать();
					Пока ВыборкаТЧ.Следующий() Цикл

						Если ЗначениеЗаполнено(ВыборкаТЧ.Номенклатура) Тогда

							КлючЭлемента 	= Строка(ВыборкаТЧ.Номенклатура);
							ЗначениеКлюча 	= "";

							Если МетаданныеТЧ.Реквизиты.Найти("Количество") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + Формат(ВыборкаТЧ.Количество, "ЧГ=0");
							КонецЕсли;

							Если МетаданныеТЧ.Реквизиты.Найти("ЕдиницаИзмерения") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + " " + Строка(ВыборкаТЧ.ЕдиницаИзмерения);
							КонецЕсли;

							Если МетаданныеТЧ.Реквизиты.Найти("Цена") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + " за " + Формат(ВыборкаТЧ.Цена, "ЧГ=0") + " " + ВалютаСтрокой;
							КонецЕсли;

							Если МетаданныеТЧ.Реквизиты.Найти("Сумма") <> Неопределено Тогда
								ЗначениеКлюча = ЗначениеКлюча + " на " + Формат(ВыборкаТЧ.Сумма, "ЧГ=0") + " " + ВалютаСтрокой;
							КонецЕсли;

							мТекстТела.Добавить(Новый Структура("Ключ, Значение", КлючЭлемента, ЗначениеКлюча));

						КонецЕсли;

					КонецЦикла;

				КонецЕсли;
			КонецЕсли;			

		ИначеЕсли ОбщегоНазначения.ЭтоСправочник(МетаданныеОбъекта) Тогда

			ЗначенияРеквизитовЭлемента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, "ПометкаУдаления, Наименование");

			ОписаниеДела = ЗначенияРеквизитовЭлемента.Наименование;

			Если ЭтоОшибка Тогда
				ЗаголовокТега = "Ошибка";
				ТипТэга 	  = "failure";
			ИначеЕсли ЗначенияРеквизитовЭлемента.ПометкаУдаления = Истина Тогда
				ЗаголовокТега = "Помечен на удаление";
				ТипТэга 	  = "failure";
			Иначе
				ЗаголовокТега = "Записан";
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИдентификаторВладельца) Тогда
		ТелоЗапроса = ТелоЗапроса + "&ownerId=$result[" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КлючВладельца) + "]";
	Иначе
		ТелоЗапроса = ТелоЗапроса + "&ownerId=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторВладельца);
	КонецЕсли;

	ТелоЗапроса = ТелоЗапроса + "&ownerTypeId=" + ТипВладельца;

	ТелоЗапроса = ТелоЗапроса + "&fields[completed]=Y";   //N

	ТелоЗапроса = ТелоЗапроса + "&layout[icon][code]=link";
	ТелоЗапроса = ТелоЗапроса + "&layout[header][title]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ЗаголовокДела);

	Если ЗначениеЗаполнено(ЗаголовокТега) Тогда
		ТелоЗапроса = ТелоЗапроса + "&layout[header][tags][1][title]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ЗаголовокТега);
		ТелоЗапроса = ТелоЗапроса + "&layout[header][tags][1][type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТипТэга);
	КонецЕсли;

	Если ЗначениеЗаполнено(НавигационнаяСсылкаОбъекта) Тогда
		ТелоЗапроса = ТелоЗапроса + "&layout[header][titleAction][type]=openRestApp";
		ТелоЗапроса = ТелоЗапроса + "&layout[header][titleAction][actionParams][idAdress]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(
			ИдентификаторПодключения);
		ТелоЗапроса = ТелоЗапроса + "&layout[header][titleAction][actionParams][relAdress]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(
			НавигационнаяСсылкаОбъекта);
		ТелоЗапроса = ТелоЗапроса + "&layout[header][titleAction][actionParams][view_doc]=Y";
	КонецЕсли;

	Если ЗначениеЗаполнено(НавигационнаяСсылкаОбъекта) Тогда
		ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][link][type]=link";
		ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][link][properties][text]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ОписаниеДела);
		ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][link][properties][action][type]=openRestApp";
		ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][link][properties][action][actionParams][idAdress]="
			+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторПодключения);
		ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][link][properties][action][actionParams][relAdress]="
			+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(НавигационнаяСсылкаОбъекта);
		ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][link][properties][action][actionParams][view_doc]=Y";
	КонецЕсли;

	ТелоЗапроса = ТелоЗапроса + "&layout[body][logo][code]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИконкаТела);

	Если мТекстТела.Количество() > 0 Тогда

		Если мТекстТела[0].Ключ = "ПредопределенноеСообщение" Тогда
			ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][text][type]=text";   //text   largeText   withTitle 
			ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][text][properties][value]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(
				мТекстТела[0].Значение);
		Иначе

			ТелоСообщения = "";
			Для Каждого ТекЭлемент Из мТекстТела Цикл

				ТелоСообщения = ТелоСообщения + ТекЭлемент.Ключ + Символы.ПС;
				ТелоСообщения = ТелоСообщения + ТекЭлемент.Значение + Символы.ПС + Символы.ПС;

			КонецЦикла;

			ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][largeText][type]=largeText";   //text   largeText   withTitle 
			ТелоЗапроса = ТелоЗапроса + "&layout[body][blocks][largeText][properties][value]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(
				ТелоСообщения);

		КонецЕсли;

	КонецЕсли;

	Возврат ТелоЗапроса;

КонецФункции

// Создает дело в Битрикс24 и записывает его идентификатор в регистр сведений Б24_К_ИдентификаторыДел.
//
// Параметры:
//  СтруктураНастроек - Структура - настройки интеграции с Битрикс24.
//  ВидДела - Строка - вид создаваемого дела ("Конфигурируемое" или "Стандартное").
//  ПараметрыЗапроса - Структура - параметры запроса на создание дела.
//  ОбъектСсылка - ДокументСсылка, СправочникСсылка - ссылка на объект, для которого создается дело.
//  ТипВладельца - Строка - тип владельца дела.
//  ИдентификаторВладельца - Строка - идентификатор владельца
//  ТипДанных - Строка - тип данных дела.
//  СохранятьИдентификатор - Булево - признак необходимости записи идентификатора в регистр сведений.
//
// Возвращаемое значение:
//  Булево - Истина, если дело успешно создано, иначе Ложь.
//
Функция ДелоСозданоВБитрикс24(СтруктураНастроек, ВидДела, ПараметрыЗапроса, ОбъектСсылка, ТипВладельца, ИдентификаторВладельца, ТипДанных, СохранятьИдентификатор = Истина, ПропускатьПовторноеСоздание = Истина) Экспорт

	Результат = НЕ СохранятьИдентификатор;

	// Повторная выгрузка дела по тому же объекту и владельцу добавляла на портале ещё одно дело:
	// в сделке накапливалось несколько дел на один документ 1С. Если дело уже создавалось, выходим
	// с Истиной — дело у объекта есть. Сообщения в ленту (СохранятьИдентификатор = Ложь) проверку
	// не проходят: каждому сообщению нужен свой элемент на таймлайне.
	Если НЕ Результат И ПропускатьПовторноеСоздание
		И ЕстьСозданноеДелоПоОбъекту(СтруктураНастроек.НастройкаПодключения, ОбъектСсылка, ТипДанных, ИдентификаторВладельца) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ВидДела = "Конфигурируемое" Тогда

		ОтветПортала = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm.activity.configurable.add", ПараметрыЗапроса);
		Если СохранятьИдентификатор И ОтветПортала <> Неопределено Тогда

			result = ОтветПортала.Получить("result");
			Если result <> Неопределено Тогда
				activity = result.Получить("activity");
				Если activity <> Неопределено Тогда

					ИдентификаторДела = Формат(activity.Получить("id"), "ЧГ=0");

					Если ТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.ДелоСмартПроцесса Тогда
						РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, ТипДанных, ОбъектСсылка, ТипВладельца + "_"
							+ ИдентификаторДела, Результат);
					Иначе
						РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, ТипДанных, ОбъектСсылка, ИдентификаторДела, ИдентификаторВладельца);
					КонецЕсли;

					Результат = Истина;

				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ВидДела = "Стандартное" Тогда

		ОтветПортала = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/crm.activity.add", ПараметрыЗапроса);
		Если СохранятьИдентификатор И ОтветПортала <> Неопределено Тогда

			ИдентификаторДела = Формат(ОтветПортала.Получить("result"), "ЧГ=0");
			Если ЗначениеЗаполнено(ИдентификаторДела) Тогда

				Результат = Истина;

				Если ТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.ДелоСмартПроцесса Тогда
					РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, ТипДанных, ОбъектСсылка, ТипВладельца + "_"
						+ ИдентификаторДела, Результат);
				Иначе
					РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, ТипДанных, ОбъектСсылка, ИдентификаторДела, ИдентификаторВладельца);
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

// Проверяет, выгружалось ли уже дело по этому объекту 1С для указанного владельца Битрикс24.
//
// Дело на один объект создаётся из нескольких мест (форма нового документа из Битрикс24, запись
// документа, привязка заказа к сделке). Без такой проверки на портале появлялось несколько дел
// на один документ 1С, а идентификатор предыдущего дела затирался в регистре.
//
// Параметры:
//  НастройкаПодключения  - СправочникСсылка.Б24_К_НастройкиПодключения - настройка подключения к Битрикс24.
//  ОбъектСсылка          - ДокументСсылка, СправочникСсылка - объект 1С, по которому выгружается дело.
//  ТипДанных             - ПеречислениеСсылка - тип данных дела (ДелоСделки, ДелоСчета и т. п.).
//  ИдентификаторВладельца - Строка - идентификатор владельца на портале; пустая строка - владелец не проверяется.
//
// Возвращаемое значение:
//  Булево - Истина, если дело по объекту уже выгружалось.
//
Функция ЕстьСозданноеДелоПоОбъекту(НастройкаПодключения, ОбъектСсылка, ТипДанных, ИдентификаторВладельца = "") Экспорт

	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) ИЛИ НЕ ЗначениеЗаполнено(ОбъектСсылка)
		ИЛИ НЕ ЗначениеЗаполнено(ТипДанных) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкаПодключения"	, НастройкаПодключения);
	Запрос.УстановитьПараметр("ТипДанных"				, ТипДанных);
	Запрос.УстановитьПараметр("ТипОбъекта"				, ОбъектСсылка.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("ИдентификаторОбъекта"	, XMLСтрока(ОбъектСсылка));
	Запрос.УстановитьПараметр("ПроверятьВладельца"		, ЗначениеЗаполнено(ИдентификаторВладельца));
	Запрос.УстановитьПараметр("ИдентификаторВладельца"	, Формат(ИдентификаторВладельца, "ЧГ=0"));
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИдентификаторыДел.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК ИдентификаторыДел
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Б24_К_НастройкиПодключения КАК НастройкиПодключения
	|		ПО ИдентификаторыДел.Портал = НастройкиПодключения.Портал
	|ГДЕ
	|	НастройкиПодключения.Ссылка = &НастройкаПодключения
	|	И ИдентификаторыДел.ТипДанных = &ТипДанных
	|	И ИдентификаторыДел.ТипОбъекта = &ТипОбъекта
	|	И ИдентификаторыДел.ИдентификаторОбъекта = &ИдентификаторОбъекта
	|	И ИдентификаторыДел.Идентификатор <> """"
	|	И (НЕ &ПроверятьВладельца
	|		ИЛИ ИдентификаторыДел.ДополнительныйИдентификатор = &ИдентификаторВладельца)";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Процедура выгрузки дела в Битрикс24.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка, СправочникСсылка - Ссылка на объект, для которого необходимо выгрузить дело.
//  НастройкаПодключения - СправочникСсылка.Б24_К_НастройкиПодключения - Настройка подключения к Битрикс24 (необязательный параметр).
//  ТипВладельца - Строка - Тип владельца дела (необязательный параметр).
//  ИдентификаторВладельца - Строка - Идентификатор владельца дела (необязательный параметр).
//  ВыгружатьОтдельнымПотоком - Булево - Признак выгрузки в отдельном потоке (необязательный параметр).
//
Процедура ВыгрузитьДелоВБитрикс24(ОбъектСсылка, НастройкаПодключения = Неопределено, ТипВладельца = "", ИдентификаторВладельца = "", ВыгружатьОтдельнымПотоком = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляДел = Новый Массив;
	
	Если ТипВладельца = "" ИЛИ ИдентификаторВладельца = "" Тогда           
		
		мДанных = РегистрыСведений.Б24_К_ИдентификаторыДел.ПолучитьИнформациюОДелахПоОбъекту(ОбъектСсылка, ТипВладельца); 
		Для каждого ТекЭлемент Из мДанных Цикл
			
			Если ЗначениеЗаполнено(ТекЭлемент.Идентификатор) И ТекЭлемент.НеОбновлятьДелаБитрикс24 Тогда 
				Продолжить;
			КонецЕсли;
			
			ЕстьЗапись = Ложь;	
			Для каждого ТекЭлементДел Из ДанныеДляДел Цикл
				Если ТекЭлемент.НастройкаПодключения = ТекЭлементДел.НастройкаПодключения И ТекЭлемент.Идентификатор = ТекЭлементДел.Идентификатор 
					И ТекЭлемент.ИдентификаторВладельца = ТекЭлементДел.ИдентификаторВладельца И ТекЭлемент.ТипВладельца = ТекЭлементДел.ТипВладельца Тогда
					ЕстьЗапись = Истина;	
				КонецЕсли;
			КонецЦикла; 
			
			Если НЕ ЕстьЗапись Тогда
				ДанныеДляДел.Добавить(ТекЭлемент);	
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли;	

	Если ЗначениеЗаполнено(НастройкаПодключения) И ЗначениеЗаполнено(ИдентификаторВладельца) И ЗначениеЗаполнено(ТипВладельца) И ДанныеДляДел.Количество() = 0 Тогда
		
		НовоеДело = Новый Структура;
		НовоеДело.Вставить("НастройкаПодключения"	, НастройкаПодключения);
		НовоеДело.Вставить("Идентификатор"			, "");
		НовоеДело.Вставить("ИдентификаторВладельца"	, ИдентификаторВладельца);
		НовоеДело.Вставить("ТипВладельца"			, ТипВладельца);
		НовоеДело.Вставить("Объект"					, ОбъектСсылка);
		НовоеДело.Вставить("ЭтоНовый"				, Истина);
	
		НовоеДело.Вставить("ТипДанных"			, Б24_К_RestApiВызовСервера.ПолучитьТипДанныхДелаПоТипуВладельца(НастройкаПодключения, ТипВладельца));

		// Дело по этому объекту и владельцу уже выгружалось: повторная выгрузка добавляла на портале
		// ещё одно дело (на один документ 1С накапливалось несколько дел) и затирала прежний идентификатор.
		Если НЕ ЕстьСозданноеДелоПоОбъекту(НастройкаПодключения, ОбъектСсылка, НовоеДело.ТипДанных, ИдентификаторВладельца) Тогда
			ДанныеДляДел.Добавить(НовоеДело);
		КонецЕсли;

	КонецЕсли;
	
	Для каждого ТекЭлемент Из ДанныеДляДел Цикл 
		ВыгрузитьИнформациюДела(ТекЭлемент, ВыгружатьОтдельнымПотоком, ТекЭлемент.ЭтоНовый);
	КонецЦикла;
	
КонецПроцедуры           

Процедура ВыгрузитьИнформациюДела(ДанныеДела, ВыгружатьОтдельнымПотоком, ЭтоНовый)
	
УстановитьПривилегированныйРежим(Истина);
		
	Если НЕ Б24_К_СлужебныйВызовСервера.БазовыйМодульДоступен(ДанныеДела.НастройкаПодключения) Тогда
		Возврат;
	КонецЕсли;                          
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("НастройкаПодключения"	, ДанныеДела.НастройкаПодключения);
	ПараметрыЗапроса.Вставить("ОбъектСсылка"			, ДанныеДела.Объект);
	ПараметрыЗапроса.Вставить("ТипДанных"				, ДанныеДела.ТипДанных);	
	ПараметрыЗапроса.Вставить("ИдентификаторВладельца"	, ДанныеДела.ИдентификаторВладельца);
	ПараметрыЗапроса.Вставить("ИдентификаторДела"		, ДанныеДела.Идентификатор);
	ПараметрыЗапроса.Вставить("ТипВладельца"			, ДанныеДела.ТипВладельца);
	ПараметрыЗапроса.Вставить("ЭтоНовый"				, ЭтоНовый);
	
	Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_К_ВыгрузкаДелСервер.ВыгрузитьИнформациюДелаВФоне", "Обновление информации на портале", ПараметрыЗапроса, 2, ВыгружатьОтдельнымПотоком); 

КонецПроцедуры

// Выполняет фоновую выгрузку информации о деле в систему Битрикс24.
//
// Параметры:
//   ПередаваемыеПараметры - Структура - Параметры подключения и данные выгружаемого объекта
//   АдресРезультата - Строка - Адрес для хранения результата выполнения фонового задания
Процедура ВыгрузитьИнформациюДелаВФоне(ПередаваемыеПараметры, АдресРезультата) Экспорт

	НастройкаПодключения 	= ПередаваемыеПараметры.НастройкаПодключения;
	ОбъектСсылка 			= ПередаваемыеПараметры.ОбъектСсылка;
	ТипДанных 				= ПередаваемыеПараметры.ТипДанных;
	ИдентификаторВладельца 	= ПередаваемыеПараметры.ИдентификаторВладельца;
	ТипВладельца 			= ПередаваемыеПараметры.ТипВладельца;
	ЭтоНовый 				= ПередаваемыеПараметры.ЭтоНовый;

	ИдентификаторДела 		= ПередаваемыеПараметры.ИдентификаторДела;
	ОбработатьИдентификаторДела(ИдентификаторДела);

	Если Не ЗначениеЗаполнено(ТипВладельца) Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;

	СтруктураНастроек 	= Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения,
		Истина);
	Если СтруктураНастроек = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось подключиться");
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;

	СтруктураНастроек.Логирование.Измерение2 = "Выгрузка дел";
	ТипыОбъектовОбмена = СтруктураНастроек.ТипыОбъектовОбмена;
	Если ТипДанных = ТипыОбъектовОбмена.ДелоКомпании Или ТипДанных = ТипыОбъектовОбмена.ДелоКонтакта Или ТипДанных
		= ТипыОбъектовОбмена.ДелоСчета Или ТипДанных = ТипыОбъектовОбмена.ДелоСделки Или ТипДанных
		= ТипыОбъектовОбмена.ДелоЛида Или ТипДанных = ТипыОбъектовОбмена.ДелоСмартПроцесса Тогда
		ВидДела = "Стандартное";
	Иначе
		ВидДела = "Конфигурируемое";
	КонецЕсли;

	HTTPЗапросДела 	= ПолучитьТелоЗапросаДела(СтруктураНастроек, ВидДела, ТипВладельца, ИдентификаторВладельца, "N",
		ОбъектСсылка, , Истина);
	ТелоHTTPЗапроса = ПолучитьЗапросДела(СтруктураНастроек, ВидДела, "N", ИдентификаторДела, HTTPЗапросДела);

	Если Не ЗначениеЗаполнено(ТелоHTTPЗапроса) Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;

	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
	Если СтруктураОтвета = Неопределено Тогда
		СтруктураНастроек.ВыполненоБезОшибок = Ложь;
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;

	Попытка
		result = СтруктураОтвета.Получить("result");
		Если result <> Неопределено Тогда
			result2 = result.Получить("result");
			Если ЗначениеЗаполнено(result2) Тогда

				Если Не ЗначениеЗаполнено(ИдентификаторДела) Тогда

					result3 = result2.Получить("N");
					Если ТипЗнч(result3) = Тип("Соответствие") Тогда
						activity = result3.Получить("activity");
						Если activity <> Неопределено Тогда
							ИдентификаторДела = Формат(activity.Получить("id"), "ЧГ=0");
						КонецЕсли;
					Иначе
						ИдентификаторДела = Формат(result3, "ЧГ=0");
					КонецЕсли;

					Если ТипДанных = ТипыОбъектовОбмена.ДелоСмартПроцесса Или ТипДанных
						= ТипыОбъектовОбмена.КонфигурируемоеДелоСмартПроцесса Тогда
						ИдентификаторДела = ТипВладельца + "_" + ИдентификаторДела;
					КонецЕсли;

					РегистрыСведений.Б24_К_ИдентификаторыДел.ЗаписатьИдБ24Объекта(СтруктураНастроек, ТипДанных,
						ОбъектСсылка, ИдентификаторДела, ИдентификаторВладельца);

				КонецЕсли;

			КонецЕсли;
		КонецЕсли;

		Если ЭтоНовый Тогда
			Б24_КА_РоботыИТриггерыСервер.ОбработкаСобытияТриггера(ОбъектСсылка, "ИзменениеДокумента");
			Б24_КА_РоботыИТриггерыСервер.ПроверитьЗапуститьТриггерПроведенияДокумента(ОбъектСсылка);
		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации("ДобавлениеСвязиЧерезДело", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось Выгрузить Информацию Дела ВФоне Битрикс24");
	КонецПопытки;

	~КонецПроцедурыВФоне: 
	
	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);

КонецПроцедуры

#КонецОбласти


#Область РаботаСДелами

Функция ПолучитьИспользуемыеНастройкиПодключенияОбъектомЧерезДела(Объект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;     
	Запрос.УстановитьПараметр("ТипОбъекта"			, Объект.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", XMLСтрока(Объект));
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Б24_КБ_ОбъектыСозданныеЧерезСлайдер.НастройкаПодключения КАК НастройкаПодключения
	|ИЗ
	|	РегистрСведений.Б24_КБ_ОбъектыСозданныеЧерезСлайдер КАК Б24_КБ_ОбъектыСозданныеЧерезСлайдер
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|		ПО Б24_КБ_ОбъектыСозданныеЧерезСлайдер.НастройкаПодключения = Б24_К_НастройкиПодключения.Ссылка
	|ГДЕ
	|	Б24_КБ_ОбъектыСозданныеЧерезСлайдер.ТипОбъекта = &ТипОбъекта
	|	И Б24_КБ_ОбъектыСозданныеЧерезСлайдер.ИдентификаторОбъекта = &ИдентификаторОбъекта
	|	И Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	тзнДанных = Запрос.Выполнить().Выгрузить();
	
	Возврат тзнДанных.ВыгрузитьКолонку("НастройкаПодключения");
	
КонецФункции

Функция ОбъектуПривязаныДела(Объект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипыДанных"			, Б24_К_RestApiВызовСервера.ПолучитьТипыДанныхДел());
	Запрос.УстановитьПараметр("ТекущийОбъект"		, Объект);
	Запрос.УстановитьПараметр("ТипОбъекта"			, Объект.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", XMLСтрока(Объект));
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Б24_К_ИдентификаторыДел.ТипДанных КАК ТипДанных,
	|	Б24_К_ИдентификаторыДел.Портал КАК Портал,
	|	Б24_К_ИдентификаторыДел.Идентификатор КАК Идентификатор,
	|	Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор КАК ДополнительныйИдентификатор
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.ТипДанных В(&ТипыДанных)
	|	И Б24_К_ИдентификаторыДел.ТипОбъекта = &ТипОбъекта
	|	И Б24_К_ИдентификаторыДел.ИдентификаторОбъекта = &ИдентификаторОбъекта";
	ВыполненныйЗапрос = Запрос.Выполнить();  
	
	Возврат	НЕ ВыполненныйЗапрос.Пустой();
	
КонецФункции

Функция ДобавитьСвязкуСДокументомОснования(Объект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	Если ОбъектуПривязаныДела(Объект) Тогда	
		Возврат Результат;
	КонецЕсли;
	
	мДокументыОснования = ПолучитьДокументыОснования(Объект);
	
	КС = Новый КвалификаторыСтроки(100);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));    
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);  
	
	ОписаниеДокументовОснований = Новый ТаблицаЗначений;
	ОписаниеДокументовОснований.Колонки.Добавить("ТипОбъекта"			, ОписаниеТиповС);	
	ОписаниеДокументовОснований.Колонки.Добавить("ИдентификаторОбъекта"	, ОписаниеТиповС);	
	
	Для каждого ТекЭлемент Из мДокументыОснования Цикл      
		
		Если НЕ ЗначениеЗаполнено(ТекЭлемент) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ЭтоПростойТип(ТипЗнч(ТекЭлемент)) Тогда
			НоваяСтрока = ОписаниеДокументовОснований.Добавить();    
			НоваяСтрока.ТипОбъекта 				= ТекЭлемент.Метаданные().ПолноеИмя();
			НоваяСтрока.ИдентификаторОбъекта 	= XMLСтрока(ТекЭлемент);
		КонецЕсли;
		
	КонецЦикла;      
	
	ОграниченияПоСозданиюДел = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиПодключенияСЗапретомНаСозданияДелНаОсновании(Объект.Метаданные().ПолноеИмя());
	
	ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();	
	ТипыДанныхДел 				 = Б24_К_RestApiВызовСервера.ПолучитьТипыДанныхДел();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипыДанных"					, ТипыДанныхДел);
	Запрос.УстановитьПараметр("ДокументыОснования"			, мДокументыОснования);
	Запрос.УстановитьПараметр("ОписаниеДокументовОснований"	, ОписаниеДокументовОснований);
	Запрос.Текст = "ВЫБРАТЬ
	|	ОписаниеДокументовОснований.ТипОбъекта КАК ТипОбъекта,
	|	ОписаниеДокументовОснований.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	|ПОМЕСТИТЬ ВТ_ОписаниеДокументовОснований
	|ИЗ
	|	&ОписаниеДокументовОснований КАК ОписаниеДокументовОснований
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Б24_К_НастройкиПодключения.Ссылка КАК НастройкаПодключения,
	|	Б24_К_ИдентификаторыДел.ТипДанных КАК ТипДанных,
	|	Б24_К_ИдентификаторыДел.Портал КАК Портал,
	|	Б24_К_ИдентификаторыДел.Идентификатор КАК Идентификатор,
	|	Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор КАК ДополнительныйИдентификатор,
	|	Б24_К_ИдентификаторыДел.ТипОбъекта КАК ТипОбъекта,
	|	Б24_К_ИдентификаторыДел.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|		ПО Б24_К_ИдентификаторыДел.Портал = Б24_К_НастройкиПодключения.Портал
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОписаниеДокументовОснований КАК ОписаниеДокументовОснований
	|		ПО Б24_К_ИдентификаторыДел.ТипОбъекта = ОписаниеДокументовОснований.ТипОбъекта
	|			И Б24_К_ИдентификаторыДел.ИдентификаторОбъекта = ОписаниеДокументовОснований.ИдентификаторОбъекта
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.ТипДанных В(&ТипыДанных)
	|	И Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ОграниченияПоСозданиюДел.Найти(Выборка.НастройкаПодключения) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяЗапись = РегистрыСведений.Б24_К_ИдентификаторыДел.СоздатьМенеджерЗаписи();
			
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
			НоваяЗапись.ТипОбъекта 					= Объект.Метаданные().ПолноеИмя();
			НоваяЗапись.ИдентификаторОбъекта		= XMLСтрока(Объект);
			НоваяЗапись.Идентификатор				= "";
			
			Если НоваяЗапись.ТипДанных = ТипыДанныхДляОбменаСПорталом.ДелоСмартПроцесса Тогда
				ЧастиИдентификатора = СтрРазделить(Выборка.Идентификатор, "_");	
				Если ЧастиИдентификатора.Количество()>0 Тогда
					НоваяЗапись.Идентификатор = ЧастиИдентификатора[0] + "_";
				КонецЕсли;
			КонецЕсли;
			
			НоваяЗапись.Записать();   
			
			Результат = Истина;
			
		КонецЦикла;
		
	КонецЕсли;  
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДокументыОснования(Объект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);   
	
	мДокументыОснования = Новый Массив;
	
	Попытка  //опасно без попытки.

		МетаданныеОбъекта = Объект.Метаданные();

		КлючиПоиска = Новый Массив;                                
		
		ИсключенияИменаРеквизитов = ИсключенияИменаРеквизитовДляСозданияДелНаОсновании();  
		
		мГруппыРеквизитов = Новый Массив;
		мГруппыРеквизитов.Добавить(МетаданныеОбъекта.Реквизиты);	
		мГруппыРеквизитов.Добавить(МетаданныеОбъекта.СтандартныеРеквизиты);	
		
		Для каждого ТекТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл       
			Если ТекТабЧасть.Имя = "ДополнительныеРеквизиты" Тогда
				Продолжить;
			КонецЕсли;
			мГруппыРеквизитов.Добавить(Новый Структура("ИмяТЧ, Реквизиты", ТекТабЧасть.Имя, ТекТабЧасть.Реквизиты))
		КонецЦикла;	
		
		Для каждого ГруппаРеквизитов Из мГруппыРеквизитов Цикл
			
			КоллекцияРеквизитов = Неопределено;   
			ИмяТЧ				= "";
			Если ТипЗнч(ГруппаРеквизитов) = Тип("Структура") Тогда
				КоллекцияРеквизитов = ГруппаРеквизитов.Реквизиты;
				ИмяТЧ				= ГруппаРеквизитов.ИмяТЧ;
			Иначе
				КоллекцияРеквизитов = ГруппаРеквизитов;		
			КонецЕсли; 
			
			Для каждого ТекРеквизит Из КоллекцияРеквизитов Цикл
				
				Если ИсключенияИменаРеквизитов.Найти(ТекРеквизит.Имя) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
					
				Для каждого ТипРеквизита Из ТекРеквизит.Тип.Типы() Цикл    
					
					Если ИсключениеТиповДляСозданияДелНаОсновании(Объект, ТипРеквизита) Тогда
						Продолжить;
					КонецЕсли;
					
					МетаданныеПоТипу = Метаданные.НайтиПоТипу(ТипРеквизита);
					Если МетаданныеПоТипу <> Неопределено Тогда  
						Если МетаданныеОбъекта.ВводитсяНаОсновании.Содержит(МетаданныеПоТипу) Тогда
							КлючиПоиска.Добавить(Новый Структура("ИмяТЧ, ИмяРеквизита", ИмяТЧ, ТекРеквизит.Имя));
						КонецЕсли;	
					КонецЕсли;
					
				КонецЦикла; 
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
			Если ТипЗнч(Объект) = Тип("ДокументСсылка.СчетФактураВыданный") И КлючиПоиска.Количество() = 0 Тогда
				КлючиПоиска.Добавить(Новый Структура("ИмяТЧ, ИмяРеквизита", "", "ДокументОснование"));
			КонецЕсли;
		КонецЕсли;
		
		ИспользуемыеТЧ 		= Новый Соответствие;
		РеквизитыСтрокой 	= "";
		Для каждого ТекЭлемент Из КлючиПоиска Цикл          
			Если НЕ ЗначениеЗаполнено(ТекЭлемент.ИмяТЧ) Тогда       
				Если СтрНайти(РеквизитыСтрокой, ТекЭлемент.ИмяРеквизита) = 0 Тогда
					РеквизитыСтрокой = ?(РеквизитыСтрокой = "", ТекЭлемент.ИмяРеквизита, РеквизитыСтрокой + ", " + ТекЭлемент.ИмяРеквизита);
				КонецЕсли;
			Иначе
				
				КлючТЧ = ИспользуемыеТЧ.Получить(ТекЭлемент.ИмяТЧ);
				Если КлючТЧ = Неопределено Тогда КлючТЧ = Новый Массив КонецЕсли;  
				КлючТЧ.Добавить(ТекЭлемент.ИмяРеквизита);
				
				ИспользуемыеТЧ.Вставить(ТекЭлемент.ИмяТЧ, КлючТЧ); 
					
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(РеквизитыСтрокой) Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, РеквизитыСтрокой);   
			Для каждого ТекКлюч Из ЗначенияРеквизитов Цикл
				Если ЗначениеЗаполнено(ТекКлюч.Значение) Тогда  
					Если мДокументыОснования.Найти(ТекКлюч.Значение) = Неопределено И ТекКлюч.Значение <> Объект Тогда 
						мДокументыОснования.Добавить(ТекКлюч.Значение);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
		
		Для каждого ТекКлюч Из ИспользуемыеТЧ Цикл
			
			Выборка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, ТекКлюч.Ключ).Выбрать();   
			Пока Выборка.Следующий() Цикл       
				Для каждого ТекРеквизит Из ТекКлюч.Значение Цикл      
					Если ЗначениеЗаполнено(Выборка[ТекРеквизит]) Тогда  
						Если мДокументыОснования.Найти(Выборка[ТекРеквизит]) = Неопределено Тогда 
							мДокументыОснования.Добавить(Выборка[ТекРеквизит]);
						КонецЕсли;  
					КонецЕсли;  
				КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;      
		
	Исключение
		ЗаписьЖурналаРегистрации("ДобавлениеСвязиЧерезДело", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось привязать объект к сущности Битрикс24");
	КонецПопытки;       
	
	Возврат мДокументыОснования;

КонецФункции

Функция ИсключениеТиповДляСозданияДелНаОсновании(Объект, ТипРеквизита)     
	
	Результат = Ложь;
	
	Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
		
	ИначеЕсли Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "БП"
		или Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "УНФ" Тогда
			
		ТипКонтрагент = "СправочникСсылка.Контрагенты";
		ТипДоговор = "СправочникСсылка.ДоговорыКонтрагентов";
		Если ТипРеквизита = Тип(ТипКонтрагент) Тогда
			Результат = Истина;  
		ИначеЕсли ТипРеквизита = Тип(ТипДоговор) Тогда
			Результат = Истина;
		КонецЕсли;
		
	Иначе
		
		Если ТипРеквизита = Тип("СправочникСсылка.Контрагенты") Тогда
			Результат = Истина;  
		ИначеЕсли ТипРеквизита = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			Результат = Истина; 
		ИначеЕсли ТипРеквизита = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Партнеры") Тогда
			Результат = Истина;   
		ИначеЕсли ТипРеквизита = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.СоглашенияСКлиентами") Тогда
			Результат = Истина;			
		КонецЕсли;
		
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ИсключенияИменаРеквизитовДляСозданияДелНаОсновании()     

	Результат = Новый Массив;     
	
	Результат.Добавить("ОснованиеПечатиСсылка");
	Результат.Добавить("Субконто");
	
	Возврат Результат;

КонецФункции

Процедура ОбработатьИдентификаторДела(ИдентификаторДела)

	РазделенныйИдентификатор = СтрРазделить(ИдентификаторДела, "_");
	Если РазделенныйИдентификатор.Количество() > 1 Тогда
		ИдентификаторДела = РазделенныйИдентификатор[1];
	КонецЕсли; 
	
КонецПроцедуры

