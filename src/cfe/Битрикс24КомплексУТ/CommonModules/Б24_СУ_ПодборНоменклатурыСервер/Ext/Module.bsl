
#Область productSeach

Процедура productSearch(ПередаваемыеПараметры, АдресРезультата) Экспорт
	
	НастройкаПодключения 	= ПередаваемыеПараметры. НастройкаПодключения;
	//Портал 					= ПередаваемыеПараметры.Портал;
	ИдСессии 				= ПередаваемыеПараметры.ИдСессии;
	СтрокаПоиска 			= ПередаваемыеПараметры.СтрокаПоиска;

	ДанныеДляПередачи = ПолучитьДанныеПоСтрокеПоиска(НастройкаПодключения, СтрокаПоиска);
	
	ВернутьСписокНайденныхТоваров(НастройкаПодключения, ИдСессии, ДанныеДляПередачи);

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);
	
КонецПроцедуры

Функция ПолучитьДанныеПоСтрокеПоиска(НастройкаПодключения, СтрокаПоиска) Экспорт 
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	НастройкиПоНастройкеПодключения = Б24_СУ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПоНастройкеПодключения(НастройкаПодключения);
	СохраненныеНастройки = НастройкиПоНастройкеПодключения.Настройки.Получить();
	
	НастройкиЦен 		= СохраненныеНастройки.НастройкиЦен;
	НастройкиОстатков 	= СохраненныеНастройки.НастройкиОстатков;
	
	Прайс = Неопределено;
	Для каждого ТекСтрока Из НастройкиЦен.Прайсы Цикл
		Если ТекСтрока.Базовый Тогда Прайс = ТекСтрока.Прайс1С КонецЕсли;
	КонецЦикла;     
	
	ДанныеДляПередачи = Новый Массив;      
	
	СхемаВыгрузки = РегистрыСведений.Б24_СУ_Настройки.ПолучитьМакет("СхемаВыгрузкиНоменклатуры");
	
	
	Если СохраненныеНастройки.НастройкиТоваров.Свойство("ФильтрыНоменклатуры") Тогда
		НастройкиКомпоновщикаИзНастройки = СохраненныеНастройки.НастройкиТоваров.ФильтрыНоменклатуры;	
	Иначе
		НастройкиКомпоновщикаИзНастройки = Неопределено;	
	КонецЕсли;
	
    КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
    КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаВыгрузки)); 
    Если ЗначениеЗаполнено(НастройкиКомпоновщикаИзНастройки) Тогда
    	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновщикаИзНастройки);
    	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
    Иначе
    	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаВыгрузки.НастройкиПоУмолчанию);
    КонецЕсли;
	
    Для Каждого ТекПараметрСКД Из КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл    
    	
    	Если ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("ДатаФормирования") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= ТекущаяДатаСеанса(); 	
   		ИначеЕсли ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("Прайс") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= Прайс; 
    	ИначеЕсли ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("Прайсы") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= НастройкиЦен.Прайсы.ВыгрузитьКолонку("Прайс1С"); 	
    	ИначеЕсли ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("Склады") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= НастройкиОстатков.Склады.ВыгрузитьКолонку("Склад1С"); 
		ИначеЕсли ТипКонфигурации = "БП"
			и ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("СчетаОстатков") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= НастройкиОстатков.СчетаОстатков; 
    	ИначеЕсли ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("СтрокаПоиска") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= "%" + СтрокаПоиска + "%";
    	ИначеЕсли ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("СтрокаПоискаСНачала") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= СтрокаПоиска + "%";
		ИначеЕсли ТипКонфигурации = "УТ"
			и ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("ИспользуетсяЦО20") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ФункциональнаяОпцияВключена("ИспользуетсяЦенообразование20") = Истина;   
		ИначеЕсли ТипКонфигурации = "УТ"
			и ТекПараметрСКД.Параметр = Новый ПараметрКомпоновкиДанных("ИспользуетсяЦО25") Тогда
    		ТекПараметрСКД.Использование 	= Истина;
    		ТекПараметрСКД.Значение 		= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ФункциональнаяОпцияВключена("ИспользуетсяЦенообразование25") = Истина;   
		КонецЕсли;

    КонецЦикла;

    Запрос = Новый Запрос;
    
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
    
    МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаВыгрузки, КомпоновщикНастроек.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанных"));
    Запрос.Текст = МакетКомпоновкиДанных.НаборыДанных.ОсновнойНаборДанных.Запрос;
    
    Для каждого Параметр Из МакетКомпоновкиДанных.ЗначенияПараметров Цикл
    	Запрос.Параметры.Вставить(Параметр.Имя, Параметр.Значение);
	КонецЦикла;
	
	Если ТипКонфигурации = "БП" Тогда
		УчетВалютныхОперацийИспользуются = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.УчетВалютныхОперацийИспользуются();
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		ХарактеристикиНоменклатурыИспользуются = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ХарактеристикиНоменклатурыИспользуются();
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		ХарактеристикиНоменклатурыИспользуются = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ХарактеристикиНоменклатурыИспользуются();
		УчетВалютныхОперацийИспользуются = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.УчетВалютныхОперацийИспользуются();
	КонецЕсли;
	
	ВыполненныйЗапрос = Запрос.Выполнить();  
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ТипКонфигурации = "УТ"
				и ХарактеристикиНоменклатурыИспользуются Тогда
				ИдентификаторСтроки = XMLСтрока(Выборка.Номенклатура) + "#" + XMLСтрока(Выборка.Характеристика);
			Иначе
				ИдентификаторСтроки = XMLСтрока(Выборка.Номенклатура);
			КонецЕсли;
			
			НаименованиеПозиции = Выборка.НаименованиеПозиции;  
			Если ЗначениеЗаполнено(Выборка.Цена) Тогда
				Если ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "УНФ" Тогда
					НаименованиеПозиции = НаименованиеПозиции + " (" + Формат(Выборка.Цена, "") + ?(УчетВалютныхОперацийИспользуются, " " + Выборка.Валюта, "") + ")";  
				ИначеЕсли ТипКонфигурации = "УТ" Тогда
					НаименованиеПозиции = НаименованиеПозиции + " (" + Формат(Выборка.Цена, "") + ")";  
				КонецЕсли;
			КонецЕсли;
			
			ДанныеОТоваре = Новый Структура;
			ДанныеОТоваре.Вставить("id"	 , ИдентификаторСтроки);
			ДанныеОТоваре.Вставить("name", НаименованиеПозиции);   
			
			ДанныеДляПередачи.Добавить(ДанныеОТоваре);				
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ДанныеДляПередачи;
	
КонецФункции

Процедура ВернутьСписокНайденныхТоваров(НастройкаПодключения, ИдСессии, ДанныеДляПередачи)
	
	СтрJSON = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеДляПередачи);
	
	СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка товаров";
	Если СтруктураНастроек <> Неопределено Тогда
		
		Если ДанныеДляПередачи.Количество() > 0 Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Выгрузка на портал найденный список товаров");
		КонецЕсли;
		
		ТелоЗапроса = "&COMMAND=productSearchResult&MODULE_ID=1ctotal&PARAMS[session]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСессии)+"&PARAMS[data]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(СтрJSON);
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти    


#Область uploadProduct

Процедура uploadProduct(ПередаваемыеПараметры, АдресРезультата) Экспорт
	
	НастройкаПодключения = ПередаваемыеПараметры. НастройкаПодключения;
	//Портал 			= ПередаваемыеПараметры.Портал;
	ИдСессии 		= ПередаваемыеПараметры.ИдСессии;
	ИдСтрокиТовара 	= ПередаваемыеПараметры.ИдСтрокиТовара;
	
	ИдентификаторВариации = ВыгрузитьДанныеТовара(НастройкаПодключения, ИдСтрокиТовара);	
	
	ВернутьИдВыгруженногоТовара(НастройкаПодключения, ИдСессии, ИдентификаторВариации);

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);
	
КонецПроцедуры

Процедура ВернутьИдВыгруженногоТовара(НастройкаПодключения, ИдСессии, ИдентификаторВариации)
	
	СтруктураНастроек 	= Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек <> Неопределено Тогда
		ТелоЗапроса = "&COMMAND=uploadProductResult&MODULE_ID=1ctotal&PARAMS[session]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСессии)+"&PARAMS[data]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторВариации);
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	КонецЕсли;
		
КонецПроцедуры

Функция ВыгрузитьДанныеТовара(НастройкаПодключения,  ИдСтрокиТовара, пНоменклатура = Неопределено, пХарактеристика = Неопределено) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ИдентификаторВариации = "";	
	СтруктураНастроек = Б24_СУ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если СтруктураНастроек = Неопределено Тогда
		Возврат ИдентификаторВариации;	
	КонецЕсли;

	СтруктураНастроек.Вставить("ИдентификаторыНовыхОбъектов", Новый Соответствие);
	Если ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
		СтруктураИдентификаторовТовара = Б24_КС_ОбщегоНазначенияВызовСервера.ПолучитьДвеСоставныеЧастиИзСтроки(ИдСтрокиТовара, "#");
	КонецЕсли;
	Если ЗначениеЗаполнено(ИдСтрокиТовара) Тогда
		Номенклатура = Неопределено;
		Если ТипКонфигурации = "БП" Тогда		
			Номенклатура = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Номенклатура"), ИдСтрокиТовара);
		ИначеЕсли ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
			Если ЗначениеЗаполнено(СтруктураИдентификаторовТовара.ПерваяЧасть) Тогда
				Номенклатура = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Номенклатура"), СтруктураИдентификаторовТовара.ПерваяЧасть);
			КонецЕсли;				
		КонецЕсли;
		
		Если Номенклатура = Неопределено Тогда
			Возврат ИдентификаторВариации;
		КонецЕсли;
		
		Если ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
			Характеристика = Неопределено;
			Если ЗначениеЗаполнено(СтруктураИдентификаторовТовара.ВтораяЧасть) И СтруктураИдентификаторовТовара.ВтораяЧасть <> "00000000-0000-0000-0000-000000000000" Тогда
				Характеристика = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.ХарактеристикиНоменклатуры"), СтруктураИдентификаторовТовара.ВтораяЧасть);
			КонецЕсли;				
		КонецЕсли;		
	Иначе
		Номенклатура = пНоменклатура;
		Если ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
			Характеристика 	= пХарактеристика;				
		КонецЕсли;
	КонецЕсли;
	
	Если ТипКонфигурации = "БП" Тогда
		КлючТовара 	= XMLСтрока(Номенклатура);  
		КлючВариации= XMLСтрока(Номенклатура) + "#" + XMLСтрока(Номенклатура);					
	ИначеЕсли ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
		ЕстьХарактеристика = ЗначениеЗаполнено(Характеристика);
		КлючТовара = XMLСтрока(Номенклатура);  
		Если ЕстьХарактеристика Тогда
			КлючВариации 	= XMLСтрока(Номенклатура)+"#"+XMLСтрока(Характеристика);    
			Вариация 		= Характеристика;	
		Иначе
			КлючВариации 	= XMLСтрока(Номенклатура)+"#"+XMLСтрока(Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка()); 
			Вариация 		= Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка();	
		КонецЕсли;					
	КонецЕсли;	 
	
	Склады = Новый Массив;
	Если СтруктураНастроек.НастройкиОстатков.Свойство("Склады") Тогда
		Склады = СтруктураНастроек.НастройкиОстатков.Склады;
	КонецЕсли; 
	
	Прайсы = Новый Массив;
	Если СтруктураНастроек.НастройкиЦен.Свойство("Прайсы") Тогда
		Прайсы = СтруктураНастроек.НастройкиЦен.Прайсы;
	КонецЕсли; 
	
	МВТСвойствНоменклатуры = Новый МенеджерВременныхТаблиц;       
	МВТСвойствОбъекта(СтруктураНастроек, Номенклатура, "Товар", МВТСвойствНоменклатуры);	
	Если ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
		Если ЕстьХарактеристика Тогда
			МВТСвойствХарактеристик = Новый МенеджерВременныхТаблиц;       
			МВТСвойствОбъекта(СтруктураНастроек, Характеристика, "Вариация", МВТСвойствХарактеристик);     
		Иначе
			МВТСвойствХарактеристик = Неопределено;
		КонецЕсли;					
	КонецЕсли;
	
#Область ЗапросТоваров
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал"	, СтруктураНастроек.Портал);	
	Запрос.УстановитьПараметр("Товар"	, Номенклатура);	
	Запрос.УстановитьПараметр("ТипДанныхТовар", СтруктураНастроек.ТипыОбъектовОбмена.Товар2);	
