	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		мБатчЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.storeproduct.bulksave?" + ТелоЗапроса));	
	КонецЕсли;
#КонецОбласти 

	ОбъеденитьЗапросыВыгрузить(СтруктураНастроек, мБатчЗапросы);	
	Если ТипКонфигурации = "БП" Тогда
		ИдентификаторВариации = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Предложение, Номенклатура);  
	ИначеЕсли ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
		ИдентификаторВариации = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Предложение, Номенклатура, Вариация);  
		#Область Картинки     
		Если ЗначениеЗаполнено(ИдентификаторВариации) Тогда			
			Если СтруктураНастроек.НастройкиТоваров.ВыгружатьКартинки Тогда				
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					ВыборкаКартинок = Справочники["НоменклатураПрисоединенныеФайлы"].Выбрать(,,Новый Структура("ВладелецФайла", Номенклатура));
					Пока ВыборкаКартинок.Следующий() Цикл;
						РегистрыСведений.Б24_СУ_ТаблицаИзменений.ДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, СтруктураНастроек.ТипыОбъектовОбмена.КартинкаФайлТовара2, Неопределено, ВыборкаКартинок.Ссылка); 
					КонецЦикла;
				КонецЕсли;
				Если ТипКонфигурации = "УНФ" Тогда
					Если ЗначениеЗаполнено(Характеристика) Тогда
						ВыборкаКартинок = Справочники["ХарактеристикиНоменклатурыПрисоединенныеФайлы"].Выбрать(,,Новый Структура("ВладелецФайла", Характеристика));
						Пока ВыборкаКартинок.Следующий() Цикл;
							РегистрыСведений.Б24_СУ_ТаблицаИзменений.ДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, СтруктураНастроек.ТипыОбъектовОбмена.КартинкаФайлПредложения, Неопределено, ВыборкаКартинок.Ссылка); 
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		Если СтруктураНастроек.НастройкиТоваров.ВыгружатьКартинки И СтруктураНастроек.НастройкиТоваров.СпособВыгрузки = "ВРежимеРеальногоВремени" Тогда
			ТипыОпераций 				 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыОпераций();
			ИменаИспользуемыхРеглЗаданий = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий(); 
			НаименованиеФоновогоЗадания = ИменаИспользуемыхРеглЗаданий.ВыгрузкаКартинок + " на: " + СтруктураНастроек.Портал;  
			Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.СейчасВыполняетсяЗадание(НаименованиеФоновогоЗадания) Тогда
				УникальныйИдентификатор = Новый УникальныйИдентификатор;
				ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
				ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеФоновогоЗадания;
				ПараметрыВыполнения.ОжидатьЗавершение = 0;            
				
				мТипыОпераций = Новый Массив;
				мТипыОпераций.Добавить(ТипыОпераций.КартинкиФайлыТоваров);	
				мТипыОпераций.Добавить(ТипыОпераций.КартинкиФайлыПредложений);	
				ПараметрыВыгрузки = Б24_СУ_ОбщегоНазначенияВызовСервера.ПараметрыВыполненияОбменаВФоне(НастройкаПодключения, мТипыОпераций, Истина);
				ДлительныеОперации.ВыполнитьВФоне("Б24_СУ_ОбщегоНазначенияВызовСервера.ВыполнитьОбменВФоне", ПараметрыВыгрузки, ПараметрыВыполнения);
			КонецЕсли;			
		КонецЕсли;
		#КонецОбласти 					
	КонецЕсли;
	
		Возврат ИдентификаторВариации;
	
КонецФункции

#Область ФормированиеРестЗапросов

Функция РестЗапросСвойстваОбъекта(СтруктураНастроек, ИнформацияСвойства, ТипДанных="", Пакет="", ЭтоНовыйЭлемент="")
	
	КлючСвойства = XMLСтрока(ИнформацияСвойства.Свойство);	
	
	Если ИнформацияСвойства.Тип = "СвойствоТовара" Тогда
		ИдИнфоблока = СтруктураНастроек.НастройкиТоваров.ИдентификаторКаталогаТоваров;
		ТипДанных 	= СтруктураНастроек.ТипыОбъектовОбмена.СвойствоТовара2; 
	Иначе
		ИдИнфоблока = СтруктураНастроек.НастройкиТоваров.ИдентификаторКаталогаПредложений;
		ТипДанных 	= СтруктураНастроек.ТипыОбъектовОбмена.СвойствоПредложения; 
	КонецЕсли;
	
	Поля = Новый Структура;
	Поля.Вставить("iblockId"	, ИдИнфоблока);
	Поля.Вставить("xmlId"		, ИнформацияСвойства.Свойство);
	Поля.Вставить("name"		, ИнформацияСвойства.Заголовок);
	Поля.Вставить("multiple"	, "N");
	Поля.Вставить("isRequired"	, "N");
	Поля.Вставить("active"		, "Y");  	
	Поля.Вставить("listType"	, "L");    
	Поля.Вставить("propertyType", "S");  

	ТипЗначенияСвойства = ИнформацияСвойства.ТипЗначения;	
	Если ТипЗначенияСвойства.СодержитТип(Тип("Строка")) Тогда
		Если ИнформацияСвойства.ТипЗначения.КвалификаторыСтроки.Длина = 0 Тогда
			Поля.Вставить("userType", "HTML");  
		Иначе
			Поля.Вставить("userType", "");  
		КонецЕсли;
	ИначеЕсли ТипЗначенияСвойства.СодержитТип(Тип("Число")) Тогда
		Поля.Вставить("propertyType", "N");  
	ИначеЕсли ТипЗначенияСвойства.СодержитТип(Тип("Дата")) Тогда
		Если ИнформацияСвойства.ТипЗначения.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.ДатаВремя Тогда 
			Поля.Вставить("userType", "DateTime"); 
		Иначе
			Поля.Вставить("userType", "Date"); 
		КонецЕсли;
	ИначеЕсли ТипЗначенияСвойства.СодержитТип(Тип("Булево")) Тогда
		Поля.Вставить("listType"	, "C");                         
		Поля.Вставить("propertyType", "L"); 
		Поля.Вставить("userType"	, "BoolEnum"); 
	ИначеЕсли ТипЗначенияСвойства.СодержитТип(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.ЗначенияСвойствОбъектов")) Тогда
		Поля.Вставить("propertyType", "L"); 
	КонецЕсли;
	
	ТелоЗапроса = "";
	Для каждого ТекПоле Из Поля Цикл
		ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
	КонецЦикла;  
	
	СтрокаЗапроса = "cmd["+КлючСвойства+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.productProperty.add?" + ТелоЗапроса);	
	
	СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючСвойства, ПолучитьСтруктуруКлючаБатчЗапроса(ТипДанных, ИнформацияСвойства.Свойство));	
	
	Возврат СтрокаЗапроса;
	
КонецФункции

Функция РестЗапросЗначенияСвойстваОбъекта(СтруктураНастроек, ИнформацияЗначенияСвойства)

	ИдентификаторСвойства = ИнформацияЗначенияСвойства.ИдентификаторСвойства;
	
	Если Не ЗначениеЗаполнено(ИдентификаторСвойства) Тогда    
		ИдентификаторСвойства = СтруктураНастроек.ИдентификаторыНовыхОбъектов.Получить(ИнформацияЗначенияСвойства.Свойство);
	КонецЕсли;    
	
	Если Не ЗначениеЗаполнено(ИдентификаторСвойства) Тогда    
		ИдентификаторСвойства = "$result["+XMLСтрока(ИнформацияЗначенияСвойства.Свойство)+"][productProperty][id]";
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторСвойства) Тогда
		Возврат "";
	КонецЕсли; 
	
	Если ИнформацияЗначенияСвойства.Тип = "СвойствоТовараЗС" Тогда
		ТипДанных 	= СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваТовара2; 
	Иначе
		ТипДанных 	= СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваПредложения; 
	КонецЕсли;
	
	КлючЭлемента = XMLСтрока(ИнформацияЗначенияСвойства.ЗначениеСвойства);	
	
	Поля = Новый Структура;
	//Поля.Вставить("propertyId"	, ИдентификаторСвойства);
	Поля.Вставить("xmlId"		, КлючЭлемента);
	Поля.Вставить("value"		, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИнформацияЗначенияСвойства.ЗначениеСвойства, "Наименование"));
	
	ТелоЗапроса = "";
	Для каждого ТекПоле Из Поля Цикл
		ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
	КонецЦикла;  
	
	ТелоЗапроса = ТелоЗапроса + "&fields[propertyId]="+ИдентификаторСвойства; 
	
	СтрокаЗапроса = "cmd["+КлючЭлемента+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.productPropertyEnum.add?" + ТелоЗапроса);	
	
	СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючЭлемента, ПолучитьСтруктуруКлючаБатчЗапроса(ТипДанных, ИнформацияЗначенияСвойства.ЗначениеСвойства));	
	
	Возврат СтрокаЗапроса;
	
КонецФункции
 
Функция РестЗапросЕдиницыИзмерения(СтруктураНастроек, ИнформацияЕдиницыИзмерения)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	КлючЕдИзм = XMLСтрока(ИнформацияЕдиницыИзмерения.ЕдиницаИзмерения);	
	Поля = Новый Структура;
	
	Если НЕ ЗначениеЗаполнено(ИнформацияЕдиницыИзмерения.КодЕдИзм) Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "У единицы измерения: " + ИнформацияЕдиницыИзмерения.НаименованиеЕдИзм + ". Пустой код, единица не будет выгружена в Битрикс24");
		Возврат "";	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИнформацияЕдиницыИзмерения.НаименованиеЕдИзм) Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "У единицы измерения: " + ИнформацияЕдиницыИзмерения.НаименованиеЕдИзм + ". Пустое Наименование, единица не будет выгружена в Битрикс24");
		Возврат "";	
	КонецЕсли;
	
	Поля.Вставить("code"				, ИнформацияЕдиницыИзмерения.КодЕдИзм);  	
	Поля.Вставить("symbol"				, ИнформацияЕдиницыИзмерения.НаименованиеЕдИзм);
	Поля.Вставить("measureTitle"		, ИнформацияЕдиницыИзмерения.НаименованиеПолноеЕдИзм);   
	Если ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
		Поля.Вставить("symbolIntl"			, ИнформацияЕдиницыИзмерения.МеждународноеСокращениеЕдИзм);
		Поля.Вставить("symbolLetterIntl"	, ИнформацияЕдиницыИзмерения.МеждународноеСокращениеЕдИзм);
	КонецЕсли;
	ТелоЗапроса = "";
	
	Для каждого ТекПоле Из Поля Цикл
		
		ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
		
	КонецЦикла;  
	
	СтрокаЗапроса = "cmd["+КлючЕдИзм+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.measure.add?" + ТелоЗапроса);	
	
	СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючЕдИзм, ПолучитьСтруктуруКлючаБатчЗапроса(СтруктураНастроек.ТипыОбъектовОбмена.ЕдиницаИзмерения2, ИнформацияЕдиницыИзмерения.ЕдиницаИзмерения));
	
	Возврат СтрокаЗапроса;
	
КонецФункции
 
Функция РестЗапросТовараВариации(СтруктураНастроек, Поля, ЭтоТовар, КлючОбъекта, ИдентификаторОбъекта, МенеджерВременныхТаблиц = Неопределено)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ИмяСправочникаПользователей = "Пользователи";
	Если ТипКонфигурации = "УНФ" Тогда
		ИмяСправочникаПользователей = "Сотрудники";
	КонецЕсли;
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Текст = "ВЫБРАТЬ *
		|ИЗ
		|	ВТ_ДопРеквизитыОбъекта КАК ВТ_ДопРеквизитыОбъекта";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ИдентификаторСвойства = Выборка.ИдентификаторСвойства;
			
			Если НЕ ЗначениеЗаполнено(ИдентификаторСвойства) Тогда
				ИдентификаторСвойства = СтруктураНастроек.ИдентификаторыНовыхОбъектов.Получить(Выборка.Свойство);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ИдентификаторСвойства) Тогда 
				Продолжить;
			КонецЕсли;
			
			КлючСвойства = "property" + ИдентификаторСвойства;
			
			Если Поля.Свойство(КлючСвойства) Тогда
				Продолжить;	
			КонецЕсли;
			
			Если Выборка.ТипЗначенияСвойства.СодержитТип(Тип("СправочникСсылка."+ИмяСправочникаПользователей)) Тогда	
				
				НайденнаяСтрока = СтруктураНастроек.ТаблицаСопоставленияПользователей.Найти(Выборка.ЗначениеСвойства, "Пользователь1С");	
				Если НайденнаяСтрока <> Неопределено Тогда
					Поля.Вставить(КлючСвойства, НайденнаяСтрока.ИдПользователя);
				Иначе
					Поля.Вставить(КлючСвойства, "");
				КонецЕсли;     
				
			ИначеЕсли Выборка.ТипЗначенияСвойства.СодержитТип(Тип("Булево")) Тогда	
				Поля.Вставить(КлючСвойства, ?(Выборка.ЗначениеСвойства = Истина, "Y", "N"));
			Иначе
				
				Если Выборка.ДополнительныеЗначенияИспользуются Тогда
					
					ИдентификаторЗначенияСвойства = Выборка.ИдентификаторЗначенияСвойства; 
					Если НЕ ЗначениеЗаполнено(ИдентификаторЗначенияСвойства) Тогда
						ИдентификаторЗначенияСвойства = СтруктураНастроек.ИдентификаторыНовыхОбъектов.Получить(Выборка.ЗначениеСвойства);
					КонецЕсли;   
					
					Если ЗначениеЗаполнено(ИдентификаторЗначенияСвойства) Тогда
						Поля.Вставить(КлючСвойства, ИдентификаторЗначенияСвойства);
					КонецЕсли;    
					
				Иначе
					Поля.Вставить(КлючСвойства, Выборка.ЗначениеСвойства);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;  
		
	КонецЕсли;
	
	ТелоЗапроса = "";
	Для каждого ТекПоле Из Поля Цикл    
		
		Если ТекПоле.Значение <> Неопределено Тогда 
			
			НачалоКлюча = Лев(ТекПоле.Ключ, 8);
			Если НачалоКлюча = "property" Тогда
				ТелоЗапроса = ТелоЗапроса + "fields["+ ТекПоле.Ключ + "][value]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение) + "&";        
			ИначеЕсли НачалоКлюча = "parentId" Тогда
				ТелоЗапроса = ТелоЗапроса + "fields["+ ТекПоле.Ключ + "]=" + ТекПоле.Значение + "&"; 
			Иначе
				ТелоЗапроса = ТелоЗапроса + "fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение)+ "&"; 
			КонецЕсли; 
			
		КонецЕсли;

	КонецЦикла;    
	
	Если ЭтоТовар Тогда
		Если НЕ ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
			СтрокаЗапроса = "cmd["+КлючОбъекта+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.product.add?" + ТелоЗапроса);	
		Иначе
			СтрокаЗапроса = "cmd["+КлючОбъекта+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.product.update?id=" + ИдентификаторОбъекта + "&"  + ТелоЗапроса);	
		КонецЕсли;
	Иначе
		Если НЕ ЗначениеЗаполнено(ИдентификаторОбъекта) Тогда
			СтрокаЗапроса = "cmd["+КлючОбъекта+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.product.offer.add?" + ТелоЗапроса);	
		Иначе
			СтрокаЗапроса = "cmd["+КлючОбъекта+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.product.offer.update?id=" + ИдентификаторОбъекта + "&"  + ТелоЗапроса);	
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрокаЗапроса;
	
КонецФункции


Процедура updateProduct(ПередаваемыеПараметры, АдресРезультата) Экспорт
	
	НастройкаПодключения = ПередаваемыеПараметры. НастройкаПодключения;
	Портал 			= ПередаваемыеПараметры.Портал;
	ИдСессии 		= ПередаваемыеПараметры.ИдСессии;
	ИдСтрокиТовара 	= ПередаваемыеПараметры.ИдСтрокиТовара;
	
	ОтветПорталу = "";
	НайденныеДанные = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьЗначениеПоИдБ24Объекта(Портал, Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом.Предложение, Формат(ИдСтрокиТовара, "ЧГ=0"));
	Если НайденныеДанные = Неопределено Тогда
		ОтветПорталу = "failure: Product not found";
	Иначе     
		ВыгрузитьДанныеТовара(НастройкаПодключения, Неопределено, НайденныеДанные.Объект, НайденныеДанные.ПодчиненныйОбъект);
		ОтветПорталу = "success";
	КонецЕсли;
	
	ВернутьОтветОбновленногоТовара(НастройкаПодключения, ИдСессии, ОтветПорталу);

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);
	
КонецПроцедуры

Процедура ВернутьОтветОбновленногоТовара(НастройкаПодключения, ИдСессии, ОтветПорталу)
	
	СтруктураНастроек 	= Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек <> Неопределено Тогда
		ТелоЗапроса = "&COMMAND=updateProductResult&MODULE_ID=1ctotal&PARAMS[session]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСессии)+"&PARAMS[data]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ОтветПорталу);
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаНаПортал

Процедура ОбъеденитьЗапросыВыгрузить(СтруктураНастроек, мЭлементы)

	КоличествоВЗапросе = 0;	
	ТелоHTTPЗапроса = "";
	Для каждого ТекЭлемент Из мЭлементы Цикл
		
		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + ТекЭлемент;	
		
		КоличествоВЗапросе = КоличествоВЗапросе + 1;
		
		Если КоличествоВЗапросе = 50 Тогда     
			
			ВыгрузитьНаПортал(СтруктураНастроек, ТелоHTTPЗапроса);
			
			КоличествоВЗапросе = 0;	
			ТелоHTTPЗапроса= "";  
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоВЗапросе > 0 Тогда
		ВыгрузитьНаПортал(СтруктураНастроек, ТелоHTTPЗапроса);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВыгрузитьНаПортал(СтруктураНастроек, ТелоHTTPЗапроса)
	
	СтруктураОтвета =  Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
	Если СтруктураОтвета = Неопределено Тогда
		СтруктураНастроек.ВыполненоБезОшибок = Ложь;
		Возврат;	
	КонецЕсли;
	
	result = СтруктураОтвета.Получить("result");
	Если result = Неопределено Тогда  
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "Не удалось разобрать JSON ответа");
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "Тело отправляемого запроса: " + ТелоHTTPЗапроса);
		СтруктураНастроек.ВыполненоБезОшибок = Ложь;   
		Возврат;	
	КонецЕсли;
	
	result2 = result.Получить("result");
	Если result2 <> Неопределено Тогда
		
		Для каждого ТекСтрока Из result2 Цикл
			
			Если ТипЗнч(ТекСтрока) = Тип("Булево") ИЛИ ТипЗнч(ТекСтрока) = Тип("Соответствие") ИЛИ СтрДлина(ТекСтрока.Ключ) < 30 Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеКлюча = СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Получить(ТекСтрока.Ключ);
			
			Если ДанныеКлюча = Неопределено Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден объект с ид:" + Строка(ТекСтрока.Ключ));  
				СтруктураНастроек.ВыполненоБезОшибок = Ложь;
				Продолжить;
			КонецЕсли;
			
			Если ДанныеКлюча.Тип = СтруктураНастроек.ТипыОбъектовОбмена.СвойствоТовара2 ИЛИ ДанныеКлюча.Тип = СтруктураНастроек.ТипыОбъектовОбмена.СвойствоПредложения Тогда 
				
				Если ТипЗнч(ТекСтрока.Значение) = Тип("Соответствие") Тогда
					productProperty = ТекСтрока.Значение.Получить("productProperty"); 
					Если productProperty <> Неопределено Тогда
						ИдЭлемента = Формат(productProperty.Получить("id"), "ЧГ=0");
						РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, ДанныеКлюча.Тип, ДанныеКлюча, ИдЭлемента);  
						СтруктураНастроек.ИдентификаторыНовыхОбъектов.Вставить(ДанныеКлюча.Объект, ИдЭлемента);
					КонецЕсли;         
				КонецЕсли;	
				
			ИначеЕсли ДанныеКлюча.Тип = СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваТовара2 ИЛИ ДанныеКлюча.Тип = СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваПредложения Тогда 
				
				Если ТипЗнч(ТекСтрока.Значение) = Тип("Соответствие") Тогда
					productPropertyEnum = ТекСтрока.Значение.Получить("productPropertyEnum"); 
					Если productPropertyEnum <> Неопределено Тогда
						ИдЭлемента = Формат(productPropertyEnum.Получить("id"), "ЧГ=0");  
						ДанныеКлюча.ПодчиненныйОбъект = Формат(productPropertyEnum.Получить("propertyId"), "ЧГ=0");
						РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, ДанныеКлюча.Тип, ДанныеКлюча, ИдЭлемента);  
						СтруктураНастроек.ИдентификаторыНовыхОбъектов.Вставить(ДанныеКлюча.Объект, ИдЭлемента);
					КонецЕсли;         
				КонецЕсли;	
				
			ИначеЕсли ДанныеКлюча.Тип = СтруктураНастроек.ТипыОбъектовОбмена.ЕдиницаИзмерения2 Тогда 
				
				Если ТипЗнч(ТекСтрока.Значение) = Тип("Соответствие") Тогда
					measure = ТекСтрока.Значение.Получить("measure"); 
					Если measure <> Неопределено Тогда
						ИдЭлемента = Формат(measure.Получить("id"), "ЧГ=0");
						РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, ДанныеКлюча.Тип, ДанныеКлюча, ИдЭлемента);
						СтруктураНастроек.ИдентификаторыНовыхОбъектов.Вставить(ДанныеКлюча.Объект, ИдЭлемента);
					КонецЕсли;         
				КонецЕсли;	
				
			ИначеЕсли ДанныеКлюча.Тип = СтруктураНастроек.ТипыОбъектовОбмена.Товар2 Тогда 
				
				Если ТипЗнч(ТекСтрока.Значение) = Тип("Соответствие") Тогда
					element = ТекСтрока.Значение.Получить("element"); 
					Если element <> Неопределено Тогда
						ИдЭлемента = Формат(element.Получить("id"), "ЧГ=0");
						РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, ДанныеКлюча.Тип, ДанныеКлюча, ИдЭлемента);
						СтруктураНастроек.ИдентификаторыНовыхОбъектов.Вставить(ДанныеКлюча.Объект, ИдЭлемента);
					КонецЕсли;         
				КонецЕсли;
				
			ИначеЕсли ДанныеКлюча.Тип = СтруктураНастроек.ТипыОбъектовОбмена.Предложение Тогда 
				
				Если ТипЗнч(ТекСтрока.Значение) = Тип("Соответствие") Тогда
					offer = ТекСтрока.Значение.Получить("offer"); 
					Если offer <> Неопределено Тогда
						
						ИдЭлемента = Формат(offer.Получить("id"), "ЧГ=0");
						РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(СтруктураНастроек, ДанныеКлюча.Тип, ДанныеКлюча, ИдЭлемента);
						
						Если ЗначениеЗаполнено(ДанныеКлюча.ПодчиненныйОбъект) Тогда
							СтруктураНастроек.ИдентификаторыНовыхОбъектов.Вставить(ДанныеКлюча.ПодчиненныйОбъект, ИдЭлемента);
						Иначе
							СтруктураНастроек.ИдентификаторыНовыхОбъектов.Вставить(ДанныеКлюча.Объект, ИдЭлемента);
						КонецЕсли;
						
						
					КонецЕсли;         
				КонецЕсли;	
				
			КонецЕсли;   
			
		КонецЦикла;
	КонецЕсли;
	
	result_error = result.Получить("result_error"); 
	Если result_error <> Неопределено Тогда
		
		Для каждого ТекСтрока Из result_error Цикл     					
			
			Если ТипЗнч(ТекСтрока) <> Тип("Соответствие") Тогда                  
				
				ДанныеКлюча = СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Получить(ТекСтрока.Ключ);
				Если ДанныеКлюча = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				лОписаниеОшибки = ТекСтрока.Значение.Получить("error_description");
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, лОписаниеОшибки + " у объекта:" + Строка(ДанныеКлюча.Объект)); 
						
				РазобратьОшибку(СтруктураНастроек, ДанныеКлюча.Тип, ДанныеКлюча.Объект, лОписаниеОшибки);
						
				СтруктураНастроек.ВыполненоБезОшибок = Ложь;
				
			КонецЕсли;					
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Прочее

Процедура МВТСвойствОбъекта(СтруктураНастроек, Объект, Вид, МенеджерВременныхТаблиц)
	
	Если Вид = "Товар" Тогда               
		ИмяСправочника = "Номенклатура"; 
		ТипДанныхСвойство 			= СтруктураНастроек.ТипыОбъектовОбмена.СвойствоТовара2;	
		ТипДанныхЗначениеСвойства 	= СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваТовара2;	
	Иначе           
		ИмяСправочника = "ХарактеристикиНоменклатуры"; 
		ТипДанныхСвойство 			= СтруктураНастроек.ТипыОбъектовОбмена.СвойствоПредложения;	
		ТипДанныхЗначениеСвойства 	= СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваПредложения;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Портал"	, СтруктураНастроек.Портал);	
	Запрос.УстановитьПараметр("Объект"	, Объект);	
	Запрос.УстановитьПараметр("ТипДанныхСвойство"		 , ТипДанныхСвойство);	
	Запрос.УстановитьПараметр("ТипДанныхЗначениеСвойства", ТипДанныхЗначениеСвойства);	
	Запрос.Текст = "ВЫБРАТЬ
	|	ОбъектДополнительныеРеквизиты.Ссылка КАК Товар,
	|	ОбъектДополнительныеРеквизиты.Свойство КАК Свойство,
	|	Б24_К_ИдентификаторыСвойств.Идентификатор КАК ИдентификаторСвойства,
	|	Б24_К_ИдентификаторыСвойств.ДополнительныйИдентификатор КАК ДополнительныйИдентификаторСвойства,
	|	ДополнительныеРеквизитыИСведения.ТипЗначения КАК ТипЗначенияСвойства,
	|	ДополнительныеРеквизитыИСведения.Заголовок КАК ЗаголовокСвойства,
	|	ДополнительныеРеквизитыИСведения.Наименование КАК НаименованиеСвойства, 
	|	ДополнительныеРеквизитыИСведения.ДополнительныеЗначенияИспользуются КАК ДополнительныеЗначенияИспользуются,    
	|	ОбъектДополнительныеРеквизиты.Значение КАК ЗначениеСвойства,
	|	Б24_К_ИдентификаторыЗначенийСвойств.Идентификатор КАК ИдентификаторЗначенияСвойства
	|ПОМЕСТИТЬ ВТ_ДопРеквизитыОбъекта
	|ИЗ
	|	Справочник."+ИмяСправочника+".ДополнительныеРеквизиты КАК ОбъектДополнительныеРеквизиты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|		ПО ОбъектДополнительныеРеквизиты.Свойство = ДополнительныеРеквизитыИСведения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыСвойств
	|		ПО ОбъектДополнительныеРеквизиты.Свойство = Б24_К_ИдентификаторыСвойств.Объект
	|			И (Б24_К_ИдентификаторыСвойств.ТипДанных = &ТипДанныхСвойство)
	|			И (Б24_К_ИдентификаторыСвойств.Портал = &Портал)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыЗначенийСвойств
	|		ПО ОбъектДополнительныеРеквизиты.Значение = Б24_К_ИдентификаторыЗначенийСвойств.Объект
	|			И (Б24_К_ИдентификаторыЗначенийСвойств.ТипДанных = &ТипДанныхЗначениеСвойства)
	|			И (Б24_К_ИдентификаторыЗначенийСвойств.Портал = &Портал)
	|ГДЕ
	|	ОбъектДополнительныеРеквизиты.Ссылка = &Объект
	|	И ДополнительныеРеквизитыИСведения.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДополнительныеСведения.Объект,
	|	ДополнительныеСведения.Свойство,
	|	Б24_К_ИдентификаторыСвойств.Идентификатор,
	|	Б24_К_ИдентификаторыСвойств.ДополнительныйИдентификатор,
	|	ДополнительныеРеквизитыИСведения.ТипЗначения,
	|	ДополнительныеРеквизитыИСведения.Заголовок,
	|	ДополнительныеРеквизитыИСведения.Наименование,    
	|	ДополнительныеРеквизитыИСведения.ДополнительныеЗначенияИспользуются,    
	|	ДополнительныеСведения.Значение,
	|	Б24_К_ИдентификаторыЗначенийСвойств.Идентификатор
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|		ПО ДополнительныеСведения.Свойство = ДополнительныеРеквизитыИСведения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыСвойств
	|		ПО ДополнительныеСведения.Свойство = Б24_К_ИдентификаторыСвойств.Объект
	|			И (Б24_К_ИдентификаторыСвойств.ТипДанных = &ТипДанныхСвойство)
	|			И (Б24_К_ИдентификаторыСвойств.Портал = &Портал)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыЗначенийСвойств
	|		ПО ДополнительныеСведения.Значение = Б24_К_ИдентификаторыЗначенийСвойств.Объект
	|			И (Б24_К_ИдентификаторыЗначенийСвойств.ТипДанных = &ТипДанныхЗначениеСвойства)
	|			И (Б24_К_ИдентификаторыЗначенийСвойств.Портал = &Портал)
	|ГДЕ
	|	ДополнительныеСведения.Объект = &Объект
	|	И ДополнительныеРеквизитыИСведения.ПометкаУдаления = ЛОЖЬ";

	
	Запрос.Выполнить();

КонецПроцедуры

Функция ПолучитьСтруктуруКлючаБатчЗапроса(ТипДанных, Объект, ПодчиненныйОбъект = Неопределено) 
	
	Результат = Новый Структура;
	
	Результат.Вставить("Тип"				, ТипДанных);
	Результат.Вставить("Объект"				, Объект);
	Результат.Вставить("ПодчиненныйОбъект"	, ПодчиненныйОбъект);
	Возврат Результат;
	
КонецФункции

Функция ДанныеЗаполненияТовараВариации(СтруктураНастроек, ДанныеТовара, Прайсы) 
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ЦенаВключаетНДС = Ложь;  
	Если Прайсы.Количество() > 0 Тогда
		ЦенаВключаетНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Прайсы[0].Прайс1С, "ЦенаВключаетНДС");
	КонецЕсли;
	
	ИдСтавкиНДС = "";
	Если ТипКонфигурации = "БП" Тогда
		СтавкаНДС = Перечисления.СтавкиНДС.СтавкаНДС(ДанныеТовара.ВидСтавкиНДС, СтруктураНастроек.ДатаФормирования);	
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		СтавкаНДС = ДанныеТовара.СтавкаНДС;
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		СтавкаНДС = Справочники["СтавкиНДС"].СтавкаНДС(ДанныеТовара.ВидСтавкиНДС, СтруктураНастроек.ДатаФормирования);					
	КонецЕсли;
	НайденнаяСтрока = СтруктураНастроек.ПресетыСтавокНДС.Найти(СтавкаНДС);
	Если НайденнаяСтрока <> Неопределено Тогда
		ИдСтавкиНДС = НайденнаяСтрока.ИдСтавки;
	Иначе
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Ставка НДС: " + Строка(СтавкаНДС) + " не поддерживается модулем. В настройках синхронизации необходимо указать соответствие ставки НДС 1С И Битрикс24.");
	КонецЕсли;	
	
	ДанныеЗаполнения = Новый Структура;    
	ДанныеЗаполнения.Вставить("iblockId"	, Неопределено);	
	ДанныеЗаполнения.Вставить("parentId"	, Неопределено);	 
	ДанныеЗаполнения.Вставить("xmlId"		, Неопределено);	
	ДанныеЗаполнения.Вставить("name"		, Неопределено);
	ДанныеЗаполнения.Вставить("previewText"	, Неопределено);
	ДанныеЗаполнения.Вставить("detailText"	, Неопределено);
	ДанныеЗаполнения.Вставить("previewTextType"	, "text");
	ДанныеЗаполнения.Вставить("detailTextType"	, "text");  
	ДанныеЗаполнения.Вставить("active"		, "Y");	  
	ДанныеЗаполнения.Вставить("available"	, "Y");	  
	ДанныеЗаполнения.Вставить("vatIncluded"	, ?(ЦенаВключаетНДС = Истина,"Y","N"));
	Если ТипКонфигурации = "УТ" Тогда
		ДанныеЗаполнения.Вставить("weight"		, ДанныеТовара.Вес*1000);	
		ДанныеЗаполнения.Вставить("width"		, ДанныеТовара.Ширина*1000);	
		ДанныеЗаполнения.Вставить("length"		, ДанныеТовара.Длина*1000);	
		ДанныеЗаполнения.Вставить("height"		, ДанныеТовара.Высота*1000);	
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		ДанныеЗаполнения.Вставить("weight"		, ДанныеТовара.Вес*1000);	
		ДанныеЗаполнения.Вставить("width"		, ДанныеТовара.Ширина*10);	
		ДанныеЗаполнения.Вставить("length"		, ДанныеТовара.Длина*10);	
		ДанныеЗаполнения.Вставить("height"		, ДанныеТовара.Высота*10);	
	КонецЕсли;
	
	Если  ЗначениеЗаполнено(ИдСтавкиНДС) Тогда
		ДанныеЗаполнения.Вставить("vatId", ИдСтавкиНДС);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеТовара.ИдентификаторЕдИзм) Тогда
		ИдентификаторЕдИзм = ДанныеТовара.ИдентификаторЕдИзм;
	Иначе
		ИдентификаторЕдИзм = СтруктураНастроек.ИдентификаторыНовыхОбъектов.Получить(ДанныеТовара.ЕдиницаИзмерения);
	КонецЕсли;
	ДанныеЗаполнения.Вставить("measure", ?(ЗначениеЗаполнено(ИдентификаторЕдИзм), ИдентификаторЕдИзм, ""));

	Возврат ДанныеЗаполнения;
	
КонецФункции

Процедура РазобратьОшибку(СтруктураНастроек, ТипДанных, Объект, ОписаниеОшибки)

	Если ТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.ЕдиницаИзмерения2 Тогда  
		
		Если СтрНайти(ОписаниеОшибки, "not exists") > 0 ИЛИ СтрНайти(ОписаниеОшибки, "не найден") > 0 Тогда
			РегистрыСведений.Б24_К_ИдентификаторыОбъектов.УдалитьИдБ24Объекта(СтруктураНастроек, ТипДанных, Объект);  
