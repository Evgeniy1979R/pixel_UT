Функция СформироватьДанныеПоСчетам(пСтруктураНастроек, МассивДанных) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	мЭлементы 	=  Новый массив;
	Если НЕ (ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "УНФ") Тогда
		Возврат мЭлементы;	
	КонецЕсли;
	СтруктураНастроек = Новый Структура;
	Для Каждого ЭлементСтруктуры Из пСтруктураНастроек Цикл
		СтруктураНастроек.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;	
	
#Область ИдентификаторыСлужебныхСвойств		

	Если пСтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда 	
		ДопИдСвойстваПометкиУдаления	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоПометкаУдаленияСчетов, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСчета); 
		СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваПометкиУдаленияСчета", ДопИдСвойстваПометкиУдаления);
	КонецЕсли;
	
	ДопИдСвойстваНомер1С	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомер1ССчетаБитрикс24, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСчета); 
	СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваНомерСчета1С", ДопИдСвойстваНомер1С);
	
#КонецОбласти
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ФормированиеВременныхТаблицДанных
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивДанных"		, МассивДанных);  
	Запрос.УстановитьПараметр("АктуальнаяДатаСеанса", СтруктураНастроек.ДатаФормирования);
	Запрос.УстановитьПараметр("Портал"				, СтруктураНастроек.Портал);
	Запрос.УстановитьПараметр("ТипДанныхСделок"		, СтруктураНастроек.ТипыОбъектовОбмена.Сделка);
	Запрос.УстановитьПараметр("ТипДанныхКомпаний"	, СтруктураНастроек.ТипыОбъектовОбмена.Компания);
	Запрос.УстановитьПараметр("ТипДанныхКонтактов"	, СтруктураНастроек.ТипыОбъектовОбмена.Контакт);
	Запрос.УстановитьПараметр("ТипДанныхРеквизитов"	, СтруктураНастроек.ТипыОбъектовОбмена.Реквизит);	
	Запрос.УстановитьПараметр("ТипДанныхТоваров"	, СтруктураНастроек.ТипыОбъектовОбмена.Товар);
	Запрос.УстановитьПараметр("ТипДанныхЕдИзм"		, СтруктураНастроек.ТипыОбъектовОбмена.ЕдиницаИзмерения);
	Запрос.УстановитьПараметр("СтатусОплатыПоУмолчанию"	 , Перечисления.СтатусОплатыСчета.НеОплачен);
	Запрос.УстановитьПараметр("СтатусОтгрузкиПоУмолчанию", Перечисления.СтатусыОтгрузки.НеОтгружен);
	Запрос.УстановитьПараметр("ТипДанныхЗСК"		, СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваСчета);
	Запрос.УстановитьПараметр("ТипДанныхЗС"			, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСчета);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетНаОплатуПокупателю.Ссылка КАК Ссылка,
	               |	СчетНаОплатуПокупателю.ПометкаУдаления КАК ПометкаУдаления,
	               |	СчетНаОплатуПокупателю.Контрагент КАК Контрагент,
	               |	СчетНаОплатуПокупателю.Организация КАК Организация,
	               |	СчетНаОплатуПокупателю.Ответственный КАК Ответственный,
	               |	СчетНаОплатуПокупателю.Номер КАК Номер,
	               |	СчетНаОплатуПокупателю.Дата КАК Дата,
	               |	СчетНаОплатуПокупателю.Проведен КАК Проведен,
	               |	СчетНаОплатуПокупателю.Комментарий КАК Комментарий,
	               |	Валюты.Код КАК ВалютаКод,
	               |	СчетНаОплатуПокупателю.СуммаДокумента КАК СуммаДокумента,
	               |	СчетНаОплатуПокупателю.СуммаВключаетНДС КАК СуммаВключаетНДС
	               |ПОМЕСТИТЬ ВТ_Счета
	               |ИЗ
	               |	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	               |		ПО СчетНаОплатуПокупателю.ВалютаДокумента = Валюты.Ссылка
	               |ГДЕ
	               |	СчетНаОплатуПокупателю.Ссылка В(&МассивДанных)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	               |	МАКСИМУМ(Б24_К_ИдентификаторыОбъектов.Идентификатор) КАК Идентификатор
	               |ПОМЕСТИТЬ ВТ_ИдентификаторыКонтрагентовОрганизаций
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |	И (Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхКомпаний
	               |			ИЛИ Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхКонтактов)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Б24_К_ИдентификаторыОбъектов.Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	               |ПОМЕСТИТЬ ВТ_ИдентификаторыРеквизитов
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхРеквизитов
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Объект КАК Объект,
	               |	ДополнительныеСведения.Свойство КАК Свойство,
	               |	ДополнительныеСведения.Значение КАК Значение
	               |ПОМЕСТИТЬ ВТ_ТаблицаСвойств
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект В(&МассивДанных)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Счета.Ссылка КАК Объект,
	               |	ВТ_Счета.Ссылка КАК Идентификатор1С,
	               |	ВТ_Счета.ПометкаУдаления КАК ПометкаУдаления,
	               |	ВТ_Счета.Контрагент КАК Контрагент,
	               |	ВТ_Счета.Организация КАК Организация,
	               |	ВТ_Счета.Ответственный КАК Ответственный,
	               |	ВТ_Счета.Номер КАК Номер,
	               |	ВТ_Счета.Дата КАК Дата,
	               |	ВТ_Счета.Проведен КАК Проведен,
	               |	ВТ_Счета.Комментарий КАК Комментарий,
	               |	СрокиОплатыДокументов.СрокОплаты КАК СрокОплаты,
	               |	ВЫБОР
	               |		КОГДА СтатусыДокументов.Статус ЕСТЬ NULL
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусОплатыСчета.НеОплачен)
	               |		ИНАЧЕ СтатусыДокументов.Статус
	               |	КОНЕЦ КАК Статус,
	               |	ВТ_Счета.ВалютаКод КАК ВалютаКод,
	               |	ВТ_Счета.СуммаДокумента КАК СуммаДокумента,
	               |	ВТ_Счета.СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	ПРЕДСТАВЛЕНИЕ(ВТ_Счета.Ссылка) КАК СчетСтрокой,
	               |	ВТ_ИдентификаторыКонтрагентов.Идентификатор КАК ИдентификаторБ24Контрагента,
	               |	ВТ_ИдентификаторыОрганизаций.Идентификатор КАК ИдентификаторБ24Организации,
	               |	ВТ_ИдентификаторыРеквизитовКонтрагентов.Идентификатор КАК ИдентификаторРеквизитаБ24,
	               |	ВТ_ИдентификаторыРеквизитовОрганизаций.Идентификатор КАК ИдентификаторРеквизитаОрганизацииБ24,
	               |	ВЫРАЗИТЬ(ЕСТЬNULL(СтатусыДокументов.Статус, &СтатусОплатыПоУмолчанию) КАК Перечисление.СтатусОплатыСчета) КАК Оплата,
	               |	ВЫРАЗИТЬ(ЕСТЬNULL(СтатусыДокументов.ДополнительныйСтатус, &СтатусОтгрузкиПоУмолчанию) КАК Перечисление.СтатусыОтгрузки) КАК Отгрузка,
	               |	Контрагенты.Наименование КАК НаименованиеКонтрагента,
	               |	Контрагенты.НаименованиеПолное КАК НаименованиеПолноеКонтрагента,
	               |	Контрагенты.ИНН КАК ИННКонтрагента,
	               |	Контрагенты.КПП КАК КППКонтрагента
	               |ИЗ
	               |	ВТ_Счета КАК ВТ_Счета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыКонтрагентовОрганизаций КАК ВТ_ИдентификаторыОрганизаций
	               |		ПО ВТ_Счета.Организация = ВТ_ИдентификаторыОрганизаций.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыРеквизитов КАК ВТ_ИдентификаторыРеквизитовОрганизаций
	               |		ПО ВТ_Счета.Организация = ВТ_ИдентификаторыРеквизитовОрганизаций.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыРеквизитов КАК ВТ_ИдентификаторыРеквизитовКонтрагентов
	               |		ПО ВТ_Счета.Контрагент = ВТ_ИдентификаторыРеквизитовКонтрагентов.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыКонтрагентовОрганизаций КАК ВТ_ИдентификаторыКонтрагентов
	               |		ПО ВТ_Счета.Контрагент = ВТ_ИдентификаторыКонтрагентов.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиОплатыДокументов КАК СрокиОплатыДокументов
	               |		ПО ВТ_Счета.Ссылка = СрокиОплатыДокументов.Документ
	               |			И ВТ_Счета.Организация = СрокиОплатыДокументов.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыДокументов КАК СтатусыДокументов
	               |		ПО ВТ_Счета.Ссылка = СтатусыДокументов.Документ
	               |			И ВТ_Счета.Организация = СтатусыДокументов.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	               |		ПО ВТ_Счета.Контрагент = Контрагенты.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонтрагентыКонтактнаяИнформация.Тип КАК Тип,
	               |	КонтрагентыКонтактнаяИнформация.Вид КАК Вид,
	               |	КонтрагентыКонтактнаяИнформация.Представление КАК Представление,
	               |	КонтрагентыКонтактнаяИнформация.Ссылка КАК Контрагент
	               |ПОМЕСТИТЬ ВТ_КИКонтрагентов
	               |ИЗ
	               |	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Счета КАК ВТ_Счета
	               |		ПО КонтрагентыКонтактнаяИнформация.Ссылка = ВТ_Счета.Контрагент
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Контрагент,
	               |	Тип
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_Счета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ИдентификаторыКонтрагентовОрганизаций
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИдентификаторыБ24.Объект КАК Объект,
	               |	МАКСИМУМ(ИдентификаторыБ24.Идентификатор) КАК Идентификатор
	               |ПОМЕСТИТЬ ВТ_ИдентификаторыТоваров
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВЫРАЗИТЬ(Б24_К_ИдентификаторыОбъектов.Объект КАК Справочник.Номенклатура) КАК Объект,
	               |		Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	               |	ИЗ
	               |		РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |	ГДЕ
	               |		Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхТоваров
	               |		И Б24_К_ИдентификаторыОбъектов.Портал = &Портал) КАК ИдентификаторыБ24
	               |СГРУППИРОВАТЬ ПО
	               |	ИдентификаторыБ24.Объект
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетНаОплатуПокупателюТовары.Ссылка КАК Счет,
	               |	СчетНаОплатуПокупателюТовары.Номенклатура КАК Номенклатура,
	               |	СчетНаОплатуПокупателюТовары.Содержание КАК Содержание,
	               |	СчетНаОплатуПокупателюТовары.Количество КАК Количество,
	               |	СчетНаОплатуПокупателюТовары.Цена КАК Цена,
	               |	СчетНаОплатуПокупателюТовары.Сумма КАК Сумма,
	               |	СчетНаОплатуПокупателюТовары.ПроцентСкидки КАК ПроцентСкидки,
	               |	СчетНаОплатуПокупателюТовары.СуммаСкидки КАК СуммаСкидки,
	               |	СчетНаОплатуПокупателюТовары.СтавкаНДС КАК СтавкаНДС,
	               |	СчетНаОплатуПокупателюТовары.СуммаНДС КАК СуммаНДС,
	               |	Товары.Наименование КАК НаименованиеТовара,
	               |	КлассификаторЕдиницИзмерения.Ссылка КАК ЕдиницаИзмерения,
	               |	ПРЕДСТАВЛЕНИЕ(КлассификаторЕдиницИзмерения.Ссылка) КАК НаименованиеЕдиницыИзмерения,
	               |	ВТ_ИдентификаторыТоваров.Идентификатор КАК ИдентификаторБ24Товара,
	               |	КлассификаторЕдиницИзмерения.Код КАК КодЕдИзм,
	               |	Товары.Услуга КАК Услуга,
	               |	СчетНаОплатуПокупателюТовары.Б24_К_ИдентификаторПозиции КАК Б24_К_ИдентификаторПозиции,
	               |	СчетНаОплатуПокупателюТовары.Б24_К_КлючСвязи КАК КлючСвязи,
	               |	СчетНаОплатуПокупателюТовары.НомерСтроки КАК НомерСтроки,
	               |	Товары.НаименованиеПолное КАК НаименованиеПолноеНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ТоварыСчетов
	               |ИЗ
	               |	Документ.СчетНаОплатуПокупателю.Товары КАК СчетНаОплатуПокупателюТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Товары
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	               |			ПО Товары.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	               |		ПО СчетНаОплатуПокупателюТовары.Номенклатура = Товары.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыТоваров КАК ВТ_ИдентификаторыТоваров
	               |		ПО СчетНаОплатуПокупателюТовары.Номенклатура = ВТ_ИдентификаторыТоваров.Объект
	               |ГДЕ
	               |	СчетНаОплатуПокупателюТовары.Ссылка В(&МассивДанных)
	               |	И СчетНаОплатуПокупателюТовары.Количество > 0
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ИдентификаторыТоваров
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК ИдентификаторБитрикс24,
	               |	Б24_К_ИдентификаторыОбъектов.ДополнительныйИдентификатор КАК ДополнительныйИдентификаторБитрикс24,
	               |	ДополнительныеРеквизитыИСведения.ДополнительныеЗначенияИспользуются КАК ДополнительныеЗначенияИспользуются,
	               |	ДополнительныеРеквизитыИСведения.ТипЗначения КАК ТипЗначения
	               |ПОМЕСТИТЬ ВТ_ИдентификаторыПользовательскихПолей
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	               |		ПО Б24_К_ИдентификаторыОбъектов.Объект = ДополнительныеРеквизитыИСведения.Ссылка
	               |ГДЕ
	               |	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхЗС
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	               |ПОМЕСТИТЬ ВТ_ИдентификаторыЗначенийПользовательскихПолей
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхЗСК
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Свойство КАК Свойство,
	               |	ДополнительныеСведения.Значение КАК Значение,
	               |	ДополнительныеСведения.Объект КАК Объект
	               |ПОМЕСТИТЬ ВТ_ЗначенияОбъектов
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект В(&МассивДанных)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ДополнительныеСведения.Свойство,
	               |	ДополнительныеСведения.Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗначенияОбъектов.Объект КАК Объект,
	               |	ВТ_ЗначенияОбъектов.Свойство КАК Свойство,
	               |	ВТ_ЗначенияОбъектов.Значение КАК Значение,
	               |	ВТ_ИдентификаторыЗначенийПользовательскихПолей.Идентификатор КАК ИдентификаторЗначенияСвойстваБитрикс24
	               |ПОМЕСТИТЬ ВТ_ЗначенияОбъектовСИд
	               |ИЗ
	               |	ВТ_ЗначенияОбъектов КАК ВТ_ЗначенияОбъектов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыЗначенийПользовательскихПолей КАК ВТ_ИдентификаторыЗначенийПользовательскихПолей
	               |		ПО ВТ_ЗначенияОбъектов.Значение = ВТ_ИдентификаторыЗначенийПользовательскихПолей.Объект
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Объект,
	               |	Свойство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ЗначенияОбъектов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ИдентификаторыЗначенийПользовательскихПолей";
#КонецОбласти

	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Выборка = ВыполненныйЗапрос.Выбрать();
		
	ВыгружатьСчета 				= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "ВыгружатьНаПортал");
	ОбновлятьНаПорталеТовары 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "ОбновлятьНаПортале");
	
	Пока Выборка.Следующий() Цикл
		
		СформированныйЗапрос = "";
		
		ИдентификаторБ24 = ИдБ24ПоСсылке(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Счет, Выборка.Объект);

		ЭтоНовыйЭлемент = НЕ ЗначениеЗаполнено(ИдентификаторБ24);
		
		Если ВыгружатьСчета Тогда
			
			Если ЭтоНовыйЭлемент ИЛИ (НЕ ЭтоНовыйЭлемент И ОбновлятьНаПорталеТовары) Тогда       
				СформированныйЗапрос = СформироватьСтруктуруДанныхПоСчету(СтруктураНастроек,  МенеджерВременныхТаблиц, Выборка, ИдентификаторБ24);
			Иначе
				СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(Выборка.Идентификатор1С);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СформированныйЗапрос) Тогда
			мЭлементы.Добавить(СформированныйЗапрос);
		Иначе
			СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(Выборка.Идентификатор1С);
		КонецЕсли;
		
	КонецЦикла;
	
	пСтруктураНастроек.КлючиПодчиненныхБатчЗапросов 	= СтруктураНастроек.КлючиПодчиненныхБатчЗапросов; 	
	пСтруктураНастроек.Логирование.НомерСообщения	 	= СтруктураНастроек.Логирование.НомерСообщения; 	
	
	Возврат мЭлементы;	
	
КонецФункции

Функция СформироватьСтруктуруДанныхПоСчету(СтруктураНастроек, МенеджерВременныхТаблиц, ИнформацияОСчете, ИдентификаторБ24)

	ЭтоНовыйЭлемент = НЕ ЗначениеЗаполнено(ИдентификаторБ24);
	
	ИнформацияОПолях 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю");
	ИнформацияОПоляхТЧ 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностейТЧ(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю");
	АлгоритмПриВыгрузкеДанныхНаПортал 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "АлгоритмПриВыгрузкеДанныхНаПортал");
	ОбновлятьТЧНаПортале 				= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет", "СчетНаОплатуПокупателю", "ОбновлятьТЧНаПортале") <> Ложь;
	
	КлючСчета = XMLСтрока(ИнформацияОСчете.Идентификатор1С);
	
#Область Счет
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Счет", ИнформацияОСчете.Объект);
	Запрос.Текст = " ВЫБРАТЬ *
	|ИЗ
	|	ВТ_ТоварыСчетов КАК ВТ_ТоварыСчетов
	|ГДЕ
	|	ВТ_ТоварыСчетов.Счет = &Счет";
	
	ТоварыСчета = Запрос.Выполнить().Выгрузить();
	
	Если ТоварыСчета.Количество() = 0 Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "У счета: " + Строка(ИнформацияОСчете.Объект) + " не найдены товары. Или табличная часть не содержит товары, или же не указано количество.");
		Возврат "";
	КонецЕсли;

	ИдОрганизации = ИнформацияОСчете.ИдентификаторБ24Организации;	
	Если НЕ ЗначениеЗаполнено(ИдОрганизации) И ЗначениеЗаполнено(ИнформацияОСчете.Организация) Тогда
	
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден идентификатор организации: " + Строка(ИнформацияОСчете.Организация) + ". Ее необходимо повторно выгрузить на Битрикс24");
		ИдОрганизации = СформироватьКомпаниюПоСсылке(СтруктураНастроек, ИнформацияОСчете.Организация);
		
		Если НЕ ЗначениеЗаполнено(ИдОрганизации) Тогда
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;	
	
	ИдентификаторСтатуса = "";
	Если СтруктураНастроек.НастройкиСинхронизацииСчетов.Свойство("ИнформацияОСтатусах") Тогда
		
		ИнформацияОСтатусах = СтруктураНастроек.НастройкиСинхронизацииСчетов.ИнформацияОСтатусах;
		
		ПереводитьВСтатусКогдаОплачен 			= Неопределено;
		ПереводитьВСтатусКогдаОтгружен 			= Неопределено;
		ПереводитьВСтатусКогдаОплаченОтгружен 	= Неопределено;      
		
		ПереводитьВСтатусКогдаЧастичноОплачен 			= Неопределено;
		ПереводитьВСтатусКогдаЧастичноОтгружен 			= Неопределено;
		ПереводитьВСтатусКогдаЧастичноОплаченОтгружен 	= Неопределено;      
		
		ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаОплачен"		, ПереводитьВСтатусКогдаОплачен);
		ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаОтгружен"		, ПереводитьВСтатусКогдаОтгружен);
		ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаОплаченОтгружен", ПереводитьВСтатусКогдаОплаченОтгружен);
		
		ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаЧастичноОплачен"		, ПереводитьВСтатусКогдаЧастичноОплачен);
		ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаЧастичноОтгружен"		, ПереводитьВСтатусКогдаЧастичноОтгружен);
		ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаЧастичноОплаченОтгружен", ПереводитьВСтатусКогдаЧастичноОплаченОтгружен);
		
		Если ИнформацияОСчете.Оплата = Перечисления.СтатусОплатыСчета.Оплачен И ИнформацияОСчете.Отгрузка = Перечисления.СтатусыОтгрузки.Отгружен
			И ЗначениеЗаполнено(ПереводитьВСтатусКогдаОплаченОтгружен) Тогда
			ИдентификаторСтатуса = ПереводитьВСтатусКогдаОплаченОтгружен;  	
			ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаОплаченОтгружен);
		ИначеЕсли ИнформацияОСчете.Оплата = Перечисления.СтатусОплатыСчета.Оплачен И ЗначениеЗаполнено(ПереводитьВСтатусКогдаОплачен) Тогда
			ИдентификаторСтатуса = ПереводитьВСтатусКогдаОплачен;  	
			ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаОплачен);
		ИначеЕсли ИнформацияОСчете.Отгрузка = Перечисления.СтатусыОтгрузки.Отгружен И ЗначениеЗаполнено(ПереводитьВСтатусКогдаОтгружен) Тогда
			ИдентификаторСтатуса = ПереводитьВСтатусКогдаОтгружен;  	
			ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаОтгружен);  
		ИначеЕсли ИнформацияОСчете.Оплата = Перечисления.СтатусОплатыСчета.ОплаченЧастично И ИнформацияОСчете.Отгрузка = Перечисления.СтатусыОтгрузки.ОтгруженЧастично
			И ЗначениеЗаполнено(ПереводитьВСтатусКогдаЧастичноОплаченОтгружен) Тогда
			ИдентификаторСтатуса = ПереводитьВСтатусКогдаЧастичноОплаченОтгружен;  	
			ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаЧастичноОплаченОтгружен);
		ИначеЕсли ИнформацияОСчете.Оплата = Перечисления.СтатусОплатыСчета.ОплаченЧастично И ЗначениеЗаполнено(ПереводитьВСтатусКогдаЧастичноОплачен) Тогда
			ИдентификаторСтатуса = ПереводитьВСтатусКогдаЧастичноОплачен;  	
			ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаЧастичноОплачен);
		ИначеЕсли ИнформацияОСчете.Отгрузка = Перечисления.СтатусыОтгрузки.ОтгруженЧастично И ЗначениеЗаполнено(ПереводитьВСтатусКогдаЧастичноОтгружен) Тогда
			ИдентификаторСтатуса = ПереводитьВСтатусКогдаЧастичноОтгружен;  	
			ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаЧастичноОтгружен);  
		Иначе
		
			Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СтатусыСчета" Тогда
				Статус = ИнформацияОСчете.Статус;
				Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "БП" ИЛИ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
					тзнСтатусов = ИнформацияОСтатусах.СоответствияСтатусов;
				Иначе
					// режим "СтатусыСчета" поддерживается только в БП/ЗУП (в форме нет страницы статусов)
					тзнСтатусов = Неопределено;
				КонецЕсли;
			ИначеЕсли ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоСчета" Тогда
				Статус = ПолучитьСвойствоИзВременнойТаблицы(СтруктураНастроек, МенеджерВременныхТаблиц, "ВТ_ТаблицаСвойств", ИнформацияОСчете.Объект, ИнформацияОСтатусах.СвойствоСчета);
				тзнСтатусов = ИнформацияОСтатусах.СоответствияЗначенийСвойств;
			КонецЕсли;
				
			НайденнаяСтрока = тзнСтатусов.Найти(Статус, "Статус");
					
			Если НайденнаяСтрока <> Неопределено Тогда
				ИдентификаторСтатуса = НайденнаяСтрока.ИдСтатуса; 
			Иначе
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден статус счета: " + ИнформацияОСчете.СчетСтрокой);
				Возврат "";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИнформацияОПолях"			, ИнформацияОПолях);
	ДополнительныеПараметры.Вставить("КлючЭлемента"				, КлючСчета);
	ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
	ДополнительныеПараметры.Вставить("ЭтоНовыйЭлемент"			, ЭтоНовыйЭлемент);
	ДополнительныеПараметры.Вставить("ИнформацияОбъекта1С"		, ИнформацияОСчете);
	ДополнительныеПараметры.Вставить("ИдентификаторСтатуса"		, ИдентификаторСтатуса);
	ДополнительныеПараметры.Вставить("ТоварыСчета"				, ТоварыСчета);

	Поля = ПолучитьСтруктуруКлючейЭлементаВыгрузки(СтруктураНастроек, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.НеВыгружать = Истина Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден ответственный у счета: " + Строка(ИнформацияОСчете.Объект) + ". Будет пропущен.");
		Возврат "";	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ДопИдПредопределенногоСвойстваНомерСчета1С) Тогда
		Поля.Вставить(СтруктураНастроек.ДопИдПредопределенногоСвойстваНомерСчета1С, ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ИнформацияОСчете.Номер));
	КонецЕсли;
	
	Если СтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда
		Если ЗначениеЗаполнено(СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияСчета) Тогда
			Поля.Вставить(СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияСчета, ИнформацияОСчете.ПометкаУдаления)
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияПользовательскихПолей(СтруктураНастроек, МенеджерВременныхТаблиц, ИнформацияОСчете.Объект, Поля, ИнформацияОПолях);	
	
	Если ЗначениеЗаполнено(АлгоритмПриВыгрузкеДанныхНаПортал) Тогда
		
		ОтказНаВыгрузку = ВыполнитьАлгоритмПередВыгрузкой(СтруктураНастроек, ИнформацияОСчете.Объект, Поля, АлгоритмПриВыгрузкеДанныхНаПортал);
		Если ОтказНаВыгрузку = Истина Тогда
			Возврат "";	
		КонецЕсли;
		
	КонецЕсли;

	ТелоЗапроса = "";
	Для каждого ТекПоле Из Поля Цикл
		Если ТекПоле.Значение <> Неопределено Тогда
			ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
		КонецЕсли;		
	КонецЦикла;  
	      
#Область ЗаполнениеСтандартныхОбязательныхРеквизитов

	ПоляРеквизиты = Новый Структура;
	ПоляРеквизиты.Вставить("FIO"	, ИнформацияОСчете.НаименованиеПолноеКонтрагента);
	ПоляРеквизиты.Вставить("ADDRESS", ПолучитьКИКонтрагента(МенеджерВременныхТаблиц, ИнформацияОСчете.Контрагент, Перечисления.ТипыКонтактнойИнформации.Адрес));
	ПоляРеквизиты.Вставить("EMAIL"	, ПолучитьКИКонтрагента(МенеджерВременныхТаблиц, ИнформацияОСчете.Контрагент, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты));
	ПоляРеквизиты.Вставить("PHONE"	, ПолучитьКИКонтрагента(МенеджерВременныхТаблиц, ИнформацияОСчете.Контрагент, Перечисления.ТипыКонтактнойИнформации.Телефон));

	ПоляРеквизиты.Вставить("COMPANY"		, ИнформацияОСчете.НаименованиеПолноеКонтрагента);
	ПоляРеквизиты.Вставить("COMPANY_NAME"	, ИнформацияОСчете.НаименованиеПолноеКонтрагента);
	ПоляРеквизиты.Вставить("COMPANY_ADR"	, ПолучитьКИКонтрагента(МенеджерВременныхТаблиц, ИнформацияОСчете.Контрагент, Перечисления.ТипыКонтактнойИнформации.Адрес));
	ПоляРеквизиты.Вставить("CONTACT_PERSON", "");
	ПоляРеквизиты.Вставить("INN"			, ИнформацияОСчете.ИННКонтрагента);
	ПоляРеквизиты.Вставить("KPP"			, ИнформацияОСчете.КППКонтрагента);
	
	Для каждого ТекПоле Из ПоляРеквизиты Цикл
		ТелоЗапроса = ТелоЗапроса + "&fields[INVOICE_PROPERTIES]["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
	КонецЦикла;  
#КонецОбласти	
	
#Область ЗаполнениеТабличнойЧасти

Если ОбновлятьТЧНаПортале Тогда   
	
		НомерСтроки = 1;	
		Для каждого ТоварСчета Из ТоварыСчета Цикл
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ИнформацияОПолях"			, ИнформацияОПоляхТЧ);
			ДополнительныеПараметры.Вставить("КлючЭлемента"				, КлючСчета);
			ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
			ДополнительныеПараметры.Вставить("ЭтоНовыйЭлемент"			, ЭтоНовыйЭлемент);
			ДополнительныеПараметры.Вставить("ИнформацияОбъекта1С"		, ИнформацияОСчете);
			ДополнительныеПараметры.Вставить("Товары"					, ТоварыСчета);
			ДополнительныеПараметры.Вставить("ИнформацияСтрокиТЧ"		, ТоварСчета);
			ДополнительныеПараметры.Вставить("КлючСвязи"				, ТоварСчета.КлючСвязи);    
			ДополнительныеПараметры.Вставить("ИмяТЧ"					, "Товары");

			ПоляТЧ = ПолучитьСтруктуруКлючейТЧЭлементаВыгрузки(СтруктураНастроек, ДополнительныеПараметры);
			
			Для каждого ТекПоле Из ПоляТЧ Цикл
				Если ТекПоле.Значение <> Неопределено Тогда
					ТелоЗапроса = ТелоЗапроса + "&fields[PRODUCT_ROWS]["+Формат(НомерСтроки, "ЧГ=0")+"]["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
				КонецЕсли;	
			КонецЦикла;  
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;     
		
	КонецЕсли;
	
#КонецОбласти
		
	Если ЭтоНовыйЭлемент Тогда
		СтрокаЗапроса = "cmd["+КлючСчета+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.invoice.add?" + ТелоЗапроса);	
	Иначе
		СтрокаЗапроса = "cmd["+КлючСчета+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.invoice.update?id=" + ИдентификаторБ24 + "&"  + ТелоЗапроса);	
	КонецЕсли;			
				
	СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючСчета, ПолучитьСтруктуруКлючейБатчЗапросов(СтруктураНастроек.ТипыОбъектовОбмена.Счет, ИнформацияОСчете.Идентификатор1С));
	
#КонецОбласти	
		
#Область РеквизитыСчета		
	
	Если НЕ ЗначениеЗаполнено(ИнформацияОСчете.ИдентификаторРеквизитаБ24) Тогда
		Возврат СтрокаЗапроса;
	КонецЕсли;	
		
	Поля = Новый Структура;
	
	Поля.Вставить("ENTITY_TYPE_ID"		, 5);
	Поля.Вставить("REQUISITE_ID"		, ИнформацияОСчете.ИдентификаторРеквизитаБ24);
	Поля.Вставить("MC_REQUISITE_ID"		, ?(ЗначениеЗаполнено(ИнформацияОСчете.ИдентификаторРеквизитаОрганизацииБ24), ИнформацияОСчете.ИдентификаторРеквизитаОрганизацииБ24, 0));		
	Поля.Вставить("BANK_DETAIL_ID"		, 0);	
	Поля.Вставить("MC_BANK_DETAIL_ID"	, 0);  
		
	ТелоРеквизитовСчета = "";
	Для каждого ТекПоле Из Поля Цикл
		ТелоРеквизитовСчета = ТелоРеквизитовСчета + ?(СтрДлина(ТелоРеквизитовСчета) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
	КонецЦикла;  
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторБ24) Тогда
		ТелоРеквизитовСчета = ТелоРеквизитовСчета + "&fields[ENTITY_ID]=" + "&fields[ID]=$result["+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КлючСчета)+"]";
	Иначе
		ТелоРеквизитовСчета = ТелоРеквизитовСчета + "&fields[ENTITY_ID]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторБ24);	
	КонецЕсли;
	
	СтрокаЗапроса = СтрокаЗапроса + "&" + "cmd[]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.requisite.link.register?" + ТелоРеквизитовСчета);	

#КонецОбласти

	Возврат СтрокаЗапроса;
	
КонецФункции

Функция ПолучитьИдПечатнойФормыСчета(СтруктураНастроек, ТипОрганизации, Организация)
	
	Результат = Неопределено;
	
	Если ТипОрганизации = "Контакт" Тогда 	
		
		тзнПечФорм = СтруктураНастроек.НастройкиСинхронизацииСчетов.ПечатныеФормыСчетов;
		Если тзнПечФорм.Колонки.Найти("Организация") <> неопределено Тогда
			НайденныеПечФормы = СтруктураНастроек.НастройкиСинхронизацииСчетов.ПечатныеФормыСчетов.НайтиСтроки(Новый Структура("Используется, ТипКлиента, Организация", Истина, "Контакт", Организация));
			Если НайденныеПечФормы.Количество() > 0 Тогда
				Результат = НайденныеПечФормы[0].ИдПечатнойФормы;
			Иначе
				НайденныеПечФормы = СтруктураНастроек.НастройкиСинхронизацииСчетов.ПечатныеФормыСчетов.НайтиСтроки(Новый Структура("Используется, ТипКлиента", Истина, "Контакт"));
				Если НайденныеПечФормы.Количество() > 0 Тогда
					Результат = НайденныеПечФормы[0].ИдПечатнойФормы;
				Иначе
					Результат = 2;
				КонецЕсли;
			КонецЕсли;
		Иначе
			НайденныеПечФормы = СтруктураНастроек.НастройкиСинхронизацииСчетов.ПечатныеФормыСчетов.НайтиСтроки(Новый Структура("Используется, ТипКлиента", Истина, "Контакт"));
			Если НайденныеПечФормы.Количество() > 0 Тогда
				Результат = НайденныеПечФормы[0].ИдПечатнойФормы;
			Иначе
				Результат = 2;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипОрганизации = "Компания" Тогда 	
		
		тзнПечФорм = СтруктураНастроек.НастройкиСинхронизацииСчетов.ПечатныеФормыСчетов;
		Если тзнПечФорм.Колонки.Найти("Организация") <> неопределено Тогда
			НайденныеПечФормы = СтруктураНастроек.НастройкиСинхронизацииСчетов.ПечатныеФормыСчетов.НайтиСтроки(Новый Структура("Используется, ТипКлиента, Организация", Истина, "Компания", Организация));
			Если НайденныеПечФормы.Количество() > 0 Тогда
				Результат = НайденныеПечФормы[0].ИдПечатнойФормы;
			Иначе
				НайденныеПечФормы = СтруктураНастроек.НастройкиСинхронизацииСчетов.ПечатныеФормыСчетов.НайтиСтроки(Новый Структура("Используется, ТипКлиента", Истина, "Компания"));
				Если НайденныеПечФормы.Количество() > 0 Тогда
					Результат = НайденныеПечФормы[0].ИдПечатнойФормы;
				Иначе
					Результат = 1;
				КонецЕсли;
			КонецЕсли;
		Иначе
			НайденныеПечФормы = СтруктураНастроек.НастройкиСинхронизацииСчетов.ПечатныеФормыСчетов.НайтиСтроки(Новый Структура("Используется, ТипКлиента", Истина, "Компания"));
			Если НайденныеПечФормы.Количество() > 0 Тогда
				Результат = НайденныеПечФормы[0].ИдПечатнойФормы;
			Иначе
				Результат = 1;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Результат = 1;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКИКонтрагента(МенеджерВременныхТаблиц, Контрагент, ТипКИ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Контрагент"	, Контрагент);
	Запрос.УстановитьПараметр("Тип"			, ТипКИ);
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТ_КИКонтрагентов.Представление КАК Представление
	|ИЗ
	|	ВТ_КИКонтрагентов КАК ВТ_КИКонтрагентов
	|ГДЕ
	|	ВТ_КИКонтрагентов.Контрагент = &Контрагент
	|	И ВТ_КИКонтрагентов.Тип = &Тип";

	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если ВыполненныйЗапрос.Пустой() Тогда
		Возврат "";
	Иначе
		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ПустаяСтрока(Выборка.Представление) Тогда
				Возврат(Выборка.Представление);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции


