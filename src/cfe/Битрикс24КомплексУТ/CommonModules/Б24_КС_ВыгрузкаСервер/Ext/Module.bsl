	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	               |			ПО Товары.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	               |		ПО СчетНаОплатуПокупателюТовары.Номенклатура = Товары.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыТоваров КАК ВТ_ИдентификаторыТоваров
	               |		ПО СчетНаОплатуПокупателюТовары.Номенклатура = ВТ_ИдентификаторыТоваров.Объект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыПредложений КАК ВТ_ИдентификаторыПредложений
	               |		ПО СчетНаОплатуПокупателюТовары.Номенклатура = ВТ_ИдентификаторыПредложений.Объект
	               |ГДЕ
	               |	СчетНаОплатуПокупателюТовары.Ссылка В(&МассивДанных)
	               |	И СчетНаОплатуПокупателюТовары.Количество > 0
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ИдентификаторыТоваров
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ИдентификаторыПредложений
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК ИдентификаторБитрикс24,
	               |	Б24_К_ИдентификаторыОбъектов.ДополнительныйИдентификатор КАК ДополнительныйИдентификаторБитрикс24,
	               |	ДополнительныеРеквизитыИСведения.ДополнительныеЗначенияИспользуются КАК ДополнительныеЗначенияИспользуются,
	               |	ДополнительныеРеквизитыИСведения.ТипЗначения КАК ТипЗначения
	               |ПОМЕСТИТЬ ВТ_ИдентификаторыПользовательскихПолей
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	               |		ПО Б24_К_ИдентификаторыОбъектов.Объект = ДополнительныеРеквизитыИСведения.Ссылка
	               |ГДЕ
	               |	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхЗС
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Б24_К_ИдентификаторыОбъектов.Объект КАК Объект,
	               |	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	               |ПОМЕСТИТЬ ВТ_ИдентификаторыЗначенийПользовательскихПолей
	               |ИЗ
	               |	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	               |ГДЕ
	               |	Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхЗСК
	               |	И Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Свойство КАК Свойство,
	               |	ДополнительныеСведения.Значение КАК Значение,
	               |	ДополнительныеСведения.Объект КАК Объект
	               |ПОМЕСТИТЬ ВТ_ЗначенияОбъектов
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект В(&МассивДанных)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ДополнительныеСведения.Свойство,
	               |	ДополнительныеСведения.Объект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗначенияОбъектов.Объект КАК Объект,
	               |	ВТ_ЗначенияОбъектов.Свойство КАК Свойство,
	               |	ВТ_ЗначенияОбъектов.Значение КАК Значение,
	               |	ВТ_ИдентификаторыЗначенийПользовательскихПолей.Идентификатор КАК ИдентификаторЗначенияСвойстваБитрикс24
	               |ПОМЕСТИТЬ ВТ_ЗначенияОбъектовСИд
	               |ИЗ
	               |	ВТ_ЗначенияОбъектов КАК ВТ_ЗначенияОбъектов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИдентификаторыЗначенийПользовательскихПолей КАК ВТ_ИдентификаторыЗначенийПользовательскихПолей
	               |		ПО ВТ_ЗначенияОбъектов.Значение = ВТ_ИдентификаторыЗначенийПользовательскихПолей.Объект
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Объект,
	               |	Свойство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ЗначенияОбъектов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВТ_ИдентификаторыЗначенийПользовательскихПолей";
#КонецОбласти
	
	ДобавитьКЗапросуОбъектовДанныеФайлов(СтруктураНастроек, Запрос);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыгружатьСчета 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "ВыгружатьНаПортал");
	ОбновлятьНаПортале 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "ОбновлятьНаПортале");
	
	Пока Выборка.Следующий() Цикл
		
		СформированныйЗапрос = "";
		
		ИдентификаторБ24 = ИдБ24ПоСсылке(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Счет2, Выборка.Объект);
		
		ЭтоНовыйЭлемент = НЕ ЗначениеЗаполнено(ИдентификаторБ24);
		
		Если ВыгружатьСчета Тогда
			
			Если ЭтоНовыйЭлемент ИЛИ (НЕ ЭтоНовыйЭлемент И ОбновлятьНаПортале) Тогда 
				СформированныйЗапрос = СформироватьСтруктуруДанныхПоСчету2(СтруктураНастроек,  МенеджерВременныхТаблиц, Выборка, ИдентификаторБ24, Пакет);
			Иначе
				СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(Выборка.Идентификатор1С);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СформированныйЗапрос) Тогда
			мЭлементы.Добавить(СформированныйЗапрос);
		Иначе
			СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(Выборка.Идентификатор1С);
		КонецЕсли;
		
	КонецЦикла;
	
	пСтруктураНастроек.КлючиПодчиненныхБатчЗапросов 	= СтруктураНастроек.КлючиПодчиненныхБатчЗапросов; 	
	пСтруктураНастроек.Логирование.НомерСообщения	 	= СтруктураНастроек.Логирование.НомерСообщения; 	
	
	Возврат мЭлементы;	
	
КонецФункции

Функция СформироватьСтруктуруДанныхПоСчету2(СтруктураНастроек, МенеджерВременныхТаблиц, ИнформацияОСчете, ИдентификаторБ24, Пакет)
	
	ИнформацияОПолях 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю");
	ИнформацияОПоляхТЧ 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностейТЧ(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю");
	АлгоритмПриВыгрузкеДанныхНаПортал 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "АлгоритмПриВыгрузкеДанныхНаПортал");
	ОбновлятьТЧНаПортале 				= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Счет2", "СчетНаОплатуПокупателю", "ОбновлятьТЧНаПортале") <> Ложь; 

	КлючСчета 	= XMLСтрока(ИнформацияОСчете.Идентификатор1С);
	ИдСчета		= ИдентификаторБ24; 
	
	ТипыОбъектовОбмена = СтруктураНастроек.ТипыОбъектовОбмена;
		
	ЭтоНовыйЭлемент = НЕ ЗначениеЗаполнено(ИдСчета);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Счет", ИнформацияОСчете.Объект);
	Запрос.Текст = " ВЫБРАТЬ *
	|ИЗ
	|	ВТ_ТоварыСчетов КАК ВТ_ТоварыСчетов
	|ГДЕ
	|	ВТ_ТоварыСчетов.Счет = &Счет";
	
	ТоварыСчета = Запрос.Выполнить().Выгрузить();
	
#Область Счет

	ИдНаправленияСчета 		= Неопределено;  
	ИдентификаторСтатуса 	= Неопределено;  
	тзнСтатусов 			= Неопределено;
	Если СтруктураНастроек.НастройкиСинхронизацииСчетов.Свойство("ИнформацияОСтатусах") Тогда
		
		ИнформацияОСтатусах = СтруктураНастроек.НастройкиСинхронизацииСчетов.ИнформацияОСтатусах;
		
		Если ИнформацияОСтатусах <> Неопределено Тогда
			
			Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоСчета" Тогда
			    тзнСтатусов = ИнформацияОСтатусах.СоответствияЗначенийСвойств;
			ИначеЕсли ИнформацияОСтатусах.ИсточникСтатусов1С = "СтатусыСчета" Тогда
			    Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "БП" ИЛИ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
			        тзнСтатусов = ИнформацияОСтатусах.СоответствияСтатусов;
			    Иначе
			        // режим "СтатусыСчета" поддерживается только в БП/ЗУП (в форме нет страницы статусов)
			        тзнСтатусов = Неопределено;
			    КонецЕсли;
			КонецЕсли;
			
			Если тзнСтатусов.Колонки.Найти("ИдНаправления") <> Неопределено Тогда
				
				Если НЕ тзнСтатусов = Неопределено Тогда
					Для каждого ТекСтрока Из тзнСтатусов Цикл
						ИдНаправленияСчета = ТекСтрока.ИдНаправления;
						Прервать;
					КонецЦикла;
				КонецЕсли;
				
			Иначе
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Для счетов не задано сопоставление статусов");
			КонецЕсли;
			
			ПереводитьВСтатусКогдаОплачен 			= Неопределено;
			ПереводитьВСтатусКогдаОтгружен 			= Неопределено;
			ПереводитьВСтатусКогдаОплаченОтгружен 	= Неопределено;     
			
			ПереводитьВСтатусКогдаЧастичноОплачен 			= Неопределено;
			ПереводитьВСтатусКогдаЧастичноОтгружен 			= Неопределено;
			ПереводитьВСтатусКогдаЧастичноОплаченОтгружен 	= Неопределено;      
			
			ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаОплачен"		, ПереводитьВСтатусКогдаОплачен);
			ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаОтгружен"		, ПереводитьВСтатусКогдаОтгружен);
			ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаОплаченОтгружен", ПереводитьВСтатусКогдаОплаченОтгружен);
			
			ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаЧастичноОплачен"		, ПереводитьВСтатусКогдаЧастичноОплачен);
			ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаЧастичноОтгружен"		, ПереводитьВСтатусКогдаЧастичноОтгружен);
			ИнформацияОСтатусах.Свойство("ПереводитьВСтатусКогдаЧастичноОплаченОтгружен", ПереводитьВСтатусКогдаЧастичноОплаченОтгружен);
		
			Если ИнформацияОСчете.Оплата = Перечисления.СтатусОплатыСчета.Оплачен И ИнформацияОСчете.Отгрузка = Перечисления.СтатусыОтгрузки.Отгружен
				И ЗначениеЗаполнено(ПереводитьВСтатусКогдаОплаченОтгружен) Тогда
				ИдентификаторСтатуса = ПереводитьВСтатусКогдаОплаченОтгружен;  	
				ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаОплаченОтгружен);
			ИначеЕсли ИнформацияОСчете.Оплата = Перечисления.СтатусОплатыСчета.Оплачен И ЗначениеЗаполнено(ПереводитьВСтатусКогдаОплачен) Тогда
				ИдентификаторСтатуса = ПереводитьВСтатусКогдаОплачен;  	
				ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаОплачен);
			ИначеЕсли ИнформацияОСчете.Отгрузка = Перечисления.СтатусыОтгрузки.Отгружен И ЗначениеЗаполнено(ПереводитьВСтатусКогдаОтгружен) Тогда
				ИдентификаторСтатуса = ПереводитьВСтатусКогдаОтгружен;  	
				ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаОтгружен);
			ИначеЕсли ИнформацияОСчете.Оплата = Перечисления.СтатусОплатыСчета.ОплаченЧастично И ИнформацияОСчете.Отгрузка = Перечисления.СтатусыОтгрузки.ОтгруженЧастично
				И ЗначениеЗаполнено(ПереводитьВСтатусКогдаЧастичноОплаченОтгружен) Тогда
				ИдентификаторСтатуса = ПереводитьВСтатусКогдаЧастичноОплаченОтгружен;  	
				ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаЧастичноОплаченОтгружен);
			ИначеЕсли ИнформацияОСчете.Оплата = Перечисления.СтатусОплатыСчета.ОплаченЧастично И ЗначениеЗаполнено(ПереводитьВСтатусКогдаЧастичноОплачен) Тогда
				ИдентификаторСтатуса = ПереводитьВСтатусКогдаЧастичноОплачен;  	
				ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаЧастичноОплачен);
			ИначеЕсли ИнформацияОСчете.Отгрузка = Перечисления.СтатусыОтгрузки.ОтгруженЧастично И ЗначениеЗаполнено(ПереводитьВСтатусКогдаЧастичноОтгружен) Тогда
				ИдентификаторСтатуса = ПереводитьВСтатусКогдаЧастичноОтгружен;  	
				ОбновитьСтатусДокумента(СтруктураНастроек, ИнформацияОСчете.Объект, МенеджерВременныхТаблиц, ИнформацияОСтатусах, ПереводитьВСтатусКогдаЧастичноОтгружен);  
			Иначе
				
				Если ИнформацияОСтатусах.ИсточникСтатусов1С = "СтатусыСчета" Тогда
					Статус = ИнформацияОСчете.Статус;
				ИначеЕсли ИнформацияОСтатусах.ИсточникСтатусов1С = "СвойствоСчета" Тогда
					Статус = ПолучитьСвойствоИзВременнойТаблицы(СтруктураНастроек, МенеджерВременныхТаблиц, "ВТ_ТаблицаСвойств", ИнформацияОСчете.Объект, ИнформацияОСтатусах.СвойствоСчета);
				КонецЕсли;
					
				Если ТипЗнч(тзнСтатусов) = Тип("ТаблицаЗначений") Тогда     
					
					НайденнаяСтрока = тзнСтатусов.Найти(Статус, "Статус");
					Если НайденнаяСтрока <> Неопределено Тогда
						ИдентификаторСтатуса = НайденнаяСтрока.ИдСтатуса;  	
					КонецЕсли; 
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЭтоНовыйЭлемент И ИдентификаторСтатуса = Неопределено И ИнформацияОСтатусах.Свойство("СтатусПоУмолчанию") Тогда
				ИдентификаторСтатуса = ИнформацияОСтатусах.СтатусПоУмолчанию;	
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоНовыйЭлемент И НЕ ЗначениеЗаполнено(ИдентификаторСтатуса) Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден статус счета. Документ не будет выгружен");
		СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(ИнформацияОСчете.Объект);   
		Возврат "";
	КонецЕсли;	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИнформацияОПолях"				, ИнформацияОПолях);
	ДополнительныеПараметры.Вставить("КлючЭлемента"					, КлючСчета);
	ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"		, МенеджерВременныхТаблиц);
	ДополнительныеПараметры.Вставить("ЭтоНовыйЭлемент"				, ЭтоНовыйЭлемент);
	ДополнительныеПараметры.Вставить("ИнформацияОбъекта1С"			, ИнформацияОСчете);
	ДополнительныеПараметры.Вставить("ИдНаправленияСчета"			, ИдНаправленияСчета);
	ДополнительныеПараметры.Вставить("ИдентификаторСтатуса"			, ИдентификаторСтатуса);
	ДополнительныеПараметры.Вставить("ТоварыСчета"					, ТоварыСчета);

	ПоляШапки = ПолучитьСтруктуруКлючейЭлементаВыгрузки(СтруктураНастроек, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.НеВыгружать = Истина Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден ответственный у счета: " + Строка(ИнформацияОСчете.Объект) + ". Будет пропущен.");
		Возврат "";	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтруктураНастроек.ДопИдПредопределенногоСвойстваНомерСчета1С) Тогда
		ПоляШапки.Вставить(СтруктураНастроек.ДопИдПредопределенногоСвойстваНомерСчета1С, ПрефиксацияОбъектовКлиентСервер.УдалитьЛидирующиеНулиИзНомераОбъекта(ИнформацияОСчете.Номер));
	КонецЕсли;
	
	Если СтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда
		Если ЗначениеЗаполнено(СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияСчета) Тогда
			ПоляШапки.Вставить(СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияСчета, ?(ИнформацияОСчете.ПометкаУдаления = Истина, "Y", "N"));
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияПользовательскихПолей(СтруктураНастроек, МенеджерВременныхТаблиц, ИнформацияОСчете.Объект, ПоляШапки, ИнформацияОПолях);	
	
	Если ЗначениеЗаполнено(АлгоритмПриВыгрузкеДанныхНаПортал) Тогда
		
		ОтказНаВыгрузку = ВыполнитьАлгоритмПередВыгрузкой(СтруктураНастроек, ИнформацияОСчете.Объект, ПоляШапки, АлгоритмПриВыгрузкеДанныхНаПортал); 
		Если ОтказНаВыгрузку = Истина Тогда
			Возврат "";	
		КонецЕсли;
		
	КонецЕсли;

	//////////////////////////////////////////////////////////////// ++Костылища
	Для каждого ТекПоле Из ПоляШапки Цикл
		Если СтрНайти(ТекПоле.Ключ, "UF_CRM_SMART_INVOICE_") > 0 Тогда    
			
			КонвертированноеПоле = СтрЗаменить(ТекПоле.Ключ, "UF_CRM_SMART_INVOICE_", "ufCrm_SMART_INVOICE_");     
			
			Если ПоляШапки.Свойство(КонвертированноеПоле) = Ложь Тогда
				ПоляШапки.Вставить(КонвертированноеПоле, ТекПоле.Значение); 
			Иначе
				Если НЕ ЗначениеЗаполнено(ПоляШапки[КонвертированноеПоле]) Тогда
					ПоляШапки[КонвертированноеПоле] = ТекПоле.Значение;	
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;  
	                                                    
	Для каждого ТекПоле Из ПоляШапки Цикл
		Если СтрНайти(ТекПоле.Ключ, "ufCrmSmartInvoice") > 0 Тогда      
			
			КонвертированноеПоле = СтрЗаменить(ТекПоле.Ключ, "ufCrmSmartInvoice", "ufCrm_SMART_INVOICE_"); 
			
			Если ПоляШапки.Свойство(КонвертированноеПоле) = Ложь Тогда
				ПоляШапки.Вставить(КонвертированноеПоле, ТекПоле.Значение);  
			Иначе
				Если НЕ ЗначениеЗаполнено(ПоляШапки[КонвертированноеПоле]) Тогда
					ПоляШапки[КонвертированноеПоле] = ТекПоле.Значение;	
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;               
	
	Для каждого ТекПоле Из ПоляШапки Цикл
		Если СтрНайти(ТекПоле.Ключ, "ufCrm_SMART_INVOICE_") > 0 Тогда    
			
			КлючПоля = СтрЗаменить(ТекПоле.Ключ, "ufCrm_SMART_INVOICE_", "");   
			
			Если НЕ ОбщегоНазначенияКлиентСервер.ЭтоЧисло(КлючПоля) Тогда
				
				РазбитыйКлюч = СтрРазделить(КлючПоля, "_");  
				ДлинаМассиваРК = РазбитыйКлюч.Количество();
				Если ДлинаМассиваРК > 0 Тогда  
					
					ИмяКлючаСвойства = "";
					Для пер = 0 По ДлинаМассиваРК-1 Цикл           
						ИмяЭлеменаКлюча = РазбитыйКлюч[пер]; 
						ИмяКлючаСвойства = ИмяКлючаСвойства + ВРег(Лев(ИмяЭлеменаКлюча, 1)) + НРег(Прав(ИмяЭлеменаКлюча, СтрДлина(ИмяЭлеменаКлюча)-1));	
					КонецЦикла;
					
					КонвертированноеПоле = "ufCrmSmartInvoice" + ИмяКлючаСвойства;	
					Если ПоляШапки.Свойство(КонвертированноеПоле) = Ложь Тогда
						ПоляШапки.Вставить(КонвертированноеПоле, ТекПоле.Значение); 
					Иначе
						Если НЕ ЗначениеЗаполнено(ПоляШапки[КонвертированноеПоле]) Тогда
							ПоляШапки[КонвертированноеПоле] = ТекПоле.Значение;	
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;  	
	
	//////////////////////////////////////////////////////////////// --Костылища	
	
	ТелоЗапроса = "";
	мОбработанныеПоля = Новый Соответствие;
	Для каждого ТекПоле Из ПоляШапки Цикл
		Если ТекПоле.Значение <> Неопределено Тогда    
			// Имена пользовательских полей приводим к тому же виду, что использует загрузка,
			// иначе поля с ключом UF_CRM_... не попадали в тело запроса и не выгружались.
			ИмяКлючаПоля = Б24_К_ОбщегоНазначенияВызовСервера.КонвертацияИмёнКлючей("Счет2", ТекПоле.Ключ, Ложь);
			Если мОбработанныеПоля.Получить(ИмяКлючаПоля) = Неопределено Тогда
				мОбработанныеПоля.Вставить(ИмяКлючаПоля, Истина);
				ТелоЗапроса = ТелоЗапроса + "&fields["+ ИмяКлючаПоля + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
			КонецЕсли;		
		КонецЕсли;		
	КонецЦикла;  
	
	ТелоЗапроса = ТелоЗапроса + ДанныеРестКлючаФайлов(СтруктураНастроек, МенеджерВременныхТаблиц, ИнформацияОСчете.Объект);
	
	Если ЭтоНовыйЭлемент Тогда
		СтрокаЗапроса = "cmd["+КлючСчета+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.item.add?entityTypeId=31" + ТелоЗапроса);	
	Иначе
		СтрокаЗапроса = "cmd["+КлючСчета+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.item.update?id=" + ИдСчета + "&entityTypeId=31" + ТелоЗапроса);
	КонецЕсли;
				
	СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючСчета, ПолучитьСтруктуруКлючейБатчЗапросов(ТипыОбъектовОбмена.Счет2, ИнформацияОСчете.Идентификатор1С));
	
#КонецОбласти	


#Область ТоварыСчета

	Если ОбновлятьТЧНаПортале Тогда    
		
		ЗапросПоТоварамЭлемента 	= "";
		НомерСтроки 				= 1;	
		Для каждого ТоварСчета Из ТоварыСчета Цикл

			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ИнформацияОПолях"			, ИнформацияОПоляхТЧ);
			ДополнительныеПараметры.Вставить("КлючЭлемента"				, КлючСчета);
			ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
			ДополнительныеПараметры.Вставить("ЭтоНовыйЭлемент"			, ЭтоНовыйЭлемент);
			ДополнительныеПараметры.Вставить("ИнформацияОбъекта1С"		, ИнформацияОСчете);
			ДополнительныеПараметры.Вставить("Товары"					, ТоварыСчета);
			ДополнительныеПараметры.Вставить("ИнформацияСтрокиТЧ"		, ТоварСчета);
			ДополнительныеПараметры.Вставить("КлючСвязи"				, ТоварСчета.КлючСвязи);
			ДополнительныеПараметры.Вставить("ИмяТЧ"					, "Товары");

			ПоляТЧ = ПолучитьСтруктуруКлючейТЧЭлементаВыгрузки(СтруктураНастроек, ДополнительныеПараметры);

			Для каждого ТекПоле Из ПоляТЧ Цикл
				Если ТекПоле.Значение <> Неопределено Тогда
					ЗапросПоТоварамЭлемента = ЗапросПоТоварамЭлемента + "&productRows["+Формат(НомерСтроки, "ЧГ=0")+"]["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение);			
				КонецЕсли;	
			КонецЦикла;  
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;	
		
		Если ЗначениеЗаполнено(ЗапросПоТоварамЭлемента) Тогда
			
			Если ЭтоНовыйЭлемент Тогда
				ЗапросПоТоварамЭлемента = "ownerType=SI&ownerId=$result["+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КлючСчета)+"][item][id]"+ЗапросПоТоварамЭлемента;			
			Иначе
				ЗапросПоТоварамЭлемента = "ownerType=SI&ownerId="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСчета)+ЗапросПоТоварамЭлемента;
			КонецЕсли;		
			
			СтрокаЗапроса = СтрокаЗапроса + "&" + "cmd[]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.item.productrow.set?" + ЗапросПоТоварамЭлемента);	

		КонецЕсли;
		
	КонецЕсли;

#КонецОбласти
	
#Область ДелоСчета

	КонфигурируемыеДела = СтруктураНастроек.КонфигурируемыеДела;

	ИдентификаторДела = РегистрыСведений.Б24_К_ИдентификаторыДел.ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТипыОбъектовОбмена.КонфигурируемоеДелоСчета,
		ИнформацияОСчете.Объект);

	Если ЗначениеЗаполнено(ИдентификаторДела) Тогда
		КонфигурируемыеДела = Истина;
	Иначе

		ИдентификаторДела = РегистрыСведений.Б24_К_ИдентификаторыДел.ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТипыОбъектовОбмена.ДелоСчета,
			ИнформацияОСчете.Объект);

		Если ЗначениеЗаполнено(ИдентификаторДела) Тогда
			КонфигурируемыеДела = Ложь;
		КонецЕсли;

	КонецЕсли;

	ТелоДела = Б24_К_ВыгрузкаДелСервер.ПолучитьТелоЗапросаДела(СтруктураНастроек, ?(КонфигурируемыеДела, "Конфигурируемое", "Стандартное"),
		Б24_К_RestApiВызовСервера.ПолучитьТипВладельцаТаймЛайнПоТипуДанных(	ТипыОбъектовОбмена.Счет2), ИдСчета, КлючСчета, ИнформацияОСчете.Идентификатор1С,, Истина);

	ТелоДела = СтрЗаменить(ТелоДела, "$result["+КлючСчета+"]", "$result["+КлючСчета+"][item][id]"); 

	Если ЗначениеЗаполнено(ТелоДела) Тогда

		КлючДела = "D_" + КлючСчета;

		СтрокаЗапроса = СтрокаЗапроса + Б24_К_ВыгрузкаДелСервер.ПолучитьЗапросДела(СтруктураНастроек, ?(КонфигурируемыеДела, "Конфигурируемое", "Стандартное"),
			КлючДела, ИдентификаторДела, ТелоДела);

		СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючДела, ПолучитьСтруктуруКлючейБатчЗапросов(?(КонфигурируемыеДела,
			ТипыОбъектовОбмена.КонфигурируемоеДелоСчета, ТипыОбъектовОбмена.ДелоСчета), ИнформацияОСчете.Идентификатор1С));

	КонецЕсли;

#КонецОбласти

	Возврат СтрокаЗапроса;
	
КонецФункции


///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


Функция СформироватьДанныеПоСделкам(пСтруктураНастроек, МассивДанных, Пакет) Экспорт
	
	мЭлементы 	=  Новый массив;
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" Тогда
		Возврат мЭлементы;	
	КонецЕсли;
	СтруктураНастроек = Новый Структура;
	Для Каждого ЭлементСтруктуры Из пСтруктураНастроек Цикл
		СтруктураНастроек.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;	
	
#Область ИдентификаторыСлужебныхСвойств	

	ДопИдСвойстваОрганизации 	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоОрганизацияСделки, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСделки); 
	СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваОрганизацииСделки", ДопИдСвойстваОрганизации);
	
	ДопИдСвойстваНомер1С	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоНомер1ССделки, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСделки); 
	СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваНомерСделки1С", ДопИдСвойстваНомер1С);
	
	Если пСтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда 	
		ДопИдСвойстваПометкиУдаления	= РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоПометкаУдаленияСделок, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоСделки); 
		СтруктураНастроек.Вставить("ДопИдПредопределенногоСвойстваПометкиУдаленияСделки", ДопИдСвойстваПометкиУдаления);
	КонецЕсли;	
	
#КонецОбласти
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ФормированиеВременныхТаблицДанных	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивДанных"		, МассивДанных);  
	Запрос.УстановитьПараметр("АктуальнаяДатаСеанса", СтруктураНастроек.ДатаФормирования);
	Запрос.УстановитьПараметр("Портал"			 	, СтруктураНастроек.Портал);
	Запрос.УстановитьПараметр("СвойствоОрганизации"	, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоОрганизацияСделки);
	Запрос.УстановитьПараметр("ТипДанныхЗаказов"	, СтруктураНастроек.ТипыОбъектовОбмена.Заказ);
	Запрос.УстановитьПараметр("ТипДанныхКомпаний"	, СтруктураНастроек.ТипыОбъектовОбмена.Компания);
	Запрос.УстановитьПараметр("ТипДанныхКонтактов"	, СтруктураНастроек.ТипыОбъектовОбмена.Контакт);	
	Запрос.УстановитьПараметр("ТипДанныхРеквизитов"	, СтруктураНастроек.ТипыОбъектовОбмена.Реквизит);
	Запрос.УстановитьПараметр("ТипДанныхБанкСчетов"	, СтруктураНастроек.ТипыОбъектовОбмена.БанковскийСчетРеквизита);	
	Запрос.УстановитьПараметр("ТипДанныхТоваров"	, СтруктураНастроек.ТипыОбъектовОбмена.Товар);			
	Запрос.УстановитьПараметр("ТипДанныхЗначениеСвойства", СтруктураНастроек.ТипыОбъектовОбмена.ЗначениеСвойстваСделки);
	Запрос.УстановитьПараметр("ТипДанныхТоваров2"	, СтруктураНастроек.ТипыОбъектовОбмена.Товар2);
	Запрос.УстановитьПараметр("ТипДанныхПредложений", СтруктураНастроек.ТипыОбъектовОбмена.Предложение);
