	АлгоритмПриВыгрузкеДанныхНаПорталКомпаний	 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Компания", СправочникКомпаний, "АлгоритмПриВыгрузкеДанныхНаПортал");
	АлгоритмПриВыгрузкеДанныхНаПорталОрганизаций	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Компания", "Организации", "АлгоритмПриВыгрузкеДанныхНаПортал");
	
	ПоляКомпаний 			= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Компания", СправочникКомпаний);
	ПоляОрганизаций 		= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Компания", "Организации");
	
	ОбновлятьНаПорталеКомпании	 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Компания", СправочникКомпаний, "ОбновлятьНаПортале");
	ОбновлятьНаПорталеОрганизации 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Компания", "Организации", "ОбновлятьНаПортале");
	
	Пока Выборка.Следующий() Цикл
		
		НеВыгружать = Ложь;
		Для каждого ТекЭлемент Из РезультатОбработкиПоискаПередДобавлениемНовых Цикл
			Если ТекЭлемент.Объект = Выборка.Объект И ТекЭлемент.Результат = "Ошибка" Тогда 	
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Было найдено несколько компаний по алгоритму поиска для клиента: " + Выборка.Наименование + ". Будет пропущен");
				НеВыгружать = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НеВыгружать Тогда
			Продолжить;
		КонецЕсли;
		
		СформированныйЗапрос = "";
		
		ЭтоНовыйЭлемент = НЕ ЗначениеЗаполнено(Выборка.ИдентификаторБ24);
		
		Если Выборка.ЭтоОрганизация = "N" И ВыгружатьКомпании Тогда
			
			Если ЭтоНовыйЭлемент ИЛИ (НЕ ЭтоНовыйЭлемент И ОбновлятьНаПорталеКомпании) Тогда 
				СформированныйЗапрос = СформироватьСтруктуруДанныхПоКомпании(СтруктураНастроек, ПоляКомпаний, АлгоритмПриВыгрузкеДанныхНаПорталКомпаний, МенеджерВременныхТаблиц, Выборка, СтруктураИспВидовКИ);
			Иначе
				// Диагностика: компания уже существует на портале, а обновление отключено - выгрузка молча пропущена
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация,
					"Компания пропущена при выгрузке: " + Выборка.Наименование + " (Ид1С: " + Строка(Выборка.Идентификатор1С) + "). Причина: компания уже связана с компанией на портале (ИдБ24: " + Строка(Выборка.ИдентификаторБ24) + "), параметр 'ОбновлятьНаПортале' = Ложь.");
				СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(Выборка.Идентификатор1С);
			КонецЕсли;
			
		ИначеЕсли Выборка.ЭтоОрганизация = "Y" И ВыгружатьОрганизации Тогда
			
			Если ЭтоНовыйЭлемент ИЛИ (НЕ ЭтоНовыйЭлемент И ОбновлятьНаПорталеОрганизации) Тогда 
				СформированныйЗапрос = СформироватьСтруктуруДанныхПоКомпании(СтруктураНастроек, ПоляОрганизаций, АлгоритмПриВыгрузкеДанныхНаПорталОрганизаций, МенеджерВременныхТаблиц, Выборка, СтруктураИспВидовКИ);
			Иначе
				// Диагностика: организация уже существует на портале, а обновление отключено - выгрузка молча пропущена
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация,
					"Организация пропущена при выгрузке: " + Выборка.Наименование + " (Ид1С: " + Строка(Выборка.Идентификатор1С) + "). Причина: организация уже связана с организацией на портале (ИдБ24: " + Строка(Выборка.ИдентификаторБ24) + "), параметр 'ОбновлятьНаПортале' = Ложь.");
				СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(Выборка.Идентификатор1С);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СформированныйЗапрос) Тогда
			мЭлементы.Добавить(СформированныйЗапрос);
		Иначе
			// Диагностика: компания/организация не попала ни в одну ветку выгрузки (СформированныйЗапрос пуст) - логируем причину
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация,
				"Компания не сформирована для выгрузки (СформированныйЗапрос пуст): " + Выборка.Наименование + " (Ид1С: " + Строка(Выборка.Идентификатор1С) + ", ИдБ24: " + Строка(Выборка.ИдентификаторБ24) + "). Проверьте флаги 'ВыгружатьНаПортал'/'ОбновлятьНаПортале' и правила идентификации для сущности Компания.");
			СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(Выборка.Идентификатор1С);
		КонецЕсли;
		
	КонецЦикла;
	
	пСтруктураНастроек.КлючиПодчиненныхБатчЗапросов 	= СтруктураНастроек.КлючиПодчиненныхБатчЗапросов; 	// чтобы лог не затерся.
	пСтруктураНастроек.Логирование.НомерСообщения	 	= СтруктураНастроек.Логирование.НомерСообщения; 	// чтобы лог не затерся.
	
	Возврат мЭлементы;	
	
КонецФункции

Функция СформироватьСтруктуруДанныхПоКомпании(СтруктураНастроек, ИнформацияОПолях, АлгоритмПриВыгрузкеДанныхНаПортал, МенеджерВременныхТаблиц, ИнформацияОКомпании, СтруктураИспВидовКИ)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ЭтоНовыйЭлемент = НЕ ЗначениеЗаполнено(ИнформацияОКомпании.ИдентификаторБ24);	
	КлючКомпании = XMLСтрока(ИнформацияОКомпании.Идентификатор1С);	
	ТипыОбъектовОбмена = СтруктураНастроек.ТипыОбъектовОбмена;
	
#Область Компания

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИнформацияОПолях"			, ИнформацияОПолях);
	ДополнительныеПараметры.Вставить("КлючЭлемента"				, КлючКомпании);
	ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"	, МенеджерВременныхТаблиц);
	ДополнительныеПараметры.Вставить("ЭтоНовыйЭлемент"			, ЭтоНовыйЭлемент);
	ДополнительныеПараметры.Вставить("ИнформацияОбъекта1С"		, ИнформацияОКомпании);

	Поля = ПолучитьСтруктуруКлючейЭлементаВыгрузки(СтруктураНастроек, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.НеВыгружать = Истина Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Не найден ответственный у контрагента: " + Строка(ИнформацияОКомпании.Объект) + ". Будет пропущен.");
		Возврат "";	
	КонецЕсли;	
	
	Если СтруктураНастроек.Свойство("ДопИдПредопределенногоСвойстваВзаиморасчетов") И ЗначениеЗаполнено(СтруктураНастроек.ДопИдПредопределенногоСвойстваВзаиморасчетов) Тогда
		Если ТипКонфигурации = "БП" Тогда
			Поля.Вставить(СтруктураНастроек.ДопИдПредопределенногоСвойстваВзаиморасчетов, ИнформацияОКомпании.Долг)
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			Долг = ИнформацияОКомпании.ДолгПокупателя - ИнформацияОКомпании.ДолгПоставщика;
			Поля.Вставить(СтруктураНастроек.ДопИдПредопределенногоСвойстваВзаиморасчетов, Долг)
		КонецЕсли;
	КонецЕсли;
		
	Если СтруктураНастроек.ОбрабатыватьУдалениеОбъектовВ1С Тогда
		Если ЗначениеЗаполнено(СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияКомпании) Тогда
			Поля.Вставить(СтруктураНастроек.ДопИдПредопределенногоСвойстваПометкиУдаленияКомпании, ИнформацияОКомпании.ПометкаУдаления)
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияПользовательскихПолей(СтруктураНастроек, МенеджерВременныхТаблиц, ИнформацияОКомпании.Объект, Поля, ИнформацияОПолях);	
	
	Если ЗначениеЗаполнено(АлгоритмПриВыгрузкеДанныхНаПортал) Тогда
		
		ОтказНаВыгрузку = ВыполнитьАлгоритмПередВыгрузкой(СтруктураНастроек, ИнформацияОКомпании.Объект, Поля, АлгоритмПриВыгрузкеДанныхНаПортал);
		Если ОтказНаВыгрузку = Истина Тогда
			Возврат "";	
		КонецЕсли;
		
	КонецЕсли;	
	
	ТелоЗапроса = "";
	Для каждого ТекПоле Из Поля Цикл
		Если ТекПоле.Значение <> Неопределено Тогда
			ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
		КонецЕсли;	
	КонецЦикла;    
	
	ЗаполнениеТелефонаИПочтыДляКомпании(СтруктураНастроек, ИнформацияОКомпании.Объект, МенеджерВременныхТаблиц, СтруктураИспВидовКИ, ТелоЗапроса);
	
	ТелоЗапроса = ТелоЗапроса + ДанныеРестКлючаФайлов(СтруктураНастроек, МенеджерВременныхТаблиц, ИнформацияОКомпании.Объект);
	
	Если ЭтоНовыйЭлемент Тогда
		
		// === ПРАВКА: защита от дублей и потери ID при повторной/параллельной выгрузке одного контрагента ===
		// Перед crm.company.add ищем на портале уже созданную компанию по внешнему ИД (ORIGIN_ID = КлючКомпании).
		// Если компания уже существует — используем её ID (update вместо нового add) и сразу фиксируем ID в 1С.
		ЭлементыПоВнешнемуИД = Б24_К_RestApiВызовСервера.МассивЭлементовПоМетоду(СтруктураНастроек,
			"/rest/crm.company.list",
			"filter[%3FORIGIN_ID]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КлючКомпании)
			+ "&filter[%3FORIGINATOR_ID]=ONE_C&select[]=ID");
		
		Если ЭлементыПоВнешнемуИД.Количество() > 0 Тогда
			ИдКомпанииНаПортале = ЭлементыПоВнешнемуИД[0].Получить("ID");
			Если ЗначениеЗаполнено(ИдКомпанииНаПортале) Тогда
				СтрокаЗапроса = "cmd["+КлючКомпании+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(
					"crm.company.update?id=" + ИдКомпанииНаПортале + "&" + ТелоЗапроса);
				РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(
					СтруктураНастроек, ТипыОбъектовОбмена.Компания, ИнформацияОКомпании.Объект, ИдКомпанииНаПортале);
				СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючКомпании,
					ПолучитьСтруктуруКлючейБатчЗапросов(ТипыОбъектовОбмена.Компания, ИнформацияОКомпании.Идентификатор1С));
				Возврат СтрокаЗапроса;
			КонецЕсли;
		КонецЕсли;
		// === /ПРАВКА ===
		
		СтрокаЗапроса = "cmd["+КлючКомпании+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.company.add?"  + ТелоЗапроса);	
	Иначе
		СтрокаЗапроса = "cmd["+КлючКомпании+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.company.update?id=" + ИнформацияОКомпании.ИдентификаторБ24 + "&" + ТелоЗапроса);	
	КонецЕсли;
				
	СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючКомпании, ПолучитьСтруктуруКлючейБатчЗапросов(ТипыОбъектовОбмена.Компания, ИнформацияОКомпании.Идентификатор1С));
	
#КонецОбласти


#Область ДелоКомпании

	КонфигурируемыеДела = СтруктураНастроек.КонфигурируемыеДела;

	ИдентификаторДела = РегистрыСведений.Б24_К_ИдентификаторыДел.ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТипыОбъектовОбмена.КонфигурируемоеДелоКомпании,
		ИнформацияОКомпании.Объект);

	Если ЗначениеЗаполнено(ИдентификаторДела) Тогда
		КонфигурируемыеДела = Истина;
	Иначе

		ИдентификаторДела = РегистрыСведений.Б24_К_ИдентификаторыДел.ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТипыОбъектовОбмена.ДелоКомпании,
			ИнформацияОКомпании.Объект);

		Если ЗначениеЗаполнено(ИдентификаторДела) Тогда
			КонфигурируемыеДела = Ложь;
		КонецЕсли;

	КонецЕсли;

	ТелоДела = Б24_К_ВыгрузкаДелСервер.ПолучитьТелоЗапросаДела(СтруктураНастроек, ?(КонфигурируемыеДела, "Конфигурируемое", "Стандартное"),
		Б24_К_RestApiВызовСервера.ПолучитьТипВладельцаТаймЛайнПоТипуДанных(	ТипыОбъектовОбмена.Компания), ИнформацияОКомпании.ИдентификаторБ24,
		КлючКомпании, ИнформацияОКомпании.Идентификатор1С);

	Если ЗначениеЗаполнено(ТелоДела) Тогда

		КлючДела = "D_" + КлючКомпании;

		СтрокаЗапроса = СтрокаЗапроса + Б24_К_ВыгрузкаДелСервер.ПолучитьЗапросДела(СтруктураНастроек, ?(КонфигурируемыеДела, "Конфигурируемое", "Стандартное"),
			КлючДела, ИдентификаторДела, ТелоДела);

		СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючДела, ПолучитьСтруктуруКлючейБатчЗапросов(?(КонфигурируемыеДела,
			ТипыОбъектовОбмена.КонфигурируемоеДелоКомпании, ТипыОбъектовОбмена.ДелоКомпании), ИнформацияОКомпании.Идентификатор1С));

	КонецЕсли;

#КонецОбласти

	Возврат СтрокаЗапроса;
	
КонецФункции

#КонецОбласти


#Область Контакты  

Функция СформироватьДанныеПоКонтактам(пСтруктураНастроек, МассивДанных) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" Тогда
		СправочникКомпаний = "Контрагенты";
		СправочникКонтактов = "КонтактныеЛица";
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		СправочникКомпаний = "Партнеры";
		СправочникКонтактов = "КонтактныеЛицаПартнеров";
	КонецЕсли;
	СтруктураНастроек = Новый Структура;
	Для Каждого ЭлементСтруктуры Из пСтруктураНастроек Цикл
		СтруктураНастроек.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);
	КонецЦикла;	

	РезультатОбработкиПоискаПередДобавлениемНовых = ПроверитьНаличиеКонтактовПередДобавлениемНовых(СтруктураНастроек, МассивДанных);
	
#Область ИдентификаторыСлужебныхСвойств	

Если ТипКонфигурации = "УТ" Тогда
	Если НЕ СтруктураНастроек.ПредопределенныеСвойства.Свойство("ПредопределенноеСвойствоПолКонтактов") Тогда 
		СтруктураНастроек.ПредопределенныеСвойства.Вставить("ПредопределенноеСвойствоПолКонтактов", Неопределено);	
	КонецЕсли;
	ДопИдСвойстваПола = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьДопИдОбъекта(СтруктураНастроек.Портал, СтруктураНастроек.ПредопределенныеСвойства.ПредопределенноеСвойствоПолКонтактов, СтруктураНастроек.ТипыОбъектовОбмена.СвойствоКонтакта); 
