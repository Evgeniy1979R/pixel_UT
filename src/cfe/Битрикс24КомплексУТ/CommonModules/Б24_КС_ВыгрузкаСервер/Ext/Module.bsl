		Запрос.УстановитьПараметр("Объект", ДанныеДляПоиска.Объект); 
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_Справочник.НомерСчета КАК НомерСчета
		|ИЗ
		|	ВТ_Справочник КАК ВТ_Справочник
		|ГДЕ
		|	ВТ_Справочник.Объект = &Объект"; 
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.НомерСчета) Тогда
				Для каждого ТекЭлемент Из ДанныеДляПоиска.СтруктураДанных.НомераСчетов Цикл
					Если Выборка.НомерСчета = ТекЭлемент.НомерСчета Тогда  	
						Результат.Добавить(ТекЭлемент.Идентификатор);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли Алгоритм = "БИК" Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = ДанныеДляПоиска.МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("Объект", ДанныеДляПоиска.Объект); 
		Запрос.Текст = "ВЫБРАТЬ
		|	ВТ_Справочник.БикБанка КАК БикБанка
		|ИЗ
		|	ВТ_Справочник КАК ВТ_Справочник
		|ГДЕ
		|	ВТ_Справочник.Объект = &Объект"; 
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.БикБанка) Тогда
				Для каждого ТекЭлемент Из ДанныеДляПоиска.СтруктураДанных.БИК Цикл
					Если Выборка.БикБанка = ТекЭлемент.БИК Тогда  	
						Результат.Добавить(ТекЭлемент.Идентификатор);
					КонецЕсли;
				КонецЦикла;
			Иначе
				Результат = Неопределено;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено(Идентификатор) Тогда  
		
		НайденнаяСтрока = ДанныеДляПоиска.ТаблицаСвойств.Найти(Идентификатор, "Идентификатор");
		Если ЗначениеЗаполнено(НайденнаяСтрока) Тогда
		
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = ДанныеДляПоиска.МенеджерВременныхТаблиц;
			Запрос.УстановитьПараметр("Свойство", НайденнаяСтрока.Свойство); 
			Запрос.УстановитьПараметр("Объект"	, ДанныеДляПоиска.Объект); 
			Запрос.Текст = " ВЫБРАТЬ
			|	ВТ_ЗначенияСвойств.Значение КАК Значение
			|ИЗ
			|	ВТ_ЗначенияСвойств КАК ВТ_ЗначенияСвойств
			|ГДЕ
			|	ВТ_ЗначенияСвойств.Объект = &Объект
			|	И ВТ_ЗначенияСвойств.Свойство = &Свойство";
		
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Если ЗначениеЗаполнено(Выборка.Значение) Тогда
					Для каждого ТекЭлемент Из ДанныеДляПоиска.СтруктураДанных[НайденнаяСтрока.ДопИд] Цикл
						Если Выборка.Значение = ТекЭлемент.Значение Тогда  	
							Результат.Добавить(ТекЭлемент.Идентификатор);
						КонецЕсли;
					КонецЦикла;
				Иначе
					Результат = Неопределено;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция РазбитьТелефоныВМассив(НомераТелефонов)

	МассивКонтактов = Новый Массив;   
	
	ЕстьТочкаЗапятые= Ложь;
	ЕстьЗапятые 	= Ложь;    
	
	НомераТелефоновСтрокой = СтрЗаменить(НомераТелефонов, "(", "");
	НомераТелефоновСтрокой = СтрЗаменить(НомераТелефоновСтрокой, ")", "");
	НомераТелефоновСтрокой = СтрЗаменить(НомераТелефоновСтрокой, " ", "");
	
	Если СтрНайти(НомераТелефоновСтрокой, ",") > 0 Тогда
		ЕстьЗапятые = Истина;
		МассивКонтактов = СтрРазделить(НомераТелефоновСтрокой, ",")
	КонецЕсли;
	
	Если СтрНайти(НомераТелефоновСтрокой, ";") > 0 Тогда
		ЕстьТочкаЗапятые = Истина;
		МассивКонтактов = СтрРазделить(НомераТелефоновСтрокой, ";")
	КонецЕсли;
	
	Если НЕ ЕстьТочкаЗапятые И НЕ ЕстьЗапятые Тогда
		МассивКонтактов.Добавить(НомераТелефоновСтрокой);	
	КонецЕсли;       
	
	Возврат МассивКонтактов;
	
КонецФункции

Функция СформироватьФильтрПоКлючу(ИмяКлюча, ЗначениеКлюча, ЭтоМассив = Ложь, ПолноеСравнение = Истина)  
	
	Если ЭтоМассив Тогда ПараметрМассив = "[]" КонецЕсли;	
	
	Результат = "&filter[" + ?(ПолноеСравнение, "%3D", "") + ИмяКлюча + "]" + ПараметрМассив + "=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ЗначениеКлюча); 
	
	Возврат Результат;
	
КонецФункции

Процедура НайтиЭлементыСвойстваПравилаРекурсивно(ДеревоПравил, ТаблицаСвойств)
	
	ЕстьКолонкаИдентификатор = Ложь;
	Если ТипЗнч(ДеревоПравил) = Тип("ДеревоЗначений") Тогда
		ЕстьКолонкаИдентификатор = ДеревоПравил.Колонки.Найти("Идентификатор") <> Неопределено;	
	ИначеЕсли ТипЗнч(ДеревоПравил) = Тип("СтрокаДереваЗначений") Тогда
		ВладелецДеревоПравил = ДеревоПравил.Владелец();
		ЕстьКолонкаИдентификатор = ВладелецДеревоПравил.Колонки.Найти("Идентификатор") <> Неопределено;
	КонецЕсли;
	
	Для каждого ТекСтрока Из ДеревоПравил.Строки Цикл 
		
		Если ЕстьКолонкаИдентификатор И ЗначениеЗаполнено(ТекСтрока.Идентификатор) Тогда
			
			СсылкаНаСвойство = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"), ТекСтрока.Идентификатор); 
			Если ЗначениеЗаполнено(СсылкаНаСвойство) Тогда      
				
				НоваяСтрока = ТаблицаСвойств.Добавить();	
				НоваяСтрока.Свойство 		= СсылкаНаСвойство;	
				НоваяСтрока.Идентификатор 	= ТекСтрока.Идентификатор;	
				
			КонецЕсли; 
			
		КонецЕсли;
		
		НайтиЭлементыСвойстваПравилаРекурсивно(ТекСтрока, ТаблицаСвойств);   
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

