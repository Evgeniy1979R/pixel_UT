	|ВЫБРАТЬ              
	|	ВТ_ВыгружаемыеОплаты.ИдентификаторЗаказаБитрикс24 КАК ИдентификаторЗаказаБитрикс24,
	|	ВТ_ВыгружаемыеОплаты.ИдентификаторСделкиБитрикс24 КАК ИдентификаторСделкиБитрикс24,
	|	ВТ_ВыгружаемыеОплаты.Оплата КАК Объект,
	|	ВТ_ВыгружаемыеОплаты.Оплата,
	|	ВТ_ВыгружаемыеОплаты.Заказ,
	|	ОперацияПоПлатежнымКартам.Дата,
	|	ОперацияПоПлатежнымКартам.Номер,
	|	ОперацияПоПлатежнымКартам.Проведен,
	|	ОперацияПоПлатежнымКартам.ПометкаУдаления,
	|	ОперацияПоПлатежнымКартам.ВерсияДанных,
	|	ОперацияПоПлатежнымКартам.Комментарий,
	|	ОперацияПоПлатежнымКартам.СуммаДокумента,
	|	ОперацияПоПлатежнымКартам.Валюта,
	|	NULL,
	|	NULL,
	|	ОперацияПоПлатежнымКартам.ЭквайринговыйТерминал,
	|	ОперацияПоПлатежнымКартам.ДоговорЭквайринга,
	|	Валюты.Код КАК ВалютаКод
	|ИЗ
	|	Документ.ОперацияПоПлатежнойКарте КАК ОперацияПоПлатежнымКартам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВыгружаемыеОплаты КАК ВТ_ВыгружаемыеОплаты
	|		ПО ОперацияПоПлатежнымКартам.Ссылка = ВТ_ВыгружаемыеОплаты.Оплата
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ОперацияПоПлатежнымКартам.Валюта = Валюты.Ссылка";	
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
#КонецОбласти	
	
	мЭлементы 	=  Новый массив;
	
	Пока Выборка.Следующий() Цикл
		
		СформированныйЗапрос = СформироватьСтруктуруДанныхПоОплате(СтруктураНастроек, Пакет, Выборка);
		
		Если ЗначениеЗаполнено(СформированныйЗапрос) Тогда
			мЭлементы.Добавить(СформированныйЗапрос);
		Иначе
			СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(Выборка.Оплата);
		КонецЕсли;
		
	КонецЦикла;
	
	пСтруктураНастроек.КлючиПодчиненныхБатчЗапросов = СтруктураНастроек.КлючиПодчиненныхБатчЗапросов; 	
	пСтруктураНастроек.Логирование.НомерСообщения 	= СтруктураНастроек.Логирование.НомерСообщения; 	
	
	Возврат мЭлементы;	
	
КонецФункции

Функция СформироватьСтруктуруДанныхПоОплате(СтруктураНастроек, Пакет, ИнформацияОплаты)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если НЕ СтруктураНастроек.Свойство("НастройкиСинхронизацииОплатОтгрузок") Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "Не заполнены настройки синхронизации оплат и отгрузки");
		Возврат "";	
	КонецЕсли;	
	
	ПрефиксВнешнихКодовБитрикс24 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПрефиксВнешнихКодовБитрикс24();
	ПрефиксВнешнихКодов1С 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьОписаниеПрефиксовВнешнихКодов1С();
	
	ИдентификаторСделкиБ24 	= Прав(ИнформацияОплаты.ИдентификаторСделкиБитрикс24, СтрДлина(ИнформацияОплаты.ИдентификаторСделкиБитрикс24)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.Сделки));
	ИдентификаторЗаказаБ24 	= Прав(ИнформацияОплаты.ИдентификаторЗаказаБитрикс24, СтрДлина(ИнформацияОплаты.ИдентификаторЗаказаБитрикс24)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.Заказы));
	
	ИдентификаторБ24 = ИдБ24ПоСсылке(СтруктураНастроек.Портал, СтруктураНастроек.ТипыОбъектовОбмена.Оплата, ИнформацияОплаты.Оплата);
		
	ЭтоНовыйЭлемент = НЕ ЗначениеЗаполнено(ИдентификаторБ24);
	
	Если ТипЗнч(ИнформацияОплаты.Оплата) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ОплатаПлатежнойКартой") Тогда
		ВыгружатьОплаты 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ОплатаПлатежнойКартой", "ВыгружатьНаПортал");
		ОбновлятьНаПортале 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ОплатаПлатежнойКартой", "ОбновлятьНаПортале");	
		ИнформацияОПолях 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ОплатаПлатежнойКартой");
		АлгоритмПриВыгрузкеДанныхНаПортал 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ОплатаПлатежнойКартой", "АлгоритмПриВыгрузкеДанныхНаПортал");
		КлючОплаты 							= ПрефиксВнешнихКодовБитрикс24.ОперацияПоПлатежнымКартам + XMLСтрока(ИнформацияОплаты.Оплата);
	ИначеЕсли ТипЗнч(ИнформацияОплаты.Оплата) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		ВыгружатьОплаты 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПриходныйКассовыйОрдер", "ВыгружатьНаПортал");
		ОбновлятьНаПортале 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПриходныйКассовыйОрдер", "ОбновлятьНаПортале");	
		ИнформацияОПолях 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПриходныйКассовыйОрдер");
		АлгоритмПриВыгрузкеДанныхНаПортал 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПриходныйКассовыйОрдер", "АлгоритмПриВыгрузкеДанныхНаПортал");
		КлючОплаты 							= ПрефиксВнешнихКодовБитрикс24.ПоступлениеВКассу + XMLСтрока(ИнформацияОплаты.Оплата);
	ИначеЕсли ТипКонфигурации = "БП"
		и ТипЗнч(ИнформацияОплаты.Оплата) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		ВыгружатьОплаты 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПоступлениеНаРасчетныйСчет", "ВыгружатьНаПортал");
		ОбновлятьНаПортале 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПоступлениеНаРасчетныйСчет", "ОбновлятьНаПортале");	
		ИнформацияОПолях 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПоступлениеНаРасчетныйСчет");
		АлгоритмПриВыгрузкеДанныхНаПортал 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПоступлениеНаРасчетныйСчет", "АлгоритмПриВыгрузкеДанныхНаПортал");
		КлючОплаты 							= ПрефиксВнешнихКодовБитрикс24.ПоступлениеНаСчет + XMLСтрока(ИнформацияОплаты.Оплата);
	ИначеЕсли ТипКонфигурации = "УТ"
		и ТипЗнч(ИнформацияОплаты.Оплата) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда
		ВыгружатьОплаты 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПоступлениеБезналичныхДенежныхСредств", "ВыгружатьНаПортал");
		ОбновлятьНаПортале 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПоступлениеБезналичныхДенежныхСредств", "ОбновлятьНаПортале");	
		ИнформацияОПолях 					= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьВыгружаемыеПоляСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПоступлениеБезналичныхДенежныхСредств");
		АлгоритмПриВыгрузкеДанныхНаПортал 	= Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.НастройкиСущностей(СтруктураНастроек.НастройкаПодключения, "Оплата", "ПоступлениеБезналичныхДенежныхСредств", "АлгоритмПриВыгрузкеДанныхНаПортал");
		КлючОплаты 							= ПрефиксВнешнихКодовБитрикс24.ПоступлениеНаСчет + XMLСтрока(ИнформацияОплаты.Оплата);
	КонецЕсли;
	
	Если НЕ ВыгружатьОплаты ИЛИ (НЕ ЭтоНовыйЭлемент И НЕ ОбновлятьНаПортале) Тогда
		СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(ИнформацияОплаты.Оплата);
		Возврат "";
	КонецЕсли;
	
	СоответствияПлатежныхСистем	= Неопределено;
	Если СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.Свойство("ИнформацияОПлатежныхСистемах") Тогда
		СоответствияПлатежныхСистем	= СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИнформацияОПлатежныхСистемах.СоответствияПлатежныхСистем;
	КонецЕсли;
	
	ДополнительнаяИнформация = Новый Структура;
	
	ИнформацияОПлатежнойСистеме = Неопределено;
	ТипОбъекта = ТипЗнч(ИнформацияОплаты.Оплата);
	Если ТипКонфигурации = "БП"
		и ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда 
		Идентификатор1С = ПрефиксВнешнихКодов1С.ПоступлениеНаСчет + XMLСтрока(ИнформацияОплаты.Идентификатор1С);	
		ДополнительнаяИнформация.Вставить("РасчетныйСчет", ИнформацияОплаты.БанковскийСчет);
		ИнформацияОПлатежнойСистеме = ПолучитьИнформациюОПлатежнойСистемеПоСоответствию(2, СоответствияПлатежныхСистем, ДополнительнаяИнформация);
	ИначеЕсли ТипКонфигурации = "УТ"
		и ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда 
		Идентификатор1С = ПрефиксВнешнихКодов1С.ПоступлениеНаСчет + XMLСтрока(ИнформацияОплаты.Оплата);	
		ДополнительнаяИнформация.Вставить("РасчетныйСчет", ИнформацияОплаты.БанковскийСчет);
		ИнформацияОПлатежнойСистеме = ПолучитьИнформациюОПлатежнойСистемеПоСоответствию(2, СоответствияПлатежныхСистем, ДополнительнаяИнформация);
	ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		Если ТипКонфигурации = "БП" Тогда
			Идентификатор1С = ПрефиксВнешнихКодов1С.ПоступлениеВКассу + XMLСтрока(ИнформацияОплаты.Идентификатор1С);	
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			Идентификатор1С = ПрефиксВнешнихКодов1С.ПоступлениеВКассу + XMLСтрока(ИнформацияОплаты.Оплата);	
		КонецЕсли;
		ДополнительнаяИнформация.Вставить("Касса", ИнформацияОплаты.Касса);
		ИнформацияОПлатежнойСистеме = ПолучитьИнформациюОПлатежнойСистемеПоСоответствию(1, СоответствияПлатежныхСистем, ДополнительнаяИнформация);
	Иначе
		Если ТипКонфигурации = "БП" Тогда
			Идентификатор1С = ПрефиксВнешнихКодов1С.ОперацияПоПлатежнымКартам + XMLСтрока(ИнформацияОплаты.Идентификатор1С);
			ДополнительнаяИнформация.Вставить("Терминал"		 , ИнформацияОплаты.ВидОплаты);
			ДополнительнаяИнформация.Вставить("ВидПлатежнойКарты", "");
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			Идентификатор1С = ПрефиксВнешнихКодов1С.ОперацияПоПлатежнымКартам + XMLСтрока(ИнформацияОплаты.Оплата);
			ДополнительнаяИнформация.Вставить("Терминал"		 , ИнформацияОплаты.ЭквайринговыйТерминал);
			ДополнительнаяИнформация.Вставить("ВидПлатежнойКарты", ИнформацияОплаты.ДоговорЭквайринга);
		КонецЕсли;
		ИнформацияОПлатежнойСистеме = ПолучитьИнформациюОПлатежнойСистемеПоСоответствию(3, СоответствияПлатежныхСистем, ДополнительнаяИнформация);
	КонецЕсли;
	
	Если ИнформацияОПлатежнойСистеме <> Неопределено И СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.Свойство("ИспользуемыеПС") Тогда
		
		ПропуститьОплату = СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИспользуемыеПС.Количество() > 0;	
		
		Для каждого ТекЭлементПС Из СтруктураНастроек.НастройкиСинхронизацииОплатОтгрузок.ИспользуемыеПС Цикл
			
			Если ТекЭлементПС.Значение = ИнформацияОПлатежнойСистеме.Ид Тогда 
				ПропуститьОплату = Ложь;    
				Прервать
			КонецЕсли;
			
		КонецЦикла;  
		
		Если ПропуститьОплату Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, " Оплата:  " + Строка(ИнформацияОплаты.Оплата) + " будет пропущена т.к. не подходит под фильтр платежных систем.");
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;
		
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИнформацияОПолях"				, ИнформацияОПолях);
	ДополнительныеПараметры.Вставить("КлючЭлемента"					, КлючОплаты);
	ДополнительныеПараметры.Вставить("МенеджерВременныхТаблиц"		, Неопределено);
	ДополнительныеПараметры.Вставить("ЭтоНовыйЭлемент"				, ЭтоНовыйЭлемент);
	ДополнительныеПараметры.Вставить("ИнформацияОбъекта1С"			, ИнформацияОплаты);
	ДополнительныеПараметры.Вставить("ИдентификаторБ24"				, ИдентификаторБ24);
	ДополнительныеПараметры.Вставить("ИдентификаторЗаказаБ24"		, ИдентификаторЗаказаБ24);
	ДополнительныеПараметры.Вставить("ИнформацияОПлатежнойСистеме"	, ИнформацияОПлатежнойСистеме);
	
	Поля = ПолучитьСтруктуруКлючейЭлементаВыгрузки(СтруктураНастроек, ДополнительныеПараметры);
	
	СтрокаЗапроса 	= "";   
	ТелоЗапроса 	= "";	
	Если ЭтоНовыйЭлемент Тогда
		
		Если ЗначениеЗаполнено(ИдентификаторЗаказаБ24) Тогда
			
			Для каждого ТекПоле Из Поля Цикл
				Если ТекПоле.Значение <> Неопределено Тогда            
					ТелоЗапроса = ТелоЗапроса + "&fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
				КонецЕсли;
			КонецЦикла;  
			
			СтрокаЗапроса = СтрокаЗапроса + "cmd["+КлючОплаты+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("sale.payment.add?" + ТелоЗапроса);
				
		ИначеЕсли НЕ ЗначениеЗаполнено(ИдентификаторЗаказаБ24) И ЗначениеЗаполнено(ИдентификаторСделкиБ24) Тогда  // заказа может не существовать. Создаем фейковую оплату, автоматически создастся заказ
			
			Для каждого ТекПоле Из Поля Цикл
				Если ТекПоле.Значение <> Неопределено И ТекПоле.Ключ <> "orderId" Тогда            
					ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
				КонецЕсли;
			КонецЦикла;  
			
			КлючОплатыЗ 	= "N_" + КлючОплаты;	    
			СтрокаЗапроса 	= "cmd["+КлючОплатыЗ+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.item.payment.add?entityTypeId=2&entityId=" + ИдентификаторСделкиБ24  + "&fields[paySystemId]=" + Поля.paySystemId);   
			СтрокаЗапроса 	= СтрокаЗапроса + "&cmd["+КлючОплаты+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("sale.payment.update?id=$result["+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КлючОплатыЗ)+"]&" + ТелоЗапроса);
			
		Иначе      
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Ошибка, "У оплаты:" + Строка(ИнформацияОплаты.Объект) + " не найден ид. сделки или заказа. Не будет выгружен");
			СтруктураНастроек.НеобновляемыеДанныеНаПортале.Добавить(ИнформацияОплаты.Оплата);
			Возврат СтрокаЗапроса;
		КонецЕсли;   
		
	Иначе

		ТелоЗапроса = "";

		Для каждого ТекПоле Из Поля Цикл
			Если ТекПоле.Значение <> Неопределено Тогда
				ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение); 
			КонецЕсли;
		КонецЦикла;  
		
		СтрокаЗапроса = "cmd["+КлючОплаты+"]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("sale.payment.update?id=" + ИдентификаторБ24 + "&" + ТелоЗапроса);  
		
	КонецЕсли;
	
	СтруктураНастроек.КлючиПодчиненныхБатчЗапросов.Вставить(КлючОплаты, ПолучитьСтруктуруКлючейБатчЗапросов(СтруктураНастроек.ТипыОбъектовОбмена.Оплата, ИнформацияОплаты.Объект));
	
	Возврат СтрокаЗапроса;
	
КонецФункции	

Функция ПолучитьИнформациюОПлатежнойСистемеПоСоответствию(ТипДокумента, СоответствияПлатежныхСистем, ДополнительнаяИнформация)  
	
	РасчетныйСчет 		= Неопределено;
	Касса 				= Неопределено;
	Терминал 			= Неопределено;
	ВидПлатежнойКарты 	= Неопределено;
	
	ДополнительнаяИнформация.Свойство("РасчетныйСчет"	 , РасчетныйСчет);
	ДополнительнаяИнформация.Свойство("Касса"			 , Касса);
	ДополнительнаяИнформация.Свойство("Терминал"		 , Терминал);
	ДополнительнаяИнформация.Свойство("ВидПлатежнойКарты", ВидПлатежнойКарты);
	
	Результат = Неопределено;
	
	Если СоответствияПлатежныхСистем <> Неопределено Тогда
		
		Для каждого ТекПозицияСоответствия Из СоответствияПлатежныхСистем Цикл
			
			Если (ТипДокумента = 1 И ТекПозицияСоответствия.Касса = Касса)
				ИЛИ (ТипДокумента = 3 И ТекПозицияСоответствия.Терминал = Терминал И ТекПозицияСоответствия.ВидПлатежнойКарты = ВидПлатежнойКарты)
				ИЛИ (ТипДокумента = 2 И ТекПозицияСоответствия.РасчетныйСчет = РасчетныйСчет) Тогда
				
					Для каждого ТекПС Из ТекПозицияСоответствия.ПлатежнаяСистема Цикл 							
						Результат = Новый Структура;
						Результат.Вставить("Ид"				, ТекПС.Значение);
						Результат.Вставить("Наименование"	, ТекПС.Представление);
						Возврат Результат;
					КонецЦикла;
				
				КонецЕсли;	
				
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

