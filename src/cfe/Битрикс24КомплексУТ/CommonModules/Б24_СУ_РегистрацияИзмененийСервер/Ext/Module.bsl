			КонецЕсли;
			
			Склады = ИнформацияОНастройке.Склады;
			
			УжеДобавлены = Новый Массив;
			
			ПакетДанных = ПакетДанныхДляРегистрацииИзменений();
			
			Если Замещение Тогда
				
				СтарыйНаборЗаписей = РегистрыСведений["РаспределениеЗапасов"].СоздатьНаборЗаписей();
				
				Для Каждого ЗначениеОтбора Из Источник.Отбор Цикл
					
					Если ЗначениеОтбора.Использование = Ложь Тогда
						Продолжить;
					КонецЕсли;
					
					СтрокаОтбора = СтарыйНаборЗаписей.Отбор.Найти(ЗначениеОтбора.Имя);
					СтрокаОтбора.Значение = ЗначениеОтбора.Значение;
					СтрокаОтбора.Использование = Истина;
					
				КонецЦикла;
				
				СтарыйНаборЗаписей.Прочитать();
				
				Для каждого ТекЗапись Из СтарыйНаборЗаписей Цикл
					
					Если Склады.Найти(ТекЗапись.Склад) <> Неопределено Тогда     
						
						УИДЗаписи = XMLСтрока(ТекЗапись.Склад) +"_"+ XMLСтрока(ТекЗапись.Номенклатура) +"_"+ XMLСтрока(ТекЗапись.Характеристика);   
						Если УжеДобавлены.Найти(УИДЗаписи) = Неопределено Тогда
							
							УжеДобавлены.Добавить(УИДЗаписи);	
							
							ДобавитьЗаписьВПакетДанныхДляРегистрации(ПакетДанных, НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, ТекЗапись.Склад
							, ТекЗапись.Номенклатура, ТекЗапись.Характеристика);
							
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			Для Каждого ТекЗапись Из Источник Цикл
				
				Если Склады.Найти(ТекЗапись.Склад) <> Неопределено Тогда   
					
					УИДЗаписи = XMLСтрока(ТекЗапись.Склад) +"_"+ XMLСтрока(ТекЗапись.Номенклатура) +"_"+ XMLСтрока(ТекЗапись.Характеристика);   
					Если УжеДобавлены.Найти(УИДЗаписи) = Неопределено  Тогда
						
						УжеДобавлены.Добавить(УИДЗаписи);	
						
						ДобавитьЗаписьВПакетДанныхДляРегистрации(ПакетДанных, НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, ТекЗапись.Склад
						, ТекЗапись.Номенклатура, ТекЗапись.Характеристика);
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
			
			ЗарегистрироватьПакетОбъектов(ПакетДанных);
			
		ИначеЕсли ТипКонфигурации = "УНФ" И ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрНакопленияНаборЗаписей.Запасы") Тогда 
			
			Если НЕ ИнформацияОНастройке.ВыгружатьОстатки Тогда
				Продолжить;
			КонецЕсли;
			
  			Склады = ИнформацияОНастройке.Склады;
			
			УжеДобавлены = Новый Массив;
			
			ПакетДанных = ПакетДанныхДляРегистрацииИзменений();
			
			Если Замещение Тогда
				
				СтарыйНаборЗаписей = РегистрыНакопления["Запасы"].СоздатьНаборЗаписей();
				
				Для Каждого ЗначениеОтбора Из Источник.Отбор Цикл
					
					Если ЗначениеОтбора.Использование = Ложь Тогда
						Продолжить;
					КонецЕсли;
					
					СтрокаОтбора = СтарыйНаборЗаписей.Отбор.Найти(ЗначениеОтбора.Имя);
					СтрокаОтбора.Значение = ЗначениеОтбора.Значение;
					СтрокаОтбора.Использование = Истина;
					
				КонецЦикла;
				
				СтарыйНаборЗаписей.Прочитать();
				
				Для каждого ТекЗапись Из СтарыйНаборЗаписей Цикл
					
					Если Склады.Найти(ТекЗапись.СтруктурнаяЕдиница) <> Неопределено Тогда     
					
						УИДЗаписи = XMLСтрока(ТекЗапись.СтруктурнаяЕдиница) +"_"+ XMLСтрока(ТекЗапись.Номенклатура) +"_"+ XMLСтрока(ТекЗапись.Характеристика);   
						Если УжеДобавлены.Найти(УИДЗаписи) = Неопределено Тогда
							
							УжеДобавлены.Добавить(УИДЗаписи);	
						
							ДобавитьЗаписьВПакетДанныхДляРегистрации(ПакетДанных, НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, ТекЗапись.СтруктурнаяЕдиница
								, ТекЗапись.Номенклатура, ТекЗапись.Характеристика);
					
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			Для Каждого ТекЗапись Из Источник Цикл
				
				Если Склады.Найти(ТекЗапись.СтруктурнаяЕдиница) <> Неопределено Тогда   
					
					УИДЗаписи = XMLСтрока(ТекЗапись.СтруктурнаяЕдиница) +"_"+ XMLСтрока(ТекЗапись.Номенклатура) +"_"+ XMLСтрока(ТекЗапись.Характеристика);   
					Если УжеДобавлены.Найти(УИДЗаписи) = Неопределено  Тогда
							
						УжеДобавлены.Добавить(УИДЗаписи);	
					
						ДобавитьЗаписьВПакетДанныхДляРегистрации(ПакетДанных, НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, ТекЗапись.СтруктурнаяЕдиница
							, ТекЗапись.Номенклатура, ТекЗапись.Характеристика);
						
					КонецЕсли;
					
				КонецЕсли;
					
			КонецЦикла;    
			
			ЗарегистрироватьПакетОбъектов(ПакетДанных);
			

		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИнформацияОНастройке Из МассивНастроекОВыгружаемыхДанных Цикл
		Б24_СУ_ОбщегоНазначенияВызовСервера.ВыгрузкаВРеальномВремени(ИнформацияОНастройке);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ПакетДанныхДляРегистрацииИзменений()
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ПакетДанных = Новый ТаблицаЗначений;
	ПакетДанных.Колонки.Добавить("НастройкаПодключения", Новый ОписаниеТипов("СправочникСсылка.Б24_К_НастройкиПодключения"));
	ПакетДанных.Колонки.Добавить("ТипОбъекта");
	ПакетДанных.Колонки.Добавить("Ключ");
	ПакетДанных.Колонки.Добавить("Объект");	
	Если ТипКонфигурации = "БП" Тогда
		ПакетДанных.Колонки.Добавить("ПодчиненныйОбъект");					
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		ПакетДанных.Колонки.Добавить("ПодчиненныйОбъект", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		ПакетДанных.Колонки.Добавить("ПодчиненныйОбъект", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КонецЕсли;

	Возврат ПакетДанных;
	
КонецФункции

Процедура ДобавитьЗаписьВПакетДанныхДляРегистрации(ПакетДанных, НастройкаПодключения, ТипОбъекта, Ключ, Объект, ПодчиненныйОбъект = Неопределено)
	
	НоваяСтрока = ПакетДанных.Добавить();
	НоваяСтрока.НастройкаПодключения 	= НастройкаПодключения;
	НоваяСтрока.Ключ 					= Ключ;
	НоваяСтрока.Объект 					= Объект;
	НоваяСтрока.ПодчиненныйОбъект 		= ПодчиненныйОбъект;
	НоваяСтрока.ТипОбъекта 				= ТипОбъекта;

КонецПроцедуры

Процедура ЗарегистрироватьПакетОбъектов(ПакетДанных)
	
	Для каждого ТекСтрока Из ПакетДанных Цикл
		
		РегистрыСведений.Б24_СУ_ТаблицаИзменений.ДобавитьОбъектВТаблицуИзменений(ТекСтрока.НастройкаПодключения, ТекСтрока.ТипОбъекта, ТекСтрока.Ключ 
			, ТекСтрока.Объект, ТекСтрока.ПодчиненныйОбъект);	
	
	КонецЦикла;
	
КонецПроцедуры  

Процедура ДобавитьЗаписьПроводкиВПакетДанныхДляРегистрации(ИнформацияОНастройке, ПакетДанных, ТипыДанныхДляОбменаСПорталом, УжеДобавлены, ТекЗапись)

	НастройкаПодключения 	= ИнформацияОНастройке.НастройкаПодключения;
	Склады 					= ИнформацияОНастройке.Склады;
  	СчетаОстатков 			= ИнформацияОНастройке.СчетаОстатков;
	
	Если (ЗначениеЗаполнено(ТекЗапись.СубконтоДт.Склады) И Склады.Найти(ТекЗапись.СубконтоДт.Склады) <> Неопределено) 
		ИЛИ (ЗначениеЗаполнено(ТекЗапись.СубконтоКт.Склады) И Склады.Найти(ТекЗапись.СубконтоКт.Склады) <> Неопределено) Тогда
		
		Товар = Неопределено;
		Если ЗначениеЗаполнено(ТекЗапись.СчетДТ) И СчетаОстатков.Найти(ТекЗапись.СчетДТ) <> Неопределено  Тогда 
			Товар = ТекЗапись.СубконтоДт.Номенклатура;
		ИначеЕсли ЗначениеЗаполнено(ТекЗапись.СчетКт) И СчетаОстатков.Найти(ТекЗапись.СчетКт) <> Неопределено  Тогда
			Товар = ТекЗапись.СубконтоКт.Номенклатура;
		КонецЕсли;	
		
		СкладДт = Неопределено;      
		Если ЗначениеЗаполнено(ТекЗапись.СубконтоДт.Склады) Тогда СкладДт = ТекЗапись.СубконтоДт.Склады КонецЕсли;  
		
		СкладКт = Неопределено;
		Если ЗначениеЗаполнено(ТекЗапись.СубконтоКт.Склады) Тогда СкладКт = ТекЗапись.СубконтоКт.Склады КонецЕсли;  
		
		Если ЗначениеЗаполнено(Товар) И (ЗначениеЗаполнено(СкладДт) ИЛИ ЗначениеЗаполнено(СкладКт)) Тогда
			
			УИДЗаписи = XMLСтрока(Товар);   
			Если УжеДобавлены.Найти(УИДЗаписи) = Неопределено Тогда
				
				УжеДобавлены.Добавить(УИДЗаписи);	
				
				Если ЗначениеЗаполнено(СкладДт) Тогда 
					ДобавитьЗаписьВПакетДанныхДляРегистрации(ПакетДанных, НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, СкладДт, Товар);    
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СкладКт) Тогда 
					ДобавитьЗаписьВПакетДанныхДляРегистрации(ПакетДанных, НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, СкладКт, Товар);    
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

