
#Область ПубликацияПоста

Функция ОпубликоватьТабличныйДокументВБ24НаСервере(ПередаваемыеПараметры) Экспорт
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(ПередаваемыеПараметры.НастройкаПодключения, Истина);  
	
	Если СтруктураНастроек = Неопределено Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Не удалось подключиться к Битрикс24");
		
		РезультатОтправки = Новый Структура;	
		РезультатОтправки.Вставить("УспешнаяВыгрузка", Ложь);
		
		Возврат РезультатОтправки;
		
	КонецЕсли;
	
	СтруктураНастроек.Логирование.Измерение2 = "Отправка " + ?(ПередаваемыеПараметры.ТипОбъекта = "Документ", "печатной формы", "отчета");
	
	РезультатОтправки = ВыполнитьПубликованияДанныхВБ24(СтруктураНастроек, ПередаваемыеПараметры);
	
	Возврат РезультатОтправки;
	
КонецФункции

Функция ВыполнитьПубликованияДанныхВБ24(СтруктураНастроек, ПередаваемыеПараметры, НастройкаРегулярнойВыгрузки = Неопределено)
	
	Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Начало публикации данных");
	
	РезультатОтправки = Новый Структура;	
	РезультатОтправки.Вставить("УспешнаяВыгрузка", Ложь);
	РезультатОтправки.Вставить("СсылкаНаОбъект","");
	
	лПараметрЗаголовка          = "";
	лПараметрЗаголовка 			= "&POST_TITLE=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПередаваемыеПараметры.НаименованиеОбъекта);
	лПараметрСообщения			= "&POST_MESSAGE=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПередаваемыеПараметры.ТекстСообщения);	
		
	лПараметрГрупп 				= ПолучатьПараметрПользователейИГруппВидимости(ПередаваемыеПараметры.МассивГрупп, ПередаваемыеПараметры.МассивПользователей, ПередаваемыеПараметры.МассивОтделов);
	
	ИдПользователя = ПолучитьИдПользователя(СтруктураНастроек.Портал, НастройкаРегулярнойВыгрузки);
	
	Если ИдПользователя <> "-1" Тогда
		лПараметрОтправитель = "&USER_ID=" + ИдПользователя;	
	Иначе
		лПараметрОтправитель = "";
	КонецЕсли;	
		
	ТелоHTTPЗапроса = лПараметрЗаголовка + лПараметрСообщения + лПараметрОтправитель + лПараметрГрупп;
	
	УспешноСформировано = Истина;
	НужноВыгружать 		= Ложь;
	
	Если НастройкаРегулярнойВыгрузки = Неопределено Тогда
		ОтчетСохраненИДобавлен = СохранениеОтчетаИДобавлениеОбъектаВТело(СтруктураНастроек, ТелоHTTPЗапроса, ПередаваемыеПараметры, 1); 
	Иначе
		
		тзнНастроекВыгрузки = НастройкаРегулярнойВыгрузки.СохраненныеНастройки.Получить();
		
		НомерОтчета 		= 0;
		
		Для каждого ТекСтрока Из тзнНастроекВыгрузки Цикл
			
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Выгрузка отчета: " + ТекСтрока.Отчет);
			НомерОтчета = НомерОтчета + 1;
			
			ТабличныйДокумент 							= СформироватьТабличныйДокумент(ТекСтрока.Отчет, ТекСтрока.НастройкиОтчета);
			ПередаваемыеПараметры.ТабличныйДокумент 	= ТабличныйДокумент;
			ПередаваемыеПараметры.НаименованиеОбъекта	= ТекСтрока.Отчет;
			
			РезультатФормированияОтчета = СохранениеОтчетаИДобавлениеОбъектаВТело(СтруктураНастроек, ТелоHTTPЗапроса, ПередаваемыеПараметры, НомерОтчета);
			
			Если НЕ РезультатФормированияОтчета Тогда
				УспешноСформировано = Ложь;
			Иначе
				НужноВыгружать = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если (НастройкаРегулярнойВыгрузки = Неопределено И ОтчетСохраненИДобавлен)
		ИЛИ (УспешноСформировано И НужноВыгружать И ТелоHTTPЗапроса <> (лПараметрЗаголовка + лПараметрСообщения + лПараметрОтправитель + лПараметрГрупп)) Тогда
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/log.blogpost.add", ТелоHTTPЗапроса); 
		
		Если СтруктураОтвета <> Неопределено Тогда
		
			Если СтруктураОтвета.Получить("result") <> Неопределено Тогда

				ИдПоста = СокрЛП(Формат(СтруктураОтвета.Получить("result"), "ЧГ=0"));
				
				РезультатОтправки.УспешнаяВыгрузка = Истина;
				РезультатОтправки.СсылкаНаОбъект = ПолучитьСсылкуПостаИзТекста(СтруктураНастроек, ИдПоста);
				
				НовЗапись = РегистрыСведений.Б24_КЭ_ОтправленныеПубликацииВБ24.СоздатьМенеджерЗаписи();
				НовЗапись.Период 					= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
				НовЗапись.Портал 					= СтруктураНастроек.Портал;
				НовЗапись.Пользователь 				= ПараметрыСеанса.ТекущийПользователь;
				НовЗапись.НаименованиеОбъекта 		= ПередаваемыеПараметры.НаименованиеОбъекта;
				НовЗапись.Тип 						= ПередаваемыеПараметры.ТипОбъекта;
				НовЗапись.РегулярнаяПубликация 		= НастройкаРегулярнойВыгрузки;
				НовЗапись.ИдентификаторПубликации 	= ИдПоста;
				НовЗапись.Записать(Истина);
				
				Если НЕ НастройкаРегулярнойВыгрузки = Неопределено Тогда
					НовЗапись = РегистрыСведений.Б24_КЭ_ДатыРегулярныхПубликаций.СоздатьМенеджерЗаписи();
					НовЗапись.Период 				= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
					НовЗапись.ДатаПоследнегоОбмена 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
					НовЗапись.РегулярнаяПубликация 	= НастройкаРегулярнойВыгрузки;
					НовЗапись.Записать(Истина);
				КонецЕсли;
				
				Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Данные опубликованы");

			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатОтправки;
	
КонецФункции

Функция ПолучатьПараметрПользователейИГруппВидимости(МассивГрупп, МассивПользователей, МассивОтделов)
	
	лПараметрГруппВидимости = "";
	
	Для каждого ТекЗначение Из МассивГрупп Цикл
		лПараметрГруппВидимости = лПараметрГруппВидимости + "&SPERM[SG][]=SG" + ТекЗначение; 
	КонецЦикла;
	
	Для каждого ТекЗначение Из МассивПользователей Цикл
		лПараметрГруппВидимости = лПараметрГруппВидимости + "&SPERM[U][]=U" + ?(ТекЗначение = "Все пользователи", "A", ТекЗначение); 
	КонецЦикла;
	
	Для каждого ТекЗначение Из МассивОтделов Цикл
		лПараметрГруппВидимости = лПараметрГруппВидимости + "&SPERM[DR][]=DR" + ТекЗначение; 
	КонецЦикла;
	
	Возврат лПараметрГруппВидимости; 
	
КонецФункции

Функция СохранениеОтчетаИДобавлениеОбъектаВТело(СтруктураНастроек, ТелоHTTPЗапроса, ПередаваемыеПараметры, Итератор)
	
	НаименованиеОбъекта = ПередаваемыеПараметры.НаименованиеОбъекта;
	ТабличныйДокумент	= ПередаваемыеПараметры.ТабличныйДокумент;
	
	Попытка
		лРасширение 		= ТипФайлаТабличногоДокумента.PDF;
		ИмяВременногоФайла 	= ПолучитьИмяВременногоФайла(".pdf");
		
		ТабличныйДокумент.Записать(ИмяВременногоФайла, лРасширение);
	Исключение
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось сохранить объект: " + НаименованиеОбъекта);
		Возврат Ложь;	
	КонецПопытки;
	
	ДвоичноеСодержимоеОтчета = Base64Строка(Новый ДвоичныеДанные(ИмяВременногоФайла));
	
	лПараметрНазванияКартинки	= "&FILES[" + Формат(Итератор,"ЧГ=0") + "][0]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(НаименованиеОбъекта + " " +ФормаТ(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса(), "ДФ=dd.MM.yyyy") + ".pdf");	
	лПараметрКартинка			= "&FILES[" + Формат(Итератор,"ЧГ=0") + "][1]=" 	+ Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ДвоичноеСодержимоеОтчета);	
	
	ТелоHTTPЗапроса = ТелоHTTPЗапроса + лПараметрНазванияКартинки + лПараметрКартинка;
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
	КонецПопытки;
	
	Возврат Истина;
	        
КонецФункции

Функция ПолучитьСсылкуПостаИзТекста(СтруктураНастроек, ИдПоста)
	
	АдресСайта = ?(СтруктураНастроек.НастройкиПодключения.ЗащищенноеСоединение, "https://", "http://") + СтруктураНастроек.НастройкиПодключения.Сервер;
	
 	ИдПользователя = ПолучитьИдПользователя(СтруктураНастроек.Портал);
	
	Если ИдПользователя <> "-1" Тогда

		АдресПоста = АдресСайта + "/company/personal/user/" + ИдПользователя + "/blog/" + ИдПоста + "/";
		
	Иначе
		
		АдресПоста = АдресСайта;
		
	КонецЕсли;
	
	Возврат АдресПоста;  
	
КонецФункции

Функция ПолучитьИдПользователя(Портал, НастройкаРегулярнойВыгрузки = Неопределено)
	
	ИдПользователя = "-1";
	               
	Если НастройкаРегулярнойВыгрузки = Неопределено Тогда
		ТекущийПользователь = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьТекущегоПользователя();
	Иначе
		ТекущийПользователь = НастройкаРегулярнойВыгрузки.Пользователь; 	
	КонецЕсли;
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УНФ" Тогда
		ИмяСправочника = "Сотрудники";
	Иначе
		ИмяСправочника = "Пользователи";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь1С"	, ТекущийПользователь.Наименование);
	Запрос.УстановитьПараметр("Портал"			, Портал);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ПользователиБитрикс24.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.Б24_К_ПользователиБитрикс24 КАК Б24_К_ПользователиБитрикс24
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник." + ИмяСправочника + " КАК Сотрудники
	|		ПО Б24_К_ПользователиБитрикс24.Пользователь1С = Сотрудники.Ссылка
	|ГДЕ
	|	Сотрудники.Наименование ПОДОБНО &Пользователь1С
	|	И Б24_К_ПользователиБитрикс24.Портал = &Портал";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		ИдПользователя = ВыполненныйЗапрос.Выгрузить()[0].Идентификатор;		
	КонецЕсли;
	
	Возврат ИдПользователя;
	
КонецФункции

#КонецОбласти


#Область ОбсуждениеПоста

Функция ПолучитьСсылкуНаПоследнийПост(НастройкаПодключения, НаименованиеОбъекта) Экспорт
	
    АдресПортала = "https://" + НастройкаПодключения.Портал;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал", НастройкаПодключения.Портал);
	Запрос.УстановитьПараметр("НаименованиеОбъекта", НаименованиеОбъекта);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Б24_КЭ_ОтправленныеПубликацииВБ24СрезПоследних.ИдентификаторПубликации КАК ИдентификаторПубликации
	               |ИЗ
	               |	РегистрСведений.Б24_КЭ_ОтправленныеПубликацииВБ24.СрезПоследних(
	               |			,
	               |			Портал = &Портал
	               |				И НаименованиеОбъекта = &НаименованиеОбъекта) КАК Б24_КЭ_ОтправленныеПубликацииВБ24СрезПоследних";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
    	ИдПоста = ВыполненныйЗапрос.Выгрузить()[0].ИдентификаторПубликации;
	Иначе
		ИдПоста = "";
	КонецЕсли;
	
 	ИдПользователя = ПолучитьИдПользователя(НастройкаПодключения.Портал);
	
   Если ИдПользователя <> "-1" И ИдПоста <> "" Тогда
    	АдресПоста = АдресПортала + "/company/personal/user/" + ИдПользователя + "/blog/" + ИдПоста + "/";
    Иначе
    	АдресПоста = АдресПортала;
    КонецЕсли;
    
    Возврат АдресПоста;	
	
КонецФункции

Функция ПроверитьНаличиеПубликацийОтчета(НастройкаПодключения, НаименованиеОбъекта, РегулярнаяПубликация) Экспорт
	
УстановитьПривилегированныйРежим(Истина);  

	ДатаПубликации = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_КЭ_ОтправленныеПубликацииВБ24.Пользователь КАК Пользователь,
	|	Б24_КЭ_ОтправленныеПубликацииВБ24.НаименованиеОбъекта КАК НаименованиеОбъекта,
	|	Б24_КЭ_ОтправленныеПубликацииВБ24.ИдентификаторПубликации КАК ИдентификаторПубликации,
	|	Б24_КЭ_ОтправленныеПубликацииВБ24.Период КАК Период
	|ИЗ
	|	РегистрСведений.Б24_КЭ_ОтправленныеПубликацииВБ24.СрезПоследних(
	|			,
	|			Портал = &Портал
	|				И НаименованиеОбъекта = &НаименованиеОбъекта
	|				И РегулярнаяПубликация = &РегулярнаяПубликация
	|				И Тип = ""Отчет"") КАК Б24_КЭ_ОтправленныеПубликацииВБ24";
	
	Запрос.УстановитьПараметр("Портал"				, НастройкаПодключения.Портал);			   
	Запрос.УстановитьПараметр("РегулярнаяПубликация", РегулярнаяПубликация);			   
	Запрос.УстановитьПараметр("НаименованиеОбъекта"	, НаименованиеОбъекта);			   
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДатаПубликации = Выборка.Период;	
	КонецЦикла;
	
	
	Возврат ДатаПубликации;
	
КонецФункции

#КонецОбласти


#Область ПоРасписанию

Процедура ВыполнитьВыгрузкуОтчетовПоРасписанию() Экспорт
	
	Выборка = Справочники.Б24_КЭ_РегулярныеПубликацииОтчетовВБитрикс24.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.НеАктивно ИЛИ Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкиРегулярности = Выборка.СохраненныеНастройкиРегулярности.Получить();
		
		Если НастройкиРегулярности = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаПоследнегоОбмена = РегистрыСведений.Б24_КЭ_ДатыРегулярныхПубликаций.ПолучитьПоследнее(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса(), Новый Структура("РегулярнаяПубликация", Выборка.Ссылка)).ДатаПоследнегоОбмена;
			
		Если НЕ НужноВыгружать(НастройкиРегулярности, ДатаПоследнегоОбмена) Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкаПодключения = Выборка.НастройкаПодключения;
		
		Если НЕ Б24_К_СлужебныйВызовСервера.МодульЭкспортаПечатныхФормДоступен(НастройкаПодключения) Тогда
			Возврат;	
		КонецЕсли;
		
		СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
		
		Если СтруктураНастроек = Неопределено Тогда
			
			ОбщегоНазначения.СообщитьПользователю("Не удалось подключиться к Битрикс24");
			Возврат;
		КонецЕсли;
		
		СтруктураНастроек.Логирование.Измерение2 = "Отправка отчета по расписанию";
		
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Выгрузка отчетов настройки: " + Выборка.Наименование);
		
		мПользователи 	= Новый Массив;
		мГруппы 		= Новый Массив;
		мОтделы			= Новый Массив;
		
		Для Каждого ТекСтрока Из Выборка.ПользователиИГруппы Цикл
			
			Если ТекСтрока.Тип = "Группа" Тогда
				мГруппы.Добавить(ТекСтрока.Идентификатор);	
			ИначеЕсли ТекСтрока.Тип = "Отдел" Тогда
				мОтделы.Добавить(ТекСтрока.Идентификатор);	
			Иначе
				мПользователи.Добавить(ТекСтрока.Идентификатор);	
			КонецЕсли;
			
		КонецЦикла;
		
		ПередаваемыеПараметры = Новый Структура;
		ПередаваемыеПараметры.Вставить("НастройкаПодключения"	, НастройкаПодключения);
		ПередаваемыеПараметры.Вставить("ТекстСообщения"			, Выборка.ТекстСообщения);
		ПередаваемыеПараметры.Вставить("ТабличныйДокумент"		, "");
		ПередаваемыеПараметры.Вставить("НаименованиеОбъекта"	, Выборка.Наименование);
		ПередаваемыеПараметры.Вставить("ТипОбъекта"				, "Отчет");
		ПередаваемыеПараметры.Вставить("МассивПользователей"	, мПользователи);
		ПередаваемыеПараметры.Вставить("МассивГрупп"			, мГруппы);
		ПередаваемыеПараметры.Вставить("МассивОтделов"			, мОтделы);
	
		ВыполнитьПубликованияДанныхВБ24(СтруктураНастроек, ПередаваемыеПараметры, Выборка.Ссылка);

		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Завершение выгрузки отчетов настройки: " + Выборка.Наименование);

	КонецЦикла;
	
КонецПроцедуры

Функция НужноВыгружать(пВременаОтправки, пДатаПоследнейВыгрузки)
	
	Если пВременаОтправки.мВремяОтправки.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекДата = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса(); 
	ВремяВыгрузкиС = Час(ТекДата)*60*60 + Минута(ТекДата)*60 + Секунда(ТекДата);
	
	лТекущийДеньНедели = ДеньНедели(ТекДата);
	
	Если лТекущийДеньНедели = 1 Тогда
		ВыгружаетсяВЭтотДень = пВременаОтправки.Понедельник;
	ИначеЕсли лТекущийДеньНедели = 2 Тогда	
		ВыгружаетсяВЭтотДень = пВременаОтправки.Вторник;
	ИначеЕсли лТекущийДеньНедели = 3 Тогда	
		ВыгружаетсяВЭтотДень = пВременаОтправки.Среда;
	ИначеЕсли лТекущийДеньНедели = 4 Тогда	
		ВыгружаетсяВЭтотДень = пВременаОтправки.Четверг;
	ИначеЕсли лТекущийДеньНедели = 5 Тогда	
		ВыгружаетсяВЭтотДень = пВременаОтправки.Пятница;
	ИначеЕсли лТекущийДеньНедели = 6 Тогда	
		ВыгружаетсяВЭтотДень = пВременаОтправки.Суббота;
	ИначеЕсли лТекущийДеньНедели = 7 Тогда	
		ВыгружаетсяВЭтотДень = пВременаОтправки.Воскресенье;
	Иначе 
		ВыгружаетсяВЭтотДень = Ложь;
	КонецЕсли;
	
	НовыйДень = День(ТекДата) <> День(пДатаПоследнейВыгрузки); 
	
	Если ВыгружаетсяВЭтотДень Тогда
	
		ВремяПоследнейВыгрузкиЧ = ?(НовыйДень, 0, Час(пДатаПоследнейВыгрузки)*60*60 + Минута(пДатаПоследнейВыгрузки)*60 + Секунда(пДатаПоследнейВыгрузки));
		
		Для Каждого ТекВремя Из пВременаОтправки.мВремяОтправки Цикл
			
			ВремяВыгрузкиЧ = Час(ТекВремя)*60*60 + Минута(ТекВремя)*60 + Секунда(ТекВремя);
			
			Если ВремяПоследнейВыгрузкиЧ < ВремяВыгрузкиЧ И ВремяВыгрузкиЧ <= ВремяВыгрузкиС Тогда
				Возврат Истина;	
			КонецЕсли;
			
		КонецЦикла;
	
		Возврат Ложь;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ВыполнитьФормированиеОтчета(ТабличныйДок, НазваниеОтчета, НастройкаОтчета)
	
	Если НЕ ЗначениеЗаполнено(НазваниеОтчета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(НастройкаОтчета) = Тип("НастройкиКомпоновкиДанных") Тогда		
	
		НовыйОтчет = Отчеты[НазваниеОтчета].Создать();
		
		Если НастройкаОтчета <> Неопределено Тогда
			
			НовыйОтчет.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкаОтчета);	
			
			Для Каждого ТеПараметр Из НастройкаОтчета.ПараметрыДанных.Элементы Цикл
				
				Для Каждого ТеПараметр2 Из НовыйОтчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
					
					Если ТеПараметр.Параметр = ТеПараметр2.Параметр	Тогда
						
						ТеПараметр2.Значение = ТеПараметр.Значение;	
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
		НовыйОтчет.СкомпоноватьРезультат(ТабличныйДок);
	Иначе
		МодульБухгалтерскиеОтчеты = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("БухгалтерскиеОтчетыВызовСервера");
		Если МодульБухгалтерскиеОтчеты <> Неопределено Тогда
			Результат = МодульБухгалтерскиеОтчеты.ПодготовитьОтчет(НастройкаОтчета);
			ТабличныйДок = Результат.Результат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьТабличныйДокумент(НаименованиеОбъекта, НастройкиОбъекта)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.АвтоМасштаб				= Истина;
	ТабличныйДокумент.РазмерКолонтитулаСверху	= 0;
	ТабличныйДокумент.РазмерКолонтитулаСнизу	= 0;
	ТабличныйДокумент.ОриентацияСтраницы		= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати		= "ПАРАМЕТРЫ_ПЕЧАТИ_ВыгрузкаВЖЛ";
	
	ВыполнитьФормированиеОтчета(ТабличныйДокумент, НаименованиеОбъекта, НастройкиОбъекта);
	
	Возврат ТабличныйДокумент;
	        
КонецФункции

Процедура СохранитьРасписаниеВыгрузкиОтчетовПоРасписанию(ВключитьРегламентноеЗадание = Ложь) Экспорт
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаИспользуемыхРеглЗаданий 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();
	СтруктураРеглЗаданий 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеРеглЗадания();	
	
УстановитьПривилегированныйРежим(Истина); //Для возможности всем пользователям с правами устанавливать расписания	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИменаИспользуемыхРеглЗаданий.ВыгрузкаОтчетов);		
	Если ОбщегоНазначения.РазделениеВключено() Тогда		
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);			
	КонецЕсли;	
	
	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);	
	
	ПараметрыЗапуска = Новый Массив();
	ПараметрыЗапуска.Добавить(СтруктураРеглЗаданий.ВыгрузкаОтчетов);
	ПараметрыЗапуска.Добавить(Неопределено);
	
	РасписаниеРегламентногоЗаданияВыгрузкиОтчетов = Новый РасписаниеРегламентногоЗадания;
	РасписаниеРегламентногоЗаданияВыгрузкиОтчетов.ПериодПовтораДней = 1;
	РасписаниеРегламентногоЗаданияВыгрузкиОтчетов.ПериодНедель = 1;
	РасписаниеРегламентногоЗаданияВыгрузкиОтчетов.ПериодПовтораВТечениеДня = 60*15;
	//РасписаниеРегламентногоЗаданияУдаленияЛога.ПериодПовтораВТечениеДня = 60;
	
	мДниРасписания = Новый Массив;
	мДниРасписания.Добавить(1);
	мДниРасписания.Добавить(2);
	мДниРасписания.Добавить(3);
	мДниРасписания.Добавить(4);
	мДниРасписания.Добавить(5);
	мДниРасписания.Добавить(6);
	мДниРасписания.Добавить(7);
	
	РасписаниеРегламентногоЗаданияВыгрузкиОтчетов.ДниНедели = мДниРасписания;
	
	Если НайденныеРеглЗадания.Количество() = 0 Тогда	
		
		Если ВключитьРегламентноеЗадание Тогда			
			
			ПараметрыЗадания = Новый Структура();
			ПараметрыЗадания.Вставить("Метаданные"					, Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
			ПараметрыЗадания.Вставить("Наименование"				, ИменаИспользуемыхРеглЗаданий.ВыгрузкаОтчетов);
			ПараметрыЗадания.Вставить("Ключ"						, ИменаИспользуемыхРеглЗаданий.ВыгрузкаОтчетов);
			ПараметрыЗадания.Вставить("Использование"				, Истина);
			ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение"		, Ложь);
			ПараметрыЗадания.Вставить("Параметры"					, ПараметрыЗапуска);
			ПараметрыЗадания.Вставить("Расписание"					, РасписаниеРегламентногоЗаданияВыгрузкиОтчетов);		
			ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
			ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);
			
			РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);	
		
		КонецЕсли;
		
	Иначе
	
		ПараметрыИзмененияЗадания = Новый Структура();
		ПараметрыИзмененияЗадания.Вставить("Использование"	, Истина);
		ПараметрыИзмененияЗадания.Вставить("Параметры"		, ПараметрыЗапуска);
		ПараметрыИзмененияЗадания.Вставить("Расписание"		, РасписаниеРегламентногоЗаданияВыгрузкиОтчетов);
		ПараметрыИзмененияЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
		ПараметрыИзмененияЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);		
		
		Если ВключитьРегламентноеЗадание Тогда
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
		Иначе
			ПараметрыИзмененияЗадания.Использование = Ложь;
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
		КонецЕсли;
		
	КонецЕсли;
УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

  
