Функция СнимокОкнаДоступен() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиТекущегоПользователя = ОбработкаОшибок.ПолучитьНастройкиПользователя();
	ОбщиеНастройки = ОбработкаОшибок.ПолучитьОбщиеНастройки();
	
	Возврат (НастройкиТекущегоПользователя.ВключатьСнимокОконВОтчетНаКлиенте = РежимОтправкиИнформацииОбОшибке.Отправлять 
		И ОбщиеНастройки.ВключатьСнимокОконВОтчетНаКлиенте = РежимОтправкиИнформацииОбОшибке.Отправлять); 
	
КонецФункции

Процедура ВключитьВозможностьДелатьСнимкиЭкрана() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НастройкиОбщие = ОбработкаОшибок.ПолучитьОбщиеНастройки();
	НастройкиОбщие.ВключатьСнимокОконВОтчетНаКлиенте = РежимОтправкиИнформацииОбОшибке.Отправлять;
	ОбработкаОшибок.УстановитьОбщиеНастройки(НастройкиОбщие);
	
	НастройкиПользователя = ОбработкаОшибок.ПолучитьНастройкиПользователя();
	НастройкиПользователя.ВключатьСнимокОконВОтчетНаКлиенте = РежимОтправкиИнформацииОбОшибке.Отправлять;
	ОбработкаОшибок.УстановитьНастройкиПользователя(НастройкиПользователя);
	
КонецПроцедуры


Процедура ДобавитьИнформациюУчастниковЧата(Портал, ИдентификаторЧата, НаименованиеЧата, Адресанты, НаименованиеОбъекта) Экспорт
	
	ТекущаяДатаСеанса = ТекущаяДатаСеанса();

	Для каждого ТекЭлемент Из Адресанты Цикл	
		
		НоваяЗапись = РегистрыСведений.Б24_КЭ_ИсторияЧатов.СоздатьМенеджерЗаписи();
		
		НоваяЗапись.ДатаСоздания 			= ТекущаяДатаСеанса;
		НоваяЗапись.Портал					= Портал;	
		НоваяЗапись.ИдентификаторЧата		= ИдентификаторЧата;	 
		НоваяЗапись.НаименованиеЧата		= НаименованиеЧата;	 
		НоваяЗапись.ИдентификаторСотрудника	= ТекЭлемент.Идентификатор;	 
		НоваяЗапись.НаименованиеСотрудника	= ТекЭлемент.Наименование;	 
		НоваяЗапись.НаименованиеОбъекта		= НаименованиеОбъекта;	 
	
		НоваяЗапись.Записать();
		
	КонецЦикла;
	  
КонецПроцедуры

Функция СписокЧатов(Портал) Экспорт
	
	Результат = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("ДатаСоздания", ТекущаяДатаСеанса()-60*60*24*7);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Б24_КЭ_ИсторияЧатов.ИдентификаторЧата КАК ИдентификаторЧата,
	|	Б24_КЭ_ИсторияЧатов.НаименованиеЧата КАК НаименованиеЧата
	|ИЗ
	|	РегистрСведений.Б24_КЭ_ИсторияЧатов КАК Б24_КЭ_ИсторияЧатов
	|ГДЕ
	|	Б24_КЭ_ИсторияЧатов.Портал = &Портал
	|	И Б24_КЭ_ИсторияЧатов.ДатаСоздания > &ДатаСоздания";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	Если ВыполненныйЗапрос.Пустой() Тогда
		Возврат Результат; 
	КонецЕсли;

	Выборка = ВыполненныйЗапрос.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.ИдентификаторЧата ,Выборка.НаименованиеЧата);	
	КонецЦикла;
	
	Возврат Результат;    
	
КонецФункции

Функция СотрудникиДляНовогоЧата(Портал, НаименованиеОбъекта) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.УстановитьПараметр("НаименованиеОбъекта", НаименованиеОбъекта);
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(Б24_КЭ_ИсторияЧатов.ДатаСоздания) КАК ДатаСоздания,
	|	Б24_КЭ_ИсторияЧатов.Портал КАК Портал,
	|	Б24_КЭ_ИсторияЧатов.НаименованиеОбъекта КАК НаименованиеОбъекта
	|ПОМЕСТИТЬ ВТ_СрезДанных
	|ИЗ
	|	РегистрСведений.Б24_КЭ_ИсторияЧатов КАК Б24_КЭ_ИсторияЧатов
	|ГДЕ
	|	Б24_КЭ_ИсторияЧатов.Портал = &Портал
	|	И Б24_КЭ_ИсторияЧатов.НаименованиеОбъекта = &НаименованиеОбъекта
	|
	|СГРУППИРОВАТЬ ПО
	|	Б24_КЭ_ИсторияЧатов.Портал,
	|	Б24_КЭ_ИсторияЧатов.НаименованиеОбъекта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_КЭ_ИсторияЧатов.ИдентификаторСотрудника КАК Идентификатор,
	|	Б24_КЭ_ИсторияЧатов.НаименованиеСотрудника КАК Наименование
	|ИЗ
	|	ВТ_СрезДанных КАК ВТ_СрезДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Б24_КЭ_ИсторияЧатов КАК Б24_КЭ_ИсторияЧатов
	|		ПО (Б24_КЭ_ИсторияЧатов.ДатаСоздания = ВТ_СрезДанных.ДатаСоздания)
	|			И (Б24_КЭ_ИсторияЧатов.Портал = ВТ_СрезДанных.Портал)
	|			И (Б24_КЭ_ИсторияЧатов.НаименованиеОбъекта = ВТ_СрезДанных.НаименованиеОбъекта)";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	Если ВыполненныйЗапрос.Пустой() Тогда
		Возврат Результат; 
	КонецЕсли;

	Выборка = ВыполненныйЗапрос.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Идентификатор, Наименование", Выборка.Идентификатор ,Выборка.Наименование));	
	КонецЦикла;
	
	Возврат Результат; 
	
КонецФункции

Функция Base64АватаркиЧата() Экспорт

	Возврат Base64Строка(БиблиотекаКартинок.Б24_К_ИконкаПоиска.ПолучитьДвоичныеДанные());

КонецФункции

