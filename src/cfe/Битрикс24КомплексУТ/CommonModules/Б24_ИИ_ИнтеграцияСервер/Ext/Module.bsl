#Область ЛогированиеVibeCode

// Пишет в лог ИИ одну запись модуля VibeCode.
//   Режим - "PUSH" (long-poll задание) или "HTTP" (вызов HTTP-сервиса порталом);
//   Вид   - "Запрос", "Ответ" или "Ошибка";
//   Метод - ярлык операции (getData, listTools, listUsers, ping, result, settings).
// Операция собирается как "<Режим>-<Вид>: <Метод>": это измерение регистра
// длиной 50 символов, поэтому строка при необходимости усекается.
Процедура ЗаписатьВЛогVibeCode(Режим, Вид, Метод, Текст) Экспорт

	Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ(
		Лев(Режим + "-" + Вид + ": " + Метод, 50), Текст);

КонецПроцедуры

#КонецОбласти


#Область КонстантыИНастройки

Функция МаксимумСтрок() Экспорт
	Возврат 10000;
КонецФункции

Функция МаксимумБайтEnvelope() Экспорт
	Возврат 4194304; // 4 MiB
КонецФункции

Функция ФорматВерсия() Экспорт
	Возврат "1";
КонецФункции

Функция КлючХранилищаТокена() Экспорт
	Возврат "ТокенПодключенияVibeCode";
КонецФункции

Функция КлючХранилищаПодключения() Экспорт
	Возврат "ПодключениеVibeCode";
КонецФункции

// Возвращает активную (не удалённую, использующуюся) настройку VibeCode.
Функция ПолучитьАктивнуюНастройкуVibeCode() Экспорт

	Выборка = Справочники.Б24_ИИ_НастройкиVibeCode.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Использование И НЕ Выборка.ПометкаУдаления Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Режим работы модуля по настройке: pushpull (по умолчанию) или http.
Функция РежимРаботы(Настройка) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат "pushpull";
	КонецЕсли;

	Режим = СокрЛП(Настройка.Режим);
	Если НЕ ПустаяСтрока(Режим) Тогда
		Возврат НРег(Режим);
	КонецЕсли;

	Возврат "pushpull";

КонецФункции

// Текущий статус настройки подключения. Никогда не возвращает пустую строку:
// если настройки нет или статус ещё не присвоен (до первого connect), выдаёт
// значение по умолчанию "OFFLINE".
Функция ПолучитьСтатусНастройки(Настройка) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат "OFFLINE";
	КонецЕсли;

	Статус = СокрЛП(Настройка.Статус);
	Если ПустаяСтрока(Статус) Тогда
		Возврат "OFFLINE";
	КонецЕсли;

	Возврат Статус;

КонецФункции

// Полный адрес Integration REST (часть строки кабинета до "#").
Функция БазовыйURLИнтеграции(Настройка) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// Приоритет - адрес окружения, сохранённый при connect (среда токена), чтобы
	// запросы /settings не уходили на другое окружение, чем подключение.
	Попытка
		Хранимое = ПрочитатьХранимоеПодключение(Настройка);
		СохраненныйАдрес = СокрЛП(Строка(ЗначениеНастройки(Хранимое, "Адрес")));
		Если НЕ ПустаяСтрока(СохраненныйАдрес) Тогда
			Возврат СохраненныйАдрес;
		КонецЕсли;
	Исключение
		// Падаем на адрес по умолчанию.
	КонецПопытки;

	// Поле «Адрес интеграции» из формы настроек убрано. Адрес берётся из строки
	// подключения (сохраняется при connect в безопасном хранилище) либо из
	// константы ниже, чтобы не требовалось вводить его вручную.
	Возврат АдресИнтеграцииПоУмолчанию();

КонецФункции

// Адрес интеграции VibeCode по умолчанию (бэкенд onec-module). Используется,
// когда адрес ещё не был сохранён при подключении из строки кабинета.
Функция АдресИнтеграцииПоУмолчанию() Экспорт

	Возврат "https://vibecode.bitrix24.tech/api/onec-module/v1";

КонецФункции

// Извлекает Integration REST base URL и секрет из строки кабинета вида
// https://<host>/api/onec-module/v1#<секрет>. Секрет - выданный ключ модуля
// "vibe_onec_..." / "vibe_api_onec_..." (контракт «один ключ»); служит Bearer-токеном
// при POST /connect и последующих запросах.
// Возвращает структуру {Успех, Адрес, Ключ, ЭтоПарныйКлюч} или Неопределено.
Функция РазобратьКлючПодключения(Знач СтрокаКлюча) Экспорт

	СтрокаКлюча = СокрЛП(СтрокаКлюча);
	Если ПустаяСтрока(СтрокаКлюча) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Успех, Адрес, Ключ, ЭтоПарныйКлюч", Ложь, "", "", Ложь);

	ПозицияРешетки = СтрНайти(СтрокаКлюча, "#");
	Если ПозицияРешетки = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Адрес = Лев(СтрокаКлюча, ПозицияРешетки - 1);
	Ключ = Прав(СтрокаКлюча, СтрДлина(СтрокаКлюча) - ПозицияРешетки);
	НРегКлюч = НРег(Ключ);

	// Принимаем любой секрет с префиксом "vibe_": и парный ключ, и готовый токен.
	АдресКорректен = НЕ ПустаяСтрока(Адрес) И Лев(НРег(Адрес), 8) = "https://";
	ТокенКорректен = НЕ ПустаяСтрока(Ключ)
		И (Лев(НРегКлюч, 10) = "vibe_onec_" ИЛИ Лев(НРегКлюч, 9) = "vibe_api_");
	Если АдресКорректен И ТокенКорректен Тогда
		Результат.Успех = Истина;
		Результат.Адрес = Адрес;
		Результат.Ключ = Ключ;
		Результат.ЭтоПарныйКлюч = (Лев(НРегКлюч, 16) = "vibe_onec_pair_");
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти


#Область ЗаданиеVibeCode

Функция ИмяФоновогоЗадания() Экспорт
	Возврат "Битрикс24 Push n Pull VibeCode";
КонецФункции

// Имя дополнительной обработки-расписания задания. Обработка подключается в
// справочнике «Дополнительные отчёты и обработки» БСП (имя задания,
// команда «Запуск по регламентному заданию», расписание настраивается в БСП).
// При срабатывании БСП вызывает ВыполнитьОбработкуПоРегламентномуЗаданию,
// которую перехватывает общий модуль ДополнительныеОтчетыИОбработки и запускает
// задание через ПроверитьИЗапуститьЗадание.
Функция ИмяЗадания() Экспорт
	Возврат "Битрикс24 Push n Pull VibeCode";
КонецФункции

// Отвязывает настройку от портала: снимает конфигурацию модуля (DELETE /settings),
// стирает токен и подключение, останавливает расписание задания.
// Вызывается при пометке элемента справочника настроек на удаление.
// Возвращает структуру (Успех, Сообщение).
Функция ОтвязатьОтПортала(Настройка) Экспорт

	Результат = Новый Структура("Успех, Сообщение", Истина, "");

	Готовность = ПроверитьГотовностьКЗапросамКонфигурации(Настройка);
	Если Готовность.Успех Тогда
		Попытка
			РезультатУдаления = УдалитьКонфигурациюМодуля(Настройка);
			Если РезультатУдаления <> Неопределено И НЕ РезультатУдаления.Успех Тогда
				Результат.Успех = Ложь;
				Результат.Сообщение = ?(ПустаяСтрока(РезультатУдаления.Сообщение),
					РезультатУдаления.КодОшибки, РезультатУдаления.Сообщение);
			КонецЕсли;
		Исключение
			Результат.Успех = Ложь;
			Результат.Сообщение = ОписаниеОшибки();
		КонецПопытки;
	Иначе
		// Подключения нет - снимать на портале нечего.
		Результат.Сообщение = Готовность.Сообщение;
	КонецЕсли;

	// Локально отвязываем в любом случае: токен, подключение, расписание задания.
	УдалитьПодключение(Настройка, "DISCONNECTED");

	// Отвязка - редкое событие, поэтому пишем результат в лог ИИ одной записью.
	Если Результат.Успех Тогда
		ЗаписатьВЛогVibeCode("HTTP", "Отвязка", "settings",
			"Настройка " + Строка(Настройка) + " отвязана от портала");
	Иначе
		ЗаписатьВЛогVibeCode("HTTP", "Ошибка", "settings",
			"Отвязка " + Строка(Настройка) + ": " + Результат.Сообщение);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Признак того, что объект уже был помечен на удаление до текущей записи.
// Нужна обработчику пометки: отвязка от портала выполняется только при
// переходе в помеченное состояние, а не при каждом пересохранении.
Функция ПометкаУдаленияБылаРанее(Ссылка) Экспорт

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ПометкаУдаления");

КонецФункции

// Создаёт/включает/удаляет регламентное задание задания. Всё в коде: задание
// создаётся программно по метаданным БСП-задания ЗапускДополнительныхОбработок
// с параметром = имя задания (аналогично МониторингРТ/Синхронизация). При
// выполнении БСП вызывает ВыполнитьОбработкуПоРегламентномуЗаданию с этим именем,
// его перехватывает общий модуль ДополнительныеОтчетыИОбработки и запускает
// задание через ПроверитьИЗапуститьЗадание.
Процедура ДобавитьУдалитьРасписаниеЗадания(УдалитьЗадание = Ложь) Экспорт

	// Файловая база больше не запрет: задание нужен и в тестовых файловых ИБ
	// (регламентное задание выполняется, пока запущен сеанс).
	Настройка = ПолучитьАктивнуюНастройкуVibeCode();
	ЕстьАктивнаяНастройка = НЕ Настройка = Неопределено
		И РежимРаботы(Настройка) = "pushpull";

	УстановитьПривилегированныйРежим(Истина);

	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИмяЗадания());
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);
	КонецЕсли;

	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);

	Если НЕ УдалитьЗадание И ЕстьАктивнаяНастройка
		И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда

		Если НайденныеРеглЗадания.Количество() = 0 Тогда

			ПараметрыЗапуска = Новый Массив();
			ПараметрыЗапуска.Добавить(ИмяЗадания());
			ПараметрыЗапуска.Добавить(Неопределено);

			ПараметрыЗадания = Новый Структура();
			ПараметрыЗадания.Вставить("Метаданные", Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
			ПараметрыЗадания.Вставить("Наименование", ИмяЗадания());
			ПараметрыЗадания.Вставить("Ключ", ИмяЗадания());
			ПараметрыЗадания.Вставить("Использование", Истина);
			ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение", Ложь);
			ПараметрыЗадания.Вставить("Параметры", ПараметрыЗапуска);
			ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении", 0);
			ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении", 0);

			Расписание = Новый РасписаниеРегламентногоЗадания;
			Расписание.ПериодПовтораВТечениеДня = 60;
			Расписание.ПериодПовтораДней = 1;
			ПараметрыЗадания.Вставить("Расписание", Расписание);

			РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);

		Иначе

			ПараметрыИзмененияЗадания = Новый Структура();
			ПараметрыИзмененияЗадания.Вставить("Использование", Истина);
			ПараметрыИзмененияЗадания.Вставить("Параметры", НайденныеРеглЗадания[0].Параметры);
			ПараметрыИзмененияЗадания.Вставить("Расписание", НайденныеРеглЗадания[0].Расписание);
			РегламентныеЗаданияСервер.ИзменитьЗадание(
				НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);

		КонецЕсли;

	Иначе

		Если НайденныеРеглЗадания.Количество() > 0 Тогда
			РегламентныеЗаданияСервер.УдалитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор);
		КонецЕсли;

	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Перезапускает воркер по команде из формы: снимает активные экземпляры задания,
// пересоздаёт расписание (оно могло быть потеряно, если настройка сохранялась в
// http-режиме) и запускает цикл заново. Результат пишется в лог ИИ.
Процедура ПерезапуститьЗаданиеВоркера(Настройка = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Настройка = ПолучитьАктивнуюНастройкуVibeCode();
	КонецЕсли;
	Если Настройка = Неопределено Тогда
		ЗаписатьВЛогVibeCode("PUSH", "Задание", "restart",
			"Перезапуск не выполнен: активная настройка VibeCode не найдена");
		Возврат;
	КонецЕсли;

	СнятоЗаданий = СнятьАктивныеЗаданияВоркера();

	// Расписание могло быть потеряно (настройка сохранялась в http-режиме) - создаём заново.
	ДобавитьУдалитьРасписаниеЗадания();

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("Настройка", Настройка);
	Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание(
		"Б24_ИИ_ИнтеграцияСервер.ЗапуститьЗаданиеVibeCodeВФоне",
		ИмяФоновогоЗадания(), ПараметрыЗапуска, 0, Истина);

	ЗаписатьВЛогVibeCode("PUSH", "Задание", "restart",
		"Воркер перезапущен: снято активных заданий " + СнятоЗаданий
		+ ", instanceId " + ИдентификаторЭкземпляра(Настройка)
		+ ", адрес " + БазовыйURLИнтеграции(Настройка));

КонецПроцедуры

// Снимает активные экземпляры фонового задания воркера, возвращает их количество.
Функция СнятьАктивныеЗаданияВоркера() Экспорт

	ИмяЗаданияВФоне = ИмяФоновогоЗадания();
	СнятоЗаданий = 0;
	мФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Наименование", ИмяЗаданияВФоне));
	Для каждого ТекЗадание Из мФоновыеЗадания Цикл
		Если ТекЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Попытка
				РегламентныеЗаданияСлужебный.ОтменитьФоновоеЗадание(ТекЗадание.УникальныйИдентификатор);
				СнятоЗаданий = СнятоЗаданий + 1;
			Исключение
				// Задание уже завершилось - пропускаем.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат СнятоЗаданий;

КонецФункции

// Вызывается регламентным заданием: проверяет single-instance и запускает задание.
Процедура ПроверитьИЗапуститьЗадание() Экспорт

	Настройка = ПолучитьАктивнуюНастройкуVibeCode();
	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если РежимРаботы(Настройка) <> "pushpull" Тогда
		Возврат;
	КонецЕсли;

	ИмяЗаданияВФоне = ИмяФоновогоЗадания();

	// Задание живёт максимум 10 минут. Если активная копия старше 12 минут - она
	// зависла: снимаем её и запускаем заново, чтобы зависший экземпляр не блокировал
	// запуск задания вечно (single-instance).
	МеткаЗависания = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса() - 12 * 60;
	ЕстьАктивноеЗадание = Ложь;
	мФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Наименование", ИмяЗаданияВФоне));
	Для каждого ТекЗадание Из мФоновыеЗадания Цикл
		Если ТекЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			Если ТекЗадание.Начало < МеткаЗависания Тогда
				Попытка
					РегламентныеЗаданияСлужебный.ОтменитьФоновоеЗадание(ТекЗадание.УникальныйИдентификатор);
				Исключение
				КонецПопытки;
			Иначе
				ЕстьАктивноеЗадание = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьАктивноеЗадание Тогда
		Возврат;
	КонецЕсли;

	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("Настройка", Настройка);
	Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание(
		"Б24_ИИ_ИнтеграцияСервер.ЗапуститьЗаданиеVibeCodeВФоне",
		ИмяЗаданияВФоне, ПараметрыЗапуска, 0, Истина);

КонецПроцедуры

// Фоновое задание: живёт 10 минут, держит long-poll к /commands.
Процедура ЗапуститьЗаданиеVibeCodeВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт

	Настройка = ПараметрыВыгрузки.Настройка;
	Если Настройка = Неопределено Тогда
		ЗаписатьВЛогVibeCode("PUSH", "Задание", "start",
			"Фоновое задание не запущено: настройка не передана");
		Возврат;
	КонецЕсли;

	ВыполнитьЗаданиеVibeCode(Настройка);

КонецПроцедуры

// Основной цикл P&P-задания.
Процедура ВыполнитьЗаданиеVibeCode(Настройка) Экспорт

	Токен = ТокенПодключения(Настройка);
	ИдентификаторЭкземпляра = ИдентификаторЭкземпляра(Настройка);
	Если ПустаяСтрока(Токен) ИЛИ ПустаяСтрока(ИдентификаторЭкземпляра) Тогда
		// Без токена и идентификатора опрашивать портал нечем. Пишем причину: иначе
		// задание завершается "без ошибок" и в логе не остаётся ни одной записи.
		ЗаписатьВЛогVibeCode("PUSH", "Задание", "start",
			"Задание не запущено: "
			+ ?(ПустаяСтрока(Токен), "не найден токен подключения", "пустой идентификатор экземпляра")
			+ " (проверьте подключение настройки)");
		Возврат;
	КонецЕсли;

	БазовыйURL = БазовыйURLИнтеграции(Настройка);
	Если ПустаяСтрока(БазовыйURL) Тогда
		ЗаписатьВЛогVibeCode("PUSH", "Задание", "start",
			"Задание не запущено: пустой адрес интеграции");
		Возврат;
	КонецЕсли;

	// ТекущаяУниверсальнаяДата, а не дата сеанса: внутри одного серверного вызова
	// ТекущаяДатаСеанса() не меняется, и условие окончания цикла не наступало бы.
	ДатаОкончания = ТекущаяУниверсальнаяДата() + 10 * 60;
	ВерсияКаталога = ВерсияКаталога();
	// Отметка о старте цикла: по ней в логе видно, что воркер действительно опрашивает
	// портал (успешные опросы отдельно не логируются).
	ЗаписатьВЛогVibeCode("PUSH", "Задание", "start",
		"Воркер запущен: instanceId " + ИдентификаторЭкземпляра + ", адрес " + БазовыйURL);
	ЗадержкаПовтора = 0;

	Пока ТекущаяУниверсальнаяДата() < ДатаОкончания Цикл

		Если ЗадержкаПовтора > 0 Тогда
			ПриостановитьВыполнение(ЗадержкаПовтора);
			ЗадержкаПовтора = 0;
		КонецЕсли;

		РезультатКоманд = Б24_ИИ_ИнтеграцияВызовСервера.ПолучитьКоманды(
			БазовыйURL, Токен, ИдентификаторЭкземпляра, ВерсияКаталога, 5, 1);

		// Транспортная ошибка: пересоздание соединения и backoff.
		Если РезультатКоманд.Статус < 0 Тогда
			ЗадержкаПовтора = РассчитатьЗадержкуBackoff(ЗадержкаПовтора);
			Продолжить;
		КонецЕсли;

		КодОшибки = Б24_ИИ_ИнтеграцияВызовСервера.КодОшибкиИнтеграции(РезультатКоманд.JSON);

		// Коды, требующие удаления токена.
		Если КодОшибки = "ONEC_TOKEN_INVALID" ИЛИ КодОшибки = "ONEC_INSTANCE_MISMATCH" Тогда
			УдалитьПодключение(Настройка, "DISCONNECTED");
			Возврат;
		КонецЕсли;

		Если НЕ ПустаяСтрока(КодОшибки) Тогда
			ЗадержкаПовтора = 5;
			Продолжить;
		КонецЕсли;

		Команды = ПолучитьКомандыИзОтвета(РезультатКоманд.JSON);

		Для каждого Команда Из Команды Цикл
			ВыполнитьКомандуИОтправитьРезультат(Настройка, Команда);
		КонецЦикла;

		// Следующий poll сразу: сервер сам удерживал запрос wait секунд,
		// дополнительная пауза не нужна, чтобы опрашивать чаще.
		Если Команды.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Извлекает массив команд из ответа /commands.
Функция ПолучитьКомандыИзОтвета(JSONОтвета) Экспорт

	МассивКоманд = Новый Массив;
	Если ЗначениеНастройки(JSONОтвета, "data") = Неопределено Тогда
		Возврат МассивКоманд;
	КонецЕсли;
	Данные = ЗначениеНастройки(JSONОтвета, "data");
	Если ТипЗнч(Данные) <> Тип("Соответствие")
		ИЛИ ЗначениеНастройки(Данные, "commands") = Неопределено Тогда
		Возврат МассивКоманд;
	КонецЕсли;
	Значение = ЗначениеНастройки(Данные, "commands");
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат МассивКоманд;

КонецФункции

Функция ПолучитьPollWaitSec(JSONОтвета) Экспорт

	Данные = ЗначениеНастройки(JSONОтвета, "data");
	Если НЕ Данные = Неопределено Тогда
		Если ТипЗнч(Данные) = Тип("Соответствие")
			И НЕ ЗначениеНастройки(Данные, "pollWaitSec") = Неопределено Тогда
			Возврат Число(ЗначениеНастройки(Данные, "pollWaitSec"));
		КонецЕсли;
	КонецЕсли;
	Возврат 20;

КонецФункции

// Выполняет команду (listTools/getData) и отправляет результат.
	Процедура ВыполнитьКомандуИОтправитьРезультат(Настройка, Команда) Экспорт

	ИдКоманды = "";
	// По контракту P&P идентификатор команды лежит в поле commandId
	// (data.commands[].commandId). Оставляем фолбэк на "id" для совместимости.
	Если НЕ ЗначениеНастройки(Команда, "commandId") = Неопределено Тогда
		ИдКоманды = Строка(ЗначениеНастройки(Команда, "commandId"));
	ИначеЕсли НЕ ЗначениеНастройки(Команда, "id") = Неопределено Тогда
		ИдКоманды = Строка(ЗначениеНастройки(Команда, "id"));
	КонецЕсли;
	Если ПустаяСтрока(ИдКоманды) Тогда
		Возврат;
	КонецЕсли;

	ТипКоманды = "";
	Если НЕ ЗначениеНастройки(Команда, "type") = Неопределено Тогда
		ТипКоманды = Строка(ЗначениеНастройки(Команда, "type"));
	КонецЕсли;

	// Лог push-режима на входе: 1С прочитала команду - пишем её полный текст.
	ЗаписатьВЛогVibeCode("PUSH", "Запрос", ТипКоманды,
		"Команда " + ТипКоманды + " " + ИдКоманды + ". Запрос: "
		+ Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(Команда));

	КонвертРезультата = ВыполнитьКоманду(Настройка, Команда, ТипКоманды);
	ОтправитьРезультатКоманды(Настройка, ИдКоманды, КонвертРезультата);

КонецПроцедуры

// Формирует конверт результата команды.
Функция ВыполнитьКоманду(Настройка, Команда, ТипКоманды) Экспорт

	Если ТипКоманды = "getData" Тогда
		ЗапросGetData = Новый Соответствие;
		ПолезнаяНагрузка = ЗначениеНастройки(Команда, "payload");
		Если НЕ ПолезнаяНагрузка = Неопределено Тогда
			Если ТипЗнч(ПолезнаяНагрузка) = Тип("Соответствие") Тогда
				ЗапросGetData = ПолезнаяНагрузка;
			КонецЕсли;
		КонецЕсли;
		Возврат ВыполнитьGetData(ЗапросGetData);
	КонецЕсли;

	Если ТипКоманды = "listUsers" Тогда
		Возврат ВыполнитьListUsers();
	КонецЕсли;

	// listTools и неизвестные команды - возвращаем каталог.
	Возврат ВыполнитьListTools();

КонецФункции

// Отправляет результат команды в /commands/{id}/result.
Процедура ОтправитьРезультатКоманды(Настройка, ИдКоманды, КонвертРезультата) Экспорт

	Токен = ТокенПодключения(Настройка);
	ИдентификаторЭкземпляра = ИдентификаторЭкземпляра(Настройка);
	// По контракту результат команды: POST /commands/{id}/result. Адрес берём из
	// ответа /connect (urls.result) - сервер сам сообщает нужный шаблон; сборка из
	// базового адреса остаётся фолбэком внутри URLИнтеграции.
	URLРезультата = URLИнтеграции(Настройка, "result");

	Если ПустаяСтрока(Токен) ИЛИ ПустаяСтрока(URLРезультата) Тогда
		Возврат;
	КонецЕсли;

	РезультатЗапроса = Б24_ИИ_ИнтеграцияВызовСервера.ОтправитьРезультатКоманды(
		URLРезультата, Токен, ИдентификаторЭкземпляра, ИдКоманды, КонвертРезультата);

	КодОшибки = Б24_ИИ_ИнтеграцияВызовСервера.КодОшибкиИнтеграции(РезультатЗапроса.JSON);
	СтрокаКонверта = Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(КонвертРезультата);
	Если РезультатЗапроса.Статус < 200 ИЛИ РезультатЗапроса.Статус >= 300 Тогда
		// Ошибка доставки результата: код, ответ портала и полное тело запроса.
		ЗаписатьВЛогVibeCode("PUSH", "Ошибка", "result",
			"POST result " + ИдКоманды + ": HTTP " + Формат(РезультатЗапроса.Статус, "ЧГ=")
			+ ", код ошибки: " + ?(ПустаяСтрока(КодОшибки), "нет", КодОшибки)
			+ ", ответ портала: " + Лев(СокрЛП(Строка(РезультатЗапроса.Тело)), 600)
			+ ", тело запроса: " + СтрокаКонверта);
	Иначе
		// Лог push-режима на выходе: полное тело ответа 1С.
		ЗаписатьВЛогVibeCode("PUSH", "Ответ", "result",
			"POST result " + ИдКоманды + ": " + СтрокаКонверта);
	КонецЕсли;
	Если КодОшибки = "ONEC_TOKEN_INVALID" ИЛИ КодОшибки = "ONEC_INSTANCE_MISMATCH" Тогда
		УдалитьПодключение(Настройка, "DISCONNECTED");
	КонецЕсли;
	// ONEC_COMMAND_NOT_FOUND / ONEC_DEADLINE_EXPIRED - отбрасываем локальный результат.

КонецПроцедуры

// Расчёт задержки backoff: 2, 4, 8, ... с потолком 60 с.
Функция РассчитатьЗадержкуBackoff(ТекущаяЗадержка) Экспорт

	Если ТекущаяЗадержка = 0 Тогда
		Возврат 2;
	КонецЕсли;
	НоваяЗадержка = ТекущаяЗадержка * 2;
	Если НоваяЗадержка > 60 Тогда
		Возврат 60;
	КонецЕсли;
	Возврат НоваяЗадержка;

КонецФункции

// Активное ожидание в секундах (редкие backoff-паузы в фоновом задании).
Процедура ПриостановитьВыполнение(Секунды) Экспорт

	Если Секунды <= 0 Тогда
		Возврат;
	КонецЕсли;
	// Дату сеанса здесь использовать нельзя: внутри серверного вызова она не
	// меняется, и пауза превращалась бы в вечный цикл.
	ДатаОкончания = ТекущаяУниверсальнаяДата() + Секунды;
	Пока ТекущаяУниверсальнаяДата() < ДатаОкончания Цикл
		// Активное ожидание.
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


#Область БезопасноеХранилище

// Сохраняет токен и идентификатор экземпляра в безопасном хранилище.
Процедура СохранитьТокенИИдентификатор(Настройка, Токен, ИдентификаторЭкземпляра,
	СтруктураПодключения = Неопределено) Экспорт

	ЗначениеДляХранения = Новый Соответствие;
	ЗначениеДляХранения.Вставить("Токен", Токен);
	ЗначениеДляХранения.Вставить("ИдентификаторЭкземпляра", ИдентификаторЭкземпляра);
	Если НЕ СтруктураПодключения = Неопределено Тогда
		ЗначениеДляХранения.Вставить("Подключение", СтруктураПодключения);
	КонецЕсли;

	КлючОбъекта = ПолучитьКлючОбъектаНастроек(Настройка);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючХранилищаТокена(),
		ЗначениеДляХранения);
	// Идентификатор экземпляра не является секретом - дублируем его в реквизит
	// справочника, чтобы он был доступен любому пользователю (в т.ч. служебному
	// «АгентИИ», под которым VibeCode ходит на ping при PUT /settings).
	СохранитьИдентификаторВРеквизит(Настройка, ИдентификаторЭкземпляра);
	// Токен тоже дублируем в реквизит, чтобы фоновое задание (выполняется под
	// другим пользователем) мог его прочитать.
	СохранитьТокенВРеквизит(Настройка, Токен);

КонецПроцедуры

// Пишет значение реквизита справочника настройки в актуальную версию объекта.
// При конфликте версий (сохранённые данные изменены другим пользователем) перечитывает объект и повторяет
// запись (до 3 попыток); если значение уже совпадает - запись пропускается.
Функция ЗаписатьРеквизитНастройкиСПовтором(Настройка, ИмяРеквизита, Значение) Экспорт

	ПопыткаЗаписать = 0;
	Пока ПопыткаЗаписать < 3 Цикл
		Объект = Настройка.ПолучитьОбъект();
		Если СокрЛП(Строка(Объект[ИмяРеквизита])) = СокрЛП(Строка(Значение)) Тогда
			Возврат Истина;
		КонецЕсли;
		Объект[ИмяРеквизита] = СокрЛП(Строка(Значение));
		Попытка
			Объект.Записать();
			Возврат Истина;
		Исключение
			Если НЕ ЭтоКонфликтХранимыхДанных(ОписаниеОшибки()) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецПопытки;
		ПопыткаЗаписать = ПопыткаЗаписать + 1;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет, что текст ошибки соответствует конфликту версий хранимых данных
// («данные изменены/записаны другим пользователем»). Встроенной глобальной
// функции ОшибкаХранимыхДанных в платформе нет, поэтому определяем по тексту.
Функция ЭтоКонфликтХранимыхДанных(ТекстОшибки) Экспорт

	Возврат СтрНайти(НРег(ТекстОшибки), НРег("изменены или удалены другим пользователем")) > 0;

КонецФункции

// Дублирует идентификатор экземпляра в реквизит справочника настройки, чтобы он
// был доступен любому пользователю (в т.ч. служебному «АгентИИ», под которым
// VibeCode ходит на ping при PUT /settings). Идентификатор не является секретом.
Процедура СохранитьИдентификаторВРеквизит(Настройка, ИдентификаторЭкземпляра) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЗаписатьРеквизитНастройкиСПовтором(Настройка, "ИдентификаторЭкземпляра", ИдентификаторЭкземпляра);
	Исключение
		// Реквизит может отсутствовать в старой версии расширения - не критично.
	КонецПопытки;

КонецПроцедуры

// Дублирует токен подключения в реквизит справочника настройки, чтобы он был
// доступен любому пользователю (в т.ч. служебному, под которым выполняется
// фоновое задание, у которого безопасное хранилище пусто).
Процедура СохранитьТокенВРеквизит(Настройка, Токен) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЗаписатьРеквизитНастройкиСПовтором(Настройка, "Токен", Токен);
	Исключение
		// Реквизит может отсутствовать в старой версии расширения - не критично.
	КонецПопытки;

КонецПроцедуры

// Сохраняет пароль пользователя HTTP-сервиса публикации в безопасное хранилище
// настройки (ключ "ПарольПубликации"). В реквизиты справочника не пишется.
Процедура СохранитьПарольПубликации(Настройка, Пароль, АдресПубликации = Неопределено, ПользовательПубликации = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Хранимое = ПрочитатьХранимоеПодключение(Настройка);
	Если ПустаяСтрока(Пароль) Тогда
		Хранимое.Удалить("ПарольПубликации");
		Хранимое.Удалить("ПарольАдресПубликации");
		Хранимое.Удалить("ПарольПользовательПубликации");
	Иначе
		Хранимое.Вставить("ПарольПубликации", СокрЛП(Пароль));
		// Запоминаем учётную запись публикации, для которой введён пароль.
		Хранимое.Вставить("ПарольАдресПубликации", СокрЛП(Строка(АдресПубликации)));
		Хранимое.Вставить("ПарольПользовательПубликации", СокрЛП(Строка(ПользовательПубликации)));
	КонецЕсли;

	КлючОбъекта = ПолучитьКлючОбъектаНастроек(Настройка);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючХранилищаТокена(), Хранимое);

КонецПроцедуры

// Признак того, что пароль публикации сохранён в безопасном хранилище.
Функция ХранитсяПарольПубликации(Настройка, АдресПубликации = Неопределено, ПользовательПубликации = Неопределено) Экспорт

	Хранимое = ПрочитатьХранимоеПодключение(Настройка);
	Пароль = ЗначениеНастройки(Хранимое, "ПарольПубликации");
	Если Пароль = Неопределено ИЛИ ПустаяСтрока(Строка(Пароль)) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Пароль хранится вместе с адресом и пользователем, для которых он введён:
	// если они изменились, пароль неактуален - его надо запросить заново.
	Если АдресПубликации <> Неопределено
		И СокрЛП(Строка(ЗначениеНастройки(Хранимое, "ПарольАдресПубликации"))) <> СокрЛП(Строка(АдресПубликации)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПользовательПубликации <> Неопределено
		И СокрЛП(Строка(ЗначениеНастройки(Хранимое, "ПарольПользовательПубликации"))) <> СокрЛП(Строка(ПользовательПубликации)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Прочитать хранимое значение: {Токен, ИдентификаторЭкземпляра, Подключение?}.
Функция ПрочитатьХранимоеПодключение(Настройка) Экспорт

	КлючОбъекта = ПолучитьКлючОбъектаНастроек(Настройка);
	Значение = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючХранилищаТокена());

	// Гарантируем возврат Соответствия: копируем данные из любого источника,
	// не полагаясь на конкретный тип, который вернуло хранилище.
	Результат = Новый Соответствие;
	Попытка
		Если НЕ Значение = Неопределено И ТипЗнч(Значение) = Тип("Соответствие") Тогда
			Для каждого КлючЗначение Из Значение Цикл
				Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// Некорректное значение в хранилище - возвращаем пустое Соответствие.
		Результат = Новый Соответствие;
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ТокенПодключения(Настройка) Экспорт

	Хранимое = ПрочитатьХранимоеПодключение(Настройка);
	ТокенИзХранилища = Строка(ЗначениеНастройки(Хранимое, "Токен"));
	Если НЕ ПустаяСтрока(ТокенИзХранилища) Тогда
		Возврат ТокенИзХранилища;
	КонецЕсли;

	// Фолбэк: токен продублирован в реквизит справочника, доступный любому
	// пользователю (в т.ч. служебному, под которым работает фоновое задание,
	// у которого безопасное хранилище пусто).
	Если НЕ Настройка = Неопределено Тогда
		Попытка
			Возврат СокрЛП(Строка(Настройка.Токен));
		Исключение
			// Реквизит может отсутствовать в старой версии расширения.
		КонецПопытки;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ИдентификаторЭкземпляра(Настройка) Экспорт

	// Приоритет - реквизит справочника: он доступен любому пользователю (в т.ч.
	// служебному «АгентИИ», под которым VibeCode ходит на ping при PUT /settings),
	// тогда как безопасное хранилище привязано к пользователю сеанса.
	Если НЕ Настройка = Неопределено Тогда
		Попытка
			ИдИзРеквизита = СокрЛП(Строка(Настройка.ИдентификаторЭкземпляра));
			Если НЕ ПустаяСтрока(ИдИзРеквизита) Тогда
				Возврат ИдИзРеквизита;
			КонецЕсли;
		Исключение
			// Реквизит может отсутствовать в старой версии расширения - идём в хранилище.
		КонецПопытки;
	КонецЕсли;

	Хранимое = ПрочитатьХранимоеПодключение(Настройка);
	ИдИзХранилища = Строка(ЗначениеНастройки(Хранимое, "ИдентификаторЭкземпляра"));

	// Миграция: если в хранилище есть значение, а в реквизите его ещё нет -
	// переносим в реквизит, чтобы оно стало доступно всем пользователям.
	Если НЕ ПустаяСтрока(ИдИзХранилища) И НЕ Настройка = Неопределено Тогда
		СохранитьИдентификаторВРеквизит(Настройка, ИдИзХранилища);
	КонецЕсли;

	Возврат ИдИзХранилища;

КонецФункции

// Безопасное чтение значения из Соответствия/Структуры без вызова метода Свойство.
// При любых проблемах (нет ключа, неверный тип) возвращает Неопределено.
Функция ЗначениеНастройки(Хранимое, Ключ) Экспорт

	Попытка
		Если НЕ Хранимое = Неопределено Тогда
			Возврат Хранимое[Ключ];
		КонецЕсли;
	Исключение
		// Ключ отсутствует или тип не поддерживает индексирование.
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Считывает и кэширует в сеансе URL-ы из ответа connect (heartbeat/commands/result/...).
Функция URLИнтеграции(Настройка, ИмяМетода) Экспорт

	Хранимое = ПрочитатьХранимоеПодключение(Настройка);
	Подключение = ЗначениеНастройки(Хранимое, "Подключение");
	URLs = ЗначениеНастройки(Подключение, "URLs");
	Если НЕ URLs = Неопределено Тогда
		ЗначениеURL = ЗначениеНастройки(URLs, ИмяМетода);
		Если НЕ ЗначениеURL = Неопределено Тогда
			Возврат Строка(ЗначениеURL);
		КонецЕсли;
	КонецЕсли;

	// Фолбэк: строим URL из базового адреса.
	Базовый = БазовыйURLИнтеграции(Настройка);
	Если ПустаяСтрока(Базовый) Тогда
		Возврат "";
	КонецЕсли;

	// У результата команды путь длиннее имени метода: /commands/{id}/result.
	Если НРег(ИмяМетода) = "result" Тогда
		Возврат Базовый + "/commands/{id}/result";
	КонецЕсли;

	Возврат Базовый + "/" + ИмяМетода;

КонецФункции

// Устанавливает статус настройки (PAIRING/ONLINE/OFFLINE/DISCONNECTED) и дату контакта.
Процедура ОбновитьСтатусНастройки(Настройка, Статус = "", ДатаКонтакта = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Если менять нечего - не пишем, чтобы не плодить версии записи.
	Если ПустаяСтрока(Статус) И ДатаКонтакта = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПопыткаЗаписать = 0;
	Пока ПопыткаЗаписать < 3 Цикл
		Объект = Настройка.ПолучитьОбъект();
		Если НЕ ПустаяСтрока(Статус) Тогда
			Объект["Статус"] = Статус;
		КонецЕсли;
		Если НЕ ДатаКонтакта = Неопределено Тогда
			Объект.ДатаПоследнегоКонтакта = ДатаКонтакта;
		КонецЕсли;
		Попытка
			Объект.Записать();
			Возврат;
		Исключение
			Если НЕ ЭтоКонфликтХранимыхДанных(ОписаниеОшибки()) Тогда
				Возврат;
			КонецЕсли;
		КонецПопытки;
		ПопыткаЗаписать = ПопыткаЗаписать + 1;
	КонецЦикла;

КонецПроцедуры

// Удаляет токен и отмечает настройку как отключённую.
Процедура УдалитьПодключение(Настройка, Статус = "DISCONNECTED") Экспорт

	КлючОбъекта = ПолучитьКлючОбъектаНастроек(Настройка);
	ХранилищеОбщихНастроек.Удалить(КлючОбъекта, КлючХранилищаТокена());
	ХранилищеОбщихНастроек.Удалить(КлючОбъекта, КлючХранилищаПодключения());
	ОбновитьСтатусНастройки(Настройка, Статус, Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса());
	// Подключение удалено - убираем расписание задания.
	ДобавитьУдалитьРасписаниеЗадания(Истина);

КонецПроцедуры

Функция ПолучитьКлючОбъектаНастроек(Настройка) Экспорт

	Возврат "Б24_ИИ_НастройкиVibeCode_" + Строка(Настройка);

КонецФункции

#КонецОбласти


#Область Информация1С

// Собирает блок information1C для /connect (§4.2).
Функция ПолучитьИнформацию1С() Экспорт

	ТекущаяИнформация = Новый СистемнаяИнформация;

	Информация = Новый Структура;
	Информация.Вставить("moduleVersion", Б24_ИИ_ИнтеграцияВызовСервера.ВерсияМодуля());
	Информация.Вставить("platformVersion", ТекущаяИнформация.ВерсияПриложения);
	Информация.Вставить("baseType", ?(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ИнформационнаяБазаФайловая(), "file", "server"));
	Информация.Вставить("configurationName", Метаданные.Синоним);
	Информация.Вставить("configurationVersion", Метаданные.Версия);
	Информация.Вставить("osVersion", ТекущаяИнформация.ВерсияОС);
	Информация.Вставить("customizer", "");

	Возврат Информация;

КонецФункции

#КонецОбласти


#Область КаталогИнструментов

// Формирует массив tools[] в формате §5.3 из справочника Б24_ИИ_ИнструментыVibeCode.
Функция СформироватьКаталогИнструментов() Экспорт

	Каталог = Новый Массив;

	Выборка = Справочники.Б24_ИИ_ИнструментыVibeCode.Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Выборка.НеИспользуется ИЛИ Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		Метод = СокрЛП(Выборка.Наименование);
		Если ПустаяСтрока(Метод) Тогда
			Продолжить;
		КонецЕсли;

		// Табличные части (Колонки/Фильтры) доступны только через объект, не через выборку.
		ОбъектИнструмента = Выборка.ПолучитьОбъект();

		Инструмент = Новый Структура;
		Инструмент.Вставить("name", СокрЛП(Выборка.ИмяОтображаемое));
		Инструмент.Вставить("method", Метод);
		Инструмент.Вставить("description", СокрЛП(Выборка.Описание));

		Параметры = Новый Структура;

		// Колонки
		Колонки = Новый Структура;
		Колонки.Вставить("type", "array_select");
		Колонки.Вставить("description", "Поля результата; при отсутствии возвращаются все разрешённые поля");
		ОпцииКолонок = Новый Массив;
		Для каждого Колонка Из ОбъектИнструмента.Колонки Цикл
			Опция = Новый Структура;
			Опция.Вставить("name", СокрЛП(Колонка.Имя));
			Опция.Вставить("description", СокрЛП(Колонка.Описание));
			Опция.Вставить("type", СокрЛП(Колонка.Тип));
			ОпцииКолонок.Добавить(Опция);
		КонецЦикла;
		Колонки.Вставить("options", ОпцииКолонок);
		Параметры.Вставить("columns", Колонки);

		// Фильтры
		Если ОбъектИнструмента.Фильтры.Количество() > 0 Тогда
			Фильтры = Новый Структура;
			Фильтры.Вставить("type", "object");
			Фильтры.Вставить("description", "Фильтры выборки");
			СвойстваФильтров = Новый Соответствие;
			Для каждого Фильтр Из ОбъектИнструмента.Фильтры Цикл
				СвойствоФильтра = Новый Структура;
				СвойствоФильтра.Вставить("type", СокрЛП(Фильтр.Тип));
				СвойствоФильтра.Вставить("description", СокрЛП(Фильтр.Описание));
				СвойстваФильтров.Вставить(СокрЛП(Фильтр.Имя), СвойствоФильтра);
			КонецЦикла;
			Фильтры.Вставить("properties", СвойстваФильтров);
			Параметры.Вставить("filters", Фильтры);
		КонецЕсли;

		Инструмент.Вставить("parameters", Параметры);
		Каталог.Добавить(Инструмент);
	КонецЦикла;

	Возврат Каталог;

КонецФункции

// Канонический JSON каталога (постоянный порядок, без пробелов) для вычисления MD5.
Функция КаноническийJSONКаталога(Каталог) Экспорт

	Возврат Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(Каталог);

КонецФункции

// MD5-хэш строки в виде hex без разделителей: ХешСумма отдаёт байты через пробел,
// а контракт (catalogVersion = "<moduleVersion>:<md5>") ждёт обычную hex-строку.
Функция MD5Строки(Знач СтрокаДляХэша) Экспорт

	Хэш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хэш.Добавить(СтрокаДляХэша);
	Возврат НРег(СтрЗаменить(Хэш.ХешСумма, " ", ""));

КонецФункции

// Версия каталога вида "<moduleVersion>:<md5>". Пустая строка - не сравнивать.
Функция ВерсияКаталога() Экспорт

	Каталог = СформироватьКаталогИнструментов();
	Попытка
		МД5 = MD5Строки(КаноническийJSONКаталога(Каталог));
		Возврат Б24_ИИ_ИнтеграцияВызовСервера.ВерсияМодуля() + ":" + МД5;
	Исключение
		Возврат Б24_ИИ_ИнтеграцияВызовСервера.ВерсияМодуля();
	КонецПопытки;

КонецФункции

#КонецОбласти


#Область Handlers

// POST /ping - проверка доступности публикации и авторизации (§5.2).
Функция ВыполнитьPing(Настройка = Неопределено) Экспорт

	// Ping приходит от VibeCode под пользователем HTTP-публикации 1С — в т.ч.
	// служебным «АгентИИ», у которого может не быть прав на справочник настроек
	// и безопасное хранилище. Привилегированный режим гарантирует чтение активной
	// настройки и сохранённого instanceId независимо от прав пользователя.
	// Привилегированный режим, установленный в функции, автоматически
	// восстанавливается до прежнего значения при выходе из неё, поэтому
	// явное сохранение/восстановление не требуется.
	УстановитьПривилегированныйРежим(Истина);

	Попытка

		// Лог HTTP-режима: входящий запрос (у ping он без тела).
		ЗаписатьВЛогVibeCode("HTTP", "Запрос", "ping", "<тело запроса отсутствует>");

		Если Настройка = Неопределено Тогда
			Настройка = ПолучитьАктивнуюНастройкуVibeCode();
		КонецЕсли;

		Информация = Новый Соответствие;
		Информация.Вставить("instanceId", ?(Настройка = Неопределено, "",
			ИдентификаторЭкземпляра(Настройка)));
		Информация.Вставить("moduleVersion", Б24_ИИ_ИнтеграцияВызовСервера.ВерсияМодуля());

		Данные = Новый Соответствие;
		Данные.Вставить("success", Истина);
		Данные.Вставить("data", Информация);

		// Лог HTTP-режима: полное тело ответа 1С.
		ЗаписатьВЛогVibeCode("HTTP", "Ответ", "ping",
			Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(Данные));

		Возврат Данные;

	Исключение
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// POST /listTools - возврат каталога инструментов (§5.3).
Функция ВыполнитьListTools() Экспорт

	Каталог = СформироватьКаталогИнструментов();

	// Лог HTTP-режима: входящий запрос (у listTools он без тела).
	ЗаписатьВЛогVibeCode("HTTP", "Запрос", "listTools", "<тело запроса отсутствует>");

	Данные = Новый Соответствие;
	Данные.Вставить("formatVersion", ФорматВерсия());
	Данные.Вставить("tools", Каталог);

	Конверт = Новый Соответствие;
	Конверт.Вставить("success", Истина);
	Конверт.Вставить("data", Данные);

	// Лог HTTP-режима: полное тело ответа 1С (сверка каталога со схемой §5.3).
	ЗаписатьВЛогVibeCode("HTTP", "Ответ", "listTools",
		Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(Конверт));

	Возврат Конверт;

КонецФункции

// POST /listUsers - возвращает {settingsGuid, users:[{name, guid}]}: ИД настройки
// VibeCode и её разрешённые пользователи 1С (табличная часть «Пользователи»).
// settingsGuid - тот же идентификатор, что уходит на портал как instanceId
// (реквизит «ИдентификаторЭкземпляра» справочника настройки).
// Параметр ГуидНастройки: если передан, настройка выбирается строго по нему;
// если пуст - берётся активная настройка.
Функция ВыполнитьListUsers(ГуидНастройки = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);

	// Лог HTTP-режима: входящий запрос (тело listUsers - только settingsGuid).
	ЗаписатьВЛогVibeCode("HTTP", "Запрос", "listUsers",
		Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(
			Новый Структура("settingsGuid", СокрЛП(ГуидНастройки))));

	СписокПользователей = Новый Массив;
	ВозвращаемыйГуидНастройки = "";

	// Типизированный запрос: колонка Ссылка даёт EDT известный тип
	// СправочникСсылка.Б24_ИИ_НастройкиVibeCode, поэтому обращение к
	// табличной части .Пользователи типизатор не считает ошибкой.
	ЗапросНастройки = Новый Запрос;
	Если ЗначениеЗаполнено(ГуидНастройки) Тогда
		// ИД настройки (он же instanceId, он же settingsGuid) лежит в реквизите
		// «ИдентификаторЭкземпляра»: настройку выбираем строго по нему.
		// Фолбэк на GUID ссылки - для настроек, привязанных к порталу до того,
		// как оба идентификатора свели в один.
		ИдентификаторСтрокой = СокрЛП(ГуидНастройки);
		СсылкаНастройки = Справочники.Б24_ИИ_НастройкиVibeCode.НайтиПоРеквизиту(
			"ИдентификаторЭкземпляра", ИдентификаторСтрокой);
		Если НЕ ЗначениеЗаполнено(СсылкаНастройки) Тогда
			Попытка
				СсылкаНастройки = Справочники.Б24_ИИ_НастройкиVibeCode.ПолучитьСсылку(
					Новый УникальныйИдентификатор(ИдентификаторСтрокой));
			Исключение
				СсылкаНастройки = Справочники.Б24_ИИ_НастройкиVibeCode.ПустаяСсылка();
			КонецПопытки;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СсылкаНастройки) Тогда
			КонвертОтвета = КонвертListUsers(СписокПользователей, "");
			ЗаписатьВЛогVibeCode("HTTP", "Ответ", "listUsers",
				Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(КонвертОтвета));
			Возврат КонвертОтвета;
		КонецЕсли;

		ЗапросНастройки.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Настройки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Б24_ИИ_НастройкиVibeCode КАК Настройки
			|ГДЕ
			|	Настройки.Ссылка = &СсылкаНастройки
			|	И НЕ Настройки.ПометкаУдаления";
		ЗапросНастройки.УстановитьПараметр("СсылкаНастройки", СсылкаНастройки);
	Иначе
		// GUID не передан - берём активную настройку.
		ЗапросНастройки.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Настройки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Б24_ИИ_НастройкиVibeCode КАК Настройки
			|ГДЕ
			|	Настройки.Использование И НЕ Настройки.ПометкаУдаления";
	КонецЕсли;

	ВыборкаНастройки = ЗапросНастройки.Выполнить().Выбрать();
	Если ВыборкаНастройки.Следующий() Тогда
		// На портал уходит тот же ИД, что и в instanceId (заголовок X-Onec-Instance-Id
		// и тело connect) - единый идентификатор подключения базы.
		ВозвращаемыйГуидНастройки = ИдентификаторЭкземпляра(ВыборкаНастройки.Ссылка);
		Если ПустаяСтрока(ВозвращаемыйГуидНастройки) Тогда
			// Настройка подключена до появления общего ИД: генерируем и фиксируем,
			// чтобы значение было стабильным и совпадало с instanceId.
			ВозвращаемыйГуидНастройки = Строка(Новый УникальныйИдентификатор);
			СохранитьИдентификаторВРеквизит(ВыборкаНастройки.Ссылка, ВозвращаемыйГуидНастройки);
		КонецЕсли;
		ОбъектНастройки = ВыборкаНастройки.Ссылка.ПолучитьОбъект();
		Если НЕ ОбъектНастройки.ВсеПользователи Тогда
			// Галка «Все пользователи» снята: выгружаем всех неудалённых
			// пользователей справочника «Пользователи» без ограничения списком.
			ЗапросПользователей = Новый Запрос(
				"ВЫБРАТЬ
				|	Пользователи.Ссылка КАК Ссылка,
				|	Пользователи.Наименование КАК Наименование
				|ИЗ
				|	Справочник.Пользователи КАК Пользователи
				|ГДЕ
				|	НЕ Пользователи.ПометкаУдаления");
			ВыборкаПользователей = ЗапросПользователей.Выполнить().Выбрать();
			Пока ВыборкаПользователей.Следующий() Цикл
				Элемент = Новый Структура("name, guid",
					СокрЛП(ВыборкаПользователей.Наименование),
					Строка(ВыборкаПользователей.Ссылка.УникальныйИдентификатор()));
				СписокПользователей.Добавить(Элемент);
			КонецЦикла;
		Иначе
			// Галка установлена: конкретный список пользователей из табличной
			// части настройки.
			Для каждого СтрокаПользователя Из ОбъектНастройки.Пользователи Цикл
				Если ПустаяСтрока(СокрЛП(СтрокаПользователя.Гуид)) Тогда
					Продолжить;
				КонецЕсли;
				Элемент = Новый Структура("name, guid",
					СокрЛП(СтрокаПользователя.Наименование),
					СокрЛП(СтрокаПользователя.Гуид));
				СписокПользователей.Добавить(Элемент);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	КонвертОтвета = КонвертListUsers(СписокПользователей, ВозвращаемыйГуидНастройки);

	// Лог HTTP-режима: полное тело ответа 1С.
	ЗаписатьВЛогVibeCode("HTTP", "Ответ", "listUsers",
		Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(КонвертОтвета));

	Возврат КонвертОтвета;

КонецФункции

// Собирает конверт ответа listUsers {success, data:{settingsGuid, users}}.
Функция КонвертListUsers(СписокПользователей, ГуидНастройки) Экспорт

	Данные = Новый Соответствие;
	Данные.Вставить("settingsGuid", ГуидНастройки);
	Данные.Вставить("users", СписокПользователей);

	Конверт = Новый Соответствие;
	Конверт.Вставить("success", Истина);
	Конверт.Вставить("data", Данные);
	Возврат Конверт;

КонецФункции

// Проверяет, что пользователь 1С с данным GUID (user.id из getData) входит в
// список разрешённых пользователей активной настройки (табличная часть
// «Пользователи»). Если пользователя нет в этом списке - доступа нет.
Функция ПользовательИмеетДоступ(ГуидПользователя) Экспорт

	Если ПустаяСтрока(СокрЛП(ГуидПользователя)) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	// Получаем активную настройку типизированно: ссылка из запроса даёт EDT
	// известный тип СправочникСсылка.Б24_ИИ_НастройкиVibeCode, поэтому
	// обращение к табличной части .Пользователи типизатор не считает ошибкой.
	ЗапросНастройки = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Б24_ИИ_НастройкиVibeCode КАК Настройки
		|ГДЕ
		|	Настройки.Использование И НЕ Настройки.ПометкаУдаления");
	ВыборкаНастройки = ЗапросНастройки.Выполнить().Выбрать();
	Если НЕ ВыборкаНастройки.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	// Обходим табличную часть активной настройки через объект.
	ОбъектНастройки = ВыборкаНастройки.Ссылка.ПолучитьОбъект();

	// Если галка «Все пользователи» снята — доступ разрешён любому
	// пользователю, проверка по табличной части «Пользователи» не применяется.
	Если НЕ ОбъектНастройки.ВсеПользователи Тогда
		Возврат Истина;
	КонецЕсли;

	Для каждого СтрокаПользователя Из ОбъектНастройки.Пользователи Цикл
		СсылкаПользователя = СтрокаПользователя.Пользователь;
		Если НЕ ЗначениеЗаполнено(СсылкаПользователя) Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(Строка(СсылкаПользователя.УникальныйИдентификатор()))
			= НРег(СокрЛП(ГуидПользователя)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

	// При выходе из функции привилегированный режим восстановится автоматически.

КонецФункции

// ===== Вариант D (реальный): применение RLS пользователя 1С =====
// Полной смены пользователя сеанса в 1С НЕТ: текущий пользователь фиксируется при
// аутентификации, штатных функций УстановитьПользователя/УстановитьТекущегоПользователя
// не существует (проверено EDT и документацией). Поэтому доступ ограничивается
// применением RLS целевого пользователя: параметр сеанса ТекущийПользователь, на
// котором строятся строковые ограничения в УТ, на время выполнения запроса
// устанавливается в ссылку пользователя из user.id, затем возвращается в исходное.

// Возвращает ссылку справочника «Пользователи» по GUID (user.id из getData).
// Пустая ссылка, если GUID некорректен.
Функция СсылкаПользователяПоГуиду(ГуидПользователя) Экспорт

	Если ПустаяСтрока(СокрЛП(ГуидПользователя)) Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;

	УИД = Неопределено;
	Попытка
		УИД = Новый УникальныйИдентификатор(СокрЛП(ГуидПользователя));
	Исключение
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецПопытки;

	Ссылка = Справочники.Пользователи.ПолучитьСсылку(УИД);
	// ПолучитьСсылку не проверяет существование: по произвольному GUID вернётся
	// "фантомная" ссылка, прав в RLS для неё нет - и построчный фильтр скрыл бы
	// все строки. Чтение реквизита у несуществующего объекта падает - проверяем им.
	Попытка
		НаименованиеПользователя = Ссылка.Наименование;
	Исключение
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецПопытки;

	Возврат Ссылка;

КонецФункции

// Выполняет запрос с применением RLS целевого пользователя (параметр сеанса
// ТекущийПользователь). Исходное значение параметра сеанса восстанавливается
// всегда, в т.ч. при исключении. На клиенте (не используется для HTTP-сервиса)
// запрос выполняется в текущем контексте.
Функция ВыполнитьЗапросОтИмениПользователя(Запрос, ГуидПользователя) Экспорт

	СсылкаПользователя = СсылкаПользователяПоГуиду(ГуидПользователя);
	Если НЕ ЗначениеЗаполнено(СсылкаПользователя) Тогда
		ВызватьИсключение НСтр("ru='Пользователь 1С не найден или у него нет прав'");
	КонецЕсли;

	// Программная проверка прав ролей: пользователь должен иметь право чтения
	// каждой таблицы, к которой обращается запрос.
	ОшибкаПрав = ПроверитьПраваНаТекстЗапроса(СсылкаПользователя, Запрос.Текст);
	Если НЕ ПустаяСтрока(ОшибкаПрав) Тогда
		ВызватьИсключение ОшибкаПрав;
	КонецЕсли;

#Если Сервер Тогда

	ИсходныйПользователь = ПараметрыСеанса.ТекущийПользователь;

	// Параметр сеанса, на котором построены ограничения доступа в УТ, меняется
	// только в привилегированном режиме. Но сам запрос обязан выполняться уже БЕЗ
	// него: в привилегированном режиме платформа не применяет ни права, ни RLS, и
	// пользователь получает строки, запрещённые его группами доступа.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ПараметрыСеанса.ТекущийПользователь = СсылкаПользователя;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	// Ограничения доступа построены на параметрах сеанса (набор групп доступа,
	// версии шаблонов ограничений). Одной подмены пользователя мало - параметры
	// нужно пересчитать для него, иначе запрос вернёт строки, запрещённые его
	// группами доступа (например, данные всех организаций).
	Попытка
		УправлениеДоступомСлужебный.ОбновитьПараметрыСеанса();
	Исключение
		ТекстОшибкиПараметров = ОписаниеОшибки();
		ЗаписатьВЛогVibeCode("Права", "Ошибка", "getData",
			"Не удалось пересчитать параметры ограничений доступа: "
			+ Лев(ТекстОшибкиПараметров, 300));
	КонецПопытки;

	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ВосстановитьПользователяСеанса(ИсходныйПользователь);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	// Возврат параметра сеанса тоже требует привилегированного режима -
	// он включается и снимается внутри самой процедуры.
	ВосстановитьПользователяСеанса(ИсходныйПользователь);

	Возврат Результат;

#Иначе
	Возврат Запрос.Выполнить().Выгрузить();
#КонецЕсли

КонецФункции

// Восстанавливает исходного пользователя в параметре сеанса RLS (ТекущийПользователь).
Процедура ВосстановитьПользователяСеанса(Значение) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ПараметрыСеанса.ТекущийПользователь = Значение;
	Исключение
		// Сеанс уже завершается HTTP-обработкой; не критично.
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	// Возвращаем параметры ограничений сеанса к исходному пользователю.
	Попытка
		УправлениеДоступомСлужебный.ОбновитьПараметрыСеанса();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// Суффикс служебных полей запроса инструмента, по которым проверяются права доступа.
// В запрос такое поле добавляется, чтобы отфильтровать строки по правам портального
// пользователя, и в контракт инструмента (список колонок, ответ портала) не попадает.
Функция СуффиксСлужебногоПоля() Экспорт

	Возврат "_ПраваДоступа";

КонецФункции

// ЭтоСсылочноеЗначение - Булево: значение ссылочного типа, для которого в принципе
// могут действовать ограничения доступа на уровне записей.
Функция ЭтоСсылочноеЗначение(Значение) Экспорт

	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Метаданные.НайтиПоТипу(ТипЗначения) <> Неопределено;

КонецФункции

// Скрывает из выборки инструмента строки, значения-ссылки которых недоступны
// портальному пользователю.
//
// Ограничения доступа платформа применяет к пользователю сеанса (в фоновом задании
// пользователя нет вовсе), поэтому вместо подстановки пользователя в параметр сеанса
// права проверяются явно - штатной функцией БСП по конкретным объектам.
// Недоступно хотя бы одно значение строки - строки нет в ответе (как и при RLS).
//
// Возвращает количество скрытых строк.
Функция СкрытьНедоступныеСтроки(Таблица, ГуидПользователя) Экспорт

	Если Таблица = Неопределено ИЛИ Таблица.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	СсылкаПользователя = СсылкаПользователяПоГуиду(ГуидПользователя);
	Если НЕ ЗначениеЗаполнено(СсылкаПользователя) Тогда
		// Пользователь не определён - безопасное поведение: данных не отдаём.
		// Пишем в лог: без этой записи отказ выглядит как «данных нет».
		ЗаписатьВЛогVibeCode("Права", "Пользователь", "getData",
			"Пользователь портала " + СокрЛП(ГуидПользователя)
			+ " не сопоставлен с пользователем 1С: данные не отдаются");
		Таблица.Очистить();
		Возврат 0;
	КонецЕсли;

	// Диагностика: по записи видно, с кем именно сравниваются права.
	ЗаписатьВЛогVibeCode("Права", "Пользователь", "getData",
		"Пользователь портала " + СокрЛП(ГуидПользователя)
		+ " -> " + Строка(СсылкаПользователя));

	// Полноправному пользователю (администратору) построчная фильтрация не нужна:
	// его доступ идёт не через RLS, а по роли «Полные права», поэтому записей о правах
	// на конкретные объекты нет - проверка ошибочно скрыла бы все строки.
	Попытка
		Если Пользователи.ЭтоПолноправныйПользователь(СсылкаПользователя) Тогда
			Возврат 0;
		КонецЕсли;
	Исключение
		// Не удалось определить полноправность - работаем по общему правилу.
	КонецПопытки;

	// Вариант ограничения доступа в базе. Производительный поддерживает штатный API БСП
	// ПраваДоступаКДанным; в стандартном (классическом) варианте он не поддерживается,
	// и наборы разрешённых значений собираются по настройкам групп доступа пользователя
	// (см. РазрешенныеЗначенияТипаПоГруппамДоступа).
	Попытка
		ПроизводительныйВариант = УправлениеДоступом.ПроизводительныйВариант();
	Исключение
		ПроизводительныйВариант = Ложь;
	КонецПопытки;

	// Ссылки собираем по типам: ПраваДоступаКДанным принимает объекты одного типа.
	СсылкиПоТипам = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = СтрокаТаблицы[Колонка.Имя];
			Если НЕ ЭтоСсылочноеЗначение(Значение) Тогда
				Продолжить;
			КонецЕсли;
			ТипЗначения = ТипЗнч(Значение);
			СсылкиТипа = СсылкиПоТипам.Получить(ТипЗначения);
			Если СсылкиТипа = Неопределено Тогда
				СсылкиТипа = Новый Массив;
				СсылкиПоТипам.Вставить(ТипЗначения, СсылкиТипа);
			КонецЕсли;
			Если СсылкиТипа.Найти(Значение) = Неопределено Тогда
				СсылкиТипа.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Для каждого типа определяем, какие значения портальный пользователь вправе видеть:
	// в производительном варианте - штатным API БСП, в стандартном - по настройкам групп
	// доступа. Если тип не подтверждён ни одним способом, он попадает в типы без ограничений.
	РазрешенныеЗначения = Новый Соответствие;
	ТипыБезОграничений = Новый Соответствие;
	// Типы, по которым у пользователя есть настройки: по ним не отдаются и строки
	// с незаполненным значением (см. проверку строк ниже).
	ТипыСОграничениями = Новый Соответствие;
	ЛогОбразцаПравВыведен = Ложь;
	МассивПользователей = Новый Массив;
	МассивПользователей.Добавить(СсылкаПользователя);
	Для Каждого КлючИЗначение Из СсылкиПоТипам Цикл

		// Стандартный вариант ограничения доступа: штатный API БСП недоступен, набор
		// разрешённых значений собираем по группам доступа портального пользователя.
		Если НЕ ПроизводительныйВариант Тогда
			ДобавитьРазрешенныеЗначенияТипа(КлючИЗначение.Ключ, КлючИЗначение.Значение,
				СсылкаПользователя, РазрешенныеЗначения, ТипыБезОграничений, ТипыСОграничениями);
			Продолжить;
		КонецЕсли;

		Попытка
			// API рассчитан на вызов с полными правами или в привилегированном режиме
			// (внутри у него такая проверка); на результат это не влияет - права
			// считаются для переданных пользователей, а не для сеансового.
			УстановитьПривилегированныйРежим(Истина);
			ПраваОбъектов = УправлениеДоступом.ПраваДоступаКДанным(
				КлючИЗначение.Значение, Ложь, МассивПользователей);
			УстановитьПривилегированныйРежим(Ложь);
			Если ПраваОбъектов.Количество() = 0 Тогда
				// Ограничения доступа к данным этого типа не настроены: доступ
				// определяется ролями, построчно скрывать нечего.
				ТипыБезОграничений.Вставить(КлючИЗначение.Ключ, Истина);
				Продолжить;
			КонецЕсли;
			ИмяКолонкиОбъекта = "";
			Для Каждого КолонкаПрава Из ПраваОбъектов.Колонки Цикл
				Если КолонкаПрава.Имя <> "ПользовательСПравом" И КолонкаПрава.Имя <> "ПравоИзменение" Тогда
					ИмяКолонкиОбъекта = КолонкаПрава.Имя;
				КонецЕсли;
			КонецЦикла;
			Если ПустаяСтрока(ИмяКолонкиОбъекта) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЛогОбразцаПравВыведен Тогда
				ЛогОбразцаПравВыведен = Истина;
				ОбразецПрав = "";
				СтрокаОбразец = ПраваОбъектов[0];
				Для Каждого КолонкаПрава Из ПраваОбъектов.Колонки Цикл
					ОбразецПрав = ОбразецПрав + КолонкаПрава.Имя + "="
						+ Строка(СтрокаОбразец[КолонкаПрава.Имя]) + "; ";
				КонецЦикла;
				ЗаписатьВЛогVibeCode("Права", "Образец", "getData", Лев(ОбразецПрав, 500));
			КонецЕсли;
			// Функция вызвана для конкретного пользователя (он передан в составе
			// пользователей), поэтому её строки описывают права именно его - в том числе
			// выданные через группы доступа. Раньше мы дополнительно требовали, чтобы
			// колонка «ПользовательСПравом» совпадала с пользователем: права, выданные
			// группе, отбрасывались и построчный фильтр скрывал все строки.
			ТипыСОграничениями.Вставить(КлючИЗначение.Ключ, Истина);
			Для Каждого СтрокаПрава Из ПраваОбъектов Цикл
				РазрешенныеЗначения.Вставить(СтрокаПрава[ИмяКолонкиОбъекта], Истина);
			КонецЦикла;
		Исключение
			// Штатный API не сработал - собираем набор по группам доступа, иначе тип
			// остался бы запрещённым целиком (раньше в этом случае скрывались все строки).
			// Причину пишем в лог: без неё этот случай неотличим от «прав нет».
			ТекстОшибкиПрав = ОписаниеОшибки();
			ЗаписатьВЛогVibeCode("Права", "Ошибка", "getData",
				"Не удалось получить права доступа к данным: " + Лев(ТекстОшибкиПрав, 400));
			ДобавитьРазрешенныеЗначенияТипа(КлючИЗначение.Ключ, КлючИЗначение.Значение,
				СсылкаПользователя, РазрешенныеЗначения, ТипыБезОграничений, ТипыСОграничениями);
		КонецПопытки;
	КонецЦикла;

	// Отдельного вида доступа по сотрудникам в БСП нет: кадровые данные ограничиваются по
	// физическим лицам, организациям и подразделениям. Поэтому сотрудников из выборки
	// проверяем по значениям самого сотрудника (физическое лицо, организация, подразделение).
	ДоступныеСотрудники = Неопределено;
	ТипСотрудникиВыборки = Неопределено;
	Если НЕ ПроизводительныйВариант Тогда
		Попытка
			ПроверкаПоСотрудникам = ДоступныеСотрудникиВыборки(Таблица, СсылкаПользователя);
		Исключение
			ТекстОшибкиПоСотрудникам = ОписаниеОшибки();
			ЗаписатьВЛогVibeCode("Права", "Ошибка", "getData",
				"Не удалось проверить права по сотрудникам: "
				+ Лев(ТекстОшибкиПоСотрудникам, 300));
			ПроверкаПоСотрудникам = Неопределено;
		КонецПопытки;
		Если ПроверкаПоСотрудникам <> Неопределено Тогда
			ДоступныеСотрудники = ПроверкаПоСотрудникам.Доступные;
			ТипСотрудникиВыборки = ПроверкаПоСотрудникам.Тип;
		КонецЕсли;
	КонецЕсли;

	// Диагностика: сколько значений признано доступными и чем представлены права
	// (пользователем или группой доступа) - по этому видно, почему строки скрываются.
	// Кроме значений групп доступа платформа даёт доступ через собственный набор значений
	// доступа объекта и через настроенные права объекта (шаблоны ограничения доступа ролей).
	// Разбор этих механизмов дополняет набор доступных значений; сами механизмы строго
	// аддитивные: если что-то не подтверждено, значение считается недоступным.
	РазрешенныеДополнительно = Новый Соответствие;
	ДобавитьДоступныеПоНаборамЗначенийДоступа(СсылкиПоТипам, СсылкаПользователя,
		РазрешенныеДополнительно);
	ДобавитьДоступныеПоНастройкамПравОбъектов(СсылкиПоТипам, СсылкаПользователя,
		РазрешенныеДополнительно);

	ЗаписатьВЛогVibeCode("Права", "Разбор", "getData",
		"Доступных значений: " + РазрешенныеЗначения.Количество()
		+ ", типов без ограничений: " + ТипыБезОграничений.Количество()
		+ ", типов с ограничениями: " + ТипыСОграничениями.Количество()
		+ ", типов проверялось: " + СсылкиПоТипам.Количество()
		+ ", доступно по иным механизмам: " + РазрешенныеДополнительно.Количество()
		+ ", вариант ограничения доступа: "
		+ ?(ПроизводительныйВариант, "производительный", "стандартный"));

	// Удаляем строки, в которых есть хотя бы одно недоступное значение.
	БылоСтрок = Таблица.Количество();
	НомерСтроки = БылоСтрок - 1;
	Пока НомерСтроки >= 0 Цикл
		СтрокаТаблицы = Таблица[НомерСтроки];
		СтрокаНедоступна = Ложь;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = СтрокаТаблицы[Колонка.Имя];

			// Незаполненное значение ограничиваемого вида доступа доступ не подтверждает:
			// строку не отдаём (ограничение 1С по незаполненному полю тоже её не пропускает).
			// Тип берём у колонки: по NULL определить его нельзя.
			Если Значение = NULL
				ИЛИ ЭтоСсылочноеЗначение(Значение) И НЕ ЗначениеЗаполнено(Значение) Тогда
				Если ЭтоТипСОграничениями(Колонка.ТипЗначения, ТипыСОграничениями) Тогда
					СтрокаНедоступна = Истина;
					Прервать;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Если НЕ ЭтоСсылочноеЗначение(Значение) Тогда
				Продолжить;
			КонецЕсли;
			// Сотрудник проверяется по своим физическому лицу, организации и подразделению:
			// собственного вида доступа по сотрудникам в БСП нет.
			Если ДоступныеСотрудники <> Неопределено
				И ТипЗнч(Значение) = ТипСотрудникиВыборки Тогда
				Если ДоступныеСотрудники.Получить(Значение) = Неопределено Тогда
					СтрокаНедоступна = Истина;
					Прервать;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если ТипыБезОграничений.Получить(ТипЗнч(Значение)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если РазрешенныеЗначения.Получить(Значение) = Неопределено
				И РазрешенныеДополнительно.Получить(Значение) = Неопределено Тогда
				СтрокаНедоступна = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаНедоступна Тогда
			Таблица.Удалить(НомерСтроки);
		КонецЕсли;
		НомерСтроки = НомерСтроки - 1;
	КонецЦикла;

	// Полное сокрытие выборки - признак того, что настройки групп доступа прочитаны
	// неверно (либо у пользователя действительно нет доступа ни к одной строке). Пишем
	// отдельную запись: без неё отказ выглядит как «данных нет».
	Если БылоСтрок > 0 И Таблица.Количество() = 0 Тогда
		ЗаписатьВЛогVibeCode("Права", "ВсеСтроки", "getData",
			"Скрыты все строки выборки (" + БылоСтрок + "): проверьте группы доступа"
			+ " и значения доступа пользователя");
	КонецЕсли;

	Возврат БылоСтрок - Таблица.Количество();

КонецФункции

// Добавляет в общие наборы разрешённые значения типа, собранные по группам доступа
// портального пользователя. Тип без настроек помечается как тип без ограничений, тип
// с настройками - как ограничиваемый (по нему строки с пустым значением не отдаются).
Процедура ДобавитьРазрешенныеЗначенияТипа(ТипЗначения, СсылкиТипа, СсылкаПользователя,
	РазрешенныеЗначения, ТипыБезОграничений, ТипыСОграничениями) Экспорт

	// Ошибка разбора настроек доступа не должна ломать выдачу данных: строки тогда идут
	// как есть (как было до фильтрации), а причина остаётся в логе ИИ.
	Попытка
		РезультатПоТипу = РазрешенныеЗначенияТипаПоГруппамДоступа(ТипЗначения, СсылкаПользователя, СсылкиТипа);
	Исключение
		ТекстОшибкиГрупп = ОписаниеОшибки();
		ЗаписатьВЛогVibeCode("Права", "Ошибка", "getData",
			"Не удалось применить ограничения групп доступа ("
			+ Строка(ТипЗначения) + "): " + Лев(ТекстОшибкиГрупп, 300));
		РезультатПоТипу = Неопределено;
	КонецПопытки;

	Если РезультатПоТипу = Неопределено Тогда
		// Значения этого типа видами доступа не ограничиваются (например, сотрудники).
		ТипыБезОграничений.Вставить(ТипЗначения, Истина);
		Возврат;
	КонецЕсли;

	Если РезультатПоТипу.Ограничен Тогда
		ТипыСОграничениями.Вставить(ТипЗначения, Истина);
	КонецЕсли;

	Для Каждого КлючИЗначение Из РезультатПоТипу.Разрешенные Цикл
		РазрешенныеЗначения.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;

КонецПроцедуры

// Возвращает разрешённые значения типа по настройкам групп доступа пользователя.
//
// В стандартном (классическом) варианте ограничения доступа функция БСП
// УправлениеДоступом.ПраваДоступаКДанным() не поддерживается, поэтому набор значений
// собирается по тем же данным, что использует шаблон ограничения доступа ПоЗначениям ролей:
//   РегистрСведений.ЗначенияГруппДоступа            - назначенные значения доступа;
//   РегистрСведений.ЗначенияГруппДоступаПоУмолчанию - «все разрешены» по типу значения;
//   РегистрСведений.ГруппыЗначенийДоступа           - вхождение значения в группу значений;
//   РегистрСведений.СоставыГруппПользователей       - вложенные группы пользователей.
// Значение разрешено, если оно назначено (напрямую или как участник назначенной группы
// значений) в точности тем группам пользователя, в которых задан список значений: когда
// группе разрешены все значения, назначенные значения являются исключениями.
//
// Параметры:
//  ТипЗначения          - Тип - тип значения доступа, например Тип("СправочникСсылка.Организации").
//  СсылкаПользователя   - СправочникСсылка.Пользователи - портальный пользователь.
//  ПроверяемыеЗначения  - Массив - значения выборки указанного типа.
//
// Возвращаемое значение:
//  Неопределено - тип не является типом значения доступа, ограничивать нечего;
//  Структура:
//   * Разрешенные - Соответствие - разрешённые из проверяемых значений (Ключ - значение);
//   * Ограничен   - Булево - по типу есть настройки в группах доступа пользователя.
//
Функция РазрешенныеЗначенияТипаПоГруппамДоступа(ТипЗначения, СсылкаПользователя, ПроверяемыеЗначения) Экспорт

	Если ТипЗначения = Неопределено ИЛИ ПроверяемыеЗначения = Неопределено
		ИЛИ ПроверяемыеЗначения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Вид доступа задаётся значением того же типа, поэтому проверяемые значения можно
	// сравнивать с настройками напрямую. Для типов, которые видами доступа не описываются
	// (сотрудники, номенклатура и т. п.), функция не применяется.
	Если Метаданные.НайтиПоТипу(ТипЗначения) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Вид доступа, отключённый в базе, ограничений не создаёт: настройки по нему платформа
	// не применяет. Отключение распознаём только по явной записи регистра БСП - если
	// регистр не заполнен, вид доступа считаем действующим.
	Попытка
		ВидДоступаОтключен = ВидДоступаОтключенВбазе(ТипЗначения, ПроверяемыеЗначения[0]);
	Исключение
		ВидДоступаОтключен = Ложь;
	КонецПопытки;
	Если ВидДоступаОтключен Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Проверяются только значения из выборки: запрашивать все значения справочников
	// (физических лиц, например) целиком дорого.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ТипЗначения);

	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("Значение", Новый ОписаниеТипов(МассивТипов));
	Для Каждого Значение Из ПроверяемыеЗначения Цикл
		СтрокаКандидата = Кандидаты.Добавить();
		СтрокаКандидата.Значение = Значение;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", СсылкаПользователя);
	Запрос.УстановитьПараметр("Кандидаты", Кандидаты);
	Запрос.УстановитьПараметр("ЗначениеТипа", ПроверяемыеЗначения[0]);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кандидаты.Значение КАК Значение
	|ПОМЕСТИТЬ КандидатыЗначения
	|ИЗ
	|	&Кандидаты КАК Кандидаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ГруппыДоступаПользователя
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|ГДЕ
	|	ГруппыДоступаПользователи.Пользователь = &Пользователь
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГруппыДоступаПользователи.Ссылка
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
	|		ПО СоставыГруппПользователей.Пользователь = &Пользователь
	|			И СоставыГруппПользователей.ГруппаПользователей = ГруппыДоступаПользователи.Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	КандидатыЗначения.Значение КАК Значение,
	|	ВЫБОР
	|		КОГДА ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					ГруппыДоступаПользователя КАК ГруппыДоступаНастроек
	|				ГДЕ
	|					ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							РегистрСведений.ЗначенияГруппДоступаПоУмолчанию КАК ЗначенияПоУмолчаниюНастроек
	|						ГДЕ
	|							ЗначенияПоУмолчаниюНастроек.ГруппаДоступа = ГруппыДоступаНастроек.Ссылка
	|							И ТИПЗНАЧЕНИЯ(ЗначенияПоУмолчаниюНастроек.ТипЗначенийДоступа) = ТИПЗНАЧЕНИЯ(&ЗначениеТипа)
	|							И ЗначенияПоУмолчаниюНастроек.ВсеРазрешены = ЛОЖЬ)
	|					ИЛИ ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							РегистрСведений.ЗначенияГруппДоступа КАК ЗначенияНастроек
	|						ГДЕ
	|							ЗначенияНастроек.ГруппаДоступа = ГруппыДоступаНастроек.Ссылка
	|							И ТИПЗНАЧЕНИЯ(ЗначенияНастроек.ЗначениеДоступа) = ТИПЗНАЧЕНИЯ(&ЗначениеТипа)))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТипОграничен
	|ИЗ
	|	КандидатыЗначения КАК КандидатыЗначения
	|ГДЕ
	|	ИСТИНА В
	|		(ВЫБРАТЬ ПЕРВЫЕ 1
	|			ИСТИНА
	|		ИЗ
	|			ГруппыДоступаПользователя КАК ГруппыДоступа
	|		ГДЕ
	|			ВЫБОР
	|				КОГДА ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							РегистрСведений.ЗначенияГруппДоступа КАК Значения
	|						ГДЕ
	|							Значения.ГруппаДоступа = ГруппыДоступа.Ссылка
	|							И Значения.ЗначениеДоступа = КандидатыЗначения.Значение
	|
	|						ОБЪЕДИНИТЬ ВСЕ
	|
	|						ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							РегистрСведений.ЗначенияГруппДоступа КАК Значения
	|								ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГруппыЗначенийДоступа КАК ГруппыЗначений
	|								ПО
	|									Значения.ГруппаДоступа = ГруппыДоступа.Ссылка
	|									И Значения.ЗначениеДоступа = ГруппыЗначений.ГруппаЗначенийДоступа
	|									И ГруппыЗначений.ЗначениеДоступа = КандидатыЗначения.Значение)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|			=
	|			ВЫБОР
	|				КОГДА ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							РегистрСведений.ЗначенияГруппДоступаПоУмолчанию КАК ЗначенияПоУмолчанию
	|						ГДЕ
	|							ЗначенияПоУмолчанию.ГруппаДоступа = ГруппыДоступа.Ссылка
	|							И ТИПЗНАЧЕНИЯ(ЗначенияПоУмолчанию.ТипЗначенийДоступа) = ТИПЗНАЧЕНИЯ(КандидатыЗначения.Значение)
	|							И ЗначенияПоУмолчанию.ВсеРазрешены = ЛОЖЬ)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)";

	Попытка
		Выборка = Запрос.Выполнить().Выгрузить();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьВЛогVibeCode("Права", "Ошибка", "getData",
			"Не удалось собрать ограничения по группам доступа ("
			+ Строка(ТипЗначения) + "): " + Лев(ТекстОшибки, 400));
		// Ошибку разбора настроек доступа не превращаем в сокрытие всех строк: доступ
		// к данным уже проверен по ролям пользователя (ПроверитьПраваНаТекстЗапроса).
		Возврат Неопределено;
	КонецПопытки;

	Разрешенные = Новый Соответствие;
	ТипОграничен = Ложь;
	Для Каждого СтрокаВыборки Из Выборка Цикл
		Разрешенные.Вставить(СтрокаВыборки.Значение, Истина);
		Если СтрокаВыборки.ТипОграничен Тогда
			ТипОграничен = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Разрешенные, Ограничен", Разрешенные, ТипОграничен);

КонецФункции

// Возвращает Истина, если вид доступа с указанным типом значений отключён в базе.
//
// Использование видов доступа ведёт подсистема УправлениеДоступом в регистре сведений
// ИспользуемыеВидыДоступа (в ЗУП, например, вид доступа «Группы физических лиц»
// отключается константой ОграничиватьДоступНаУровнеЗаписейФизическиеЛица). Настройки
// значений в группах доступа при этом сохраняются, но платформа их не применяет -
// иначе отключение вида доступа не давало бы эффекта.
//
// Параметры:
//  ТипЗначения         - Тип - тип значения доступа.
//  ЗначениеДляТипа     - ЛюбаяСсылка - любое значение этого типа (нужно, чтобы запрос
//                        сравнил тип значения с типом, записанным в регистре).
//
// Возвращаемое значение:
//  Булево
//
Функция ВидДоступаОтключенВбазе(ТипЗначения, ЗначениеДляТипа) Экспорт

	Если Метаданные.НайтиПоПолномуИмени("РегистрСведений.ИспользуемыеВидыДоступа") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗначениеТипа", ЗначениеДляТипа);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИспользуемыеВидыДоступа.Используется КАК Используется
	|ИЗ
	|	РегистрСведений.ИспользуемыеВидыДоступа КАК ИспользуемыеВидыДоступа
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ИспользуемыеВидыДоступа.ТипЗначенийДоступа) = ТИПЗНАЧЕНИЯ(&ЗначениеТипа)";

	Выборка = Запрос.Выполнить().Выбрать();

	ЕстьЗаписи = Ложь;
	ВидИспользуется = Ложь;
	Пока Выборка.Следующий() Цикл
		ЕстьЗаписи = Истина;
		Если Выборка.Используется Тогда
			ВидИспользуется = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Отключённым считаем вид доступа, по которому записи есть, но ни одна не помечена
	// как используемая. Если записей нет вовсе, настройки вида доступа продолжаем применять.
	Возврат ЕстьЗаписи И НЕ ВидИспользуется;

КонецФункции

// Возвращает Истина, если хотя бы один из типов колонки входит в ограничиваемые типы.
//
// Параметры:
//  ОписаниеТипа       - ОписаниеТипов - тип колонки таблицы значений.
//  ТипыСОграничениями - Соответствие - ограничиваемые типы (Ключ - Тип, Значение - Истина).
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоТипСОграничениями(ОписаниеТипа, ТипыСОграничениями) Экспорт

	Если ОписаниеТипа = Неопределено ИЛИ ТипыСОграничениями = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ТипКолонки Из ОписаниеТипа.Типы() Цикл
		Если ТипыСОграничениями.Получить(ТипКолонки) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает сотрудников выборки, доступных портальному пользователю, или Неопределено,
// если проверка по сотрудникам не требуется.
//
// Отдельного вида доступа по сотрудникам в БСП нет: кадровые данные ограничиваются по
// физическим лицам, организациям и подразделениям. Для сотрудников выборки берутся их
// физическое лицо и головная организация (реквизиты справочника) и подразделение
// кадровой истории; каждое значение проверяется набором разрешённых значений своего типа.
// Сотрудник остаётся в ответе, если доступны все его проверяемые значения.
//
// Параметры:
//  Таблица            - ТаблицаЗначений - выборка инструмента (колонки _ПраваДоступа).
//  СсылкаПользователя - СправочникСсылка.Пользователи.
//
// Возвращаемое значение:
//  Неопределено - сотрудников в выборке нет либо проверять их не по чему;
//  Структура:
//   * Тип       - Тип - тип колонок со сотрудниками;
//   * Доступные - Соответствие - доступные сотрудники (Ключ - сотрудник, Значение - Истина).
//
// Добавляет в набор доступных значения, которые платформа разрешает через собственный набор
// значений доступа объекта. Регистр сведений НаборыЗначенийДоступа - материализованная форма
// табличной части «НаборыЗначенийДоступа» тех объектов, для которых определена процедура
// ЗаполнитьНаборыЗначенийДоступа (см. УправлениеДоступом.ТаблицаНаборыЗначенийДоступа).
//
// Правило взято из шаблона ограничения доступа ролей: объект доступен, если найдётся его набор
// для права чтения (Чтение = Истина), все значения которого разрешены пользователю. Значение
// ДополнительныеЗначенияДоступа.ДоступРазрешен набор подтверждает, ДоступЗапрещен - отменяет.
// Наборы с уточнением (табличные права), со значением-идентификатором метаданных, а также с
// признаками «стандартное значение» и «значение без групп» не разбираются: сомнение трактуется
// как «не разрешено», иначе порталу могла бы уйти строка, которую 1С не показывает.
//
// Параметры:
//  СсылкиПоТипам            - Соответствие - проверяемые значения выборки по типам.
//  СсылкаПользователя       - СправочникСсылка.Пользователи - портальный пользователь.
//  РазрешенныеДополнительно - Соответствие - дополняется доступными значениями.
//
Процедура ДобавитьДоступныеПоНаборамЗначенийДоступа(СсылкиПоТипам, СсылкаПользователя,
	РазрешенныеДополнительно) Экспорт

	Если Метаданные.НайтиПоПолномуИмени("РегистрСведений.НаборыЗначенийДоступа") = Неопределено Тогда
		Возврат; // В базе механизма нет - фильтр работает как раньше.
	КонецЕсли;

	// Строки регистра по проверяемым объектам: Объект -> НомерНабора -> строки набора.
	НаборыПоОбъектам = Новый Соответствие;
	ЗначенияНаборов = Новый Массив;
	Для Каждого КлючИЗначение Из СсылкиПоТипам Цикл
		Если Метаданные.НайтиПоТипу(КлючИЗначение.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			СтрокиРегистра = СтрокиНаборовЗначенийДоступа(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		Исключение
			ТекстОшибкиНаборов = ОписаниеОшибки();
			ЗаписатьВЛогVibeCode("Права", "Ошибка", "getData",
				"Не удалось прочитать наборы значений доступа ("
				+ Строка(КлючИЗначение.Ключ) + "): " + Лев(ТекстОшибкиНаборов, 300));
			СтрокиРегистра = Новый ТаблицаЗначений;
		КонецПопытки;
		Для Каждого СтрокаРегистра Из СтрокиРегистра Цикл
			НаборыОбъекта = НаборыПоОбъектам.Получить(СтрокаРегистра.Объект);
			Если НаборыОбъекта = Неопределено Тогда
				НаборыОбъекта = Новый Соответствие;
				НаборыПоОбъектам.Вставить(СтрокаРегистра.Объект, НаборыОбъекта);
			КонецЕсли;
			СтрокиНабора = НаборыОбъекта.Получить(СтрокаРегистра.НомерНабора);
			Если СтрокиНабора = Неопределено Тогда
				СтрокиНабора = Новый Массив;
				НаборыОбъекта.Вставить(СтрокаРегистра.НомерНабора, СтрокиНабора);
			КонецЕсли;
			СтрокиНабора.Добавить(СтрокаРегистра);
			ЗначенияНаборов.Добавить(СтрокаРегистра.ЗначениеДоступа);
		КонецЦикла;
	КонецЦикла;

	Если НаборыПоОбъектам.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Значения наборов проверяются теми же настройками групп доступа, что и значения выборки.
	ТипыЗначенийНаборов = Новый Соответствие;
	Для Каждого ЗначениеНабора Из ЗначенияНаборов Цикл
		Если НЕ ЭтоСсылочноеЗначение(ЗначениеНабора) Тогда
			Продолжить; // Служебные значения разбираются по типу в проверке набора.
		КонецЕсли;
		Если ЗначениеНабора.Метаданные().ПолноеИмя() = "Справочник.ИдентификаторыОбъектовМетаданных" Тогда
			Продолжить;
		КонецЕсли;
		МножествоЗначений = ТипыЗначенийНаборов.Получить(ТипЗнч(ЗначениеНабора));
		Если МножествоЗначений = Неопределено Тогда
			МножествоЗначений = Новый Массив;
			ТипыЗначенийНаборов.Вставить(ТипЗнч(ЗначениеНабора), МножествоЗначений);
		КонецЕсли;
		Если МножествоЗначений.Найти(ЗначениеНабора) = Неопределено Тогда
			МножествоЗначений.Добавить(ЗначениеНабора);
		КонецЕсли;
	КонецЦикла;

	РазрешенныеЗначенияНаборов = Новый Соответствие;
	Для Каждого КлючИЗначение Из ТипыЗначенийНаборов Цикл
		Попытка
			РезультатПоТипу = РазрешенныеЗначенияТипаПоГруппамДоступа(КлючИЗначение.Ключ,
				СсылкаПользователя, КлючИЗначение.Значение);
		Исключение
			РезультатПоТипу = Неопределено;
		КонецПопытки;
		Если РезультатПоТипу = Неопределено Тогда
			// Тип настройками групп доступа не описывается: подтвердить значения набора нечем,
			// набор доступа не даёт.
			Продолжить;
		КонецЕсли;
		Для Каждого РазрешенноеЗначение Из РезультатПоТипу.Разрешенные Цикл
			РазрешенныеЗначенияНаборов.Вставить(РазрешенноеЗначение.Ключ, Истина);
		КонецЦикла;
	КонецЦикла;

	// Тип служебного перечисления наборов доступа берётся по имени: расширенная проверка модулей
	// разбирает литералы только в вызовах платформы, поэтому «Возможно ошибочный параметр» не появляется.
	ТипЗначенияДоступа = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ПеречислениеСсылка.ДополнительныеЗначенияДоступа");

	// Объект доступен, если хотя бы один его набор для чтения подтверждён целиком.
	НаборовПодтверждено = 0;
	Для Каждого КлючИЗначение Из НаборыПоОбъектам Цикл
		Для Каждого Набор Из КлючИЗначение.Значение Цикл
			НаборПодтвержден = Истина;
			Для Каждого СтрокаНабора Из Набор.Значение Цикл
				Если СтрокаНабора.ЭтоУточнение ИЛИ СтрокаНабора.ЗначениеБезГрупп
					ИЛИ СтрокаНабора.СтандартноеЗначение Тогда
					НаборПодтвержден = Ложь;
					Прервать;
				КонецЕсли;
				ЗначениеНабора = СтрокаНабора.ЗначениеДоступа;
				Если ТипЗначенияДоступа <> Неопределено И ТипЗнч(ЗначениеНабора) = ТипЗначенияДоступа Тогда
					Если ЗначениеНабора = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Перечисление.ДополнительныеЗначенияДоступа.ДоступЗапрещен") Тогда
						НаборПодтвержден = Ложь;
						Прервать;
					ИначеЕсли ЗначениеНабора = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Перечисление.ДополнительныеЗначенияДоступа.ДоступРазрешен") Тогда
						Продолжить; // Служебное значение набор подтверждает.
					КонецЕсли;
				КонецЕсли;
				Если РазрешенныеЗначенияНаборов.Получить(ЗначениеНабора) = Неопределено Тогда
					НаборПодтвержден = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НаборПодтвержден Тогда
				РазрешенныеДополнительно.Вставить(КлючИЗначение.Ключ, Истина);
				НаборовПодтверждено = НаборовПодтверждено + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ЗаписатьВЛогVibeCode("Права", "Наборы", "getData",
		"объектов с наборами значений доступа: " + НаборыПоОбъектам.Количество()
		+ ", объектов подтверждено: " + НаборовПодтверждено
		+ ", значений в наборах проверено: " + ЗначенияНаборов.Количество());

КонецПроцедуры

// Возвращает строки регистра сведений НаборыЗначенийДоступа по проверяемым объектам для права
// чтения. Значения передаются таблицей в параметре, поэтому сначала помещаются во временную
// таблицу: выбирать таблицу значений параметром в результирующем запросе пакета платформа
// не позволяет («Содержимое объекта данных может быть выбрано только во временную таблицу»).
//
// Параметры:
//  ТипЗначения         - Тип - тип проверяемых значений.
//  ПроверяемыеЗначения - Массив - значения выборки указанного типа.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Объект, НомерНабора, ЗначениеДоступа - как в регистре;
//   * ЭтоУточнение - Булево - набор уточнён (табличные права), такой набор не разбирается;
//   * ЗначениеБезГрупп, СтандартноеЗначение - Булево - признаки особых наборов.
//
Функция СтрокиНаборовЗначенийДоступа(ТипЗначения, ПроверяемыеЗначения) Экспорт

	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ТипЗначения);
	Кандидаты = Новый ТаблицаЗначений;
	Кандидаты.Колонки.Добавить("Значение", Новый ОписаниеТипов(МассивТипов));
	Для Каждого Значение Из ПроверяемыеЗначения Цикл
		СтрокаКандидата = Кандидаты.Добавить();
		СтрокаКандидата.Значение = Значение;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Кандидаты", Кандидаты);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кандидаты.Значение КАК Значение
	|ПОМЕСТИТЬ КандидатыЗначения
	|ИЗ
	|	&Кандидаты КАК Кандидаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	КандидатыЗначения.Значение КАК Объект,
	|	Наборы.НомерНабора КАК НомерНабора,
	|	Наборы.ЗначениеДоступа КАК ЗначениеДоступа,
	|	Наборы.ЗначениеБезГрупп КАК ЗначениеБезГрупп,
	|	Наборы.СтандартноеЗначение КАК СтандартноеЗначение,
	|	ВЫБОР
	|		КОГДА Наборы.Уточнение = ЗНАЧЕНИЕ(Справочник.ИдентификаторыОбъектовМетаданных.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоУточнение
	|ИЗ
	|	КандидатыЗначения КАК КандидатыЗначения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НаборыЗначенийДоступа КАК Наборы
	|		ПО Наборы.Объект = КандидатыЗначения.Значение
	|ГДЕ
	|	Наборы.Чтение";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Добавляет в набор доступных значения, права на которые настроены для объекта напрямую
// (регистры НастройкиПравОбъектов и НаследованиеНастроекПравОбъектов). Проверку выполняет
// сама БСП: УправлениеДоступом.ЕстьПраво учитывает разрешающие и запрещающие настройки по всей
// иерархии объектов. Свой разбор нужен потому, что штатная УправлениеДоступом.ЧтениеРазрешено
// в стандартном варианте ограничения доступа для другого пользователя вызывает исключение.
//
// Права объекта настраиваются не для всех типов: список возможных прав даёт БСП
// (УправлениеДоступомСлужебный.ВозможныеПраваДляНастройкиПравОбъектов). Для типов из списка
// проверяется право «Чтение».
//
// Параметры:
//  СсылкиПоТипам            - Соответствие - проверяемые значения выборки по типам.
//  СсылкаПользователя       - СправочникСсылка.Пользователи - портальный пользователь.
//  РазрешенныеДополнительно - Соответствие - дополняется доступными значениями.
//
Процедура ДобавитьДоступныеПоНастройкамПравОбъектов(СсылкиПоТипам, СсылкаПользователя,
	РазрешенныеДополнительно) Экспорт

	Если Метаданные.НайтиПоПолномуИмени("РегистрСведений.НастройкиПравОбъектов") = Неопределено Тогда
		Возврат; // В базе механизма нет - фильтр работает как раньше.
	КонецЕсли;

	Попытка
		ВозможныеПраваПоТипам = УправлениеДоступомСлужебный.ВозможныеПраваДляНастройкиПравОбъектов().ПоТипам;
	Исключение
		Возврат; // Подсистема настройки прав недоступна - механизм не применяется.
	КонецПопытки;
	Если ВозможныеПраваПоТипам = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПровереноЗначений = 0;
	Разрешено = 0;
	Для Каждого КлючИЗначение Из СсылкиПоТипам Цикл
		ОписаниеПрав = ВозможныеПраваПоТипам.Получить(КлючИЗначение.Ключ);
		Если ОписаниеПрав = Неопределено ИЛИ ОписаниеПрав.Получить("Чтение") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Значение Из КлючИЗначение.Значение Цикл
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				Продолжить;
			КонецЕсли;
			ПровереноЗначений = ПровереноЗначений + 1;
			Попытка
				Если УправлениеДоступом.ЕстьПраво("Чтение", Значение, СсылкаПользователя) Тогда
					РазрешенныеДополнительно.Вставить(Значение, Истина);
					Разрешено = Разрешено + 1;
				КонецЕсли;
			Исключение
				// Сомнение трактуется как «не разрешено».
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

	Если ПровереноЗначений > 0 Тогда
		ЗаписатьВЛогVibeCode("Права", "НастройкиПрав", "getData",
			"значений с настраиваемыми правами: " + ПровереноЗначений
			+ ", из них разрешено: " + Разрешено);
	КонецЕсли;

КонецПроцедуры

Функция ДоступныеСотрудникиВыборки(Таблица, СсылкаПользователя) Экспорт

	МетаданныеСотрудников = Метаданные.НайтиПоПолномуИмени("Справочник.Сотрудники");
	Если МетаданныеСотрудников = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ТипСотрудники = Тип("СправочникСсылка.Сотрудники");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТипСотрудники = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	СотрудникиВыборки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = СтрокаТаблицы[Колонка.Имя];
			Если ТипЗнч(Значение) = ТипСотрудники
				И СотрудникиВыборки.Найти(Значение) = Неопределено Тогда
				СотрудникиВыборки.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если СотрудникиВыборки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Проверка повторяет ограничение доступа роли на справочник Сотрудники:
	//   #ПоЗначениямРасширенный("Справочник.Сотрудники","Чтение","",
	//     "ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОрганизацииВКоторыхРаботалиСотрудники КАК Т2
	//        ПО Т2.Сотрудник = Т.Ссылка", "",
	//     "Организации","Т2.Организация","и",
	//     "ГруппыФизическихЛиц","Т.ФизическоеЛицо","", ...)
	// Группы соединяются операцией И, внутри вида «Организации» достаточно одной разрешённой
	// организации (строки соединения объединяются по ИЛИ), вид «Подразделения» в ограничении
	// не участвует. Если же регистра ОрганизацииВКоторыхРаботалиСотрудники в базе нет,
	// работает прежний источник — реквизиты сотрудника и кадровая история.
	ЕстьРегистрОрганизацийСотрудников =
		Метаданные.НайтиПоПолномуИмени("РегистрСведений.ОрганизацииВКоторыхРаботалиСотрудники") <> Неопределено
		И Метаданные.НайтиПоПолномуИмени("Справочник.Организации") <> Неопределено;

	// Какие значения сотрудника проверяются: реквизиты есть не во всех конфигурациях,
	// поэтому список полей собирается по метаданным. Поле «Набор» помечает значения, которых
	// у сотрудника может быть несколько (организации из регистра).
	Поля = "Сотрудники.Ссылка КАК Сотрудник";
	ВидыЗначений = Новый Массив;

	Если МетаданныеСотрудников.Реквизиты.Найти("ФизическоеЛицо") <> Неопределено Тогда
		ТипФизическихЛиц = Тип("СправочникСсылка.ФизическиеЛица");
		Если ТипФизическихЛиц <> Неопределено Тогда
			Поля = Поля + ",
			|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо";
			ВидыЗначений.Добавить(Новый Структура("Поле, Тип, Набор", "ФизическоеЛицо", ТипФизическихЛиц, Ложь));
		КонецЕсли;
	КонецЕсли;

	СоединениеСИсторией = "";
	Если ЕстьРегистрОрганизацийСотрудников Тогда
		ТипОрганизаций = Тип("СправочникСсылка.Организации");
		Если ТипОрганизаций <> Неопределено Тогда
			ВидыЗначений.Добавить(Новый Структура("Поле, Тип, Набор", "Организации", ТипОрганизаций, Истина));
		КонецЕсли;
	Иначе
		Если МетаданныеСотрудников.Реквизиты.Найти("ГоловнаяОрганизация") <> Неопределено
			И Метаданные.НайтиПоПолномуИмени("Справочник.Организации") <> Неопределено Тогда
			ТипОрганизаций = Тип("СправочникСсылка.Организации");
			Если ТипОрганизаций <> Неопределено Тогда
				Поля = Поля + ",
				|	Сотрудники.ГоловнаяОрганизация КАК Организация";
				ВидыЗначений.Добавить(Новый Структура("Поле, Тип, Набор", "Организация", ТипОрганизаций, Ложь));
			КонецЕсли;
		КонецЕсли;

		Если Метаданные.НайтиПоПолномуИмени("РегистрСведений.КадроваяИсторияСотрудников") <> Неопределено
			И Метаданные.НайтиПоПолномуИмени("Справочник.ПодразделенияОрганизаций") <> Неопределено Тогда
			ТипПодразделений = Тип("СправочникСсылка.ПодразделенияОрганизаций");
			Если ТипПодразделений <> Неопределено Тогда
				Поля = Поля + ",
				|	КадроваяИстория.Подразделение КАК Подразделение";
				СоединениеСИсторией =
				"
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(, ) КАК КадроваяИстория
				|		ПО КадроваяИстория.Сотрудник = Сотрудники.Ссылка";
				ВидыЗначений.Добавить(Новый Структура("Поле, Тип, Набор", "Подразделение", ТипПодразделений, Ложь));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если ВидыЗначений.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСотрудников", СотрудникиВыборки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + Поля + "
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники" + СоединениеСИсторией + "
	|ГДЕ
	|	Сотрудники.Ссылка В (&СписокСотрудников)";

	Попытка
		ЗначенияСотрудников = Запрос.Выполнить().Выгрузить();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьВЛогVibeCode("Права", "Ошибка", "getData",
			"Не удалось получить значения сотрудников для проверки прав: "
			+ Лев(ТекстОшибки, 400));
		Возврат Неопределено;
	КонецПопытки;

	// Организации, в которых работал сотрудник: проверяемый сотрудник может быть разрешён
	// по любой из них.
	ОрганизацииСотрудников = Новый Соответствие;
	Если ЕстьРегистрОрганизацийСотрудников Тогда
		ЗапросОрганизаций = Новый Запрос;
		ЗапросОрганизаций.УстановитьПараметр("СписокСотрудников", СотрудникиВыборки);
		ЗапросОрганизаций.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОрганизацииСотрудников.Сотрудник КАК Сотрудник,
		|	ОрганизацииСотрудников.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.ОрганизацииВКоторыхРаботалиСотрудники КАК ОрганизацииСотрудников
		|ГДЕ
		|	ОрганизацииСотрудников.Сотрудник В (&СписокСотрудников)";

		Попытка
			ВыборкаОрганизаций = ЗапросОрганизаций.Выполнить().Выгрузить();
		Исключение
			ТекстОшибкиОрганизаций = ОписаниеОшибки();
			ЗаписатьВЛогVibeCode("Права", "Ошибка", "getData",
				"Не удалось получить организации сотрудников для проверки прав: "
				+ Лев(ТекстОшибкиОрганизаций, 400));
			ВыборкаОрганизаций = Новый ТаблицаЗначений;
		КонецПопытки;
		Для Каждого СтрокаОрганизации Из ВыборкаОрганизаций Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаОрганизации.Организация) Тогда
				Продолжить;
			КонецЕсли;
			МассивОрганизаций = ОрганизацииСотрудников.Получить(СтрокаОрганизации.Сотрудник);
			Если МассивОрганизаций = Неопределено Тогда
				МассивОрганизаций = Новый Массив;
				ОрганизацииСотрудников.Вставить(СтрокаОрганизации.Сотрудник, МассивОрганизаций);
			КонецЕсли;
			Если МассивОрганизаций.Найти(СтрокаОрганизации.Организация) = Неопределено Тогда
				МассивОрганизаций.Добавить(СтрокаОрганизации.Организация);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	РазрешенныеЗначения = Новый Соответствие;
	ПоляСОграничениями = Новый Соответствие;
	Для Каждого ВидЗначения Из ВидыЗначений Цикл
		ПроверяемыеЗначения = Новый Массив;
		Для Каждого СтрокаЗначений Из ЗначенияСотрудников Цикл
			Если ВидЗначения.Набор Тогда
				МассивОрганизаций = ОрганизацииСотрудников.Получить(СтрокаЗначений.Сотрудник);
				Если МассивОрганизаций = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого ОрганизацияСотрудника Из МассивОрганизаций Цикл
					Если ПроверяемыеЗначения.Найти(ОрганизацияСотрудника) = Неопределено Тогда
						ПроверяемыеЗначения.Добавить(ОрганизацияСотрудника);
					КонецЕсли;
				КонецЦикла;
				Продолжить;
			КонецЕсли;
			Значение = СтрокаЗначений[ВидЗначения.Поле];
			Если ЗначениеЗаполнено(Значение)
				И ПроверяемыеЗначения.Найти(Значение) = Неопределено Тогда
				ПроверяемыеЗначения.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
		РезультатПоВиду = РазрешенныеЗначенияТипаПоГруппамДоступа(ВидЗначения.Тип, СсылкаПользователя, ПроверяемыеЗначения);
		Если РезультатПоВиду = Неопределено ИЛИ НЕ РезультатПоВиду.Ограничен Тогда
			// По этому значению ограничений нет (или их не удалось собрать) - не проверяем
			// его вовсе, иначе сотрудник был бы скрыт из-за отсутствия набора.
			Продолжить;
		КонецЕсли;
		ПоляСОграничениями.Вставить(ВидЗначения.Поле, Истина);
		Для Каждого КлючИЗначение Из РезультатПоВиду.Разрешенные Цикл
			РазрешенныеЗначения.Вставить(КлючИЗначение.Ключ, Истина);
		КонецЦикла;
	КонецЦикла;

	Если ПоляСОграничениями.Количество() = 0 Тогда
		// Ни одно значение сотрудников не ограничено - проверять нечего.
		Возврат Неопределено;
	КонецЕсли;

	Доступные = Новый Соответствие;
	Для Каждого СтрокаЗначений Из ЗначенияСотрудников Цикл
		СотрудникДоступен = Истина;
		Для Каждого ВидЗначения Из ВидыЗначений Цикл
			Если ПоляСОграничениями.Получить(ВидЗначения.Поле) = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если ВидЗначения.Набор Тогда
				// Организации сотрудника: по ограничению роли достаточно одной разрешённой.
				// Сотрудник без организаций в регистре ограничению не удовлетворяет.
				ЕстьРазрешеннаяОрганизация = Ложь;
				МассивОрганизаций = ОрганизацииСотрудников.Получить(СтрокаЗначений.Сотрудник);
				Если МассивОрганизаций <> Неопределено Тогда
					Для Каждого ОрганизацияСотрудника Из МассивОрганизаций Цикл
						Если РазрешенныеЗначения.Получить(ОрганизацияСотрудника) <> Неопределено Тогда
							ЕстьРазрешеннаяОрганизация = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ ЕстьРазрешеннаяОрганизация Тогда
					СотрудникДоступен = Ложь;
					Прервать;
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Значение = СтрокаЗначений[ВидЗначения.Поле];
			Если НЕ ЗначениеЗаполнено(Значение) Тогда
				Продолжить;
			КонецЕсли;
			Если РазрешенныеЗначения.Получить(Значение) = Неопределено Тогда
				СотрудникДоступен = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СотрудникДоступен Тогда
			Доступные.Вставить(СтрокаЗначений.Сотрудник, Истина);
		КонецЕсли;
	КонецЦикла;

	ЗаписатьВЛогVibeCode("Права", "Сотрудники", "getData",
		"сотрудников проверено: " + ЗначенияСотрудников.Количество()
		+ ", доступно: " + Доступные.Количество()
		+ ", источник организаций: " + ?(ЕстьРегистрОрганизацийСотрудников,
			"регистр ОрганизацииВКоторыхРаботалиСотрудники", "реквизиты и кадровая история"));

	Возврат Новый Структура("Тип, Доступные", ТипСотрудники, Доступные);

КонецФункции

// ===== Программная проверка прав ролей пользователя =====
// Сменить пользователя сеанса в 1С нельзя, а глобальная ПравоДоступа("Чтение", Объект)
// проверяет только ТЕКУЩЕГО пользователя. Поэтому право проверяется по РОЛЯМ
// пользователя информационной базы: для каждой таблицы запроса берётся объект
// метаданных, и для каждой роли пользователя проверяется ПравоДоступа(Право, Объект,
// Роль). Пользователь допускается, если хотя бы одна его роль даёт право "Чтение".

// Проверяет, что у пользователя (ссылка справочника «Пользователи») есть право
// чтения каждой таблицы запроса. Возвращает "" если есть, иначе текст ошибки.
Функция ПроверитьПраваНаТекстЗапроса(СсылкаПользователя, ТекстЗапроса) Экспорт

	Если НЕ ЗначениеЗаполнено(СсылкаПользователя) Тогда
		Возврат "Пользователь 1С не найден";
	КонецЕсли;

#Если Сервер Тогда

	ПользовательИБ = ПользовательИнформационнойБазыПоСсылке(СсылкаПользователя);
	Если ПользовательИБ = Неопределено Тогда
		Возврат "У пользователя 1С нет учётной записи информационной базы";
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ОбъектыМетаданных = ОбъектыМетаданныхИзТекстаЗапроса(ТекстЗапроса);
		Для Каждого ОбъектМетаданных Из ОбъектыМетаданных Цикл
			Если НЕ ПользовательИмеетПравоЧтения(ПользовательИБ, ОбъектМетаданных) Тогда
				Возврат "У пользователя 1С нет права чтения таблицы " + ОбъектМетаданных.ПолноеИмя();
			КонецЕсли;
		КонецЦикла;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Возврат "Не удалось проверить права: " + ТекстОшибки;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

#Иначе
	// На клиенте проверка прав ролей недоступна (нет пользователя ИБ).
	Возврат "";
#КонецЕсли

	Возврат "";

КонецФункции

// Возвращает пользователя информационной базы по ссылке справочника «Пользователи».
Функция ПользовательИнформационнойБазыПоСсылке(СсылкаПользователя) Экспорт

	Если НЕ ЗначениеЗаполнено(СсылкаПользователя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Пользователи.НайтиПоСсылке(СсылкаПользователя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Собирает объекты метаданных таблиц, упомянутых в тексте запроса.
Функция ОбъектыМетаданныхИзТекстаЗапроса(ТекстЗапроса) Экспорт

	Результат = Новый Массив;
	ИменаТаблиц = ИменаТаблицИзТекстаЗапроса(ТекстЗапроса);
	УжеДобавлены = Новый Соответствие;
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		Ключ = НРег(ИмяТаблицы);
		Если УжеДобавлены.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоПолномуИмени(ИмяТаблицы);
		Если НЕ ОбъектМетаданных = Неопределено Тогда
			Результат.Добавить(ОбъектМетаданных);
			УжеДобавлены.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Извлекает полные имена таблиц из текста запроса (Справочник.Х, Документ.Х и т.д.).
Функция ИменаТаблицИзТекстаЗапроса(ТекстЗапроса) Экспорт

	Результат = Новый Массив;
	Префиксы = Новый Массив;
	Префиксы.Добавить("Справочник.");
	Префиксы.Добавить("Документ.");
	Префиксы.Добавить("РегистрСведений.");
	Префиксы.Добавить("РегистрНакопления.");
	Префиксы.Добавить("РегистрБухгалтерии.");
	Префиксы.Добавить("ПланВидовХарактеристик.");
	Префиксы.Добавить("ПланСчетов.");
	Префиксы.Добавить("ПланВидовРасчета.");
	Префиксы.Добавить("БизнесПроцесс.");
	Префиксы.Добавить("Задача.");
	Префиксы.Добавить("Константа.");
	Префиксы.Добавить("Перечисление.");

	// Поиск ведём по «остатку» строки через СтрНайти(Строка, Подстрока) и Сред:
	// 3-й параметр (начальная позиция) у СтрНайти в платформе 8.5 недоступен.
	Для Каждого Префикс Из Префиксы Цикл
		ЧастьТекста = ТекстЗапроса;
		Пока Истина Цикл
			ПозицияПрефикса = СтрНайти(ЧастьТекста, Префикс);
			Если ПозицияПрефикса = 0 Тогда
				Прервать;
			КонецЕсли;
			ПозицияИмени = ПозицияПрефикса + СтрДлина(Префикс);
			ИмяТаблицы = "";
			ПозицияСимвола = ПозицияИмени;
			Пока ПозицияСимвола <= СтрДлина(ЧастьТекста) Цикл
				Символ = Сред(ЧастьТекста, ПозицияСимвола, 1);
				Если Символ = " " Или Символ = Символы.ПС Или Символ = Символы.ВК
					Или Символ = "." Или Символ = "," Или Символ = "(" Или Символ = ")"
					Или Символ = "=" Или Символ = "<" Или Символ = ">" Или Символ = ";"
					Или Символ = "[" Или Символ = "]" Тогда
					Прервать;
				КонецЕсли;
				ИмяТаблицы = ИмяТаблицы + Символ;
				ПозицияСимвола = ПозицияСимвола + 1;
			КонецЦикла;
			Если НЕ ПустаяСтрока(ИмяТаблицы) Тогда
				Результат.Добавить(Префикс + ИмяТаблицы);
			КонецЕсли;
			// Отрезаем начало до конца имени таблицы, иначе зациклимся на том же вхождении.
			До = ПозицияСимвола;
			Осталось = СтрДлина(ЧастьТекста) - До;
			Если Осталось <= 0 Тогда
				Прервать;
			КонецЕсли;
			ЧастьТекста = Сред(ЧастьТекста, До + 1, Осталось);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Таблицы запроса, для которых в базе настроены виды доступа, то есть данные по ним
// ограничиваются правами. Возвращает массив полных имён таблиц.
Функция ТаблицыСОграничениямиДоступа(ОбъектыМетаданных) Экспорт

	Результат = Новый Массив;
	Если ОбъектыМетаданных.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Для Каждого ОбъектМетаданных Из ОбъектыМетаданных Цикл
		Идентификатор = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОбъектМетаданных, Ложь);
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Идентификаторы.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Идентификаторы.ПолноеИмя КАК ПолноеИмя
	|ИЗ
	|	РегистрСведений.ИспользуемыеВидыДоступаПоТаблицам КАК ВидыДоступа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК Идентификаторы
	|		ПО ВидыДоступа.Таблица = Идентификаторы.Ссылка
	|ГДЕ
	|	ВидыДоступа.Таблица В (&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.ПолноеИмя);
		КонецЦикла;
	Исключение
		// Не удалось определить ограничения - считаем, что их нет.
		ТекстОшибкиОграничений = ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Проверяет, размечен ли инструмент для проверки прав доступа.
//
// Ограничения доступа к портальному пользователю платформа применить не может
// (пользователь публикации полноправный, в фоновом задании пользователя нет),
// поэтому строки фильтруются по ссылкам выборки. Если по таблицам запроса в базе
// виды доступа настроены, а ссылок в выборке нет, проверить права не по чему -
// такой инструмент данных не получает.
//
// Возвращает текст отказа или пустую строку, если разметка есть.
Функция ПроверитьРазметкуПравИнструмента(Таблица, ТекстЗапроса) Экспорт

	// Разметкой считаем любую ссылочную колонку выборки: по ней фильтр проверит права.
	// Это дешёвая проверка, поэтому к списку таблиц обращаемся только если ссылок нет.
	ЕстьСсылкиВВыборке = Ложь;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Для Каждого ТипКолонки Из Колонка.ТипЗначения.Типы() Цикл
			Если Метаданные.НайтиПоТипу(ТипКолонки) <> Неопределено Тогда
				ЕстьСсылкиВВыборке = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьСсылкиВВыборке Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьСсылкиВВыборке Тогда
		Возврат "";
	КонецЕсли;

	ТаблицыСОграничениями = ТаблицыСОграничениямиДоступа(
		ОбъектыМетаданныхИзТекстаЗапроса(ТекстЗапроса));
	Если ТаблицыСОграничениями.Количество() = 0 Тогда
		// По таблицам запроса ограничений нет - проверять нечего.
		Возврат "";
	КонецЕсли;

	Возврат "Инструмент не размечен для проверки прав доступа: в выборке нет ни одной ссылки,"
		+ " по которой можно проверить права. Добавьте в запрос поле вида"
		+ " <Таблица>.Ссылка КАК <Имя>" + СуффиксСлужебногоПоля()
		+ " и выполните «Обработать текст запроса». Ограничения доступа настроены"
		+ " для таблиц: " + СтрСоединить(ТаблицыСОграничениями, ", ");

КонецФункции

// Проверяет право чтения объекта метаданных у пользователя ИБ (перебор его ролей).
Функция ПользовательИмеетПравоЧтения(ПользовательИБ, ОбъектМетаданных) Экспорт

	Если ПользовательИБ = Неопределено Или ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Для Каждого Роль Из ПользовательИБ.Роли Цикл
			Если ПравоДоступа("Чтение", ОбъектМетаданных, Роль, Неопределено) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		// Проверка права невозможна - считаем доступа нет (безопасно).
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// POST /getData - выполнение выборки (§5.4).
// Запрос - Соответствие с ключами requestId/method/columns/filters/limit/offset/portal/user.
Функция ВыполнитьGetData(Запрос) Экспорт

	РезультатВыполнения = "success";
	
	ДанныеДляОтвета = Новый Структура;
	ДанныеДляОтвета.Вставить("data"		, Новый Массив);
	ДанныеДляОтвета.Вставить("errors"	, Новый Массив);

	// Заполняется, если инструмент не размечен для проверки прав доступа.
	ОтказПоРазметке = "";
	
	ИИ_ЛимитПередачи = Константы.Б24_ИИ_ЛимитПередачи.Получить();
	
	// Источник запроса: HTTP-сервис передаёт HTTP-запрос (тело читается методом
	// ПолучитьТелоКакСтроку), P&P-задание - уже разобранный payload команды
	// (Соответствие), у которого такого метода нет.
	ЭтоЗапросИзЗадания = (ТипЗнч(Запрос) = Тип("Соответствие"));
	ДанныеJSON = Неопределено;
	ЗапросСтрокой = "";
	Если ЭтоЗапросИзЗадания Тогда
		ДанныеJSON = Запрос;
	Иначе
		ЗапросСтрокой = Запрос.ПолучитьТелоКакСтроку();
	КонецЕсли;	
			
	Попытка     
		
		Если ДанныеJSON = Неопределено Тогда
			СтрокаПараметров = Б24_К_RestApiВызовСервера.РаскодироватьСтрокуСервер(ЗапросСтрокой);	
			ДанныеJSON = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(СтрокаПараметров, Истина);
		КонецЕсли;			
		Если НЕ ЭтоЗапросИзЗадания Тогда
			// Лог HTTP-режима: полный текст входящего запроса от портала.
			// В push-режиме пару запрос/ответ пишет задание (ВыполнитьКомандуИОтправитьРезультат).
			ЗаписатьВЛогVibeCode("HTTP", "Запрос", "getData",
				Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеJSON));
		КонецЕсли;
		
		tool 		= ДанныеJSON.Получить("method");
		Если не ЗначениеЗаполнено(tool) Тогда
			tool 	= ДанныеJSON.Получить("tool");
		КонецЕсли;
		columns 	= ДанныеJSON.Получить("columns");
		filters 	= ДанныеJSON.Получить("filters"); 
				
		Если ТипЗнч(filters) = Тип("Соответствие") Тогда
			Новfilters = Новый Соответствие;
			Для Каждого Фильтр из filters Цикл
				Новfilters.Вставить(нРег(Фильтр.Ключ), Фильтр.Значение);
			КонецЦикла;
			filters = Новfilters;
		КонецЕсли;		
				
		// Проверка прав: VibeCode присылает user.id (GUID) и user.name пользователя 1С,
		// под которым выполняется запрос. Если пользователя нет в базе - доступа нет.
		ПользовательДанные = ДанныеJSON.Получить("user");
		ГуидПользователя = "";
		Если ТипЗнч(ПользовательДанные) = Тип("Соответствие") Тогда
			ГуидПользователя = Строка(ПользовательДанные.Получить("id"));
		КонецЕсли;
		Если НЕ ПользовательИмеетДоступ(ГуидПользователя) Тогда
			ДанныеДляОтвета.errors.Добавить(Новый Структура(
				"code, message",
				"ACCESS_DENIED",
				"У вас нет доступа: пользователь 1С не найден в информационной базе"));
			РезультатВыполнения = "failure";
		КонецЕсли;

		НайденныйИнструмент = Справочники.Б24_ИИ_ИнструментыVibeCode.НайтиПоНаименованию(tool, Истина);
		Если НЕ ЗначениеЗаполнено(НайденныйИнструмент) Тогда
			НайденныйИнструмент = Справочники.Б24_ИИ_ИнструментыVibeCode.НайтиПоРеквизиту("ПолноеНаименование",tool);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НайденныйИнструмент) Тогда			
			ДанныеДляОтвета.errors.Добавить(Новый Структура(
				"code, message",
				"ONEC_ERROR",
				"Не найден инструмент в 1С. Был произведен поиск по:" + tool));
			РезультатВыполнения = "failure";
		КонецЕсли;
				
		Если РезультатВыполнения = "success" Тогда

			Запрос = Новый Запрос;
			Запрос.Текст = НайденныйИнструмент.ТекстЗапроса;

			// Права на таблицы запроса проверяем до выполнения: отказ должен быть явным
			// (пустые данные и описание в errors), а не технической ошибкой выполнения.
			// Проверка идёт по ролям учётной записи портального пользователя.
			ОшибкаПравНаТаблицы = ПроверитьПраваНаТекстЗапроса(
				СсылкаПользователяПоГуиду(ГуидПользователя), Запрос.Текст);
			Если НЕ ПустаяСтрока(ОшибкаПравНаТаблицы) Тогда
				ДанныеДляОтвета.errors.Добавить(Новый Структура(
					"code, message",
					"ACCESS_DENIED",
					"Данные инструмента недоступны. " + ОшибкаПравНаТаблицы));
				РезультатВыполнения = "failure";
			КонецЕсли;

			Для каждого ТекФильтр Из НайденныйИнструмент.Фильтры Цикл
				
				Если filters = Неопределено или (ТипЗнч(filters) = Тип("Массив") и filters.Количество()=0) Тогда					
					Если ТекФильтр.Имя = "Период" или нРег(ТекФильтр.Имя) = "date" Тогда
						Запрос.УстановитьПараметр(ТекФильтр.Имя, ТекущаяДата());
					Иначе
						Запрос.УстановитьПараметр(ТекФильтр.Имя, "B24_NoFilterSpecified");
					КонецЕсли; 
				Иначе
					// Значение фильтра ищем и по «Название», и по «Имя» (ключи в filters
					// нормализованы к нижнему регистру). Иначе фильтр не применяется.
					НайденноеЗначениеФильтра = filters.Получить(нРег(ТекФильтр.Название));
					Если НайденноеЗначениеФильтра = Неопределено И
						НРег(СокрЛП(ТекФильтр.Название)) <> НРег(СокрЛП(ТекФильтр.Имя)) Тогда
						НайденноеЗначениеФильтра = filters.Получить(нРег(ТекФильтр.Имя));
					КонецЕсли;
					Если НайденноеЗначениеФильтра = Неопределено Тогда        
						Если ТекФильтр.Имя = "Период" или нРег(ТекФильтр.Имя) = "date" Тогда
							Запрос.УстановитьПараметр(ТекФильтр.Имя, ТекущаяДата());
						Иначе
							Запрос.УстановитьПараметр(ТекФильтр.Имя, "B24_NoFilterSpecified");
						КонецЕсли;
					Иначе
						
						Попытка							
							Если ТекФильтр.Тип = "number" тогда
								Если ТипЗнч(НайденноеЗначениеФильтра) = Тип("Число") Тогда
									ЗначениеФильтра = НайденноеЗначениеФильтра;
								Иначе
									ЗначениеФильтра	= XMLЗначение(Тип("Число"), НайденноеЗначениеФильтра);
								КонецЕсли;
							ИначеЕсли ТекФильтр.Тип = "boolean" тогда 
								ЗначениеФильтра	= XMLЗначение(Тип("Булево"), НайденноеЗначениеФильтра);
							ИначеЕсли ТекФильтр.Тип = "date" тогда 
								ЗначениеФильтра = СтроковыеФункцииКлиентСервер.СтрокаВДату(НайденноеЗначениеФильтра);								
							Иначе      
								Если ТекФильтр.УсловиеСодержит Тогда
									ЗначениеФильтра	= XMLЗначение(Тип("Строка"), "%" + НайденноеЗначениеФильтра + "%");									
								ИначеЕсли ТекФильтр.Имя = "Период"  или нРег(ТекФильтр.Имя) = "date" Тогда
									ЗначениеФильтра = СтроковыеФункцииКлиентСервер.СтрокаВДату(НайденноеЗначениеФильтра);
								ИначеЕсли СтрНайти(ТекФильтр.Имя, "Количество") Тогда
									ЗначениеФильтра = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(НайденноеЗначениеФильтра);									
								Иначе
									ЗначениеФильтра	= XMLЗначение(Тип("Строка"), НайденноеЗначениеФильтра);
								КонецЕсли;
							КонецЕсли;
							
						Исключение   
							РезультатВыполнения = "failure";
						КонецПопытки;
						
						Запрос.УстановитьПараметр(ТекФильтр.Имя, ЗначениеФильтра);  
						
					КонецЕсли;    
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Если РезультатВыполнения = "success" Тогда

				РежимОбмена = ?(ЭтоЗапросИзЗадания, "PUSH", "HTTP");

				тзнДанных = ВыполнитьЗапросОтИмениПользователя(Запрос, ГуидПользователя);

				// Инструменты, у которых в выборке нет ни одной ссылки, проверить права
				// не удастся: данные порталу не отдаём (отказ формируется ниже, чтобы не
				// ломать обработку выборки).
				ОтказПоРазметке = ПроверитьРазметкуПравИнструмента(тзнДанных, Запрос.Текст);

				// Ограничения доступа к портальному пользователю платформа применить не
				// может: пользователь публикации полноправный (к таким сеансам RLS не
				// применяется), а в фоновом задании пользователя нет вовсе. Поэтому
				// строки, недоступные портальному пользователю, скрываем сами.
				СкрытоСтрок = СкрытьНедоступныеСтроки(тзнДанных, ГуидПользователя);
				Если СкрытоСтрок > 0 Тогда
					// Отдельный вид записи: у записи ответа та же операция, что была бы
					// здесь, а ключ регистра лога совпал бы и строка затирала предыдущую.
					ЗаписатьВЛогVibeCode(РежимОбмена, "Права", "getData",
						"Скрыто строк по правам доступа: " + СкрытоСтрок
						+ " из " + (СкрытоСтрок + тзнДанных.Количество()));
				КонецЕсли;
				
				КолонкиГруппировки 	= "";
				КолонкиСуммы 		= "";
				
				мИспКолонки = Новый Массив;
				Если columns = Неопределено или columns = "*" Тогда
					
				Иначе
					СписокКолонок = "";
					Для каждого ТекКолонкаИИ Из columns Цикл 
						СписокКолонок = СписокКолонок + ТекКолонкаИИ + ";" + Символы.ПС;						
					КонецЦикла;					
				КонецЕсли;
				Для каждого ТекКолонка Из НайденныйИнструмент.Колонки Цикл
					
					ИспКолонка = Истина;	
					Если columns <> Неопределено Тогда					
						ИспКолонка = Ложь;
						Если columns = "*" Тогда
							ИспКолонка = Истина;
						Иначе
							Для каждого ТекКолонкаИИ Из columns Цикл 
								Если ТекКолонка.Название = ТекКолонкаИИ или ТекКолонкаИИ = "*" Тогда
									ИспКолонка = Истина;									
								КонецЕсли;								
							КонецЦикла; 
						КонецЕсли;						
					КонецЕсли;        
					
					Если ИспКолонка Тогда    
						мИспКолонки.Добавить(Новый Структура("Имя, Тип", ТекКолонка.Имя, ТекКолонка.Тип));
						Если ТекКолонка.Тип = "number" Тогда   
							КолонкиСуммы = КолонкиСуммы + ?(КолонкиСуммы = "", ТекКолонка.Имя, "," + ТекКолонка.Имя);
						Иначе  
							КолонкиГруппировки = КолонкиГруппировки + ?(КолонкиГруппировки = "", ТекКолонка.Имя, "," + ТекКолонка.Имя);
						КонецЕсли;  
					КонецЕсли;
					
				КонецЦикла;
			
				Если КолонкиГруппировки = "" И КолонкиСуммы = "" Тогда					
					ДанныеДляОтвета.errors.Добавить(Новый Структура(
						"code, message",
						"ONEC_ERROR",
						"Не выбрано колонок в инструменте:" + tool));
					РезультатВыполнения = "failure";
				Иначе
					
					Если КолонкиГруппировки = "" Тогда 
						КолонкиГруппировки = КолонкиСуммы;
						КолонкиСуммы = "";
					КонецЕсли;
					
					тзнДанных.Свернуть(КолонкиГруппировки, КолонкиСуммы);
					НомерСтроки = 1;
					Для каждого ТекСтрока Из тзнДанных Цикл
						
						ОписаниеЭлемента = Новый Структура;  
					
						Для каждого ТекКолонка Из мИспКолонки Цикл
							ЗначениеКолонки = ТекСтрока[ТекКолонка.Имя];
							Если ТекКолонка.Тип = "string" ИЛИ ТекКолонка.Тип = "text" Тогда
								// Строки, ссылки и коды с ведущими нулями - строками (§5.5).
								ОписаниеЭлемента.Вставить(ТекКолонка.Имя, Строка(ЗначениеКолонки));
							ИначеЕсли ЭтоЧисловойТипКолонки(ТекКолонка.Тип) Тогда
								// Числа сериализуются числами (§5.5), а не строками.
								ОписаниеЭлемента.Вставить(ТекКолонка.Имя, ЧислоИзЗначенияКолонки(ЗначениеКолонки));
							ИначеЕсли ТекКолонка.Тип = "boolean" ИЛИ ТекКолонка.Тип = "bool" Тогда
								ОписаниеЭлемента.Вставить(ТекКолонка.Имя, БулевоИзЗначенияКолонки(ЗначениеКолонки));
							Иначе
								// Даты и прочие типы - в представлении 1С (для дат ISO 8601).
								ОписаниеЭлемента.Вставить(ТекКолонка.Имя, XMLСтрока(ЗначениеКолонки));
							КонецЕсли;
						КонецЦикла;
					
						ДанныеДляОтвета.data.Добавить(ОписаниеЭлемента); 
													
						НомерСтроки = НомерСтроки + 1;						
						Если НомерСтроки > ИИ_ЛимитПередачи Тогда
							Прервать;	
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;     
				
			КонецЕсли;     
			
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = ИнформацияОбОшибке().Описание;
		// Контракт ответа: данные и ошибки не смешиваются. Текст исключения уходит
		// в errors (массив объектов code/message), а частично собранные данные
		// очищаются. С текстом ошибки в data портал отвергает ответ как
		// несоответствующий контракту (HTTP 400 ONEC_VALIDATION).
		ДанныеДляОтвета.data.Очистить();
		ДанныеДляОтвета.errors.Добавить(Новый Структура(
			"code, message",
			"ONEC_ERROR",
			"Выполнение инструмента в 1С было завершено с ошибкой: " + ТекстОшибки));
		РезультатВыполнения = "failure";

	КонецПопытки;

	// Страховка от неразмеченных инструментов: если по таблицам запроса есть
	// ограничения доступа, а ссылок в выборке не оказалось, данные не отдаём.
	Если НЕ ПустаяСтрока(ОтказПоРазметке) Тогда
		ДанныеДляОтвета.data.Очистить();
		ДанныеДляОтвета.errors.Добавить(Новый Структура(
			"code, message", "ACCESS_DENIED", ОтказПоРазметке));
	КонецЕсли;

	РезультатВыполнения = "success";
	СтрJSON = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеДляОтвета);
	Если НЕ ЭтоЗапросИзЗадания Тогда
		// Лог HTTP-режима: полное тело ответа 1С.
		ЗаписатьВЛогVibeCode("HTTP", "Ответ", "getData", СтрJSON);
	КонецЕсли;
		
	// P&P-заданию нужен конверт результата (тот же JSON, что отдаёт HTTP-режим),
	// а не HTTP-ответ сервиса: HTTPСервисОтвет сериализовать в тело /result нельзя.
	Если ЭтоЗапросИзЗадания Тогда
		Возврат ДанныеДляОтвета;
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(200);  
	Ответ.Заголовки.Вставить("Content-Type", "application/json");
	Ответ.Причина = РезультатВыполнения;
	Ответ.УстановитьТелоИзСтроки((СтрJSON));
	
	Возврат Ответ;



КонецФункции

// Числовой ли тип колонки: такие значения уходят в JSON числами (§5.5).
Функция ЭтоЧисловойТипКолонки(Знач ТипКолонки) Экспорт

	Тип = НРег(СокрЛП(ТипКолонки));
	Возврат Тип = "number" ИЛИ Тип = "integer" ИЛИ Тип = "int"
		ИЛИ Тип = "decimal" ИЛИ Тип = "float";

КонецФункции

// Значение колонки как число; на нечисловом значении - представление строкой.
Функция ЧислоИзЗначенияКолонки(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат XMLСтрока(Значение);
	КонецПопытки;

КонецФункции

// Значение колонки как булево.
Функция БулевоИзЗначенияКолонки(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Булево(СокрЛП(Строка(Значение)));
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Находит выборку справочника каталога по методу. Возвращает ссылку или Неопределено.
Функция НайтиВыборкуПоМетоду(Метод) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнструментыVibeCode.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Б24_ИИ_ИнструментыVibeCode КАК ИнструментыVibeCode
	|ГДЕ
	|	ИнструментыVibeCode.Наименование = &Метод
	|	И НЕ ИнструментыVibeCode.ПометкаУдаления
	|	И НЕ ИнструментыVibeCode.НеИспользуется";
	Запрос.УстановитьПараметр("Метод", Метод);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат.Выбрать().Ссылка;

КонецФункции

// Проверяет фильтры запроса по объявленным фильтрам выборки.
// Возвращает структуру {Успех, Код, Сообщение}.
Функция ПроверитьФильтры(Выборка, Запрос) Экспорт

	Результат = Новый Структура("Успех, Код, Сообщение", Истина, "", "");

	Если ЗначениеНастройки(Запрос, "filters") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Фильтры = ЗначениеНастройки(Запрос, "filters");

	// filters:[] невалиден.
	Если ТипЗнч(Фильтры) = Тип("Массив") Тогда
		Результат.Успех = Ложь;
		Результат.Код = "INVALID_FILTER";
		Результат.Сообщение = "filters не может быть массивом";
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Фильтры) <> Тип("Соответствие") Тогда
		Результат.Успех = Ложь;
		Результат.Код = "INVALID_FILTER";
		Результат.Сообщение = "Некорректный формат фильтров";
		Возврат Результат;
	КонецЕсли;

	Объект = Выборка.ПолучитьОбъект();

	Для каждого Фильтр Из Фильтры Цикл
		ИмяФильтра = Строка(Фильтр.Ключ);
		Найден = Ложь;
		Для каждого ОбъявленныйФильтр Из Объект.Фильтры Цикл
			Если СокрЛП(ОбъявленныйФильтр.Имя) = ИмяФильтра Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найден Тогда
			Результат.Успех = Ложь;
			Результат.Код = "UNKNOWN_FILTER";
			Результат.Сообщение = "Фильтр " + ИмяФильтра + " не поддерживается методом";
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает массив запрошенных колонок или весь набор колонок выборки.
Функция ПолучитьЗапрошенныеКолонки(Выборка, Запрос) Экспорт

	Объект = Выборка.ПолучитьОбъект();
	Колонки = Новый Массив;

	Запрошенные = Неопределено;
	Если НЕ ЗначениеНастройки(Запрос, "columns") = Неопределено Тогда
		Запрошенные = ЗначениеНастройки(Запрос, "columns");
	КонецЕсли;

	Если ТипЗнч(Запрошенные) = Тип("Массив") И Запрошенные.Количество() > 0 Тогда
		Для каждого ИмяКолонки Из Запрошенные Цикл
			Колонки.Добавить(Строка(ИмяКолонки));
		КонецЦикла;
		Возврат Колонки;
	КонецЕсли;

	// Нет columns - все разрешённые поля (в порядке объявления).
	Для каждого Колонка Из Объект.Колонки Цикл
		Колонки.Добавить(СокрЛП(Колонка.Имя));
	КонецЦикла;

	Возврат Колонки;

КонецФункции

Функция ПолучитьЛимит(Запрос) Экспорт

	Лимит = МаксимумСтрок();
	Если НЕ ЗначениеНастройки(Запрос, "limit") = Неопределено Тогда
		Попытка
			Значение = Число(ЗначениеНастройки(Запрос, "limit"));
			Если Значение > 0 И Значение < Лимит Тогда
				Лимит = Значение;
			КонецЕсли;
		Исключение
			// Оставляем лимит по умолчанию.
		КонецПопытки;
	КонецЕсли;
	Возврат Лимит;

КонецФункции

Функция ПолучитьСмещение(Запрос) Экспорт

	Смещение = 0;
	Если НЕ ЗначениеНастройки(Запрос, "offset") = Неопределено Тогда
		Попытка
			Значение = Число(ЗначениеНастройки(Запрос, "offset"));
			Если Значение >= 0 Тогда
				Смещение = Значение;
			КонецЕсли;
		Исключение
			// Оставляем смещение 0.
		КонецПопытки;
	КонецЕсли;
	Возврат Смещение;

КонецФункции

// Получает строки данных выборки с учётом лимита/смещения и усечения.
// Точка расширения: демо-механизм возвращает пустой набор;
// реальные методы (номенклатура/остатки/банки) наполняются позже.
Функция ПолучитьДанныеВыборки(Выборка, Запрос, Колонки, Лимит, Смещение) Экспорт

	Строки = ВыполнитьВыборкуДанных(Выборка, Запрос, Колонки, Лимит, Смещение);

	Данные = Новый Соответствие;
	Данные.Вставить("rows", Строки);
	Данные.Вставить("truncated", Ложь);

	// Проверка усечения по байтам (целыми строками) и по количеству строк.
	Если Строки.Количество() >= Лимит И Лимит >= МаксимумСтрок() Тогда
		Данные.Вставить("truncated", Истина);
	КонецЕсли;

	Попытка
		Размер = СтрДлина(Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(Строки));
		Если Размер * 4 >= МаксимумБайтEnvelope() Тогда
			Данные.Вставить("truncated", Истина);
		КонецЕсли;
	Исключение
		// Не критично.
	КонецПопытки;

	Возврат Данные;

КонецФункции

// Реальный источник строк выборки. Механизм готов; наполнение конкретных
// методов (номенклатура, остатки, банки и пр.) производится последующими шагами.
Функция ВыполнитьВыборкуДанных(Выборка, Запрос, Колонки, Лимит, Смещение) Экспорт

	// Возвращаем пустой массив строк в демо-фазе.
	МассивСтрок = Новый Массив;
	Возврат МассивСтрок;

КонецФункции

// Формирует конверт бизнес-ошибки handler'а getData.
Функция ОшибкаGetData(Код, Сообщение) Экспорт

	Ошибка = Новый Соответствие;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);

	Конверт = Новый Соответствие;
	Конверт.Вставить("success", Ложь);
	Конверт.Вставить("error", Ошибка);
	Возврат Конверт;

КонецФункции

// ЗначениеПоУсловию - вспомогательная функция безопасного чтения из Соответствия.
Функция ЗначениеПоУсловию(Условие, ЗначениеЕслиЛожь, Выражение) Экспорт

	Если Условие Тогда
		Возврат Выражение;
	КонецЕсли;

	Возврат ЗначениеЕслиЛожь;

КонецФункции

#КонецОбласти


#Область Подключение

// Выполняет подключение модуля к VibeCode: POST /connect, тело {instanceId, name},
//   авторизация Bearer <ключ> + X-Onec-Instance-Id (контракт «один ключ», без pairing).
// Возвращает структуру {Успех, КодОшибки, Данные}.
Функция ВыполнитьConnect(Настройка, СтрокаКлюча) Экспорт

	РазобранныйКлюч = РазобратьКлючПодключения(СтрокаКлюча);
	Если НЕ РазобранныйКлюч.Успех Тогда
		Результат = Новый Структура("Успех, КодОшибки, Сообщение", Ложь, "ONEC_VALIDATION", "Некорректная строка подключения");
		Возврат Результат;
	КонецЕсли;

	ИдентификаторЭкземпляра = ИдентификаторЭкземпляра(Настройка);
	Если ПустаяСтрока(ИдентификаторЭкземпляра) Тогда
		ИдентификаторЭкземпляра = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	Токен = РазобранныйКлюч.Ключ;
	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("instanceId", ИдентификаторЭкземпляра);
	ТелоЗапроса.Вставить("name", СокрЛП(Настройка.Наименование));

	БазовыйURL = РазобранныйКлюч.Адрес;
	РезультатЗапроса = Б24_ИИ_ИнтеграцияВызовСервера.ОтправитьConnect(
		БазовыйURL, ТелоЗапроса, Токен, ИдентификаторЭкземпляра);

	Результат = Новый Структура("Успех, КодОшибки, Сообщение, Данные", Ложь, "", "", Неопределено);

	Если РезультатЗапроса.Статус = 200 Тогда
		JSON = РезультатЗапроса.JSON;
		Если ЗначениеНастройки(JSON, "success") = Истина Тогда
			Данные = ЗначениеНастройки(JSON, "data");
			// Токен не перевыпускается: при отсутствии нового в ответе используем введённый ключ.
			Если ТипЗнч(Данные) = Тип("Соответствие")
				И НЕ ЗначениеНастройки(Данные, "token") = Неопределено Тогда
				ВыданныйТокен = Строка(ЗначениеНастройки(Данные, "token"));
				Если НЕ ПустаяСтрока(ВыданныйТокен) Тогда
					Токен = ВыданныйТокен;
				КонецЕсли;
			КонецЕсли;
			ПараметрыХранения = Новый Соответствие;
			ПараметрыХранения.Вставить("Токен", Токен);
			ПараметрыХранения.Вставить("ИдентификаторЭкземпляра", ИдентификаторЭкземпляра);
			ПараметрыХранения.Вставить("Адрес", РазобранныйКлюч.Адрес);
			Если ТипЗнч(Данные) = Тип("Соответствие")
				И НЕ ЗначениеНастройки(Данные, "urls") = Неопределено Тогда
				ПараметрыХранения.Вставить("URLs", ЗначениеНастройки(Данные, "urls"));
			КонецЕсли;
			СохранитьТокенИИдентификатор(Настройка, Токен, ИдентификаторЭкземпляра, ПараметрыХранения);
			ОбновитьСтатусНастройки(Настройка, "ONLINE",
				Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса());
			// Подключение успешно - создаём/включаем расписание задания.
			ДобавитьУдалитьРасписаниеЗадания();
			Результат.Успех = Истина;
			Результат.Данные = Данные;
			Возврат Результат;
		КонецЕсли;
		КодОшибки = Б24_ИИ_ИнтеграцияВызовСервера.КодОшибкиИнтеграции(JSON);
		Результат.КодОшибки = КодОшибки;
		Результат.Сообщение = КодОшибки;
		Возврат Результат;
	Иначе
		// Логируем тело ответа портала (может быть JSON-конвертом ошибки).
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ(
			"HTTP-Ответ-Тело", "connect: HTTP " + Формат(РезультатЗапроса.Статус, "ЧГ=")
				+ " тело ответа: " + СокрЛП(РезультатЗапроса.Тело));
		// Если портал вернул JSON-конверт ошибки - показываем его код, иначе транспортная.
		КодОшибкиConnect = Б24_ИИ_ИнтеграцияВызовСервера.КодОшибкиИнтеграции(РезультатЗапроса.JSON);
		Если ПустаяСтрока(КодОшибкиConnect) Тогда
			Результат.КодОшибки = "TRANSPORT";
			Результат.Сообщение = "Транспортная ошибка при connect (HTTP "
				+ Формат(РезультатЗапроса.Статус, "ЧГ=") + ")";
		Иначе
			Результат.КодОшибки = КодОшибкиConnect;
			Результат.Сообщение = КодОшибкиConnect + ": "
				+ СообщениеОшибкиИнтеграции(РезультатЗапроса.JSON);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

КонецФункции

// SHA256 строки (используется как стабильная подпись экземпляра).
Функция SHA256(Знач СтрокаДляХэша) Экспорт

	Попытка
		Хэш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хэш.Добавить(СтрокаДляХэша);
		Возврат "sha256:" + НРег(Хэш.ХешСумма);
	Исключение
		Возврат "sha256:";
	КонецПопытки;

КонецФункции

// Процедура ручного отключения (POST /disconnect).
Процедура ВыполнитьDisconnect(Настройка) Экспорт

	Токен = ТокенПодключения(Настройка);
	Ид = ИдентификаторЭкземпляра(Настройка);
	Если ПустаяСтрока(Токен) Тогда
		Возврат;
	КонецЕсли;

	БазовыйURL = БазовыйURLИнтеграции(Настройка);
	Если ПустаяСтрока(БазовыйURL) Тогда
		Возврат;
	КонецЕсли;

	Б24_ИИ_ИнтеграцияВызовСервера.ОтправитьDisconnect(БазовыйURL, Токен, Ид);
	УдалитьПодключение(Настройка, "DISCONNECTED");

КонецПроцедуры

#КонецОбласти


#Область КонфигурацияМодуля

// Проверяет, что настройка готова к запросам /settings (есть токен и базовый адрес).
// Возвращает структуру {Успех, БазовыйURL, Токен, ИдентификаторЭкземпляра, Сообщение}.
Функция ПроверитьГотовностьКЗапросамКонфигурации(Настройка) Экспорт

	Результат = Новый Структура(
		"Успех, БазовыйURL, Токен, ИдентификаторЭкземпляра, Сообщение",
		Ложь, "", "", "", "");

	Если Настройка = Неопределено Тогда
		Результат.Сообщение = "Не выбрана настройка интеграции";
		Возврат Результат;
	КонецЕсли;

	БазовыйURL = БазовыйURLИнтеграции(Настройка);
	Токен = ТокенПодключения(Настройка);
	Ид = ИдентификаторЭкземпляра(Настройка);

	Если ПустаяСтрока(БазовыйURL) Тогда
		Результат.Сообщение = "Не заполнен адрес интеграции";
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(Токен) Тогда
		Результат.Сообщение = "Нет действующего токена подключения (выполните connect)";
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.БазовыйURL = БазовыйURL;
	Результат.Токен = Токен;
	Результат.ИдентификаторЭкземпляра = Ид;
	Возврат Результат;

КонецФункции

// GET /settings: получить конфигурацию модуля с портала.
// Возвращает структуру {Успех, КодОшибки, Сообщение, Данные}.
Функция ПолучитьКонфигурациюМодуля(Настройка) Экспорт

	Готовность = ПроверитьГотовностьКЗапросамКонфигурации(Настройка);
	Если НЕ Готовность.Успех Тогда
		Результат = Новый Структура("Успех, КодОшибки, Сообщение, Данные",
			Ложь, "ONEC_VALIDATION", Готовность.Сообщение, Неопределено);
		Возврат Результат;
	КонецЕсли;

	ОтветЗапроса = Б24_ИИ_ИнтеграцияВызовСервера.ПолучитьКонфигурацию(
		Готовность.БазовыйURL, Готовность.Токен, Готовность.ИдентификаторЭкземпляра);
	Возврат ОбработатьОтветКонфигурации(ОтветЗапроса);

КонецФункции

// Один запрос PUT /settings (создать/обновить) с новым Idempotency-Key.
// Возвращает сырой результат HTTP-клиента.
Функция ОтправитьPUTНастроек(Готовность, ДанныеТела, ЭтоСоздание, ETag)

	ИдемпотентностиКлюч = Строка(Новый УникальныйИдентификатор);
	Возврат Б24_ИИ_ИнтеграцияВызовСервера.СохранитьКонфигурациюПолностью(
		Готовность.БазовыйURL, Готовность.Токен, Готовность.ИдентификаторЭкземпляра,
		ДанныеТела, ИдемпотентностиКлюч, ЭтоСоздание, ETag);

КонецФункции

// Читает текущие настройки и их ETag через GET /settings.
// Возвращает {Успех, ETag, КодОшибки, Сообщение}. Если настроек нет -
// Успех=Ложь и КодОшибки=ONEC_SETTINGS_MISSING (HTTP 404).
Функция ЧтениеETagНастроек(Готовность)

	Результат = Новый Структура("Успех, ETag, КодОшибки, Сообщение", Ложь, "", "", "");
	ОтветГет = Б24_ИИ_ИнтеграцияВызовСервера.ПолучитьКонфигурацию(
		Готовность.БазовыйURL, Готовность.Токен, Готовность.ИдентификаторЭкземпляра);

	Если ОтветГет.Статус < 0 Тогда
		Результат.КодОшибки = "TRANSPORT";
		Результат.Сообщение = "Транспортная ошибка чтения настроек";
		Возврат Результат;
	КонецЕсли;

	Если ОтветГет.Статус = 200 Тогда
		Результат.Успех = Истина;
		Результат.ETag = ETagОтвета(ОтветГет);
		Если ПустаяСтрока(Результат.ETag) Тогда
			// Резерв: ETag в теле как data.settingsVersion, если заголовка нет.
			Попытка
				Данные = ЗначениеНастройки(ОтветГет.JSON, "data");
				Если НЕ Данные = Неопределено Тогда
					Версия = ЗначениеНастройки(Данные, "settingsVersion");
					Если НЕ Версия = Неопределено Тогда
						Результат.ETag = СокрЛП(Строка(Версия));
					КонецЕсли;
				КонецЕсли;
			Исключение
				// Игнорируем - ETag останется пустым.
			КонецПопытки;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	JSON = ОтветГет.JSON;
	Результат.КодОшибки = КодОшибкиИнтеграции(JSON);
	Результат.Сообщение = СообщениеОшибкиИнтеграции(JSON);
	Возврат Результат;

КонецФункции

// После успешного сохранения обновляет хранимый ETag на актуальный (из GET).
Процедура ОбновитьХранимыйETag(Настройка, Готовность)

	Чтение = ЧтениеETagНастроек(Готовность);
	Если Чтение.Успех И НЕ ПустаяСтрока(Чтение.ETag) Тогда
		Хранимое = ПрочитатьХранимоеПодключение(Настройка);
		Хранимое.Вставить("ETag", Чтение.ETag);
		КлючОбъекта = ПолучитьКлючОбъектаНастроек(Настройка);
		ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючХранилищаТокена(), Хранимое);
	КонецЕсли;

КонецПроцедуры

// Структура-ошибка в формате {Успех, КодОшибки, Сообщение, Данные}.
Функция РезультатОшибки(Код, Сообщение)

	Результат = Новый Структура("Успех, КодОшибки, Сообщение, Данные",
		Ложь, "", "", Неопределено);
	Результат.КодОшибки = Код;
	Результат.Сообщение = Сообщение;
	Возврат Результат;

КонецФункции

// Обрабатывает финальный ответ PUT и обновляет хранимый ETag при успехе.
Функция ЗавершитьСохранение(Настройка, Готовность, ОтветЗапроса)

	Результат = ОбработатьОтветКонфигурации(ОтветЗапроса);
	Если Результат.Успех Тогда
		ОбновитьХранимыйETag(Настройка, Готовность);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Обновление существующей конфигурации: свежий ETag из GET -> PUT с If-Match.
// Если настроек на портале больше нет - создаёт заново (If-None-Match).
Функция ОбновитьСуществующуюКонфигурацию(Настройка, Готовность, ДанныеТела)

	Чтение = ЧтениеETagНастроек(Готовность);
	Если НЕ Чтение.Успех Тогда
		Если Чтение.КодОшибки = "ONEC_SETTINGS_MISSING" Тогда
			// Настроек на портале нет - создать заново.
			ОтветЗапроса = ОтправитьPUTНастроек(Готовность, ДанныеТела, Истина, "");
			Если ОтветЗапроса.Статус = 412 Тогда
				Возврат РезультатОшибки("ONEC_ETAG_CONFLICT",
					"Настройки изменились на портале (HTTP 412). Повторите сохранение.");
			КонецЕсли;
			Возврат ЗавершитьСохранение(Настройка, Готовность, ОтветЗапроса);
		Иначе
			Возврат РезультатОшибки(Чтение.КодОшибки, Чтение.Сообщение);
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(Чтение.ETag) Тогда
		Возврат РезультатОшибки("ONEC_ETAG_MISSING",
			"Портал не вернул ETag настроек (GET /settings).");
	КонецЕсли;

	ОтветЗапроса = ОтправитьPUTНастроек(Готовность, ДанныеТела, Ложь, Чтение.ETag);
	Если ОтветЗапроса.Статус = 412 Тогда
		Возврат РезультатОшибки("ONEC_ETAG_CONFLICT",
			"Настройки изменились на портале (HTTP 412). "
			+ "Нажмите «Получить конфигурацию» и повторите сохранение.");
	КонецЕсли;

	Возврат ЗавершитьСохранение(Настройка, Готовность, ОтветЗапроса);

КонецФункции

// PUT /settings: сохранить конфигурацию модуля (создать или обновить).
// Тело по умолчанию собирается из настроек {transport, information1C, capabilities}.
// Пока нет сохранённого ETag - это первое сохранение: шлём PUT с If-None-Match: *
// (без GET - при отсутствии настроек GET отвечает 404 ONEC_SETTINGS_MISSING).
// После успешного сохранения ETag хранится и обновляется через GET; дальнейшие
// сохранения идут с If-Match: <актуальный ETag>.
// HTTP 412: при создании - настройки уже есть (обновляем); при обновлении - конфликт.
Функция СохранитьКонфигурациюМодуля(Настройка, Конфигурация = Неопределено) Экспорт

	Готовность = ПроверитьГотовностьКЗапросамКонфигурации(Настройка);
	Если НЕ Готовность.Успех Тогда
		Возврат РезультатОшибки("ONEC_VALIDATION", Готовность.Сообщение);
	КонецЕсли;

	Если Конфигурация = Неопределено Тогда
		// Портал требует пароль публикации, пока HTTP-настройки на нём не созданы:
		// без пароля PUT /settings отклонится текстом вида "transport.password is
		// missing". Проверяем заранее, чтобы показать понятную подсказку.
		Если РежимРаботы(Настройка) = "http" И НЕ ХранитсяПарольПубликации(Настройка) Тогда
			Возврат РезультатОшибки("ONEC_VALIDATION",
				"Для http-режима нужен пароль пользователя публикации."
				+ " Переключите режим (Push-Pull - HTTP) или выполните подключение заново,"
				+ " чтобы ввести пароль.");
		КонецЕсли;
		ДанныеТела = КонфигурацияПервичногоСохранения(Настройка);
	Иначе
		ДанныеТела = ПривестиКДаннымJSON(Конфигурация);
		Если ДанныеТела = Неопределено Тогда
			Возврат РезультатОшибки("ONEC_VALIDATION", "Некорректный JSON конфигурации");
		КонецЕсли;
	КонецЕсли;

	Хранимое = ПрочитатьХранимоеПодключение(Настройка);
	ХранимыйETag = СокрЛП(Строка(ЗначениеНастройки(Хранимое, "ETag")));

	Если ПустаяСтрока(ХранимыйETag) Тогда
		// Первое сохранение: создаём сразу (If-None-Match: *).
		ОтветЗапроса = ОтправитьPUTНастроек(Готовность, ДанныеТела, Истина, "");
		Если ОтветЗапроса.Статус = 412 Тогда
			// Уже существуют (созданы ранее) - обновить по актуальному ETag.
			Возврат ОбновитьСуществующуюКонфигурацию(Настройка, Готовность, ДанныеТела);
		КонецЕсли;
		Возврат ЗавершитьСохранение(Настройка, Готовность, ОтветЗапроса);
	Иначе
		Возврат ОбновитьСуществующуюКонфигурацию(Настройка, Готовность, ДанныеТела);
	КонецЕсли;

КонецФункции


// PATCH /settings: частично обновить настройки модуля на портале.
// Конфигурация - частичный объект контракта /settings (ключи только
// transport/information1C/capabilities). Обновление идёт с актуальным ETag
// (GET /settings) в If-Match и новым Idempotency-Key.
Функция ОбновитьКонфигурациюМодуля(Настройка, Конфигурация = Неопределено) Экспорт

	Готовность = ПроверитьГотовностьКЗапросамКонфигурации(Настройка);
	Если НЕ Готовность.Успех Тогда
		Возврат РезультатОшибки("ONEC_VALIDATION", Готовность.Сообщение);
	КонецЕсли;

	ДанныеТела = ПривестиКДаннымJSON(Конфигурация);
	Если ДанныеТела = Неопределено Тогда
		Возврат РезультатОшибки("ONEC_VALIDATION", "Некорректный JSON конфигурации");
	КонецЕсли;

	// Фильтруем: на портал отправляем только изменяемые ключи; служебные поля
	// GET /settings (version/status/operationTimeoutSec) игнорируем.
	ТелоДляОтправки = Новый Соответствие;
	Лишние = Новый Массив;
	Для каждого КлючЗначение Из ДанныеТела Цикл
		Имя = НРег(Строка(КлючЗначение.Ключ));
		Если Имя = "transport" Тогда
			// Очищаем вложенные служебные поля портала (passwordConfigured и т.п.),
			// которые GET /settings возвращает, но контракт PATCH не принимает.
			ТелоДляОтправки.Вставить(КлючЗначение.Ключ,
				ОчиститьТранспортДляPATCH(КлючЗначение.Значение));
		ИначеЕсли Имя = "information1c" ИЛИ Имя = "capabilities" Тогда
			ТелоДляОтправки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		ИначеЕсли Имя = "version" ИЛИ Имя = "status" ИЛИ Имя = "operationtimeoutsec" Тогда
			// Служебные поля сервера - не отправляем.
			Продолжить;
		Иначе
			Лишние.Добавить(Строка(КлючЗначение.Ключ));
		КонецЕсли;
	КонецЦикла;
	Если Лишние.Количество() > 0 Тогда
		Возврат РезультатОшибки("ONEC_VALIDATION",
			"PATCH принимает только transport/information1C/capabilities. "
			+ "Лишние ключи: " + СтрСоединить(Лишние, ", ")
			+ ". Например: {""transport"": {""mode"": ""http""}}.");
	КонецЕсли;
	Если ТелоДляОтправки.Количество() = 0 Тогда
		Возврат РезультатОшибки("ONEC_VALIDATION",
			"Нет изменяемых ключей. PATCH меняет только transport/information1C/capabilities.");
	КонецЕсли;


	// Актуальный ETag - из GET /settings.
	Чтение = ЧтениеETagНастроек(Готовность);
	Если НЕ Чтение.Успех Тогда
		Если Чтение.КодОшибки = "ONEC_SETTINGS_MISSING" Тогда
			Возврат РезультатОшибки("ONEC_SETTINGS_MISSING",
				"Настройки ещё не созданы: сначала выполните «Сохранить (PUT)».");
		КонецЕсли;
		Возврат РезультатОшибки(Чтение.КодОшибки, Чтение.Сообщение);
	КонецЕсли;

	Если ПустаяСтрока(Чтение.ETag) Тогда
		Возврат РезультатОшибки("ONEC_ETAG_MISSING",
			"Портал не вернул ETag настроек (GET /settings).");
	КонецЕсли;

	ИдемпотентностиКлюч = Строка(Новый УникальныйИдентификатор);
	ОтветЗапроса = Б24_ИИ_ИнтеграцияВызовСервера.ОбновитьКонфигурациюЧастично(
		Готовность.БазовыйURL, Готовность.Токен, Готовность.ИдентификаторЭкземпляра,
		ТелоДляОтправки, ИдемпотентностиКлюч, Чтение.ETag);

	Если ОтветЗапроса.Статус = 412 Тогда
		Возврат РезультатОшибки("ONEC_ETAG_CONFLICT",
			"Настройки изменились на портале (HTTP 412). "
			+ "Нажмите «Получить конфигурацию» и повторите.");
	КонецЕсли;

	Результат = ОбработатьОтветКонфигурации(ОтветЗапроса);
	Если Результат.Успех Тогда
		ОбновитьХранимыйETag(Настройка, Готовность);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Убирает из блока transport служебные поля портала (passwordConfigured и пр.),
// которые GET /settings возвращает, но контракт PATCH /settings не принимает.
// Возвращает очищенное Соответствие. Пароль не раскрывается и не отправляется.
Функция ОчиститьТранспортДляPATCH(Транспорт) Экспорт

	Если ТипЗнч(Транспорт) <> Тип("Соответствие") И ТипЗнч(Транспорт) <> Тип("Структура") Тогда
		Возврат Транспорт;
	КонецЕсли;

	// У Соответствия нет метода .Свойство(), поэтому используем Структуру
	// (у неё этот метод есть). Ключи транспорта, допустимые в PATCH /settings.
	РазрешенныеКлючи = Новый Структура("mode, baseurl, username, password",
		Истина, Истина, Истина, Истина);

	Результат = Новый Соответствие;
	Для каждого КлючЗначение Из Транспорт Цикл
		Имя = НРег(Строка(КлючЗначение.Ключ));
		Если РазрешенныеКлючи.Свойство(Имя) Тогда
			Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Один запрос DELETE /settings с актуальным ETag и новым Idempotency-Key.
// Возвращает сырой результат HTTP-клиента.
Функция ОтправитьDELETEНастроек(Готовность, ETag)

	ИдемпотентностиКлюч = Строка(Новый УникальныйИдентификатор);
	Возврат Б24_ИИ_ИнтеграцияВызовСервера.УдалитьКонфигурацию(
		Готовность.БазовыйURL, Готовность.Токен, Готовность.ИдентификаторЭкземпляра,
		ИдемпотентностиКлюч, ETag);

КонецФункции

// Убирает сохранённый ETag настроек из безопасного хранилища.
Процедура ОчиститьХранимыйETag(Настройка)

	Хранимое = ПрочитатьХранимоеПодключение(Настройка);
	Если ЗначениеНастройки(Хранимое, "ETag") <> Неопределено Тогда
		Хранимое.Удалить("ETag");
		КлючОбъекта = ПолучитьКлючОбъектаНастроек(Настройка);
		ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючХранилищаТокена(), Хранимое);
	КонецЕсли;

КонецПроцедуры

// DELETE /settings: удалить конфигурацию модуля с портала.
// Удаление идёт с If-Match по актуальному ETag (GET /settings) и новым
// Idempotency-Key; при конфликте версии (409) пробует один повтор со свежим ETag.
Функция УдалитьКонфигурациюМодуля(Настройка) Экспорт

	Готовность = ПроверитьГотовностьКЗапросамКонфигурации(Настройка);
	Если НЕ Готовность.Успех Тогда
		Возврат РезультатОшибки("ONEC_VALIDATION", Готовность.Сообщение);
	КонецЕсли;

	Чтение = ЧтениеETagНастроек(Готовность);
	Если НЕ Чтение.Успех Тогда
		Если Чтение.КодОшибки = "ONEC_SETTINGS_MISSING" Тогда
			// Настроек на портале нет - нечего удалять.
			ОчиститьХранимыйETag(Настройка);
			Результат = РезультатОшибки("", "");
			Результат.Успех = Истина;
			Результат.Сообщение = "Настроек на портале нет (HTTP 404)";
			Возврат Результат;
		КонецЕсли;
		Возврат РезультатОшибки(Чтение.КодОшибки, Чтение.Сообщение);
	КонецЕсли;

	Если ПустаяСтрока(Чтение.ETag) Тогда
		Возврат РезультатОшибки("ONEC_ETAG_MISSING",
			"Портал не вернул ETag настроек (GET /settings).");
	КонецЕсли;

	ОтветЗапроса = ОтправитьDELETEНастроек(Готовность, Чтение.ETag);

	// Конфликт версии (409 ONEC_SETTINGS_VERSION_CONFLICT) или 412 - один повтор
	// со свежим ETag.
	Если ОтветЗапроса.Статус = 409 ИЛИ ОтветЗапроса.Статус = 412 Тогда
		Чтение2 = ЧтениеETagНастроек(Готовность);
		Если Чтение2.Успех И НЕ ПустаяСтрока(Чтение2.ETag) Тогда
			ОтветЗапроса = ОтправитьDELETEНастроек(Готовность, Чтение2.ETag);
		КонецЕсли;
	КонецЕсли;

	Результат = ОбработатьОтветКонфигурации(ОтветЗапроса);
	Если Результат.Успех Тогда
		ОчиститьХранимыйETag(Настройка);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Нормализует переданную конфигурацию к значению, сериализуемому в JSON.
// Принимает Соответствие, Структуру, Массив или строку JSON; иначе Неопределено.
Функция ПривестиКДаннымJSON(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		СтрокаJSON = СокрЛП(Значение);
		Если ПустаяСтрока(СтрокаJSON) Тогда
			Возврат Новый Соответствие;
		КонецЕсли;
		Попытка
			Разобранное = Б24_ИИ_ИнтеграцияВызовСервера.СтрокаJSONВСоответствие(СтрокаJSON);
			Если Разобранное.Количество() > 0 Тогда
				Возврат Разобранное;
			КонецЕсли;
			// Пустой объект {}. Допустимо для PUT/PATCH как пустая конфигурация.
			Если ПустаяСтрока(СтрокаJSON) = Ложь И Лев(СтрокаJSON,1) = "{" Тогда
				Возврат Разобранное;
			КонецЕсли;
			Возврат Неопределено;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Соответствие")
		ИЛИ ТипЗнч(Значение) = Тип("Структура")
		ИЛИ ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Приводит результат HTTP-запроса к единому виду {Успех, КодОшибки, Сообщение, Данные}.
Функция ОбработатьОтветКонфигурации(ОтветЗапроса) Экспорт

	Результат = Новый Структура("Успех, КодОшибки, Сообщение, Данные",
		Ложь, "", "", Неопределено);

	Если ОтветЗапроса = Неопределено Тогда
		Результат.КодОшибки = "TRANSPORT";
		Результат.Сообщение = "Нет ответа сервера";
		Возврат Результат;
	КонецЕсли;

	// Транспортная ошибка (HTTP-статус < 0 или не-JSON).
	Если ОтветЗапроса.Статус < 0 Тогда
		Результат.КодОшибки = "TRANSPORT";
		Результат.Сообщение = "Транспортная ошибка запроса к порталу";
		Возврат Результат;
	КонецЕсли;

		JSON = ОтветЗапроса.JSON;
	Если НЕ JSON = Неопределено И НЕ ЗначениеНастройки(JSON, "success") = Неопределено Тогда
		Если ЗначениеНастройки(JSON, "success") = Истина Тогда
			Результат.Успех = Истина;
			Если НЕ ЗначениеНастройки(JSON, "data") = Неопределено Тогда
				Результат.Данные = ЗначениеНастройки(JSON, "data");
			КонецЕсли;
			Возврат Результат;
	Иначе
		КодОшибки = КодОшибкиИнтеграции(JSON);
		Результат.КодОшибки = КодОшибки;
		Результат.Сообщение = СообщениеОшибкиИнтеграции(JSON);
		// Диагностика: логируем код и тело ответа портала (может содержать details валидации).
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ(
			"Settings-Ошибка", "HTTP " + Формат(ОтветЗапроса.Статус, "ЧГ=")
				+ " код: " + Строка(КодОшибки)
				+ " тело: " + СокрЛП(ОтветЗапроса.Тело));
		// Код в сообщении, чтобы был виден пользователю в форме.
		Если НЕ ПустаяСтрока(Строка(КодОшибки)) Тогда
			Результат.Сообщение = Строка(КодОшибки) + ": " + Результат.Сообщение;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	КонецЕсли;

	// HTTP-статус без валидного JSON-конверта: трактуем семантику по коду.
	Если ОтветЗапроса.Статус = 404 Тогда
		// Конфигурация на портале ещё не создана - считаем успешным пустым результатом.
		Результат.Успех = Истина;
		Результат.Данные = Новый Соответствие;
		Результат.Сообщение = "Конфигурация на портале не создана (HTTP 404)";
		Возврат Результат;
	КонецЕсли;

	Если ОтветЗапроса.Статус = 405 Тогда
		Результат.КодОшибки = "ONEC_METHOD_NOT_ALLOWED";
		Результат.Сообщение = "Портал не поддерживает этот метод для конфигурации (HTTP 405). "
			+ "Возможно, запись/удаление конфигурации модуля через /settings не реализовано.";
		Возврат Результат;
	КонецЕсли;

	Если ОтветЗапроса.Статус = 401 ИЛИ ОтветЗапроса.Статус = 403 Тогда
		Результат.КодОшибки = "ONEC_TOKEN_INVALID";
		Результат.Сообщение = "Портал отклонил ключ доступа (HTTP " + Формат(ОтветЗапроса.Статус, "ЧГ=") + ")";
		Возврат Результат;
	КонецЕсли;

	Если ОтветЗапроса.Статус = 409 Тогда
		Результат.КодОшибки = "ONEC_INSTANCE_MISMATCH";
		Результат.Сообщение = "Токен привязан к другому инстансу (HTTP 409). "
			+ "Проверьте instanceId подключения.";
		Возврат Результат;
	КонецЕсли;

	// HTTP-статус без валидного JSON-конверта.
	Результат.КодОшибки = "TRANSPORT";
	Результат.Сообщение = "Некорректный ответ сервера (HTTP " + Формат(ОтветЗапроса.Статус, "ЧГ=") + ")";
	Возврат Результат;

КонецФункции

// Читает ETag из заголовков ответа HTTP (ключ ищем без учёта регистра).
// Возвращает пустую строку, если заголовка нет.
Функция ETagОтвета(ОтветЗапроса) Экспорт

	Если ОтветЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Заголовки = ОтветЗапроса.Заголовки;
	Исключение
		Заголовки = Неопределено;
	КонецПопытки;

	Если Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИскомоеИмя = НРег("etag");
	Для каждого КлючЗначение Из Заголовки Цикл
		Если НРег(Строка(КлючЗначение.Ключ)) = ИскомоеИмя Тогда
			Значение = КлючЗначение.Значение;
			Если НЕ Значение = Неопределено Тогда
				Возврат СокрЛП(Строка(Значение));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Извлекает код ошибки из JSON-конверта {success:false,error:{code,...}}.
Функция КодОшибкиИнтеграции(JSON) Экспорт

	Если JSON = Неопределено ИЛИ ЗначениеНастройки(JSON, "error") = Неопределено Тогда
		Возврат "ONEC_ERROR";
	КонецЕсли;
	Ошибка = ЗначениеНастройки(JSON, "error");
	Код = ЗначениеНастройки(Ошибка, "code");
	Если НЕ Код = Неопределено Тогда
		Возврат Строка(Код);
	КонецЕсли;
	Возврат "ONEC_ERROR";

КонецФункции

// Извлекает сообщение ошибки из JSON-конверта.
Функция СообщениеОшибкиИнтеграции(JSON) Экспорт

	Если JSON = Неопределено ИЛИ ЗначениеНастройки(JSON, "error") = Неопределено Тогда
		Возврат "Ошибка сервера";
	КонецЕсли;
	Ошибка = ЗначениеНастройки(JSON, "error");
	Если ТипЗнч(Ошибка) = Тип("Соответствие") Тогда
		Сообщение = ЗначениеНастройки(Ошибка, "message");
		Если НЕ Сообщение = Неопределено Тогда
			Возврат Строка(Сообщение);
		КонецЕсли;
		Код = ЗначениеНастройки(Ошибка, "code");
		Если НЕ Код = Неопределено Тогда
			Возврат Строка(Код);
		КонецЕсли;
	КонецЕсли;
	Возврат "Ошибка сервера";

КонецФункции

// Формирует тело PUT /settings при первом сохранении после connect:
// {transport, information1C, capabilities}. Пароль берётся из безопасного
// хранилища и в реквизиты/на форму не выводится.
Функция КонфигурацияПервичногоСохранения(Настройка) Экспорт

	Тело = Новый Соответствие;

	transport = Новый Соответствие;
	transport.Вставить("mode", РежимРаботы(Настройка));
	Если РежимРаботы(Настройка) = "http" Тогда
		Если НЕ Настройка = Неопределено Тогда
			Если НЕ ПустаяСтрока(СокрЛП(Настройка.АдресПубликации)) Тогда
				transport.Вставить("baseUrl", СокрЛП(Настройка.АдресПубликации));
			КонецЕсли;
			Если НЕ ПустаяСтрока(СокрЛП(Настройка.ПользовательПубликации)) Тогда
				transport.Вставить("username", СокрЛП(Настройка.ПользовательПубликации));
			КонецЕсли;
		КонецЕсли;
		Хранимое = ПрочитатьХранимоеПодключение(Настройка);
		Пароль = ЗначениеНастройки(Хранимое, "ПарольПубликации");
		Если НЕ Пароль = Неопределено Тогда
			transport.Вставить("password", Строка(Пароль));
		КонецЕсли;
	КонецЕсли;
	Тело.Вставить("transport", transport);

	Тело.Вставить("information1C", ПолучитьИнформацию1С());

	Способности = Новый Массив;
	Способности.Добавить("listUsers");
	Способности.Добавить("listTools");
	Способности.Добавить("getData");
	Тело.Вставить("capabilities", Способности);

	Возврат Тело;

КонецФункции

// Формирует конфигурацию по умолчанию из реквизитов справочника настройки.
// Удобно как стартовая точка для PUT /settings.
Функция КонфигурацияИзНастройки(Настройка) Экспорт

	Конфигурация = Новый Соответствие;
	Если Настройка = Неопределено Тогда
		Возврат Конфигурация;
	КонецЕсли;

	Конфигурация.Вставить("name", СокрЛП(Настройка.Наименование));
	Конфигурация.Вставить("mode", РежимРаботы(Настройка));
	Конфигурация.Вставить("status", СокрЛП(Настройка.Статус));
	Возврат Конфигурация;

КонецФункции

// Сериализует данные (Соответствие/Структура/Массив) в строку JSON.
Функция ПреобразоватьВСтрокуJSON(Данные) Экспорт

	Возврат Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(Данные);

КонецФункции

// Разбирает строку JSON в Соответствие/Массив.
// При некорректной строке возвращает Неопределено (пустой объект {} разбирается как
// пустое Соответствие, что для PUT/PATCH допустимо).
Функция РазобратьСтрокуJSON(СтрокаJSON) Экспорт

	СтрокаJSON = СокрЛП(СтрокаJSON);
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Разобранное = Б24_ИИ_ИнтеграцияВызовСервера.СтрокаJSONВСоответствие(СтрокаJSON);
		// Уточнение: отличаем валидный JSON от ошибки разбора.
		Если Лев(СтрокаJSON, 1) = "[" Тогда
			// Массив разобрали как Соответствие - вернём как есть (пустой/невалидный).
			// Для целей настройки ожидается объект или массив; возвращаем разобранное.
			Возврат Разобранное;
		КонецЕсли;
		Если Лев(СтрокаJSON, 1) = "{" Тогда
			Возврат Разобранное;
		КонецЕсли;
		Возврат Неопределено;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
