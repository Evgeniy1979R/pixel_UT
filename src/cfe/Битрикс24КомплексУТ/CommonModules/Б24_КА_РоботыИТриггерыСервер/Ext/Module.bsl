КонецЕсли;

	РоботБитрикс24 = Новый Структура;    // Выгрузка докумнета в XML
	РоботБитрикс24.Вставить("Имя"				, СтруктураИмен.ВыгрузкаДокументаВФайл);  
	РоботБитрикс24.Вставить("Название"			, "Выгрузка документа в файл");  
	
	мОписаниеПараметров = Новый Массив;
	мОписаниеПараметров.Добавить(Новый Структура("name, description", "doc", "Тип документа 1С в таймлайне"));
	РоботБитрикс24.Вставить("ОписаниеПараметров", мОписаниеПараметров);
#Область РоботВыгрузкаДокументаВфайл

	ДокументыРобота = Новый Массив;
			Если ТипКонфигурации = "УНФ" Тогда
				ДокументыРобота.Добавить(ПолучитьСтруктуруОписанияДокументаРобота(Метаданные.Документы["РасходнаяНакладная"].Синоним, Метаданные.Документы["РасходнаяНакладная"].ПолноеИмя()));
				ДокументыРобота.Добавить(ПолучитьСтруктуруОписанияДокументаРобота(Метаданные.Документы["АктВыполненныхРабот"].Синоним, Метаданные.Документы["АктВыполненныхРабот"].ПолноеИмя()));
			Иначе
				ДокументыРобота.Добавить(ПолучитьСтруктуруОписанияДокументаРобота(Метаданные.Документы["РеализацияТоваровУслуг"].Синоним, Метаданные.Документы["РеализацияТоваровУслуг"].ПолноеИмя()));
				Если ТипКонфигурации = "БП" Тогда
					ДокументыРобота.Добавить(ПолучитьСтруктуруОписанияДокументаРобота(Метаданные.Документы["ОказаниеУслуг"].Синоним, Метаданные.Документы["ОказаниеУслуг"].ПолноеИмя()));
				ИначеЕсли ТипКонфигурации = "УТ" Тогда
					ДокументыРобота.Добавить(ПолучитьСтруктуруОписанияДокументаРобота(Метаданные.Документы["АктВыполненныхРабот"].Синоним, Метаданные.Документы["АктВыполненныхРабот"].ПолноеИмя()));
				КонецЕсли;
			КонецЕсли;
	РоботБитрикс24.Вставить("Документы", ДокументыРобота);
	
	Результат.Добавить(РоботБитрикс24);
	
#КонецОбласти 
	
КонецЕсли;

	РоботБитрикс24 = Новый Структура;    // Проверка наличия дела
	РоботБитрикс24.Вставить("Имя"		, СтруктураИмен.ПроверкаНаличияДела);  
	РоботБитрикс24.Вставить("Название"	, "Проверка наличия дела");  
	
	мОписаниеПараметров = Новый Массив;
	мОписаниеПараметров.Добавить(Новый Структура("name, description", "doc", "Тип объекта 1С"));
	РоботБитрикс24.Вставить("ОписаниеПараметров", мОписаниеПараметров);
    
#Область РоботПроверкаНаличияДела
	
	ДокументыРобота = Новый Массив;
	
	мВидыМетаданных = Новый Массив;
	мВидыМетаданных.Добавить(Метаданные.Документы);
	мВидыМетаданных.Добавить(Метаданные.Справочники);
	Для каждого ТекВидМетаданных Из мВидыМетаданных Цикл
		
		Для каждого ТекОбъект Из ТекВидМетаданных Цикл
			
			Если ТекВидМетаданных = Метаданные.Документы Тогда 
				ПредставлениеОбъекта = "Документ: " + ТекОбъект.Синоним;   
			Иначе
				ПредставлениеОбъекта = "Справочник: " + ТекОбъект.Синоним;   
