Процедура ПодпискаНаСобытиеРегистрПриЗаписи(Источник, Отказ, Замещение) Экспорт 
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;    
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;          
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;  
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "ЗУП" Тогда 
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства = Источник.ДополнительныеСвойства;   
	
	ТипОбъекта 	= ТипЗнч(Источник); 
	Если ТипКонфигурации = "УНФ" Тогда
		Если ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрСведенийНаборЗаписей.ГрафикВыполненияЗаказов") Тогда      
		
			Если ДополнительныеСвойства.Свойство("Б24_КА_Отгрузки") Тогда
		
				//УникальныйИдентификатор = Новый УникальныйИдентификатор;
			
				ПараметрыВыгрузки = Новый Структура;
				ПараметрыВыгрузки.Вставить("мДокументы"	, ДополнительныеСвойства.Б24_КА_Отгрузки);
			
				Если НЕ Б24_КА_РоботыИТриггерыСерверПовтИсп.ТребуетсяВыполнениеТриггера("Документ.ЗаказПокупателя", "ЧастичнаяОтгрузкаДокумента")
					И НЕ Б24_КА_РоботыИТриггерыСерверПовтИсп.ТребуетсяВыполнениеТриггера("Документ.ЗаказПокупателя", "ОтгрузкаДокумента") 
					И НЕ Б24_КА_РоботыИТриггерыСерверПовтИсп.ТребуетсяВыполнениеТриггера("Документ.ЗаказПоставщику", "ЧастичнаяОтгрузкаДокумента") 
					И НЕ Б24_КА_РоботыИТриггерыСерверПовтИсп.ТребуетсяВыполнениеТриггера("Документ.ЗаказПоставщику", "ОтгрузкаДокумента") Тогда
					Возврат;
				КонецЕсли;
			
				Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_КА_РоботыИТриггерыСервер.ОбработатьТриггерОтгрузкаВФоне", "Обработка триггеров Битрикс24", ПараметрыВыгрузки, 5);  
			
			//ИначеЕсли ДополнительныеСвойства.Свойство("Б24_КА_ЧастичныеОтгрузки") Тогда
			//
			//	УникальныйИдентификатор = Новый УникальныйИдентификатор;
			//			
			//	ПараметрыВыгрузки = Новый Структура;
			//	ПараметрыВыгрузки.Вставить("мДокументы"	, ДополнительныеСвойства.Б24_КА_ЧастичныеОтгрузки);
			//			
			//	Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_КА_РоботыИТриггерыСервер.ОбработатьТриггерОтгрузкаВФоне", "Обработка триггеров Битрикс24", ПараметрыВыгрузки, 5);  
	
			КонецЕсли;		
		
		ИначеЕсли ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрСведенийНаборЗаписей.ФактОплатыЗаказов") 
			ИЛИ ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрСведенийНаборЗаписей.ФактОплатыДокументов") Тогда 
		
			Если ДополнительныеСвойства.Свойство("Б24_КА_Оплаты") Тогда
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_Оплаты Цикл  
				
					Если ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПокупателя") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПоставщику") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.АктВыполненныхРабот") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПриходнаяНакладная") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплату") 
						ИЛИ ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.РасходнаяНакладная") Тогда
					
						ОбработкаСобытияТриггера(ТекДокумент, "ОплатаДокумента");	
					
					КонецЕсли;
				
				КонецЦикла;
			КонецЕсли;
		
			Если ДополнительныеСвойства.Свойство("Б24_КА_ЧастичныеОплаты") Тогда
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_ЧастичныеОплаты Цикл  
				
					Если ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПокупателя") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПоставщику") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.АктВыполненныхРабот") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ПриходнаяНакладная") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплату") 
						ИЛИ ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") 
						ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.РасходнаяНакладная") Тогда
					
						ОбработкаСобытияТриггера(ТекДокумент, "ЧастичнаяОплатаДокумента");	
					
					КонецЕсли;
				
				КонецЦикла;
			КонецЕсли;
		
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "БП" Тогда
		Если ТипОбъекта =  Тип("РегистрСведенийНаборЗаписей.СтатусыДокументов") Тогда      
			
			Если ДополнительныеСвойства.Свойство("Б24_КА_Оплаты") Тогда
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_Оплаты Цикл  
					
					Если ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") 
						ИЛИ ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
						
						ОбработкаСобытияТриггера(ТекДокумент, "ОплатаДокумента");	
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Если ДополнительныеСвойства.Свойство("Б24_КА_ЧастичныеОплаты") Тогда
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_ЧастичныеОплаты Цикл  
					
					Если ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") 
						ИЛИ ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
						
						ОбработкаСобытияТриггера(ТекДокумент, "ЧастичнаяОплатаДокумента");	
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Если ДополнительныеСвойства.Свойство("Б24_КА_Отгрузки") Тогда
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_Отгрузки Цикл  
					
					Если ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") 
						ИЛИ ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
						
						ОбработкаСобытияТриггера(ТекДокумент, "ОтгрузкаДокумента");	
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Если ДополнительныеСвойства.Свойство("Б24_КА_ЧастичныеОтгрузки") Тогда
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_ЧастичныеОтгрузки Цикл  
					
					Если ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") 
						ИЛИ ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
						
						ОбработкаСобытияТриггера(ТекДокумент, "ЧастичнаяОтгрузкаДокумента");	
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		
		Если ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрСведенийНаборЗаписей.СостоянияЗаказовКлиентов")
			ИЛИ ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрСведенийНаборЗаписей.СостоянияЗаказовПоставщикам") Тогда      
			
			Если ДополнительныеСвойства.Свойство("Б24_КА_Отгрузки") Тогда   
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_Отгрузки Цикл  
					ОбработкаСобытияТриггера(ТекДокумент, "ОтгрузкаДокумента");	    
				КонецЦикла;
			КонецЕсли;		
			
			Если ДополнительныеСвойства.Свойство("Б24_КА_ЧастичныеОтгрузки") Тогда  
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_ЧастичныеОтгрузки Цикл  
					ОбработкаСобытияТриггера(ТекДокумент, "ЧастичнаяОтгрузкаДокумента");
				КонецЦикла;
			КонецЕсли;		
			
			Если ДополнительныеСвойства.Свойство("Б24_КА_Оплаты") Тогда
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_Оплаты Цикл  
					ОбработкаСобытияТриггера(ТекДокумент, "ОплатаДокумента");
				КонецЦикла;
			КонецЕсли;		
			
			Если ДополнительныеСвойства.Свойство("Б24_КА_ЧастичныеОплаты") Тогда   
				Для каждого ТекДокумент Из ДополнительныеСвойства.Б24_КА_ЧастичныеОплаты Цикл  
					ОбработкаСобытияТриггера(ТекДокумент, "ЧастичнаяОплатаДокумента");	   
				КонецЦикла;
			КонецЕсли;			
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры	

