						ДопПараметры 	= "&fields[PROVIDER_PARAMS][idAdress]=" + СтруктураНастроек.ИдентификаторПодключения + "&fields[PROVIDER_PARAMS][relAdress]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПолучитьНавигационнуюСсылку(СсылкаНаОбъект)); 
						
						ДопПараметры2 	= "&fields[FILES][1][0]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ДанныеФормирования.ПолноеИмяФайла) 
