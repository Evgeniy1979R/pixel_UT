 
#Область ПодпискиНаСобытия
 
Процедура ПодпискаНаСобытиеТриггераПриЗаписи(Источник, Отказ) Экспорт 
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;    
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;    
	
	Если НЕ Источник.ДополнительныеСвойства.Свойство("Б24_К_ОбъектНовый") Тогда
		ОбработкаСобытияТриггера(Источник.Ссылка, "ИзменениеДокумента");
	КонецЕсли;
	
КонецПроцедуры	
	 
Процедура ПодпискаНаСобытиеДокументОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт 
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;    
	
	Если НЕ Источник.ДополнительныеСвойства.Свойство("Б24_К_ДокументУжеПроведен") Тогда 
		Если Источник.ДополнительныеСвойства.Свойство("Б24_К_ДобавленаСвязка") ИЛИ НЕ Источник.ДополнительныеСвойства.Свойство("Б24_К_ОбъектНовый") Тогда
			ОбработкаСобытияТриггера(Источник.Ссылка, "Проведение");  
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	
 
Процедура ПодпискаНаСобытиеДокументОбработкаУдаленияПроведения(Источник, Отказ) Экспорт 
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;    
	
	Если Источник.ДополнительныеСвойства.Свойство("Б24_К_ДокументУжеПроведен") Тогда 
		Если Источник.ДополнительныеСвойства.Свойство("Б24_К_ДобавленаСвязка") ИЛИ НЕ Источник.ДополнительныеСвойства.Свойство("Б24_К_ОбъектНовый") Тогда
			ОбработкаСобытияТриггера(Источник.Ссылка, "Распроведение");  
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПроверитьЗапуститьТриггерПроведенияДокумента(Объект) Экспорт   
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации <> "УНФ" Тогда
		Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;    
	
	Если ОбщегоНазначения.ЭтоДокумент(Объект.Метаданные()) Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, "Проведен") Тогда 
			ОбработкаСобытияТриггера(Объект, "Проведение");  
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПодпискаНаСобытиеРегистрПередЗаписью(Источник, Отказ, Замещение) Экспорт 
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;    
	
	Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "ЗУП" Тогда 
		Возврат;
	КонецЕсли;
	
	ТипОбъекта 	= ТипЗнч(Источник); 
	
	Если ТипКонфигурации = "УНФ" Тогда
		Если ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрСведенийНаборЗаписей.ГрафикВыполненияЗаказов") Тогда   
		
			Б24_КА_Отгрузки 			= Новый Массив;
			Б24_КА_ЧастичныеОтгрузки 	= Новый Массив;
	#Область ЗаполнениеМассивов
			ТриггерыБитрикс24 = РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьКоличествоНастроекПодключенияАвтоматизации("ИспользоватьТриггеры", Истина) > 0;
			Если ТриггерыБитрикс24 <> Истина Тогда
				Возврат;
			КонецЕсли;
		
			СтарыйНаборЗаписей = РегистрыСведений["ГрафикВыполненияЗаказов"].СоздатьНаборЗаписей();
		
			Для Каждого ЗначениеОтбора Из Источник.Отбор Цикл
			
				Если ЗначениеОтбора.Использование = Ложь Тогда
					Продолжить;
				КонецЕсли;
			
				СтрокаОтбора = СтарыйНаборЗаписей.Отбор.Найти(ЗначениеОтбора.Имя);
				СтрокаОтбора.Значение = ЗначениеОтбора.Значение;
				СтрокаОтбора.Использование = Истина;
			
			КонецЦикла;
		            
			СтарыйНаборЗаписей.Прочитать();
		
			Если СтарыйНаборЗаписей.Количество() > 0 Тогда
			
				Если Источник.Количество() = 0 Тогда
					Для каждого ТекЗапись Из СтарыйНаборЗаписей Цикл
						Б24_КА_Отгрузки.Добавить(ТекЗапись.Заказ);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		
			Для каждого ТекЗапись Из Источник Цикл
				Если ТекЗапись.Выполнено > 0 Тогда
					Б24_КА_Отгрузки.Добавить(ТекЗапись.Заказ);
				КонецЕсли;
			КонецЦикла;

	#КонецОбласти       
	 		Источник.ДополнительныеСвойства.Вставить("Б24_КА_Отгрузки"			, Б24_КА_Отгрузки);   
			Источник.ДополнительныеСвойства.Вставить("Б24_КА_ЧастичныеОтгрузки"	, Б24_КА_Отгрузки);   

		ИначеЕсли ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрСведенийНаборЗаписей.ФактОплатыЗаказов") Тогда 
		
			Б24_КА_Оплаты 			= Новый Массив;
			Б24_КА_ЧастичныеОплаты 	= Новый Массив;
	#Область ЗаполнениеМассивов
			ТриггерыБитрикс24 = РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьКоличествоНастроекПодключенияАвтоматизации("ИспользоватьТриггеры", Истина) > 0;
			Если ТриггерыБитрикс24 <> Истина Тогда
				Возврат;
			КонецЕсли;   
		
			СтарыйНаборЗаписей = РегистрыСведений["ФактОплатыЗаказов"].СоздатьНаборЗаписей();
		
			Для Каждого ЗначениеОтбора Из Источник.Отбор Цикл
			
				Если ЗначениеОтбора.Использование = Ложь Тогда
					Продолжить;
				КонецЕсли;
			
				СтрокаОтбора = СтарыйНаборЗаписей.Отбор.Найти(ЗначениеОтбора.Имя);
				СтрокаОтбора.Значение = ЗначениеОтбора.Значение;
				СтрокаОтбора.Использование = Истина;
			
			КонецЦикла;
		
			СтарыйНаборЗаписей.Прочитать();
		
			Если СтарыйНаборЗаписей.Количество()= 0 Тогда
			
				Для Каждого ТекЗаписьИсточника Из Источник Цикл
				
					Если (ТекЗаписьИсточника.Сумма - ТекЗаписьИсточника.СуммаАванса - ТекЗаписьИсточника.СуммаОплаты) <= 0 Тогда
						Б24_КА_Оплаты.Добавить(ТекЗаписьИсточника.СчетНаОплату);
					ИначеЕсли ТекЗаписьИсточника.СуммаАванса > 0 ИЛИ ТекЗаписьИсточника.СуммаОплаты > 0 Тогда
						Б24_КА_ЧастичныеОплаты.Добавить(ТекЗаписьИсточника.СчетНаОплату);
					КонецЕсли;
				
				КонецЦикла;	
			
			Иначе
			
				Для каждого ТекЗапись Из СтарыйНаборЗаписей Цикл
				
					НужноОбновлять = Источник.Количество() = 0;
					Для Каждого ТекЗаписьИсточника Из Источник Цикл
					
						Если ТекЗапись.СчетНаОплату = ТекЗаписьИсточника.СчетНаОплату И (ТекЗапись.СуммаАванса <> ТекЗаписьИсточника.СуммаАванса ИЛИ ТекЗапись.СуммаОплаты <> ТекЗаписьИсточника.СуммаОплаты) Тогда
							НужноОбновлять = Истина;
							Прервать
						КонецЕсли;
					
					КонецЦикла;	
				
					Если НужноОбновлять = Истина Тогда
						Для Каждого ТекЗаписьИсточника Из Источник Цикл
						
							Если (ТекЗаписьИсточника.Сумма - ТекЗаписьИсточника.СуммаАванса - ТекЗаписьИсточника.СуммаОплаты) <= 0 Тогда
								Б24_КА_Оплаты.Добавить(ТекЗапись.СчетНаОплату);
							ИначеЕсли ТекЗаписьИсточника.СуммаАванса > 0 ИЛИ ТекЗаписьИсточника.СуммаОплаты > 0 Тогда
								Б24_КА_ЧастичныеОплаты.Добавить(ТекЗаписьИсточника.СчетНаОплату);
							КонецЕсли;
						
						КонецЦикла;	
					КонецЕсли;
				
				КонецЦикла;
			
			КонецЕсли;
	#КонецОбласти
	 		Источник.ДополнительныеСвойства.Вставить("Б24_КА_Оплаты"			, Б24_КА_Оплаты);   
			Источник.ДополнительныеСвойства.Вставить("Б24_КА_ЧастичныеОплаты"	, Б24_КА_ЧастичныеОплаты);   
		
		ИначеЕсли ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("РегистрСведенийНаборЗаписей.ФактОплатыДокументов") Тогда 
		
			Б24_КА_Оплаты 			= Новый Массив;
			Б24_КА_ЧастичныеОплаты 	= Новый Массив;
	#Область ЗаполнениеМассивов
			ТриггерыБитрикс24 = РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьКоличествоНастроекПодключенияАвтоматизации("ИспользоватьТриггеры", Истина) > 0;
			Если ТриггерыБитрикс24 <> Истина Тогда
				Возврат;
			КонецЕсли;   
			
			СтарыйНаборЗаписей = РегистрыСведений["ФактОплатыДокументов"].СоздатьНаборЗаписей();
		
			Для Каждого ЗначениеОтбора Из Источник.Отбор Цикл
			
				Если ЗначениеОтбора.Использование = Ложь Тогда
					Продолжить;
				КонецЕсли;
			
				СтрокаОтбора = СтарыйНаборЗаписей.Отбор.Найти(ЗначениеОтбора.Имя);
				СтрокаОтбора.Значение = ЗначениеОтбора.Значение;
				СтрокаОтбора.Использование = Истина;
			
			КонецЦикла;
		
			СтарыйНаборЗаписей.Прочитать();
		
			Если СтарыйНаборЗаписей.Количество()= 0 Тогда
			
				Для Каждого ТекЗаписьИсточника Из Источник Цикл
				
					Если (ТекЗаписьИсточника.Сумма - ТекЗаписьИсточника.СуммаАванса - ТекЗаписьИсточника.СуммаОплаты) <= 0 Тогда
						Б24_КА_Оплаты.Добавить(ТекЗаписьИсточника.Документ);
					ИначеЕсли ТекЗаписьИсточника.СуммаАванса > 0 ИЛИ ТекЗаписьИсточника.СуммаОплаты > 0 Тогда
						Б24_КА_ЧастичныеОплаты.Добавить(ТекЗаписьИсточника.Документ);
					КонецЕсли;
				
				КонецЦикла;	
			
			Иначе
			
				Для каждого ТекЗапись Из СтарыйНаборЗаписей Цикл
				
					НужноОбновлять = Источник.Количество() = 0;
					Для Каждого ТекЗаписьИсточника Из Источник Цикл
					
						Если ТекЗапись.Документ = ТекЗаписьИсточника.Документ И (ТекЗапись.СуммаАванса <> ТекЗаписьИсточника.СуммаАванса ИЛИ ТекЗапись.СуммаОплаты <> ТекЗаписьИсточника.СуммаОплаты) Тогда
							НужноОбновлять = Истина;
							Прервать
						КонецЕсли;
					
					КонецЦикла;	
				
					Если НужноОбновлять = Истина Тогда
						Для Каждого ТекЗаписьИсточника Из Источник Цикл
						
							Если (ТекЗаписьИсточника.Сумма - ТекЗаписьИсточника.СуммаАванса - ТекЗаписьИсточника.СуммаОплаты) <= 0 Тогда
								Б24_КА_Оплаты.Добавить(ТекЗапись.Документ);
							ИначеЕсли ТекЗаписьИсточника.СуммаАванса > 0 ИЛИ ТекЗаписьИсточника.СуммаОплаты > 0 Тогда
								Б24_КА_ЧастичныеОплаты.Добавить(ТекЗаписьИсточника.Документ);
							КонецЕсли;
						
						КонецЦикла;	
					КонецЕсли;
				
				КонецЦикла;
			
			КонецЕсли;
	#КонецОбласти
	 		Источник.ДополнительныеСвойства.Вставить("Б24_КА_Оплаты"			, Б24_КА_Оплаты);   
			Источник.ДополнительныеСвойства.Вставить("Б24_КА_ЧастичныеОплаты"	, Б24_КА_ЧастичныеОплаты);   
		
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "БП" Тогда
		Если ТипОбъекта =  Тип("РегистрСведенийНаборЗаписей.СтатусыДокументов") Тогда   
			
			Б24_КА_Отгрузки 			= Новый Массив;
			Б24_КА_Оплаты 				= Новый Массив;
			Б24_КА_ЧастичныеОплаты 		= Новый Массив;
			Б24_КА_ЧастичныеОтгрузки 	= Новый Массив;
			#Область ЗаполнениеМассивов
			ТриггерыБитрикс24 = РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьКоличествоНастроекПодключенияАвтоматизации("ИспользоватьТриггеры", Истина) > 0;
			Если ТриггерыБитрикс24 <> Истина Тогда
				Возврат;
			КонецЕсли;
			
			СтарыйНаборЗаписей = РегистрыСведений["СтатусыДокументов"].СоздатьНаборЗаписей();
			
			Для Каждого ЗначениеОтбора Из Источник.Отбор Цикл
				
				Если ЗначениеОтбора.Использование = Ложь Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаОтбора = СтарыйНаборЗаписей.Отбор.Найти(ЗначениеОтбора.Имя);
				СтрокаОтбора.Значение = ЗначениеОтбора.Значение;
				СтрокаОтбора.Использование = Истина;
				
			КонецЦикла;
			
			СтарыйНаборЗаписей.Прочитать();
			
			Если СтарыйНаборЗаписей.Количество()= 0 Тогда
				
				Для Каждого ТекЗаписьИсточника Из Источник Цикл
					
					Если ТекЗаписьИсточника.Статус = Перечисления["СтатусОплатыСчета"].Оплачен Тогда 
						Б24_КА_Оплаты.Добавить(ТекЗаписьИсточника.Документ);
					КонецЕсли;
					
					Если ТекЗаписьИсточника.ДополнительныйСтатус = Перечисления["СтатусыОтгрузки"].Отгружен 
						ИЛИ ТекЗаписьИсточника.ДополнительныйСтатус = Перечисления["СтатусыПоступленияПоСчету"].Получен Тогда 
						Б24_КА_Отгрузки.Добавить(ТекЗаписьИсточника.Документ);
					КонецЕсли;
					
					Если ТекЗаписьИсточника.ДополнительныйСтатус = Перечисления["СтатусыОтгрузки"].ОтгруженЧастично 
						ИЛИ ТекЗаписьИсточника.ДополнительныйСтатус = Перечисления["СтатусыПоступленияПоСчету"].ПолученЧастично Тогда 
						Б24_КА_ЧастичныеОтгрузки.Добавить(ТекЗаписьИсточника.Документ);
					КонецЕсли;
					
					Если ТекЗаписьИсточника.Статус = Перечисления["СтатусОплатыСчета"].ОплаченЧастично Тогда 
						Б24_КА_ЧастичныеОплаты.Добавить(ТекЗаписьИсточника.Документ);
					КонецЕсли;
					
				КонецЦикла;	
				
			Иначе
				
				Для каждого ТекЗапись Из СтарыйНаборЗаписей Цикл
					
					НужноОбновлять = Источник.Количество() = 0;
					Для Каждого ТекЗаписьИсточника Из Источник Цикл
						
						Если ТекЗапись.Документ = ТекЗаписьИсточника.Документ И (ТекЗапись.Статус <> ТекЗаписьИсточника.Статус ИЛИ ТекЗапись.ДополнительныйСтатус <> ТекЗаписьИсточника.ДополнительныйСтатус) Тогда
							НужноОбновлять = Истина;
							Прервать
						КонецЕсли;
						
					КонецЦикла;	
					
					Если НужноОбновлять = Истина Тогда
						Для Каждого ТекЗаписьИсточника Из Источник Цикл
							
							Если ТекЗапись.Документ = ТекЗаписьИсточника.Документ И ТекЗапись.Статус <> ТекЗаписьИсточника.Статус Тогда
								Если ТекЗаписьИсточника.Статус = Перечисления["СтатусОплатыСчета"].Оплачен Тогда 
									Б24_КА_Оплаты.Добавить(ТекЗапись.Документ);
								КонецЕсли;
							КонецЕсли;
							
							Если ТекЗапись.Документ = ТекЗаписьИсточника.Документ И ТекЗапись.ДополнительныйСтатус <> ТекЗаписьИсточника.ДополнительныйСтатус Тогда
								Если ТекЗаписьИсточника.ДополнительныйСтатус = Перечисления["СтатусыОтгрузки"].Отгружен 
									ИЛИ ТекЗаписьИсточника.ДополнительныйСтатус = Перечисления["СтатусыПоступленияПоСчету"].Получен Тогда 
									Б24_КА_Отгрузки.Добавить(ТекЗапись.Документ);
								КонецЕсли;
							КонецЕсли;
							
							Если ТекЗапись.Документ = ТекЗаписьИсточника.Документ И ТекЗапись.ДополнительныйСтатус <> ТекЗаписьИсточника.ДополнительныйСтатус Тогда
								Если ТекЗаписьИсточника.ДополнительныйСтатус = Перечисления["СтатусыОтгрузки"].ОтгруженЧастично 
									ИЛИ ТекЗаписьИсточника.ДополнительныйСтатус = Перечисления["СтатусыПоступленияПоСчету"].ПолученЧастично Тогда 
