#Область ФормыЭлементов

Процедура ДобавлениеЭлементовФормыДляТриггеров(Форма) Экспорт

	УстановитьПривилегированныйРежим(Истина);       
	
	Если НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ЕстьПраваНаРаботуСМодулем() Тогда
		Возврат;
	КонецЕсли;
	
	Объект 	= Форма.Объект.Ссылка;
	
	НастройкиПодключения = Б24_КА_РоботыИТриггерыСерверПовтИсп.ПолучитьМассивНастроекАвтоматизации("ИспользоватьТриггеры", Истина); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкиПодключения"	, НастройкиПодключения);
	Запрос.УстановитьПараметр("ТипыДанных"				, Б24_К_RestApiВызовСервера.ПолучитьТипыДанныхДел());
	Запрос.УстановитьПараметр("ТипОбъекта"				, Объект.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("ИдентификаторОбъекта"	, XMLСтрока(Объект));
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_НастройкиПодключения.Портал КАК Портал
	|ПОМЕСТИТЬ ВТ_Порталы
	|ИЗ
	|	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|ГДЕ
	|	Б24_К_НастройкиПодключения.Ссылка В(&НастройкиПодключения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_К_ИдентификаторыДел.Портал КАК Портал,
	|	Б24_К_ИдентификаторыДел.Идентификатор КАК Идентификатор,
	|	Б24_К_ИдентификаторыДел.ТипДанных КАК ТипДанных
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.Портал В
	|			(ВЫБРАТЬ
	|				ВТ_Порталы.Портал
	|			ИЗ
	|				ВТ_Порталы)
	|	И Б24_К_ИдентификаторыДел.ТипДанных В(&ТипыДанных)
	|	И Б24_К_ИдентификаторыДел.ТипОбъекта = &ТипОбъекта
	|	И Б24_К_ИдентификаторыДел.ИдентификаторОбъекта = &ИдентификаторОбъекта";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	Если ВыполненныйЗапрос.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ИмяГруппы = "Б24_КА_ГруппаТриггеровКомандБитрикс24";
	Если ТипКонфигурации = "УНФ" Тогда
		НоваяКоманднаяПанель 				= Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Форма.КоманднаяПанель);
	Иначе
		НайденнаяКоманднаяПанель = Форма.Элементы.Найти("ГруппаКоманднаяПанель");
		НайденнаяКоманднаяПанель = ?(НайденнаяКоманднаяПанель = Неопределено, Форма.КоманднаяПанель, НайденнаяКоманднаяПанель);
		
		НоваяКоманднаяПанель 				= Форма.Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), НайденнаяКоманднаяПанель);
	КонецЕсли;
	НоваяКоманднаяПанель.Заголовок 		= "Сообщить";
	НоваяКоманднаяПанель.Вид 			= ВидГруппыФормы.Подменю;
	НоваяКоманднаяПанель.Картинка 		= БиблиотекаКартинок.Б24_К_Лого;
	НоваяКоманднаяПанель.Отображение 	= ОтображениеКнопки.КартинкаИТекст;
	
	ИмяКоманды = "Б24_КА_ОтправитьСообщениеОК";
	
	КомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
	КомандаФормы.Действие	= ИмяКоманды;
	КомандаФормы.Заголовок	= ИмяКоманды;		
	
	НовыйЭлемент 			= Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы[ИмяГруппы]);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.Заголовок 	= "Все корректно";     
	НовыйЭлемент.Отображение= ОтображениеКнопки.Текст;
	Форма.Элементы.Переместить(НовыйЭлемент, Форма.Элементы[ИмяГруппы]); 
	
	ИмяКоманды = "Б24_КА_ОтправитьСообщениеОшибка";
	КомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
	КомандаФормы.Действие	= ИмяКоманды;
	КомандаФормы.Заголовок	= ИмяКоманды;		
	
	НовыйЭлемент 			= Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы[ИмяГруппы]);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.Заголовок 	= "Есть ошибка";     
	НовыйЭлемент.Отображение= ОтображениеКнопки.Текст;
	Форма.Элементы.Переместить(НовыйЭлемент, Форма.Элементы[ИмяГруппы]); 
	
КонецПроцедуры

#КонецОбласти


#Область Триггеры

Процедура ОбновитьСписокЗарегистрированныхТриггеров(ИдентификаторПодключения, Портал, мДанныеОТриггерах) Экспорт
	
	СтруктураИменТриггеров = ПолучитьСтруктуруИменТриггеров();
	
	НаборЗаписей = РегистрыСведений.Б24_КА_ЗарегистрированныеТриггеры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторПодключения.Установить(ИдентификаторПодключения);
	НаборЗаписей.Отбор.Портал.Установить(Портал);
	НаборЗаписей.Записать();
	
	Для каждого ТекЭлемент Из мДанныеОТриггерах Цикл 
		
		ИмяТриггера = "";
		ИдДокумента = "";
		Для каждого ТекИмя Из СтруктураИменТриггеров Цикл 
			
			НомерСимвола = СтрНайти(ТекЭлемент.Код, ТекИмя.Значение); 
			
			Если НомерСимвола > 0 Тогда
				КодТриггера	= ТекЭлемент.Код;
				ИмяТриггера = ТекИмя.Значение;	
				
				ДлинаКодаТриггера 	= СтрДлина(ТекЭлемент.Код);
				ДлинаИмениТриггера 	= СтрДлина(ТекИмя.Значение);
				
				ИдДокумента = Прав(ТекЭлемент.Код, ДлинаКодаТриггера - ДлинаИмениТриггера - НомерСимвола);  
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ИдентификаторПодключения 	= ИдентификаторПодключения;
		НоваяЗапись.Портал 						= Портал;
		НоваяЗапись.ИмяТриггера 				= ИмяТриггера;
		НоваяЗапись.ИдДокумента 				= ИдДокумента;
		НоваяЗапись.КодТриггера   				= КодТриггера;
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Функция ПолучитьНастройкиТриггеров() Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	ОписаниеИспользуемыхДокументов 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьОписаниеИспользуемыхДокументов();
	ИдентификаторыИспользуемыхДокументов 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИдентификаторыИспользуемыхДокументов();
	
	СтруктураИмен = ПолучитьСтруктуруИменТриггеров();
	
	Результат = Новый Массив;
	
	ТриггерБитрикс24 = Новый Структура;    // Проведение документа 1С 
	ТриггерБитрикс24.Вставить("Имя"			, СтруктураИмен.Проведение);  
	ТриггерБитрикс24.Вставить("Название"	, "Проведение документа");  
#Область ТриггерПроведениеДокумента

	ДокументыТриггера = Новый Массив;       

	Для каждого ТекОбъект Из Метаданные.Документы Цикл 
		
		Если ТекОбъект.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда   
			ПредставлениеОбъекта = "Документ: " + ТекОбъект.Синоним;
			ДокументыТриггера.Добавить(ПолучитьСтруктуруОписанияДокументаТриггера(ПредставлениеОбъекта, ""));
		КонецЕсли;
		
	КонецЦикла;        
	
	ТриггерБитрикс24.Вставить("Документы", ДокументыТриггера);
	
	Результат.Добавить(ТриггерБитрикс24);
	
#КонецОбласти

	
	ТриггерБитрикс24 = Новый Структура;    // Распроведение документа 1С 
	ТриггерБитрикс24.Вставить("Имя"			, СтруктураИмен.Распроведение);  
	ТриггерБитрикс24.Вставить("Название"	, "Распроведение документа");  
#Область ТриггерРаспроведениеДокумента

	ДокументыТриггера = Новый Массив;
	
	Для каждого ТекОбъект Из Метаданные.Документы Цикл 
		
		Если ТекОбъект.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда   
			ПредставлениеОбъекта = "Документ: " + ТекОбъект.Синоним;
			ДокументыТриггера.Добавить(ПолучитьСтруктуруОписанияДокументаТриггера(ПредставлениеОбъекта, ""));
		КонецЕсли;
		
	КонецЦикла;        
	
	ТриггерБитрикс24.Вставить("Документы", ДокументыТриггера);
	
	Результат.Добавить(ТриггерБитрикс24);
	
#КонецОбласти

	
	ТриггерБитрикс24 = Новый Структура;    // Изменение документа 
	ТриггерБитрикс24.Вставить("Имя"			, СтруктураИмен.ИзменениеДокумента);  
	ТриггерБитрикс24.Вставить("Название"	, "Изменение объекта 1С");  
#Область ТриггерИзменениеДокумента

	ДокументыТриггера = Новый Массив;     
	
	мВидыМетаданных = Новый Массив;
	мВидыМетаданных.Добавить(Метаданные.Документы);
	мВидыМетаданных.Добавить(Метаданные.Справочники);
	
	Для каждого ТекВидМетаданных Из мВидыМетаданных Цикл
		
		Для каждого ТекОбъект Из ТекВидМетаданных Цикл
		
