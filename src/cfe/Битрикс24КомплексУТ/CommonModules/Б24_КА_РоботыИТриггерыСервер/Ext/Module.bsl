	Б24_К_ОбщегоНазначенияВызовСервера.СортироватьМассив(ДокументыРобота, НаправлениеСортировки.Возр, "Название");    
	
	РоботБитрикс24.Вставить("Документы", ДокументыРобота);

	Результат.Добавить(РоботБитрикс24);
	
#КонецОбласти
	
	Возврат Результат;
	
КонецФункции

Функция НастройкиРоботаСозданияНаОсновании() Экспорт
	
	ОбъектыРобота = Новый Массив;
	
	ОснованияОбъектов = Новый Соответствие;
	
	мВидыМетаданных = Новый Массив;
	мВидыМетаданных.Добавить(Метаданные.Документы);
	мВидыМетаданных.Добавить(Метаданные.Справочники);
	Для каждого ВидМетаданных Из мВидыМетаданных Цикл
		
		Для каждого ОбъектМетаданных Из ВидМетаданных Цикл
			
			Для каждого ОснованиеОбъекта Из ОбъектМетаданных.ВводитсяНаОсновании Цикл
				
				ПодчиненныеДокументы = ОснованияОбъектов.Получить(ОснованиеОбъекта);
				Если ПодчиненныеДокументы = Неопределено Тогда   
					ПодчиненныеДокументы = Новый Массив;
				КонецЕсли;
				
				ПодчиненныеДокументы.Добавить(ОбъектМетаданных);
				
				ОснованияОбъектов.Вставить(ОснованиеОбъекта, ПодчиненныеДокументы);
				
			КонецЦикла;	
			
		КонецЦикла;	
		
	КонецЦикла;	
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УНФ" Тогда
		ОперацияПоПлатежнымКартам = Метаданные.Документы["ОперацияПоПлатежнымКартам"];
		КомандаОплатаПлатежнойКартой = ОперацияПоПлатежнымКартам.Команды.Найти("ОплатаПлатежнойКартой");
	КонецЕсли;
	
	Для каждого ВидМетаданных Из мВидыМетаданных Цикл
		
		Для каждого ОснованиеОбъектов Из ОснованияОбъектов Цикл
			
			Если НЕ ВидМетаданных.Содержит(ОснованиеОбъектов.Ключ) Тогда    
				Продолжить;	
			КонецЕсли;
			
			Если Метаданные.Документы.Содержит(ОснованиеОбъектов.Ключ) Тогда    
				ПредставлениеОбъекта = "Документ: " + ОснованиеОбъектов.Ключ.Синоним;
			ИначеЕсли Метаданные.Справочники.Содержит(ОснованиеОбъектов.Ключ) Тогда
				ПредставлениеОбъекта = "Справочник: " + ОснованиеОбъектов.Ключ.Синоним;
			КонецЕсли;
			
			ДокументыНаОсновании = Новый Массив;
			Для каждого ПодчиненныйОбъект Из ОснованиеОбъектов.Значение Цикл       
				
				Если Метаданные.Документы.Содержит(ПодчиненныйОбъект) Тогда    
					ПредставлениеПодчиненногоОбъекта = "Документ: " + ПодчиненныйОбъект.Синоним;
				ИначеЕсли Метаданные.Справочники.Содержит(ПодчиненныйОбъект) Тогда
					ПредставлениеПодчиненногоОбъекта = "Справочник: " + ПодчиненныйОбъект.Синоним;     
				КонецЕсли;
				
				ДокументыНаОсновании.Добавить(Новый Структура("Ид, Имя", ПодчиненныйОбъект.ПолноеИмя(), ПредставлениеПодчиненногоОбъекта));   
				
			КонецЦикла;    
			
			Если ТипКонфигурации = "УНФ" Тогда
				Если КомандаОплатаПлатежнойКартой <> Неопределено Тогда  
					
					ТипыКоманды = КомандаОплатаПлатежнойКартой.ТипПараметраКоманды.Типы();
					Для каждого ТекТип Из ТипыКоманды Цикл    
						
						Если ОснованиеОбъектов.Ключ = Метаданные.НайтиПоТипу(ТекТип) Тогда 
							ДокументНаОсновании = Новый Структура("Ид, Имя", ОперацияПоПлатежнымКартам.ПолноеИмя(), ОперацияПоПлатежнымКартам.Синоним); 
							Если ДокументыНаОсновании.Найти(ДокументНаОсновании) = Неопределено Тогда ДокументыНаОсновании.Добавить(ДокументНаОсновании) КонецЕсли;	
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;    
			КонецЕсли;
			
			Если ДокументыНаОсновании.Количество() > 0 Тогда     
				ОбъектыРобота.Добавить(ПолучитьСтруктуруОписанияДокументаРобота(ПредставлениеОбъекта, ОснованиеОбъектов.Ключ.ПолноеИмя(),, ДокументыНаОсновании));        
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;                                      
	
	Б24_К_ОбщегоНазначенияВызовСервера.СортироватьМассив(ОбъектыРобота, НаправлениеСортировки.Возр, "Название");
	
	Возврат ОбъектыРобота;
	
КонецФункции

Функция ПолучитьСтруктуруИменРоботов() Экспорт
	
	Результат = Новый Структура;
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "ЗУП" Тогда
		
		Результат.Вставить("Проведение"						, "rExecution1C");
		Результат.Вставить("Распроведение"					, "rAntiExecution1C");
		Результат.Вставить("ЭкспортПечатнойФормы2"			, "rPrint1C2");
		Результат.Вставить("СозданиеОбъектаНаОсновании"		, "rCreate1C2");
		Результат.Вставить("ПроизвольныйРобот"				, "rCustom");	 
		Результат.Вставить("ВыгрузкаДокументаВФайл"			, "rExportDoc");	
		Результат.Вставить("ПроверкаНаличияДела"			, "rActivityChecking");
		
	ИначеЕсли ТипКонфигурации = "БП" 
		или ТипКонфигурации = "УТ" 
		или ТипКонфигурации = "УНФ" Тогда
		
		Результат.Вставить("Проведение"						, "rExecution1C");
		Результат.Вставить("Распроведение"					, "rAntiExecution1C");
		Результат.Вставить("ЭкспортПечатнойФормы"			, "rPrint1C");
		Результат.Вставить("СозданиеДокументаНаОсновании"	, "rCreate1C");
		Результат.Вставить("ЭкспортПечатнойФормы2"			, "rPrint1C2");
		Результат.Вставить("СозданиеОбъектаНаОсновании"		, "rCreate1C2");
		Результат.Вставить("ПроизвольныйРобот"				, "rCustom"); 
		Результат.Вставить("ПечатьЧека"						, "rPrintCheck"); 
		Результат.Вставить("ВыгрузкаДокументаВФайл"			, "rExportDoc");	
		Результат.Вставить("ПроверкаНаличияДела"			, "rActivityChecking");   
			
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НазваниеРоботаПоКоду(КодРобота) Экспорт    
	
	Результат = "";
	
	Если СтрНайти(КодРобота, "rExecution1C") > 0 Тогда        
		Результат = "Проведение документа";
	ИначеЕсли СтрНайти(КодРобота, "rAntiExecution1C") > 0 Тогда   
		Результат = "Распроведение документа";   
	ИначеЕсли СтрНайти(КодРобота, "rPrint1C2") > 0 Тогда
		Результат = "Импорт печатной формы 1С v.2";
	ИначеЕсли СтрНайти(КодРобота, "rCreate1C2") > 0 Тогда
		Результат = "Создание объекта 1С на основании";
	ИначеЕсли СтрНайти(КодРобота, "rPrintCheck") > 0 Тогда             
		Результат = "Добавить в очередь печати чека"; 	
	ИначеЕсли СтрНайти(КодРобота, "rExportDoc") > 0 Тогда            
		Результат = "Выгрузка документа в файл";       
	ИначеЕсли СтрНайти(КодРобота, "rActivityChecking") > 0 Тогда            
		Результат = "Проверка наличия дела";         
	ИначеЕсли СтрНайти(КодРобота, "rPrint1C") > 0 Тогда				// устаревший
		Результат = "Импорт печатной формы 1С";
	ИначеЕсли СтрНайти(КодРобота, "rCreate1C") > 0 Тогда             // устаревший
		Результат = "Создание документа 1С на основании";       
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Процедура ДозаполнитьОбъектПоОснованию(ОбъектОснование, НовыйОбъект) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УТ" Тогда
		ТипОснования 	= ТипЗнч(ОбъектОснование);
		ТипОбъекта 		= ТипЗнч(НовыйОбъект);
		МодульДенежныеСредстваСервер = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ДенежныеСредстваСервер");
		МодульЗначениеНастроекПовтИсп = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ЗначениеНастроекПовтИсп");
		МодульСинхронизацииБ24 = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КС_ОбщегоНазначенияВызовСервера");
		
		Если ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ОперацияПоПлатежнойКарте") Тогда
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ХозяйственнаяОперация) Тогда
				Если ТипЗнч(ОбъектОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
					НовыйОбъект.ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"].ВозвратДенежныхСредствОтПоставщика;
				Иначе
					НовыйОбъект.ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"]["ПоступлениеОплатыОтКлиента"];
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Контрагент) Тогда
				НовыйОбъект.Контрагент = ОбъектОснование.Контрагент;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Организация) Тогда
				НовыйОбъект.Организация	= ОбъектОснование.Организация;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ЭквайринговыйТерминал) Тогда
					НовыйОбъект.ЭквайринговыйТерминал = Справочники["ЭквайринговыеТерминалы"].ЭквайринговыйТерминалПоУмолчанию(ОбъектОснование.Организация);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Валюта) Тогда
				НовыйОбъект.Валюта	= ОбъектОснование.Валюта;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.СтатьяДвиженияДенежныхСредств) Тогда
					НовыйОбъект.СтатьяДвиженияДенежныхСредств = Справочники["СтатьиДвиженияДенежныхСредств"]["ПоступлениеОплатыОтКлиента"];
			КонецЕсли;
			
			Для каждого ТекСтрока Из НовыйОбъект.РасшифровкаПлатежа Цикл
				Если НЕ ЗначениеЗаполнено(ТекСтрока.СтатьяДвиженияДенежныхСредств) Тогда
					ТекСтрока.СтатьяДвиженияДенежныхСредств = НовыйОбъект.СтатьяДвиженияДенежныхСредств;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТекСтрока.ВалютаВзаиморасчетов) Тогда
					ТекСтрока.ВалютаВзаиморасчетов = НовыйОбъект.Валюта;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств") Тогда
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ХозяйственнаяОперация) Тогда
				Если ТипЗнч(ОбъектОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
					НовыйОбъект.ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"].ВозвратДенежныхСредствОтПоставщика;
				Иначе
					НовыйОбъект.ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"]["ПоступлениеОплатыОтКлиента"];
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ТипПлатежногоДокумента) Тогда
				НовыйОбъект.ТипПлатежногоДокумента	= Перечисления["ТипыПлатежныхДокументов"].ПлатежноеПоручение;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Контрагент) Тогда
				НовыйОбъект.Контрагент	= ОбъектОснование.Контрагент;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Организация) Тогда
				НовыйОбъект.Организация	= ОбъектОснование.Организация;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Валюта) Тогда
				НовыйОбъект.Валюта	= ОбъектОснование.Валюта;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.БанковскийСчет) Тогда
				БанковскийСчетОснования = Неопределено;
				РеквизитыОснования = ОбъектОснование.Метаданные().Реквизиты;
				Если РеквизитыОснования.Найти("БанковскийСчет") <> Неопределено Тогда
					БанковскийСчетОснования	= ОбъектОснование.БанковскийСчет;
				ИначеЕсли РеквизитыОснования.Найти("БанковскийСчетОрганизации") <> Неопределено Тогда
					БанковскийСчетОснования	= ОбъектОснование.БанковскийСчетОрганизации;
				КонецЕсли;

				НовыйОбъект.БанковскийСчет 	= МодульСинхронизацииБ24.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(
					ОбъектОснование.Организация, Неопределено, БанковскийСчетОснования, Неопределено, Неопределено);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.СтатьяДвиженияДенежныхСредств) Тогда
					НовыйОбъект.СтатьяДвиженияДенежныхСредств	= Справочники["СтатьиДвиженияДенежныхСредств"]["ПоступлениеОплатыОтКлиента"];
			КонецЕсли;
			
			Для каждого ТекСтрока Из НовыйОбъект.РасшифровкаПлатежа Цикл
				Если НЕ ЗначениеЗаполнено(ТекСтрока.СтатьяДвиженияДенежныхСредств) Тогда
					ТекСтрока.СтатьяДвиженияДенежныхСредств = НовыйОбъект.СтатьяДвиженияДенежныхСредств;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТекСтрока.Организация) Тогда
					ТекСтрока.Организация = НовыйОбъект.Организация;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТекСтрока.ВалютаВзаиморасчетов) Тогда
					ТекСтрока.ВалютаВзаиморасчетов = НовыйОбъект.Валюта;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипОбъекта = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
			
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ХозяйственнаяОперация) Тогда
				Если ТипЗнч(ОбъектОснование) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
					НовыйОбъект.ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"].ВозвратДенежныхСредствОтПоставщика;
				Иначе
					НовыйОбъект.ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"]["ПоступлениеОплатыОтКлиента"];
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Контрагент) Тогда
				НовыйОбъект.Контрагент	= ОбъектОснование.Контрагент;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Организация) Тогда
				НовыйОбъект.Организация	= ОбъектОснование.Организация;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Валюта) Тогда
				НовыйОбъект.Валюта	= ОбъектОснование.Валюта;  
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект["Касса"]) Тогда
				СтруктураПараметров = МодульДенежныеСредстваСервер.ПараметрыЗаполненияКассыОрганизацииПоУмолчанию();
				СтруктураПараметров.Организация = ОбъектОснование.Организация;
				Если ОбъектОснование.Метаданные().Реквизиты.Найти("ФормаОплаты") <> Неопределено Тогда
					СтруктураПараметров.ФормаОплаты	= ОбъектОснование.ФормаОплаты;
				КонецЕсли;
				Если ОбъектОснование.Метаданные().Реквизиты.Найти("Касса") <> Неопределено Тогда
					СтруктураПараметров["Касса"] = ОбъектОснование.Касса;
				КонецЕсли;
				НовыйОбъект["Касса"]  = МодульЗначениеНастроекПовтИсп.ПолучитьКассуОрганизацииПоУмолчанию(СтруктураПараметров);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.СтатьяДвиженияДенежныхСредств) Тогда
					НовыйОбъект.СтатьяДвиженияДенежныхСредств	= Справочники["СтатьиДвиженияДенежныхСредств"]["ПоступлениеОплатыОтКлиента"];
			КонецЕсли;
			
			Для каждого ТекСтрока Из НовыйОбъект.РасшифровкаПлатежа Цикл
				Если НЕ ЗначениеЗаполнено(ТекСтрока.СтатьяДвиженияДенежныхСредств) Тогда
					ТекСтрока.СтатьяДвиженияДенежныхСредств = НовыйОбъект.СтатьяДвиженияДенежныхСредств;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТекСтрока.Организация) Тогда
					ТекСтрока.Организация = НовыйОбъект.Организация;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ТекСтрока.ВалютаВзаиморасчетов) Тогда
					ТекСтрока.ВалютаВзаиморасчетов = НовыйОбъект.Валюта;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
			
			Если НЕ ЗначениеЗаполнено(НовыйОбъект["СпособДоставки"]) Тогда
				НовыйОбъект["СпособДоставки"] = Перечисления["СпособыДоставки"].СиламиПоставщикаДоНашегоСклада;
			КонецЕсли;
			
		ИначеЕсли ТипОбъекта = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
			
			Если ТипЗнч(ОбъектОснование) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказКлиента") Тогда
				
				Если НЕ ЗначениеЗаполнено(НовыйОбъект["СпособДоставки"]) Тогда
					НовыйОбъект["СпособДоставки"]	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектОснование, "СпособДоставки");  
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ОбъектОснование) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ВозвратТоваровОтКлиента") Тогда
				НовыйОбъект["Статус"] 						= Перечисления["СтатусыРеализацийТоваровУслуг"].КПредоплате;
				НовыйОбъект["СпособДоставки"] 				= Перечисления["СпособыДоставки"].Самовывоз;
				НовыйОбъект["ВариантОформленияПродажи"] 	= Перечисления["ВариантыОформленияПродажи"].РеализацияТоваровУслуг;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НовыйОбъект.Метаданные().Реквизиты.Найти("СкидкиРассчитаны") <> Неопределено Тогда
			НовыйОбъект.СкидкиРассчитаны = Истина;
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
	
		ТипОснования 	= ТипЗнч(ОбъектОснование);
		ТипОбъекта 		= ТипЗнч(НовыйОбъект);
	
		Если ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ЗаказПокупателя") Тогда
	
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ВидОперации) Тогда
				Если ТипОснования = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплату") ИЛИ ТипОснования = Тип("СправочникСсылка.Контрагенты") Тогда
						НовыйОбъект.ВидОперации 	= Перечисления["ВидыОперацийЗаказПокупателя"].ЗаказНаПродажу;
					НовыйОбъект.ДатаОтгрузки 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса()+7*24*60*60;
				КонецЕсли;
			КонецЕсли; 
		
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ЗаказПоставщику") Тогда
	
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ВидОперации) Тогда
				Если ТипОснования = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
						НовыйОбъект.ВидОперации 		= Перечисления["ВидыОперацийЗаказПоставщику"].ЗаказНаЗакупку;
					НовыйОбъект.ДатаПоступления 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса()+7*24*60*60;
				КонецЕсли;
			КонецЕсли;
		
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ОперацияПоПлатежнымКартам") Тогда
		
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Статья) Тогда
					НовыйОбъект.Статья 	= Справочники["СтатьиДвиженияДенежныхСредств"]["ОплатаОтПокупателей"];
			КонецЕсли;
		
				НовыйОбъект.ВидОперации = Перечисления["ВидыОперацийЭквайринга"].ПоступлениеОплатыОтПокупателя;
	
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ПоступлениеВКассу") ИЛИ ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ПоступлениеНаСчет")  Тогда
		
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.Статья) Тогда
					НовыйОбъект.Статья 	= Справочники["СтатьиДвиженияДенежныхСредств"]["ОплатаОтПокупателей"];
			КонецЕсли;
	
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.ПриходнаяНакладная") Тогда 
	
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ВидОперации) Тогда
				Если ТипОснования = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПоставщику") Тогда
						НовыйОбъект.ВидОперации = Перечисления["ВидыОперацийПриходнаяНакладная"].ПоступлениеОтПоставщика;
				ИначеЕсли ТипОснования = Тип("ДокументСсылка.СчетНаОплатуПоставщика") Тогда
						НовыйОбъект.ВидОперации = Перечисления["ВидыОперацийПриходнаяНакладная"].ПоступлениеОтПоставщика;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументОбъект.РасходнаяНакладная") Тогда  
		
			Если НЕ ЗначениеЗаполнено(НовыйОбъект.ВидОперации) Тогда
				Если ТипОснования = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПокупателя") Тогда
						НовыйОбъект.ВидОперации = Перечисления["ВидыОперацийРасходнаяНакладная"].ПродажаПокупателю;
				ИначеЕсли ТипОснования = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплату") Тогда
						НовыйОбъект.ВидОперации = Перечисления["ВидыОперацийРасходнаяНакладная"].ПродажаПокупателю;
				КонецЕсли;
			КонецЕсли;
		
		КонецЕсли;
	
		Если НовыйОбъект.Метаданные().Реквизиты.Найти("СкидкиРассчитаны") <> Неопределено Тогда
			НовыйОбъект.СкидкиРассчитаны = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ВыгрузкаСообщений

Процедура ВыгрузкаСообщенияВБитрикс24(Сообщение, Параметры) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	Если Параметры.Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипыДанных"				, Б24_К_RestApiВызовСервера.ПолучитьТипыДанныхДел()); 
	Запрос.УстановитьПараметр("ТипОбъекта"				, Параметры.Объект.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("ИдентификаторОбъекта"	, XMLСтрока(Параметры.Объект));	
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыДел.Портал КАК Портал,
	|	Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор КАК Идентификатор,
	|	Б24_К_ИдентификаторыДел.ТипДанных КАК ТипДанных,
	|	Б24_К_ИдентификаторыДел.Идентификатор КАК ИдентификаторДела
	|ПОМЕСТИТЬ ВТ_Связи
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.ТипДанных В(&ТипыДанных)
	|	И Б24_К_ИдентификаторыДел.ТипОбъекта = &ТипОбъекта
	|	И Б24_К_ИдентификаторыДел.ИдентификаторОбъекта = &ИдентификаторОбъекта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_К_НастройкиПодключения.Портал КАК Портал,
	|	ВТ_Связи.Идентификатор КАК ИдентификаторВладельца,
	|	ВТ_Связи.ТипДанных КАК ТипДанных,
	|	Б24_К_НастройкиПодключения.Ссылка КАК НастройкаПодключения,
	|	ВТ_Связи.ИдентификаторДела КАК ИдентификаторДела
	|ИЗ
	|	ВТ_Связи КАК ВТ_Связи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|		ПО ВТ_Связи.Портал = Б24_К_НастройкиПодключения.Портал
	|ГДЕ
	|	Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	Если ВыполненныйЗапрос.Пустой() Тогда
		 ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден владелец Битрикс24 документа: " + Строка(Параметры.Объект));
		Возврат;
	КонецЕсли;
	
	Выборка = ВыполненныйЗапрос.Выбрать();
	
	Пока Выборка.Следующий() Цикл
			
		СтруктураНастроек 	= Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(Выборка.НастройкаПодключения, Истина);  
		
		Если СтруктураНастроек = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю("Не удалось подключиться");
			Продолжить;
		КонецЕсли;		
		
		ИдентификаторВладельца = Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьУдалитьПрефиксИдОбъекта(Выборка.ИдентификаторВладельца);

		Если Параметры.ТипСообщения = "ДокументКорректный" Тогда
			Статус = "ОК";
		Иначе
			Статус = "Ошибка";			
		КонецЕсли;
		
		ТипВладельца = Б24_К_RestApiВызовСервера.ПолучитьТипВладельцаТаймЛайнПоТипуДанных(Выборка.ТипДанных, Выборка.ИдентификаторДела);
		
		Б24_К_RestApiВызовСервера.ДобавитьЗаписьВТаймЛайн(СтруктураНастроек, ТипВладельца, ИдентификаторВладельца, Статус, Сообщение, Параметры.Объект);	

	КонецЦикла;
	
КонецПроцедуры	

#КонецОбласти


#Область Прочее

Функция ПолучитьСтроковыйИдентификаторХранилищаДанныхРоботов() Экспорт
	Возврат "rBackOffice1C"; 	
КонецФункции

Функция ПолучитьСтруктуруОписанияДокументаРобота(НазваниеДокумента, ИдДокумента, ПечатныеФормы = Неопределено, ДокументыНаОсновании = Неопределено) Экспорт  
	
	Результат = Новый Структура;
	
	Результат.Вставить("Название"				, НазваниеДокумента);
	Результат.Вставить("ИдДокумента"			, ИдДокумента);
	Результат.Вставить("ПечатныеФормы"			, ?(ПечатныеФормы = Неопределено, Новый Массив, ПечатныеФормы));
	Результат.Вставить("ДокументыНаОсновании"	, ?(ДокументыНаОсновании = Неопределено, Новый Массив, ДокументыНаОсновании));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтруктуруОписанияДокументаТриггера(НазваниеДокумента, ИдДокумента="")
	
	Результат = Новый Структура;
	
	Результат.Вставить("Название"		, НазваниеДокумента);
	Результат.Вставить("ИдДокумента"	, ИдДокумента);
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьТриггерОтгрузкаВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт

	Б24_К_ОбщегоНазначенияВызовСервера.Таймаут(5);
	
	мДокументы 	= ПараметрыВыгрузки.мДокументы; 
	
	Если ТипЗнч(мДокументы) <> Тип("Массив") Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	Для каждого ТекДокумент Из мДокументы Цикл
	
#Область ОтгрузкаЗаказов			
		Если ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПокупателя") 
			ИЛИ ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПоставщику") Тогда
			
			МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
			Если ТипЗнч(ТекДокумент) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПокупателя") Тогда
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				Запрос.УстановитьПараметр("Документ", ТекДокумент); 
				Запрос.Текст = "ВЫБРАТЬ
				|	ЗаказПокупателя.Ссылка КАК Ссылка,
				|	ЗаказПокупателя.Проведен КАК Проведен,
				|	ЗаказПокупателя.ВариантЗавершения КАК ВариантЗавершения
				|ПОМЕСТИТЬ ВТ_Заказы
				|ИЗ
				|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
				|ГДЕ
				|	ЗаказПокупателя.Ссылка = &Документ";
				Запрос.Выполнить();
				
			Иначе 
				
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
				Запрос.УстановитьПараметр("Документ", ТекДокумент); 
				Запрос.Текст = "ВЫБРАТЬ
				|	ЗаказПоставщику.Ссылка КАК Ссылка,
				|	ЗаказПоставщику.Проведен КАК Проведен,
				|	ЗаказПоставщику.ВариантЗавершения КАК ВариантЗавершения
				|ПОМЕСТИТЬ ВТ_Заказы
				|ИЗ
				|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
				|ГДЕ
				|	ЗаказПоставщику.Ссылка = &Документ";
				Запрос.Выполнить();
				
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("АктуальнаяДатаСеанса", НачалоДня(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса())); 
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			Запрос.Текст = "ВЫБРАТЬ
			|	ВТ_Заказы.Ссылка КАК Документ,
			|	ВЫБОР
			|		КОГДА ВТ_Заказы.Проведен
			|			ТОГДА ВЫБОР
			|					КОГДА ВТ_Заказы.ВариантЗавершения = ЗНАЧЕНИЕ(Перечисление.ВариантыЗавершенияЗаказа.Отменен)
			|						ТОГДА -1
			|					КОГДА ГрафикВыполнения.Выполнено = 0
			|						ТОГДА 2
			|					КОГДА ГрафикВыполнения.Выполнено > 0
			|						ТОГДА 1
			|					КОГДА ГрафикВыполненияПлан.Выполнено = 0
			|						ТОГДА 2
			|					КОГДА ГрафикВыполненияПлан.Выполнено > 0
			|						ТОГДА 1
			|					КОГДА ГрафикВыполнения.Заказ ЕСТЬ NULL
			|							И ГрафикВыполненияПлан.Заказ ЕСТЬ NULL
			|						ТОГДА 0
			|					ИНАЧЕ 2
			|				КОНЕЦ
			|		ИНАЧЕ -1
			|	КОНЕЦ КАК СтатусОтгрузки
			|ИЗ
			|	ВТ_Заказы КАК ВТ_Заказы
			|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикВыполненияЗаказов КАК ГрафикВыполнения
			|		ПО ВТ_Заказы.Ссылка = ГрафикВыполнения.Заказ
			|			И (ГрафикВыполнения.Период <= &АктуальнаяДатаСеанса)}
			|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикВыполненияЗаказов КАК ГрафикВыполненияПлан
			|		ПО ВТ_Заказы.Ссылка = ГрафикВыполненияПлан.Заказ
			|			И (ГрафикВыполненияПлан.Период > &АктуальнаяДатаСеанса)}";
			
			
			ВыполненныйЗапрос = Запрос.Выполнить();
			
			Если НЕ ВыполненныйЗапрос.Пустой() Тогда
				
				Выборка = ВыполненныйЗапрос.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					Если Выборка.СтатусОтгрузки = 0 Тогда
						ОбработкаСобытияТриггера(Выборка.Документ, "ОтгрузкаДокумента");	
					ИначеЕсли Выборка.СтатусОтгрузки = 1 Тогда
						ОбработкаСобытияТриггера(Выборка.Документ, "ЧастичнаяОтгрузкаДокумента");	
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
#КонецОбласти 				
		
	КонецЦикла;

~КонецПроцедурыВФоне:

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПараметрыВыгрузки);
	
КонецПроцедуры

#КонецОбласти
