		ДокументыТриггера.Добавить(ПолучитьСтруктуруОписанияДокументаТриггера(ОписаниеИспользуемыхДокументов.РасходнаяНакладная			, ИдентификаторыИспользуемыхДокументов.РасходнаяНакладная));
		
		ТриггерБитрикс24.Вставить("Документы", ДокументыТриггера);
		
		Результат.Добавить(ТриггерБитрикс24);
		
	ИначеЕсли ТипКонфигурации = "БП" Тогда
		
		ТриггерБитрикс24 = Новый Структура;    // Оплата документа 
		ТриггерБитрикс24.Вставить("Имя"			, СтруктураИмен.ЧастичнаяОплатаДокумента);  
		ТриггерБитрикс24.Вставить("Название"	, "Частичная оплата документа");  
		
		ДокументыТриггера = Новый Массив;
		ДокументыТриггера.Добавить(ПолучитьСтруктуруОписанияДокументаТриггера(ОписаниеИспользуемыхДокументов.СчетНаОплатуПокупателю		, ИдентификаторыИспользуемыхДокументов.СчетНаОплатуПокупателю));
		ДокументыТриггера.Добавить(ПолучитьСтруктуруОписанияДокументаТриггера(ОписаниеИспользуемыхДокументов.СчетНаОплатуПоставщика		, ИдентификаторыИспользуемыхДокументов.СчетНаОплатуПоставщика));
		
		ТриггерБитрикс24.Вставить("Документы", ДокументыТриггера);
		
		Результат.Добавить(ТриггерБитрикс24);
		
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		
		ТриггерБитрикс24 = Новый Структура;    // Оплата документа 
		ТриггерБитрикс24.Вставить("Имя"			, СтруктураИмен.ЧастичнаяОплатаДокумента);  
		ТриггерБитрикс24.Вставить("Название"	, "Частичная оплата документа");  
		
		ДокументыТриггера = Новый Массив;
		ДокументыТриггера.Добавить(ПолучитьСтруктуруОписанияДокументаТриггера(ОписаниеИспользуемыхДокументов.ЗаказКлиента		, ИдентификаторыИспользуемыхДокументов.ЗаказКлиента));
		ДокументыТриггера.Добавить(ПолучитьСтруктуруОписанияДокументаТриггера(ОписаниеИспользуемыхДокументов.ЗаказПоставщику	, ИдентификаторыИспользуемыхДокументов.ЗаказПоставщику));
		
		ТриггерБитрикс24.Вставить("Документы", ДокументыТриггера);
		
		Результат.Добавить(ТриггерБитрикс24);
		
	КонецЕсли;
	
#КонецОбласти

	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтруктуруИменТриггеров() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Проведение"			, "tExecution1C");
	Результат.Вставить("Распроведение"		, "tAntiExecution1C");
	Результат.Вставить("ИзменениеДокумента"	, "tModification1C");
	Результат.Вставить("ОплатаДокумента"	, "tPayment1C");
	Результат.Вставить("ОтгрузкаДокумента"	, "tShipment1C");
	Результат.Вставить("ОшибкаВДокументе"	, "tErrorMessage1C");
	Результат.Вставить("ДокументКорректный"	, "tOkMessage1C");
	
	Результат.Вставить("ЧастичнаяОплатаДокумента"	, "tPaymentPart1C");
	Результат.Вставить("ЧастичнаяОтгрузкаДокумента"	, "tShipmentPart1C");
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработкаСобытияТриггера(Объект, ТипОперации) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УНФ" Тогда
		Если ТипЗнч(Объект) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.КассоваяСмена") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	НастройкиПодключения = Б24_КА_РоботыИТриггерыСерверПовтИсп.ПолучитьМассивНастроекАвтоматизации("ИспользоватьТриггеры", Истина); 
	Если НастройкиПодключения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Б24_КА_РоботыИТриггерыСерверПовтИсп.ТребуетсяВыполнениеТриггера(Объект.Метаданные().ПолноеИмя(), ТипОперации) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("Объект"					, Объект);
	ПараметрыВыгрузки.Вставить("ТипОперации"			, ТипОперации);
	ПараметрыВыгрузки.Вставить("НастройкиПодключения"	, НастройкиПодключения);
	
	ИменаИспользуемыхРеглЗаданий = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();
	Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_КА_РоботыИТриггерыСервер.ОбработкаСобытияТриггераВФоне", ИменаИспользуемыхРеглЗаданий.ТриггерыБ24, ПараметрыВыгрузки, 5);
	
КонецПроцедуры


Процедура ОбработкаСобытияТриггераВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);     
	
	Объект 					= ПараметрыВыгрузки.Объект;
	ТипОперации 			= ПараметрыВыгрузки.ТипОперации;
	НастройкиПодключения 	= ПараметрыВыгрузки.НастройкиПодключения;
	
	ИдентификаторОбъектаМетаданных = РегистрыСведений.Б24_К_ИдентификаторыОбъектовМетаданных.ПолучитьИдентификаторОбъектаМетаданных(Объект.Метаданные());
	
	СтруктураИмен 	= ПолучитьСтруктуруИменТриггеров();
	ИмяТриггера 	= СтруктураИмен[ТипОперации];
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации <> "УНФ" Тогда
		НастройкиПодключения = РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьМассивНастроекАвтоматизации("ИспользоватьТриггеры", Истина); 
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкиПодключения"	, НастройкиПодключения);
	Запрос.УстановитьПараметр("ТипыДанных"				, Б24_К_RestApiВызовСервера.ПолучитьТипыДанныхДел());
	Запрос.УстановитьПараметр("ТипОбъекта"				, Объект.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("ИдентификаторОбъекта"	, XMLСтрока(Объект));
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_НастройкиПодключения.Портал КАК Портал
	|ПОМЕСТИТЬ ВТ_Порталы
	|ИЗ
	|	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|ГДЕ
	|	Б24_К_НастройкиПодключения.Ссылка В(&НастройкиПодключения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_К_ИдентификаторыДел.Портал КАК Портал,
	|	ВЫБОР
	|		КОГДА Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор = """"
	|			ТОГДА Б24_К_ИдентификаторыДел.Идентификатор
	|		ИНАЧЕ Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор
	|	КОНЕЦ КАК ИдентификаторВладельца,
	|	Б24_К_ИдентификаторыДел.ТипДанных КАК ТипДанных,
	|	Б24_К_ИдентификаторыДел.Идентификатор КАК ИдентификаторДела
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.Портал В
	|			(ВЫБРАТЬ
	|				ВТ_Порталы.Портал
	|			ИЗ
	|				ВТ_Порталы)
	|	И Б24_К_ИдентификаторыДел.ТипДанных В(&ТипыДанных)
	|	И Б24_К_ИдентификаторыДел.ТипОбъекта = &ТипОбъекта
	|	И Б24_К_ИдентификаторыДел.ИдентификаторОбъекта = &ИдентификаторОбъекта";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если ВыполненныйЗапрос.Пустой() Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	тзнСвязейОбъекта1С = ВыполненныйЗапрос.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкиПодключения", НастройкиПодключения);
	Запрос.УстановитьПараметр("ИмяТриггера"			, ИмяТриггера);   
	Запрос.УстановитьПараметр("ИдОбъектаМетаданных"	, ИдентификаторОбъектаМетаданных);   
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_НастройкиПодключения.Ссылка КАК НастройкаПодключения,
	|	Б24_К_НастройкиПодключения.ИдентификаторПодключения КАК ИдентификаторПодключения,
	|	Б24_К_НастройкиПодключения.Портал КАК Портал
	|ПОМЕСТИТЬ ВТ_Настройки
	|ИЗ
	|	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|ГДЕ
	|	Б24_К_НастройкиПодключения.Ссылка В(&НастройкиПодключения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Настройки.НастройкаПодключения КАК НастройкаПодключения,
	|	Б24_КА_ЗарегистрированныеТриггеры.ИмяТриггера КАК ИмяТриггера,
	|	Б24_КА_ЗарегистрированныеТриггеры.ИдДокумента КАК ИдДокумента,
	|	Б24_КА_ЗарегистрированныеТриггеры.КодТриггера КАК КодТриггера,
	|	Б24_КА_ЗарегистрированныеТриггеры.Портал КАК Портал
	|ИЗ
	|	РегистрСведений.Б24_КА_ЗарегистрированныеТриггеры КАК Б24_КА_ЗарегистрированныеТриггеры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Настройки КАК ВТ_Настройки
	|		ПО Б24_КА_ЗарегистрированныеТриггеры.ИдентификаторПодключения = ВТ_Настройки.ИдентификаторПодключения
	|			И Б24_КА_ЗарегистрированныеТриггеры.Портал = ВТ_Настройки.Портал
	|ГДЕ
	|	Б24_КА_ЗарегистрированныеТриггеры.ИмяТриггера = &ИмяТриггера
	|	И Б24_КА_ЗарегистрированныеТриггеры.ИдДокумента = &ИдОбъектаМетаданных";
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если ВыполненныйЗапрос.Пустой() Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	Выборка = ВыполненныйЗапрос.Выбрать();         
	Пока Выборка.Следующий() Цикл 
		
		Для каждого ТекСвязь Из тзнСвязейОбъекта1С Цикл
						
			Если Выборка.Портал = ТекСвязь.Портал Тогда
				
				Если НЕ Б24_К_СлужебныйВызовСервера.МодульАвтоматизацииДоступен(Выборка.НастройкаПодключения) Тогда
				   	Продолжить;
				КонецЕсли;
				
				ТипВладельца = Б24_К_RestApiВызовСервера.ПолучитьТипВладельцаТаймЛайнПоТипуДанных(ТекСвязь.ТипДанных, ТекСвязь.ИдентификаторДела);
				Если ЗначениеЗаполнено(ТипВладельца) Тогда	
					НоваяЗапись = РегистрыСведений.Б24_КА_ОчередьВыполненияТриггеров.СоздатьМенеджерЗаписи();
									
					НоваяЗапись.НастройкаПодключения 	= Выборка.НастройкаПодключения;
					НоваяЗапись.КодТриггера 			= Выборка.КодТриггера;
					НоваяЗапись.ТипВладельца 			= ТипВладельца;
					НоваяЗапись.ИдентификаторВладельца 	= ТекСвязь.ИдентификаторВладельца;
					НоваяЗапись.Записать();
									
					ЗапуститьВыгрузкуТриггеров();    
				КонецЕсли;    
				
				//Перейти ~КонецПроцедурыВФоне;
							
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;	

~КонецПроцедурыВФоне:

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПараметрыВыгрузки);
	
КонецПроцедуры

Процедура ЗапуститьВыгрузкуТриггеров() Экспорт
	
	НужноВыгружать = Истина;
	
	Пока НужноВыгружать Цикл
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДатаАктуальности", Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса()-60*60);
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 50
		|	Б24_КА_ОчередьВыполненияТриггеров.НастройкаПодключения КАК НастройкаПодключения,
		|	Б24_КА_ОчередьВыполненияТриггеров.КодТриггера КАК КодТриггера,
		|	Б24_КА_ОчередьВыполненияТриггеров.ТипВладельца КАК ТипВладельца,
		|	Б24_КА_ОчередьВыполненияТриггеров.ИдентификаторВладельца КАК ИдентификаторВладельца,
		|	Б24_КА_ОчередьВыполненияТриггеров.ДатаПоследнейВыгрузки КАК ДатаПоследнейВыгрузки
		|ИЗ
		|	РегистрСведений.Б24_КА_ОчередьВыполненияТриггеров КАК Б24_КА_ОчередьВыполненияТриггеров
		|ГДЕ
		|	Б24_КА_ОчередьВыполненияТриггеров.ДатаПоследнейВыгрузки < &ДатаАктуальности
		|	И Б24_КА_ОчередьВыполненияТриггеров.КоличествоПопыток < 9";
		ВыполненныйЗапрос = Запрос.Выполнить();
		
		НужноВыгружать = НЕ ВыполненныйЗапрос.Пустой();
		
		Если НужноВыгружать Тогда
			
			тзнДанных = ВыполненныйЗапрос.Выгрузить();
			
			ЗапросыБитрикс24 = Новый Соответствие;
			
			Для каждого ТекСтрока Из тзнДанных Цикл 
				
				БатчЗапросы = ЗапросыБитрикс24.Получить(ТекСтрока.НастройкаПодключения);
				Если БатчЗапросы = Неопределено Тогда
					БатчЗапросы = Новый Массив;	
				КонецЕсли;
				
				Ключ = тзнДанных.Индекс(ТекСтрока)+1;
				
				ИдентификаторВладельца = Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьУдалитьПрефиксИдОбъекта(ТекСтрока.ИдентификаторВладельца);
				
				ТелоHTTPЗапроса = "CODE=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекСтрока.КодТриггера)
				+ "&OWNER_TYPE_ID=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекСтрока.ТипВладельца)
				+ "&OWNER_ID=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторВладельца);
				
				лБатчЗапрос = "cmd["+ XMLСтрока(Ключ) + "]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.automation.trigger.execute?"  + ТелоHTTPЗапроса);
				
				Если БатчЗапросы.Найти(лБатчЗапрос) = Неопределено Тогда
					БатчЗапросы.Добавить(лБатчЗапрос);
				КонецЕсли;
				
				Если ТекСтрока.ТипВладельца = "2" Тогда       //костыль для офлайн событий сделки. Они триггерами не регистрируются.       
					лДопБатчЗапрос = "cmd[999]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.item.update?entityTypeId=2&id=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдентификаторВладельца)); 	
					Если БатчЗапросы.Найти(лДопБатчЗапрос) = Неопределено Тогда
						БатчЗапросы.Добавить(лДопБатчЗапрос);
					КонецЕсли;
				КонецЕсли;

				ЗапросыБитрикс24.Вставить(ТекСтрока.НастройкаПодключения, БатчЗапросы);
				
			КонецЦикла;
			
			мУспешныеЗапросы 	= Новый Массив;
			мНеуспешныеЗапросы 	= Новый Массив;
			
			Для каждого ТекЭлемент Из ЗапросыБитрикс24 Цикл 
				
				Если БатчЗапросы.Количество() > 0 Тогда
					
					СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(ТекЭлемент.Ключ, Истина);    					
					Если СтруктураНастроек = Неопределено Тогда
						Прервать;
					КонецЕсли;
					
					Итератор 		= 0;
					ТелоHTTPЗапроса	= "";
					Для каждого ТекЗапрос Из БатчЗапросы Цикл
						
						Итератор = Итератор  + 1;						
						ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + ТекЗапрос;	
						
						Если Итератор = 50 Тогда
							
							СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса); 
							Если СтруктураОтвета <> Неопределено Тогда
								Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
									
									СтруктураОтвета2 = СтруктураОтвета.Получить("result");
									Если СтруктураОтвета2.Получить("result") <> Неопределено Тогда
										
										Для каждого ТекОтвет Из СтруктураОтвета2.Получить("result") Цикл
											мУспешныеЗапросы.Добавить(Число(ТекОтвет.Ключ));	
										КонецЦикла;
										
										Для каждого ТекОтвет Из СтруктураОтвета2.Получить("result_error") Цикл
											мНеуспешныеЗапросы.Добавить(Число(ТекОтвет.Ключ));	
										КонецЦикла;
										
									КонецЕсли;
									
								КонецЕсли;
							КонецЕсли;
							
							Итератор 		= 0;
							ТелоHTTPЗапроса = "";
						КонецЕсли;
						
					КонецЦикла;
					
					Если НЕ ТелоHTTPЗапроса = "" Тогда
						СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса); 
						Если СтруктураОтвета <> Неопределено Тогда
							Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
								
								СтруктураОтвета2 = СтруктураОтвета.Получить("result");
								Если СтруктураОтвета2.Получить("result") <> Неопределено Тогда
									
									Для каждого ТекОтвет Из СтруктураОтвета2.Получить("result") Цикл
										мУспешныеЗапросы.Добавить(Число(ТекОтвет.Ключ));	
									КонецЦикла;
									
									Для каждого ТекОтвет Из СтруктураОтвета2.Получить("result_error") Цикл
										мНеуспешныеЗапросы.Добавить(Число(ТекОтвет.Ключ));	
									КонецЦикла;
									
								КонецЕсли;
								
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЦикла;
			
			Если мУспешныеЗапросы.Количество() = 0 И мНеуспешныеЗапросы.Количество() = 0 Тогда      //исключительные ситуации
				
				Для каждого СтрокаДанных Из тзнДанных Цикл
					
					Запись = РегистрыСведений.Б24_КА_ОчередьВыполненияТриггеров.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(Запись, СтрокаДанных);
					Запись.Прочитать();
					Запись.ДатаПоследнейВыгрузки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
					Запись.Записать();
					
				КонецЦикла;
				
			Иначе
				
				Для каждого ТекЭлемент Из мУспешныеЗапросы Цикл
					
					Если ТекЭлемент = 999 Тогда
						Продолжить;
					КонецЕсли;
					
					СтрокаДанных = тзнДанных.Получить(ТекЭлемент-1);
					
					Запись = РегистрыСведений.Б24_КА_ОчередьВыполненияТриггеров.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(Запись, СтрокаДанных);
					Запись.Прочитать();
					Запись.Удалить();
					
				КонецЦикла;

				Для каждого ТекЭлемент Из мНеуспешныеЗапросы Цикл
					
					Если ТекЭлемент = 999 Тогда
						Продолжить;
					КонецЕсли;
					
					СтрокаДанных = тзнДанных.Получить(ТекЭлемент-1);
					
					Запись = РегистрыСведений.Б24_КА_ОчередьВыполненияТриггеров.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(Запись, СтрокаДанных);
					Запись.Прочитать();
					Запись.ДатаПоследнейВыгрузки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
					Запись.КоличествоПопыток = Запись.КоличествоПопыток + 1; 
					Запись.Записать();
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область Роботы

Процедура ОбновитьСписокЗарегистрированныхРоботов(ИдентификаторПодключения, Портал, мДанныеОТриггерах) Экспорт
	
	НаборЗаписей = РегистрыСведений.Б24_КА_ЗарегистрированныеРоботы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторПодключения.Установить(ИдентификаторПодключения);
	НаборЗаписей.Отбор.Портал.Установить(Портал);
	НаборЗаписей.Записать();
	
	Для каждого ТекЭлемент Из мДанныеОТриггерах Цикл 
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ИдентификаторПодключения 	= ИдентификаторПодключения;
		НоваяЗапись.Портал 						= Портал;
		НоваяЗапись.КодРобота 					= ТекЭлемент.КодРобота;
		НоваяЗапись.Типовой 					= ТекЭлемент.Типовой;
		НоваяЗапись.ДанныеРобота 				= Новый ХранилищеЗначения(ТекЭлемент.ДанныеРобота);
		
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Процедура ПроверитьДобавитьРасписаниеРоботов(Использование) Экспорт
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаИспользуемыхРеглЗаданий 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();	
	СтруктураРеглЗаданий 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеРеглЗадания();	
	
УстановитьПривилегированныйРежим(Истина);	 //Для возможности пользователям 1С добавить расписание СПАРК			
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИменаИспользуемыхРеглЗаданий.РоботыБ24);		
	Если ОбщегоНазначения.РазделениеВключено() Тогда		
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);			
	КонецЕсли;	
	
	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);	
	
	Если НайденныеРеглЗадания.Количество() = 0 Тогда
			
		ПараметрыЗапуска = Новый Массив();
		ПараметрыЗапуска.Добавить(СтруктураРеглЗаданий.РоботыБ24);
		ПараметрыЗапуска.Добавить(Неопределено);
		
		Расписание = Новый РасписаниеРегламентногоЗадания;			
		Расписание.ПериодПовтораВТечениеДня 	= 30*60;         // раз в пол часа
		Расписание.ПериодПовтораДней 			= 1;	  
		
		ПараметрыЗадания = Новый Структура();
		ПараметрыЗадания.Вставить("Метаданные"					, Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
		ПараметрыЗадания.Вставить("Наименование"				, ИменаИспользуемыхРеглЗаданий.РоботыБ24);
		ПараметрыЗадания.Вставить("Ключ"						, ИменаИспользуемыхРеглЗаданий.РоботыБ24);
		ПараметрыЗадания.Вставить("Использование"				, Использование);
		ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение"		, Ложь);
		ПараметрыЗадания.Вставить("Параметры"					, ПараметрыЗапуска);
		ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
		ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);
		
		ПараметрыЗадания.Вставить("Расписание", Расписание);
		РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
	Иначе
		
		НайденноеРеглЗадание = НайденныеРеглЗадания[0];
	
		ПараметрыИзмененияЗадания = Новый Структура();
		ПараметрыИзмененияЗадания.Вставить("Использование"	, Использование);
		
		РегламентныеЗаданияСервер.ИзменитьЗадание(НайденноеРеглЗадание.УникальныйИдентификатор, ПараметрыИзмененияЗадания);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьРоботовБитрикс24() Экспорт
	
	КоличествоНастроекПодключенияАвтоматизации = РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьКоличествоНастроекПодключенияАвтоматизации("ИспользоватьРоботов", Истина); 
	
	Если КоличествоНастроекПодключенияАвтоматизации = 0 Тогда 
		Возврат;
	КонецЕсли;
									
	ИменаИспользуемыхРеглЗаданий = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();
	Если Б24_К_ОбщегоНазначенияВызовСервера.СейчасВыполняетсяЗадание(ИменаИспользуемыхРеглЗаданий.РоботыБ24) Тогда
		Возврат;
	КонецЕсли;
	
	мНастройкиПодключения = Б24_КА_РоботыИТриггерыСерверПовтИсп.ПолучитьМассивНастроекАвтоматизации("ИспользоватьРоботов", Истина);
	Для каждого ТекНастройкаПодключения Из мНастройкиПодключения Цикл
		
		Если Б24_К_СлужебныйВызовСервера.МодульАвтоматизацииДоступен(ТекНастройкаПодключения) = Ложь Тогда
			Продолжить;	
		КонецЕсли;
		
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("НастройкаПодключения"	, ТекНастройкаПодключения);
		
		robotAction(ПараметрыЗапроса, Неопределено);
		
	КонецЦикла;
	
КонецПроцедуры


Процедура robotAction(ПередаваемыеПараметры, АдресРезультата) Экспорт
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(ПередаваемыеПараметры.НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Перейти ~КонецПроцедурыВФоне;
	КонецЕсли;
	
	СформированныеЗапросыУдаления = Новый Массив;      
	
	Метод 			= "/rest/entity.item.get";
	ТелоHTTPЗапроса = "ENTITY="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПолучитьСтроковыйИдентификаторХранилищаДанныхРоботов());	
	result = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, Метод, "ID", ТелоHTTPЗапроса); 
	Для каждого ТекЭлемент Из result Цикл

		ИдЗаписиОРоботе 	= Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");
		ТокенСобытияРобота 	= ТекЭлемент.Получить("PREVIEW_TEXT");
		
		Запрос = Новый Запрос;   
		Запрос.УстановитьПараметр("Портал"			, СтруктураНастроек.Портал);
		Запрос.УстановитьПараметр("ИдЗаписиРобота"	, Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдЗаписиОРоботе));    
		Запрос.УстановитьПараметр("ТочкаОтсчета"	, СтруктураНастроек.ДатаФормирования - 60*60*24);     // на случай, если ид начнутся сначала(после удаления приложения)
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_КА_ВыполненныеРоботы.ИдЗаписиРобота КАК ИдЗаписиРобота
		|ИЗ
		|	РегистрСведений.Б24_КА_ВыполненныеРоботы КАК Б24_КА_ВыполненныеРоботы
		|ГДЕ
		|	Б24_КА_ВыполненныеРоботы.Портал = &Портал
		|	И Б24_КА_ВыполненныеРоботы.ИдЗаписиРобота = &ИдЗаписиРобота
		|	И Б24_КА_ВыполненныеРоботы.ВремяЗаписи > &ТочкаОтсчета";
		ВыполненныйЗапрос = Запрос.Выполнить();
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			Продолжить;
		КонецЕсли; 
		
		НоваяЗапись = РегистрыСведений.Б24_КА_ВыполненныеРоботы.СоздатьМенеджерЗаписи();
		НоваяЗапись.Портал 			= СтруктураНастроек.Портал; 
		НоваяЗапись.ИдЗаписиРобота 	= Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдЗаписиОРоботе);    
		НоваяЗапись.ВремяЗаписи 	= ТекущаяДатаСеанса();    
		НоваяЗапись.Записать();
		
		лСтруктурПараметров = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(ТекЭлемент.Получить("DETAIL_TEXT"), Истина);
		Если лСтруктурПараметров <> Неопределено Тогда
			
			Если лСтруктурПараметров.Получить("idAdress")= СтруктураНастроек.ИдентификаторПодключения Тогда
				
				СформированныеЗапросыУдаления.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("entity.item.delete?ENTITY="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПолучитьСтроковыйИдентификаторХранилищаДанныхРоботов())+"&ID="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдЗаписиОРоботе)));
				
				СтруктураИменРоботов= ПолучитьСтруктуруИменРоботов();
				ИмяРобота 			= лСтруктурПараметров.Получить("robot");
				ПараметрыРобота 	= лСтруктурПараметров.Получить("properties");
				ИнформацияОСущности	= лСтруктурПараметров.Получить("document_id");
				ТипСущности 		= лСтруктурПараметров.Получить("document_type");
				
				ЭтоПроизвольныйРобот 	= СтрНайти(ИмяРобота, СтруктураИменРоботов.ПроизвольныйРобот) > 0;    
				Если ЭтоПроизвольныйРобот Тогда
		
					ДанныеРобота = Неопределено;
					Выборка = РегистрыСведений.Б24_КА_ЗарегистрированныеРоботы.Выбрать(Новый Структура("КодРобота", ИмяРобота));
					Пока Выборка.Следующий() Цикл
						ДанныеРобота = Выборка.ДанныеРобота.Получить();	
					КонецЦикла;
					
					Если ДанныеРобота = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					РезультатВыполнения = Новый Структура;  
					РезультатВыполнения.Вставить("Успешно"				, Истина);
					РезультатВыполнения.Вставить("ВозвращаемыеПараметры", Новый Соответствие);
					РезультатВыполнения.Вставить("ОписаниеОшибки"		, "");
					
					ДополнительныеПараметры = Новый Структура;
					ДополнительныеПараметры.Вставить("НастройкаПодключения"		, ПередаваемыеПараметры.НастройкаПодключения);
					ДополнительныеПараметры.Вставить("СтруктураНастроек"		, СтруктураНастроек);
					ДополнительныеПараметры.Вставить("ПараметрыРобота"			, ПараметрыРобота);
					ДополнительныеПараметры.Вставить("ИнформацияОСущности"		, ИнформацияОСущности);
					ДополнительныеПараметры.Вставить("ТипСущности"				, ТипСущности);
					ДополнительныеПараметры.Вставить("ДанныеРобота"				, ДанныеРобота);
					ДополнительныеПараметры.Вставить("Результат"				, РезультатВыполнения);
					
					УжеОбработан = Ложь;
					Б24_КА_РоботыИТриггерыСерверПереопределяемый.ОбработатьСобытиеПроизвольногоРобота(ИмяРобота, ДополнительныеПараметры, УжеОбработан); 
					Если НЕ УжеОбработан Тогда
					
						Параметры = Б24_К_ОбщегоНазначенияСервер.ПолучитьСтруктуруПараметровПредопределенногоАлгоритма();   
						ЗаполнитьЗначенияСвойств(Параметры, ДополнительныеПараметры);
						
						Б24_К_ОбщегоНазначенияСервер.ПолучитьЗначениеПредопределенногоАлгоритма(ДополнительныеПараметры.ДанныеРобота.КодОбработки, Параметры, "Процедура");		
					
					КонецЕсли;
				
					Если РезультатВыполнения.Успешно Тогда
					
						Метод 			= "/rest/bizproc.event.send";
						ТелоHTTPЗапроса = "EVENT_TOKEN="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТокенСобытияРобота);	  
						
						Для каждого ТекПараметр Из ДополнительныеПараметры.Результат.ВозвращаемыеПараметры Цикл     
							
							ЭтоМножественныйПараметр = Ложь;
							Для каждого ТекВыхПараметр Из ДанныеРобота.ВыходныеПараметры Цикл
								Если ТекВыхПараметр.Имя = ТекПараметр.Ключ И ТекВыхПараметр.Множественный Тогда ЭтоМножественныйПараметр = Истина КонецЕсли; 
							КонецЦикла;
							
							ЗначениеПараметра = ТекПараметр.Значение;
							
							Если ЭтоМножественныйПараметр И ТипЗнч(ТекПараметр.Значение) <> Тип("Массив") Тогда
								ЗначениеПараметра = Новый Массив;
								ЗначениеПараметра.Добавить(ТекПараметр.Значение);
							КонецЕсли;
							
							Если ЭтоМножественныйПараметр Тогда  
								ИтераторМассива = 1;
								Для каждого ТекЗначениеВыхПараметра Из ЗначениеПараметра Цикл
									ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&RETURN_VALUES["+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПараметр.Ключ)+"]["+Формат(ИтераторМассива, "ЧГ=0")+"]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекЗначениеВыхПараметра);
									ИтераторМассива = ИтераторМассива + 1;	
								КонецЦикла;
							Иначе
								ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&RETURN_VALUES["+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПараметр.Ключ)+"]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ЗначениеПараметра);
							КонецЕсли;
							
						КонецЦикла;
						
						СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
						Если СтруктураОтвета = Неопределено Тогда
							СформированныеЗапросыУдаления.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("entity.item.delete?ENTITY="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПолучитьСтроковыйИдентификаторХранилищаДанныхРоботов())+"&ID="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдЗаписиОРоботе)));
						КонецЕсли;      
						
					КонецЕсли;      
					
				Иначе
					
					ИдСущности 	= "";
					ТипСущности = "";
					
					Если ТипЗнч(ИнформацияОСущности) = Тип("Массив") Тогда
						Если ИнформацияОСущности.Количество() > 0 Тогда 
							
							ВремИдСущности = ИнформацияОСущности[ИнформацияОСущности.Количество()-1];
							Если СтрНайти(ВремИдСущности, "LEAD_") > 0 Тогда
								ИдСущности	= Прав(ВремИдСущности, СтрДлина(ВремИдСущности)-5);
								ТипСущности = "1";
							ИначеЕсли СтрНайти(ВремИдСущности, "DEAL_") > 0 Тогда
								ИдСущности	= Прав(ВремИдСущности, СтрДлина(ВремИдСущности)-5);
								ТипСущности = "2";
							ИначеЕсли СтрНайти(ВремИдСущности, "CONTACT_") > 0 Тогда
								ИдСущности	= Прав(ВремИдСущности, СтрДлина(ВремИдСущности)-8);
								ТипСущности = "3";
							ИначеЕсли СтрНайти(ВремИдСущности, "COMPANY_") > 0 Тогда
								ИдСущности	= Прав(ВремИдСущности, СтрДлина(ВремИдСущности)-8);
								ТипСущности = "4";   
							ИначеЕсли СтрНайти(ВремИдСущности, "SMART_INVOICE_") > 0 Тогда
								ИдСущности	= Прав(ВремИдСущности, СтрДлина(ВремИдСущности)-14);
								ТипСущности = "31";  
							ИначеЕсли СтрНайти(ВремИдСущности, "DYNAMIC_") > 0 Тогда
								
								РазделенныйКлюч = СтрРазделить(ВремИдСущности, "_");	
								Если РазделенныйКлюч.Количество()= 3 Тогда	
									ИдСущности	= РазделенныйКлюч[2];
									ТипСущности = РазделенныйКлюч[1];    
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ИдСущности) Тогда
						
						ДокументТаймЛайна 		= ПараметрыРобота.Получить("doc");
						ДополнительныйПараметр 	= ПараметрыРобота.Получить("optParam");
						
						ДополнительныеПараметры = Новый Структура;
						ДополнительныеПараметры.Вставить("НастройкаПодключения"		, ПередаваемыеПараметры.НастройкаПодключения);
						ДополнительныеПараметры.Вставить("СтруктураНастроек"		, СтруктураНастроек);
						ДополнительныеПараметры.Вставить("ИдентификаторВладельца"	, ИдСущности);
						ДополнительныеПараметры.Вставить("ТипВладельца"				, ТипСущности);
						ДополнительныеПараметры.Вставить("ДокументТаймЛайна"		, ДокументТаймЛайна);
						ДополнительныеПараметры.Вставить("ДополнительныйПараметр"	, ДополнительныйПараметр);
						
						Результат = ОбработатьСобытиеТиповогоРобота(ИмяРобота, ДополнительныеПараметры);
						
						Метод 			= "/rest/bizproc.event.send";
						ТелоHTTPЗапроса = "EVENT_TOKEN="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТокенСобытияРобота);	
						ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&RETURN_VALUES[result]=" + ?(Результат.ОписаниеОшибки = "", "Y", "N");  
						
						Если Результат.ДанныеФайла <> Неопределено Тогда
							ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&RETURN_VALUES[file][0]=file.pdf"; 
							ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&RETURN_VALUES[file][1]=" + Результат.ДанныеФайла;     
						КонецЕсли;
						
						Если ЗначениеЗаполнено(Результат.ИдДокумента) Тогда
							ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&RETURN_VALUES[idDoc]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Результат.ИдДокумента);  
						КонецЕсли;
						
						Если ЗначениеЗаполнено(Результат.АдресPDF) Тогда
							ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&RETURN_VALUES[pdfUrlMachine]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Результат.АдресPDF);  
						КонецЕсли;
						
						Если Результат.Проведен <> Неопределено Тогда
							ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&RETURN_VALUES[Confirmed]="+?(Результат.Проведен = Истина, "Y", "N");  
						КонецЕсли;
						
						СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
						Если СтруктураОтвета = Неопределено Тогда
							СформированныеЗапросыУдаления.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("entity.item.delete?ENTITY="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ПолучитьСтроковыйИдентификаторХранилищаДанныхРоботов())+"&ID="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдЗаписиОРоботе)));
						КонецЕсли;      
						
						Если Результат.ОписаниеОшибки <> "" И Результат.ОписаниеОшибки <> "Нет дела" Тогда     
							Б24_К_RestApiВызовСервера.ДобавитьЗаписьВТаймЛайн(СтруктураНастроек, ТипСущности, ИдСущности, "Ошибка", Результат.ОписаниеОшибки, Результат.СсылкаНаДокумент);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
	КоличествоВЗапросе = 0;	
	ТелоHTTPЗапроса = "";
	Для каждого ТекЭлемент Из СформированныеЗапросыУдаления Цикл
		
		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + ТекЭлемент;	
		
		КоличествоВЗапросе = КоличествоВЗапросе + 1;
		
		Если КоличествоВЗапросе = 50 Тогда
			Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
			КоличествоВЗапросе = 0;	
			ТелоHTTPЗапроса= "";
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоВЗапросе > 0 Тогда
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
	КонецЕсли;
	
	Если СформированныеЗапросыУдаления.Количество() > 0 Тогда
		
		robotAction(ПередаваемыеПараметры, Неопределено);
	КонецЕсли;
	
	~КонецПроцедурыВФоне:	
	
	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);	
	
КонецПроцедуры

Функция ОбработатьСобытиеТиповогоРобота(ИмяРобота, ДополнительныеПараметры)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Результат = Новый Структура;
	Результат.Вставить("ДанныеФайла"		, Неопределено);
	Результат.Вставить("ИдДокумента"		, "");       
	Результат.Вставить("АдресPDF"			, "");       
	Результат.Вставить("СсылкаНаДокумент"	, Неопределено);
	Результат.Вставить("ОписаниеОшибки"		, "");
	Результат.Вставить("Проведен"			, Неопределено);
	
	НастройкиАвтоматизации = РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьНастройкуАвтоматизацииПоНастройкеПодключения(ДополнительныеПараметры.НастройкаПодключения);		
	Если НастройкиАвтоматизации.ИспользоватьРоботов = Ложь Тогда
		// === ПРАВКА: без текста ошибки портал получает «Y», хотя робот не выполнялся ===
		Результат.ОписаниеОшибки = "Роботы Битрикс24 отключены в настройках автоматизации";
		Возврат Результат;
	КонецЕсли;
	
	СтруктураНастроек		= ДополнительныеПараметры.СтруктураНастроек;
	НастройкаПодключения 	= ДополнительныеПараметры.НастройкаПодключения; 
	
	ИдентификаторВладельца 	= ДополнительныеПараметры.ИдентификаторВладельца; 
	ТипВладельца 			= ДополнительныеПараметры.ТипВладельца; 
	
	ДополнительныйПараметр 	= ДополнительныеПараметры.ДополнительныйПараметр; 
	
	ИмяОбъекта = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИмяОбъектаПоСинониму(ДополнительныеПараметры.ДокументТаймЛайна);
	Если НЕ ЗначениеЗаполнено(ИмяОбъекта) Тогда
		// === ПРАВКА: без текста ошибки портал получает «Y», хотя робот не выполнялся ===
		Результат.ОписаниеОшибки = "Не удалось определить документ 1С по документу Битрикс24: " + Строка(ДополнительныеПараметры.ДокументТаймЛайна);
		Возврат Результат;
	КонецЕсли;
	
	Если СтрНайти(ДополнительныеПараметры.ДокументТаймЛайна, "Документ: ") > 0 Тогда 
		ПолноеИмяОбъекта = "Документ."+ИмяОбъекта;
	ИначеЕсли СтрНайти(ДополнительныеПараметры.ДокументТаймЛайна, "Справочник: ") > 0 Тогда   
		ПолноеИмяОбъекта = "Справочник."+ИмяОбъекта;  
	Иначе
		ПолноеИмяОбъекта = "Документ."+ИмяОбъекта;
	КонецЕсли;
	
	ТипыДанных = Б24_К_RestApiВызовСервера.ТипыДанныхДелаПоТипуВладельца(ТипВладельца);
	
	СтруктуруИменРоботов = ПолучитьСтруктуруИменРоботов();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал"			, СтруктураНастроек.Портал);
	Запрос.УстановитьПараметр("ТипыДанных"		, ТипыДанных);
 	Запрос.УстановитьПараметр("Идентификатор"	, ИдентификаторВладельца);
	Запрос.УстановитьПараметр("ТипВладельца"	, ТипВладельца);
	Запрос.УстановитьПараметр("ТипОбъекта"		, ПолноеИмяОбъекта);   
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыДел.Портал КАК Портал,
	|	Б24_К_ИдентификаторыДел.ТипОбъекта КАК ТипОбъекта,
	|	Б24_К_ИдентификаторыДел.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
	|	&ТипВладельца КАК ТипВладельца,
	|	Б24_К_ИдентификаторыДел.Идентификатор КАК ИдентификаторВладельца
	|ПОМЕСТИТЬ ВТ_Связи
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.Портал = &Портал
	|	И Б24_К_ИдентификаторыДел.ТипДанных В (&ТипыДанных)
	|	И Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор = &Идентификатор  
	|	И Б24_К_ИдентификаторыДел.ТипОбъекта = &ТипОбъекта  
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Б24_К_НастройкиПодключения.Ссылка КАК НастройкаПодключения,   
	|	ВТ_Связи.ТипОбъекта КАК ТипОбъекта,
	|	ВТ_Связи.ИдентификаторОбъекта КАК ИдентификаторОбъекта,
	|	ВТ_Связи.ИдентификаторВладельца КАК ИдентификаторВладельца,
	|	ВТ_Связи.ТипВладельца КАК ТипВладельца,
	|	Б24_К_НастройкиПодключения.Портал КАК Портал
	|ИЗ
	|	ВТ_Связи КАК ВТ_Связи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|		ПО ВТ_Связи.Портал = Б24_К_НастройкиПодключения.Портал
	|ГДЕ
	|	Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СсылкаНаОбъект = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоИмениИИдентификатору(Выборка.ТипОбъекта, Выборка.ИдентификаторОбъекта);  
			Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
				Результат.ОписаниеОшибки = "Не найден объект по идентификатору";
				Возврат Результат;
			КонецЕсли;
			
			Результат.СсылкаНаДокумент = СсылкаНаОбъект;
			
			Если ИмяРобота = СтруктуруИменРоботов.Проведение Тогда
				
				ДокументОбъект 		= СсылкаНаОбъект.ПолучитьОбъект(); 
				
				Попытка  
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);                      
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Проведен документ: " + Строка(СсылкаНаОбъект));
				Исключение
					
					ОписаниеОшибки = "Во время проведения документа: " + Строка(СсылкаНаОбъект) + " возникли ошибки."+ Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
					Если СтрНайти(ОписаниеОшибки, "несоответствия версии") > 0
						Или СтрНайти(ОписаниеОшибки, "отсутствия записи") > 0 Тогда
						// перечитываем объект и пробуем ещё раз
						ОбработатьСобытиеТиповогоРобота(ИмяРобота, ДополнительныеПараметры);
					КонецЕсли;
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, ОписаниеОшибки);
					
					Результат.ОписаниеОшибки = "Возникли ошибки во время проведения. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					
					Возврат Результат;  
					
				КонецПопытки;
					
			ИначеЕсли ИмяРобота = СтруктуруИменРоботов.Распроведение Тогда
				
				ДокументОбъект 		= СсылкаНаОбъект.ПолучитьОбъект(); 
				
				Попытка     
					ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения, РежимПроведенияДокумента.Неоперативный);
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Отмена проведения у документа: " + Строка(СсылкаНаОбъект));
				Исключение
					
					ОписаниеОшибки = "Во время отмены проведения документа: " + Строка(СсылкаНаОбъект) + " возникли ошибки."+ Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); 
					Если СтрНайти(ОписаниеОшибки, "несоответствия версии") > 0
						Или СтрНайти(ОписаниеОшибки, "отсутствия записи") > 0 Тогда
						// перечитываем объект и пробуем ещё раз
						ОбработатьСобытиеТиповогоРобота(ИмяРобота, ДополнительныеПараметры);
					КонецЕсли;
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, ОписаниеОшибки);
					
					Результат.ОписаниеОшибки = "Возникли ошибки во время отмены проведения. " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					
					Возврат Результат; 
					
				КонецПопытки;			    
				
				ИначеЕсли ИмяРобота = СтруктуруИменРоботов.ПечатьЧека Тогда
					
					Если ТипКонфигурации = "УНФ" Тогда
						ТекстОшибки = "";
						МодульОборудованиеУНФ = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ПодключаемоеОборудованиеУНФ");
						МодульОборудованиеУНФ.ДобавитьВОчередьФискализации(СсылкаНаОбъект, ТекстОшибки);
						Если ЗначениеЗаполнено(ТекстОшибки) Тогда
							ТекстОшибки = "Не удалось добавить в очередь печати" + Символы.ПС + ТекстОшибки;
							Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, ТекстОшибки);
							Результат.ОписаниеОшибки = ТекстОшибки;   
							Возврат Результат;
						КонецЕсли;
					ИначеЕсли ТипКонфигурации = "УТ" Тогда
						МодульЧеков = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ФормированиеПараметровФискальногоЧекаСервер");
					МодульУстройств = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ОборудованиеЧекопечатающиеУстройстваВызовСервера");					
					ПараметрыОперацииФискализацииЧека = МодульЧеков.ПараметрыОперацииФискализацииЧекаПакетныйРежим(СсылкаНаОбъект);
					ПараметрыОперацииФискализацииЧека.ИдентификаторФискальнойЗаписи = Строка(Новый УникальныйИдентификатор);
					МодульУстройств.ДобавитьЧекВОчередьЧековККТ(ПараметрыОперацииФискализацииЧека);
				КонецЕсли;
				
			ИначеЕсли ИмяРобота = СтруктуруИменРоботов.ЭкспортПечатнойФормы2 Тогда
#Область ЭкспортПечатнойФормы2	

				ПредставлениеПечатнойФормы = ДополнительныйПараметр;
				Если НЕ ЗначениеЗаполнено(ПредставлениеПечатнойФормы) Тогда
					Результат.ОписаниеОшибки = "не удалось разобрать имя печатной формы";
					Возврат Результат;
				КонецЕсли;
				НастройкиАвтоматизации = РегистрыСведений.Б24_КА_НастройкиАвтоматизации.ПолучитьНастройкуАвтоматизацииПоНастройкеПодключения(ДополнительныеПараметры.НастройкаПодключения);		
				ПечатныеФормыСФаксимиле =  НастройкиАвтоматизации.ПечатныеФормыСФаксимиле = Истина;
				
				ДанныеКоманды = Неопределено;

				Попытка
				ТаблицаКоманд 			= УправлениеПечатью.КомандыПечатиОбъекта(СсылкаНаОбъект.Метаданные());
				Исключение
				ТаблицаКоманд = Новый ТаблицаЗначений;
				КонецПопытки;
				ВызовСерверногоМетода 	= Перечисления.СпособыВызоваДополнительныхОбработок.ВызовСерверногоМетода;
				Для Каждого КомандаПечати Из ТаблицаКоманд Цикл
					Если ПустаяСтрока(КомандаПечати.МенеджерПечати) Тогда
						Продолжить;
					КонецЕсли;
					Если КомандаПечати.ДополнительныеПараметры.Свойство("Ссылка") 
						И ЗначениеЗаполнено(КомандаПечати.ДополнительныеПараметры.Ссылка)
						И КомандаПечати.ДополнительныеПараметры.ВариантЗапуска <> ВызовСерверногоМетода Тогда
						Продолжить;
					КонецЕсли;   
					
					Если КомандаПечати.Представление = ПредставлениеПечатнойФормы Тогда 
						
						ДанныеКоманды = Новый Структура("Представление, ВнешняяОбработка, МенеджерПечати, Идентификатор, ДополнительныеПараметры");
						ЗаполнитьЗначенияСвойств(ДанныеКоманды, КомандаПечати);
						Если КомандаПечати.ДополнительныеПараметры.Свойство("Ссылка") Тогда
							ДанныеКоманды.Вставить("ВнешняяОбработка", КомандаПечати.ДополнительныеПараметры.Ссылка);
						КонецЕсли;            
						
						Прервать;
					КонецЕсли;
					
				КонецЦикла;    
				
				Если ДанныеКоманды = Неопределено Тогда
					Возврат Результат;
				КонецЕсли;
					
				Коллекция = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(ДанныеКоманды.Идентификатор);
				Если Не ЗначениеЗаполнено(ДанныеКоманды.ВнешняяОбработка) Тогда
					//++НЕВ
					МодульПечати = Неопределено;
					ЧастиИмени = СтрРазделить(ДанныеКоманды.МенеджерПечати, ".");
					Если ЧастиИмени.Количество() = 1 Тогда //вероятнее всего это общий модуль
						МетаданыеМодуля  = Метаданные.ОбщиеМодули.Найти(ЧастиИмени[0]);
						Если МетаданыеМодуля <> Неопределено Тогда
							МодульПечати = Вычислить(ЧастиИмени[0]);
						КонецЕсли;
						
					КонецЕсли;
					Если МодульПечати = Неопределено Тогда 
						//--НЕВ
						
						МодульПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ДанныеКоманды.МенеджерПечати);
						//++НЕВ
					КонецЕсли;
					//--НЕВ
				Иначе            
					
					Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда 
						Возврат Результат;
					Иначе
						МодульПечати = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ДанныеКоманды.ВнешняяОбработка);
					КонецЕсли;
					
					Если МодульПечати = Неопределено Тогда         
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось подключить внешнюю печатную форму "+Строка(ДанныеКоманды.ВнешняяОбработка));
						Возврат Результат;
					КонецЕсли;   
					
				КонецЕсли;
				
				ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
				МассивОбъектов = Новый Массив;
				МассивОбъектов.Добавить(СсылкаНаОбъект);       
				
				Если ОбщегоНазначения.ЭтоДокумент(Метаданные.НайтиПоТипу(ТипЗнч(СсылкаНаОбъект))) Тогда            
					РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "Дата, Номер");
					НазваниеПечатнойФормы = ПредставлениеПечатнойФормы + " № " + РеквизитыДокумента.Номер + " от " + Формат(РеквизитыДокумента.Дата, "ДЛФ=DD");  
				Иначе
					НазваниеПечатнойФормы = ПредставлениеПечатнойФормы; 
				КонецЕсли;
				
				Попытка
					
					Если ПредставлениеПечатнойФормы = "Универсальный передаточный документ (УПД)" Тогда       
						
						Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
							ПараметрыПечати = Новый Структура;
							ПараметрыПечати.Вставить("ПечатьВВалюте", Ложь);
							ПараметрыПечати.Вставить("ИдентификаторВКомплекте", "УниверсальныйПередаточныйДокументКомплект");
							
							МодульУчетНДСВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("УчетНДСВызовСервера");
							
							НастройкиПечатиУПД = МодульУчетНДСВызовСервера.ПолучитьНастройкиПечатиУниверсальныхПередаточныхДокументов(МассивОбъектов);   
							
							ДанныеУПД = УправлениеПечатью.СформироватьПечатныеФормы("Обработка.ПечатьУПД", НастройкиПечатиУПД.СписокМакетов, НастройкиПечатиУПД.УниверсальныеПередаточныеДокументы, ПараметрыПечати);
							
							Коллекция = ДанныеУПД.КоллекцияПечатныхФорм;
						КонецЕсли;
						
					ИначеЕсли Не ЗначениеЗаполнено(ДанныеКоманды.ВнешняяОбработка) Тогда
						МодульПечати.Печать(МассивОбъектов, ДанныеКоманды.ДополнительныеПараметры, Коллекция, Новый СписокЗначений, ПараметрыВывода);
					Иначе
						МодульПечати.Печать(МассивОбъектов, Коллекция, Новый СписокЗначений, ПараметрыВывода);
					КонецЕсли;
					
					ТабличныйДокумент = Коллекция[0].ТабличныйДокумент;	
					
					Если ПечатныеФормыСФаксимиле = Истина Тогда	
						
						ПараметрыПечати = Новый Структура;
						ПараметрыПечати.Вставить("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
						ПараметрыПечати.Вставить("Представление", НазваниеПечатнойФормы);				

						Попытка     
							
							ОбъектыПечати = Новый СписокЗначений;
							ОбъектыПечати.Добавить(МассивОбъектов[0], "Документ_1");
							
							ПодписиИПечатиОбластей = УправлениеПечатью.ПодписиИПечатиОбластей(ОбъектыПечати);
							
							ДанныеПечатиРисунковТабличногоДокумента = УправлениеПечатью.ПодписиИПечатиТабличногоДокумента(ОбъектыПечати, ТабличныйДокумент, ПараметрыПечати);
							Для Каждого ПодписиИПечатиОбласти Из ПодписиИПечатиОбластей Цикл
								ИмяОбласти = ПодписиИПечатиОбласти.Ключ;
								Если ДанныеПечатиРисунковТабличногоДокумента[ИмяОбласти] = Неопределено Тогда
									ДанныеПечатиРисунковТабличногоДокумента[ИмяОбласти] = Новый Соответствие();
								КонецЕсли;
								Для Каждого Элемент Из ПодписиИПечатиОбласти.Значение Цикл
									ДанныеПечатиРисунковТабличногоДокумента[ИмяОбласти][Элемент.Ключ] = Элемент.Значение;
								КонецЦикла;
							КонецЦикла;		
							
							УправлениеПечатью.ДобавитьПодписьИПечать(ТабличныйДокумент, ДанныеПечатиРисунковТабличногоДокумента);
							
						Исключение
						КонецПопытки;
						
					КонецЕсли;
					
					Если ТабличныйДокумент <> Неопределено И ТабличныйДокумент.Области.Количество()> 0  Тогда
						
						ДанныеВыгрузки = Б24_К_RestApiВызовСервера.ВыгрузитьПечатнуюФормуВТаймЛайн(НастройкаПодключения, СсылкаНаОбъект, НазваниеПечатнойФормы, ТабличныйДокумент);
						
						Результат.ИдДокумента 	= ДанныеВыгрузки.ИдДокумента;
						Результат.ДанныеФайла 	= ДанныеВыгрузки.ДанныеФайла;
						Результат.АдресPDF 		= ДанныеВыгрузки.АдресPDF;
						
					Иначе        
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не сформировать сделать печатную форму: " + НазваниеПечатнойФормы);
						Результат.ОписаниеОшибки = "Не удалось сформировать печатную форму " + НазваниеПечатнойФормы;
						Возврат Результат;
					КонецЕсли; 
					
				Исключение  
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось сформировать печатную форму: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					Результат.ОписаниеОшибки = "Не удалось сформировать печатную форму " + НазваниеПечатнойФормы;
					ЗаписьЖурналаРегистрации("ФормированиеПечатнойФормы", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
#КонецОбласти	
			
			ИначеЕсли ИмяРобота = СтруктуруИменРоботов.СозданиеОбъектаНаОсновании Тогда
				
				ИмяОбъектаНаОсновании = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИмяОбъектаПоСинониму(ДополнительныйПараметр);
				Если НЕ ЗначениеЗаполнено(ИмяОбъектаНаОсновании) Тогда
					Результат.ОписаниеОшибки = "Не удалось разобрать имя документа на основании: " + ДополнительныйПараметр;
					Возврат Результат;
				КонецЕсли;
				
				Попытка     
					
					Если Метаданные.Документы.Найти(ИмяОбъектаНаОсновании) <> Неопределено Тогда
							
						НовыйОбъект = Документы[ИмяОбъектаНаОсновании].СоздатьДокумент();
						НовыйОбъект.Дата = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
						НовыйОбъект.Заполнить(СсылкаНаОбъект);                   
						
						Если СсылкаНаОбъект.Метаданные().Реквизиты.Найти("Организация") <> Неопределено Тогда
							НовыйОбъект.УстановитьНовыйНомер();
						Иначе
							НовыйОбъект.УстановитьНовыйНомер();
						КонецЕсли;  
						
					ИначеЕсли Метаданные.Справочники.Найти(ИмяОбъектаНаОсновании) <> Неопределено Тогда
						
						НовыйОбъект = Справочники[ИмяОбъектаНаОсновании].СоздатьЭлемент(); 
						НовыйОбъект.Заполнить(СсылкаНаОбъект);                           
						
					КонецЕсли;   
					
					ДозаполнитьОбъектПоОснованию(СсылкаНаОбъект, НовыйОбъект);       
					
					Параметры = Новый Структура;
					Параметры.Вставить("НастройкаПодключения"	, НастройкаПодключения);
					Параметры.Вставить("СтруктураНастроек"		, СтруктураНастроек);
					Параметры.Вставить("Основание"				, СсылкаНаОбъект);
					Параметры.Вставить("НовыйОбъект"			, НовыйОбъект);
					
					УжеОбработан = Ложь;
					Б24_КА_РоботыИТриггерыСерверПереопределяемый.ДозаполнитьОбъектПоОснованию(Параметры, УжеОбработан); 
					Если НЕ УжеОбработан Тогда
					
						Запрос = Новый Запрос;  
						Запрос.УстановитьПараметр("ПервичныйКлюч", СсылкаНаОбъект.Метаданные().ПолноеИмя());
						Запрос.УстановитьПараметр("ВторичныйКлюч", НовыйОбъект.Метаданные().ПолноеИмя()); 
						Запрос.Текст = "ВЫБРАТЬ
						|	Б24_КА_АлгоритмыЗаполненияОбъектовНаОсновании.Алгоритм КАК Алгоритм
						|ИЗ
						|	РегистрСведений.Б24_КА_АлгоритмыЗаполненияОбъектовНаОсновании КАК Б24_КА_АлгоритмыЗаполненияОбъектовНаОсновании
						|ГДЕ
						|	Б24_КА_АлгоритмыЗаполненияОбъектовНаОсновании.ПервичныйКлюч = &ПервичныйКлюч
						|	И Б24_КА_АлгоритмыЗаполненияОбъектовНаОсновании.ВторичныйКлюч = &ВторичныйКлюч";
						ВыполненныйЗапрос = Запрос.Выполнить();     
						
						Если НЕ ВыполненныйЗапрос.Пустой() Тогда 
							Выборка = ВыполненныйЗапрос.Выбрать();
							Пока Выборка.Следующий() Цикл
								Б24_К_ОбщегоНазначенияСервер.ПолучитьЗначениеПредопределенногоАлгоритма(Выборка.Алгоритм, Параметры, "Процедура");	
							КонецЦикла;
						КонецЕсли;

					КонецЕсли;

					НовыйОбъект.Записать();
					
				Исключение                                                                                    
					
					ЗаписьЖурналаРегистрации("СозданиеОбъектаНаОсновании", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось создать объект на основании: " + ДополнительныйПараметр);
					ЗаписьЖурналаРегистрации("СозданиеОбъектаНаОсновании", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
					Результат.ОписаниеОшибки = "Не удалось создать объект на основании: " + ДополнительныйПараметр;
					Возврат Результат;
				КонецПопытки;     
				
			ИначеЕсли ИмяРобота = СтруктуруИменРоботов.ВыгрузкаДокументаВФайл Тогда
				
				МассивСсылокНаОбъект = Новый Массив;
				МассивСсылокНаОбъект.Добавить(СсылкаНаОбъект);   
				
				ПараметрыЗадания = Новый Структура;
				ПараметрыЗадания.Вставить("МассивСсылокНаОбъект", МассивСсылокНаОбъект);
				ПараметрыЗадания.Вставить("ОтправкаЧерезБС", Ложь);
				
				Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
					
					МодульИнтеграцияЭДО = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("ИнтеграцияЭДО");
					РезультатПроверкиГотовности = МодульИнтеграцияЭДО.ПроверкаГотовностиКДокументообороту(МассивСсылокНаОбъект);
					Если РезультатПроверкиГотовности.Неготовые.Количество() > 0 Тогда   
						
						ТекстОшибки = "Не готов документ для выгрузки в XML: " + Строка(СсылкаНаОбъект);
						
						Б24_К_RestApiВызовСервера.ДобавитьЗаписьВТаймЛайн(СтруктураНастроек, ТипВладельца, ИдентификаторВладельца, "Ошибка", ТекстОшибки, СсылкаНаОбъект);
						
