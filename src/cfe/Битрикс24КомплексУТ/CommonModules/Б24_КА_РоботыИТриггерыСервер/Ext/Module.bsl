					мИменаМакетов.Добавить("КоммерческоеПредложениеКлиенту");
					ИмяМенеджераПечати = "Документ." + ИмяОбъекта;
				КонецЕсли;
				
				ПараметрыПечати.Вставить("Представление", ПечатнаяФорма);
				
				Попытка
					ДанныеПечатныхФорм 		= УправлениеПечатью.СформироватьПечатныеФормы(ИмяМенеджераПечати, мИменаМакетов, мОбъекты, ПараметрыПечати);
					КоллекцияПечатныхФорм 	= ДанныеПечатныхФорм.КоллекцияПечатныхФорм;
					
					Если КоллекцияПечатныхФорм.Количество() > 0 Тогда
						Если  КоллекцияПечатныхФорм[0].ТабличныйДокумент.Области.Количество()> 0  Тогда  
							
							ДанныеВыгрузки = Б24_К_RestApiВызовСервера.ВыгрузитьПечатнуюФормуВТаймЛайн(НастройкаПодключения, СсылкаНаОбъект, КоллекцияПечатныхФорм[0].СинонимМакета, КоллекцияПечатныхФорм[0].ТабличныйДокумент);
							
							Результат.ИдДокумента = ДанныеВыгрузки.ИдДокумента;
							Результат.ДанныеФайла = ДанныеВыгрузки.ДанныеФайла;
							
						Иначе
							Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось сделать печатную форму: " + ПечатнаяФорма);
							Результат.ОписаниеОшибки = "Не удалось сформировать печатную форму: " + ПечатнаяФорма;
							Возврат Результат;
						КонецЕсли;
					КонецЕсли;
				Исключение
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Не удалось сформировать печатную форму: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ЗаписьЖурналаРегистрации("ФормированиеПечатнойФормы", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
					
				КонецЕсли;
				#КонецОбласти	

			ИначеЕсли СтруктуруИменРоботов.Свойство("СозданиеДокументаНаОсновании")
				и ИмяРобота = СтруктуруИменРоботов.СозданиеДокументаНаОсновании Тогда
				
				Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, "Проведен") = Ложь Тогда
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка, "Документ возможно не проведен: " + Строка(СсылкаНаОбъект));
					Результат.ОписаниеОшибки = "Нельзя создать на основании. Документ возможно не проведен";
					Возврат Результат;
				КонецЕсли;
				
				ИмяОбъектаНаОсновании = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИмяОбъектаПоСинониму(ДополнительныйПараметр);
				Если НЕ ЗначениеЗаполнено(ИмяОбъектаНаОсновании) Тогда
					Результат.ОписаниеОшибки = "Не удалось разобрать имя документа на основании: " + ДополнительныйПараметр;
					Возврат Результат;
				КонецЕсли;
				
				Попытка
					
					НовыйДокумент = Документы[ИмяОбъектаНаОсновании].СоздатьДокумент();
					НовыйДокумент.Дата = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
					НовыйДокумент.Б24_К_ОбработкаЗаполнения(СсылкаНаОбъект, Истина);
					НовыйДокумент.УстановитьНовыйНомер();
					НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
					
				Исключение
					Результат.ОписаниеОшибки = "Не удалось создать документ на основании: " + ДополнительныйПараметр;

					Возврат Результат;
				КонецПопытки;  
	
			КонецЕсли;	
			
		КонецЦикла;
		
	Иначе

		Если ИмяРобота = СтруктуруИменРоботов.Проведение ИЛИ ИмяРобота = СтруктуруИменРоботов.Распроведение Тогда

			// === ПРАВКА: связи сделки с заказом нет — сообщаем на портал «N» с текстом ===
			Результат.ОписаниеОшибки 	= "Заказ по сделке не найден";
			Результат.Проведен 			= Ложь;

		КонецЕсли;

		Если ИмяРобота = СтруктуруИменРоботов.ПроверкаНаличияДела Тогда
			
			Результат.ОписаниеОшибки 	= "Нет дела";
			Результат.Проведен 			= Ложь;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат Результат;
					
КонецФункции


Функция ПолучитьНастройкиРоботов() Экспорт
	
	СтруктураИмен = ПолучитьСтруктуруИменРоботов();
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	ОписаниеИспользуемыхДокументов 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьОписаниеИспользуемыхДокументов();
	ИдентификаторыИспользуемыхДокументов 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИдентификаторыИспользуемыхДокументов();
	
	Результат = Новый Массив;
	
	РоботБитрикс24 = Новый Структура;    // проведение документа
	РоботБитрикс24.Вставить("Имя"				, СтруктураИмен.Проведение);  
	РоботБитрикс24.Вставить("Название"			, "Проведение документа");  
	
	мОписаниеПараметров = Новый Массив;
	мОписаниеПараметров.Добавить(Новый Структура("name, description", "doc", "Тип документа 1С в таймлайне"));
	РоботБитрикс24.Вставить("ОписаниеПараметров", мОписаниеПараметров);
#Область РоботПроведениеДокумента

	ДокументыРобота = Новый Массив;   
	
	Для каждого ТекОбъект Из Метаданные.Документы Цикл 
		
		Если ТекОбъект.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда   
			ПредставлениеОбъекта = "Документ: " + ТекОбъект.Синоним;
			ДокументыРобота.Добавить(ПолучитьСтруктуруОписанияДокументаРобота(ПредставлениеОбъекта, ТекОбъект.ПолноеИмя()));        
		КонецЕсли;
		
	КонецЦикла;        
	Если ТипКонфигурации = "УНФ" Тогда
			ДокументыРобота.Добавить(ПолучитьСтруктуруОписанияДокументаРобота("Заказ-наряд", Метаданные.Документы["ЗаказПокупателя"].ПолноеИмя()));        
	КонецЕсли;
	
	Б24_К_ОбщегоНазначенияВызовСервера.СортироватьМассив(ДокументыРобота, НаправлениеСортировки.Возр, "Название");    
	
	РоботБитрикс24.Вставить("Документы", ДокументыРобота);
	
	Результат.Добавить(РоботБитрикс24);
	
#КонецОбласти

	
	РоботБитрикс24 = Новый Структура;    // распроведение документа
	РоботБитрикс24.Вставить("Имя"				, СтруктураИмен.Распроведение);  
	РоботБитрикс24.Вставить("Название"			, "Распроведение документа"); 
	
