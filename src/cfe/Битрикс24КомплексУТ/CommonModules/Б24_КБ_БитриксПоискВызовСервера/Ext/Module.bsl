
#Область bitrixSeach

Функция ЭтоЧисло(Знач СтрокаПроверки)
	
	Для НомерСимвола = 1 По СтрДлина(СтрокаПроверки) Цикл
		
		КодСимвола = КодСимвола(Сред(СтрокаПроверки, НомерСимвола, 1));
		
		Если НЕ ((КодСимвола >= 48 И КодСимвола <= 57)
			ИЛИ КодСимвола = 44 ИЛИ КодСимвола = 46) Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеПоСтрокеПоиска(НастройкаПодключения, ТипКлиента, СтрокаПоиска) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УНФ" Тогда

		ДанныеДляПередачи = Новый Массив;
		
		НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
		Если НастройкиИнтеграцииСервисов.БитриксПоиск <> Истина Тогда
			Возврат ДанныеДляПередачи;	
		КонецЕсли;
		
		ВыгружатьМодулемСинхронизации 	= Ложь;
		ТипыКонтрагентовДляКомпаний		= Новый Массив;
		ТипыКонтрагентовДляКонтактов	= Новый Массив;
		
		СохраненныеНастройки = НастройкиИнтеграцииСервисов.Настройки.Получить();
		Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
			
			Если СохраненныеНастройки.ВыгружатьКонтрагентовМодулемСинхронизации Тогда
				
				ВыгружатьМодулемСинхронизации = Истина;
				
				НастройкиСинхронизации = Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкиИнтеграцииСервисов.НастройкаПодключения, Истина);
				
				ТипыКонтрагентовДляКомпаний 	= НастройкиСинхронизации.ТипыКонтрагентовДляКомпаний;
				ТипыКонтрагентовДляКонтактов 	= НастройкиСинхронизации.ТипыКонтрагентовДляКонтактов;
				
			КонецЕсли;
		
		КонецЕсли;
		
		Если ТипКлиента = "3" Тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ВыгружатьМодулемСинхронизации"	, ВыгружатьМодулемСинхронизации);
			Запрос.УстановитьПараметр("спкВидовКонтрагента"				, ТипыКонтрагентовДляКонтактов);

			ПоискПоИНН = ЭтоЧисло(СтрокаПоиска);
			Если ПоискПоИНН Тогда
				
				Запрос.УстановитьПараметр("ИНН", "%" + СтрокаПоиска + "%");
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Контрагенты.Ссылка КАК Ссылка,
				|	Контрагенты.ИНН КАК ИНН,
				|	Контрагенты.КПП КАК КПП,
				|	Контрагенты.Наименование КАК Наименование,
				|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
				|	""1"" КАК ТипСправочника
				|ИЗ
				|	Справочник.Контрагенты КАК Контрагенты
				|ГДЕ
				|	Контрагенты.ИНН ПОДОБНО &ИНН
				|	И ВЫБОР
				|		КОГДА &ВыгружатьМодулемСинхронизации
				|			ТОГДА Контрагенты.ВидКонтрагента В (&спкВидовКонтрагента)
				|		ИНАЧЕ ИСТИНА
				|	КОНЕЦ
				|	И Контрагенты.ЭтоГруппа = ЛОЖЬ";
				ВыполненныйЗапрос = Запрос.Выполнить();
				
			Иначе
				
				Запрос.УстановитьПараметр("Наименование"	, "%" + СтрокаПоиска + "%");
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Контрагенты.Ссылка КАК Ссылка,
				|	Контрагенты.ИНН КАК ИНН,
				|	Контрагенты.КПП КАК КПП,
				|	Контрагенты.Наименование КАК Наименование,
				|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
				|	""1"" КАК ТипСправочника
				|ИЗ
				|	Справочник.Контрагенты КАК Контрагенты
				|ГДЕ
				|	Контрагенты.Наименование ПОДОБНО &Наименование
				|	И Контрагенты.ЭтоГруппа = ЛОЖЬ			
				|	И ВЫБОР
				|			КОГДА &ВыгружатьМодулемСинхронизации
				|				ТОГДА Контрагенты.ВидКонтрагента В(&спкВидовКонтрагента)
				|			ИНАЧЕ ИСТИНА
				|		КОНЕЦ
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	КонтактныеЛица.Ссылка,
				|	"""",
				|	"""",
				|	КонтактныеЛица.Наименование,
				|	КонтактныеЛица.Наименование,
				|	""2""
				|ИЗ
				|	Справочник.КонтактныеЛица КАК КонтактныеЛица
				|ГДЕ
				|	КонтактныеЛица.Наименование ПОДОБНО &Наименование
				|	И &ВыгружатьМодулемСинхронизации = ЛОЖЬ";
				ВыполненныйЗапрос = Запрос.Выполнить();
				
			КонецЕсли;
			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ВыгружатьМодулемСинхронизации"	, ВыгружатьМодулемСинхронизации);
			Запрос.УстановитьПараметр("спкВидовКонтрагента"				, ТипыКонтрагентовДляКомпаний);
			
			ПоискПоИНН = ЭтоЧисло(СтрокаПоиска);
			
			Если ПоискПоИНН Тогда
				
				Запрос.УстановитьПараметр("ИНН", "%" + СтрокаПоиска + "%");
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Контрагенты.Ссылка КАК Ссылка,
				|	Контрагенты.ИНН КАК ИНН,
				|	Контрагенты.КПП КАК КПП,
				|	Контрагенты.Наименование КАК Наименование,
				|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
				|	""1"" КАК ТипСправочника
				|ИЗ
				|	Справочник.Контрагенты КАК Контрагенты
				|ГДЕ
				|	Контрагенты.ИНН ПОДОБНО &ИНН
				|	И Контрагенты.ЭтоГруппа = ЛОЖЬ
				|	И ВЫБОР
				|			КОГДА &ВыгружатьМодулемСинхронизации
				|				ТОГДА Контрагенты.ВидКонтрагента В (&спкВидовКонтрагента)
				|			ИНАЧЕ ИСТИНА
				|		КОНЕЦ";
				ВыполненныйЗапрос = Запрос.Выполнить();
				
			Иначе
				
				Запрос.УстановитьПараметр("Наименование", "%" + СтрокаПоиска + "%");
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Контрагенты.Ссылка КАК Ссылка,
				|	Контрагенты.ИНН КАК ИНН,
				|	Контрагенты.КПП КАК КПП,
				|	Контрагенты.Наименование КАК Наименование,
				|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
				|	""1"" КАК ТипСправочника
				|ИЗ
				|	Справочник.Контрагенты КАК Контрагенты
				|ГДЕ
				|	Контрагенты.Наименование ПОДОБНО &Наименование
				|	И Контрагенты.ЭтоГруппа = ЛОЖЬ
				|	И ВЫБОР
				|			КОГДА &ВыгружатьМодулемСинхронизации
				|				ТОГДА Контрагенты.ВидКонтрагента В (&спкВидовКонтрагента)
				|			ИНАЧЕ ИСТИНА
				|		КОНЕЦ";
				ВыполненныйЗапрос = Запрос.Выполнить();
				
			КонецЕсли;
			
			
		КонецЕсли;
		
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
			
			Выборка = ВыполненныйЗапрос.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				ИнформацияИНН = ?(ЗначениеЗаполнено(Выборка.ИНН), " (ИНН:" + Выборка.ИНН + ")", "");
				
				ДанныеОКлиенте = Новый Структура;
				
				ДанныеОКлиенте.Вставить("id"		, ?(Выборка.ТипСправочника = "2", "c_", "") + XMLСтрока(Выборка.Ссылка));
				ДанныеОКлиенте.Вставить("inn"		, Выборка.ИНН);
				ДанныеОКлиенте.Вставить("kpp"		, Выборка.КПП);
				ДанныеОКлиенте.Вставить("name"		, Выборка.Наименование + ИнформацияИНН);
				//ДанныеОКлиенте.Вставить("name"		, Выборка.НаименованиеПолное + " (ИНН:" + Выборка.ИНН + ")");
				ДанныеОКлиенте.Вставить("fullName"	, Выборка.НаименованиеПолное + ИнформацияИНН);
				
				ДанныеДляПередачи.Добавить(ДанныеОКлиенте);				
				
			КонецЦикла;
			
		КонецЕсли;
		
		Возврат ДанныеДляПередачи;
	Иначе

		ДанныеДляПередачи = Новый Массив;
	
		НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
		Если НастройкиИнтеграцииСервисов.БитриксПоиск <> Истина Тогда
			Возврат ДанныеДляПередачи;	
		КонецЕсли;
	
		Если ТипКонфигурации = "ЗУП"
			или ТипКонфигурации = "БП" Тогда
			Если ТипКлиента = "3" Тогда
			
				Запрос = Новый Запрос;
			
				ПоискПоИНН = ЭтоЧисло(СтрокаПоиска);
				Если ПоискПоИНН Тогда
				
					Запрос.УстановитьПараметр("ИНН", "%" + СтрокаПоиска + "%");
					Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Контрагенты.Ссылка КАК Ссылка,
					|	Контрагенты.ИНН КАК ИНН,
					|	Контрагенты.КПП КАК КПП,
					|	Контрагенты.Наименование КАК Наименование,
					|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
					|	""1"" КАК ТипСправочника
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|ГДЕ
					|	Контрагенты.ИНН ПОДОБНО &ИНН
					|	И Контрагенты.ЭтоГруппа = ЛОЖЬ";
					ВыполненныйЗапрос = Запрос.Выполнить();
				
				Иначе
				
					Запрос.УстановитьПараметр("Наименование"	, "%" + СтрокаПоиска + "%");
					ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Контрагенты.Ссылка КАК Ссылка,
					|	Контрагенты.ИНН КАК ИНН,
					|	Контрагенты.КПП КАК КПП,
					|	Контрагенты.Наименование КАК Наименование,
					|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
					|	""1"" КАК ТипСправочника
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|ГДЕ
					|	Контрагенты.Наименование ПОДОБНО &Наименование
					|	И Контрагенты.ЭтоГруппа = ЛОЖЬ
					|";
					// ЗУП: справочника контактных лиц в конфигурации нет — поиск только по контрагентам
					Если НЕ ТипКонфигурации = "ЗУП" Тогда
						ТекстЗапроса = ТекстЗапроса + "
						|ОБЪЕДИНИТЬ ВСЕ
						|
						|ВЫБРАТЬ
						|	КонтактныеЛица.Ссылка,
						|	"""",
						|	"""",
						|	КонтактныеЛица.Наименование,
						|	КонтактныеЛица.Наименование,
						|	""2""
						|ИЗ
						|	Справочник.КонтактныеЛица КАК КонтактныеЛица
						|ГДЕ
						|	КонтактныеЛица.Наименование ПОДОБНО &Наименование";
					КонецЕсли;
					Запрос.Текст = ТекстЗапроса;
					ВыполненныйЗапрос = Запрос.Выполнить();
				
				КонецЕсли;
			
			Иначе
			
				Запрос = Новый Запрос;
			
				ПоискПоИНН = ЭтоЧисло(СтрокаПоиска);
			
				Если ПоискПоИНН Тогда
				
					Запрос.УстановитьПараметр("ИНН", "%" + СтрокаПоиска + "%");
					Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Контрагенты.Ссылка КАК Ссылка,
					|	Контрагенты.ИНН КАК ИНН,
					|	Контрагенты.КПП КАК КПП,
					|	Контрагенты.Наименование КАК Наименование,
					|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
					|	""1"" КАК ТипСправочника
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|ГДЕ
					|	Контрагенты.ИНН ПОДОБНО &ИНН
					|	И Контрагенты.ЭтоГруппа = ЛОЖЬ";
					ВыполненныйЗапрос = Запрос.Выполнить();
				
				Иначе
				
					Запрос.УстановитьПараметр("Наименование", "%" + СтрокаПоиска + "%");
					Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Контрагенты.Ссылка КАК Ссылка,
					|	Контрагенты.ИНН КАК ИНН,
					|	Контрагенты.КПП КАК КПП,
					|	Контрагенты.Наименование КАК Наименование,
					|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
					|	""1"" КАК ТипСправочника
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|ГДЕ
					|	Контрагенты.Наименование ПОДОБНО &Наименование
					|	И Контрагенты.ЭтоГруппа = ЛОЖЬ";
					ВыполненныйЗапрос = Запрос.Выполнить();
				
				КонецЕсли;
			
			
			КонецЕсли;
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			ВыгружатьМодулемСинхронизации 	= Ложь;
			ТипыКонтрагентовДляКомпаний		= Новый Массив;
			ТипыКонтрагентовДляКонтактов	= Новый Массив;
		
			СохраненныеНастройки = НастройкиИнтеграцииСервисов.Настройки.Получить();
			Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда			
				Если СохраненныеНастройки.ВыгружатьКонтрагентовМодулемСинхронизации Тогда
				
					ВыгружатьМодулемСинхронизации = Истина;				
					НастройкиСинхронизации = Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкиИнтеграцииСервисов.НастройкаПодключения, Истина);
					ТипыКонтрагентовДляКомпаний 	= НастройкиСинхронизации.ТипыКонтрагентовДляКомпаний;
					ТипыКонтрагентовДляКонтактов 	= НастройкиСинхронизации.ТипыКонтрагентовДляКонтактов;
				
				КонецЕсли;			
			КонецЕсли;
		
			Если ТипКлиента = "3" Тогда
			
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("ВыгружатьМодулемСинхронизации"	, ВыгружатьМодулемСинхронизации);
				Запрос.УстановитьПараметр("спкВидовПартнера"				, ТипыКонтрагентовДляКонтактов);
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Партнеры.Ссылка КАК Партнер
				|ПОМЕСТИТЬ ВТ_Партнеры
				|ИЗ
				|	Справочник.Партнеры КАК Партнеры
				|ГДЕ
				|	ВЫБОР
				|			КОГДА &ВыгружатьМодулемСинхронизации
				|				ТОГДА ИСТИНА В (&спкВидовПартнера)
				|			ИНАЧЕ 1 = 0
				|		КОНЕЦ
				|;
				|";
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА В (&спкВидовПартнера)", "Партнеры.ЮрФизЛицо В (&спкВидовПартнера)");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 0", "Партнеры.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.КомпанияЧастноеЛицо.ЧастноеЛицо)");
			
				ПоискПоИНН = ЭтоЧисло(СтрокаПоиска);
				Если ПоискПоИНН Тогда
				
					Запрос.УстановитьПараметр("ИНН", "%" + СтрокаПоиска + "%");
					Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Контрагенты.Ссылка КАК Ссылка,
					|	Контрагенты.ИНН КАК ИНН,
					|	Контрагенты.КПП КАК КПП,
					|	Контрагенты.Наименование КАК Наименование,
					|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
					|	""1"" КАК ТипСправочника
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Партнеры КАК ВТ_Партнеры
					|		ПО Контрагенты.Ссылка = ВТ_Партнеры.Партнер
					|ГДЕ
					|	Контрагенты.ИНН ПОДОБНО &ИНН";
				Если Метаданные.Справочники.Найти("Контрагенты") <> Неопределено И Метаданные.Справочники.Найти("Контрагенты").Реквизиты.Найти("Партнер") <> Неопределено Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контрагенты.Ссылка = ВТ_Партнеры.Партнер", "Контрагенты.Партнер = ВТ_Партнеры.Партнер");
				КонецЕсли;
				
					ВыполненныйЗапрос = Запрос.Выполнить();
				
				Иначе
				
					Запрос.УстановитьПараметр("Наименование"	, "%" + СтрокаПоиска + "%");
					Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Контрагенты.Ссылка КАК Ссылка,
					|	Контрагенты.ИНН КАК ИНН,
					|	Контрагенты.КПП КАК КПП,
					|	Контрагенты.Наименование КАК Наименование,
					|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
					|	""1"" КАК ТипСправочника
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Партнеры КАК ВТ_Партнеры
					|		ПО Контрагенты.Ссылка = ВТ_Партнеры.Партнер
					|ГДЕ
					|	Контрагенты.Наименование ПОДОБНО &Наименование
				
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	КонтактныеЛицаПартнеров.Ссылка,
					|	"""",
					|	"""",
					|	КонтактныеЛицаПартнеров.Наименование,
					|	КонтактныеЛицаПартнеров.Наименование,
					|	""2""
					|ИЗ
					|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Партнеры КАК ВТ_Партнеры
					|		ПО КонтактныеЛицаПартнеров.Владелец = ВТ_Партнеры.Партнер
					|ГДЕ
					|	КонтактныеЛицаПартнеров.Наименование ПОДОБНО &Наименование
					|	И &ВыгружатьМодулемСинхронизации = ЛОЖЬ";
					Если Метаданные.Справочники.Найти("Контрагенты") <> Неопределено И Метаданные.Справочники.Найти("Контрагенты").Реквизиты.Найти("Партнер") <> Неопределено Тогда
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контрагенты.Ссылка = ВТ_Партнеры.Партнер", "Контрагенты.Партнер = ВТ_Партнеры.Партнер");
					КонецЕсли;
					ВыполненныйЗапрос = Запрос.Выполнить();
				
				КонецЕсли;
			
			Иначе
			
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("ВыгружатьМодулемСинхронизации"	, ВыгружатьМодулемСинхронизации);
				Запрос.УстановитьПараметр("спкВидовПартнера"				, ТипыКонтрагентовДляКомпаний);
				Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Партнеры.Ссылка КАК Партнер
				|ПОМЕСТИТЬ ВТ_Партнеры
				|ИЗ
				|	Справочник.Партнеры КАК Партнеры
				|ГДЕ
				|	ВЫБОР
				|			КОГДА &ВыгружатьМодулемСинхронизации
				|				ТОГДА ИСТИНА В (&спкВидовПартнера)
				|			ИНАЧЕ 1 = 0
				|		КОНЕЦ
				|;
				|";
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИСТИНА В (&спкВидовПартнера)", "Партнеры.ЮрФизЛицо В (&спкВидовПартнера)");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 0", "Партнеры.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.КомпанияЧастноеЛицо.Компания)");
			
				ПоискПоИНН = ЭтоЧисло(СтрокаПоиска);
			
				Если ПоискПоИНН Тогда
				
					Запрос.УстановитьПараметр("ИНН", "%" + СтрокаПоиска + "%");
					Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Контрагенты.Ссылка КАК Ссылка,
					|	Контрагенты.ИНН КАК ИНН,
					|	Контрагенты.КПП КАК КПП,
					|	Контрагенты.Наименование КАК Наименование,
					|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
					|	""1"" КАК ТипСправочника
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Партнеры КАК ВТ_Партнеры
					|		ПО Контрагенты.Ссылка = ВТ_Партнеры.Партнер
					|ГДЕ
					|	Контрагенты.ИНН ПОДОБНО &ИНН";
				Если Метаданные.Справочники.Найти("Контрагенты") <> Неопределено И Метаданные.Справочники.Найти("Контрагенты").Реквизиты.Найти("Партнер") <> Неопределено Тогда
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контрагенты.Ссылка = ВТ_Партнеры.Партнер", "Контрагенты.Партнер = ВТ_Партнеры.Партнер");
				КонецЕсли;
				
					ВыполненныйЗапрос = Запрос.Выполнить();
				
				Иначе
				
					Запрос.УстановитьПараметр("Наименование", "%" + СтрокаПоиска + "%");
					Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Контрагенты.Ссылка КАК Ссылка,
					|	Контрагенты.ИНН КАК ИНН,
					|	Контрагенты.КПП КАК КПП,
					|	Контрагенты.Наименование КАК Наименование,
					|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
					|	""1"" КАК ТипСправочника
					|ИЗ
					|	Справочник.Контрагенты КАК Контрагенты
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Партнеры КАК ВТ_Партнеры
					|		ПО Контрагенты.Ссылка = ВТ_Партнеры.Партнер
					|ГДЕ
					|	Контрагенты.Наименование ПОДОБНО &Наименование";
					Если Метаданные.Справочники.Найти("Контрагенты") <> Неопределено И Метаданные.Справочники.Найти("Контрагенты").Реквизиты.Найти("Партнер") <> Неопределено Тогда
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контрагенты.Ссылка = ВТ_Партнеры.Партнер", "Контрагенты.Партнер = ВТ_Партнеры.Партнер");
					КонецЕсли;
				
					ВыполненныйЗапрос = Запрос.Выполнить();
				
				КонецЕсли;			
			КонецЕсли;	
		КонецЕсли;
	
		Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
			Выборка = ВыполненныйЗапрос.Выбрать();
			Пока Выборка.Следующий() Цикл
			
				ИнформацияИНН = ?(ЗначениеЗаполнено(Выборка.ИНН), " (ИНН:" + Выборка.ИНН + ")", "");
			
				ДанныеОКлиенте = Новый Структура;
			
				ДанныеОКлиенте.Вставить("id"		, ?(Выборка.ТипСправочника = "2", "c_", "") + XMLСтрока(Выборка.Ссылка));
				ДанныеОКлиенте.Вставить("inn"		, Выборка.ИНН);
				ДанныеОКлиенте.Вставить("kpp"		, Выборка.КПП);
				ДанныеОКлиенте.Вставить("name"		, Выборка.Наименование + ИнформацияИНН);
				//ДанныеОКлиенте.Вставить("name"		, Выборка.НаименованиеПолное + " (ИНН:" + Выборка.ИНН + ")");
				ДанныеОКлиенте.Вставить("fullName"	, Выборка.НаименованиеПолное + ИнформацияИНН);
			
				ДанныеДляПередачи.Добавить(ДанныеОКлиенте);				
			
			КонецЦикла;
		
		КонецЕсли;
	
		Возврат ДанныеДляПередачи;
	КонецЕсли;
	
КонецФункции

Процедура bitrixSeach(ПередаваемыеПараметры, АдресРезультата) Экспорт
	
	НастройкаПодключения = ПередаваемыеПараметры. НастройкаПодключения;
	Портал 					= ПередаваемыеПараметры.Портал;
	ИдСессии 				= ПередаваемыеПараметры.ИдСессии;
	ТипКлиента 				= Формат(ПередаваемыеПараметры.ТипКлиента, "ЧГ=0");
	СтрокаПоиска 			= ПередаваемыеПараметры.СтрокаПоиска;

	ДанныеДляПередачи = ПолучитьДанныеПоСтрокеПоиска(НастройкаПодключения, ТипКлиента, СтрокаПоиска);
	
	ВернутьСписокНайденныхКлиентов(НастройкаПодключения, ИдСессии, ДанныеДляПередачи);

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);
	
КонецПроцедуры

Процедура ВернутьСписокНайденныхКлиентов(НастройкаПодключения, ИдСессии, ДанныеДляПередачи)
	
	СтрJSON = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеДляПередачи);
	
	СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка клиентов";
	Если СтруктураНастроек <> Неопределено Тогда
		
		Если ДанныеДляПередачи.Количество() > 0 Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "Выгрузка на портал найденный список клиентов");
		КонецЕсли;
		
		ТелоЗапроса = "&COMMAND=bitrixSeachResult&MODULE_ID=1ctotal&PARAMS[session]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСессии)+"&PARAMS[data]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(СтрJSON);
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	КонецЕсли;
		
КонецПроцедуры

Функция ВыгрузитьКлиента(НастройкаПодключения, ТипКлиента, ИдСтрокиКлиента) Экспорт

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();

	Если ТипКонфигурации = "УНФ" Тогда

		Результат = "";
		
		НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
		Если НастройкиИнтеграцииСервисов.БитриксПоиск <> Истина Тогда
			Возврат Результат;	
		КонецЕсли;
		
		НастройкиИнтеграцииСервисов = НастройкиИнтеграцииСервисов.Настройки.Получить();
		Если НастройкиИнтеграцииСервисов = Неопределено Тогда
			Возврат Результат;	
		КонецЕсли;
		
	УстановитьПривилегированныйРежим(Истина);

		Клиент = Неопределено;
		Если Лев(ИдСтрокиКлиента, 2) = "c_" Тогда
			Клиент = XMLЗначение(Тип("СправочникСсылка.КонтактныеЛица"), Прав(ИдСтрокиКлиента, СтрДлина(ИдСтрокиКлиента)-2));
		Иначе
			Клиент = XMLЗначение(Тип("СправочникСсылка.Контрагенты"), ИдСтрокиКлиента);
		КонецЕсли;
		
		ИдКлиента = "";
		Если Клиент <> Неопределено Тогда
			

			Если НастройкиИнтеграцииСервисов.ВыгружатьКонтрагентовМодулемСинхронизации Тогда
				
				Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
					
					Модуль_КС_ОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КС_ОбщегоНазначенияВызовСервера");
					Модуль_КС_ВыгрузкаСервер = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КС_ВыгрузкаСервер");
					СтруктураНастроек 	= Модуль_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения,,2, Истина);
					Если СтруктураНастроек <> Неопределено Тогда
						
						СтруктураНастроек.Логирование.Измерение1 = "Подсистема интеграции сервисов";
						СтруктураНастроек.Логирование.Измерение2 = "Выгрузка клиента из 1С";
						
						Если ТипКлиента = "3" Тогда
							ИдКлиента = Модуль_КС_ВыгрузкаСервер.СформироватьКонтактПоСсылке(СтруктураНастроек, Клиент); 
						Иначе
							ИдКлиента = Модуль_КС_ВыгрузкаСервер.СформироватьКомпаниюПоСсылке(СтруктураНастроек, Клиент); 
						КонецЕсли;
						
						Если Лев(ИдКлиента, 1) = "#"Тогда
							ИдКлиента = Прав(ИдКлиента, СтрДлина(ИдКлиента)-1);		
						КонецЕсли;
						
						Результат = ИдКлиента;
						
						ИдРеквизита = "";
						Если ЗначениеЗаполнено(ИдКлиента) Тогда
							ИдРеквизита = Модуль_КС_ВыгрузкаСервер.СформироватьРеквизитПоСсылке(СтруктураНастроек, Клиент);
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ИдРеквизита) Тогда
							Модуль_КС_ВыгрузкаСервер.СформироватьБанкСчетаПоВладельцу(СтруктураНастроек, Клиент);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
				
				Если СтруктураНастроек <> Неопределено Тогда
					
					СтруктураНастроек.Вставить("НастройкиКлиентов", СтруктураНастроек.НастройкиИнтеграцииСервисов.НастройкиКлиентов);
					
					СтруктураНастроек.Логирование.Измерение2 = "Выгрузка клиента из 1С";
					
					Если ТипКлиента = "3" Тогда
						ИдКлиента = Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхКонтакта(СтруктураНастроек, Клиент); 
					Иначе
						ИдКлиента = Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхКомпании(СтруктураНастроек, Клиент); 
					КонецЕсли;
					
					Результат = ИдКлиента;
					
					ИдРеквизита = "";
					Если ЗначениеЗаполнено(ИдКлиента) Тогда
						ИдРеквизита = Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхРеквизита(СтруктураНастроек, Клиент, ИдКлиента, ТипКлиента);
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ИдРеквизита) И НЕ СтруктураНастроек.НеВыгружатьАдресаРеквизитов Тогда
						ИдФактАдреса 	= Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхАдреса(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.ФактАдресРеквизита	, Клиент, ИдРеквизита);
						ИдЮрАдреса 		= Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхАдреса(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.ЮрАдресРеквизита		, Клиент, ИдРеквизита);
						
						Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхБанковскогоСчета(СтруктураНастроек, Клиент, ИдРеквизита);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат) Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "На портал выгружен клиент: " + Строка(Клиент));
		КонецЕсли;
		
		Возврат Результат;
	Иначе

		Результат = "";
	
		НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
		Если НастройкиИнтеграцииСервисов.БитриксПоиск <> Истина Тогда
			Возврат Результат;	
		КонецЕсли;
	
		НастройкиИнтеграцииСервисов = НастройкиИнтеграцииСервисов.Настройки.Получить();
		Если НастройкиИнтеграцииСервисов = Неопределено Тогда
			Возврат Результат;	
		КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

		Клиент = Неопределено;
		Если ТипКонфигурации = "БП"
			или ТипКонфигурации = "ЗУП" Тогда
			Если Лев(ИдСтрокиКлиента, 2) = "c_" Тогда
				Если НЕ ТипКонфигурации = "ЗУП" Тогда
					Клиент = XMLЗначение(Тип("СправочникСсылка.КонтактныеЛица"), Прав(ИдСтрокиКлиента, СтрДлина(ИдСтрокиКлиента)-2));
				КонецЕсли;
			Иначе
				Клиент = XMLЗначение(Тип("СправочникСсылка.Контрагенты"), ИдСтрокиКлиента);
			КонецЕсли;
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			Если Лев(ИдСтрокиКлиента, 2) = "c_" Тогда
				Реквизит = Справочники["Партнеры"].ПустаяСсылка();
				Клиент = XMLЗначение(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.КонтактныеЛицаПартнеров"), Прав(ИдСтрокиКлиента, СтрДлина(ИдСтрокиКлиента)-2));
			Иначе
				Реквизит = XMLЗначение(Тип("СправочникСсылка.Контрагенты"), ИдСтрокиКлиента);
				Клиент = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(Реквизит, "Партнер");
			КонецЕсли;	
		КонецЕсли;
	
		ИдКлиента = "";
		Если Клиент <> Неопределено Тогда		

			Если НастройкиИнтеграцииСервисов.ВыгружатьКонтрагентовМодулемСинхронизации
				и НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
			
				Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
				
					Модуль_КС_ОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КС_ОбщегоНазначенияВызовСервера");
					Модуль_КС_ВыгрузкаСервер = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КС_ВыгрузкаСервер");
					СтруктураНастроек 	= Модуль_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения,,2, Истина);
					Если СтруктураНастроек <> Неопределено Тогда
					
						СтруктураНастроек.Логирование.Измерение1 = "Подсистема интеграции сервисов";
						СтруктураНастроек.Логирование.Измерение2 = "Выгрузка клиента из 1С";
					
						Если ТипКлиента = "3" Тогда
							ИдКлиента = Модуль_КС_ВыгрузкаСервер.СформироватьКонтактПоСсылке(СтруктураНастроек, Клиент); 
						Иначе
							ИдКлиента = Модуль_КС_ВыгрузкаСервер.СформироватьКомпаниюПоСсылке(СтруктураНастроек, Клиент); 
						КонецЕсли;
					
						Если Лев(ИдКлиента, 1) = "#"Тогда
							ИдКлиента = Прав(ИдКлиента, СтрДлина(ИдКлиента)-1);		
						КонецЕсли;
					
						Результат = ИдКлиента;
					
						ИдРеквизита = "";
						Если ТипКонфигурации = "БП"
							или ТипКонфигурации = "ЗУП" Тогда
							Если ЗначениеЗаполнено(ИдКлиента) Тогда
								ИдРеквизита = Модуль_КС_ВыгрузкаСервер.СформироватьРеквизитПоСсылке(СтруктураНастроек, Клиент);
							КонецЕсли;						
							Если ЗначениеЗаполнено(ИдРеквизита) Тогда
								Модуль_КС_ВыгрузкаСервер.СформироватьБанкСчетаПоВладельцу(СтруктураНастроек, Клиент);
							КонецЕсли;
						ИначеЕсли ТипКонфигурации = "УТ" Тогда
							Если ЗначениеЗаполнено(ИдКлиента) И ЗначениеЗаполнено(Реквизит) Тогда
								ИдРеквизита = Модуль_КС_ВыгрузкаСервер.СформироватьРеквизитПоСсылке(СтруктураНастроек, Реквизит);
							КонецЕсли;						
							Если ЗначениеЗаполнено(ИдРеквизита) Тогда
								Модуль_КС_ВыгрузкаСервер.СформироватьБанкСчетаПоВладельцу(СтруктураНастроек, Реквизит);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				
				КонецЕсли;
			
			Иначе
			
				СтруктураНастроек 	= Б24_КБ_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
			
				Если СтруктураНастроек <> Неопределено Тогда
				
					СтруктураНастроек.Вставить("НастройкиКлиентов", СтруктураНастроек.НастройкиИнтеграцииСервисов.НастройкиКлиентов);
				
					СтруктураНастроек.Логирование.Измерение2 = "Выгрузка клиента из 1С";
				
					Если ТипКлиента = "3" Тогда
						ИдКлиента = Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхКонтакта(СтруктураНастроек, Клиент); 
					Иначе
						ИдКлиента = Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхКомпании(СтруктураНастроек, Клиент); 
					КонецЕсли;
				
					Результат = ИдКлиента;
				
					ИдРеквизита = "";
					Если ТипКонфигурации = "БП"
						или ТипКонфигурации = "ЗУП" Тогда
						Если ЗначениеЗаполнено(ИдКлиента) Тогда
							ИдРеквизита = Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхРеквизита(СтруктураНастроек, Клиент, ИдКлиента, ТипКлиента);
						КонецЕсли;				
						Если ЗначениеЗаполнено(ИдРеквизита) Тогда
							ИдФактАдреса 	= Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхАдреса(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.ФактАдресРеквизита	, Клиент, ИдРеквизита);
							ИдЮрАдреса 		= Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхАдреса(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.ЮрАдресРеквизита		, Клиент, ИдРеквизита);
							Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхБанковскогоСчета(СтруктураНастроек, Клиент, ИдРеквизита);
						КонецЕсли;
					ИначеЕсли ТипКонфигурации = "УТ" Тогда
						Если ЗначениеЗаполнено(ИдКлиента) И ЗначениеЗаполнено(Реквизит) Тогда
							ИдРеквизита = Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхРеквизита(СтруктураНастроек, Реквизит, ИдКлиента, ТипКлиента);
						КонецЕсли;					
						Если ЗначениеЗаполнено(ИдРеквизита) И НЕ СтруктураНастроек.НеВыгружатьАдресаРеквизитов Тогда
							ИдФактАдреса 	= Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхАдреса(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.ФактАдресРеквизита	, Реквизит, ИдРеквизита);
							ИдЮрАдреса 		= Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхАдреса(СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.ЮрАдресРеквизита		, Реквизит, ИдРеквизита);
							Б24_К_ОбменКомпанийКонтактовСервер.СформироватьСтруктуруДанныхБанковскогоСчета(СтруктураНастроек, Реквизит, ИдРеквизита);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			
			КонецЕсли;
		
		КонецЕсли;
	
		Если ЗначениеЗаполнено(Результат) Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.Информация, "На портал выгружен клиент: " + Строка(Клиент));
		КонецЕсли;
	
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

Процедура uploadClient(ПередаваемыеПараметры, АдресРезультата) Экспорт
	
	НастройкаПодключения = ПередаваемыеПараметры. НастройкаПодключения;
	Портал 					= ПередаваемыеПараметры.Портал;
	ИдСессии 				= ПередаваемыеПараметры.ИдСессии;
	ИдСтрокиКлиента 		= ПередаваемыеПараметры.ИдСтрокиКлиента;
	ТипКлиента 				= Строка(ПередаваемыеПараметры.ТипКлиента);
	
	ИдКлиента = ВыгрузитьКлиента(НастройкаПодключения, ТипКлиента, ИдСтрокиКлиента);	
	
	ВернутьИдВыгруженногоКлиента(НастройкаПодключения, ИдСессии, ИдКлиента);

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПередаваемыеПараметры);
	
КонецПроцедуры

Процедура ВернутьИдВыгруженногоКлиента(НастройкаПодключения, ИдСессии, ИдКлиента)
	
	СтруктураНастроек 	= Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек <> Неопределено Тогда
		ТелоЗапроса = "&COMMAND=uploadClientResult&MODULE_ID=1ctotal&PARAMS[session]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдСессии)+"&PARAMS[data]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдКлиента);
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти
