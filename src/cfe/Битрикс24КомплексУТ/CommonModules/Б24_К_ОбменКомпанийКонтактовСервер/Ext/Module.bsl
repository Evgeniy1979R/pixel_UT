Функция ВидКлиентаПоОбъекту(Объект1С) Экспорт
	
	ВидКлиента = "Физическое лицо";
	
	ТипЗначенияОбъекта = ТипЗнч(Объект1С);
	
	Если ТипЗначенияОбъекта = Тип("СправочникСсылка.Контрагенты") ИЛИ ТипЗначенияОбъекта = Тип("СправочникОбъект.Контрагенты") Тогда
		
		Если ТипЗначенияОбъекта = Тип("СправочникСсылка.Контрагенты") Тогда
			РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект1С, "ЮридическоеФизическоеЛицо, ИндивидуальныйПредприниматель, ОбособленноеПодразделение, ГосударственныйОрган");
		Иначе
			РеквизитыКонтрагента = Объект1С;
		КонецЕсли;
		
		Если РеквизитыКонтрагента.ЮридическоеФизическоеЛицо = Перечисления["ЮридическоеФизическоеЛицо"].ФизическоеЛицо Тогда 
			Если РеквизитыКонтрагента.ИндивидуальныйПредприниматель = Истина Тогда 
				ВидКлиента = "Индивидуальный предприниматель";
			Иначе
				ВидКлиента = "Физическое лицо";
			КонецЕсли;
		ИначеЕсли РеквизитыКонтрагента.ОбособленноеПодразделение = Истина Тогда
			ВидКлиента = "Обособленное подразделение";
		ИначеЕсли РеквизитыКонтрагента.ГосударственныйОрган = Истина Тогда
			ВидКлиента = "Государственный орган";
		Иначе
			ВидКлиента = "Юридическое лицо";
		КонецЕсли;
		
	ИначеЕсли ТипЗначенияОбъекта = Тип("СправочникСсылка.Организации") ИЛИ ТипЗначенияОбъекта = Тип("СправочникОбъект.Организации") Тогда
		ВидКлиента = "Юридическое лицо";
	КонецЕсли;
	
    Возврат ВидКлиента;
	
КонецФункции

Процедура ЗаполнитьОбъектПоВидуКлиента(Объект1С, ВидКлиента) Экспорт

	// Страховка от повторения дефекта: при Неопределённом объекте (контрагент не найден и реквизит
	// не создан) ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта роняет фоновое задание
	// внутри ЗаполнитьЗначенияСвойств — «Недопустимое значение параметра (параметр номер '2')».
	Если ТипЗнч(Объект1С) = Тип("Неопределено") Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ВидКлиента = "" Тогда

		Если ТипЗнч(Объект1С) = Тип("СправочникОбъект.Организации") Тогда
			Если ВидКлиента = "Юридическое лицо" Тогда
				Результат = Перечисления["ЮридическоеФизическоеЛицо"].ЮридическоеЛицо;
			Иначе
				Результат = Перечисления["ЮридическоеФизическоеЛицо"].ФизическоеЛицо;
			КонецЕсли;
		Иначе

			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект1С, "ГосударственныйОрган") Тогда
				Объект1С.ГосударственныйОрган 			= Ложь;
			КонецЕсли;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект1С, "ОбособленноеПодразделение") Тогда
				Объект1С.ОбособленноеПодразделение 		= Ложь;
			КонецЕсли;
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект1С, "ИндивидуальныйПредприниматель") Тогда
				Объект1С.ИндивидуальныйПредприниматель 	= Ложь;
			КонецЕсли;

			Если ВидКлиента = "Юридическое лицо" Тогда
				Объект1С.ЮридическоеФизическоеЛицо = Перечисления["ЮридическоеФизическоеЛицо"].ЮридическоеЛицо;
			ИначеЕсли ВидКлиента = "Обособленное подразделение" Тогда
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект1С, "ОбособленноеПодразделение") Тогда
					Объект1С.ОбособленноеПодразделение 		= Истина;
				КонецЕсли;
				Объект1С.ЮридическоеФизическоеЛицо = Перечисления["ЮридическоеФизическоеЛицо"].ЮридическоеЛицо;
			ИначеЕсли ВидКлиента = "Государственный орган" Тогда
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект1С, "ГосударственныйОрган") Тогда
					Объект1С.ГосударственныйОрган 			= Истина;
				КонецЕсли;
				Объект1С.ЮридическоеФизическоеЛицо = Перечисления["ЮридическоеФизическоеЛицо"].ЮридическоеЛицо;
			ИначеЕсли ВидКлиента = "Физическое лицо" Тогда
				Объект1С.ЮридическоеФизическоеЛицо = Перечисления["ЮридическоеФизическоеЛицо"].ФизическоеЛицо;
			ИначеЕсли ВидКлиента = "Индивидуальный предприниматель" Тогда
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект1С, "ИндивидуальныйПредприниматель") Тогда
					Объект1С.ИндивидуальныйПредприниматель 	= Истина;
				КонецЕсли;
				Объект1С.ЮридическоеФизическоеЛицо = Перечисления["ЮридическоеФизическоеЛицо"].ФизическоеЛицо;
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры
#КонецОбласти


#Область ПоискПартнераКомпанииПоРеквизитам
Функция НайтиПартнераКомпанииПоРеквизитамИзПакета(СтруктураНастроек, ПодробныеДанные, ИдКомпанииБ24, МенеджерВременныхТаблиц, ИмяСправочникаКомпания)
	Результат = Справочники[ИмяСправочникаКомпания].ПустаяСсылка();
	
	Если НЕ ПодробныеДанные.Свойство("ИнформацияОКомпаниях") Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Находим компанию в пакете обмена по COMPANY_ID
	КомпанияВПакете = Неопределено;
	Для Каждого ТекКомпания Из ПодробныеДанные.ИнформацияОКомпаниях Цикл
		Если Формат(ТекКомпания.Получить("ID"), "ЧГ=0") = Формат(ИдКомпанииБ24, "ЧГ=0") Тогда
			КомпанияВПакете = ТекКомпания;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если КомпанияВПакете = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗаголовокКомпании = Строка(КомпанияВПакете.Получить("TITLE"));
	Телефоны = КомпанияВПакете.Получить("PHONE");
	Почта = КомпанияВПакете.Получить("EMAIL");
	
	ИНН = "";
	КПП = "";
	Если ПодробныеДанные.Свойство("ИнформацияОРеквизитах") Тогда
		Для Каждого РеквизитКомпании Из ПодробныеДанные.ИнформацияОРеквизитах Цикл
			Если Формат(РеквизитКомпании.Получить("ENTITY_ID"), "ЧГ=0") = Формат(ИдКомпанииБ24, "ЧГ=0") Тогда
				ИНН = РеквизитКомпании.Получить("RQ_INN");
				КПП = РеквизитКомпании.Получить("RQ_KPP");
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("НастройкиКлиентов") Тогда
		ПорядокИдентификации = СтруктураНастроек.НастройкиКлиентов.ПорядокИдентификацииЮрЛиц;
	Иначе
		ПорядокИдентификации = Новый СписокЗначений;
		ПорядокИдентификации.Добавить("Внешний идентификатор");
	КонецЕсли;
	
	ИнформацияОКонтрагенте = Новый Соответствие;
	ИнформацияОКонтрагенте.Вставить("ID", Формат(ИдКомпанииБ24, "ЧГ=0"));
	
	Для Каждого ТекЗначение Из ПорядокИдентификации Цикл
	
		Критерий = ТекЗначение.Значение;
	
		СтруктураДанныхПоиска = Новый Структура;
		СтруктураДанныхПоиска.Вставить("НаименованиеКомпанииКонтакта", ЗаголовокКомпании);
		СтруктураДанныхПоиска.Вставить("Телефоны", Телефоны);
		СтруктураДанныхПоиска.Вставить("Почта", Почта);
		СтруктураДанныхПоиска.Вставить("ИНН", ИНН);
		СтруктураДанныхПоиска.Вставить("КПП", КПП);
		СтруктураДанныхПоиска.Вставить("ТипОбъектаОбмена", СтруктураНастроек.ТипыОбъектовОбмена.Компания);
	
		НайденнаяКомпания = ПолучитьКомпаниюКонтактПоКритерию(
			СтруктураНастроек, Критерий, МенеджерВременныхТаблиц, ИнформацияОКонтрагенте, СтруктураДанныхПоиска);
	
		Если НайденнаяКомпания = Неопределено Тогда
			// Найдено несколько партнеров - прекращаем поиск
			Прервать;
		КонецЕсли;
	
		Если ТипЗнч(НайденнаяКомпания) = Тип("СправочникСсылка." + ИмяСправочникаКомпания)
			И ЗначениеЗаполнено(НайденнаяКомпания) Тогда
			Результат = НайденнаяКомпания;
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат;

КонецФункции
#КонецОбласти
