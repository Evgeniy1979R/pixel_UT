
#Область РегламентноеЗаданиеПроверкиРаботоспособностиЛонгПуллинга

Процедура ДобавитьУдалитьРасписаниеМониторингаСоединенияСБитрикс24(УдалитьЗадание = Ложь) Экспорт
	
	БазаФайловая					= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ИнформационнаяБазаФайловая();
	ИменаИспользуемыхРеглЗаданий 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();	
	СтруктураРеглЗаданий 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеРеглЗадания();	
	
	
	МассивНастроекПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьМассивНастроекПодключения();
	ЕстьНастройка = МассивНастроекПодключения.Количество() > 0;				
	
УстановитьПривилегированныйРежим(Истина);	 //Для возможности пользователям 1С добавить расписание мониторинг реал тайм обмена.			
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИменаИспользуемыхРеглЗаданий.МониторингРТ);		
	Если ОбщегоНазначения.РазделениеВключено() Тогда		
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);			
	КонецЕсли;	
	
	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);	
		
	Если НЕ УдалитьЗадание И НЕ БазаФайловая И ЕстьНастройка И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
			
		Если НайденныеРеглЗадания.Количество() = 0 Тогда
			
			ПараметрыЗапуска = Новый Массив();
			ПараметрыЗапуска.Добавить(СтруктураРеглЗаданий.МониторингРТ);
			ПараметрыЗапуска.Добавить(Неопределено);

			ПараметрыЗадания = Новый Структура();
			ПараметрыЗадания.Вставить("Метаданные"					, Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
			ПараметрыЗадания.Вставить("Наименование"				, ИменаИспользуемыхРеглЗаданий.МониторингРТ);
			ПараметрыЗадания.Вставить("Ключ"						, ИменаИспользуемыхРеглЗаданий.МониторингРТ);
			ПараметрыЗадания.Вставить("Использование"				, Истина);
			ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение"	, Ложь);
			ПараметрыЗадания.Вставить("Параметры"					, ПараметрыЗапуска);
			ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
			ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);
			
			Расписание = Новый РасписаниеРегламентногоЗадания;			
			Расписание.ПериодПовтораВТечениеДня 	= 180;
			Расписание.ПериодПовтораДней 			= 1;	  
			ПараметрыЗадания.Вставить("Расписание", Расписание);
			РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
		Иначе
			
			ПараметрыИзмененияЗадания = Новый Структура();
			ПараметрыИзмененияЗадания.Вставить("Использование"	, Истина);
 			ПараметрыИзмененияЗадания.Вставить("Параметры"		, НайденныеРеглЗадания[0].Параметры);
			ПараметрыИзмененияЗадания.Вставить("Расписание"		, НайденныеРеглЗадания[0].Расписание);
			ПараметрыИзмененияЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
			ПараметрыИзмененияЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);		
			
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
			
		КонецЕсли;
		
	Иначе		
		
		Если НайденныеРеглЗадания.Количество() > 0 Тогда  			
			РегламентныеЗаданияСервер.УдалитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор);
		КонецЕсли;
						
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПроверитьАктуальностьСоединенияСБитрикс24() Экспорт

	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ИнформационнаяБазаФайловая() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РегистрыСведений.Б24_К_СтатусыВыполненияЛонгПуллинга.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.НастройкаПодключения.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ Выборка.СтатусВыполнения Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкаПодключения = Выборка.НастройкаПодключения;
		Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
			 УстановитьНастройкуЛонгПуллинг(НастройкаПодключения, Ложь);
			Возврат;
		КонецЕсли;
		
		НаименованиеФоновогоЗадания = Б24_К_ЛонгПуллингКлиентСервер.ПолучитьНазваниеФоновогоЗаданияСоединенияСБитрикс24(НастройкаПодключения);
		
		НужноЗапуститьФоновоеЗадание = НЕ Б24_К_ОбщегоНазначенияВызовСервера.СейчасВыполняетсяЗадание(НаименованиеФоновогоЗадания);
		
		МеткаПовторногоЗапуска = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса() - 5*60;     //если не получен статус за 5 минут - перестартуем. Значит завис.  Там задания быстрые.
		
		Если НЕ НужноЗапуститьФоновоеЗадание И Выборка.ДатаВыполнения < МеткаПовторногоЗапуска Тогда
			
			мФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Наименование", НаименованиеФоновогоЗадания));
			Для каждого ТекЭлемент Из мФоновыеЗадания Цикл
				
				Если ТекЭлемент.Состояние = СостояниеФоновогоЗадания.Активно Тогда			
					РегламентныеЗаданияСлужебный.ОтменитьФоновоеЗадание(ТекЭлемент.УникальныйИдентификатор);
				КонецЕсли;			
			КонецЦикла;

			НужноЗапуститьФоновоеЗадание = Истина;
			
		КонецЕсли;
		
		Если НужноЗапуститьФоновоеЗадание Тогда

			ПараметрыВыгрузки = Новый Структура;
			ПараметрыВыгрузки.Вставить("НастройкаПодключения", НастройкаПодключения);
			Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_К_ЛонгПуллингВызовСервера.ЗапуститьСоединениеСБитрикс24ВФоне", НаименованиеФоновогоЗадания, ПараметрыВыгрузки, 0, Истина);  
			
		Иначе
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область СохранениеИнформацииДляЛонгПуллинга

Процедура УстановитьНастройкуЛонгПуллинг(НастройкаПодключения, СтатусВыполнения) Экспорт
	
	НоваяЗапись = РегистрыСведений.Б24_К_СтатусыВыполненияЛонгПуллинга.СоздатьМенеджерЗаписи();
	НоваяЗапись.НастройкаПодключения 	= НастройкаПодключения;
	НоваяЗапись.СтатусВыполнения 		= СтатусВыполнения;
	НоваяЗапись.ДатаВыполнения 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
	НоваяЗапись.Записать(Истина);
	
КонецПроцедуры

Функция ПолучитьНастройкуЛонгПуллинг(НастройкаПодключения) Экспорт 
	
	Результат = Ложь;  	
	
	Выборка = РегистрыСведений.Б24_К_СтатусыВыполненияЛонгПуллинга.Выбрать(Новый Структура("НастройкаПодключения", НастройкаПодключения));
	
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.СтатусВыполнения;	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область ВыполнениеЛонгПуллинга

Процедура ЗапуститьСоединениеСБитрикс24ВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт
	
	НастройкаПодключения 		= ПараметрыВыгрузки.НастройкаПодключения;
	ДатаЗапускаФоновогоЗадания 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();

	Б24_К_ЛонгПуллингКлиентСервер.ЗапускДлительногоСоединенияКПорталуОбщий(НастройкаПодключения,, ДатаЗапускаФоновогоЗадания);
	
КонецПроцедуры

#КонецОбласти


#Область КонтрольВыполненияЛонгПуллинга

Процедура ВыгрузитьМеткуВремениВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт
	
	НастройкаПодключения = ПараметрыВыгрузки.НастройкаПодключения;
	
	МеткиВремени = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("МеткиВремени");
	Если ТипЗнч(МеткиВремени) <> Тип("Соответствие") Тогда
		МеткиВремени = Новый Соответствие;	
	КонецЕсли;
	
	МеткаКлюча 		= МеткиВремени.Получить(НастройкаПодключения);
	ТекущаяМетка 	= ТекущаяДатаСеанса();
	
	Если МеткаКлюча = Неопределено ИЛИ МеткаКлюча < ТекущаяМетка - 180 Тогда
		
		МеткиВремени.Вставить(НастройкаПодключения, ТекущаяМетка);
		
		ИдентификаторПодключения = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(НастройкаПодключения.ИдентификаторПодключения);
		
		СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
		
		Если СтруктураНастроек = Неопределено Тогда
			Перейти ~КонецПроцедурыВФоне;
		КонецЕсли;
		
		СтруктураНастроек.Логирование.Измерение1 = "Подключение канала к Битрикс24";	
		
		// Метка времени последней связи 1С с порталом. Ранее источником была команда
		// crm.requisite.preset.list ($result[pTime][time][date_finish]), но она стала
		// возвращать массив пресетов реквизитов вместо строки-метки, поэтому страница
		// /onec постоянно считала соединение нерабочим. Пишем актуальное время строкой-датой (UTC).
		МеткаВремени = Формат(ТекущаяУниверсальнаяДата(), "ДФ='yyyy-MM-dd'T'HH:mm:ss'") + "Z";
		ПараметрыЗапроса = "options[tracking"+ИдентификаторПодключения+"][date]=" + МеткаВремени;
		
		Результат = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/app.option.set", ПараметрыЗапроса); 
		Если Результат <> Неопределено Тогда
			УстановитьНастройкуЛонгПуллинг(НастройкаПодключения, Истина);	
			Б24_К_ОбщегоНазначенияВызовСервера.УстановитьЗначениеВХранилищаНастроек("МеткиВремени", МеткиВремени); 
		КонецЕсли;
		
	КонецЕсли;
	
~КонецПроцедурыВФоне:	
	
	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПараметрыВыгрузки);
	
КонецПроцедуры

#КонецОбласти



Функция РеалТаймДоступенДляСинхронизации(НастройкаПодключения) Экспорт
	
	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульСинхронизацияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_КС_ОбщегоНазначенияВызовСервера");
	НастройкиСинхронизации = МодульСинхронизацияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если НастройкиСинхронизации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;   
	
	Возврат НастройкиСинхронизации.ВРежимеРеальногоВремени;
	
КонецФункции

Функция РеалТаймДоступенДляСмартПроцесса(НастройкаПодключения) Экспорт
	
	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СмартПроцессы") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МодульСинхронизацияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СМ_ОбщегоНазначенияВызовСервера");
	НастройкиСинхронизации = МодульСинхронизацияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если НастройкиСинхронизации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;  
	
	Возврат НастройкиСинхронизации.ВРежимеРеальногоВремени;
	
КонецФункции

// Проверяет доступность режима реального времени для КЭДО по настройке подключения.
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Б24_К_НастройкиПодключения - Настройка подключения для КЭДО.
//
// Возвращаемое значение:
//  Булево - Истина, если режим реального времени доступен, иначе Ложь.
//
Функция РеалТаймКЭДОДоступен(НастройкаПодключения) Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти("Б24_УП_ОбменВызовСервераПовтИсп") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	МодульОбменВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОбменВызовСервераПовтИсп");
	НастройкиКЭДО = МодульОбменВызовСервера.НастройкиКЭДОПоНастройкеПодключения(НастройкаПодключения);
	
	Возврат	НастройкиКЭДО <> Неопределено И НастройкиКЭДО.ВыполнятьОбмен И НастройкиКЭДО.ВРежимеРеальногоВремени;

КонецФункции
