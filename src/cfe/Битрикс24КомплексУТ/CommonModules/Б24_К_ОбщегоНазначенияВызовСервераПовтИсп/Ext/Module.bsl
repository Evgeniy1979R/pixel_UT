
#Область ФункциональностьБазы1С

Функция ДополнительныеРеквизитыИСведенияИспользуются() Экспорт
	
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеРеквизитыИСведения") = Истина;
	
КонецФункции

Функция УчетВалютныхОперацийИспользуются() Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УНФ" Тогда
		Возврат Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ФункциональнаяОпцияВключена("УчетВалютныхОпераций") = Истина;	
	ИначеЕсли ТипКонфигурации = "ЗУП"
		или ТипКонфигурации = "БП" Тогда		
		Возврат ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") = Истина;	
	Иначе
		Возврат Ложь	
	КонецЕсли;
	
КонецФункции


Функция ХарактеристикиНоменклатурыИспользуются() Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УНФ" Тогда
		Возврат Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ФункциональнаяОпцияВключена("ИспользоватьХарактеристики") = Истина;	
	ИначеЕсли ТипКонфигурации = "ЗУП"
		или ТипКонфигурации = "БП" Тогда		
		Возврат Ложь;	
	Иначе
		Возврат Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ФункциональнаяОпцияВключена("ИспользоватьХарактеристикиНоменклатуры") = Истина;
	КонецЕсли;	
	
КонецФункции

