	Результат.Вставить("ТелефонМобильныйКонЛица"	, Справочники["ВидыКонтактнойИнформации"].ПустаяСсылка());
	Результат.Вставить("ТелефонДомашнийКонЛица"		, Справочники["ВидыКонтактнойИнформации"].ПустаяСсылка());
	Результат.Вставить("ПочтаДомашняяКонЛица"		, Справочники["ВидыКонтактнойИнформации"].ПустаяСсылка());
	Результат.Вставить("ПочтаДругаяКонЛица"			, Справочники["ВидыКонтактнойИнформации"].ПустаяСсылка());
	Результат.Вставить("ПочтаДляРассылокКонЛица"	, Справочники["ВидыКонтактнойИнформации"].ПустаяСсылка());
	
	Выборка = Справочники["ВидыКонтактнойИнформации"].Выбрать(Справочники.ВидыКонтактнойИнформации["СправочникКонтрагенты"]);
	
	ЕстьПочтаЧастная 	= Ложь;
	ЕстьПочтаДомашняя 	= Ложь;
	ЕстьПочтаДругая 	= Ложь;
	ЕстьПочтаДляРассылок = Ложь;
	ЕстьТелефонМоб 		= Ложь;
	ЕстьТелефонДом 		= Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты И Выборка.Наименование = "Частный" Тогда
			ЕстьПочтаЧастная = Истина;	
			Результат.ПочтаЧастная = Выборка.Ссылка;	
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты И Выборка.Наименование = "Домашний" Тогда
			ЕстьПочтаДомашняя = Истина;	
			Результат.ПочтаДомашняя = Выборка.Ссылка;	
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты И Выборка.Наименование = "Другой" Тогда
			ЕстьПочтаДругая = Истина;	
			Результат.ПочтаДругая = Выборка.Ссылка;	
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты И Выборка.Наименование = "Для рассылок" Тогда
			ЕстьПочтаДляРассылок = Истина;	
			Результат.ПочтаДляРассылок = Выборка.Ссылка;	
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон И Выборка.Наименование = "Мобильный" Тогда
			ЕстьТелефонМоб = Истина;	
			Результат.ТелефонМобильный = Выборка.Ссылка;	
		КонецЕсли;
		
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон И Выборка.Наименование = "Домашний" Тогда
			ЕстьТелефонДом = Истина;	
			Результат.ТелефонДомашний = Выборка.Ссылка;	
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЕстьПочтаЧастная Тогда
		НовыйКИ = Справочники["ВидыКонтактнойИнформации"].СоздатьЭлемент();
		НовыйКИ.Родитель = Справочники.ВидыКонтактнойИнформации["СправочникКонтрагенты"];
		НовыйКИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		НовыйКИ.Наименование = "Частный";
		НовыйКИ.Используется = Истина;
		НовыйКИ.Записать();
		
		Результат.ПочтаЧастная = НовыйКИ.Ссылка;	
		
	КонецЕсли;
	
	Если НЕ ЕстьПочтаДомашняя Тогда
		НовыйКИ = Справочники["ВидыКонтактнойИнформации"].СоздатьЭлемент();
		НовыйКИ.Родитель = Справочники.ВидыКонтактнойИнформации["СправочникКонтрагенты"];
		НовыйКИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		НовыйКИ.Наименование = "Домашний";
		НовыйКИ.Используется = Истина;
		НовыйКИ.Записать();
		
		Результат.ПочтаДомашняя = НовыйКИ.Ссылка;	
		
	КонецЕсли;
	
	Если НЕ ЕстьПочтаДругая Тогда
		НовыйКИ = Справочники["ВидыКонтактнойИнформации"].СоздатьЭлемент();
		НовыйКИ.Родитель = Справочники.ВидыКонтактнойИнформации["СправочникКонтрагенты"];
		НовыйКИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		НовыйКИ.Наименование = "Другой";
		НовыйКИ.Используется = Истина;
		НовыйКИ.Записать();
		
		Результат.ПочтаДругая = НовыйКИ.Ссылка;	
		
	КонецЕсли;
	
	Если НЕ ЕстьПочтаДляРассылок Тогда
		НовыйКИ = Справочники["ВидыКонтактнойИнформации"].СоздатьЭлемент();
		НовыйКИ.Родитель = Справочники.ВидыКонтактнойИнформации["СправочникКонтрагенты"];
		НовыйКИ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		НовыйКИ.Наименование = "Для рассылок";
