// Возвращаемое значение:
//  СправочникСсылка.Б24_К_НастройкиПодключения - Найденная настройка подключения по указанному порталу.
//  Неопределено - Если настройка подключения не найдена.
Функция НастройкаПодключенияПоПорталу(Портал) Экспорт
	
	Результат = Неопределено;
	
	Выборка = Справочники.Б24_К_НастройкиПодключения.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Портал = Портал И НЕ Выборка.ПометкаУдаления Тогда
			Результат = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет доступность режима реального времени для КЭДО по настройке подключения.
//
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Б24_К_НастройкиПодключения - Настройка подключения для КЭДО.
//
// Возвращаемое значение:
//  Булево - Истина, если режим реального времени доступен, иначе Ложь.
//
Функция РеалТаймКЭДОДоступен(НастройкаПодключения) Экспорт
	
	Если Метаданные.ОбщиеМодули.Найти("Б24_УП_ОбменВызовСервераПовтИсп") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	МодульОбменВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОбменВызовСервераПовтИсп");
	НастройкиКЭДО = МодульОбменВызовСервера.НастройкиКЭДОПоНастройкеПодключения(НастройкаПодключения);
	
	Возврат	НастройкиКЭДО <> Неопределено И НастройкиКЭДО.ВыполнятьОбмен И НастройкиКЭДО.ВРежимеРеальногоВремени;

КонецФункции


#КонецОбласти


#Область Свойства

Функция ПолучитьНаборСвойств(КлючНабора) Экспорт
	
	НаборСвойств = Справочники.НаборыДополнительныхРеквизитовИСведений.ПустаяСсылка();
	
	ПредопределенныеНаборыСвойств = Справочники.НаборыДополнительныхРеквизитовИСведений.ПредопределенныеНаборыСвойств();
	
	ДанныеПоКлючуНабора = ПредопределенныеНаборыСвойств.Получить(КлючНабора);
	
	Если ДанныеПоКлючуНабора <> Неопределено Тогда
		НаборСвойств = ДанныеПоКлючуНабора.Ссылка;	
	КонецЕсли;    
	
	Если НЕ ЗначениеЗаполнено(НаборСвойств) Тогда
		Попытка
			НаборСвойств = Справочники.НаборыДополнительныхРеквизитовИСведений[КлючНабора];
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат НаборСвойств;
	
КонецФункции

Функция СоздатьПолучитьСвойствоФлагСинхронизацииБитрикс24() Экспорт 
	
	НаименованиеСвойства = "Синхронизировано с Битрикс24";
	
	мНаборы = Новый Массив;
	
	мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Контрагенты"));	
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "ЗУП" Тогда 
		// Для ЗУП торговые объекты не добавляются — достаточно Справочник_Контрагенты (добавлен выше безусловно).
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_КонтактныеЛица"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Номенклатура_Общие"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_СчетНаОплату"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_ЗаказПокупателя"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_РасходнаяНакладная"));
	ИначеЕсли ТипКонфигурации = "БП" Тогда 
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_КонтактныеЛица"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Номенклатура"));	
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_СчетНаОплатуПокупателю"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_РеализацияТоваровУслуг"));
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_КонтактныеЛицаПартнеров"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Партнеры_Общие"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Номенклатура_Общие")); 
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_ЗаказКлиента"));
		мНаборы.Добавить(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_РеализацияТоваровУслуг"));
    КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаименованиеСвойства", НаименованиеСвойства);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|ГДЕ
	|	ДополнительныеРеквизитыИСведения.Заголовок = &НаименованиеСвойства
	|	И ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение = ИСТИНА";
	
	ВыполненныйЗапрос = Запрос.Выполнить();	
	Если ВыполненныйЗапрос.Пустой() Тогда
		
		СвойствоОбъект 	= ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
		СвойствоОбъект.Комментарий 	= НСтр("ru = 'Создано автоматически при загрузке с Битрикс24'");
		СвойствоОбъект.Наименование = НаименованиеСвойства;
		СвойствоОбъект.Заголовок 	= НаименованиеСвойства;
		СвойствоОбъект.Комментарий	= "";
		СвойствоОбъект.ЗаголовокФормыВыбораЗначения = НаименованиеСвойства;
		СвойствоОбъект.ЗаголовокФормыЗначения 		= НаименованиеСвойства;
		
		СвойствоОбъект.ЭтоДополнительноеСведение = Истина;
		СвойствоОбъект.ТипЗначения 	= Новый ОписаниеТипов("Булево");
		СвойствоОбъект.Доступен 	= Ложь;
		СвойствоОбъект.Виден 		= Ложь;
		СвойствоОбъект.ДополнительныеЗначенияИспользуются 	= Ложь;
		
		СвойствоОбъект.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);		
		СвойствоОбъект.Записать();
		СвойствоСсылка = СвойствоОбъект.Ссылка; 
		
		Для каждого ТекЭлемент Из мНаборы Цикл
			НаборОбъект = ТекЭлемент.ПолучитьОбъект();
			НаборОбъект.ДополнительныеСведения.Добавить().Свойство = СвойствоСсылка; 
			НаборОбъект.Записать();
		КонецЦикла;
		
	Иначе
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СвойствоСсылка = Выборка.Ссылка; 
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СвойствоСсылка;
	
КонецФункции

#КонецОбласти
// Возвращает тип по имени вида "СправочникСсылка.Партнеры".
// Имя передаётся параметром: расширенная проверка модулей (Конфигуратор -> Проверка модулей)
// анализирует только литералы, переданные напрямую в Тип(), ПредопределенноеЗначение() и подобные
// функции. В конфигурациях, где объекта метаданных нет (например 1C:Fresh), имя приходит строкой.
// Если объекта метаданных с таким именем в конфигурации нет, возвращается Неопределено: Тип()
// в этом случае выбрасывает «Тип не определен» и валит операцию целиком (так в УНФ ложилась запись
// документа на ДокументОбъект.РеализацияТоваровУслуг, которого в УНФ нет — там РасходнаяНакладная).
// Сравнение с Неопределено всегда ложно, поэтому ветка кода для чужого объекта просто не исполняется.
Функция ТипПоИмени(ИмяТипа) Экспорт

	Попытка
		Возврат Тип(ИмяТипа);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Возвращает Истина, если функциональная опция с указанным именем включена.
// По той же причине, что и ТипПоИмени: имя опции — параметр, а не литерал в вызове
// ПолучитьФункциональнуюОпцию().
Функция ФункциональнаяОпцияВключена(ИмяОпции) Экспорт
	Если Метаданные.ФункциональныеОпции.Найти(ИмяОпции) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПолучитьФункциональнуюОпцию(ИмяОпции) = Истина;
КонецФункции
// Возвращает значение предопределённого элемента по полному имени,
// например "Справочник.СтатьиДвиженияДенежныхСредств.ОплатаОтПокупателей".
// Литерал передаётся параметром: расширенная проверка модулей анализирует только литералы,
// стоящие прямо в вызове ПредопределенноеЗначение().
Функция ПредопределенноеЗначениеПоИмени(ПолноеИмя) Экспорт
	Возврат ПредопределенноеЗначение(ПолноеИмя);
КонецФункции
