			ДлительныеОперации.ВыполнитьВФоне("Б24_КС_ОбщегоНазначенияВызовСервера.ВыгрузкаВРеальномВремени", ПараметрыВыгрузки, ПараметрыВыполнения);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры


Функция ПакетДанныхДляРегистрацииИзменений()
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ПакетДанных = Новый ТаблицаЗначений;
	ПакетДанных.Колонки.Добавить("НастройкаПодключения", Новый ОписаниеТипов("СправочникСсылка.Б24_К_НастройкиПодключения"));
	ПакетДанных.Колонки.Добавить("Объект");	
	Если ТипКонфигурации = "БП" Тогда
		ПакетДанных.Колонки.Добавить("ПодчиненныйОбъект");					
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		ПакетДанных.Колонки.Добавить("ПодчиненныйОбъект", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	КонецЕсли;
	ПакетДанных.Колонки.Добавить("ТипОбъекта");

	Возврат ПакетДанных;
	
КонецФункции

Процедура ДобавитьЗапистьВПакетДанныхДляРегистрации(ПакетДанных, НастройкаПодключения, ТипОбъекта, Объект, ПодчиненныйОбъект = Неопределено)
	
	НоваяСтрока = ПакетДанных.Добавить();
	НоваяСтрока.НастройкаПодключения 	= НастройкаПодключения;
	НоваяСтрока.Объект 					= Объект;
	НоваяСтрока.ПодчиненныйОбъект 		= ПодчиненныйОбъект;
	НоваяСтрока.ТипОбъекта 				= ТипОбъекта;

КонецПроцедуры

Процедура ЗарегистрироватьПакетОбъектов(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, ПакетДанных)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	НастройкаПодключения = ИнформацияОНастройкеСинхронизации.НастройкаПодключения;	
	Для каждого ТекСтрока Из ПакетДанных Цикл		
		Если ТипКонфигурации = "БП"
			и ТекСтрока.ТипОбъекта = "Контрагенты" Тогда     
			ЗарегистрироватьКонтрагента(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, ТекСтрока.Объект);
		ИначеЕсли ТекСтрока.ТипОбъекта = "Номенклатура" Тогда 
			ЗарегистрироватьНоменклатуру(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, ТекСтрока.Объект);
		ИначеЕсли ТекСтрока.ТипОбъекта = "Цены" Тогда     
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Цена, ТекСтрока.Объект, ТекСтрока.ПодчиненныйОбъект);	
		ИначеЕсли ТекСтрока.ТипОбъекта = "Остатки" Тогда 
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, ТекСтрока.Объект, ТекСтрока.ПодчиненныйОбъект);	
		ИначеЕсли ТипКонфигурации = "БП"
			и ТекСтрока.ТипОбъекта = "Счета" Тогда    
			ЗарегистрироватьСчет(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, ТекСтрока.Объект);			
		ИначеЕсли ТипКонфигурации = "УТ"
			и ТекСтрока.ТипОбъекта = "Партнеры" Тогда     
			ЗарегистрироватьКонтрагента(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, ТекСтрока.Объект);
		ИначеЕсли ТипКонфигурации = "УТ"
			и ТекСтрока.ТипОбъекта = "Контрагенты" Тогда       
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Реквизит, ТекСтрока.Объект);	
		ИначеЕсли ТипКонфигурации = "УТ"
			и ТекСтрока.ТипОбъекта = "ХарактеристикиНоменклатуры" Тогда      
			ЗарегистрироватьХарактеристикиНоменклатуры(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, ТекСтрока.Объект);
		ИначеЕсли ТипКонфигурации = "УТ"
			и ТекСтрока.ТипОбъекта = "Заказы" Тогда      
			ЗарегистрироватьЗаказ(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, ТекСтрока.Объект);	
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры  

Процедура ЗарегистрироватьИзмененияВладельцевДанных(НастройкаПодключения, ТипДанных, Объект) Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	Если ТипДанных = ТипыДанныхДляОбменаСПорталом.Реквизит Тогда
		
		ТипОбъекта = ТипЗнч(Объект);
		
		Если ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Организации") Тогда
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Компания, Объект);
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Реквизит, Объект);
			
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Контрагенты") Тогда
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Реквизит, Объект);
						
			Если ТипКонфигурации = "БП" Тогда
				ВидКлиента = Б24_К_ОбменКомпанийКонтактовСервер.ВидКлиентаПоОбъекту(Объект);
				ТекОбъект = Объект;
			ИначеЕсли ТипКонфигурации = "УТ" Тогда
				Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект , "Партнер");
				ВидКлиента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партнер , "ЮрФизЛицо");
				ТекОбъект = Партнер;
			КонецЕсли;
			
			ТипыКонтрагентовДляКомпаний = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипыКонтрагентовДляКомпаний(НастройкаПодключения);			
			Если ТипыКонтрагентовДляКомпаний.Найти(ВидКлиента) <> Неопределено Тогда
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Компания, ТекОбъект);
			Иначе
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Контакт, ТекОбъект);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДанных = ТипыДанныхДляОбменаСПорталом.БанковскийСчетРеквизита Тогда
		
		ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Реквизит, Объект.Владелец);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСписокНаборов(Свойство)
	
	СписокНаборов = Новый Массив;
	
	Если ЗначениеЗаполнено(Свойство) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ДополнительныеРеквизиты.Ссылка КАК Набор
		|ПОМЕСТИТЬ ВТ_Наборы
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ДополнительныеРеквизиты
		|ГДЕ
		|	ДополнительныеРеквизиты.Свойство = &Свойство
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДополнительныеСведения.Ссылка
		|ИЗ
		|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Свойство = &Свойство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Наборы.Набор КАК Набор
		|ИЗ
		|	ВТ_Наборы КАК ВТ_Наборы
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Наборы.Набор");
		
		Запрос.УстановитьПараметр("Свойство", Свойство);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокНаборов.Добавить(Выборка.Набор);
		КонецЦикла;
			
	КонецЕсли;
	
	Возврат СписокНаборов;	
	
КонецФункции

Процедура ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипДанныхДляРегистрацииИзменений, Объект, ПодчиненныйОбъект = Неопределено,
	ВремяЗаписиВМиллисекундах = Неопределено) Экспорт

	РегистрыСведений.Б24_КС_ТаблицаИзменений.ДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипДанныхДляРегистрацииИзменений, Объект, ПодчиненныйОбъект,
		ВремяЗаписиВМиллисекундах);

КонецПроцедуры
#КонецОбласти    


Процедура ЗарегистрироватьДанныеДопСведений(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Запись)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" Тогда
		СправочникКомпаний = "Контрагенты";
		СправочникКонтактныеЛица = "КонтактныеЛица";
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		СправочникКомпаний = "Партнеры";
		СправочникКонтактныеЛица = "КонтактныеЛицаПартнеров";
	КонецЕсли;
	НастройкаПодключения = ИнформацияОНастройкеСинхронизации.НастройкаПодключения;	
	ТипВладельцаСвойства = ТипЗнч(Запись.Объект);
	
	Если ТипВладельцаСвойства = Тип("СправочникСсылка."+СправочникКомпаний) Тогда
		
		Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьКонтрагентов Тогда
			Возврат;
		КонецЕсли;
		
		ЗарегистрироватьКонтрагента(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, Запись.Объект);
		
	ИначеЕсли ТипВладельцаСвойства = Тип("СправочникСсылка."+СправочникКонтактныеЛица) Тогда
		
		Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьКонтактныеЛица Тогда
			Возврат;
		КонецЕсли;
			
		ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Контакт, Запись.Объект);	
		
	ИначеЕсли ТипВладельцаСвойства = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Номенклатура") Тогда	
		
		Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьТовары Тогда
			Возврат;
		КонецЕсли;
		
		ЗарегистрироватьНоменклатуру(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Запись.Объект);		
		
	ИначеЕсли ТипКонфигурации = "БП"
		и ТипВладельцаСвойства = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплатуПокупателю") Тогда	
		
		Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьСчета Тогда
			Возврат;
		КонецЕсли;
		
		ЗарегистрироватьСчет(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Запись.Объект);
		
	ИначеЕсли ТипВладельцаСвойства = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.РеализацияТоваровУслуг") Тогда	       //трек номер может.
		
		Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьОтгрузки Тогда
			Возврат;
		КонецЕсли;
		
		ЗарегистрироватьОплатуОтгрузку(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, Запись.Объект);
		
	ИначеЕсли ТипКонфигурации = "УТ"
		и ТипВладельцаСвойства = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда	
		
		Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьПредложения Тогда
			Возврат;
		КонецЕсли;
		
		ЗарегистрироватьХарактеристикиНоменклатуры(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Запись.Объект);
		
	ИначеЕсли ТипКонфигурации = "УТ"
		и ТипВладельцаСвойства = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказКлиента") Тогда	
		
		Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьДПСделок Тогда
			Возврат;
		КонецЕсли;
		
		ЗарегистрироватьЗаказ(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Запись.Объект);
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьКонтрагента(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, КонтрагентСсылка)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" Тогда
		ВидКлиента = Б24_К_ОбменКомпанийКонтактовСервер.ВидКлиентаПоОбъекту(КонтрагентСсылка);					
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		ВидКлиента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КонтрагентСсылка, "ЮрФизЛицо");					
	КонецЕсли;	
	
	ТипыКонтрагентовДляКомпаний = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипыКонтрагентовДляКомпаний(НастройкаПодключения);
	Если ТипыКонтрагентовДляКомпаний.Найти(ВидКлиента) <> Неопределено Тогда
		ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Компания, КонтрагентСсылка);	
	Иначе           
		ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Контакт, КонтрагентСсылка);	
	КонецЕсли;

КонецПроцедуры

Процедура ЗарегистрироватьНоменклатуру(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, НоменклатураСсылка)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	НастройкаПодключения = ИнформацияОНастройкеСинхронизации.НастройкаПодключения;	
	Если ТипКонфигурации = "БП" Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураСсылка, "ЭтоГруппа");
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураСсылка, "ЭтоГруппа, ИспользованиеХарактеристик");
	КонецЕсли;

	Если ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда		
		Если ЗначенияРеквизитов.ЭтоГруппа = Истина Тогда
			Если ИнформацияОНастройкеСинхронизации.ИсточникИерархии = "Иерархия номенклатуры" Тогда
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ГруппаТовара2, НоменклатураСсылка);
			КонецЕсли;
		Иначе 
			Если ТипКонфигурации = "БП" Тогда
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Товар2, НоменклатураСсылка);	
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Предложение, НоменклатураСсылка);
			ИначеЕсли ТипКонфигурации = "УТ" Тогда
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Товар2, НоменклатураСсылка, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());	
				Если ЗначенияРеквизитов.ИспользованиеХарактеристик = Перечисления["ВариантыИспользованияХарактеристикНоменклатуры"].НеИспользовать Тогда
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Предложение, НоменклатураСсылка, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());	
				КонецЕсли;			
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ЗначенияРеквизитов.ЭтоГруппа = Истина Тогда 
			Если ИнформацияОНастройкеСинхронизации.ИсточникИерархии = "Иерархия номенклатуры" Тогда
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ГруппаТовара, НоменклатураСсылка);	
			КонецЕсли;
		Иначе
			Если ТипКонфигурации = "БП" Тогда
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Товар, НоменклатураСсылка);	
			ИначеЕсли ТипКонфигурации = "УТ" Тогда
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Товар, НоменклатураСсылка, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  

КонецПроцедуры  

Процедура ЗарегистрироватьХарактеристикиНоменклатуры(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, ХарактеристикаСсылка)
	
	НастройкаПодключения = ИнформацияОНастройкеСинхронизации.НастройкаПодключения;
	
	Если ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда   
		ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Предложение, ХарактеристикаСсылка);	
	Иначе                      
		ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Товар, Справочники.Номенклатура.ПустаяСсылка(), ХарактеристикаСсылка);	
	КонецЕсли;       
	
КонецПроцедуры  

Процедура ЗарегистрироватьСчет(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, СчетСсылка)
	
	Если ИнформацияОНастройкеСинхронизации.ВерсияСчетов = "v.2" Тогда           
		ПроверитьИДобавитьОбъектВТаблицуИзменений(ИнформацияОНастройкеСинхронизации.НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Счет2, СчетСсылка);	
	Иначе              
		ПроверитьИДобавитьОбъектВТаблицуИзменений(ИнформацияОНастройкеСинхронизации.НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Счет, СчетСсылка);	
	КонецЕсли;

КонецПроцедуры

Процедура ЗарегистрироватьЗаказ(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, ЗаказСсылка)    
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("ИнтеграцияСервисов") Тогда
		
		НастройкаПодключения = ИнформацияОНастройкеСинхронизации.НастройкаПодключения;
		
		НеСинхронизироватьЗаказыСозданныеЧерезИнтеграциюСервисов = Б24_КБ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьСохраненнуюНастройкуИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения, "НеСинхронизироватьЗаказыПривязанныеКСделкам", Ложь);
		Если НеСинхронизироватьЗаказыСозданныеЧерезИнтеграциюСервисов Тогда

			ЗапросДляИнтеграцииСервисов = Новый Запрос;
			ЗапросДляИнтеграцииСервисов.УстановитьПараметр("ТипОбъекта"				, ЗаказСсылка.Метаданные().ПолноеИмя());
			ЗапросДляИнтеграцииСервисов.УстановитьПараметр("ИдентификаторОбъекта"	, XMLСтрока(ЗаказСсылка));
			ЗапросДляИнтеграцииСервисов.УстановитьПараметр("НастройкаПодключения"	, НастройкаПодключения);
			ЗапросДляИнтеграцииСервисов.УстановитьПараметр("ТипДанныхДелаСделок"	, ТипыДанныхДляОбменаСПорталом.ДелоСделки);
			ЗапросДляИнтеграцииСервисов.Текст = "ВЫБРАТЬ
			|	Б24_КБ_ОбъектыСозданныеЧерезСлайдер.ИдентификаторОбъекта КАК ИдентификаторОбъекта
			|ИЗ
			|	РегистрСведений.Б24_КБ_ОбъектыСозданныеЧерезСлайдер КАК Б24_КБ_ОбъектыСозданныеЧерезСлайдер
			|ГДЕ             
			|	Б24_КБ_ОбъектыСозданныеЧерезСлайдер.ТипОбъекта = &ТипОбъекта
			|	И Б24_КБ_ОбъектыСозданныеЧерезСлайдер.ИдентификаторОбъекта = &ИдентификаторОбъекта
			|	И Б24_КБ_ОбъектыСозданныеЧерезСлайдер.ТипДанных = &ТипДанныхДелаСделок
			|	И Б24_КБ_ОбъектыСозданныеЧерезСлайдер.НастройкаПодключения = &НастройкаПодключения";
			
			ВыполненныйЗапросДляИнтеграцииСервисов = ЗапросДляИнтеграцииСервисов.Выполнить();
			Если НЕ ВыполненныйЗапросДляИнтеграцииСервисов.Пустой() Тогда  
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СкладскойУчет") Тогда
		
		НастройкаПодключения = ИнформацияОНастройкеСинхронизации.НастройкаПодключения;	
		Если РегистрыСведений.Б24_СУ_СозданныеДокументы.ПроверитьНаличиеЗаписиВРегистре(НастройкаПодключения, ЗаказСсылка) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	
	
	ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Сделка, ЗаказСсылка);	
	
КонецПроцедуры

Процедура ЗарегистрироватьОплатуОтгрузку(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, ДокументСсылка)    
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ТипОбъекта 	= ТипЗнч(ДокументСсылка);	
	ПоддержкаСделок = Ложь; // ограничение из-за реста. Из сделок можно создавать из 1С только оплаты
	
	Если ТипКонфигурации = "БП" Тогда
		СчетНаОплату = Документы.СчетНаОплатуПокупателю.ПустаяСсылка();	
		Если ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.РеализацияТоваровУслуг") Тогда			
			РеквизитыОтгрузки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "СчетНаОплатуПокупателю, ВидОперации");
			Если РеквизитыОтгрузки.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.ОтгрузкаБезПереходаПраваСобственности
				ИЛИ РеквизитыОтгрузки.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Оборудование Тогда
				Возврат;
			КонецЕсли;			
			СчетНаОплату = РеквизитыОтгрузки.СчетНаОплатуПокупателю;	    
			ТипыДанныхДляОбмена = ТипыДанныхДляОбменаСПорталом.Отгрузка;			
		Иначе			
			ПоддержкаСделок = Истина;			
			РеквизитыОплаты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ВидОперации, РасшифровкаПлатежа");
			Если РеквизитыОплаты.РасшифровкаПлатежа.Пустой() Тогда
				Возврат;
			КонецЕсли; 
			
			Если НЕ (РеквизитыОплаты.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя 
				ИЛИ РеквизитыОплаты.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаПокупателя 
				ИЛИ РеквизитыОплаты.ВидОперации = Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаПокупателя) Тогда
				Возврат;
			КонецЕсли;
			
			РасшифровкаПлатежа = РеквизитыОплаты.РасшифровкаПлатежа.Выгрузить();
			Если РасшифровкаПлатежа.Количество() > 0 Тогда   
				СчетНаОплату = ДокументСсылка.РасшифровкаПлатежа[0].СчетНаОплату; 
				ТипыДанныхДляОбмена = ТипыДанныхДляОбменаСПорталом.Оплата;
			КонецЕсли;			
		КонецЕсли;       
		
		Если НЕ ЗначениеЗаполнено(СчетНаОплату) Тогда
			Возврат;
		КонецЕсли;				
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		Заказ = Документы["ЗаказКлиента"].ПустаяСсылка();
		Если ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Заказ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ЗаказКлиента");	    
			ТипыДанныхДляОбмена = ТипыДанныхДляОбменаСПорталом.Отгрузка;
		Иначе        
			ПоддержкаСделок = Истина;
			Если ДокументСсылка.РасшифровкаПлатежа.Количество() > 0 Тогда   
				Заказ = ДокументСсылка.РасшифровкаПлатежа[0].ОснованиеПлатежа;
				ТипыДанныхДляОбмена = ТипыДанныхДляОбменаСПорталом.Оплата;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Заказ) Тогда
			Возврат;
		КонецЕсли;
		
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СкладскойУчет") Тогда		
			Если РегистрыСведений.Б24_СУ_СозданныеДокументы.ПроверитьНаличиеЗаписиВРегистре(НастройкаПодключения, Заказ) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал"			, НастройкаПодключения.Портал);
	Если ТипКонфигурации = "БП" Тогда
		Запрос.УстановитьПараметр("Объект"			, СчетНаОплату);					
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		Запрос.УстановитьПараметр("Объект"			, Заказ);					
	КонецЕсли;	
	Запрос.УстановитьПараметр("ТипДанныхЗаказ"	, ТипыДанныхДляОбменаСПорталом.Заказ);  
	Запрос.УстановитьПараметр("ТипДанныхСделка"	, ТипыДанныхДляОбменаСПорталом.Сделка);  
	Запрос.УстановитьПараметр("ПоддержкаСделок"	, ПоддержкаСделок);  
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Документ,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхЗаказ
	|	И Б24_К_ИдентификаторыОбъектов.Объект = &Объект
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектов.Объект КАК Документ,
	|	Б24_К_ИдентификаторыОбъектов.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектов КАК Б24_К_ИдентификаторыОбъектов
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектов.Портал = &Портал
	|	И Б24_К_ИдентификаторыОбъектов.ТипДанных = &ТипДанныхСделка
	|	И Б24_К_ИдентификаторыОбъектов.Объект = &Объект
	|	И &ПоддержкаСделок = ИСТИНА";
	ВыполненныйЗапрос = Запрос.Выполнить();
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда    
		ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбмена, ДокументСсылка);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьДопРеквизит(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, РеквизитСсылка) Экспорт
	
	НастройкаПодключения = ИнформацияОНастройкеСинхронизации.НастройкаПодключения;	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" Тогда
		СправочникКомпаний = "Контрагенты";
		СправочникКонтактныеЛица = "КонтактныеЛица";
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		СправочникКомпаний = "Партнеры";
		СправочникКонтактныеЛица = "КонтактныеЛицаПартнеров";
	КонецЕсли;
	
	
	Если ТипКонфигурации = "БП" Тогда
		Справочник_Контрагенты 		= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Контрагенты");
		Справочник_КонтактныеЛица 	= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_КонтактныеЛица");
		Документ_СчетНаОплату 		= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_СчетНаОплатуПокупателю");
		Справочник_Номенклатура 	= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Номенклатура");
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		Справочник_Контрагенты 				= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Партнеры");
		Справочник_КонтактныеЛица 			= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_КонтактныеЛицаПартнеров");
		Документ_ЗаказКлиента 				= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_ЗаказКлиента");
		Документ_СчетНаОплатуКлиенту 		= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Документ_СчетНаОплатуКлиенту");
		Справочник_Номенклатура 			= Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_Номенклатура");
		Справочник_ХарактеристикиНоменклатуры = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНаборСвойств("Справочник_ХарактеристикиНоменклатуры");
	КонецЕсли;
	
	спкНаборыСвойств = ПолучитьСписокНаборов(РеквизитСсылка);
	
	Для Каждого НаборСвойств Из спкНаборыСвойств Цикл
		
		Если НаборСвойств = Справочник_Контрагенты или (ТипКонфигурации = "УТ" и НаборСвойств.ПринадлежитЭлементу(Справочник_Контрагенты)) Тогда
			
			Если СтрНайти(РеквизитСсылка.Комментарий, "Свойство компании (Битрикс24)")>0 Тогда
				ДляКомпаний 	= Истина;
			Иначе
				ДляКомпаний 	= Ложь;
			КонецЕсли;
			
			Если СтрНайти(РеквизитСсылка.Комментарий, "Свойство контакта (Битрикс24)")>0 Тогда
				ДляКонтактов 	= Истина;
			Иначе
				ДляКонтактов 	= Ложь;
			КонецЕсли;
			
			Если НЕ ДляКомпаний И НЕ ДляКонтактов Тогда
				ДляКомпаний 	= Истина;
				ДляКонтактов 	= Истина;
			КонецЕсли;
			
			Если ДляКомпаний И 
				((ТипКонфигурации = "БП" и ИнформацияОНастройкеСинхронизации.ВыгружатьДПКонтрагентовКомпании = Истина)
				или (ТипКонфигурации = "УТ" и ИнформацияОНастройкеСинхронизации.ВыгружатьДППартнеровКомпании = Истина)) Тогда     
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоКомпании, РеквизитСсылка);	
				Если РеквизитСсылка.ДополнительныеЗначенияИспользуются Тогда            
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваКомпании, РеквизитСсылка);	
				КонецЕсли;
			КонецЕсли;
			
			Если ДляКонтактов И
				((ТипКонфигурации = "БП" и ИнформацияОНастройкеСинхронизации.ВыгружатьДПКонтрагентовКонтакты = Истина)
				или (ТипКонфигурации = "УТ" и ИнформацияОНастройкеСинхронизации.ВыгружатьДППартнеровКонтакты = Истина)) Тогда          
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоКонтакта, РеквизитСсылка);	
				Если РеквизитСсылка.ДополнительныеЗначенияИспользуются Тогда   
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваКонтакта, РеквизитСсылка);	
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ИнформацияОНастройкеСинхронизации.ВыгружатьДПКонтактов = Истина И НаборСвойств = Справочник_КонтактныеЛица Тогда
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоКонтакта, РеквизитСсылка);	
			Если РеквизитСсылка.ДополнительныеЗначенияИспользуются Тогда        
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваКонтакта, РеквизитСсылка);	
			КонецЕсли;
			
		ИначеЕсли ТипКонфигурации = "БП" 
			и ИнформацияОНастройкеСинхронизации.ВыгружатьДПСчетов = Истина 
			И НаборСвойств = Документ_СчетНаОплату Тогда
			
			Если ИнформацияОНастройкеСинхронизации.ВерсияСчетов = "v.2" Тогда       
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоСчета2, РеквизитСсылка);	
			Иначе          
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоСчета, РеквизитСсылка);	
			КонецЕсли;
			
			Если РеквизитСсылка.ДополнительныеЗначенияИспользуются Тогда 
				Если ИнформацияОНастройкеСинхронизации.ВерсияСчетов = "v.2" Тогда     
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваСчета2, РеквизитСсылка);	
				Иначе    
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваСчета, РеквизитСсылка);	
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТипКонфигурации = "УТ"
			и ИнформацияОНастройкеСинхронизации.ВыгружатьДПСделок = Истина
			И НаборСвойств = Документ_ЗаказКлиента Тогда
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоСделки, РеквизитСсылка);	
			Если РеквизитСсылка.ДополнительныеЗначенияИспользуются Тогда  
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваСделки, РеквизитСсылка);	
			КонецЕсли;
			
		ИначеЕсли ИнформацияОНастройкеСинхронизации.ВыгружатьДПТоваров = Истина И (НаборСвойств.ПринадлежитЭлементу(Справочник_Номенклатура) ИЛИ НаборСвойств = Справочник_Номенклатура) Тогда
			
			Если ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда    
				
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоТовара2, РеквизитСсылка);	
				
				ЗначенияРеквизитовОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитСсылка, "ДополнительныеЗначенияИспользуются, ВладелецДополнительныхЗначений");
				Если ЗначенияРеквизитовОбъекта.ДополнительныеЗначенияИспользуются Тогда 
					
					Если ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.ВладелецДополнительныхЗначений) Тогда
						Выборка = Справочники.ЗначенияСвойствОбъектов.Выбрать(, ЗначенияРеквизитовОбъекта.ВладелецДополнительныхЗначений);	
					Иначе
						Выборка = Справочники.ЗначенияСвойствОбъектов.Выбрать(, РеквизитСсылка);	
					КонецЕсли;
					
					Пока Выборка.Следующий() Цикл    
						ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваТовара2, Выборка.Ссылка);	
					КонецЦикла;
					
				КонецЕсли;
			Иначе                               
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоТовара, РеквизитСсылка);	
				Если РеквизитСсылка.ДополнительныеЗначенияИспользуются Тогда 
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваТовара, РеквизитСсылка);	
				КонецЕсли;
			КонецЕсли;   
			
		ИначеЕсли ТипКонфигурации = "УТ"
			и ИнформацияОНастройкеСинхронизации.ВыгружатьДППредложений = Истина
			И (НаборСвойств.ПринадлежитЭлементу(Справочник_ХарактеристикиНоменклатуры) ИЛИ НаборСвойств = Справочник_ХарактеристикиНоменклатуры) Тогда
			
			Если ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда     
				
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоПредложения, РеквизитСсылка);	
				
				ЗначенияРеквизитовОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитСсылка, "ДополнительныеЗначенияИспользуются, ВладелецДополнительныхЗначений");
				Если ЗначенияРеквизитовОбъекта.ДополнительныеЗначенияИспользуются Тогда 
					
					Если ЗначениеЗаполнено(ЗначенияРеквизитовОбъекта.ВладелецДополнительныхЗначений) Тогда
						Выборка = Справочники.ЗначенияСвойствОбъектов.Выбрать(, ЗначенияРеквизитовОбъекта.ВладелецДополнительныхЗначений);	
					Иначе
						Выборка = Справочники.ЗначенияСвойствОбъектов.Выбрать(, РеквизитСсылка);	
					КонецЕсли;
					
					Пока Выборка.Следующий() Цикл         
						ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваПредложения, Выборка.Ссылка);	
					КонецЦикла;
					
				КонецЕсли;
				
			Иначе                                 
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.СвойствоТовара, РеквизитСсылка);	
				Если РеквизитСсылка.ДополнительныеЗначенияИспользуются Тогда 
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.ЗначениеСвойстваТовара, РеквизитСсылка);	
				КонецЕсли;
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;	 
	
КонецПроцедуры

Процедура ЗарегистрироватьСчетПоДокументуОснованию(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Источник)
	
	Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьСчета Тогда
		Возврат;
	КонецЕсли;
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	Если ТипКонфигурации = "УНФ" Тогда
		ИмяДокументаСчета = "СчетНаОплату";
	ИначеЕсли ТипКонфигурации = "БП" Тогда
		ИмяДокументаСчета = "СчетНаОплатуПокупателю";
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка." + ИмяДокументаСчета) Тогда
		ЗарегистрироватьСчет(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Источник.ДокументОснование);
	КонецЕсли;
	
КонецПроцедуры
