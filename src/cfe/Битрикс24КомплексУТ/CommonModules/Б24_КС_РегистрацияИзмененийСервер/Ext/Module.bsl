  
#Область ПодпискиНаСобытия

Процедура ПодпискаНаСобытиеСправочникДокументПриЗаписи(Источник, Отказ) Экспорт 

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ЗарегистрироватьИзменения(Источник);

КонецПроцедуры

Процедура ПодпискаНаСобытиеРегистрПередЗаписью(Источник, Отказ, Замещение) Экспорт 

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьИзменения(Источник, Замещение);

КонецПроцедуры

#КонецОбласти
  
  
#Область РегистрацияИзменений

Процедура ЗарегистрироватьИзменения(Источник, Замещение = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" Тогда
		СправочникКомпаний = "Контрагенты";
		СправочникКонтактныеЛица = "КонтактныеЛица";
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		СправочникКомпаний = "Партнеры";
		СправочникКонтактныеЛица = "КонтактныеЛицаПартнеров";
	КонецЕсли;
	ТипОбъекта 	= ТипЗнч(Источник);
	
#Область ДобавлениеИнформацииДляИсключенияРегистрации
	ЗагрузкаСБитрикс24 = Неопределено;
	Источник.ДополнительныеСвойства.Свойство("ЗагрузкаСБитрикс24", ЗагрузкаСБитрикс24);
	
	Если ЗагрузкаСБитрикс24 = Истина ИЛИ ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
		Возврат;
	КонецЕсли;
#КонецОбласти	

	ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();

	МассивВыгружаемыхВРежимеРеальногоВремени = Б24_КС_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьМассивНастроекОВыгружаемыхДанных(Истина);
	Для каждого ИнформацияОНастройкеСинхронизации Из МассивВыгружаемыхВРежимеРеальногоВремени Цикл
		
		НастройкаПодключения = ИнформацияОНастройкеСинхронизации.НастройкаПодключения;
		
		Если ТипКонфигурации = "БП"
			и ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.Контрагенты") Тогда
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьКонтрагентов Тогда            
				Продолжить;
			КонецЕсли;
			
			Если Источник.ЭтоГруппа Тогда            
				Продолжить;
			КонецЕсли;
			
			ЗарегистрироватьКонтрагента(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, Источник.Ссылка);
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Реквизит, Источник.Ссылка);	
			
		ИначеЕсли ТипКонфигурации = "УТ"
			и ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.Контрагенты") Тогда
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьКонтрагентов Тогда            
				Продолжить;
			КонецЕсли;
			
			ЗарегистрироватьКонтрагента(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, Источник.Партнер);
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Реквизит, Источник.Ссылка);	
			
		ИначеЕсли ТипКонфигурации = "УТ" 
				и ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.Партнеры") Тогда
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьПартнеров Тогда             
				Продолжить;
			КонецЕсли;
			
			ЗарегистрироватьКонтрагента(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом, Источник.Ссылка);
			
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.Организации") Тогда
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьОрганизации Тогда
				Продолжить;
			КонецЕсли;
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Компания, Источник.Ссылка);	
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Реквизит, Источник.Ссылка);	
			
		ИначеЕсли ТипОбъекта = Тип("СправочникОбъект."+СправочникКонтактныеЛица) Тогда
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьКонтактныеЛица Тогда
				Продолжить;
			КонецЕсли;     
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Контакт, Источник.Ссылка);	
			
		ИначеЕсли ТипКонфигурации = "БП"
			и ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.БанковскиеСчета") Тогда 
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьБанкСчета Тогда
				Продолжить;
			КонецЕсли;
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.БанковскийСчетРеквизита, Источник.Ссылка);	
			
		ИначеЕсли ТипКонфигурации = "УТ"
			и (ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.БанковскиеСчетаКонтрагентов") 
			ИЛИ ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.БанковскиеСчетаОрганизаций")) Тогда 
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьБанкСчета Тогда
				Продолжить;
			КонецЕсли;
			
			ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.БанковскийСчетРеквизита, Источник.Ссылка);	
			
		ИначеЕсли ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.Номенклатура") Тогда 
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьТовары Тогда
				Продолжить;
			КонецЕсли;
			
			ЗарегистрироватьНоменклатуру(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Источник.Ссылка);
			
			Если ТипКонфигурации = "БП"
				И НЕ Источник.ЭтоГруппа 
				И ИнформацияОНастройкеСинхронизации.ПакетнаяРегистрацияИзменений Тогда   
				
				Если ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда        
					Если ИнформацияОНастройкеСинхронизации.ВыгружатьОстатки Тогда      
						ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, Источник.Ссылка);    
					КонецЕсли;
					Если ИнформацияОНастройкеСинхронизации.ВыгружатьЦены Тогда      
						ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Цена, Источник.Ссылка);	   
					КонецЕсли;
				КонецЕсли;				
			ИначеЕсли ТипКонфигурации = "УТ"
				и НЕ Источник.ЭтоГруппа Тогда 
				
				Если Источник.ИспользованиеХарактеристик = Перечисления["ВариантыИспользованияХарактеристикНоменклатуры"].ОбщиеДляВидаНоменклатуры Тогда
					Выборка = Справочники["ХарактеристикиНоменклатуры"].Выбрать(, Источник.ВидНоменклатуры);
					Пока Выборка.Следующий() Цикл    
						ЗарегистрироватьХарактеристикиНоменклатуры(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Выборка.Ссылка);
					КонецЦикла;   
				ИначеЕсли Источник.ИспользованиеХарактеристик = Перечисления["ВариантыИспользованияХарактеристикНоменклатуры"].ОбщиеСДругимВидомНоменклатуры Тогда
					Выборка = Справочники["ХарактеристикиНоменклатуры"].Выбрать(, Источник.ВладелецХарактеристик);
					Пока Выборка.Следующий() Цикл    
						ЗарегистрироватьХарактеристикиНоменклатуры(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Выборка.Ссылка);
					КонецЦикла;   
				КонецЕсли;                  
				
				Если ИнформацияОНастройкеСинхронизации.ПакетнаяРегистрацияИзменений Тогда   
					
					мВладельцы = Новый Массив;
					Если Источник.ИспользованиеХарактеристик = Перечисления["ВариантыИспользованияХарактеристикНоменклатуры"].ИндивидуальныеДляНоменклатуры Тогда мВладельцы.Добавить(Источник.Ссылка) КонецЕсли;
					//Если Источник.ИспользованиеХарактеристик = Перечисления["ВариантыИспользованияХарактеристикНоменклатуры"].ОбщиеДляВидаНоменклатуры Тогда мВладельцы.Добавить(Источник.ВидНоменклатуры) КонецЕсли;
					//Если Источник.ИспользованиеХарактеристик = Перечисления["ВариантыИспользованияХарактеристикНоменклатуры"].ОбщиеСДругимВидомНоменклатуры Тогда мВладельцы.Добавить(Источник.ВладелецХарактеристик) КонецЕсли;
					
					Для каждого ТекЭлемент Из мВладельцы Цикл      
						Если НЕ Источник.ИспользованиеХарактеристик = Перечисления["ВариантыИспользованияХарактеристикНоменклатуры"].НеИспользовать Тогда
							
							Выборка = Справочники["ХарактеристикиНоменклатуры"].Выбрать(, ТекЭлемент);
							Пока Выборка.Следующий() Цикл    
								
								Если ИнформацияОНастройкеСинхронизации.ВерсияТоваров <> "v.2" Тогда        
									ЗарегистрироватьХарактеристикиНоменклатуры(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Выборка.Ссылка);
								КонецЕсли;
								
								Если ИнформацияОНастройкеСинхронизации.ПакетнаяРегистрацияИзменений И ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда      
									Если ИнформацияОНастройкеСинхронизации.ВыгружатьОстатки Тогда      
										ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, Источник.Ссылка, Выборка.Ссылка);
									КонецЕсли;
									Если ИнформацияОНастройкеСинхронизации.ВыгружатьЦены Тогда      
										ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Цена, Источник.Ссылка, Выборка.Ссылка);
									КонецЕсли;
								КонецЕсли;	
								
							КонецЦикла;
							
						КонецЕсли;   
						
					КонецЦикла;
					
					Если Источник.ИспользованиеХарактеристик = Перечисления["ВариантыИспользованияХарактеристикНоменклатуры"].НеИспользовать И ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда        
						Если ИнформацияОНастройкеСинхронизации.ВыгружатьОстатки Тогда      
							ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, Источник.Ссылка, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());    
						КонецЕсли;
						Если ИнформацияОНастройкеСинхронизации.ВыгружатьЦены Тогда      
							ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Цена, Источник.Ссылка, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());	   
						КонецЕсли;
					КонецЕсли;	
					
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТипКонфигурации = "УТ" 
			и ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.НоменклатураПрисоединенныеФайлы") Тогда 
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьТовары Тогда
				Продолжить;
			КонецЕсли;
			              
			Если ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда   
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.КартинкаФайлТовара2, Источник.Ссылка);	
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Товар2, Источник.ВладелецФайла, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());	
			Иначе    
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.КартинкаФайлТовара, Источник.Ссылка);	
				ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Товар, Источник.ВладелецФайла, Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка());	
			КонецЕсли;
			
		ИначеЕсли ТипКонфигурации = "УТ" 
			и ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.ХарактеристикиНоменклатуры") Тогда 
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьТовары 
				ИЛИ (ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" И НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьПредложения) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗарегистрироватьХарактеристикиНоменклатуры(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Источник.Ссылка);
			
			Если ИнформацияОНастройкеСинхронизации.ПакетнаяРегистрацияИзменений И ТипЗнч(Источник.Владелец) = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникСсылка.Номенклатура") И ИнформацияОНастройкеСинхронизации.ВерсияТоваров = "v.2" Тогда
				Если ИнформацияОНастройкеСинхронизации.ВыгружатьОстатки Тогда  	
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Остаток, Источник.Владелец, Источник.Ссылка);	
				КонецЕсли;				
				Если ИнформацияОНастройкеСинхронизации.ВыгружатьЦены Тогда
					ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, ТипыДанныхДляОбменаСПорталом.Цена, Источник.Владелец, Источник.Ссылка);
				КонецЕсли;				
			КонецЕсли;
			
		ИначеЕсли ТипОбъекта =  Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("СправочникОбъект.Б24_КС_ПользовательскиеГруппыТоваров") Тогда 
			
			Если НЕ ИнформацияОНастройкеСинхронизации.ВыгружатьТовары Тогда
				Продолжить;
			КонецЕсли;
			
			Для каждого ТекТовар Из Источник["Товары"] Цикл
				
				Номенклатура = ТекТовар.Номенклатура;
				Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЭтоГруппа") Тогда
					
					Выборка = Справочники.Номенклатура.ВыбратьИерархически(Номенклатура);
					Пока Выборка.Следующий() Цикл
						
						Номенклатура = Выборка.Ссылка;
						Если НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЭтоГруппа") Тогда         
							ЗарегистрироватьНоменклатуру(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Номенклатура)							
						КонецЕсли;
						
					КонецЦикла;
					
				Иначе           
					ЗарегистрироватьНоменклатуру(ИнформацияОНастройкеСинхронизации, ТипыДанныхДляОбменаСПорталом, Номенклатура);							
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(Источник.Родитель) И ИнформацияОНастройкеСинхронизации.ИсточникИерархии = "Произвольная иерархия" Тогда
