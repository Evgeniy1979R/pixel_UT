#Область СлужебныеПроцедурыИФункции

Функция ВерсияМодуля() Экспорт

	Возврат "1.0.0";

КонецФункции

// Сериализует данные в строку JSON (UTF-8 без BOM).
Функция ДанныеВСтрокуJSON(Данные) Экспорт

	Возврат Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(Данные);

КонецФункции

// Читает строку JSON в Соответствие.
Функция СтрокаJSONВСоответствие(Знач СтрокаJSON) Экспорт

	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Попытка
		Возврат Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(СтрокаJSON, Истина);
	Исключение
		Возврат Новый Соответствие;
	КонецПопытки;

КонецФункции

// Формирует карту заголовков авторизованного запроса по контракту (§2).
Функция ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра) Экспорт

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("X-Onec-Instance-Id", ИдентификаторЭкземпляра);
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ТекущаяИнформация = Новый СистемнаяИнформация;
	Заголовки.Вставить("User-Agent", "VibeCode-1C/" + ВерсияМодуля()
		+ " 1C:Enterprise/" + ТекущаяИнформация.ВерсияПриложения);
	Возврат Заголовки;

КонецФункции

// Разбирает URL на сервер/порт/путь для HTTP-клиента.
// Возвращает структуру {Сервер, Порт, АдресСкрипта, ЗащищенноеСоединение} или Неопределено.
Функция РазобратьURL(URL) Экспорт

	НастройкиСоединения = Новый Структура;
	Если Б24_К_RestApiВызовСервера.РазобратьАдресСайта(URL, НастройкиСоединения) Тогда
		Возврат НастройкиСоединения;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Выполняет HTTP-запрос к Integration REST. Соединение создаётся и разрушается внутри.
//   URL            - полный адрес (для POST может содержать {id}).
//   ИмяМетода      - "GET" или "POST".
//   ТелоJSON       - строка JSON для тела (для POST), пустая - без тела.
//   Заголовки      - Соответствие дополнительных заголовков.
//   ТаймаутСекунд  - таймаут соединения (>35 для long-poll).
// Возвращает структуру:
//   Статус (HTTP-статус или -1 при транспортной ошибке),
//   Тело (строка ответа), JSON (Соответствие разобранного тела, может быть пустым).
Функция ВыполнитьHTTPЗапрос(Знач URL, Знач ИмяМетода = "GET", Знач ТелоJSON = "",
	Знач Заголовки = Неопределено, Знач ТаймаутСекунд = 35) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Статус", -1);
	Результат.Вставить("Тело", "");
	Результат.Вставить("JSON", Новый Соответствие);
	Результат.Вставить("Заголовки", Новый Соответствие);

	// Нормализуем двойные слэши в пути (кроме "://"): база может заканчиваться на "/".
	ПозицияСхемы = СтрНайти(URL, "://");
	Если ПозицияСхемы > 0 Тогда
		СхемаСПортом = Лев(URL, ПозицияСхемы + 2);
		ОстатокURL = Прав(URL, СтрДлина(URL) - (ПозицияСхемы + 2));
		Пока СтрНайти(ОстатокURL, "//") > 0 Цикл
			ОстатокURL = СтрЗаменить(ОстатокURL, "//", "/");
		КонецЦикла;
		URL = СхемаСПортом + ОстатокURL;
	КонецЕсли;

	НастройкиСоединения = РазобратьURL(URL);
	Если НастройкиСоединения = Неопределено ИЛИ ПустаяСтрока(НастройкиСоединения.Сервер) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Прокси = Неопределено;
		Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(
			?(НастройкиСоединения.ЗащищенноеСоединение, "HTTPS", "HTTP"));
		СекретноеСоединение = Неопределено;
		Если НастройкиСоединения.ЗащищенноеСоединение Тогда
			СекретноеСоединение = Б24_К_ОбщегоНазначенияВызовСервера.НовоеЗащищенноеСоединение();
		КонецЕсли;
		Соединение = Новый HTTPСоединение(НастройкиСоединения.Сервер,
			НастройкиСоединения.Порт,,, Прокси, ТаймаутСекунд, СекретноеСоединение);
	Исключение
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ(
			"HTTPConnect", "Не удалось создать HTTP-соединение: " + URL);
		Возврат Результат;
	КонецПопытки;

	Запрос = Новый HTTPЗапрос;
	АдресРесурса = НастройкиСоединения.АдресСкрипта;
	Если НЕ ПустаяСтрока(АдресРесурса) И Лев(АдресРесурса, 1) <> "/" Тогда
		АдресРесурса = "/" + АдресРесурса;
	КонецЕсли;
	Запрос.АдресРесурса = АдресРесурса;

	Если НЕ Заголовки = Неопределено Тогда
		Для каждого КлючЗначение Из Заголовки Цикл
			Запрос.Заголовки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ТелоJSON) Тогда
		// Вставляем заголовок безусловно: метод Вставить перезаписывает существующий
		// и не зависит от метода Свойство, который нестабилен в этой среде.
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ТелоJSON);
	КонецЕсли;

	// Успешные опросы и статусы в лог не пишем: потоковые логи (запрос/ответ)
	// ведёт вызывающий код - задание (режим PUSH) и HTTP-сервис (режим HTTP).
	// Здесь остаются только ошибки транспорта.
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(ИмяМетода, Запрос);
		Результат.Статус = Ответ.КодСостояния;
		Результат.Тело = Ответ.ПолучитьТелоКакСтроку();
		// Захватываем заголовки ответа (нужны для ETag у /settings).
		Попытка
			Результат.Заголовки = Ответ.Заголовки;
		Исключение
			// Заголовки недоступны - остаётся пустое Соответствие.
		КонецПопытки;
	Исключение
		// Транспортная ошибка: сеть, таймаут, 5xx, TLS. Токен не трогаем.
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ(
			"HTTPRequest", "Транспортная ошибка HTTP-запроса " + ИмяМетода + " " + URL);
		Возврат Результат;
	КонецПопытки;

	Попытка
		Если НЕ ПустаяСтрока(Результат.Тело) Тогда
		Результат.JSON = СтрокаJSONВСоответствие(Результат.Тело);
	КонецЕсли;
	Исключение
		// Не-JSON ответ - транспортная ошибка уровня контракта.
		Результат.Статус = -1;
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ(
			"HTTPResponse", "Не-JSON ответ от " + URL);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Извлекает код бизнес-ошибки из корректного JSON-конверта ошибки.
// Возвращает пустую строку, если конверт не является ошибкой интеграции.
Функция КодОшибкиИнтеграции(СоответствиеJSON) Экспорт

	Если СоответствиеJSON = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Успех = ЗначениеПоКлючу(СоответствиеJSON, "success");
	Если НЕ Успех = Ложь Тогда
		Возврат "";
	КонецЕсли;

	Ошибка = ЗначениеПоКлючу(СоответствиеJSON, "error");
	Код = ЗначениеПоКлючу(Ошибка, "code");
	Если НЕ Код = Неопределено Тогда
		Возврат Строка(Код);
	КонецЕсли;

	Возврат "";

КонецФункции

// Безопасное чтение значения по ключу без метода Свойство.
// Возвращает Неопределено, если ключа нет или тип не поддерживает индексирование.
Функция ЗначениеПоКлючу(Данные, Ключ) Экспорт

	Попытка
		Если НЕ Данные = Неопределено Тогда
			Возврат Данные[Ключ];
		КонецЕсли;
	Исключение
		// Ключ отсутствует или тип не поддерживает индексирование.
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти


#Область ИнтеграционныеМетоды

// ТелоЗапроса - тело connect (только instanceId и name); Токен - выданный ключ (Bearer),
//   ИдентификаторЭкземпляра - для заголовка X-Onec-Instance-Id.
Функция ОтправитьConnect(Знач БазовыйURL, Знач ТелоЗапроса, Знач Токен,
	Знач ИдентификаторЭкземпляра) Экспорт

	Тело = ДанныеВСтрокуJSON(ТелоЗапроса);
	РезультатЗапроса = ВыполнитьHTTPЗапрос(БазовыйURL + "/connect", "POST", Тело,
		ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра), 60);
	Возврат РезультатЗапроса;

КонецФункции

// POST /heartbeat: сигнал жизни в HTTP-режиме.
Функция ОтправитьHeartbeat(Знач БазовыйURL, Знач Токен, Знач ИдентификаторЭкземпляра,
	Знач ВерсияКаталога) Экспорт

	Тело = ДанныеВСтрокуJSON(Новый Структура("moduleVersion, catalogVersion",
		ВерсияМодуля(), ВерсияКаталога));
	Возврат ВыполнитьHTTPЗапрос(БазовыйURL + "/heartbeat", "POST", Тело,
		ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра), 60);

КонецФункции

// GET /commands: long-poll команд P&P.
// Возвращает структуру результата HTTP-запроса.
Функция ПолучитьКоманды(Знач БазовыйURL, Знач Токен, Знач ИдентификаторЭкземпляра,
	Знач ВерсияКаталога, Знач ВремяОжидания = 20, Знач Лимит = 1) Экспорт

	Параметры = "wait=" + Формат(ВремяОжидания, "ЧДЦ=0; ЧГ=")
		+ "&limit=" + Формат(Лимит, "ЧДЦ=0; ЧГ=")
		+ "&moduleVersion=" + ВерсияМодуля()
		+ "&catalogVersion=" + КодироватьСтроку(ВерсияКаталога, СпособКодированияСтроки.КодировкаURL);
	Адрес = БазовыйURL + "/commands?" + Параметры;
	Возврат ВыполнитьHTTPЗапрос(Адрес, "GET", "", 
		ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра), 35);

КонецФункции

// POST /commands/{id}/result: результат команды.
Функция ОтправитьРезультатКоманды(Знач URLРезультата, Знач Токен,
	Знач ИдентификаторЭкземпляра, Знач ИдКоманды, Знач ТелоРезультата) Экспорт

	Адрес = СтрЗаменить(URLРезультата, "{id}", ИдКоманды);
	// По контракту P&P результат команды идемпотентен: заголовок
	// Idempotency-Key должен равняться commandId.
	Заголовки = ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра);
	Заголовки.Вставить("Idempotency-Key", ИдКоманды);
	Тело = ДанныеВСтрокуJSON(ТелоРезультата);
	Возврат ВыполнитьHTTPЗапрос(Адрес, "POST", Тело, Заголовки, 60);

КонецФункции

// GET /connection: статус и диагностика подключения.
Функция ПолучитьСтатусПодключения(Знач БазовыйURL, Знач Токен, Знач ИдентификаторЭкземпляра) Экспорт

	Возврат ВыполнитьHTTPЗапрос(БазовыйURL + "/connection", "GET", "",
		ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра), 60);

КонецФункции

// POST /disconnect: отзыв токена самим модулем.
Функция ОтправитьDisconnect(Знач БазовыйURL, Знач Токен, Знач ИдентификаторЭкземпляра) Экспорт

	Тело = ДанныеВСтрокуJSON(Новый Структура);
	Возврат ВыполнитьHTTPЗапрос(БазовыйURL + "/disconnect", "POST", Тело,
		ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра), 60);

КонецФункции

// GET /settings: получить конфигурацию модуля, хранящуюся на портале.
// Возвращает структуру результата HTTP-запроса (client-envelope {success,data}).
Функция ПолучитьКонфигурацию(Знач БазовыйURL, Знач Токен, Знач ИдентификаторЭкземпляра) Экспорт

	Возврат ВыполнитьHTTPЗапрос(БазовыйURL + "/settings", "GET", "",
		ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра), 60);

КонецФункции

// PUT /settings: сохранить конфигурацию (создать или обновить).
// ИдемпотентностиКлюч - UUID для этого сохранения (заголовок Idempotency-Key);
// ЭтоСоздание - Истина: If-None-Match: * (создать, только если нет);
// ETag - актуальный из GET: If-Match: <ETag> (обновление с оптимистичной блокировкой).
// Конфигурация - Соответствие/Структура произвольного JSON-объекта.
Функция СохранитьКонфигурациюПолностью(Знач БазовыйURL, Знач Токен,
	Знач ИдентификаторЭкземпляра, Конфигурация,
	Знач ИдемпотентностиКлюч = "", Знач ЭтоСоздание = Ложь, Знач ETag = "") Экспорт

	Заголовки = ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра);
	Если НЕ ПустаяСтрока(ИдемпотентностиКлюч) Тогда
		Заголовки.Вставить("Idempotency-Key", ИдемпотентностиКлюч);
	КонецЕсли;
	Если ЭтоСоздание Тогда
		Заголовки.Вставить("If-None-Match", "*");
	ИначеЕсли НЕ ПустаяСтрока(ETag) Тогда
		Заголовки.Вставить("If-Match", ETag);
	КонецЕсли;

	Тело = ДанныеВСтрокуJSON(Конфигурация);
	Возврат ВыполнитьHTTPЗапрос(БазовыйURL + "/settings", "PUT", Тело, Заголовки, 60);

КонецФункции

// PATCH /settings: частично обновить конфигурацию модуля.
// Конфигурация - частичный объект {transport?, information1C?, capabilities?}.
// ИдемпотентностиКлюч/ETag - как у обновления PUT (If-Match + Idempotency-Key).
Функция ОбновитьКонфигурациюЧастично(Знач БазовыйURL, Знач Токен,
	Знач ИдентификаторЭкземпляра, Конфигурация,
	Знач ИдемпотентностиКлюч = "", Знач ETag = "") Экспорт

	Заголовки = ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра);
	Если НЕ ПустаяСтрока(ИдемпотентностиКлюч) Тогда
		Заголовки.Вставить("Idempotency-Key", ИдемпотентностиКлюч);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ETag) Тогда
		Заголовки.Вставить("If-Match", ETag);
	КонецЕсли;

	Тело = ДанныеВСтрокуJSON(Конфигурация);
	Возврат ВыполнитьHTTPЗапрос(БазовыйURL + "/settings", "PATCH", Тело, Заголовки, 60);

КонецФункции

// DELETE /settings: удалить конфигурацию модуля.
// ИдемпотентностиКлюч/ETag - как у записи: If-Match:<ETag> + Idempotency-Key.
// Тело отправляется как {} (контракт требует JSON-объект).
Функция УдалитьКонфигурацию(Знач БазовыйURL, Знач Токен, Знач ИдентификаторЭкземпляра,
	Знач ИдемпотентностиКлюч = "", Знач ETag = "") Экспорт

	Заголовки = ЗаголовкиАвторизации(Токен, ИдентификаторЭкземпляра);
	Если НЕ ПустаяСтрока(ИдемпотентностиКлюч) Тогда
		Заголовки.Вставить("Idempotency-Key", ИдемпотентностиКлюч);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ETag) Тогда
		Заголовки.Вставить("If-Match", ETag);
	КонецЕсли;

	Возврат ВыполнитьHTTPЗапрос(БазовыйURL + "/settings", "DELETE", "{}",
		Заголовки, 60);

КонецФункции

#КонецОбласти
