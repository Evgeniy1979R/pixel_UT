#Область ОбработчикиСобытий

// Наименование новой настройки — служебное название конфигурации (УТ, КА, ЕРП, БП, ЗУП).
// Остальные умолчания заданы значениями заполнения реквизитов: Использование = Истина,
// ВсеПользователи = Ложь (отбор по пользователям снят, на портал уходят все
// пользователи), Режим = pushpull (1С сама опрашивает портал, публикация не нужна).
// Значения заполнения платформа применяет уже после этого обработчика, поэтому в коде
// их дублировать бессмысленно — править надо в метаданных справочника.
// При копировании значения берём из источника и заполняем только пустое наименование.
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	// ИД базы (он же instanceId и settingsGuid): у новой настройки заполняется
	// автоматически. При копировании берём новое значение, иначе у двух настроек
	// был бы один ИД и портал считал бы их одной базой.
	Если ПустаяСтрока(ИдентификаторЭкземпляра) ИЛИ НЕ ДанныеЗаполнения = Неопределено Тогда
		ИдентификаторЭкземпляра = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	Если НЕ ДанныеЗаполнения = Неопределено Тогда
		Если ПустаяСтрока(Наименование) Тогда
			Наименование = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьСлужебноеНазваниеКонфигурации();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Наименование = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьСлужебноеНазваниеКонфигурации();

КонецПроцедуры

// Пометка на удаление = отвязка базы от портала: снимаем конфигурацию модуля
// (DELETE /settings), стираем токен и подключение, останавливаем расписание задания.
// Распометка ничего не делает: чтобы вернуться, нужно выполнить подключение заново.
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	// При загрузке данных (обмен, восстановление) логику отвязки не выполняем.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНовый() ИЛИ НЕ ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	// Отвязываем только при переходе в помеченное состояние, а не при каждом
	// пересохранении помеченной настройки.
	ПометкаБылаРанее = Ложь;
	Попытка
		ПометкаБылаРанее = Б24_ИИ_ИнтеграцияСервер.ПометкаУдаленияБылаРанее(Ссылка);
	Исключение
		// Объект ещё не записан - считаем, что пометки не было.
	КонецПопытки;
	Если ПометкаБылаРанее Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Б24_ИИ_ИнтеграцияСервер.ОтвязатьОтПортала(Ссылка);
	Исключение
		// Отвязка не должна мешать пометке на удаление.
		Б24_ИИ_ИнтеграцияСервер.ЗаписатьВЛогVibeCode("HTTP", "Ошибка", "settings",
			"Отвязка: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
