
#Область СлужебныеПроцедурыИФункции

// Возвращает активную (использующуюся, не помеченную на удаление) настройку VibeCode.
// Оборачивает функцию из общего модуля Б24_ИИ_ИнтеграцияСервер.
Функция АктивнаяНастройка() Экспорт

	Возврат Б24_ИИ_ИнтеграцияСервер.ПолучитьАктивнуюНастройкуVibeCode();

КонецФункции

#КонецОбласти


#Область КонфигурацияНастройки

// Выполняет подключение модуля к VibeCode (POST /connect, контракт «один ключ»).
// СтрокаПодключения - строка из кабинета VibeCode вида "<адрес>#vibe_onec_<ключ>".
// Возвращает структуру {Успех, КодОшибки, Сообщение, Данные}.
Функция Подключить(СтрокаПодключения, Настройка = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Настройка = АктивнаяНастройка();
	КонецЕсли;

	Возврат Б24_ИИ_ИнтеграцияСервер.ВыполнитьConnect(Настройка, СтрокаПодключения);

КонецФункции

// GET /settings: получить конфигурацию модуля с портала.
// Возвращает структуру {Успех, КодОшибки, Сообщение, Данные}.
Функция ПолучитьКонфигурацию(Настройка = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Настройка = АктивнаяНастройка();
	КонецЕсли;

	Возврат Б24_ИИ_ИнтеграцияСервер.ПолучитьКонфигурациюМодуля(Настройка);

КонецФункции

// PUT /settings: создать или полностью заменить конфигурацию модуля.
// Конфигурация - Соответствие/Структура/строка JSON.
Функция СохранитьКонфигурацию(Конфигурация, Настройка = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Настройка = АктивнаяНастройка();
	КонецЕсли;

	Возврат Б24_ИИ_ИнтеграцияСервер.СохранитьКонфигурациюМодуля(Настройка, Конфигурация);

КонецФункции

// PATCH /settings: частично обновить конфигурацию модуля.
// Конфигурация - Соответствие/Структура/строка JSON обновляемых полей.
Функция ОбновитьКонфигурацию(Конфигурация, Настройка = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Настройка = АктивнаяНастройка();
	КонецЕсли;

	Возврат Б24_ИИ_ИнтеграцияСервер.ОбновитьКонфигурациюМодуля(Настройка, Конфигурация);

КонецФункции

// DELETE /settings: удалить конфигурацию модуля.
Функция УдалитьКонфигурацию(Настройка = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Настройка = АктивнаяНастройка();
	КонецЕсли;

	Возврат Б24_ИИ_ИнтеграцияСервер.УдалитьКонфигурациюМодуля(Настройка);

КонецФункции

// Формирует конфигурацию по умолчанию из реквизитов настройки (для PUT).
Функция КонфигурацияИзНастройки(Настройка = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Настройка = АктивнаяНастройка();
	КонецЕсли;

	Возврат Б24_ИИ_ИнтеграцияСервер.КонфигурацияИзНастройки(Настройка);

КонецФункции

#КонецОбласти
