
#Область ОбработчикиСобытийФормы

// Во Фреш база работает в модели сервиса, а push-канал там недоступен: связь
// с порталом идёт только через http-сервисы. Поэтому режим принудительно http,
// поле режима закрыто для изменения, а запуск push-сеанса (кнопка «Перезапустить
// сеанс Push and Pull») скрыт. В обычных поставках условие ложно и форма
// работает как раньше.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Если НРег(СокрЛП(Объект.Режим)) <> "http" Тогда
			Объект.Режим = "http";
		КонецЕсли;
		Элементы.РежимПоле.Доступность = Ложь;
		Элементы.КнопкаПерезапуститьЗадание.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Новая настройка сразу считается изменённой: при закрытии платформа
	// спросит «Сохранить изменения?», чтобы не потерять введённые данные.
	Если Объект.Ссылка.Пустая() Тогда
		Модифицированность = Истина;
	КонецЕсли;

	// Статус не должен быть пустым: если подключения ещё не было (статус не
	// присвоен), показываем значение по умолчанию "OFFLINE".
	УстановитьСтатусПоУмолчанию();

	// Применяем видимость таблицы пользователей под текущее значение галки
	// «Все пользователи».
	ОбновитьВидимостьТаблицыПользователей();

	// Поля публикации нужны только http-режиму, в push-pull вместо них пояснение.
	ОбновитьВидимостьПолейПубликации();

	// В реквизите статус лежит кодом (OFFLINE/ONLINE/DISCONNECTED) - на форме
	// показываем его человеческим текстом.
	ОбновитьСостояниеНаФорме();

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ПолеПользовательПриИзменении(Элемент)

	// Обработчик подключён к колонке «Пользователь» табличного поля, поэтому
	// свойство .ТекущиеДанные есть у самого табличного поля, а не у колонки.
	ТекущиеДанные = Элементы.ТаблицаПользователи.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Пользователь) Тогда
		Возврат;
	КонецЕсли;

	// Автозаполняем наименование и GUID при выборе пользователя из справочника.
	ТекущиеДанные.Наименование = Строка(ТекущиеДанные.Пользователь);
	ТекущиеДанные.Гуид = ПолучитьГуидПользователя(ТекущиеДанные.Пользователь);

КонецПроцедуры

// Обработчик галки «Все пользователи»: скрывает/показывает таблицу разрешённых
// пользователей в зависимости от состояния галки.
&НаКлиенте
Процедура ВсеПользователиПриИзменении(Элемент)

	ОбновитьВидимостьТаблицыПользователей();

КонецПроцедуры

// ИД показываем ссылкой: по нажатию открывается окно с текущим значением,
// его можно посмотреть и при необходимости поправить (например, при восстановлении
// базы из бэкапа - тогда в настройку переносят прежний ИД).
&НаКлиенте
Процедура ИДСсылкаНажатие(Элемент, СтандартнаяОбработка)

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеВводаИДБазы", ЭтотОбъект);
	// Значение идёт вторым параметром, подсказка (заголовок окна) - третьим:
	// ПоказатьВводСтроки(<Оповещение>, <Значение>, <Подсказка>, <Длина>, <Многострочный>).
	ПоказатьВводСтроки(ОповещениеОЗавершении, Объект.ИдентификаторЭкземпляра, "ИД", 36, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаИДБазы(Строка, ДополнительныеПараметры) Экспорт

	// Отмена ввода (Неопределено) - оставляем как было.
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Ссылка «ИД» показывает только подпись, поэтому обновлять на форме нечего.
	Объект.ИдентификаторЭкземпляра = СокрЛП(Строка);

КонецПроцедуры

// Показывает таблицу «Пользователи» (группу разрешённых пользователей), когда
// галка установлена (включён отбор по пользователям), и скрывает её, когда
// галка снята (выгружаются все пользователи).
&НаКлиенте
Процедура ОбновитьВидимостьТаблицыПользователей()

	// Прячем только таблицу: галка и заголовок блока должны оставаться на форме,
	// иначе снятая галка скроет сама себя и вернуть отбор будет нечем.
	Элементы.ГруппаТаблицаПользователи.Видимость = Объект.ВсеПользователи;

КонецПроцедуры

// Адрес и пользователь публикации нужны порталу только в http-режиме: в push-pull
// 1С сама опрашивает портал, поэтому поля публикации скрыты, а вместо них -
// пояснение. Вызывается при открытии формы и при смене режима.
&НаКлиенте
Процедура ОбновитьВидимостьПолейПубликации()

	ЭтоХттпРежим = НРег(СокрЛП(Объект.Режим)) = "http";
	Элементы.ГруппаПубликация.Видимость = ЭтоХттпРежим;
	Элементы.ПояснениеПубликации.Видимость = НЕ ЭтоХттпРежим;
	// Перезапуск задания нужен только в push-режиме: в http портал сам обращается
	// к базе, и опрашивать портал нечего.
	Элементы.КнопкаПерезапуститьЗадание.Видимость = НЕ ЭтоХттпРежим;

КонецПроцедуры

// Переключатель «Режим» и реквизиты публикации: изменение сразу доводится до
// портала (PATCH /settings), иначе портал продолжает работать по-старому и в
// новый режим не переходит. Для http-режима в транспорте обязательны адрес,
// пользователь и пароль публикации - иначе портал не сможет обратиться к базе.
&НаКлиенте
Процедура РежимПриИзменении(Элемент)

	// От режима зависит, нужны ли поля публикации.
	ОбновитьВидимостьПолейПубликации();
	ОбновитьТранспортНаПортале();

КонецПроцедуры

// Адрес и пользователь публикации нужны порталу только в http-режиме: заполнили
// их - доводим транспорт до портала, не дожидаясь переподключения.
&НаКлиенте
Процедура АдресПубликацииПриИзменении(Элемент)

	Если НРег(СокрЛП(Объект.Режим)) = "http" Тогда
		ОбновитьТранспортНаПортале();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПользовательПубликацииПриИзменении(Элемент)

	Если НРег(СокрЛП(Объект.Режим)) = "http" Тогда
		ОбновитьТранспортНаПортале();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТранспортНаПортале()

	// Сначала адрес и пользователь публикации: без них пароль спрашивать рано -
	// транспорт всё равно не отправить. Пароль запросим, когда заполнены оба поля:
	// обработчики изменения этих полей вызывают процедуру заново.
	Если НРег(СокрЛП(Объект.Режим)) = "http"
		И (ПустаяСтрока(СокрЛП(Объект.АдресПубликации))
			ИЛИ ПустаяСтрока(СокрЛП(Объект.ПользовательПубликации))) Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Заполните «Адрес 1С публикации» и «Пользователь 1С» - после этого запросим пароль публикации.");
		Возврат;
	КонецЕсли;

	// Пароль пользователя публикации нужен только в http-режиме и только пока его
	// нет в безопасном хранилище.
	Если НРег(СокрЛП(Объект.Режим)) = "http" И НЕ ХранитсяПарольПубликацииНаСервере() Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения(
			"ПослеВводаПароляПубликацииДляРежима", ЭтотОбъект);
		ПоказатьВводСтроки(
			ОповещениеОЗавершении,
			"",
			"Введите пароль пользователя HTTP-сервиса публикации",
			0,
			Ложь);
		Возврат;
	КонецЕсли;

	СохранитьИОтправитьТранспорт("");

КонецПроцедуры

// Продолжение смены режима после ввода пароля публикации. Отмена ввода -
// возвращаем значения из базы: http без пароля нерабочий.
&НаКлиенте
Процедура ПослеВводаПароляПубликацииДляРежима(Пароль, ДополнительныеПараметры) Экспорт

	Если Пароль = Неопределено Тогда
		ПеречитатьОбъектФормы();
		// Значения вернулись из базы - под них же приводим и видимость полей.
		ОбновитьВидимостьПолейПубликации();
		Возврат;
	КонецЕсли;

	СохранитьВведенныйПарольПубликации(СокрЛП(Пароль));
	СохранитьИОтправитьТранспорт(СокрЛП(Пароль));

КонецПроцедуры

// Только что введённый пароль передаём в запрос напрямую, чтобы PATCH не зависел
// от того, успела ли записаться настройка в безопасное хранилище.
&НаКлиенте
Процедура СохранитьИОтправитьТранспорт(ПарольПубликации = "")

	Если НЕ ЗаписатьНастройку() Тогда
		// Текст ошибки уже выведен; на портал транспорт не отправляем.
		Возврат;
	КонецЕсли;

	ОтправитьТранспортНаСервере(ПарольПубликации);

КонецПроцедуры

&НаСервере
Функция ХранитсяПарольПубликацииНаСервере()

	// Пароль актуален только для той учётной записи публикации, для которой введён:
	// при смене адреса или пользователя его надо запросить заново.
	Возврат Б24_ИИ_ИнтеграцияСервер.ХранитсяПарольПубликации(
		ТекущаяНастройка(), Объект.АдресПубликации, Объект.ПользовательПубликации);

КонецФункции

&НаСервере
Процедура ОтправитьТранспортНаСервере(ПарольПубликации = "")

	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Расписание задания живёт только в pushpull: при переходе в http задание
	// снимаем (иначе оно тикает вхолостую), при возврате в pushpull - создаём.
	Б24_ИИ_ИнтеграцияСервер.ДобавитьУдалитьРасписаниеЗадания();

	Режим = Б24_ИИ_ИнтеграцияСервер.РежимРаботы(Настройка);
	Транспорт = Новый Соответствие;
	Транспорт.Вставить("mode", Режим);

	Если Режим = "http" Тогда

		БазовыйАдрес = СокрЛП(Настройка.АдресПубликации);
		Пользователь = СокрЛП(Настройка.ПользовательПубликации);
		Если ПустаяСтрока(БазовыйАдрес) ИЛИ ПустаяСтрока(Пользователь) Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
				"Для http-режима заполните «Адрес публикации» и «Пользователь публикации»."
				+ " Транспорт на портал не отправлен.");
			Возврат;
		КонецЕсли;

		Пароль = СокрЛП(ПарольПубликации);
		Если ПустаяСтрока(Пароль) Тогда
			Хранимое = Б24_ИИ_ИнтеграцияСервер.ПрочитатьХранимоеПодключение(Настройка);
			ХранимыйПароль = Б24_ИИ_ИнтеграцияСервер.ЗначениеНастройки(Хранимое, "ПарольПубликации");
			Если НЕ ХранимыйПароль = Неопределено Тогда
				Пароль = СокрЛП(Строка(ХранимыйПароль));
			КонецЕсли;
		КонецЕсли;
		Если ПустаяСтрока(Пароль) Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
				"Для http-режима нужен пароль пользователя публикации."
				+ " Транспорт на портал не отправлен.");
			Возврат;
		КонецЕсли;

		Транспорт.Вставить("baseUrl", БазовыйАдрес);
		Транспорт.Вставить("username", Пользователь);
		Транспорт.Вставить("password", Пароль);
	КонецЕсли;

	Готовность = Б24_ИИ_ИнтеграцияСервер.ПроверитьГотовностьКЗапросамКонфигурации(Настройка);
	Если НЕ Готовность.Успех Тогда
		// Подключения ещё нет - отправлять нечего: транспорт уйдёт на портал при
		// подключении (PUT /settings в цикле «Подключить»).
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Режим сохранён. На портал он уйдёт при подключении.");
		Возврат;
	КонецЕсли;

	ДанныеКонфигурации = Новый Соответствие;
	ДанныеКонфигурации.Вставить("transport", Транспорт);
	Результат = Б24_ИИ_ИнтеграцияСервер.ОбновитьКонфигурациюМодуля(Настройка, ДанныеКонфигурации);
	ВывестиРезультатКонфигурации(Результат, "Смена режима");

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы


// Обработчик завершения ввода пароля публикации в потоке «Подключить».
// Пароль нужен http-режиму; после его сохранения продолжаем подключение.
&НаКлиенте
Процедура ПослеВводаПароляПубликацииДляПодключения(ПарольПубликации, ДополнительныеПараметры) Экспорт

	// Пользователь закрыл окно ввода (отмена/Esc) - отменяем подключение.
	Если ПарольПубликации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПарольПубликации = СокрЛП(ПарольПубликации);

	Если ПустаяСтрока(ПарольПубликации) Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Пароль публикации пустой. Введите пароль пользователя HTTP-сервиса публикации");
		Возврат;
	КонецЕсли;

	СохранитьВведенныйПарольПубликации(ПарольПубликации);
	ПодключитьНаСервере(СтрокаПодключенияВОжидании);

КонецПроцедуры

// Перезапуск задания опроса портала (push-воркер): снимает активные экземпляры,
// пересоздаёт расписание и запускает цикл заново. Нужен, когда воркер не забирает
// команды портала (задание зависло или расписание потерялось).
&НаКлиенте
Процедура ПерезапуститьЗадание(Команда)

	ПерезапуститьЗаданиеНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПерезапуститьЗаданиеНаСервере()

	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Настройка не найдена: заполните и запишите настройку интеграции");
		Возврат;
	КонецЕсли;

	Б24_ИИ_ИнтеграцияСервер.ПерезапуститьЗаданиеВоркера(Настройка);
	Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
		"Задание опроса портала перезапущено: активные экземпляры сняты, цикл запущен");

КонецПроцедуры

&НаКлиенте
Процедура Подключить(Команда)

	// Не даём подключаться, пока настройка не записана: новая или изменённая
	// настройка сначала сохраняется, иначе введённые данные потеряются молча.
	// Вопрос показывается асинхронно: ПоказатьВопрос - процедура, ответ приходит
	// в обработчике завершения ПослеЗакрытияВопросаПодключить.
	Если НастройкаНеЗаписана() Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения(
			"ПослеЗакрытияВопросаПодключить", ЭтотОбъект);
		ПоказатьВопрос(
			ОповещениеОЗавершении,
			"Настройка не записана. Сохранить настройку и продолжить подключение?",
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Возврат;
	КонецЕсли;

	ПоказатьОкноВводаСтрокиПодключения();

КонецПроцедуры

// Обработчик завершения вопроса о несохранённой настройке.
&НаКлиенте
Процедура ПослеЗакрытияВопросаПодключить(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗаписатьНастройку() Тогда
		Возврат; // запись не прошла (ошибка показана пользователю)
	КонецЕсли;

	ПоказатьОкноВводаСтрокиПодключения();

КонецПроцедуры

// Показывает окно ввода строки подключения из кабинета VibeCode.
&НаКлиенте
Процедура ПоказатьОкноВводаСтрокиПодключения()

	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ПослеВводаСтрокиПодключения", ЭтотОбъект);

	ПоказатьВводСтроки(
		ОповещениеОЗавершении,
		"",
		"Введите строку подключения из кабинета VibeCode",
		0,
		Ложь);

КонецПроцедуры

// Обработчик завершения ввода строки подключения.
&НаКлиенте
Процедура ПослеВводаСтрокиПодключения(СтрокаПодключения, ДополнительныеПараметры) Экспорт

	// Пользователь закрыл окно ввода (отмена/Esc) - ничего не делаем.
	Если СтрокаПодключения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаПодключения = СокрЛП(СтрокаПодключения);

	Если ПустаяСтрока(СтрокаПодключения) Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Строка подключения пустая. Вставьте строку из кабинета VibeCode (адрес#ключ)");
		Возврат;
	КонецЕсли;

	Если НЕ СтрокаПодключенияКорректна(СтрокаПодключения) Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Некорректная строка подключения. Ожидается формат https://адрес/api/onec-module/v1#ключ");
		Возврат;
	КонецЕсли;

	// Запоминаем строку подключения: между асинхронными окнами (пароль)
	// нужно знать, какое подключение продолжать.
	СтрокаПодключенияВОжидании = СтрокаПодключения;

	// Для http-режима обязателен пароль пользователя HTTP-сервиса публикации.
	Если ТребуетсяВводПароляПубликации() Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения(
			"ПослеВводаПароляПубликацииДляПодключения", ЭтотОбъект);
		ПоказатьВводСтроки(
			ОповещениеОЗавершении,
			"",
			"Введите пароль пользователя HTTP-сервиса публикации",
			0,
			Ложь);
		Возврат;
	КонецЕсли;

	ПодключитьНаСервере(СтрокаПодключения);

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьГуидПользователя(СсылкаПользователя)

	Если НЕ ЗначениеЗаполнено(СсылкаПользователя) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(СсылкаПользователя.УникальныйИдентификатор());

КонецФункции

&НаКлиенте
Функция НастройкаНеЗаписана()

	// Новая запись (ссылка ещё пустая) либо в форме есть несохранённые изменения.
	Возврат Объект.Ссылка.Пустая() Или Модифицированность;

КонецФункции

&НаКлиенте
Функция ЗаписатьНастройку()

	Попытка
		Записать();
		Возврат Истина;
	Исключение
		// ОписаниеОшибки() берём ОДИН раз в начале блока Исключение и
		// переиспользуем: повторные вызовы в том же блоке не гарантированы
		// и могут вернуть пустую строку.
		ТекстОшибки = ОписаниеОшибки();
		Если ЭтоКонфликтХранимыхДанных(ТекстОшибки) Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
				"Настройка была изменена другим пользователем. Перечитайте её и повторите запись.");
			ПеречитатьОбъектФормы();
		Иначе
			Сообщить(ТекстОшибки);
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Проверяет, что текст ошибки соответствует конфликту версий хранимых данных
// («данные изменены/записаны другим пользователем»). Встроенной глобальной
// функции ОшибкаХранимыхДанных в платформе нет, поэтому определяем по тексту.
&НаКлиенте
Функция ЭтоКонфликтХранимыхДанных(ТекстОшибки)

	Возврат СтрНайти(НРег(ТекстОшибки), НРег("изменены или удалены другим пользователем")) > 0;

КонецФункции

// Перечитывает объект настройки формы из базы после того, как запись не прошла
// из-за конфликта версий (реквизиты могли поменяться другим пользователем).
&НаСервере
Процедура ПеречитатьОбъектФормы()

	// Перечитываем объект из базы и возвращаем его в реквизит формы: у объекта
	// справочника метода «Прочитать» нет, обращение к нему падает в базе с
	// «Метод объекта не обнаружен (Прочитать)».
	СсылкаНастройки = Объект.Ссылка;
	Если СсылкаНастройки.Пустая() Тогда
		// Незаписанную настройку перечитывать не из чего.
		Возврат;
	КонецЕсли;

	ЗначениеВРеквизитФормы(СсылкаНастройки.ПолучитьОбъект(), "Объект");

КонецПроцедуры

&НаСервере
Процедура ПодключитьНаСервере(СтрокаПодключения)

	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Для подключения заполните и запишите настройку интеграции");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СтрокаПодключения) Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Вставьте строку подключения из кабинета VibeCode (адрес#ключ)");
		Возврат;
	КонецЕсли;

	Результат = Б24_ИИ_ИнтеграцияСервер.ВыполнитьConnect(Настройка, СтрокаПодключения);

	Если Результат = Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Ошибка при подключении: нет ответа сервера");
		Возврат;
	КонецЕсли;

	Если Результат.Успех Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
			"Подключение выполнено, токен сохранён");
		// Полный цикл подключения: после connect сразу регистрируем конфигурацию
		// модуля на портале (PUT /settings). Без connect сохранение невозможно -
		// для него нужен действующий токен.
		РезультатСохранения = Б24_ИИ_ИнтеграцияСервер.СохранитьКонфигурациюМодуля(Настройка);
		Если РезультатСохранения = Неопределено Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
				"Подключение выполнено, но сохранение конфигурации: нет ответа сервера");
		ИначеЕсли РезультатСохранения.Успех Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(
				"Конфигурация модуля сохранена");
		Иначе
			ТекстОшибкиСохранения = "Подключение выполнено, но сохранение конфигурации: ";
			Если НЕ ПустаяСтрока(РезультатСохранения.Сообщение) Тогда
				ТекстОшибкиСохранения = ТекстОшибкиСохранения + РезультатСохранения.Сообщение;
			ИначеЕсли НЕ ПустаяСтрока(РезультатСохранения.КодОшибки) Тогда
				ТекстОшибкиСохранения = ТекстОшибкиСохранения + РезультатСохранения.КодОшибки;
			Иначе
				ТекстОшибкиСохранения = ТекстОшибкиСохранения + "ошибка сервера";
			КонецЕсли;
			Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(ТекстОшибкиСохранения);
		КонецЕсли;
		// Сервер перезаписал реквизиты/статус настройки (токен, статус, дата) -
		// перечитываем объект формы, чтобы она не держала устаревшую версию записи
		// и повторная запись не упала с ОшибкаХранимыхДанных.
		ПеречитатьОбъектФормы();
		// Статус изменился - обновляем текст состояния на форме.
		ОбновитьСостояниеНаФорме();
	Иначе
		ТекстОшибки = "Ошибка подключения: ";
		Если НЕ ПустаяСтрока(Результат.Сообщение) Тогда
			ТекстОшибки = ТекстОшибки + Результат.Сообщение;
		ИначеЕсли НЕ ПустаяСтрока(Результат.КодОшибки) Тогда
			ТекстОшибки = ТекстОшибки + Результат.КодОшибки;
		Иначе
			ТекстОшибки = ТекстОшибки + "ошибка сервера";
		КонецЕсли;
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

// Проставляет статусу настройки значение по умолчанию "OFFLINE", если он ещё
// пуст (настройка создана, но подключение не выполнялось). В реквизите статус
// хранится кодом, поэтому он не бывает пустым; при записи значение попадает в базу.
&НаСервере
Процедура УстановитьСтатусПоУмолчанию()

	Если ПустаяСтрока(СокрЛП(Объект["Статус"])) Тогда
		Объект["Статус"] = "OFFLINE";
	КонецЕсли;

КонецПроцедуры

// Показывает состояние подключения текстом вместо кода статуса, который лежит
// в реквизите настройки (OFFLINE/ONLINE/DISCONNECTED).
&НаСервере
Процедура ОбновитьСостояниеНаФорме()

	Элементы.СостояниеПодключения.Заголовок = ПредставлениеСостояния(Объект.Статус);

КонецПроцедуры

&НаСервере
Функция ПредставлениеСостояния(Статус)

	КодСтатуса = НРег(СокрЛП(Статус));
	Если КодСтатуса = "online" Тогда
		Возврат "Подключено к порталу";
	ИначеЕсли КодСтатуса = "disconnected" Тогда
		Возврат "Подключение отключено";
	КонецЕсли;

	Возврат "Не подключено";

КонецФункции

// Проверяет корректность строки подключения: адрес (https://...) и ключ
// (vibe_onec_... / vibe_api_...) через штатный разбор серверного модуля.
&НаСервере
Функция СтрокаПодключенияКорректна(СтрокаПодключения)

	РазобранныйКлюч = Б24_ИИ_ИнтеграцияСервер.РазобратьКлючПодключения(СтрокаПодключения);
	Возврат РазобранныйКлюч.Успех;

КонецФункции

&НаСервере
Функция ТекущаяНастройка()

	Если ТипЗнч(Объект) = Тип("CatalogObject.Б24_ИИ_НастройкиVibeCode") Тогда
		Возврат Объект.Ссылка;
	КонецЕсли;

	Если ТипЗнч(Объект) = Тип("CatalogRef.Б24_ИИ_НастройкиVibeCode") Тогда
		Возврат Объект;
	КонецЕсли;

	Возврат Б24_ИИ_ИнтеграцияСервер.ПолучитьАктивнуюНастройкуVibeCode();

КонецФункции

&НаСервере
Процедура ВывестиРезультатКонфигурации(Результат, Действие)

	Если Результат = Неопределено Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(Действие + ": нет ответа сервера");
		Возврат;
	КонецЕсли;

	Если Результат.Успех Тогда
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(Действие + " выполнено успешно");
	Иначе
		ТекстОшибки = Действие + ": ";
		Если НЕ ПустаяСтрока(Результат.Сообщение) Тогда
			ТекстОшибки = ТекстОшибки + Результат.Сообщение;
		ИначеЕсли НЕ ПустаяСтрока(Результат.КодОшибки) Тогда
			ТекстОшибки = ТекстОшибки + Результат.КодОшибки;
		Иначе
			ТекстОшибки = ТекстОшибки + "ошибка сервера";
		КонецЕсли;
		Б24_К_ОбщегоНазначенияВызовСервера.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТребуетсяВводПароляПубликации()

	// Окно ввода пароля показываем только для http-режима, пока пароль не сохранён.
	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НРег(Б24_ИИ_ИнтеграцияСервер.РежимРаботы(Настройка)) <> "http" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ Б24_ИИ_ИнтеграцияСервер.ХранитсяПарольПубликации(
		Настройка, Объект.АдресПубликации, Объект.ПользовательПубликации);

КонецФункции

&НаСервере
Процедура СохранитьВведенныйПарольПубликации(Пароль)

	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Б24_ИИ_ИнтеграцияСервер.СохранитьПарольПубликации(Настройка, СокрЛП(Пароль),
		Объект.АдресПубликации, Объект.ПользовательПубликации);

КонецПроцедуры

#КонецОбласти
