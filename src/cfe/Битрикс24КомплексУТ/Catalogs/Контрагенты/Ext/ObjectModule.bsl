
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("ПередЗаписью")
Процедура Б24_К_ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	Если ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" Тогда
		Б24_К_ОбъектНовый	= ЭтоНовый();
		
		Если Б24_К_ОбъектНовый Тогда
			Б24_К_ОбъектМодифицирован = Истина;
		Иначе
			
			МассивИсключений = Новый Массив;
			МассивИсключений.Добавить("ДатаИзменения");
			
			МассивДляПроверки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьМассивРеквизитовДляПроверкиМодифицированности();
			
			Если Б24_К_ОбщегоНазначенияСервер.ОбъектМодифицирован(ЭтотОбъект, МассивИсключений, МассивДляПроверки) Тогда
				Б24_К_ОбъектМодифицирован = Истина;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
#Область СинхронизацияДанных
		УстановитьПривилегированныйРежим(Истина);	
		ИмяРеквизитаПризнака = ?(ТипКонфигурации = "УНФ", "ВидКонтрагента", "ЮрФизЛицо");
		Если ЭтотОбъект.Ссылка[ИмяРеквизитаПризнака] <> ЭтотОбъект[ИмяРеквизитаПризнака] Тогда
			
			ТипыДанныхДляОбменаСПорталом = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
			
			МассивВыгружаемыхНастроекПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьМассивНастроекПодключения();
			
			Для Каждого ТекЭлемент Из МассивВыгружаемыхНастроекПодключения Цикл
				
				Выборка = РегистрыСведений.Б24_КС_ТаблицаИзменений.Выбрать(Новый Структура("Объект", ЭтотОбъект.Ссылка));
				
				Пока Выборка.Следующий() Цикл
					Если Выборка.ТипДанных = ТипыДанныхДляОбменаСПорталом.Реквизит И Выборка.НастройкаПодключения = ТекЭлемент Тогда
						Выборка.ПолучитьМенеджерЗаписи().Удалить();
					КонецЕсли;
					
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
#КонецОбласти
	КонецЕсли;

КонецПроцедуры

#КонецЕсли

