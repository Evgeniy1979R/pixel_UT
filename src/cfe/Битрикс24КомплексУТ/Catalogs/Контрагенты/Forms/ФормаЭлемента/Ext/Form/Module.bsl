
#Область СобытияФормы

&НаКлиенте
Процедура Б24_К_ПриОткрытииПосле(Отказ)
	
	Если Б24_К_НастройкиСеанса.НастройкиТелефонии.МессенджерУстановлен = Истина Тогда
		Б24_К_ДобавлениеКнопок();
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура Б24_К_ДобавлениеКнопок()
	
	Попытка
		Б24_К_ТелефонияВызовСервера.ДобавлениеКнопокТелефонии(ЭтотОбъект);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_К_Позвонить(ПараметрКоманды)
	
	Если ТипЗнч(ПараметрКоманды) = Тип("КомандаФормы") Тогда
		
		ИмяКомандыКИ 		= ПараметрКоманды.Имя;
		ИмяРеквизита 		= Прав(ИмяКомандыКИ, СтрДлина(ИмяКомандыКИ)- 6);	
		ЗначениеРеквизитаКИ = ЭтотОбъект[ИмяРеквизита];
		
	Иначе
		
		ИмяДекорацииФормыКИ	= ПараметрКоманды.Имя;
		ИмяРеквизита 		= Б24_К_ТелефонияВызовСервера.ПолучитьИмяЭлементаПредставленияКИ(ИмяДекорацииФормыКИ);
		ЭлементКИ 			= Элементы[ИмяРеквизита];
		ЗначениеРеквизитаКИ = ЭлементКИ.ТекстРедактирования;
		
	КонецЕсли;
	
	Б24_К_ТелефонияКлиент.ПозвонитьЧерезБитрикс24(ЗначениеРеквизитаКИ);
	
КонецПроцедуры
