
&НаСервере
Процедура Б24_К_ДобавлениеКнопок()
	
	Попытка
		Б24_К_ТелефонияВызовСервера.ДобавлениеКнопокТелефонии(ЭтотОбъект);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_К_Позвонить(Команда)
	
	ИмяКомандыКИ 		= Команда.Имя;
	ИмяРеквизита 		= Прав(ИмяКомандыКИ, СтрДлина(ИмяКомандыКИ)- 6);	
	ЗначениеРеквизитаКИ = ЭтотОбъект[ИмяРеквизита];
	
	Б24_К_ТелефонияКлиент.ПозвонитьЧерезБитрикс24(ЗначениеРеквизитаКИ);
	
КонецПроцедуры

&НаКлиенте
&После("ГруппаСтраницыПриСменеСтраницы")
Процедура Б24_К_ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = ПараметрыКонтактнойИнформации.ГруппаКонтактнаяИнформация.ГруппаДляРазмещения И НЕ Б24_К_ТелефонияДобавлена Тогда
		
		Если Б24_К_НастройкиСеанса.НастройкиТелефонии.МессенджерУстановлен = Истина Тогда
			Б24_К_ТелефонияДобавлена = Истина;
			Б24_К_ДобавлениеКнопок();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

