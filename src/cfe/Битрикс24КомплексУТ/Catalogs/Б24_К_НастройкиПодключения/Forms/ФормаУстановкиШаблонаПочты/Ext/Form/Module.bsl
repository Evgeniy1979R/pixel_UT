
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Шаблон = Параметры.ШаблонСозданияПочты;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПараметрыШаблона.Добавить("[Результат]");
	
	ПараметрыШаблона.Добавить("[Фамилия]");
	ПараметрыШаблона.Добавить("[Первая буква фамилии]");	
	
	ПараметрыШаблона.Добавить("[Имя]");
	ПараметрыШаблона.Добавить("[Первая буква имени]");	
	
	ПараметрыШаблона.Добавить("[Отчество]");
	ПараметрыШаблона.Добавить("[Первая буква отчества]");	
	
	ПараметрыШаблона.Добавить("[Дата рождения]");
	ПараметрыШаблона.Добавить("[Год рождения]");
	ПараметрыШаблона.Добавить("[Месяц рождения]");
	ПараметрыШаблона.Добавить("[День рождения]");
	
	Если НЕ ЗначениеЗаполнено(Шаблон) Тогда
		Шаблон = "// Пример шаблона
		|//
		|// [Результат] = [Первая буква имени] + " + """.""" + " + [Фамилия] + " + """@bitrix24.ru""";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	
	Если СтрНайти(Шаблон, "@")=0 Тогда
		ПоказатьПредупреждение(,"В шаблоне не указан домен почты. Шаблон не может быть использован для создания почты.");
		Возврат;
	КонецЕсли;
	
	Закрыть(Шаблон);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПараметр(Команда)
	
	ТекущиеДанные = Элементы.ПараметрыШаблона.ТекущиеДанные;

	Если ТекущиеДанные <> Неопределено Тогда
		
		Шаблон = Шаблон + ТекущиеДанные.Значение;
		
		ТекущийЭлемент = Элементы.Шаблон;
		Длина = СтрДлина(Шаблон) + 1;
		ОбновитьОтображениеДанных(Элементы.Шаблон);
		Элементы.Шаблон.УстановитьГраницыВыделения(Длина, Длина);	
		
	КонецЕсли;	
	
КонецПроцедуры
