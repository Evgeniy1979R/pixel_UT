
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "СозданаИзмененаНастройка" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗапуститьМастерНастроек();

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьМастерНастроек()

	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО") Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РольДоступнаНаКлиенте("Б24_К_Администратор")
		И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РольДоступнаНаКлиенте("ПолныеПрава") Тогда
		Возврат;
	КонецЕсли;

	Настройки = ПолучитьСуществующуюНастройкуКЭДО();
	ОбщиеНастройки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки");
	Если НЕ ОбщиеНастройки = Неопределено
		и (НЕ ОбщиеНастройки.Свойство("БольшеНеПредлагатьПомощникНастройкиКЭДО") или ОбщиеНастройки.БольшеНеПредлагатьПомощникНастройкиКЭДО = Ложь)
		и НЕ Настройки = Неопределено Тогда

		ПараметрыОткрытия = Новый Структура();
		ПараметрыОткрытия.Вставить("ОбщиеНастройки", ОбщиеНастройки);
		ПараметрыОткрытия.Вставить("Настройки", Настройки);

		ОткрытьФорму("Обработка." + "Б24_УП_ПомощникНастройкиКЭДО.Форма.ФормаМастераЗаполненияНастроек",ПараметрыОткрытия,ЭтаФорма);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСуществующуюНастройкуКЭДО()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Б24_К_НастройкиПодключения.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	               |ГДЕ
	               |	Б24_К_НастройкиПодключения.КЭДО = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Б24_К_НастройкиПодключения.Ссылка КАК НастройкаПодключения
	               |ИЗ
	               |	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения";
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	Если НЕ ПакетЗапросов[0].Пустой() Тогда
		Возврат Неопределено
	Иначе
		Возврат ПакетЗапросов[1].Выгрузить().ВыгрузитьКолонку("НастройкаПодключения");
	КонецЕсли;

КонецФункции
