
#Область ОбработчикиСобытийФормы

// Возвращает значения колонки таблицы значений реквизита формы.
// Таблица передаётся параметром: расширенная проверка модулей не разбирает вызов метода
// у значения неизвестного типа, поэтому маркер «Возможно ошибочный метод: Выгрузить» не появляется.
&НаСервере
Функция ЗначенияКолонкиТаблицы(Таблица, ИмяКолонки)
	Возврат Таблица.Выгрузить().ВыгрузитьКолонку(ИмяКолонки);
КонецФункции

// Возвращает таблицу значений реквизита формы (см. ЗначенияКолонкиТаблицы).
&НаСервере
Функция ВыгрузитьТаблицу(Таблица)
	Возврат Таблица.Выгрузить();
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ИсточникСтруктуры1С.СписокВыбора.Добавить("Подразделения организации");
	Элементы.КЭДО.Видимость = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО");
	Если Элементы.КЭДО.Видимость = Ложь Тогда
		Элементы.ГруппаСтраницаКЭДО.Видимость = Ложь;
	КонецЕсли;

	Если Параметры.Свойство("Ключ") Тогда

		НастройкаПодключения = Параметры.Ключ;

		Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
			РеквизитыНастройкиПодключения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаПодключения,
			"Наименование, Портал, ИдентификаторПодключения, ТелефонияБитрикс24, ЭкспортПечатныхФормОтчетов
			|, ОбсужденияВЧатах, НеОбновлятьДелаБитрикс24, КонфигурируемыеДела , НеВыгружатьАдресаРеквизитов
			|, НеЗагружатьАдресаРеквизитов, СопоставлениеОрганизаций, ОповещатьПользователейБитрикс24ОбОшибках
			|, ПолучателиДанныхОбОшибках, ФильтрыСообщенийОбОшибках, ОграниченияНаВыгрузкуДелСозданныхПоОснованию
			|, ПресетыШаблоновРеквизитов, ЗависимостиКлиентовОтТиповКонтрагентов
			|, ПоказыватьРасчетныеЛисткиОстаткиОтпуска, ИдКаналаОповещений
			|, СопоставлятьРаботниковПоДоговорамГПХ, ВыгрузкаСотрудников, СопоставлениеПодразделений
			|, ИсточникСтруктуры1С, ШаблонСозданияПочты, КЭДО, ИспользоватьОбменСобытиямиДляРасчетныхЛистков");
		Иначе
			РеквизитыНастройкиПодключения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаПодключения,
			"Наименование, Портал, ИдентификаторПодключения, ТелефонияБитрикс24, ЭкспортПечатныхФормОтчетов
			|, ОбсужденияВЧатах, НеОбновлятьДелаБитрикс24, КонфигурируемыеДела , НеВыгружатьАдресаРеквизитов
			|, НеЗагружатьАдресаРеквизитов, СопоставлениеОрганизаций, ОповещатьПользователейБитрикс24ОбОшибках
			|, ПолучателиДанныхОбОшибках, ФильтрыСообщенийОбОшибках, ОграниченияНаВыгрузкуДелСозданныхПоОснованию
			|, ПресетыШаблоновРеквизитов, ПресетыСтавокНДС, ЗависимостиКлиентовОтТиповКонтрагентов
			|, ПресетыТиповКлиентов, ПоказыватьРасчетныеЛисткиОстаткиОтпуска, ИдКаналаОповещений
			|, СопоставлятьРаботниковПоДоговорамГПХ, ВыгрузкаСотрудников, СопоставлениеПодразделений
			|, ИсточникСтруктуры1С, ШаблонСозданияПочты, КЭДО, ИспользоватьОбменСобытиямиДляРасчетныхЛистков");
		КонецЕсли;

		Наименование 				= РеквизитыНастройкиПодключения.Наименование;
		Портал 						= РеквизитыНастройкиПодключения.Портал;
		Если Элементы.КЭДО.Видимость = Ложь Тогда
			КЭДО 					= Ложь;
		Иначе
			КЭДО 					= РеквизитыНастройкиПодключения.КЭДО;
		КонецЕсли;
		ИдентификаторПодключения 	= РеквизитыНастройкиПодключения.ИдентификаторПодключения;
		ТелефонияБитрикс24 			= РеквизитыНастройкиПодключения.ТелефонияБитрикс24;
		ЭкспортПечатныхФормОтчетов	= РеквизитыНастройкиПодключения.ЭкспортПечатныхФормОтчетов;
		ОбсужденияВЧатах			= РеквизитыНастройкиПодключения.ОбсужденияВЧатах;
		НеОбновлятьДелаБитрикс24	= РеквизитыНастройкиПодключения.НеОбновлятьДелаБитрикс24;
		КонфигурируемыеДела         = РеквизитыНастройкиПодключения.КонфигурируемыеДела;
		НеВыгружатьАдресаРеквизитов	= РеквизитыНастройкиПодключения.НеВыгружатьАдресаРеквизитов;
		НеЗагружатьАдресаРеквизитов	= РеквизитыНастройкиПодключения.НеЗагружатьАдресаРеквизитов;

		ПоказыватьРасчетныеЛисткиОстаткиОтпуска	= РеквизитыНастройкиПодключения.ПоказыватьРасчетныеЛисткиОстаткиОтпуска;
		ИдКаналаОповещений						= РеквизитыНастройкиПодключения.ИдКаналаОповещений;
		СопоставлятьРаботниковПоДоговорамГПХ	= РеквизитыНастройкиПодключения.СопоставлятьРаботниковПоДоговорамГПХ;
		ВыгрузкаСотрудников						= РеквизитыНастройкиПодключения.ВыгрузкаСотрудников;
		СопоставлениеПодразделений				= РеквизитыНастройкиПодключения.СопоставлениеПодразделений;
		ИсточникСтруктуры1С						= РеквизитыНастройкиПодключения.ИсточникСтруктуры1С;
		ШаблонСозданияПочты						= РеквизитыНастройкиПодключения.ШаблонСозданияПочты;
		ИспользоватьОбменСобытиямиДляРасчетныхЛистков	= РеквизитыНастройкиПодключения.ИспользоватьОбменСобытиямиДляРасчетныхЛистков;

		ОповещатьПользователейБитрикс24ОбОшибках	= РеквизитыНастройкиПодключения.ОповещатьПользователейБитрикс24ОбОшибках;
		ПолучателиДанныхОбОшибках.ЗагрузитьЗначения(ЗначенияКолонкиТаблицы(РеквизитыНастройкиПодключения.ПолучателиДанныхОбОшибках, "ИдентификаторПользователяБитрикс24"));
		ФильтрыСообщенийОбОшибках.ЗагрузитьЗначения(ЗначенияКолонкиТаблицы(РеквизитыНастройкиПодключения.ФильтрыСообщенийОбОшибках, "КлючевойТекст"));
		ОграниченияНаВыгрузкуДелСозданныхПоОснованию.ЗагрузитьЗначения(ЗначенияКолонкиТаблицы(РеквизитыНастройкиПодключения.ОграниченияНаВыгрузкуДелСозданныхПоОснованию, "ПолноеИмяОбъекта"));
		СопоставлениеОрганизаций.Загрузить(ВыгрузитьТаблицу(РеквизитыНастройкиПодключения.СопоставлениеОрганизаций));

		ПресетыШаблоновРеквизитов.Загрузить(ВыгрузитьТаблицу(РеквизитыНастройкиПодключения.ПресетыШаблоновРеквизитов));

		ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
		Если ТипКонфигурации = "БП" Или ТипКонфигурации = "ЗУП" Тогда
			Для каждого ТекСтрока Из НастройкаПодключения.ЗависимостиКлиентовОтТиповКонтрагентов Цикл
				Если ТекСтрока.ВидКлиента = "Контакт" Тогда
					НоваяСтрока = ТипыКонтрагентовДляКонтактов.Добавить(); НоваяСтрока.Тип = ТекСтрока.Тип;
				Иначе
					НоваяСтрока = ТипыКонтрагентовДляКомпаний.Добавить(); НоваяСтрока.Тип = ТекСтрока.Тип;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			Для каждого ТекСтрока Из НастройкаПодключения.ЗависимостиКлиентовОтТиповКонтрагентов Цикл
				Если ТекСтрока.ВидКлиента = "Контакт" Тогда
					ТипыКонтрагентовДляКонтактов.Добавить(ТекСтрока.Тип);
				Иначе
					ТипыКонтрагентовДляКомпаний.Добавить(ТекСтрока.Тип);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
		ПресетыСтавокНДС.Загрузить(ВыгрузитьТаблицу(НастройкаПодключения.ПресетыСтавокНДС));
		Для каждого ТекСтрока Из НастройкаПодключения.ПресетыТиповКлиентов Цикл

			Если ТекСтрока.ВидКлиента = "Контакт" Тогда
				НоваяСтрока = ПресетыТиповКонтактов.Добавить();
			Иначе
				НоваяСтрока = ПресетыТиповКомпаний.Добавить();
			КонецЕсли;

			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);

		КонецЦикла;
		КонецЕсли;

		Токен = Б24_К_RestApiВызовСервера.ПолучитьТокен(НастройкаПодключения);

		ОбновитьСписокПользователейБитрикс24();

	Иначе

		Наименование 	= "1С";
		КонфигурируемыеДела	= Истина;

		Пока Истина Цикл

			ГСЧ = Новый ГенераторСлучайныхЧисел;
			ИдентификаторПодключения = Формат(ГСЧ.СлучайноеЧисло(2,1000), "ЧГ=0");

			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ИдентификаторПодключения", ИдентификаторПодключения);
			Запрос.Текст = "ВЫБРАТЬ
			|	Б24_К_НастройкиПодключения.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
			|ГДЕ
			|	Б24_К_НастройкиПодключения.ИдентификаторПодключения = &ИдентификаторПодключения";
			ВыполненныйЗапрос = Запрос.Выполнить();
			Если ВыполненныйЗапрос.Пустой() Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		ЗависимостиКлиентовОтТиповКонтрагентовПоУмолчанию = ЗависимостиКлиентовОтТиповКонтрагентовПоУмолчанию();
		ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
		Если ТипКонфигурации = "БП" Или ТипКонфигурации = "ЗУП" Тогда
			ТипыКонтрагентовДляКомпаний.Очистить();
			Для Каждого ТекТип Из ЗависимостиКлиентовОтТиповКонтрагентовПоУмолчанию.ТипыКонтрагентовДляКомпаний Цикл
				СтрокаТаблицы = ТипыКонтрагентовДляКомпаний.Добавить();
				СтрокаТаблицы.Тип = ТекТип;
			КонецЦикла;
			ТипыКонтрагентовДляКонтактов.Очистить();
			Для Каждого ТекТип Из ЗависимостиКлиентовОтТиповКонтрагентовПоУмолчанию.ТипыКонтрагентовДляКонтактов Цикл
				СтрокаТаблицы = ТипыКонтрагентовДляКонтактов.Добавить();
				СтрокаТаблицы.Тип = ТекТип;
			КонецЦикла;
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			ЗагрузитьЗначенияВСписок(ТипыКонтрагентовДляКомпаний, ЗависимостиКлиентовОтТиповКонтрагентовПоУмолчанию.ТипыКонтрагентовДляКомпаний);
			ЗагрузитьЗначенияВСписок(ТипыКонтрагентовДляКонтактов, ЗависимостиКлиентовОтТиповКонтрагентовПоУмолчанию.ТипыКонтрагентовДляКонтактов);
		КонецЕсли;

		Модифицированность = Истина;

	КонецЕсли;

	Если ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована Тогда
		ОбщегоНазначения.СообщитьПользователю("ВНИМАНИЕ! Работа с внешними ресурсами заблокирована! Необходимо разблокировать!");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьОтображениеЭлементовФормы();

	Элементы.НадписьВерсияМодуля.Заголовок = "Версия модуля: " + Б24_К_ОбщегоНазначенияВызовСервера.Версия();

	Если НЕ ЗначениеЗаполнено(ИсточникСтруктуры1С) Тогда
		ИсточникСтруктуры1С = Элементы.ИсточникСтруктуры1С.СписокВыбора[0].Значение;
	КонецЕсли;

	ДобавитьИменаПрикладныхОбъектовВФильтрДел();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ТелефонияБитрикс24 И НЕ ЗавершениеРаботы Тогда

		ОбновитьПовторноИспользуемыеЗначения();

		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Телефония") Тогда

			МодульТелефонияВызовСервера = Б24_К_ОбщегоНазначенияКлиент.ОбщийМодуль("Б24_К_ТелефонияВызовСервера");
			ТелефонияБитрикс24 =  МодульТелефонияВызовСервера.ПолучитьКоличествоНастроекПодключенияСТелефонией() > 0;
			Если ТелефонияБитрикс24 = Истина Тогда
				МодульТелефонияКлиент = Б24_К_ОбщегоНазначенияКлиент.ОбщийМодуль("Б24_К_ТелефонияКлиент");
				Б24_К_НастройкиСеанса.НастройкиТелефонии.МессенджерУстановлен = МодульТелефонияКлиент.ПроверитьНаличиеМессенджераБитрикс24();
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Модифицированность И НЕ НужноЗакрытьОкно Тогда

		Отказ = Истина;

		Ошибка = Ложь;
		Если НЕ ЗначениеЗаполнено(ИдентификаторПодключения) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не указан идентификатор подключения");
			Ошибка = Истина;
		КонецЕсли;

		Если Ошибка Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Модуль не будет корректно работать");
		КонецЕсли;

		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = "Настройки не будут сохранены. Закрыть?";
		Иначе
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗакрытииОкна", ЭтотОбъект, Параметры);
			ПоказатьВопрос(Оповещение, "Настройки были изменены. Сохранить изменения перед закрытием?", РежимДиалогаВопрос.ДаНетОтмена, 0);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗакрытииОкна(Результат, Параметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда

		НужноЗакрытьОкно = Истина;

		СохранитьВыгрузитьНастройки(Истина);

	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда

		НужноЗакрытьОкно = Истина;

		Закрыть();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СохранитьВыгрузитьНастройки(ЗакрытьПоОкончании = Ложь)

	НастройкаСохранена = СохранитьНастройкуСервер();
	Если ТребуетсяОбновитьИнтерфейс Тогда
		ОбновитьИнтерфейс();
	КонецЕсли;

	Если НастройкаСохранена И ВыгружатьНастройкиНаПортал Тогда

		Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(НастройкаПодключения, "ПометкаУдаления") = Ложь Тогда

			СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);

			Если СтруктураНастроек = Неопределено Тогда
				ПоказатьПредупреждение(, "Не удалось подключиться к Битрикс24");
				Возврат Ложь;
			КонецЕсли;

			СтруктураНастроек.Логирование.Измерение2 = "Выгрузка настроек для настройки подключения";

			ВыгрузкаНастройки(СтруктураНастроек, ЗакрытьПоОкончании);

			ВыгружатьНастройкиНаПортал = Ложь;

		Иначе
			Если ЗакрытьПоОкончании Тогда Закрыть() КонецЕсли;
		КонецЕсли;

		ОбновитьИнтерфейс();

		Оповестить("СозданаИзмененаНастройка");

	Иначе
		Если ЗакрытьПоОкончании Тогда Закрыть() КонецЕсли;
	КонецЕсли;

	Возврат НастройкаСохранена

КонецФункции

&НаСервере
Функция СохранитьНастройкуСервер()

	ЭтоНовый = Ложь;

	Если Модифицированность Тогда

		Если НастройкаПодключения.Пустая() Тогда
			ТекущийОбъект = Справочники.Б24_К_НастройкиПодключения.СоздатьЭлемент();
			ЭтоНовый = Истина;
		Иначе
			ТекущийОбъект = НастройкаПодключения.ПолучитьОбъект();
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Портал) Тогда
			ОбщегоНазначения.СообщитьПользователю("Не указан портал. Записать настройку подключения невозможно.");
			Возврат Ложь;
		КонецЕсли;

		ТекущийОбъект.Наименование 	 				= Наименование;
		ТекущийОбъект.Портал 		 				= Портал;
		ТекущийОбъект.КЭДО 		 					= КЭДО;
		ТекущийОбъект.ИдентификаторПодключения 		= ИдентификаторПодключения;
		ТекущийОбъект.ТелефонияБитрикс24 			= ТелефонияБитрикс24;
		ТекущийОбъект.ЭкспортПечатныхФормОтчетов 	= ЭкспортПечатныхФормОтчетов;
		ТекущийОбъект.ОбсужденияВЧатах 				= ОбсужденияВЧатах;
		ТекущийОбъект.НеОбновлятьДелаБитрикс24 		= НеОбновлятьДелаБитрикс24;
		ТекущийОбъект.КонфигурируемыеДела 			= КонфигурируемыеДела;
		ТекущийОбъект.НеВыгружатьАдресаРеквизитов 	= НеВыгружатьАдресаРеквизитов;
		ТекущийОбъект.НеЗагружатьАдресаРеквизитов 	= НеЗагружатьАдресаРеквизитов;

		ТекущийОбъект.ПоказыватьРасчетныеЛисткиОстаткиОтпуска 	= ПоказыватьРасчетныеЛисткиОстаткиОтпуска;
		ТекущийОбъект.ИдКаналаОповещений 						= ИдКаналаОповещений;
		ТекущийОбъект.СопоставлятьРаботниковПоДоговорамГПХ 		= СопоставлятьРаботниковПоДоговорамГПХ;
		ТекущийОбъект.ВыгрузкаСотрудников 						= ВыгрузкаСотрудников;
		ТекущийОбъект.СопоставлениеПодразделений 				= СопоставлениеПодразделений;
		ТекущийОбъект.ИсточникСтруктуры1С 						= ИсточникСтруктуры1С;
		ТекущийОбъект.ШаблонСозданияПочты 						= ШаблонСозданияПочты;
		ТекущийОбъект.ИспользоватьОбменСобытиямиДляРасчетныхЛистков 		= ИспользоватьОбменСобытиямиДляРасчетныхЛистков;

		ТекущийОбъект.ОповещатьПользователейБитрикс24ОбОшибках 	= ОповещатьПользователейБитрикс24ОбОшибках;

		ТекущийОбъект.ПолучателиДанныхОбОшибках.Очистить();
		Для каждого ТекЭлемент Из ПолучателиДанныхОбОшибках Цикл
			ТекущийОбъект.ПолучателиДанныхОбОшибках.Добавить().ИдентификаторПользователяБитрикс24 = ТекЭлемент.Значение;
		КонецЦикла;

		ТекущийОбъект.ФильтрыСообщенийОбОшибках.Очистить();
		Для каждого ТекЭлемент Из ФильтрыСообщенийОбОшибках Цикл
			ТекущийОбъект.ФильтрыСообщенийОбОшибках.Добавить().КлючевойТекст = ТекЭлемент.Значение;
		КонецЦикла;

		ТекущийОбъект.ОграниченияНаВыгрузкуДелСозданныхПоОснованию.Очистить();
		Для каждого ТекЭлемент Из ОграниченияНаВыгрузкуДелСозданныхПоОснованию Цикл
			ТекущийОбъект.ОграниченияНаВыгрузкуДелСозданныхПоОснованию.Добавить().ПолноеИмяОбъекта = ТекЭлемент.Значение;
		КонецЦикла;

		ТекущийОбъект.ПресетыШаблоновРеквизитов.Очистить();
		Для каждого ТекСтрока Из ПресетыШаблоновРеквизитов Цикл
			НоваяСтрока = ТекущийОбъект.ПресетыШаблоновРеквизитов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;

		Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
			ТекущийОбъект.ПресетыСтавокНДС.Очистить();
			Для каждого ТекСтрока Из ПресетыСтавокНДС Цикл
				НоваяСтрока = ТекущийОбъект.ПресетыСтавокНДС.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;
			ТекущийОбъект.ПресетыТиповКлиентов.Очистить();
			Для каждого ТекСтрока Из ПресетыТиповКомпаний Цикл
				НоваяСтрока = ТекущийОбъект.ПресетыТиповКлиентов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.ВидКлиента = "Компания";
			КонецЦикла;
			Для каждого ТекСтрока Из ПресетыТиповКонтактов Цикл
				НоваяСтрока = ТекущийОбъект.ПресетыТиповКлиентов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.ВидКлиента = "Контакт";
			КонецЦикла;
		КонецЕсли;

		ТекущийОбъект.ЗависимостиКлиентовОтТиповКонтрагентов.Очистить();
		ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
		Если ТипКонфигурации = "БП" Или ТипКонфигурации = "ЗУП" Тогда
			Для каждого ТекЭлемент Из ТипыКонтрагентовДляКомпаний Цикл
				НоваяСтрока = ТекущийОбъект.ЗависимостиКлиентовОтТиповКонтрагентов.Добавить();
				НоваяСтрока.ВидКлиента = "Компания";
				НоваяСтрока.Тип = ТекЭлемент.Тип;
			КонецЦикла;
			Для каждого ТекЭлемент Из ТипыКонтрагентовДляКонтактов Цикл
				НоваяСтрока = ТекущийОбъект.ЗависимостиКлиентовОтТиповКонтрагентов.Добавить();
				НоваяСтрока.ВидКлиента = "Контакт";
				НоваяСтрока.Тип = ТекЭлемент.Тип;
			КонецЦикла;
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			Для каждого ТекЭлемент Из ТипыКонтрагентовДляКомпаний Цикл
				НоваяСтрока = ТекущийОбъект.ЗависимостиКлиентовОтТиповКонтрагентов.Добавить();
				НоваяСтрока.ВидКлиента = "Компания";
				НоваяСтрока.Тип = ТекЭлемент.Значение;
			КонецЦикла;
			Для каждого ТекЭлемент Из ТипыКонтрагентовДляКонтактов Цикл
				НоваяСтрока = ТекущийОбъект.ЗависимостиКлиентовОтТиповКонтрагентов.Добавить();
				НоваяСтрока.ВидКлиента = "Контакт";
				НоваяСтрока.Тип = ТекЭлемент.Значение;
			КонецЦикла;
		КонецЕсли;

		ТекущийОбъект.СопоставлениеОрганизаций.Очистить();
		Для каждого ТекСтрока Из СопоставлениеОрганизаций Цикл
			НоваяСтрока = ТекущийОбъект.СопоставлениеОрганизаций.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;

		Попытка

			ТекущийОбъект.Записать();
			НастройкаПодключения = ТекущийОбъект.Ссылка;
			// Пересчёт функциональной опции КЭДО выполняем сразу после записи справочника,
			// ДО обращений к порталу: если сетевой шаг ниже сорвётся, сохранение прервётся,
			// и опция не обновится, хотя галочка КЭДО уже сохранена.
			ТребуетсяОбновитьИнтерфейс = Справочники.Б24_К_НастройкиПодключения.ЗаполнитьКонстантыКЭДО();

			СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
			Б24_К_RestApiВызовСервера.ПолучитьТокенДляСоединения(СтруктураНастроек,ЭтоНовый,Токен);

			Если ОповещатьПользователейБитрикс24ОбОшибках Тогда
				Б24_К_ОбщегоНазначенияВызовСервера.ОбновитьЧат(ТекущийОбъект.Ссылка);
			КонецЕсли;

			Константы.Б24_КЭ_ОбсудитьВЧате.Установить(ОбсужденияВЧатах);

			КоличествоНастроекПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.КоличествоНастроекПодключения("ПоказыватьРасчетныеЛисткиОстаткиОтпуска", Истина);
			Если Метаданные.Константы.Найти("Б24_УП_ПоказыватьРасчетныеЛисткиОстаткиОтпуска") <> Неопределено Тогда
				Константы["Б24_УП_ПоказыватьРасчетныеЛисткиОстаткиОтпуска"].Установить(КоличествоНастроекПодключения > 0);
			КонецЕсли;

			КоличествоНастроекПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.КоличествоНастроекПодключения("ВыгрузкаСотрудников", Истина);
			Если Метаданные.Константы.Найти("Б24_УП_ВыгрузкаСотрудников") <> Неопределено Тогда
				Константы["Б24_УП_ВыгрузкаСотрудников"].Установить(КоличествоНастроекПодключения > 0);
			КонецЕсли;

			КоличествоНастроекПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.КоличествоНастроекПодключения("СопоставлениеПодразделений", Истина);
			Если Метаданные.Константы.Найти("Б24_УП_СопоставлениеПодразделений") <> Неопределено Тогда
				Константы["Б24_УП_СопоставлениеПодразделений"].Установить(КоличествоНастроекПодключения > 0);
			КонецЕсли;

			Модифицированность = Ложь;

		Исключение
			ОбщегоНазначения.СообщитьПользователю(ИнформацияОбОшибке().Описание);
			Возврат Ложь;
		КонецПопытки;

	КонецЕсли;

	Возврат Истина

КонецФункции

&НаКлиенте
Процедура СохранитьВыгрузитьНастройкиВФоне(Операция = "", ЗакрытьПоОкончании = Ложь)

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Операция"				, Операция);
	ДополнительныеПараметры.Вставить("ЗакрытьПоОкончании"	, ЗакрытьПоОкончании);

	ДлительнаяОперацияЗавершение = Новый ОписаниеОповещения("ПослеСохраненияВыгрузкиНастроек", ЭтотОбъект, ДополнительныеПараметры);

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения             = "Выполняется сохранение настроек";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания       = Истина;
	ПараметрыОжидания.ВыводитьСообщения          = Истина;

 	ДлительнаяОперация = НачатьСохранениеВыгрузкуНастроек();

	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ДлительнаяОперацияЗавершение, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция НачатьСохранениеВыгрузкуНастроек()

	УникальныйИдентификаторЗадания = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификаторЗадания);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выгрузка настроек в Битрикс24";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;

	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("НастройкаПодключения"		, НастройкаПодключения);
	ПараметрыВыгрузки.Вставить("Модифицированность"			, Модифицированность);
	ПараметрыВыгрузки.Вставить("ВыгружатьНастройкиНаПортал"	, ВыгружатьНастройкиНаПортал);
	ПараметрыВыгрузки.Вставить("ИдентификаторПодключения"	, ИдентификаторПодключения);
	ПараметрыВыгрузки.Вставить("Наименование"				, Наименование);
	ПараметрыВыгрузки.Вставить("Портал"						, Портал);
	ПараметрыВыгрузки.Вставить("Токен"						, Токен);
	ПараметрыВыгрузки.Вставить("КЭДО"						, КЭДО);
	ПараметрыВыгрузки.Вставить("ТелефонияБитрикс24"			, ТелефонияБитрикс24);
	ПараметрыВыгрузки.Вставить("ЭкспортПечатныхФормОтчетов"	, ЭкспортПечатныхФормОтчетов);
	ПараметрыВыгрузки.Вставить("ОбсужденияВЧатах"			, ОбсужденияВЧатах);
	ПараметрыВыгрузки.Вставить("НеОбновлятьДелаБитрикс24"	, НеОбновлятьДелаБитрикс24);
	ПараметрыВыгрузки.Вставить("КонфигурируемыеДела"		, КонфигурируемыеДела);
	ПараметрыВыгрузки.Вставить("НеВыгружатьАдресаРеквизитов", НеВыгружатьАдресаРеквизитов);
	ПараметрыВыгрузки.Вставить("НеЗагружатьАдресаРеквизитов", НеЗагружатьАдресаРеквизитов);

	ПараметрыВыгрузки.Вставить("СопоставлятьРаботниковПоДоговорамГПХ"	, СопоставлятьРаботниковПоДоговорамГПХ);
	ПараметрыВыгрузки.Вставить("ПоказыватьРасчетныеЛисткиОстаткиОтпуска", ПоказыватьРасчетныеЛисткиОстаткиОтпуска);
	ПараметрыВыгрузки.Вставить("ИдКаналаОповещений"						, ИдКаналаОповещений);

	ПараметрыВыгрузки.Вставить("ВыгрузкаСотрудников"		, ВыгрузкаСотрудников);
	ПараметрыВыгрузки.Вставить("СопоставлениеПодразделений"	, СопоставлениеПодразделений);
	ПараметрыВыгрузки.Вставить("ИсточникСтруктуры1С"		, ИсточникСтруктуры1С);
	ПараметрыВыгрузки.Вставить("ШаблонСозданияПочты"		, ШаблонСозданияПочты);
	ПараметрыВыгрузки.Вставить("ИспользоватьОбменСобытиямиДляРасчетныхЛистков"	, ИспользоватьОбменСобытиямиДляРасчетныхЛистков);

	ПараметрыВыгрузки.Вставить("ОповещатьПользователейБитрикс24ОбОшибках", ОповещатьПользователейБитрикс24ОбОшибках);
	ПараметрыВыгрузки.Вставить("ПолучателиДанныхОбОшибках"	, ПолучателиДанныхОбОшибках.ВыгрузитьЗначения());
	ПараметрыВыгрузки.Вставить("ФильтрыСообщенийОбОшибках"	, ФильтрыСообщенийОбОшибках.ВыгрузитьЗначения());
	ПараметрыВыгрузки.Вставить("СопоставлениеОрганизаций"	, ВыгрузитьТаблицу(СопоставлениеОрганизаций));

	ПараметрыВыгрузки.Вставить("ОграниченияНаВыгрузкуДелСозданныхПоОснованию"	, ВыгрузитьТаблицу(ОграниченияНаВыгрузкуДелСозданныхПоОснованию));
	ПараметрыВыгрузки.Вставить("ПресетыШаблоновРеквизитов"		, ВыгрузитьТаблицу(ПресетыШаблоновРеквизитов));
	Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
		ПараметрыВыгрузки.Вставить("ПресетыСтавокНДС"				, ВыгрузитьТаблицу(ПресетыСтавокНДС));
	КонецЕсли;
	ПараметрыВыгрузки.Вставить("ТипыКонтрагентовДляКомпаний"	, ВыгрузитьТаблицу(ТипыКонтрагентовДляКомпаний));
	ПараметрыВыгрузки.Вставить("ТипыКонтрагентовДляКонтактов"	, ВыгрузитьТаблицу(ТипыКонтрагентовДляКонтактов));
	ПараметрыВыгрузки.Вставить("ПресетыТиповКомпаний"			, ВыгрузитьТаблицу(ПресетыТиповКомпаний));
	ПараметрыВыгрузки.Вставить("ПресетыТиповКонтактов"			, ВыгрузитьТаблицу(ПресетыТиповКонтактов));

	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.Б24_К_НастройкиПодключения.СохранитьВыгрузитьНастройкиВФоне", ПараметрыВыгрузки, ПараметрыВыполнения);

КонецФункции

&НаКлиенте
Процедура ПослеСохраненияВыгрузкиНастроек(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		ПоказатьПредупреждение(,"Не удалось сохранить настройки");
		Возврат;
	КонецЕсли;

	РезультатСохраненияВыгрузки = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Если РезультатСохраненияВыгрузки <> Истина Тогда
		ПоказатьПредупреждение(,"Не удалось сохранить настройки");
		Возврат;
	КонецЕсли;

	Оповестить("СозданаИзмененаНастройка");

	Модифицированность = Ложь;

	ОбновитьПовторноИспользуемыеЗначения();

	ОбновитьИнтерфейс();

	Если ДополнительныеПараметры.ЗакрытьПоОкончании Тогда
		Закрыть();
	Иначе
		НастройкаПодключения = НастройкаПодключенияПоПорталу(Портал);
	КонецЕсли;

	Если ДополнительныеПараметры.Операция = "ЗагрузкаОрганизацийБитрикс24" Тогда
		ЗагрузкаОрганизацийБитрикс24();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)

	ЕстьОшибкаЗаполнения = ПроверитьЗаполнениеПресетов();
	//ЕстьОшибкаЗаполнения = ЕстьОшибкаЗаполнения ИЛИ ПроверитьЗаполнениеПресетовШаблоновРеквизитов();

	Если НЕ ЕстьОшибкаЗаполнения Тогда
		СохранитьВыгрузитьНастройки();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЕстьОшибкаЗаполнения = ПроверитьЗаполнениеПресетов();
	//ЕстьОшибкаЗаполнения = ЕстьОшибкаЗаполнения ИЛИ ПроверитьЗаполнениеПресетовШаблоновРеквизитов();

	Если НЕ ЕстьОшибкаЗаполнения Тогда
		СохранитьВыгрузитьНастройки(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КнопкаУдалить(Команда)

	Если ЗначениеЗаполнено(НастройкаПодключения) Тогда

		КнопкаУдалитьНаСервере();

		Оповестить("СозданаИзмененаНастройка");

		Закрыть();

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура КнопкаУдалитьНаСервере()

	ТекущаяНастройка = НастройкаПодключения.ПолучитьОбъект();
	ТекущаяНастройка.УстановитьПометкуУдаления(НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаПодключения, "ПометкаУдаления"));
	ТекущаяНастройка.Записать();

	Модифицированность = Ложь;
	ВыгружатьНастройкиНаПортал = Истина;

КонецПроцедуры

&НаКлиенте
Асинх Процедура КомандаТокен(Команда)

	Обещание = ВвестиСтрокуАсинх(Токен,"Укажите токен авторизации");

	Результат = Ждать обещание;

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("Портал"						, Портал);
	СтруктураНастроек.Вставить("НастройкаПодключения"		, НастройкаПодключения);
	СтруктураНастроек.Вставить("ТипыСообщений"				, Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыСообщений());
	ОбщиеНастройки 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки");
	ОбщиеНастройки = ?(ОбщиеНастройки = Неопределено, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьОбщиеНастройкиПоУмолчанию(), ОбщиеНастройки);
	СтруктураНастроек.Вставить("ОбщиеНастройки"	, ОбщиеНастройки);
	// Диагностика: структура здесь собирается вручную, и без ключей "Логирование"/"Операция"
	// сообщения об ошибках авторизации не попадали ни в журнал, ни пользователю.
	СтруктураНастроек.Вставить("Логирование", Б24_К_ОбщегоНазначенияВызовСервера.СтруктураЛогированияПоУмолчанию("Авторизация подключения"));
	СтруктураНастроек.Вставить("Операция", "Авторизация подключения");
	СтруктураНастроек.Вставить("ИнтерактивныйЗапуск", Истина);
	Б24_К_RestApiВызовСервера.ДобавлениеНастроекАвторизации(СтруктураНастроек);

	ТокенДляСоединенияПолучен = Б24_К_RestApiВызовСервера.ПолучитьТокенДляСоединения(СтруктураНастроек, Истина, Результат);

	УжеЕстьТакаяНастройка = ПроверитьНастройкуПоПорталуНаДубль(Портал);

	Если УжеЕстьТакаяНастройка Тогда
		Портал	= "";
		Токен 	= "";
		ПоказатьОповещениеПользователя("Настройка с таким порталом уже существует. Создать еще одну нельзя.");
	Иначе
		Портал 	= СтрЗаменить(СтруктураНастроек.НастройкиПодключения.АдресСайта,"/rest/","");
		Портал	= СтрЗаменить(Портал,"https://","");
		Токен 	= Результат;
		Если НЕ ТокенДляСоединенияПолучен ИЛИ НЕ ЗначениеЗаполнено(Портал) Тогда
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, СтруктураНастроек.ТипыСообщений.КритическаяОшибка,
				"Не удалось получить адрес портала по указанному токену. Причина отказа — в сообщениях об авторизации выше.");
		КонецЕсли;
	КонецЕсли;

	ДанныеОЛицензиях = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ДополнительнаяИнформация");
	Если ТипЗнч(ДанныеОЛицензиях) <> Тип("Соответствие") Тогда ДанныеОЛицензиях = Новый Соответствие КонецЕсли;

	ИнформацияОЛицензии = Новый Структура;
	ИнформацияОЛицензии.Вставить("Дата", Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса()-60*60*24);
	ИнформацияОЛицензии.Вставить("Ключ", Токен);

	ДанныеОЛицензиях.Вставить(НастройкаПодключения, ИнформацияОЛицензии);
	Б24_К_ОбщегоНазначенияВызовСервера.УстановитьЗначениеВХранилищаНастроек("ДополнительнаяИнформация", ДанныеОЛицензиях);

	Модифицированность = Истина;

	ВыгружатьНастройкиНаПортал = Истина;
	ОбновитьСписокПользователейБитрикс24();
	ОбновитьОтображениеЭлементовФормы();

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьНДС(Команда)

	Если Модифицированность Тогда

		Обещание = ВопросАсинх("Требуется сохранить настройку. Сохранить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Результат = Ждать обещание;

		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		СохранитьВыгрузитьНастройки();

	КонецЕсли;

	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);

	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка ставок НДС на портале.";

	ТелоHTTPЗапроса = "&filter[active]=Y";
	ДанныеНДС = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/catalog.vat.list", "id", ТелоHTTPЗапроса, "vats");
	Для каждого ТекЭлемент Из ДанныеНДС Цикл

		ИдЭлемента 	= Формат(ТекЭлемент.Получить("id"), "ЧГ=0");
		СтавкаБ24 	= ТекЭлемент.Получить("rate");
		НаименованиеНДС= ТекЭлемент.Получить("name");

		Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
			Если СтавкаБ24 = Неопределено Тогда
				СтавкаНДС = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьСтавкуНДСПоСтавке("Без НДС");
			Иначе
				СтавкаНДС = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьСтавкуНДСПоСтавке(СтавкаБ24);
			КонецЕсли;

			НайденныеСтроки = ПресетыСтавокНДС.НайтиСтроки(Новый Структура("ИдСтавки", ИдЭлемента));
			Если НайденныеСтроки.Количество() = 0 Тогда
				НайденныеСтроки = ПресетыСтавокНДС.НайтиСтроки(Новый Структура("СтавкаНДС", СтавкаНДС));
			КонецЕсли;

			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = ПресетыСтавокНДС.Добавить();
				НоваяСтрока.ИдСтавки 	= ИдЭлемента;
				НоваяСтрока.СтавкаНДС 	= СтавкаНДС;
				НоваяСтрока.НаименованиеСтавкиНДС = НаименованиеНДС;
			Иначе
				НайденнаяСтрока = НайденныеСтроки[0];
				НайденнаяСтрока.НаименованиеСтавкиНДС = НаименованиеНДС;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если Команда <> Неопределено Тогда
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыгрузитьНДС(Команда)

	Если Модифицированность Тогда

		Обещание = ВопросАсинх("Требуется сохранить настройку. Сохранить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Результат = Ждать обещание;

		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		СохранитьВыгрузитьНастройки();

	КонецЕсли;

	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Выгрузка ставок НДС";

	ВыгрузитьНДССервер(СтруктураНастроек);

	ЗагрузитьНДС(Неопределено);

	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ВыгрузитьНДССервер(СтруктураНастроек)

	Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
		Возврат;
	КонецЕсли;

	СформированныеЗапросы = Новый Массив;

	Для каждого ТекСтрока Из ПресетыСтавокНДС Цикл

		СтавкаНДС = ТекСтрока.СтавкаНДС;
		Если НЕ ЗначениеЗаполнено(СтавкаНДС) Тогда
			Продолжить;
		КонецЕсли;

		КлючСтавкиНДС	= XMLСтрока(СтавкаНДС);

		Поля = Новый Структура;

		Поля.Вставить("name"	, Строка(СтавкаНДС));
		Поля.Вставить("rate"	, Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьСтавкуНДСПоСтавке(СтавкаНДС));
		Поля.Вставить("active"	, "Y");

		ТелоЗапроса = "";
		Для каждого ТекПоле Из Поля Цикл
			ТелоЗапроса = ТелоЗапроса + ?(СтрДлина(ТелоЗапроса) >0, "&", "") +"fields["+ ТекПоле.Ключ + "]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПоле.Значение);
		КонецЦикла;

		ИдСтавки = ТекСтрока.ИдСтавки;
		Если НЕ ЗначениеЗаполнено(ИдСтавки) Тогда
			СформированныеЗапросы.Добавить("cmd["+КлючСтавкиНДС+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.vat.add?" + ТелоЗапроса));
		Иначе
			СформированныеЗапросы.Добавить("cmd["+КлючСтавкиНДС+"]=" +  Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("catalog.vat.update?id=" + ИдСтавки + "&"  + ТелоЗапроса));
		КонецЕсли;

	КонецЦикла;

	КоличествоВЗапросе 	= 0;
	ТелоHTTPЗапроса		= "";
	Для каждого ТекЭлемент Из СформированныеЗапросы Цикл

		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + ТекЭлемент;

		КоличествоВЗапросе = КоличествоВЗапросе + 1;
		Если КоличествоВЗапросе = 50 Тогда

			Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);

			КоличествоВЗапросе 	= 0;
			ТелоHTTPЗапроса 	= "";

		КонецЕсли;

	КонецЦикла;

	Если КоличествоВЗапросе > 0 Тогда
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьПресетыШаблоновСПортала(Команда)

	Если Модифицированность Тогда

		Обещание = ВопросАсинх("Требуется сохранить настройку. Сохранить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Результат = Ждать обещание;

		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		СохранитьВыгрузитьНастройки();

	КонецЕсли;

	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);

	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Загрузка пресетов шаблонов";

	ТелоHTTPЗапроса = "&start=-1&filter[ENTITY_TYPE_ID]=8&filter[ACTIVE]=Y";
	ДанныеПресетов = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.requisite.preset.list", "ID", ТелоHTTPЗапроса);
	Для каждого ТекЭлемент Из ДанныеПресетов Цикл

		НайденныеСтроки = ПресетыШаблоновРеквизитов.НайтиСтроки(Новый Структура("ИдШаблона", ТекЭлемент.Получить("ID")));

		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ПресетыШаблоновРеквизитов.Добавить();
			НоваяСтрока.НаименованиеШаблона = ТекЭлемент.Получить("NAME");
			НоваяСтрока.ИдШаблона = Формат(ТекЭлемент.Получить("ID"), "ЧГ=0");

		КонецЕсли;

	КонецЦикла;

	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьТипыКомпаний(Команда)

	Если Модифицированность Тогда

		Обещание = ВопросАсинх("Требуется сохранить настройку. Сохранить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Результат = Ждать обещание;

		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		СохранитьВыгрузитьНастройки();

	КонецЕсли;

	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);

	Если СтруктураНастроек = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось подключиться к Битрикс24");
		Возврат;
	КонецЕсли;

	СтруктураНастроек.Логирование.Измерение1 = "Служебные операции";
	СтруктураНастроек.Логирование.Измерение2 = "Загрузка типов компаний";

	Фильтр = "";
	СписокАктуальныхИД = Новый Массив;
	ДанныеСтатусов = Б24_К_RestApiВызовСервера.ПолучитьМассивСтатусовCRM(СтруктураНастроек, Фильтр);
	Для каждого ТекЭлемент Из ДанныеСтатусов Цикл

		Если НЕ ТекЭлемент.Получить("ENTITY_ID") = "COMPANY_TYPE" Тогда
			Продолжить;
		КонецЕсли;

		ИдТипа = Формат(ТекЭлемент.Получить("STATUS_ID"), "ЧГ=0");

		НайденныеСтроки = ПресетыТиповКомпаний.НайтиСтроки(Новый Структура("ИдТипа", ИдТипа));
		СписокАктуальныхИД.Добавить(ИдТипа);

		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ПресетыТиповКомпаний.Добавить();
		Иначе
			НоваяСтрока = НайденныеСтроки[0];
		КонецЕсли;
		НоваяСтрока.НаименованиеТипа = Строка(ТекЭлемент.Получить("NAME"));
		НоваяСтрока.ИдТипа =  ИдТипа;

	КонецЦикла;

	СтрокиДляУдаления = Новый Массив;

	Для Каждого Строка Из ПресетыТиповКомпаний Цикл
		НайденаСтрока = СписокАктуальныхИД.Найти(Строка.ИдТипа);
		Если НайденаСтрока = Неопределено Тогда
			СтрокиДляУдаления.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Строка Из СтрокиДляУдаления Цикл
		ПресетыТиповКомпаний.Удалить(Строка);
	КонецЦикла;

	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьТипыКонтактов(Команда)

	Если Модифицированность Тогда

		Обещание = ВопросАсинх("Требуется сохранить настройку. Сохранить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Результат = Ждать обещание;

