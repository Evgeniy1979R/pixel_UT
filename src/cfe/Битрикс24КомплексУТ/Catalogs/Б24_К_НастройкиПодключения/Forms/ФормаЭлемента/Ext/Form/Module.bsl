Процедура НастроитьЗаполнениеДел(Команда)

	Если ЗначениеЗаполнено(НастройкаПодключения) Тогда

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаПодключения", НастройкаПодключения);
	ОткрытьФорму("РегистрСведений.Б24_К_АлгоритмыЗаполненияДел.ФормаСписка", ПараметрыФормы,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

