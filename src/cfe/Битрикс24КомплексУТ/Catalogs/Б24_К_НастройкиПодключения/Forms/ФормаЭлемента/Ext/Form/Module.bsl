&НаКлиенте
Функция ПроверитьЗаполнениеПресетов()

	ЕстьОшибка = Ложь;

	Если НЕ НастройкаПодключения.Пустая() Тогда
		Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
			#Область ПресетыСтавокНДС
			Если ПресетыСтавокНДС.Количество() = 0 Тогда
				ЕстьОшибка = Истина;
				ОбщегоНазначенияКлиент.СообщитьПользователю("Не задан маппинг пресетов ставок НДС",, "ПресетыСтавокНДС");
			КонецЕсли;
			#КонецОбласти

			#Область ПресетыШаблоновРеквизитов
			Если ПресетыШаблоновРеквизитов.Количество() = 0 Тогда
				ЕстьОшибка = Истина;
				ОбщегоНазначенияКлиент.СообщитьПользователю("Не задан маппинг пресетов реквизитов",, "ПресетыШаблоновРеквизитов");
			КонецЕсли;
			#КонецОбласти
		КонецЕсли;

		Если КЭДО Тогда
			#Область СопоставлениеОрганизаций
			Если СопоставлениеОрганизаций.Количество() = 0 Тогда
				ЕстьОшибка = Истина;
				ОбщегоНазначенияКлиент.СообщитьПользователю("Не задан маппинг пресетов Организаций",, "СопоставлениеОрганизаций");
			КонецЕсли;
			#КонецОбласти
		КонецЕсли;
	КонецЕсли;

	Возврат ЕстьОшибка;

КонецФункции

&НаСервере
Процедура ЗагрузкаОрганизацийБитрикс24()

	СопоставлениеОрганизаций.Загрузить(Справочники.Б24_К_НастройкиПодключения.СопоставленныеОрганизации(НастройкаПодключения));

	ВыгружатьНастройкиНаПортал = Истина;
	Модифицированность = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкаПодключенияПоПорталу(Портал)

	Возврат Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.НастройкаПодключенияПоПорталу(Портал);

КонецФункции

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	ВыгружатьНастройкиНаПортал = Истина;
	Модифицированность = Истина;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ЗагрузитьЗначенияВСписок(СписокЗначений, Значения)

	СписокЗначений.ЗагрузитьЗначения(Значения);

КонецПроцедуры

&НаКлиенте
Функция ЗначениеЕстьВСписке(СписокЗначений, Значение)

	Возврат СписокЗначений.НайтиПоЗначению(Значение) <> Неопределено;

КонецФункции
