&НаКлиенте
Процедура ТипыКонтрагентовКомпанииКонтактаЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" Тогда
		Если (Элементы.ТипыКонтрагентовКомпанииЗначение = Элемент И ТипыКонтрагентовДляКонтактов.НайтиСтроки(Новый Структура("Тип", ВыбранноеЗначение)).Количество() > 0)
			ИЛИ (Элементы.ТипыКонтрагентовКонтактыЗначение = Элемент И ТипыКонтрагентовДляКомпаний.НайтиСтроки(Новый Структура("Тип", ВыбранноеЗначение)).Количество() > 0) Тогда
			СтандартнаяОбработка = Ложь;
			ПоказатьПредупреждение(,"Нельзя указать один и тот же тип контрагента 2 раза");
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		Если ЗначениеЕстьВСписке(ТипыКонтрагентовДляКомпаний, ВыбранноеЗначение)
			ИЛИ ЗначениеЕстьВСписке(ТипыКонтрагентовДляКонтактов, ВыбранноеЗначение) Тогда

			СтандартнаяОбработка = Ложь;
			ПоказатьПредупреждение(,"Нельзя указать один и тот же тип контрагента 2 раза");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

