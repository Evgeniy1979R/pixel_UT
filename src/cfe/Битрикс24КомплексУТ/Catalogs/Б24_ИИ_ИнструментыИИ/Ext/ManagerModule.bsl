#Область ВыгрузкаЗагрузкаИнструментов

Процедура ВыгрузкаИнструментовВФайл(ВыгружаемыеИнструменты, АдресРезультата) Экспорт
	
	ФормируемыеДанные = Новый Массив; 
 	
	Для каждого ТекИнструмент Из ВыгружаемыеИнструменты Цикл
			
		ДанныеИнструмента = Новый Структура;        
		ДанныеИнструмента.Вставить("Ссылка"				, ЗначениеВСтрокуВнутр(XMLСтрока(ТекИнструмент.Ссылка))); 	 
		ДанныеИнструмента.Вставить("Наименование"		, ЗначениеВСтрокуВнутр(ТекИнструмент.Наименование)); 	 
		ДанныеИнструмента.Вставить("ПолноеНаименование"	, ЗначениеВСтрокуВнутр(ТекИнструмент.ПолноеНаименование)); 	 
		ДанныеИнструмента.Вставить("Описание"			, ЗначениеВСтрокуВнутр(ТекИнструмент.Описание)); 	 
		ДанныеИнструмента.Вставить("ТекстЗапроса"		, ЗначениеВСтрокуВнутр(ТекИнструмент.ТекстЗапроса)); 	  
		ДанныеИнструмента.Вставить("НеИспользуется"		, ЗначениеВСтрокуВнутр(ТекИнструмент.НеИспользуется)); 	  
		
		ДанныеИнструмента.Вставить("Колонки"			, Новый Массив);
		ДанныеИнструмента.Вставить("Фильтры"			, Новый Массив);
				
		Для каждого ТекКолонка Из ТекИнструмент.Колонки Цикл     
			
			ДанныеКолонки = Новый Структура;
			ДанныеКолонки.Вставить("Имя"		, ЗначениеВСтрокуВнутр(ТекКолонка.Имя));
			ДанныеКолонки.Вставить("Название"	, ЗначениеВСтрокуВнутр(ТекКолонка.Название));
			ДанныеКолонки.Вставить("Описание"	, ЗначениеВСтрокуВнутр(ТекКолонка.Описание));
			ДанныеКолонки.Вставить("Тип"		, ЗначениеВСтрокуВнутр(ТекКолонка.Тип));
			
			ДанныеИнструмента.Колонки.Добавить(ДанныеКолонки); 
			
		КонецЦикла;
		
		
		Для каждого ТекФильтр Из ТекИнструмент.Фильтры Цикл     
			
			ДанныеФильтра = Новый Структура;
			ДанныеФильтра.Вставить("Имя"			, ЗначениеВСтрокуВнутр(ТекФильтр.Имя));
			ДанныеФильтра.Вставить("Название"		, ЗначениеВСтрокуВнутр(ТекФильтр.Название));
			ДанныеФильтра.Вставить("Описание"		, ЗначениеВСтрокуВнутр(ТекФильтр.Описание));
			ДанныеФильтра.Вставить("УсловиеСодержит", ЗначениеВСтрокуВнутр(ТекФильтр.УсловиеСодержит));
			ДанныеФильтра.Вставить("Тип"			, ЗначениеВСтрокуВнутр(ТекФильтр.Тип));
			
			ДанныеИнструмента.Фильтры.Добавить(ДанныеФильтра); 
			
		КонецЦикла; 
		
		ФормируемыеДанные.Добавить(ДанныеИнструмента);	
		
	КонецЦикла;
	
	Поток = Новый ПотокВПамяти;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьПоток(Поток,,, Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(ЗаписьJSON, ФормируемыеДанные);
	ЗаписьJSON.Закрыть();
	
	ДвоичныеДанные = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	ИмяФайла = ПолучитьИмяВременногоФайла("json");
	ДвоичныеДанные.Записать(ИмяФайла);
	
	ЗаписьZipФайла = Новый ЗаписьZipФайла();
	ЗаписьZipФайла.Добавить(ИмяФайла);    
	ДвоичныеДанные = ЗаписьZipФайла.ПолучитьДвоичныеДанные();
	УдалитьФайлы(ИмяФайла);
	
	ПоместитьВоВременноеХранилище(ДвоичныеДанные, АдресРезультата);
	
КонецПроцедуры

Процедура ЗагрузкаИнструментовИзФайла(ЗагружаемыеДанные, АдресРезультата) Экспорт

	Для каждого ТекЭлемент Из ЗагружаемыеДанные Цикл
		
		Наименование 		= ЗначениеИзСтрокиВнутр(ТекЭлемент.Получить("Наименование"));
		ПолноеНаименование 	= ЗначениеИзСтрокиВнутр(ТекЭлемент.Получить("ПолноеНаименование"));
		Описание 			= ЗначениеИзСтрокиВнутр(ТекЭлемент.Получить("Описание"));
		ТекстЗапроса 		= ЗначениеИзСтрокиВнутр(ТекЭлемент.Получить("ТекстЗапроса"));
		НеИспользуется 		= ЗначениеИзСтрокиВнутр(ТекЭлемент.Получить("НеИспользуется"));
		
		Колонки 	= ТекЭлемент.Получить("Колонки");
		Фильтры 	= ТекЭлемент.Получить("Фильтры");
		
		НайденныйЭлемент = Справочники.Б24_ИИ_ИнструментыИИ.НайтиПоНаименованию(Наименование, Истина);
		Если НайденныйЭлемент.Пустая() Тогда
			ИнструментИИ = Справочники.Б24_ИИ_ИнструментыИИ.СоздатьЭлемент();	
			ИнструментИИ.Наименование = Наименование;	
		Иначе
			ИнструментИИ = НайденныйЭлемент.ПолучитьОбъект();
			ИнструментИИ.Фильтры.Очистить();
			ИнструментИИ.Колонки.Очистить();
		КонецЕсли;
		
		ИнструментИИ.Описание 			= Описание;	
		ИнструментИИ.ПолноеНаименование = ПолноеНаименование;	
		ИнструментИИ.ТекстЗапроса 		= ТекстЗапроса;	
		ИнструментИИ.НеИспользуется 	= НеИспользуется;	
		
		Для каждого ТекКолонка Из Колонки Цикл
			
			НоваяКолонка = ИнструментИИ.Колонки.Добавить();
			НоваяКолонка.Имя 		= ЗначениеИзСтрокиВнутр(ТекКолонка.Получить("Имя"));
			НоваяКолонка.Название 	= ЗначениеИзСтрокиВнутр(ТекКолонка.Получить("Название"));
			НоваяКолонка.Описание 	= ЗначениеИзСтрокиВнутр(ТекКолонка.Получить("Описание"));
			НоваяКолонка.Тип 		= ЗначениеИзСтрокиВнутр(ТекКолонка.Получить("Тип"));
			
		КонецЦикла;  
		
		Для каждого ТекФильтр Из Фильтры Цикл
			
			НовыйФильтр = ИнструментИИ.Фильтры.Добавить();
			НовыйФильтр.Имя 			= ЗначениеИзСтрокиВнутр(ТекФильтр.Получить("Имя"));
			НовыйФильтр.Название 		= ЗначениеИзСтрокиВнутр(ТекФильтр.Получить("Название"));
			НовыйФильтр.Описание 		= ЗначениеИзСтрокиВнутр(ТекФильтр.Получить("Описание"));
			НовыйФильтр.УсловиеСодержит = ЗначениеИзСтрокиВнутр(ТекФильтр.Получить("УсловиеСодержит"));
			НовыйФильтр.Тип 			= ЗначениеИзСтрокиВнутр(ТекФильтр.Получить("Тип"));
			
		КонецЦикла;  
		
		ИнструментИИ.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ИнициализироватьНачальноеЗаполнение

Процедура ИнициализироватьОбновитьТиповыеТулы() Экспорт   
	
	ШаблонНачальныхТулзов = ПолучитьМакет("ШаблонНачальныхТулзов");
	Данные = ШаблонНачальныхТулзов.ПолучитьОбласть("Данные");
	ТабДок = Новый ТабличныйДокумент;	
	ТабДок.Вывести(Данные);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДок.Область());	
	ТабДанные = Построитель.Результат.Выгрузить();
	
	ШаблонНачальныхТулзов = ПолучитьМакет("ШаблонОписаниеПараметров");
	Данные = ШаблонНачальныхТулзов.ПолучитьОбласть("Данные");
	ТабДок = Новый ТабличныйДокумент;	
	ТабДок.Вывести(Данные);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДок.Область());	
	ТабПараметры = Построитель.Результат.Выгрузить();
	
	ШаблонНачальныхТулзов = ПолучитьМакет("ШаблонОписаниеПолей");
	Данные = ШаблонНачальныхТулзов.ПолучитьОбласть("Данные");
	ТабДок = Новый ТабличныйДокумент;	
	ТабДок.Вывести(Данные);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабДок.Область());	
	ТабПолей = Построитель.Результат.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабДанные", ТабДанные);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТабДанные.Наименование КАК Наименование
	               |ПОМЕСТИТЬ ВТ_Тулзы
	               |ИЗ
	               |	&ТабДанные КАК ТабДанные
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Т.Ссылка КАК Ссылка,
	               |	Т.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.Б24_ИИ_ИнструментыИИ КАК Т
	               |ГДЕ
	               |	Т.Наименование В
	               |			(ВЫБРАТЬ
	               |				ВТ_Тулзы.Наименование КАК Наименование
	               |			ИЗ
	               |				ВТ_Тулзы КАК ВТ_Тулзы)";
	НайденныеТулзы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр из ТабДанные Цикл		
		НайденТул = НайденныеТулзы.Найти(Стр.Наименование);		
		Если ЗначениеЗаполнено(НайденТул) Тогда
			Тул = НайденТул.Ссылка.ПолучитьОбъект();	
		Иначе
			Тул = Справочники.Б24_ИИ_ИнструментыИИ.СоздатьЭлемент();			
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Тул,Стр);		
		Тул.ОбработатьТекстЗапроса();
		Для Каждого Фильтр из Тул.Фильтры Цикл
			Найдено = ТабПараметры.Найти(Фильтр.Имя);
			Если НЕ Найдено = Неопределено Тогда
				Фильтр.Описание = Найдено.Описание;
				Фильтр.Название = Найдено.Название;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Фильтр из Тул.Колонки Цикл
			Найдено = ТабПолей.Найти(Фильтр.Имя);
			Если НЕ Найдено = Неопределено Тогда
				Фильтр.Описание = Найдено.Описание;
				Фильтр.Название = Найдено.Название;
			КонецЕсли;
		КонецЦикла;
		Тул.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

