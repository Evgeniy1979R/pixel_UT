
#Область СлужебныеПроцедурыИФункции  

Процедура ОбработатьТекстЗапроса() Экспорт
	
	Объект = ЭтотОбъект;
	тзнФильтры 	= Объект.Фильтры.Выгрузить();
	Объект.Фильтры.Очистить();
	
	тзнКолонки	= Объект.Колонки.Выгрузить();
	Объект.Колонки.Очистить();  
	
	мФильтрыПодобно = СтрНайтиВсеПоРегулярномуВыражению(Объект.ТекстЗапроса, "\bПОДОБНО\s+&");
	
 	Запрос = Новый Запрос(Объект.ТекстЗапроса);   

	ПараметрыЗапроса = Запрос.НайтиПараметры();
	Для каждого ТекПараметр Из ПараметрыЗапроса Цикл
		
		Запрос.УстановитьПараметр(ТекПараметр.Имя, Null);   
		
		НоваяСтрока = Объект.Фильтры.Добавить();
		НоваяСтрока.Имя 		= ТекПараметр.Имя;
		НоваяСтрока.Название 	= РазделитьЧастиСловаПоРегистру(ТекПараметр.Имя, Ложь);
		//НоваяСтрока.Название 	= Б24_К_RestApiВызовСервера.КонвертированноеНаименование(РазделитьЧастиСловаПоРегистру(ТекПараметр.Имя, Ложь));
		НоваяСтрока.Описание 	= РазделитьЧастиСловаПоРегистру(ТекПараметр.Имя, Ложь);
		
		НайденнаяСтрока = тзнФильтры.Найти(ТекПараметр.Имя, "Имя");
		Если НайденнаяСтрока <> Неопределено Тогда ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока) КонецЕсли;
		
		НоваяСтрока.Тип = ТипОбъектаСтрокой(ТекПараметр.ТипЗначения);
		Если НоваяСтрока.Тип = "string" Тогда		
			Для каждого ТекНайденныйПодобно Из мФильтрыПодобно Цикл				
				Если Сред(Объект.ТекстЗапроса, ТекНайденныйПодобно.НачальнаяПозиция + 9 , СтрДлина(ТекПараметр.Имя)) = ТекПараметр.Имя Тогда
					НоваяСтрока.УсловиеСодержит = Истина; 
					Прервать;
				Иначе
					НоваяСтрока.УсловиеСодержит = Ложь;   
				КонецЕсли;				
			КонецЦикла; 
		ИначеЕсли НоваяСтрока.Тип = "date" Тогда
			Запрос.УстановитьПараметр(ТекПараметр.Имя, ТекущаяДата());
			НоваяСтрока.Тип = "string";
		КонецЕсли;
		
	КонецЦикла; 
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Для каждого ТекКолонка Из ВыполненныйЗапрос.Колонки Цикл

		// Служебные поля запроса (по суффиксу имени) в контракт инструмента не попадают:
		// они нужны только для проверки прав доступа к ссылочным значениям выборки
		// (см. Б24_ИИ_ИнтеграцияСервер.СкрытьНедоступныеСтроки).
		СуффиксСлужебногоПоля = Б24_ИИ_ИнтеграцияСервер.СуффиксСлужебногоПоля();
		Если Прав(ТекКолонка.Имя, СтрДлина(СуффиксСлужебногоПоля)) = СуффиксСлужебногоПоля Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Объект.Колонки.Добавить();
		
		НоваяСтрока.Имя 		= ТекКолонка.Имя;
		НоваяСтрока.Название 	= РазделитьЧастиСловаПоРегистру(ТекКолонка.Имя, Ложь);
		//НоваяСтрока.Название 	= Б24_К_RestApiВызовСервера.КонвертированноеНаименование(РазделитьЧастиСловаПоРегистру(ТекКолонка.Имя, Ложь));
		НоваяСтрока.Описание 	= РазделитьЧастиСловаПоРегистру(ТекКолонка.Имя, Ложь);
		
		НайденнаяСтрока = тзнКолонки.Найти(ТекКолонка.Имя, "Имя");
		Если НайденнаяСтрока <> Неопределено Тогда ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока) КонецЕсли;
		
		НоваяСтрока.Тип = ТипОбъектаСтрокой(ТекКолонка.ТипЗначения);
		
	КонецЦикла; 
	
КонецПроцедуры

Функция ТипОбъектаСтрокой(ТипЗначенияОбъекта) 
	
	Результат = "string";	
	
	ТипыРеквизита 				= ТипЗначенияОбъекта.Типы();
	КоличествоТиповРеквизита 	= ТипыРеквизита.Количество();
	Если КоличествоТиповРеквизита > 2 Тогда
		Результат = "string";  
	ИначеЕсли КоличествоТиповРеквизита > 1 Тогда    
		
		Если ТипыРеквизита[0] = Тип("Null") Тогда
			ТипРеквизита = ТипыРеквизита[1];
		ИначеЕсли ТипыРеквизита[0] = Тип("Дата") Тогда
			ТипРеквизита = ТипыРеквизита[0];
		ИначеЕсли ТипыРеквизита[1] = Тип("Дата") Тогда
			ТипРеквизита = ТипыРеквизита[1];
		Иначе
			ТипРеквизита = ТипыРеквизита[0];
		КонецЕсли;
		
		Если ТипРеквизита = Тип("Число") Тогда
			Результат = "number";   
		ИначеЕсли ТипРеквизита = Тип("Булево") Тогда
			Результат = "boolean";   
		ИначеЕсли ТипРеквизита = Тип("Дата") Тогда
			Результат = "date";   
		Иначе 
			Результат = "string"; 
		КонецЕсли; 
	ИначеЕсли КоличествоТиповРеквизита = 1 Тогда
		
		ТипРеквизита = ТипыРеквизита[0];
		
		Если ТипРеквизита = Тип("Число") Тогда
			Результат = "number";   
		ИначеЕсли ТипРеквизита = Тип("Булево") Тогда
			Результат = "boolean";   
		ИначеЕсли ТипРеквизита = Тип("Дата") Тогда
			Результат = "date";   
		Иначе 
			Результат = "string"; 
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РазделитьЧастиСловаПоРегистру(Знач Значение, КаждоеСловоСЗаглавной = Истина) Экспорт    
    СмещениеДоНР = КодСимвола("а") - КодСимвола("А"); // Смещение кода символа от буквы верхнего регистра до буквы нижнего регистра 
	Значение = СтрЗаменить(Значение, "_", " ");
    Для тКодВР = КодСимвола("А") По КодСимвола("Я") Цикл
        Значение = СтрЗаменить(Значение, Символ(тКодВР), Символ(тКодВР) + Символ(тКодВР + СмещениеДоНР));
    КонецЦикла;
    РазделеннаяСтрока = "";
    мЧастиСтроки = СтрРазделить(Значение, "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЫЬЪЭЮЯ", Ложь);
    Для сч = 0 По мЧастиСтроки.ВГраница() Цикл                 
        тЧасть = СокрЛП(мЧастиСтроки[сч]);
		ОднаБуква = СтрДлина(тЧасть) = 1;
        Если сч = 0 Или КаждоеСловоСЗаглавной ИЛИ ОднаБуква Тогда
            тЧасть = ТРег(тЧасть);
		КонецЕсли;
		ДобавитьПробелПеред = ОднаБуква = Ложь и НЕ Прав(РазделеннаяСтрока,1) = " ";
         РазделеннаяСтрока = РазделеннаяСтрока 
		+ ?(ДобавитьПробелПеред," ","") + тЧасть + ?(ОднаБуква, "", " ");
	КонецЦикла;
	
    Возврат СокрП(РазделеннаяСтрока );
КонецФункции

#КонецОбласти