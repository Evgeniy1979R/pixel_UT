	
	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НеЗаполненДляФильтров = "B24_NoFilterSpecified";
КонецПроцедуры
	
#Область ОбработчикиСобытийФормы      

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)    
	
	Если НЕ ЗначениеЗаполнено(Объект.Описание) Тогда Объект.Описание = Объект.ПолноеНаименование КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда Объект.Наименование = Объект.ПолноеНаименование КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы  

&НаКлиенте
Асинх Процедура КомандаКонструкторЗапроса(Команда)    
	
	КонструкторЗапроса = Новый КонструкторЗапроса;
	Если Не ПустаяСтрока(Объект.ТекстЗапроса) Тогда
			КонструкторЗапроса.Текст = Объект.ТекстЗапроса;
	КонецЕсли;

	Обещание = КонструкторЗапроса.ОткрытьАсинх();
	Результат = Ждать Обещание;
	
	Если Результат = Неопределено Тогда Возврат КонецЕсли;
	
	Если Объект.ТекстЗапроса <> Результат Тогда
		Объект.ТекстЗапроса = Результат;   
		ОбработатьТекстЗапроса();		
	КонецЕсли;
	  
КонецПроцедуры               

#КонецОбласти


#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТекстЗапросаПриИзменении(Элемент)
	
	ОбработатьТекстЗапроса();	
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрыУсловиеСодержитПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Фильтры.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если ТекущиеДанные.УсловиеСодержит И НЕ ТекущиеДанные.Тип = "string" Тогда ТекущиеДанные.УсловиеСодержит = Ложь КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеСтрокойОткрытие(Элемент, СтандартнаяОбработка)  
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.Имя = "КолонкиОписание" Тогда
		УказатьОписаниеСтрокой(Элемент, "Описание");
	ИначеЕсли Элемент.Имя = "КолонкиНазвание" Тогда
		УказатьОписаниеСтрокой(Элемент, "Название");
	ИначеЕсли Элемент.Имя = "ФильтрыОписание" Тогда
		УказатьОписаниеСтрокой(Элемент, "Описание");
	ИначеЕсли Элемент.Имя = "ФильтрыНазвание" Тогда
		УказатьОписаниеСтрокой(Элемент, "Название");
	КонецЕсли;	 
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура УказатьОписаниеСтрокой(Элемент, ИмяПараметра)   
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	Обещание = ВвестиСтрокуАсинх(ТекущиеДанные[ИмяПараметра], ИмяПараметра,, Истина);
	Результат = Ждать Обещание;    
	Если Результат <> Неопределено Тогда ТекущиеДанные[ИмяПараметра] = Результат КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Прочие  

&НаСервере
Процедура ОбработатьТекстЗапроса()  
	СпрОбъект = РеквизитФормыВЗначение("Объект");
    СпрОбъект.ОбработатьТекстЗапроса();
	ЗначениеВРеквизитФормы(СпрОбъект,"Объект"); 
	//ЭтотОбъект.Прочитать();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ПолноеНаименование) Тогда
		Отказ = Истина;
		Возврат;	
	КонецЕсли;
	
	Если Не Параметры.Ключ.Пустая() и ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.Ссылка,"ПолноеНаименование") = ТекущийОбъект.ПолноеНаименование Тогда 
		//НЕ обновляем перевод если наименование не менялось	
	Иначе
		
		//КонвертированноеНаименование = СтрЗаменить(Б24_К_RestApiВызовСервера.КонвертированноеНаименование(ТекущийОбъект.ПолноеНаименование), " ", "_");
		КонвертированноеНаименование = СтрЗаменить(ТекущийОбъект.ПолноеНаименование, " ", "_");
		КонвертированноеНаименование = СтрЗаменить(КонвертированноеНаименование, ",", "");
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Наименование", КонвертированноеНаименование);
		Запрос.УстановитьПараметр("Ссылка"		, ТекущийОбъект.Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
		|	Б24_ИИ_ИнструментыИИ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Б24_ИИ_ИнструментыИИ КАК Б24_ИИ_ИнструментыИИ
		|ГДЕ
		|	Б24_ИИ_ИнструментыИИ.Наименование = &Наименование
		|	И Б24_ИИ_ИнструментыИИ.Ссылка <> &Ссылка";
		ВыполненныйЗапрос = Запрос.Выполнить();
		
		Если Не ВыполненныйЗапрос.Пустой() Тогда
			Отказ = Истина; 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("С таким названием уже есть инструмент");
			Возврат;	
		КонецЕсли;
		
		ТекущийОбъект.Наименование = КонвертированноеНаименование;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
