&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.пустая() Тогда
		
		Если Параметры.Свойство("НастройкаПодключения") Тогда
			НастройкаПодключения = Параметры.НастройкаПодключения; 
			Объект.НастройкаПодключения	= НастройкаПодключения;
		Иначе
			НастройкаПодключения = Объект.НастройкаПодключения;
		КонецЕсли;
		
		Если Параметры.Свойство("СинонимОтчета") Тогда
			Объект.Наименование = Параметры.СинонимОтчета; 	
		КонецЕсли;

		Объект.ТекстСообщения = "Отправлено из 1С в Битрикс24";
	    Объект.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		
		НоваяСтрока = Объект.ПользователиИГруппы.Добавить();
		НоваяСтрока.Тип 			= "Все пользователи";
		НоваяСтрока.Идентификатор 	= "Все пользователи";
		НоваяСтрока.Наименование 	= "Все пользователи";

		НовыйОтчет = Отчеты1С.Добавить();
		НовыйОтчет.Отчет = Параметры.ИмяОтчета;
		
		ТаблицаНастроекКомпоновки = Новый ТаблицаЗначений;	
		ТаблицаНастроекКомпоновки.Колонки.Добавить("Отчет");	
		ТаблицаНастроекКомпоновки.Колонки.Добавить("НастройкиОтчета");
		
		//время по умолчанию
		мВремяОтправки = Новый Массив;
		мВремяОтправки.Добавить(Дата("01.01.0001 9:00:00"));

		НастройкиВремени = Новый Структура;	
		НастройкиВремени.Вставить("Понедельник"		, Истина);
		НастройкиВремени.Вставить("Вторник"			, Истина);
		НастройкиВремени.Вставить("Среда"			, Истина);
		НастройкиВремени.Вставить("Четверг"			, Истина);
		НастройкиВремени.Вставить("Пятница"			, Истина);
		НастройкиВремени.Вставить("Суббота"			, Ложь);
		НастройкиВремени.Вставить("Воскресенье"		, Ложь);
		НастройкиВремени.Вставить("мВремяОтправки"	, мВремяОтправки);

		АдресНастройкиВремени = ПоместитьВоВременноеХранилище(НастройкиВремени, УникальныйИдентификатор);
				
		лНастройкаВремениСтрокой = ПолучитьДатуИВремяОтправкиОтчетаСтрокой(НастройкиВремени);
	
		Элементы.НастройкаВремени.Заголовок	= лНастройкаВремениСтрокой;
		Объект.НастройкиРегулярностиСтрокой = лНастройкаВремениСтрокой;
		
		АдресСсылки = ПоместитьВоВременноеХранилище(ТаблицаНастроекКомпоновки, УникальныйИдентификатор);
		
		ОбновитьНастройкиОтчетаСервер(Параметры.ИмяОтчета);

		Если ЭтоАдресВременногоХранилища(Параметры.НастройкиОтчета) Тогда
			НовыйОтчет = Отчеты[Параметры.ИмяОтчета].Создать();
			АдресСхемы = ПоместитьВоВременноеХранилище(НовыйОтчет.СхемаКомпоновкиДанных, УникальныйИдентификатор);
			КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы)); 

			КомпоновщикНастроек.ЗагрузитьНастройки(ПолучитьИзВременногоХранилища(Параметры.НастройкиОтчета));
			Элементы.КомпоновщикНастроекПользовательскиеНастройки.Обновить();
		КонецЕсли;
		
		ЗаписатьНастройкиОтчетаСервер(Параметры.ИмяОтчета);
	Иначе
		НастройкаПодключения = Объект.НастройкаПодключения;
	КонецЕсли;
	
	АдресПортала = "https://" + НастройкаПодключения.Портал;
	Элементы.Инфо2.Заголовок = "Публикация будет отправлена в ваш Битрикс24: "; 
	Элементы.Инфо1.Заголовок = АдресПортала; 

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	тзнНастроек = ПолучитьИзВременногоХранилища(АдресСсылки);
	
	ТекущийОбъект.СохраненныеНастройки = Новый ХранилищеЗначения(тзнНастроек);

	тзнНастроекРегулярности = ПолучитьИзВременногоХранилища(АдресНастройкиВремени);
	
	ТекущийОбъект.СохраненныеНастройкиРегулярности = Новый ХранилищеЗначения(тзнНастроекРегулярности);
	
КонецПроцедуры

#КонецОбласти



#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НастроитьВремя(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресНастройкиВремени"		, АдресНастройкиВремени);
		
	ОтветФормы = Неопределено;
			
	ОткрытьФорму("Справочник.Б24_КЭ_РегулярныеПубликацииОтчетовВБитрикс24.Форма.ФормаВводаВремени", ПараметрыФормы, ЭтотОбъект,,,, Новый ОписаниеОповещения("НастроитьВремяЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВремяЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    ОтветФормы = Результат;
    
    Если ОтветФормы <> Неопределено Тогда
			
		НастройкиВремени 	= ПолучитьИзВременногоХранилища(ОтветФормы.АдресНастройкиВремени);
		
		лНастройкаВремениСтрокой = ПолучитьДатуИВремяОтправкиОтчетаСтрокой(НастройкиВремени);
		
		Элементы.НастройкаВремени.Заголовок	= лНастройкаВремениСтрокой;
		Объект.НастройкиРегулярностиСтрокой = лНастройкаВремениСтрокой;
		
		АдресНастройкиВремени 	= ПоместитьВоВременноеХранилище (НастройкиВремени, УникальныйИдентификатор);
	
        Модифицированность = Истина;
		
    КонецЕсли;
	
КонецПроцедуры

