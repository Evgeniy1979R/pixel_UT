&НаСервере
Процедура ДобавитьЭлементыВТаблицуВыбора(Тип, МассивЭлементов)
	
	Для каждого ЭлементМассива Из МассивЭлементов Цикл
		
		НовСтрока = Объект.ПользователиИГруппы.Добавить();
		НовСтрока.Тип = Тип;
		НовСтрока.Идентификатор = ЭлементМассива.Значение;
		НовСтрока.Наименование 	= Тип +": " + ЭлементМассива.Представление;
		
	КонецЦикла;

КонецПроцедуры

