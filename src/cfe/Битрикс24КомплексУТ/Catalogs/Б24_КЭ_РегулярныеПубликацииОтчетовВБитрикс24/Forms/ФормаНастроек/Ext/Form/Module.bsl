#Область ПроцедурыИФункцииПоРаботеСОтчетами

////////////////////////////////////////////////////////////////
//                                                           //
//  ПРОЦЕДУРЫ И ФУНКЦИИ ПО РАБОТЕ С ОТЧЕТАМИ 				//
//                                                         //
////////////////////////////////////////////////////////////

&НаКлиенте
Процедура Отчеты1СПриАктивизацииСтроки(Элемент)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда	
		
		Элементы.КомпоновщикНастроекПользовательскиеНастройки.Видимость = Истина;
		
		СписокОтчетов = ПолучитьСписокОтчетов();

		Для Каждого ТекЭлемент Из СписокОтчетов Цикл 
			
		     Элементы.Отчеты1СОтчет.СписокВыбора.Добавить(ТекЭлемент.Значение, ТекЭлемент.Представление);
						  
		 КонецЦикла;
		 
		лНазваниеОтчета = Элемент.ТекущиеДанные.Отчет;
		 
		Если лНазваниеОтчета <> "" Тогда
			ОбновитьНастройкиОтчетаСервер(лНазваниеОтчета);
		КонецЕсли;
	Иначе
		Элементы.КомпоновщикНастроекПользовательскиеНастройки.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отчеты1СОтчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Элементы.Отчеты1С.ТекущиеДанные.ВремяСтрокой = Объект.НастройкиРегулярностиСтрокой;	
	
	Если НЕ ПроверкаКорректностиВыбранногоОтчета(ВыбранноеЗначение) Тогда 
	
		СтандартнаяОбработка = Ложь;
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выбранный отчет не поддерживается.");
		ВыбранноеЗначение = "";
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Отчеты1СОтчетПриИзменении(Элемент)
	
	СтрокаТаблицыОтчетов = Элементы.Отчеты1С.ТекущиеДанные;
	
	Если СтрокаТаблицыОтчетов <> Неопределено Тогда	
		лНазваниеОтчета = СтрокаТаблицыОтчетов.Отчет;
		
		Если лНазваниеОтчета <> "" Тогда
			ОбновитьНастройкиОтчетаСервер(лНазваниеОтчета);
		КонецЕсли;
		
	КонецЕсли;
				
	НастройкиВремени 					= ПолучитьИзВременногоХранилища(АдресНастройкиВремени);
	Объект.НастройкиРегулярностиСтрокой = ПолучитьДатуИВремяОтправкиОтчетаСтрокой(НастройкиВремени);
		
	Для Каждого ТекСтрока Из Отчеты1С Цикл
		ТекСтрока.ВремяСтрокой = Объект.НастройкиРегулярностиСтрокой;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекПользовательскиеНастройкиПриИзменении(Элемент)
	
	ТекущаяСтрокаОтчета = Элементы.Отчеты1С.ТекущиеДанные;
	
	Если ТекущаяСтрокаОтчета = Неопределено Тогда
		ЗаписатьНастройкиОтчетаСервер(Неопределено); 
	Иначе
		ЗаписатьНастройкиОтчетаСервер(ТекущаяСтрокаОтчета.Отчет); 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСписокОтчетов()
	
	тзнОтчетов 		= Отчеты1С.Выгрузить();

	ВремТзнОтчетов = Новый ТаблицаЗначений;
	ВремТзнОтчетов.Колонки.Добавить("Имя");
	ВремТзнОтчетов.Колонки.Добавить("Синоним");
	
	Для Каждого ТекСтр Из Метаданные.Отчеты Цикл
		
		Если тзнОтчетов.Найти(ТекСтр.Имя) = Неопределено Тогда
			
			НовСтр = ВремТзнОтчетов.Добавить();
			НовСтр.Имя 		= ТекСтр.Имя;
			НовСтр.Синоним 	= ТекСтр.Синоним;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВремТзнОтчетов.Сортировать("Синоним");
	
	СписокОтчетов 	= Новый СписокЗначений;
	
	Для Каждого ТекСтр Из ВремТзнОтчетов Цикл
		
		СписокОтчетов.Добавить(ТекСтр.Имя, ТекСтр.Синоним);
		
	КонецЦикла;
	
	Возврат СписокОтчетов;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверкаКорректностиВыбранногоОтчета(НазваниеОтчета)
	
	Если Отчеты[НазваниеОтчета].Создать().СхемаКомпоновкиДанных <> Неопределено Тогда
		Возврат Истина;	
	Иначе
		Возврат Ложь;	
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ОбновитьНастройкиОтчетаСервер(НазваниеОтчета)
	
	НовыйОтчет = Отчеты[НазваниеОтчета].Создать();
	
	АдресСхемы = ПоместитьВоВременноеХранилище(НовыйОтчет.СхемаКомпоновкиДанных, УникальныйИдентификатор);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы)); 

	ТаблицаНастроекКомпоновки = ПолучитьИзВременногоХранилища(АдресСсылки);
	
	НайденнаяСтрока = ТаблицаНастроекКомпоновки.Найти(НазваниеОтчета);	
		
	Если  НайденнаяСтрока = Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(НовыйОтчет.СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	ИначеЕсли ТипЗнч(НайденнаяСтрока.НастройкиОтчета) = Тип("Структура")
			И НайденнаяСтрока.НастройкиОтчета.Свойство("НастройкиКомпоновкиДанных") Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(НайденнаяСтрока.НастройкиОтчета.НастройкиКомпоновкиДанных);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(НайденнаяСтрока.НастройкиОтчета);
	КонецЕсли;

	Элементы.КомпоновщикНастроекПользовательскиеНастройки.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиОтчетаСервер(НаименованиеОтчета)
	
	ТаблицаНастроекКомпоновки = ПолучитьИзВременногоХранилища(АдресСсылки);
	
	ОбновленнаяТаблица = ТаблицаНастроекКомпоновки.СкопироватьКолонки();
	
	Для Каждого ТекЭлемент Из ТаблицаНастроекКомпоновки Цикл
		
		НайденныеСтроки = Отчеты1С.НайтиСтроки(Новый Структура("Отчет",ТекЭлемент.Отчет));

		Если НайденныеСтроки.Количество() > 0 Тогда
			НовСтрока = ОбновленнаяТаблица.Добавить();
			НовСтрока.Отчет 			= ТекЭлемент.Отчет;
			НовСтрока.НастройкиОтчета 	= ТекЭлемент.НастройкиОтчета;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НаименованиеОтчета <> Неопределено Тогда
		
		НайденныйОтчет = ОбновленнаяТаблица.Найти(НаименованиеОтчета);
		
		Если НайденныйОтчет <> Неопределено Тогда
			НайденныйОтчет.НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки(); 
		Иначе
			НовСтрока = ОбновленнаяТаблица.Добавить();
			НовСтрока.Отчет = НаименованиеОтчета;
			НовСтрока.НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
		КонецЕсли;
		
	КонецЕсли;
	
	АдресСсылки = ПоместитьВоВременноеХранилище(ОбновленнаяТаблица, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура Отчеты1СПриИзменении(Элемент)
		
	ТекущаяСтрокаОтчета = Элементы.Отчеты1С.ТекущиеДанные;
	
	Если ТекущаяСтрокаОтчета = Неопределено Тогда
		ЗаписатьНастройкиОтчетаСервер(Неопределено); 
	Иначе
		ЗаписатьНастройкиОтчетаСервер(ТекущаяСтрокаОтчета.Отчет); 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьДатуИВремяОтправкиОтчетаСтрокой(НастройкиВремени)
	
	ДатаСтрокой = "";
	
	Если НастройкиВремени <> Неопределено Тогда
		
		ДатаСтрокой = ДатаСтрокой + " Дни недели [ ";

		
		Если НастройкиВремени.Понедельник Тогда
			ДатаСтрокой = ДатаСтрокой + "пн. ";	
		КонецЕсли;   		
		Если НастройкиВремени.Вторник Тогда
			ДатаСтрокой = ДатаСтрокой + "вт. ";	
		КонецЕсли;
		Если НастройкиВремени.Среда Тогда
			ДатаСтрокой = ДатаСтрокой + "ср. ";	
		КонецЕсли;
		Если НастройкиВремени.Четверг Тогда
			ДатаСтрокой = ДатаСтрокой + "чт. ";	
		КонецЕсли;
		Если НастройкиВремени.Пятница Тогда
			ДатаСтрокой = ДатаСтрокой + "пт. ";	
		КонецЕсли;
		Если НастройкиВремени.Суббота Тогда
			ДатаСтрокой = ДатаСтрокой + "сб. ";	
		КонецЕсли;
		Если НастройкиВремени.Воскресенье Тогда
			ДатаСтрокой = ДатаСтрокой + "вс. ";	
		КонецЕсли;

		ДатаСтрокой = ДатаСтрокой + "] Время [ ";
		Для каждого ТекЗначение Из  НастройкиВремени.МВремяОтправки Цикл
			
			ДатаСтрокой = ДатаСтрокой  + Формат(ТекЗначение,"ДЛФ=T") + " ";
			
		КонецЦикла;
		ДатаСтрокой = ДатаСтрокой + "]";		
	КонецЕсли;
	
	Возврат ДатаСтрокой;	
	
КонецФункции


&НаКлиенте
Процедура НастройкаПодключенияПриИзменении(Элемент)
	
	НастройкаПодключения = Объект.НастройкаПодключения;

	АдресПортала = "https://" + ЗначениеРеквизитаОбъекта(НастройкаПодключения, "Портал"); 
	Элементы.Инфо1.Заголовок = АдресПортала;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчет(Команда)
	Если Модифицированность Тогда
		ПоказатьПредупреждение(,"Необходимо сначала записать настройку!");
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Элементы.Отчеты1С.ТекущиеДанные;
	КЭ_Битрикс = Новый Структура;
	КЭ_Битрикс.Вставить("Отчет", ТекущиеДанные.Отчет);
	КЭ_Битрикс.Вставить("Ссылка", Объект.Ссылка);
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("КЭ_Битрикс", КЭ_Битрикс);
	Если Не ТекущиеДанные = Неопределено Тогда
		ОткрытьФорму("Отчет."+ТекущиеДанные.Отчет+".Форма",ПараметрыОткрытия);             
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


&НаСервере        
Функция ЗначениеРеквизитаОбъекта(ОбъектСсылка, ИмяРеквизита)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектСсылка, ИмяРеквизита);

КонецФункции
