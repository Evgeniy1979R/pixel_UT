

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СохраненныеНастройкиРегулярности 	= Объект.Ссылка.СохраненныеНастройкиРегулярности.Получить();
	Объект.НастройкиРегулярностиСтрокой = ПолучитьДатуИВремяОтправкиОтчетаСтрокой(СохраненныеНастройкиРегулярности);
	
	АдресНастройкиВремени = ПоместитьВоВременноеХранилище(СохраненныеНастройкиРегулярности, УникальныйИдентификатор);
	
	
	Если Объект.Ссылка.пустая() Тогда
		
		НастройкаПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию("ЭкспортПечатныхФормОтчетов", Истина);
		Объект.НастройкаПодключения = НастройкаПодключения;
		
		Объект.ТекстСообщения = "Отправлено из 1С в Битрикс24";
	    Объект.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		
		ТаблицаНастроекКомпоновки = Новый ТаблицаЗначений;	
		ТаблицаНастроекКомпоновки.Колонки.Добавить("Отчет");	
		ТаблицаНастроекКомпоновки.Колонки.Добавить("НастройкиВремени");	
		ТаблицаНастроекКомпоновки.Колонки.Добавить("НастройкиОтчета");
		
		НоваяСтрока = Объект.ПользователиИГруппы.Добавить();
		НоваяСтрока.Тип 			= "Все пользователи";
		НоваяСтрока.Идентификатор 	= "Все пользователи";
		НоваяСтрока.Наименование 	= "Все пользователи";
		
		
		//время по умолчанию
		мВремяОтправки = Новый Массив;
		мВремяОтправки.Добавить(Дата("01.01.0001 9:00:00"));

		НастройкиВремени = Новый Структура;	
		НастройкиВремени.Вставить("Понедельник"		, Истина);
		НастройкиВремени.Вставить("Вторник"			, Истина);
		НастройкиВремени.Вставить("Среда"			, Истина);
		НастройкиВремени.Вставить("Четверг"			, Истина);
		НастройкиВремени.Вставить("Пятница"			, Истина);
		НастройкиВремени.Вставить("Суббота"			, Ложь);
		НастройкиВремени.Вставить("Воскресенье"		, Ложь);
		НастройкиВремени.Вставить("мВремяОтправки"	, мВремяОтправки);

		АдресНастройкиВремени = ПоместитьВоВременноеХранилище(НастройкиВремени, УникальныйИдентификатор);
		
	Иначе
		
		НастройкаПодключения = Объект.НастройкаПодключения;
		                               
		ТаблицаНастроекКомпоновки	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(Объект.Ссылка, "СохраненныеНастройки").Получить();
		
		ТаблицаОтчета = Новый ТаблицаЗначений;
		ТаблицаОтчета.Колонки.Добавить("Отчет");
		ТаблицаОтчета.Колонки.Добавить("ВремяСтрокой");
		
		Для Каждого ТекСтрока Из ТаблицаНастроекКомпоновки Цикл
			
			НовСтрока = ТаблицаОтчета.Добавить();
			НовСтрока.Отчет = ТекСтрока.Отчет;
			НовСтрока.ВремяСтрокой 	= Объект.НастройкиРегулярностиСтрокой;
				
		КонецЦикла; 		
		
		Отчеты1С.Загрузить(ТаблицаОтчета);
		
	КонецЕсли;
	
	АдресСсылки = ПоместитьВоВременноеХранилище(ТаблицаНастроекКомпоновки, УникальныйИдентификатор);
	
	АдресПортала = "https://" + НастройкаПодключения.Портал;
	
	Элементы.Инфо2.Заголовок = "Публикация будет отправлена в ваш Битрикс24: "; 
	Элементы.Инфо1.Заголовок = АдресПортала; 
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "ЗУП" Тогда
		Элементы.Отчеты1СОткрытьОтчет.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не указана настройки подключения");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	тзнНастроек = ПолучитьИзВременногоХранилища(АдресСсылки);
	
	ТекущийОбъект.СохраненныеНастройки = Новый ХранилищеЗначения(тзнНастроек);
	
	тзнНастроекРегулярности = ПолучитьИзВременногоХранилища(АдресНастройкиВремени);
	
	ТекущийОбъект.СохраненныеНастройкиРегулярности = Новый ХранилищеЗначения(тзнНастроекРегулярности);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти



