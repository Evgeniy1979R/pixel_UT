&НаКлиенте
Процедура НастроитьВремя(Команда)
	
	лТекущиеДанные = Элементы.Отчеты1С.ТекущиеДанные;
	
	Если лТекущиеДанные <> Неопределено Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресНастройкиВремени"		, АдресНастройкиВремени);
		
		ОтветФормы = Неопределено;
				
		ОткрытьФорму("Справочник.Б24_КЭ_РегулярныеПубликацииОтчетовВБитрикс24.Форма.ФормаВводаВремени", ПараметрыФормы, ЭтотОбъект,,,, Новый ОписаниеОповещения("НастроитьВремяЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВремяЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    ОтветФормы = Результат;
    
    Если ОтветФормы <> Неопределено Тогда
			
		НастройкиВремени 					= ПолучитьИзВременногоХранилища(ОтветФормы.АдресНастройкиВремени);
		АдресНастройкиВремени 				= ПоместитьВоВременноеХранилище (НастройкиВремени, УникальныйИдентификатор);

		Объект.НастройкиРегулярностиСтрокой = ПолучитьДатуИВремяОтправкиОтчетаСтрокой(НастройкиВремени);
		
		Для Каждого ТекСтрока Из Отчеты1С Цикл
			ТекСтрока.ВремяСтрокой = Объект.НастройкиРегулярностиСтрокой;	
		КонецЦикла;
	
        Модифицированность = Истина;
		
    КонецЕсли;
	
КонецПроцедуры



&НаКлиенте
Процедура ДобавитьПользователей(Команда)
	
	Если  НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не указана настройки подключения");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	
	ОткрытьФорму("РегистрСведений.Б24_К_ПользователиБитрикс24.Форма.ФормаСписка", ПараметрыФормы, ЭтотОбъект,,,, Новый ОписаниеОповещения("ВыполнитьПослеВыбораПользователей", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

