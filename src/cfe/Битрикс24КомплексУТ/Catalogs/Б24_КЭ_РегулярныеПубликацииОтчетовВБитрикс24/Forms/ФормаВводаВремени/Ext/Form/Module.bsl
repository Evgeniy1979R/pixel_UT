
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресНастройкиВремени) Тогда
		
		АдресНастройкиВремени 	= Параметры.АдресНастройкиВремени;
		
		НастройкиВремени 		= ПолучитьИзВременногоХранилища(АдресНастройкиВремени);
		
		Если НастройкиВремени <> Неопределено Тогда 
			Понедельник = НастройкиВремени.Понедельник;
			Вторник     = НастройкиВремени.Вторник;
			Среда      	= НастройкиВремени.Среда;
			Четверг    	= НастройкиВремени.Четверг;
			Пятница    	= НастройкиВремени.Пятница;
			Суббота    	= НастройкиВремени.Суббота;
			Воскресенье = НастройкиВремени.Воскресенье;

			спкВремяОтправки.ЗагрузитьЗначения(НастройкиВремени.мВремяОтправки);
			
		КонецЕсли;
		
	КонецЕсли;		

КонецПроцедуры
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура Отмена(Команда)
		
	Если Модифицированность Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Параметры), "Изменения на форме не будут сохранены. Продолжить закрытие формы?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		Закрыть();	
	КонецЕсли;
	

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Закрыть();	
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
		
	Закрыть(ПрименитьНаСервере());
	

КонецПроцедуры

&НаСервере
Функция ПрименитьНаСервере()
	
	НастройкиВремени = Новый Структура;	
	НастройкиВремени.Вставить("Понедельник"		, Понедельник);
	НастройкиВремени.Вставить("Вторник"			, Вторник);
	НастройкиВремени.Вставить("Среда"			, Среда);
	НастройкиВремени.Вставить("Четверг"			, Четверг);
	НастройкиВремени.Вставить("Пятница"			, Пятница);
	НастройкиВремени.Вставить("Суббота"			, Суббота);
	НастройкиВремени.Вставить("Воскресенье"		, Воскресенье);
	НастройкиВремени.Вставить("мВремяОтправки"	, спкВремяОтправки.ВыгрузитьЗначения());

	лАдресНастроекВремени = ПоместитьВоВременноеХранилище(НастройкиВремени, УникальныйИдентификатор);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресНастройкиВремени"	, лАдресНастроекВремени);

	Возврат ПараметрыФормы;
	 
КонецФункции

