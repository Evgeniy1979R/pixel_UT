
Функция КореньСервисаPost(Запрос)

	ЗапросСтрокой = Запрос.ПолучитьТелоКакСтроку();

	Если ЭтоЗапросПроверкиПодключенияИИ(ЗапросСтрокой) Тогда
		Возврат ОтветПроверкиПодключенияИИ(ЗапросСтрокой);
	КонецЕсли;

	Возврат ОтветСпискаИнструментов();

КонецФункции

Функция КореньСервисаGet(Запрос)

	Возврат ПолучитьHTTPСервисОтвет("success");

КонецФункции

Функция listToolsPost(Запрос)

	ЗапросСтрокой = Запрос.ПолучитьТелоКакСтроку();

	Если ЭтоЗапросПроверкиПодключенияИИ(ЗапросСтрокой) Тогда
		Возврат ОтветПроверкиПодключенияИИ(ЗапросСтрокой);
	КонецЕсли;

	Возврат ОтветСпискаИнструментов();

КонецФункции

Функция ОтветСпискаИнструментов()

	УстановитьПривилегированныйРежим(Истина);

	ДанныеДляПередачи = Новый Структура;
	ДанныеДляПередачи.Вставить("format_version", "1.0");
	ДанныеДляПередачи.Вставить("tools", Новый Массив);

	Выборка = Справочники.Б24_ИИ_ИнструментыИИ.Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.НеИспользуется Тогда Продолжить КонецЕсли;
		Если Выборка.ПометкаУдаления Тогда Продолжить КонецЕсли;

		newElement =  Новый Структура;

		newElement.Вставить("name"			, Выборка.ПолноеНаименование);
		newElement.Вставить("description"	, Выборка.Описание);
		newElement.Вставить("method"		, Выборка.Наименование);

		elementParameters = Новый Структура;

		elementParameters.Вставить("columns", Новый Структура);

		elementParameters.columns.Вставить("type"		, "array_select");
		elementParameters.columns.Вставить("description", "Optional list of fields to return. Omit this parameter to use the server default field set.");
		elementParameters.columns.Вставить("required"	, "false");
		elementParameters.columns.Вставить("default"	, Новый Массив);
		elementParameters.columns.default.Добавить("*");
		elementParameters.columns.Вставить("options"	, Новый Массив);

		Для каждого ТекКолонка Из Выборка.Колонки Цикл
			decColumn = Новый Структура;
			decColumn.Вставить("name"			, ТекКолонка.Название);
			decColumn.Вставить("description"	, ТекКолонка.Описание);
			decColumn.Вставить("type"			, ТекКолонка.Тип);
			elementParameters.columns.options.Добавить(decColumn);
		КонецЦикла;

		Если Выборка.Фильтры.Количество() > 0 Тогда

			elementParameters.Вставить("filters", Новый Структура);

			elementParameters.filters.Вставить("type"		, "object");
			elementParameters.filters.Вставить("description", "Optional search filters. Use plain values only. Do not use nested operators, % wildcards, regex, or $like.");
			elementParameters.filters.Вставить("required"	, "false");
			elementParameters.filters.Вставить("properties"	, Новый Соответствие);

			Для каждого ТекФильтр Из Выборка.Фильтры Цикл

				decFilter = Новый Структура;
				decFilter.Вставить("description"	, ТекФильтр.Описание);
				decFilter.Вставить("type"			, ТекФильтр.Тип);

				elementParameters.filters.properties.Вставить(ТекФильтр.Название, decFilter);

			КонецЦикла;

		КонецЕсли;

		newElement.Вставить("parameters", elementParameters);

		ДанныеДляПередачи.tools.Добавить(newElement);

	КонецЦикла;

	СтрJSON = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеДляПередачи);

	Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ("listToolsPost: ", СтрJSON);

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json");
	Ответ.Причина = "success";
	Ответ.УстановитьТелоИзСтроки((СтрJSON));

	Возврат Ответ;

КонецФункции

Функция ЭтоЗапросПроверкиПодключенияИИ(ЗапросСтрокой)

	НормализованныйЗапрос = НРег(ЗапросСтрокой);

	Возврат СтрНайти(НормализованныйЗапрос, "initialize") > 0
		И СтрНайти(НормализованныйЗапрос, "jsonrpc") > 0;

КонецФункции

Функция ОтветПроверкиПодключенияИИ(ЗапросСтрокой)

	ИдЗапроса 		= "initialize";
	ПротоколВерсия 	= "2025-11-25";

	Попытка

		ДанныеЗапроса = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(ЗапросСтрокой, Истина);
		Если ТипЗнч(ДанныеЗапроса) = Тип("Соответствие") Тогда

			Если ДанныеЗапроса.Получить("id") <> Неопределено Тогда
				ИдЗапроса = ДанныеЗапроса.Получить("id");
			КонецЕсли;

			Параметры = ДанныеЗапроса.Получить("params");
			Если ТипЗнч(Параметры) = Тип("Соответствие")
				И Параметры.Получить("protocolVersion") <> Неопределено Тогда
				ПротоколВерсия = Параметры.Получить("protocolVersion");
			КонецЕсли;

		КонецЕсли;

	Исключение
	КонецПопытки;

	РезультатInitialize = Новый Структура;
	РезультатInitialize.Вставить("protocolVersion", ПротоколВерсия);

	Капабилитис = Новый Структура;
	Капабилитис.Вставить("tools", Новый Структура);
	РезультатInitialize.Вставить("capabilities", Капабилитис);

	ИнформацияОСервере = Новый Структура;
	ИнформацияОСервере.Вставить("name"		, "1С: Битрикс24 ИИ");
	ИнформацияОСервере.Вставить("version"	, Б24_К_ОбщегоНазначенияВызовСервера.Версия());
	РезультатInitialize.Вставить("serverInfo", ИнформацияОСервере);

	РезультатОтвета = Новый Структура;
	РезультатОтвета.Вставить("jsonrpc"	, "2.0");
	РезультатОтвета.Вставить("id"		, ИдЗапроса);
	РезультатОтвета.Вставить("result"	, РезультатInitialize);

	СтрJSON = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(РезультатОтвета);
	Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ("Проверка подключения ИИ: ", СтрJSON);

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json");
	Ответ.Причина = "success";
	Ответ.УстановитьТелоИзСтроки(СтрJSON);

	Возврат Ответ;

КонецФункции

Функция listToolsTest(Запрос)  
	
	Возврат ПолучитьHTTPСервисОтвет("success");
	
КонецФункции

Функция getDataTest(Запрос)
	
	Возврат ПолучитьHTTPСервисОтвет("success");
	
КонецФункции

Функция getDataPost(Запрос)
	
	РезультатВыполнения = "success";
	
	ДанныеДляОтвета = Новый Структура;
	ДанныеДляОтвета.Вставить("data"		, Новый Массив);
	ДанныеДляОтвета.Вставить("errors"	, Новый Массив); 
	
	ИИ_ЛимитПередачи = Константы.Б24_ИИ_ЛимитПередачи.Получить();
	
	ЗапросСтрокой = Запрос.ПолучитьТелоКакСтроку();	
			
	Попытка     
		
		СтрокаПараметров = Б24_К_RestApiВызовСервера.РаскодироватьСтрокуСервер(ЗапросСтрокой);	
		ДанныеJSON = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(СтрокаПараметров, Истина);			
		ДанныеДляЛога = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеJSON);
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ("getDataPost запрос от ИИ", ДанныеДляЛога);
		
		tool 		= ДанныеJSON.Получить("tool");
		columns 	= ДанныеJSON.Получить("columns");
		filters 	= ДанныеJSON.Получить("filters"); 
				
		Если ТипЗнч(filters) = Тип("Соответствие") Тогда
			Новfilters = Новый Соответствие;
			Для Каждого Фильтр из filters Цикл
				Новfilters.Вставить(нРег(Фильтр.Ключ), Фильтр.Значение);
			КонецЦикла;
			filters = Новfilters;
		КонецЕсли;		
				
		НайденныйИнструмент = Справочники.Б24_ИИ_ИнструментыИИ.НайтиПоНаименованию(tool, Истина);
		Если НЕ ЗначениеЗаполнено(НайденныйИнструмент) Тогда
			НайденныйИнструмент = Справочники.Б24_ИИ_ИнструментыИИ.НайтиПоРеквизиту("ПолноеНаименование",tool);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НайденныйИнструмент) Тогда			
			ДанныеДляОтвета.data.Добавить("Не найден инструмент в 1С. Был произведен поиск по:" + tool);
			РезультатВыполнения = "failure";
		КонецЕсли;
				
		Если РезультатВыполнения = "success" Тогда	
			
			Запрос = Новый Запрос;
			Запрос.Текст = НайденныйИнструмент.ТекстЗапроса;			
			
			Для каждого ТекФильтр Из НайденныйИнструмент.Фильтры Цикл
				
				Если filters = Неопределено или (ТипЗнч(filters) = Тип("Массив") и filters.Количество()=0) Тогда					
					Если ТекФильтр.Имя = "Период" или нРег(ТекФильтр.Имя) = "date" Тогда
						Запрос.УстановитьПараметр(ТекФильтр.Имя, ТекущаяДата());
					Иначе
						Запрос.УстановитьПараметр(ТекФильтр.Имя, "B24_NoFilterSpecified");
					КонецЕсли; 
					Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ("filters: ", "B24_NoFilterSpecified" + ТекФильтр.Имя);					
				Иначе					
					НайденноеЗначениеФильтра = filters.Получить(ТекФильтр.Название);
					Если НайденноеЗначениеФильтра = Неопределено Тогда        
						Если ТекФильтр.Имя = "Период" или нРег(ТекФильтр.Имя) = "date" Тогда
							Запрос.УстановитьПараметр(ТекФильтр.Имя, ТекущаяДата());
						Иначе
							Запрос.УстановитьПараметр(ТекФильтр.Имя, "B24_NoFilterSpecified");
						КонецЕсли;
						Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ("filters: ", "B24_NoFilterSpecified" + ТекФильтр.Имя + " " + ТекФильтр.Название);						
					Иначе
						
						Попытка							
							Если ТекФильтр.Тип = "number" тогда
								Если ТипЗнч(НайденноеЗначениеФильтра) = Тип("Число") Тогда
									ЗначениеФильтра = НайденноеЗначениеФильтра;
								Иначе
									ЗначениеФильтра	= XMLЗначение(Тип("Число"), НайденноеЗначениеФильтра);
								КонецЕсли;
							ИначеЕсли ТекФильтр.Тип = "boolean" тогда 
								ЗначениеФильтра	= XMLЗначение(Тип("Булево"), НайденноеЗначениеФильтра);
							ИначеЕсли ТекФильтр.Тип = "date" тогда 
								ЗначениеФильтра = СтроковыеФункцииКлиентСервер.СтрокаВДату(НайденноеЗначениеФильтра);								
							Иначе      
								Если ТекФильтр.УсловиеСодержит Тогда
									ЗначениеФильтра	= XMLЗначение(Тип("Строка"), "%" + НайденноеЗначениеФильтра + "%");									
								ИначеЕсли ТекФильтр.Имя = "Период"  или нРег(ТекФильтр.Имя) = "date" Тогда
									ЗначениеФильтра = СтроковыеФункцииКлиентСервер.СтрокаВДату(НайденноеЗначениеФильтра);
								ИначеЕсли СтрНайти(ТекФильтр.Имя, "Количество") Тогда
									ЗначениеФильтра = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(НайденноеЗначениеФильтра);									
								Иначе
									ЗначениеФильтра	= XMLЗначение(Тип("Строка"), НайденноеЗначениеФильтра);
								КонецЕсли;
							КонецЕсли;
							
						Исключение   
							РезультатВыполнения = "failure";
						КонецПопытки;
						
						Запрос.УстановитьПараметр(ТекФильтр.Имя, ЗначениеФильтра);  
						
					КонецЕсли;    
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Если РезультатВыполнения = "success" Тогда	
				
				тзнДанных = Запрос.Выполнить().Выгрузить();   
				
				КолонкиГруппировки 	= "";
				КолонкиСуммы 		= "";
				
				мИспКолонки = Новый Массив;
				Если columns = Неопределено или columns = "*" Тогда
					
				Иначе
					СписокКолонок = "";
					Для каждого ТекКолонкаИИ Из columns Цикл 
						СписокКолонок = СписокКолонок + ТекКолонкаИИ + ";" + Символы.ПС;						
					КонецЦикла;					
				КонецЕсли;
				Для каждого ТекКолонка Из НайденныйИнструмент.Колонки Цикл
					
					ИспКолонка = Истина;	
					Если columns <> Неопределено Тогда					
						ИспКолонка = Ложь;
						Если columns = "*" Тогда
							ИспКолонка = Истина;
						Иначе
							Для каждого ТекКолонкаИИ Из columns Цикл 
								Если ТекКолонка.Название = ТекКолонкаИИ или ТекКолонкаИИ = "*" Тогда
									ИспКолонка = Истина;									
								КонецЕсли;								
							КонецЦикла; 
						КонецЕсли;						
					КонецЕсли;        
					
					Если ИспКолонка Тогда    
						мИспКолонки.Добавить(Новый Структура("Имя, Тип", ТекКолонка.Имя, ТекКолонка.Тип));
						Если ТекКолонка.Тип = "number" Тогда   
							КолонкиСуммы = КолонкиСуммы + ?(КолонкиСуммы = "", ТекКолонка.Имя, "," + ТекКолонка.Имя);
						Иначе  
							КолонкиГруппировки = КолонкиГруппировки + ?(КолонкиГруппировки = "", ТекКолонка.Имя, "," + ТекКолонка.Имя);
						КонецЕсли;  
					КонецЕсли;
					
				КонецЦикла;
			
				Если КолонкиГруппировки = "" И КолонкиСуммы = "" Тогда					
					ДанныеДляОтвета.data.Добавить("Не выбрано колонок в инструменте:" + tool);
					РезультатВыполнения = "failure";
				Иначе
					
					Если КолонкиГруппировки = "" Тогда 
						КолонкиГруппировки = КолонкиСуммы;
						КолонкиСуммы = "";
					КонецЕсли;
					
					тзнДанных.Свернуть(КолонкиГруппировки, КолонкиСуммы);
					НомерСтроки = 1;
					Для каждого ТекСтрока Из тзнДанных Цикл
						
						ОписаниеЭлемента = Новый Структура;  
					
						Для каждого ТекКолонка Из мИспКолонки Цикл                              
							Если ТекКолонка.Тип = "string" Тогда
								ОписаниеЭлемента.Вставить(ТекКолонка.Имя, Строка(ТекСтрока[ТекКолонка.Имя])); 
							Иначе
								ОписаниеЭлемента.Вставить(ТекКолонка.Имя, XMLСтрока(ТекСтрока[ТекКолонка.Имя])); 
							КонецЕсли;
						КонецЦикла;
					
						ДанныеДляОтвета.data.Добавить(ОписаниеЭлемента); 
													
						НомерСтроки = НомерСтроки + 1;						
						Если НомерСтроки > ИИ_ЛимитПередачи Тогда
							Прервать;	
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;     
				
			КонецЕсли;     
			
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = ИнформацияОбОшибке().Описание;		
		ДанныеДляОтвета.data.Добавить("Выполнение инструмента в 1С было завершено с ошибкой: " + ТекстОшибки);
		РезультатВыполнения = "success";
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ("getDataPost ответ 1С failure: ", ТекстОшибки);
		
	КонецПопытки;
	РезультатВыполнения = "success";
	СтрJSON = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеДляОтвета);
	Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛогИИ("getDataPost ответ 1С: ", СтрJSON);
		
	Ответ = Новый HTTPСервисОтвет(200);  
	Ответ.Заголовки.Вставить("Content-Type", "application/json");
	Ответ.Причина = РезультатВыполнения;
	Ответ.УстановитьТелоИзСтроки((СтрJSON));
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьHTTPСервисОтвет(пЗначение)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Причина = пЗначение;
	Ответ.УстановитьТелоИзСтроки(пЗначение);
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьНастройкуПодключения(ИдентификаторИсточника, Портал)
	
	Результат = Справочники.Б24_К_НастройкиПодключения.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторИсточника", ИдентификаторИсточника);
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_НастройкиПодключения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|ГДЕ
	|	Б24_К_НастройкиПодключения.ИдентификаторПодключения = &ИдентификаторИсточника
	|	И Б24_К_НастройкиПодключения.Портал = &Портал
	|	И Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если Не ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
