
Функция pushPost(Запрос)
	
	ЗапросСтрокой = Запрос.ПолучитьТелоКакСтроку();
	
	Попытка 
	
		СтрокаПараметров = Б24_К_RestApiВызовСервера.РаскодироватьСтрокуСервер(ЗапросСтрокой);
		ДанныеJSON = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(СтрокаПараметров, Истина);
				
		connector_id 	= ДанныеJSON.Получить("idAdress");
		connector_id 	= СтрЗаменить(connector_id,"_SP","");
		connector_id 	= Формат(connector_id, "ЧГ=0");
		portal 			= ДанныеJSON.Получить("B24");
		
		Если СтрНайти(connector_id, Б24_СМ_ОбщегоНазначенияВызовСервера.ПолучитьПостфиксИдКоннектора()) Тогда
			connector_id = Лев(connector_id, СтрДлина(connector_id)-3);    
		КонецЕсли;
		
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СкладскойУчет") Тогда
			Модуль_СУ_ОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ОбщегоНазначенияВызовСервера");
			Если СтрНайти(connector_id, Модуль_СУ_ОбщегоНазначенияВызовСервера.ПолучитьПостфиксИдКоннектора()) Тогда
				connector_id = Лев(connector_id, СтрДлина(connector_id)-5);    
			КонецЕсли;
		КонецЕсли;
		
		// Коннектор КЭДО: <ИдентификаторПодключения>_HR
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО") Тогда
			Модуль_КЭДО_ОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОбменВызовСервера");
			Если Модуль_КЭДО_ОбщегоНазначенияВызовСервера <> Неопределено И СтрНайти(connector_id, Модуль_КЭДО_ОбщегоНазначенияВызовСервера.ПолучитьПостфиксИдКоннектора()) Тогда
				connector_id = Лев(connector_id, СтрДлина(connector_id)-3);
			КонецЕсли;
		КонецЕсли;

		НастройкаПодключения = ПолучитьНастройкуПодключения(connector_id, portal);                                                              
		Если ЗначениеЗаполнено(НастройкаПодключения) Тогда  
			
			Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
				НастройкаСинхронизации = РегистрыСведений["Б24_КС_НастройкиСинхронизации"].ПолучитьНастройкуСинхронизацииПоНастройкеПодключения(НастройкаПодключения);
				Если НастройкаСинхронизации.ВРежимеРеальногоВремени Тогда
					
					Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) Тогда
						
						ИмяРасписания = "Импорт данных из Битрикс24" + " (" + portal + ")";
						Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.СейчасВыполняетсяЗадание(ИмяРасписания) Тогда
							
							ПараметрыЗапроса = Новый Структура;
							ПараметрыЗапроса.Вставить("НастройкаПодключения", НастройкаПодключения);
							
							Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_КС_ОбщегоНазначенияВызовСервера.ЗапуститьВыполнениеЗагрузкиВФоне", ИмяРасписания, ПараметрыЗапроса, 3, Истина);								
							
							Б24_К_ОбщегоНазначенияВызовСервера.Таймаут(2);    //чтобы успело запуститься фоновое задание
							
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
			НастройкаСинхронизации = РегистрыСведений.Б24_СМ_НастройкиСмартПроцессов.ПолучитьНастройкуСинхронизацииПоНастройкеПодключения(НастройкаПодключения);
			Если НастройкаСинхронизации.ВРежимеРеальногоВремени Тогда
				
				Если Б24_К_СлужебныйВызовСервера.МодульСмартПроцессовДоступен(НастройкаПодключения) Тогда           
					
					ИмяРасписания = "Импорт данных СП из Битрикс24" + " (" + portal + ")";
					Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.СейчасВыполняетсяЗадание(ИмяРасписания) Тогда
						
						ПараметрыЗапроса = Новый Структура;
						ПараметрыЗапроса.Вставить("НастройкаПодключения", НастройкаПодключения);
						
						Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_СМ_ОбщегоНазначенияВызовСервера.ЗапуститьВыполнениеЗагрузкиВФоне", ИмяРасписания, ПараметрыЗапроса, 3, Истина);								
						
						Б24_К_ОбщегоНазначенияВызовСервера.Таймаут(2);    //чтобы успело запуститься фоновое задание
						
					КонецЕсли;   
					
				КонецЕсли; 				
				
			КонецЕсли;
			
			Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СкладскойУчет") Тогда
				Модуль_СУ_ОбщегоНазначенияВызовСервераПовтИсп = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ОбщегоНазначенияВызовСервераПовтИсп");
				Модуль_СУ_ОбщегоНазначенияВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ОбщегоНазначенияВызовСервера");
				Если Модуль_СУ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗначениеНастройкиПоНастройкеПодключения(НастройкаПодключения, "РезервироватьТовары", "НастройкииЗаказов") = Истина
					ИЛИ Модуль_СУ_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьЗначениеНастройкиПоНастройкеПодключения(НастройкаПодключения, "ОтгружатьТовары", "НастройкииЗаказов") = Истина Тогда
					
					Если Б24_К_СлужебныйВызовСервера.МодульСкладскойУчетДоступен(НастройкаПодключения) Тогда
						
						ИмяРасписания = "Резервирование/отгрузка из Битрикс24" + " (" + portal + ")";
						Если НЕ Б24_К_ОбщегоНазначенияВызовСервера.СейчасВыполняетсяЗадание(ИмяРасписания) Тогда
							
							ПараметрыЗапроса = Модуль_СУ_ОбщегоНазначенияВызовСервера.ПараметрыВыполненияОбменаВФоне(НастройкаПодключения, Новый Массив, Ложь, Истина);
							Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_СУ_ОбщегоНазначенияВызовСервера.ВыполнитьОбменВФоне", ИмяРасписания, ПараметрыЗапроса, 3, Истина);								
							
							Б24_К_ОбщегоНазначенияВызовСервера.Таймаут(2);    
							
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		// Роутинг остальных команд как в Push&Pull
		command = ДанныеJSON.Получить("command");
		Если ЗначениеЗаполнено(command) Тогда
			Если command = "onOfflineEvent" Тогда
				НастройкиКЭДО = Неопределено;
				Если Метаданные.ОбщиеМодули.Найти("Б24_УП_ОбменВызовСервераПовтИсп") <> Неопределено Тогда
					МодульОбменВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОбменВызовСервераПовтИсп");
					НастройкиКЭДО = МодульОбменВызовСервера.НастройкиКЭДОПоНастройкеПодключения(НастройкаПодключения);
				КонецЕсли;
				Если НастройкиКЭДО <> Неопределено И НастройкиКЭДО.ВРежимеРеальногоВремени Тогда
					Если Б24_К_СлужебныйВызовСервера.МодульКЭДОДоступен(НастройкаПодключения) Тогда
						ИмяРасписания = "Обработка событий Битрикс24 " + Строка(НастройкаПодключения);
						ПараметрыЗапроса = Новый Структура;
						ПараметрыЗапроса.Вставить("НастройкаПодключения", НастройкаПодключения);
						Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_УП_ОбменВызовСервера.ЗапускОбработкиСобытийВФоне", ИмяРасписания, ПараметрыЗапроса, 3, Истина);
						Б24_К_ОбщегоНазначенияВызовСервера.Таймаут(2);
					КонецЕсли;
				КонецЕсли;
			Иначе
				СтруктураНастроек = Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);
				Если СтруктураНастроек <> Неопределено Тогда
					Б24_К_ЛонгПуллингКлиентСервер.ОбработатьСообщениеСПортала(СтруктураНастроек, НастройкаПодключения, command, ДанныеJSON, ДанныеJSON);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		
	КонецПопытки;
	
	Ответ = ПолучитьHTTPСервисОтвет("success");
	
	Возврат Ответ;
	
КонецФункции

Функция pushTest(Запрос)  
	
	Возврат ПолучитьHTTPСервисОтвет("success");
	
КонецФункции


Функция searchProductTest(Запрос)
	
	Возврат ПолучитьHTTPСервисОтвет("success");
	
КонецФункции
   
Функция searchProductPost(Запрос)
	
	Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
		Возврат ПолучитьHTTPСервисОтвет("failure");	
	КонецЕсли;
	
	ЗапросСтрокой = Запрос.ПолучитьТелоКакСтроку();
	
	Попытка 
	
		СтрокаПараметров = Б24_К_RestApiВызовСервера.РаскодироватьСтрокуСервер(ЗапросСтрокой);
		ДанныеJSON = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(СтрокаПараметров, Истина);
	
		module_id 	= ДанныеJSON.Получить("module_id");
		command 	= ДанныеJSON.Получить("command");
		idAdress 	= Формат(ДанныеJSON.Получить("idAdress"));
		portal 		= ДанныеJSON.Получить("B24");
		searchString 		= ДанныеJSON.Получить("searchString");
		idSearchString 		= ДанныеJSON.Получить("idSearchString");
		
		Б24_К_RestApiВызовСервера.РаскодироватьJSON(ДанныеJSON);
		
		НастройкаПодключения = ПолучитьНастройкуПодключения(idAdress, portal);
		Если ЗначениеЗаполнено(НастройкаПодключения) Тогда
			
			Модуль_СУ_ПодборНоменклатурыСервер = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_СУ_ПодборНоменклатурыСервер");
			
			Если command = "productSearch" Тогда	
				
				ДанныеДляПередачи = Модуль_СУ_ПодборНоменклатурыСервер.ПолучитьДанныеПоСтрокеПоиска(НастройкаПодключения, searchString);
				
				СтрJSON = Б24_К_ОбщегоНазначенияВызовСервера.ДанныеВСтрокуJSON(ДанныеДляПередачи);
				
				Ответ = Новый HTTPСервисОтвет(200);  
				Ответ.Заголовки.Вставить("Content-Type", "application/json");
				Ответ.Причина = "success";
				Ответ.УстановитьТелоИзСтроки((СтрJSON));
				Возврат Ответ;
				
			ИначеЕсли command = "uploadProduct" Тогда	
				
				ИдВариации = Модуль_СУ_ПодборНоменклатурыСервер.ВыгрузитьДанныеТовара(НастройкаПодключения, idSearchString);
				
				Ответ = Новый HTTPСервисОтвет(200);
				Ответ.Причина = "success";
				Ответ.УстановитьТелоИзСтроки(Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИдВариации));
				Возврат Ответ;
				
			ИначеЕсли command = "updateProduct" Тогда	
				
				НайденныеДанные = РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьЗначениеПоИдБ24Объекта(portal, Перечисления.Б24_К_ТипыДанныхДляОбменаСПорталом.Предложение, Формат(idSearchString, "ЧГ=0"));
				Если НайденныеДанные = Неопределено Тогда
					Ответ = Новый HTTPСервисОтвет(200);
					Ответ.Причина = "failure";
					Ответ.УстановитьТелоИзСтроки("failure: Product not found");
					Возврат Ответ;
				Иначе     
					
					Модуль_СУ_ПодборНоменклатурыСервер.ВыгрузитьДанныеТовара(НастройкаПодключения, Неопределено, НайденныеДанные.Объект, НайденныеДанные.ПодчиненныйОбъект);
					
					Ответ = Новый HTTPСервисОтвет(200);
					Ответ.Причина = "success";
					Ответ.УстановитьТелоИзСтроки(Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("success"));
					Возврат Ответ;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		
	КонецПопытки;
	
	Возврат ПолучитьHTTPСервисОтвет("failure");
	
КонецФункции


Функция ПолучитьHTTPСервисОтвет(пЗначение)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Причина = пЗначение;
	Ответ.УстановитьТелоИзСтроки(пЗначение);
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьНастройкуПодключения(ИдентификаторИсточника, Портал)
	
	Результат = Справочники.Б24_К_НастройкиПодключения.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторИсточника", ИдентификаторИсточника);
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_НастройкиПодключения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|ГДЕ
	|	Б24_К_НастройкиПодключения.ИдентификаторПодключения = &ИдентификаторИсточника
	|	И Б24_К_НастройкиПодключения.Портал = &Портал
	|	И Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если Не ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
