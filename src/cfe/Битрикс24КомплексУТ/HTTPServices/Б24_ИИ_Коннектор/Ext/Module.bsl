Функция getDataPost(Запрос) Экспорт

	// ВыполнитьGetData принимает HTTP-запрос и возвращает готовый HTTP-ответ.
	Возврат Б24_ИИ_ИнтеграцияСервер.ВыполнитьGetData(Запрос);

КонецФункции

// GET /api/onec-module/v1/settings - получить конфигурацию.
Функция settingsGet(Запрос) Экспорт

	Конверт = Новый Соответствие;
	Конверт.Вставить("success", Истина);
	Конверт.Вставить("data", ПолучитьКонфигурациюНастроек());
	Возврат ОтветJSON(Конверт);

КонецФункции

// PUT /api/onec-module/v1/settings - создать или полностью заменить конфигурацию.
Функция settingsPut(Запрос) Экспорт

	Параметры = ПрочитатьПараметрыЗапроса(Запрос);
	Если Параметры = Неопределено Тогда
		Возврат ОшибкаJSON(400, "Некорректное JSON-тело запроса");
	КонецЕсли;

	Результат = ЗаписатьКонфигурациюНастроек(Параметры, Истина);
	Если НЕ Результат.Успех Тогда
		Возврат ОшибкаJSON(400, Результат.Сообщение);
	КонецЕсли;

	Конверт = Новый Соответствие;
	Конверт.Вставить("success", Истина);
	Конверт.Вставить("data", ПолучитьКонфигурациюНастроек());
	Возврат ОтветJSON(Конверт);

КонецФункции

// PATCH /api/onec-module/v1/settings - частично обновить конфигурацию.
Функция settingsPatch(Запрос) Экспорт

	Параметры = ПрочитатьПараметрыЗапроса(Запрос);
	Если Параметры = Неопределено Тогда
		Возврат ОшибкаJSON(400, "Некорректное JSON-тело запроса");
	КонецЕсли;

	Результат = ЗаписатьКонфигурациюНастроек(Параметры, Ложь);
	Если НЕ Результат.Успех Тогда
		Возврат ОшибкаJSON(400, Результат.Сообщение);
	КонецЕсли;

	Конверт = Новый Соответствие;
	Конверт.Вставить("success", Истина);
	Конверт.Вставить("data", ПолучитьКонфигурациюНастроек());
	Возврат ОтветJSON(Конверт);

КонецФункции

// DELETE /api/onec-module/v1/settings - удалить конфигурацию.
Функция settingsDelete(Запрос) Экспорт

	Настройка = НайтиАктивнуюНастройку();
	Если Настройка = Неопределено Тогда
		Возврат ОтветJSON(Новый Соответствие);
	КонецЕсли;

	Объект = Настройка.ПолучитьОбъект();
	Объект.Использование = Ложь;
	Объект.Записать();

	Конверт = Новый Соответствие;
	Конверт.Вставить("success", Истина);
	Конверт.Вставить("data", Новый Соответствие);
	Возврат ОтветJSON(Конверт);

КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Формирует HTTP-ответ с JSON-телом конверта (200).
Функция ОтветJSON(Конверт) Экспорт

	Если ТипЗнч(Конверт) <> Тип("Соответствие") Тогда
		Конверт = Новый Соответствие;
		Конверт.Вставить("success", Ложь);
		Конверт.Вставить("error", Новый Соответствие);
	КонецЕсли;

	СтрJSON = Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(Конверт);

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Причина = "success";
	Ответ.УстановитьТелоИзСтроки(СтрJSON);

	Возврат Ответ;

КонецФункции

// Возвращает конфигурацию настроек активной (или единственной) записи справочника.
Функция ПолучитьКонфигурациюНастроек() Экспорт

	Результат = Новый Соответствие;

	Настройка = НайтиАктивнуюНастройку();
	Если Настройка = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Вставить("address", Б24_ИИ_ИнтеграцияСервер.БазовыйURLИнтеграции(Настройка));
	Результат.Вставить("mode", СокрЛП(Настройка.Режим));
	Результат.Вставить("baseName", СокрЛП(Настройка.Наименование));
	Результат.Вставить("enabled", Настройка.Использование);
	Результат.Вставить("status", Б24_ИИ_ИнтеграцияСервер.ПолучитьСтатусНастройки(Настройка));
	Результат.Вставить("publicationUser", СокрЛП(Настройка.ПользовательПубликации));
	Результат.Вставить("publicationAddress", СокрЛП(Настройка.АдресПубликации));
	Если ЗначениеЗаполнено(Настройка.ДатаПоследнегоКонтакта) Тогда
		Результат.Вставить("lastContact",
			Строка(Формат(Настройка.ДатаПоследнегоКонтакта, "ДФ='yyyy-MM-dd'T'HH:mm:ss'")));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Записывает конфигурацию настроек в справочник.
// ПолнаяЗамена=Истина (PUT): новую активную запись вместо прежней.
// ПолнаяЗамена=Ложь (PATCH): частично обновляет активную запись.
Функция ЗаписатьКонфигурациюНастроек(Параметры, ПолнаяЗамена) Экспорт

	Результат = Новый Структура("Успех, Сообщение", Истина, "");

	Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		Результат.Успех = Ложь;
		Результат.Сообщение = "Ожидается JSON-объект";
		Возврат Результат;
	КонецЕсли;

	Если ПолнаяЗамена Тогда
		// Деактивируем прежнюю активную запись и создаём новую.
		Прежняя = НайтиАктивнуюНастройку();
		Если НЕ Прежняя = Неопределено Тогда
			ОбъектПрежней = Прежняя.ПолучитьОбъект();
			ОбъектПрежней.Использование = Ложь;
			ОбъектПрежней.Записать();
		КонецЕсли;

		Объект = Справочники.Б24_ИИ_НастройкиVibeCode.СоздатьЭлемент();
		Объект.Наименование = Строка(ЗначениеПоУсловию(Параметры.Свойство("baseName"),
			"Настройка интеграции", Параметры.Получить("baseName")));
		Объект.Использование = Истина;
	Иначе
		Настройка = НайтиАктивнуюНастройку();
		Если Настройка = Неопределено Тогда
			Объект = Справочники.Б24_ИИ_НастройкиVibeCode.СоздатьЭлемент();
			Объект.Наименование = Строка(ЗначениеПоУсловию(Параметры.Свойство("baseName"),
				"Настройка интеграции", Параметры.Получить("baseName")));
			Объект.Использование = Истина;
		Иначе
			Объект = Настройка.ПолучитьОбъект();
		КонецЕсли;
	КонецЕсли;

	// Поле «Адрес интеграции» убрано из настроек: адрес берётся из строки
	// подключения (сохраняется при connect) или из константы в серверном модуле,
	// поэтому приходящий извне "address" в реквизит не записываем.
	Если Параметры.Свойство("mode") Тогда
		Объект.Режим = Строка(Параметры.Получить("mode"));
	КонецЕсли;
	Если Параметры.Свойство("baseName") Тогда
		Объект.Наименование = Строка(Параметры.Получить("baseName"));
	КонецЕсли;
	Если Параметры.Свойство("enabled") Тогда
		Объект.Использование = Булево(Параметры.Получить("enabled"));
	КонецЕсли;
	Если Параметры.Свойство("status") Тогда
		Объект["Статус"] = Строка(Параметры.Получить("status"));
	КонецЕсли;
	Если Параметры.Свойство("lastContact") Тогда
		Объект.ДатаПоследнегоКонтакта = СтрокаВДатуБезопасно(Параметры.Получить("lastContact"));
	КонецЕсли;
	Если Параметры.Свойство("publicationUser") Тогда
		Объект.ПользовательПубликации = Строка(Параметры.Получить("publicationUser"));
	КонецЕсли;
	Если Параметры.Свойство("publicationAddress") Тогда
		Объект.АдресПубликации = Строка(Параметры.Получить("publicationAddress"));
	КонецЕсли;

	Попытка
		Объект.Записать();
	Исключение
		Результат.Успех = Ложь;
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Активная (Использование=Истина, не помечена на удаление) настройка или Неопределено.
Функция НайтиАктивнуюНастройку() Экспорт

	Выборка = Справочники.Б24_ИИ_НастройкиVibeCode.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Использование И НЕ Выборка.ПометкаУдаления Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Читает и разбирает JSON-тело HTTP-запроса. Возвращает Соответствие или Неопределено.
Функция ПрочитатьПараметрыЗапроса(Запрос) Экспорт

	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		Параметры = Б24_ИИ_ИнтеграцияВызовСервера.СтрокаJSONВСоответствие(ТелоЗапроса);
		Возврат Параметры;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Формирует HTTP-ответ ошибки с кодом и сообщением.
Функция ОшибкаJSON(Код, Сообщение) Экспорт

	Конверт = Новый Соответствие;
	Конверт.Вставить("success", Ложь);
	Конверт.Вставить("error", Новый Соответствие);

	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Б24_ИИ_ИнтеграцияВызовСервера.ДанныеВСтрокуJSON(Конверт));
	Возврат Ответ;

КонецФункции

// Безопасно преобразует строку ISO-даты в дату; при неудаче возвращает текущую дату сеанса.
Функция СтрокаВДатуБезопасно(Значение) Экспорт

	Попытка
		Возврат Дата(Строка(Значение));
	Исключение
		Возврат ТекущаяДатаСеанса();
	КонецПопытки;

КонецФункции

// Возвращает ЗначениеЕслиЛожь, если Условие ложно, иначе Выражение.
Функция ЗначениеПоУсловию(Условие, ЗначениеЕслиЛожь, Выражение) Экспорт

	Если Условие Тогда
		Возврат Выражение;
	КонецЕсли;

	Возврат ЗначениеЕслиЛожь;

КонецФункции

#КонецОбласти
