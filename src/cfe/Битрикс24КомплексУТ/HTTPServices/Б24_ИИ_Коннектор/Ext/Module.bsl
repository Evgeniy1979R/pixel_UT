// POST /v1/listUsers - список пользователей 1С {name, guid} для настройки
// разрешённых пользователей VibeCode.
Функция listUsersPost(Запрос) Экспорт

	// Платформа VibeCode может прислать settingsGuid настройки, по которой
	// нужно вернуть пользователей. Если не передан - берётся активная настройка.
	ГуидНастройки = "";
	Параметры = ПрочитатьПараметрыЗапроса(Запрос);
	// ПрочитатьПараметрыЗапроса возвращает Соответствие, у которого нет метода
	// .Свойство (он есть только у Структуры). Работаем через .Получить с проверкой.
	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		ЗначениеНастройки = Параметры.Получить("settingsGuid");
		Если НЕ ЗначениеНастройки = Неопределено Тогда
			ГуидНастройки = СокрЛП(Строка(ЗначениеНастройки));
		КонецЕсли;
	КонецЕсли;

	Конверт = Б24_ИИ_ИнтеграцияСервер.ВыполнитьListUsers(ГуидНастройки);
	Возврат ОтветJSON(Конверт);

КонецФункции

