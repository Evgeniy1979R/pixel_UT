Функция putPinPost(Запрос)

	ЗапросСтрокой = Запрос.ПолучитьТелоКакСтроку();

	Попытка

		УстановитьПривилегированныйРежим(Истина);

		СтрокаПараметров = Б24_К_RestApiВызовСервера.РаскодироватьСтрокуСервер(ЗапросСтрокой);
		ДанныеJSON = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(СтрокаПараметров, Истина);

		ИдентификаторПодключения= Формат(ДанныеJSON.Получить("idAdress"), "ЧГ=0");
		Портал 					= ДанныеJSON.Получить("portal");
		ИдКомпании 				= Формат(ДанныеJSON.Получить("idCompany"), "ЧГ=0");
		ИдентификаторСотрудника	= Формат(ДанныеJSON.Получить("idEmployee"), "ЧГ=0");
		Идентификатор1СФизЛица	= Формат(ДанныеJSON.Получить("id1cEmployee"), "ЧГ=0");
		Пинкод 					= ДанныеJSON.Получить("pincode");
		ВидОперации 			= ДанныеJSON.Получить("type");
		ФорматФайла 			= ДанныеJSON.Получить("format");

		Если ВидОперации = "vacation" Тогда
			ДатаДанных	= НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
		Иначе
			ДатаДанных	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(Тип("Дата"), ДанныеJSON.Получить("date"));
		КонецЕсли;

		ТипыСообщений = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыСообщений();

		МодульОтчетыВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОтчетыВызовСервера");
		Если МодульОтчетыВызовСервера = Неопределено Тогда
			Возврат ПолучитьHTTPСервисОтветПинКода("1", Истина);
		КонецЕсли;
		СообщенияПоКодамОшибок = МодульОтчетыВызовСервера.СообщенияПоКодамОшибок();

		НастройкаПодключения = ПолучитьНастройкуПодключения(ИдентификаторПодключения, Портал);
		Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
			Возврат ПолучитьHTTPСервисОтветПинКода("1", Истина);
		КонецЕсли;

		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО") Тогда
			МодульПовторногоИспользования = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОбменВызовСервераПовтИсп");
			Если МодульПовторногоИспользования <> Неопределено И МодульПовторногоИспользования.ИспользоватьОбменСобытиямиДляРасчетныхЛистков(НастройкаПодключения) Тогда
				МодульОтчетыВызовСервера.ДобавитьВЛог(НастройкаПодключения, ТипыСообщений.Ошибка, "Запрос расчётного листка отклонён: выдача расчётных листков переключена на обмен событиями. Ид:"+ИдентификаторСотрудника);
				Возврат ПолучитьHTTPСервисОтветПинКода("10", Истина);
			КонецЕсли;
		КонецЕсли;

		РезультатПроверкиПинКода = МодульОтчетыВызовСервера.ПроверитьПинКод(НастройкаПодключения, ВидОперации, ИдентификаторПодключения, ИдентификаторСотрудника, Пинкод);
		Если РезультатПроверкиПинКода.АвторизацияПройдена Тогда
			МодульОтчетыВызовСервера.ДобавитьВЛог(НастройкаПодключения, ТипыСообщений.Информация, "ПИН-код. Ид:"+ИдентификаторСотрудника);
		Иначе
			МодульОтчетыВызовСервера.ДобавитьВЛог(НастройкаПодключения, ТипыСообщений.Ошибка, СообщенияПоКодамОшибок.Получить(РезультатПроверкиПинКода.ОписаниеОшибки) +" Ид:"+ИдентификаторСотрудника);
			Возврат ПолучитьHTTPСервисОтветПинКода(РезультатПроверкиПинКода.ОписаниеОшибки, Истина);
		КонецЕсли;

		ПроверкаДанных = МодульОтчетыВызовСервера.ПроверитьНаличиеСотрудниковПоИд(НастройкаПодключения, Портал, ИдКомпании, Идентификатор1СФизЛица, ДатаДанных);
		Если ЗначениеЗаполнено(ПроверкаДанных.ОписаниеОшибки) Тогда
			МодульОтчетыВызовСервера.ДобавитьВЛог(НастройкаПодключения, ТипыСообщений.Ошибка, СообщенияПоКодамОшибок.Получить(ПроверкаДанных.ОписаниеОшибки)+". Ид:"+ИдентификаторСотрудника);
			Возврат ПолучитьHTTPСервисОтветПинКода(ПроверкаДанных.ОписаниеОшибки, Истина);
		КонецЕсли;

		ДанныеСотрудников = МодульОтчетыВызовСервера.РасчетныеЛисткиОстаткиОтпускаСотрудника(ДатаДанных, ПроверкаДанных.СотрудникиФизическихЛиц, ВидОперации = "money", ФорматФайла);
		Если ЗначениеЗаполнено(ДанныеСотрудников.ОписаниеОшибки) Тогда
			МодульОтчетыВызовСервера.ДобавитьВЛог(НастройкаПодключения, ТипыСообщений.Ошибка, СообщенияПоКодамОшибок.Получить(ДанныеСотрудников.ОписаниеОшибки)+". Ид:"+ИдентификаторСотрудника);
			Возврат ПолучитьHTTPСервисОтветПинКода(ДанныеСотрудников.ОписаниеОшибки, Истина);
		КонецЕсли;

		// Фактический формат файла сообщаем порталу: при сбое PDF модуль отдает HTML.
		Ответ = ПолучитьHTTPСервисОтветПинКода("", Ложь, ДанныеСотрудников.ИмяВременногоФайла);
		Ответ.Заголовки.Вставить("Format"	, Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ДанныеСотрудников.ФорматФайла));
		Ответ.Заголовки.Вставить("FileName"	, Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ДанныеСотрудников.ИмяФайла));
		
		Возврат Ответ;

	Исключение

		Возврат ПолучитьHTTPСервисОтветПинКода("2", Истина);

	КонецПопытки;

	//@skip-check bsl-legacy-check-method-for-statements-after-return
	Возврат ПолучитьHTTPСервисОтветПинКода("2", Истина);

КонецФункции

#КонецОбласти

#Область Прочее

Функция ПолучитьHTTPСервисОтветПинКода(Сообщение, ЭтоОшибка = Ложь, ИмяВременногоФайла = "")

	Если ЭтоОшибка Тогда

		МодульОтчетыВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОтчетыВызовСервера");
		Если МодульОтчетыВызовСервера = Неопределено Тогда
			Возврат ПолучитьHTTPСервисОтветПинКода("1", Истина);
		КонецЕсли;
		СообщенияПоКодамОшибок = МодульОтчетыВызовСервера.СообщенияПоКодамОшибок();
		ТекстСообщения = СообщенияПоКодамОшибок.Получить(Сообщение);
		Если НЕ ЗначениеЗаполнено(ТекстСообщения) Тогда ТекстСообщения = Сообщение КонецЕсли;

		КодОшибки = Сообщение;

	Иначе
		ТекстСообщения = Сообщение;
		КодОшибки = "";
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Причина = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекстСообщения);

	Ответ.Заголовки.Вставить("ErrorCode"	, Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КодОшибки));
	Ответ.Заголовки.Вставить("Description"	, Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекстСообщения));

	Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
		Ответ.УстановитьИмяФайлаТела(ИмяВременногоФайла);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

Функция ПолучитьHTTPСервисОтвет(пЗначение)

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(пЗначение);

	Возврат Ответ;

КонецФункции

Функция ПолучитьНастройкуПодключения(ИдентификаторИсточника, Портал)

	Результат = Справочники.Б24_К_НастройкиПодключения.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторИсточника", ИдентификаторИсточника);
	Запрос.УстановитьПараметр("Портал", Портал);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_НастройкиПодключения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|ГДЕ
	|	Б24_К_НастройкиПодключения.ИдентификаторПодключения = &ИдентификаторИсточника
	|	И Б24_К_НастройкиПодключения.Портал = &Портал
	|	И Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	ВыполненныйЗапрос = Запрос.Выполнить();

	Если Не ВыполненныйЗапрос.Пустой() Тогда

		Выборка = ВыполненныйЗапрос.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Ссылка;

	КонецЕсли;

	Возврат Результат;

КонецФункции

