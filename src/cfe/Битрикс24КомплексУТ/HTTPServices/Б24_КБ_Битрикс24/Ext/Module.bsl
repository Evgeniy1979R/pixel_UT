Функция getPinPost(Запрос)

	ЗапросСтрокой = Запрос.ПолучитьТелоКакСтроку();

	Попытка

		УстановитьПривилегированныйРежим(Истина);

		СтрокаПараметров = Б24_К_RestApiВызовСервера.РаскодироватьСтрокуСервер(ЗапросСтрокой);
		ДанныеJSON = Б24_К_RestApiВызовСервера.ПрочитатьJSONНаСервере(СтрокаПараметров, Истина);

		ИдентификаторПодключения= Формат(ДанныеJSON.Получить("idAdress"), "ЧГ=0");
		Портал 					= ДанныеJSON.Получить("portal");
		//ИдКомпании 			= Формат(ДанныеJSON.Получить("idCompany"), "ЧГ=0");
		ИдентификаторСотрудника	= Формат(ДанныеJSON.Получить("idEmployee"), "ЧГ=0");
		ВидОперации 			= ДанныеJSON.Получить("type");

		ТипыСообщений = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыСообщений();

		НастройкаПодключения = ПолучитьНастройкуПодключения(ИдентификаторПодключения, Портал);
		Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
			Возврат ПолучитьHTTPСервисОтветПинКода("1", Истина);
		КонецЕсли;

		МодульОтчетыВызовСервера = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОтчетыВызовСервера");
		Если МодульОтчетыВызовСервера = Неопределено Тогда
			Возврат ПолучитьHTTPСервисОтветПинКода("1", Истина);
		КонецЕсли;
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("Б24_КЭДО") Тогда
			МодульПовторногоИспользования = Б24_К_ОбщегоНазначенияВызовСервера.ОбщийМодуль("Б24_УП_ОбменВызовСервераПовтИсп");
			Если МодульПовторногоИспользования <> Неопределено И МодульПовторногоИспользования.ИспользоватьОбменСобытиямиДляРасчетныхЛистков(НастройкаПодключения) Тогда
				МодульОтчетыВызовСервера.ДобавитьВЛог(НастройкаПодключения, ТипыСообщений.Ошибка, "Запрос ПИН-кода отклонён: выдача расчётных листков переключена на обмен событиями. Ид:"+ИдентификаторСотрудника);
				Возврат ПолучитьHTTPСервисОтветПинКода("10", Истина);
			КонецЕсли;
		КонецЕсли;

		РезультатГенерацииПинКода = МодульОтчетыВызовСервера.СгенерироватьПинКод(НастройкаПодключения, ВидОперации, ИдентификаторПодключения, ИдентификаторСотрудника);
		Если ЗначениеЗаполнено(РезультатГенерацииПинКода.ПинКод) Тогда

			ПараметрыЗапроса = Новый Структура;
			ПараметрыЗапроса.Вставить("НастройкаПодключения"	, НастройкаПодключения);
			ПараметрыЗапроса.Вставить("ИдентификаторСотрудника"	, ИдентификаторСотрудника);
			ПараметрыЗапроса.Вставить("ПинКод"					, РезультатГенерацииПинКода.ПинКод);

			ИмяРасписания = "Генерация ПИН-кода для: " + Строка(ИдентификаторСотрудника);

			Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_УП_ОтчетыВызовСервера.ОтправкаПинКодаВМессенджерБитрикс24ВФоне", ИмяРасписания, ПараметрыЗапроса);

			МодульОтчетыВызовСервера.ДобавитьВЛог(НастройкаПодключения, ТипыСообщений.Информация, "ПИН-код сгенерирован. Ид:"+ИдентификаторСотрудника);

			Б24_К_ОбщегоНазначенияВызовСервера.Таймаут(1);	//чтобы успело запуститься фоновое задание

		Иначе
			МодульОтчетыВызовСервера.ДобавитьВЛог(НастройкаПодключения, ТипыСообщений.Ошибка, РезультатГенерацииПинКода.Сообщение+". Ид:"+ИдентификаторСотрудника);
		КонецЕсли;

		Возврат ПолучитьHTTPСервисОтветПинКода(РезультатГенерацииПинКода.Сообщение, Ложь);

	Исключение

		Возврат ПолучитьHTTPСервисОтветПинКода("1", Истина);

	КонецПопытки;

	//@skip-check bsl-legacy-check-method-for-statements-after-return
	Возврат ПолучитьHTTPСервисОтветПинКода("2", Истина);

КонецФункции

