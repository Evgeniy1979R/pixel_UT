
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)    

	ВыполнитьКомандуПривязкиКБитрикс24(ПараметрКоманды);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьКомандуПривязкиКБитрикс24(ОбъектСсылка)    

	НастройкаПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию(); 
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения();
	Если КоличествоНастроек > 1 Тогда
		
		ВыбЗнач = Неопределено;
		Обещание  = ВвестиЗначениеАсинх(ВыбЗнач, "Укажите настройку подключения", Новый ОписаниеТипов("СправочникСсылка.Б24_К_НастройкиПодключения"));
		
		Результат = Ждать Обещание;
		Если Результат <> Неопределено Тогда
			НастройкаПодключения = Результат;
		КонецЕсли  
			
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда  
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось подключиться к порталу");
		Возврат;
	КонецЕсли;
	
	спкСущности = СущностиБитрикс24(СтруктураНастроек);
	
	Обещание = спкСущности.ВыбратьЭлементАсинх("Выберите тип сущности Битрикс24");
	Результат = Ждать Обещание;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;  
	
	
	Обещание = ВвестиСтрокуАсинх("","Содержит текст в названии");
	КлючПоиска = Ждать Обещание;
	
	Если НЕ ЗначениеЗаполнено(КлючПоиска) Тогда  
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не указан текст в названии");
		Возврат;
	КонецЕсли;  
	
	ДанныеПортала = ПолучитьДанныеБ24(СтруктураНастроек, Результат.Значение, КлючПоиска);
	
	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("ОбъектСсылка"		, ОбъектСсылка);
	ПередаваемыеПараметры.Вставить("ТипСущности"		, Результат.Значение);
	ПередаваемыеПараметры.Вставить("ДанныеПортала"		, ДанныеПортала);
	ПередаваемыеПараметры.Вставить("СтруктураНастроек"	, СтруктураНастроек);
	
	ОткрытьФорму("ОбщаяФорма.Б24_К_ВыборСущностиБитрикс24", ПередаваемыеПараметры,,,,, Новый ОписаниеОповещения("ВыполнитьПослеВыбораГрупп", ЭтотОбъект, ПередаваемыеПараметры),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаКлиенте           
Процедура ВыполнитьПослеВыбораГрупп(Результат, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(Результат) Тогда

		СтруктураНастроек 	= ДополнительныеПараметры.СтруктураНастроек;
		ОбъектСсылка 		= ДополнительныеПараметры.ОбъектСсылка;

		КонфигурируемыеДела	= СтруктураНастроек.КонфигурируемыеДела;
		ТипыОбъектовОбмена	= СтруктураНастроек.ТипыОбъектовОбмена;

		Если ДополнительныеПараметры.ТипСущности = "Лид" Тогда
			ТипВладельца 	= "1";
			ТипДанных		= ?(КонфигурируемыеДела, ТипыОбъектовОбмена.КонфигурируемоеДелоЛида, ТипыОбъектовОбмена.ДелоЛида);
		ИначеЕсли ДополнительныеПараметры.ТипСущности = "Компания" Тогда
			ТипВладельца 	= "4";
			ТипДанных		= ?(КонфигурируемыеДела, ТипыОбъектовОбмена.КонфигурируемоеДелоКомпании, ТипыОбъектовОбмена.ДелоКомпании);
		ИначеЕсли ДополнительныеПараметры.ТипСущности = "Контакт" Тогда
			ТипВладельца 	= "3";
			ТипДанных		= ?(КонфигурируемыеДела, ТипыОбъектовОбмена.КонфигурируемоеДелоКонтакта, ТипыОбъектовОбмена.ДелоКонтакта);
		ИначеЕсли ДополнительныеПараметры.ТипСущности = "Сделка" Тогда
			ТипВладельца 	= "2";
			ТипДанных		= ?(КонфигурируемыеДела, ТипыОбъектовОбмена.КонфигурируемоеДелоСделки, ТипыОбъектовОбмена.ДелоСделки);
		ИначеЕсли ДополнительныеПараметры.ТипСущности = "Счет" Тогда
			ТипВладельца 	= "31";
			ТипДанных		= ?(КонфигурируемыеДела, ТипыОбъектовОбмена.КонфигурируемоеДелоСчета, ТипыОбъектовОбмена.ДелоСчета);
		Иначе
			ТипВладельца 	= ДополнительныеПараметры.ТипСущности;
			ТипДанных		= ?(КонфигурируемыеДела, ТипыОбъектовОбмена.КонфигурируемоеДелоСмартПроцесса, ТипыОбъектовОбмена.ДелоСмартПроцесса);
		КонецЕсли;
		
		ПараметрыЗапроса = ПолучитьТелоЗапросаДела(СтруктураНастроек, ?(КонфигурируемыеДела, "Конфигурируемое", "Стандартное"), ТипВладельца, Результат, "",
			ОбъектСсылка);
		ДелоСоздано = ДелоСозданоВБитрикс24(СтруктураНастроек, ?(КонфигурируемыеДела, "Конфигурируемое", "Стандартное"), ПараметрыЗапроса, ОбъектСсылка,
			ТипВладельца, Результат, ТипДанных);

		Если ДелоСоздано Тогда
			ПоказатьОповещениеПользователя("Объекты связаны");
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось привязать объект 1С");
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция СущностиБитрикс24(СтруктураНастроек)

	Результат = Новый СписокЗначений;
	Результат.Добавить("Лид");
	Результат.Добавить("Компания");
	Результат.Добавить("Контакт");
	Результат.Добавить("Сделка");
	Результат.Добавить("Счет");
	
	Если Б24_К_СлужебныйВызовСервера.МодульСмартПроцессовДоступен(СтруктураНастроек.НастройкаПодключения) Тогда

		ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.type.list", "id", "", "types");
		Для каждого ТекЭлемент Из ДанныеПортала Цикл
			Результат.Добавить(Формат(ТекЭлемент.Получить("entityTypeId"), "ЧГ=0"), ТекЭлемент.Получить("title"));
		КонецЦикла;
		
	КонецЕсли;
	                       
	Возврат Результат;
	
КонецФункции    

&НаСервере
Функция ПолучитьДанныеБ24(СтруктураНастроек, ТипСущности, Знач КлючПоиска)
	
	Результат = Новый Массив;
	
	КлючПоиска = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КлючПоиска);
	
	ДанныеПортала = Неопределено;      
	
	Если ТипСущности = "Компания" Тогда  

		ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.company.list", "ID", "&filter["+"%3F"+"TITLE]="+КлючПоиска);
	ИначеЕсли ТипСущности = "Контакт" Тогда
		ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.contact.list", "ID", "&filter["+"%3F"+"LAST_NAME]="+КлючПоиска);
	ИначеЕсли ТипСущности = "Лид" Тогда   
		ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.item.list", "id", "&entityTypeId=1&filter[title]=%25"+КлючПоиска+"%25", "items");
	ИначеЕсли ТипСущности = "Сделка" Тогда
		ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.item.list", "id", "&entityTypeId=2&filter[title]=%25"+КлючПоиска+"%25", "items");
	ИначеЕсли ТипСущности = "Счет" Тогда   
		ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.item.list", "id", "&entityTypeId=31&filter[title]=%25"+КлючПоиска+"%25", "items");
	Иначе
		ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.item.list", "id", "&entityTypeId="+ТипСущности+"&filter[title]=%25"+КлючПоиска+"%25", "items");
	КонецЕсли;     
     
	Если ДанныеПортала <> Неопределено Тогда
		
		Для каждого ТекЭлемент Из ДанныеПортала Цикл
			
			ЭлементДанных = Новый Структура;
			
			Если ТипСущности = "Компания" ИЛИ ТипСущности = "Контакт" Тогда
				ЭлементДанных.Вставить("Ид"				, Формат(ТекЭлемент.Получить("ID"),"ЧГ=0"));  
				ЭлементДанных.Вставить("ДатаСоздания"	, XMLЗначение(Тип("Дата"), ТекЭлемент.Получить("DATE_CREATE")));  
				Если ТипСущности = "Контакт" Тогда    
					ЭлементДанных.Вставить("Наименование"	, ТекЭлемент.Получить("NAME") + " " +  ТекЭлемент.Получить("LAST_NAME"));
				Иначе	                                                             
					ЭлементДанных.Вставить("Наименование"	, ТекЭлемент.Получить("TITLE"));
				КонецЕсли;
			Иначе
				ЭлементДанных.Вставить("Ид"				, Формат(ТекЭлемент.Получить("id"),"ЧГ=0"));
				ЭлементДанных.Вставить("Наименование"	, ТекЭлемент.Получить("title"));
				ЭлементДанных.Вставить("ДатаСоздания"	, XMLЗначение(Тип("Дата"), ТекЭлемент.Получить("createdTime")));  
			КонецЕсли;		
			
			Результат.Добавить(ЭлементДанных);
			
		КонецЦикла;     
		
	КонецЕсли;     	
	
	Возврат Результат;                        
	
КонецФункции    

 &НаСервере  
 Функция ДелоСозданоВБитрикс24(СтруктураНастроек, ВидДела, ПараметрыЗапроса, ОбъектСсылка, ТипВладельца, ИдентификаторВладельца, ТипДанных)

	Возврат Б24_К_ВыгрузкаДелСервер.ДелоСозданоВБитрикс24(СтруктураНастроек, ВидДела, ПараметрыЗапроса, ОбъектСсылка, ТипВладельца, ИдентификаторВладельца, ТипДанных);
  
 КонецФункции     
   
&НаСервере
Функция ПолучитьТелоЗапросаДела(СтруктураНастроек, ВидДела, ТипВладельца, ИдентификаторВладельца, КлючВладельца, ОбъектСсылка)

 	Возврат Б24_К_ВыгрузкаДелСервер.ПолучитьТелоЗапросаДела(СтруктураНастроек, ВидДела, ТипВладельца, ИдентификаторВладельца, КлючВладельца, ОбъектСсылка,, Истина);
 	
КонецФункции      