
&НаКлиенте
Асинх Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)   
	
#Если НЕ ВебКлиент Тогда
		
	Если Б24_КЭ_ЭкспортДанныхВызовСервера.СнимокОкнаДоступен() Тогда   
		ПродолжитьОбработкуКоманды(ПараметрКоманды);	
	Иначе
			
		Ответ = Ждать ВопросАсинх("Включить возможность делать снимки экрана?", РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
			
		Б24_КЭ_ЭкспортДанныхВызовСервера.ВключитьВозможностьДелатьСнимкиЭкрана();
		
		
		Ответ = Ждать ВопросАсинх("Для принятия настроек требуется перезагрузка клиента 1С. Перезагрузить?", РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		ЗавершитьРаботуСистемы(Истина, Истина);
			
	КонецЕсли;
		
#Иначе   
	
	ПоказатьПредупреждение(, "В веб клиенте недоступно делать снимки экрана");	
		
#КонецЕсли
	
КонецПроцедуры  

&НаКлиенте
Асинх Процедура ПродолжитьОбработкуКоманды(ПараметрКоманды)   
	
	НастройкаПодключения = Неопределено;
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения("ОбсужденияВЧатах", Истина);
	Если КоличествоНастроек > 1 Тогда
		 
		ВыбЗнач 	= Неопределено;
		
		Массив 		= Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Ответ = Ждать ВвестиЗначениеАсинх(ВыбЗнач, "Укажите настройку подключения", ОписаниеТипов);
		Если Ответ = Неопределено Тогда
			Возврат;
		КонецЕсли;          
		
		НастройкаПодключения = Ответ;
		
	Иначе      
		
		НастройкаПодключения = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию("ОбсужденияВЧатах", Истина);

	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСнимка = Б24_КЭ_ЭкспортДанныхКлиент.СнимокЭкранаКлиента();
	Если ДанныеСнимка = Неопределено Тогда 
		ПоказатьОповещениеПользователя("Не удалось сделать снимок экрана");
		Возврат 
	КонецЕсли;
	
	ПараметрыНовойФормы = Новый Структура;
	ПараметрыНовойФормы.Вставить("СнимокЭкрана"			, ДанныеСнимка);
	ПараметрыНовойФормы.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПараметрыНовойФормы.Вставить("ОбъектСсылка"			, ПараметрКоманды);
													
	ОткрытьФорму("ОбщаяФорма.Б24_КЭ_ОбсудитьВЧатеСоСнимкомЭкрана", ПараметрыНовойФормы,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры 

