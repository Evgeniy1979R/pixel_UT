
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.РасширениеВБезопасномРежиме() Тогда
		ПоказатьПредупреждение(, "Расширение модуля в безопасном режиме. Продолжение невозможно",10);
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Структура;	
	Параметры.Вставить("Объект"						, ПараметрКоманды);
	Параметры.Вставить("ПараметрыВыполненияКоманды"	, ПараметрыВыполненияКоманды);
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения();
	Если КоличествоНастроек > 1 Тогда
		
		ВыбЗнач 	= Неопределено;
		
		Массив 		= Новый Массив;
		Массив.Добавить(Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначения", ЭтотОбъект, Параметры);

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку подключения", ОписаниеТипов);	
		
	Иначе
		ПослеВводаЗначения(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию(), Параметры);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначения(НастройкаПодключения, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(НастройкаПодключения) Тогда
			
		Если Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения) = Ложь Тогда
			Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаСинхронизацииПоТарифномуПлану();
			Возврат;	
		КонецЕсли;
			
		ОбработкаОбъекта(НастройкаПодключения, Параметры);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОбъекта(НастройкаПодключения, Параметры, Ошибка = Ложь) 

	Если Ошибка Тогда
		ПоказатьПредупреждение(, "Не удалось выгрузить данные в Битрикс24");
		Возврат;
	КонецЕсли;
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	СтруктураНастроек 				= Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	
	ОбъектДанных					= Параметры.Объект;
	ТипыДанных 						= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	ПрефиксВнешнихКодовБитрикс24 	= ПолучитьПрефиксВнешнихКодовБитрикс24();
	НастройкаПодключения 			= НастройкаПодключения;
	АдресБитрикс24 					= СтрЗаменить(СтруктураНастроек.НастройкиПодключения.АдресСайта,"/rest/","");
	АдресСсылки						= "";
	ТекущийТипДанных				= Неопределено;
	
	ТипОбъекта 		= ТипЗнч(ОбъектДанных);
	Номенклатура 	= "";
	
	СтруктураСсылок = ПолучитьАдресаОбъектовБитрикс24();
	
	Если ТипОбъекта = Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" ИЛИ ТипКонфигурации = "УНФ", "СправочникСсылка.Контрагенты", "СправочникСсылка.Партнеры")) Тогда
		
		АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
		
		Если НЕ ЗначениеЗаполнено(АдресСсылки) Тогда
			
			ТипыКонтрагентовДляКомпаний = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипыКонтрагентовДляКомпаний(НастройкаПодключения); 
			Если ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" Тогда
				ПроверяемоеЗначение = ВидКлиентаПоОбъекту(ОбъектДанных);
			Иначе
				// В УНФ признак клиента хранится в реквизите «ВидКонтрагента», в УТ/КА — в «ЮрФизЛицо».
				ИмяРеквизитаПризнака = ?(ТипКонфигурации = "УНФ", "ВидКонтрагента", "ЮрФизЛицо");
				ПроверяемоеЗначение = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(ОбъектДанных, ИмяРеквизитаПризнака);
			КонецЕсли;
			Если ТипыКонтрагентовДляКомпаний.Найти(ПроверяемоеЗначение) <> Неопределено Тогда 
				ТекущийТипДанных = ТипыДанных.Компания;
				ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				ИдОбъекта = ?(Лев(ИдОбъекта, 1) = "#", Прав(ИдОбъекта, СтрДлина(ИдОбъекта)-1), ИдОбъекта);
				
				Если ЗначениеЗаполнено(ИдОбъекта) Тогда
					АдресСсылки = АдресБитрикс24 + СтруктураСсылок.Компания + ИдОбъекта + "/";
				КонецЕсли;	
				
			Иначе
				ТекущийТипДанных = ТипыДанных.Контакт;
				ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				ИдОбъекта = ?(Лев(ИдОбъекта, 1) = "#", Прав(ИдОбъекта, СтрДлина(ИдОбъекта)-1), ИдОбъекта);
				
				Если ЗначениеЗаполнено(ИдОбъекта) Тогда
					АдресСсылки = АдресБитрикс24 + СтруктураСсылок.Контакт + ИдОбъекта + "/";
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Организации") Тогда
		
		АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
		
		Если НЕ ЗначениеЗаполнено(АдресСсылки) Тогда
					
			ТекущийТипДанных = ТипыДанных.Компания;
			ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				
			Если ЗначениеЗаполнено(ИдОбъекта) Тогда
				АдресСсылки = АдресБитрикс24 + СтруктураСсылок.Компания + ИдОбъекта + "/";
			КонецЕсли;
			КонецЕсли;
			
		
	ИначеЕсли ТипОбъекта = Тип(?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" ИЛИ ТипКонфигурации = "УНФ", "СправочникСсылка.КонтактныеЛица", "СправочникСсылка.КонтактныеЛицаПартнеров")) Тогда
		
		АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
		
		Если НЕ ЗначениеЗаполнено(АдресСсылки) Тогда
				
			ТекущийТипДанных = ТипыДанных.Контакт;
			ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
			ИдОбъекта = ?(Лев(ИдОбъекта, 1) = "#", Прав(ИдОбъекта, СтрДлина(ИдОбъекта)-1), ИдОбъекта);
			
			Если ЗначениеЗаполнено(ИдОбъекта) Тогда
				АдресСсылки = АдресБитрикс24 + СтруктураСсылок.Контакт + ИдОбъекта + "/";
			КонецЕсли;	
			
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("СправочникСсылка.Номенклатура") Тогда
		
		ТекущийТипДанных = ТипыДанных.Товар;
		ИнформацияОТоваре = ПолучитьДанныеОТоваре(ОбъектДанных);
		
		Если ЗначениеЗаполнено(ИнформацияОТоваре.Наименование) Тогда
			АдресСсылки = АдресБитрикс24 + "/crm/product/list/?NAME=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИнформацияОТоваре.Наименование) + "&grid_filter_id=&apply_filter=Y";
		Иначе
			ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ИнформацияОТоваре.Номенклатура, ?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", Неопределено, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка")));
			Если ЗначениеЗаполнено(ИдОбъекта) Тогда
				АдресСсылки = АдресБитрикс24 + "/crm/product/show/" + ИдОбъекта + "/";
			КонецЕсли;	
		КонецЕсли;
		
	ИначеЕсли ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" Тогда
		Если ТипОбъекта = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
			НастройкиСинхронизации = ПолучитьНастройкиСинхронизации(НастройкаПодключения);
			Если НастройкиСинхронизации.ВерсияСчетов = "v.2" Тогда
				ТекущийТипДанных = ТипыДанных.Счет2;
				АдресСсылки = "";
				ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				Если ЗначениеЗаполнено(ИдОбъекта) Тогда
					АдресСсылки = АдресБитрикс24 + "/crm/type/31/details/" + ИдОбъекта + "/";
				КонецЕсли;
			Иначе
				ТекущийТипДанных = ТипыДанных.Счет;
				АдресСсылки = "";
				ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				Если ЗначениеЗаполнено(ИдОбъекта) Тогда
					АдресСсылки = АдресБитрикс24 + "/crm/invoice/show/" + ИдОбъекта + "/";
				КонецЕсли;
			КонецЕсли;
		Иначе
			АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		Если ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказКлиента") Тогда
			АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
			Если НЕ ЗначениеЗаполнено(АдресСсылки) Тогда
				ТекущийТипДанных = ТипыДанных.Сделка;
				ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				Если ЗначениеЗаполнено(ИдОбъекта) Тогда
					ИдентификаторБ24 	= Прав(ИдОбъекта, СтрДлина(ИдОбъекта)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.Сделки));	
					АдресСсылки = АдресБитрикс24 + СтруктураСсылок.Сделка + ИдентификаторБ24 + "/";
				КонецЕсли;	
			КонецЕсли;
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияКлиент.ТипПоИмени("ДокументСсылка.СчетНаОплатуКлиенту") Тогда
			АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
			Если НЕ ЗначениеЗаполнено(АдресСсылки) Тогда
				ТекущийТипДанных = ТипыДанных.Счет;
				ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				Если ЗначениеЗаполнено(ИдОбъекта) Тогда
					ИдентификаторБ24 	= Прав(ИдОбъекта, СтрДлина(ИдОбъекта)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.Счета));	
					АдресСсылки = АдресБитрикс24 + СтруктураСсылок.Счет + ИдОбъекта + "/";
				КонецЕсли;	
			КонецЕсли;
		Иначе
			АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "УНФ" Тогда
		Если ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.ЗаказПокупателя") Тогда
			
			АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
			Если НЕ ЗначениеЗаполнено(АдресСсылки) Тогда
				
				ТекущийТипДанных = ТипыДанных.Сделка;
				
				ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				Если ЗначениеЗаполнено(ИдОбъекта) Тогда
					ИдентификаторБ24 	= Прав(ИдОбъекта, СтрДлина(ИдОбъекта)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.Сделки));	
					АдресСсылки = АдресБитрикс24 + СтруктураСсылок.Сделка + ИдентификаторБ24 + "/";
				КонецЕсли;	
				
			КонецЕсли;
			
		ИначеЕсли ТипОбъекта = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ТипПоИмени("ДокументСсылка.СчетНаОплату") Тогда
			
			НастройкиСинхронизации = ПолучитьНастройкиСинхронизации(НастройкаПодключения);
			Если НастройкиСинхронизации.ВерсияСчетов = "v.2" Тогда
					
				ТекущийТипДанных = ТипыДанных.Счет2;
				
				АдресСсылки = "";
				ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
				Если ЗначениеЗаполнено(ИдОбъекта) Тогда    
					ИдентификаторБ24 	= Прав(ИдОбъекта, СтрДлина(ИдОбъекта)-СтрДлина(ПрефиксВнешнихКодовБитрикс24.Счета));	
					АдресСсылки = АдресБитрикс24 + "/crm/type/31/details/" + ИдОбъекта + "/";
				КонецЕсли;
				
			Иначе
					
				АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
				Если НЕ ЗначениеЗаполнено(АдресСсылки) Тогда
					
					ТекущийТипДанных = ТипыДанных.Счет;
					
					ИдОбъекта = ПолучитьИдОбъекта(СтруктураНастроек.Портал, ТекущийТипДанных, ОбъектДанных);
					Если ЗначениеЗаполнено(ИдОбъекта) Тогда
						АдресСсылки = АдресБитрикс24 + СтруктураСсылок.Счет + ИдОбъекта + "/";
					КонецЕсли;	
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе		
			АдресСсылки = ПолучитьАдресПоДелуОбъекта(СтруктураНастроек.Портал, АдресБитрикс24, ОбъектДанных);
		КонецЕсли;
		
	КонецЕсли;	// ТипКонфигурации (БП/УТ документы)
		
	Если НЕ ЗначениеЗаполнено(АдресСсылки)  Тогда
		
		Если ТекущийТипДанных <> Неопределено Тогда
			
			Режим = РежимДиалогаВопрос.ДаНет;
			ПередаваемыеПараметры = Новый Структура;
			ПередаваемыеПараметры.Вставить("НастройкаПодключения"		, НастройкаПодключения); 
			ПередаваемыеПараметры.Вставить("ТекущийТипДанных"			, ТекущийТипДанных); 
			ПередаваемыеПараметры.Вставить("Объект"						, ОбъектДанных); 
			ПередаваемыеПараметры.Вставить("Номенклатура"				, Номенклатура); 
			ПередаваемыеПараметры.Вставить("ПараметрыВыполненияКоманды"	, Параметры.ПараметрыВыполненияКоманды); 
			
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОВыгрузкеВБитрикс24", ЭтотОбъект, ПередаваемыеПараметры);			
			ПоказатьВопрос(Оповещение, "Объект не выгружен в Битрикс24. Выгрузить его?", Режим, 0);
			
		Иначе
			ОбщегоНазначенияКлиент.СообщитьПользователю("Нет привязки к документу. Нельзя документ выгрузить");
		КонецЕсли;
	Иначе
		
#Если ВебКлиент Тогда
		ПерейтиПоНавигационнойСсылке(АдресСсылки); 	
#Иначе			
		СпособОткрытияОбъектовБитрикс24 = СтруктураНастроек.ОбщиеНастройки.ИспользуемыйБраузер;
		
		Если СпособОткрытияОбъектовБитрикс24 <> "Браузер ОС по умолчанию" Тогда
			
			СтраницаHTML = "
			|<html>
			|<script type=""text/javascript"">
			|location.replace("""+АдресСсылки+""");
			|</script>
			|</html>";
			
			Б24_К_ОбщегоНазначенияКлиент.ПерейтиПоWebСсылке(СтраницаHTML, "", Параметры.Объект, Параметры.ПараметрыВыполненияКоманды.Окно);
		Иначе
			ПерейтиПоНавигационнойСсылке(АдресСсылки); 	
		КонецЕсли;

#КонецЕсли
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьИдОбъекта(Портал, ТипДанных, Объект, ПодчиненныйОбъект = Неопределено)
	
	Возврат РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ПолучитьИдОбъекта(Портал, ТипДанных, Объект, ПодчиненныйОбъект);
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОВыгрузкеВБитрикс24(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	НастройкаПодключения 	= Параметры.НастройкаПодключения;
	
	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("НастройкаПодключения"		, НастройкаПодключения); 
	ПередаваемыеПараметры.Вставить("ТекущийТипДанных"			, Параметры.ТекущийТипДанных); 
	ПередаваемыеПараметры.Вставить("Объект"						, Параметры.Объект); 
	ПередаваемыеПараметры.Вставить("Номенклатура"				, Параметры.Номенклатура); 
	
	ИдБитрикс24 = ВыполнитьВыгрузкуДанных(НастройкаПодключения, ПередаваемыеПараметры);
	
	Если ЗначениеЗаполнено(ИдБитрикс24) Тогда
		ОбработкаОбъекта(НастройкаПодключения, Параметры);		
	Иначе
		ОбработкаОбъекта(НастройкаПодключения, Параметры, Истина);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеОТоваре(Товар)
	
	ИнформацияОТоваре = Новый Структура;
	ИнформацияОТоваре.Вставить("Номенклатура"	, Неопределено);
	ИнформацияОТоваре.Вставить("Характеристика"	, Неопределено);
	ИнформацияОТоваре.Вставить("Наименование"	, Неопределено);
	
	ИнформацияОТоваре.Номенклатура = Товар; 	
	ИнформацияОТоваре.Наименование = Товар.Наименование;
	
	Возврат ИнформацияОТоваре;
	
КонецФункции

&НаСервере
Функция ПолучитьПрефиксВнешнихКодовБитрикс24()
	Возврат Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьПрефиксВнешнихКодовБитрикс24()
КонецФункции


&НаСервере
Функция ВыполнитьВыгрузкуДанных(НастройкаПодключения, Параметры)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ИдБитрикс24 = "";
	
	СтруктураНастроек = Б24_КС_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
	Если СтруктураНастроек = Неопределено Тогда
		Возврат ИдБитрикс24;
	КонецЕсли;
	
	СтруктураНастроек.Логирование.Измерение2 = "Ручная выгрузка данных через перейти в Битрикс24";
	
	Если Параметры.ТекущийТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.Товар Тогда
		
		Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, Параметры.ТекущийТипДанных, Параметры.Объект, ?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", Неопределено, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка")));
		
	ИначеЕсли Параметры.ТекущийТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.Товар2 Тогда
		
		Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, Параметры.ТекущийТипДанных, Параметры.Объект, ?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", Неопределено, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка")));
		
	ИначеЕсли Параметры.ТекущийТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.Компания ИЛИ Параметры.ТекущийТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.Контакт Тогда
		
		Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, Параметры.ТекущийТипДанных, Параметры.Объект);
		Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, СтруктураНастроек.ТипыОбъектовОбмена.Реквизит			, Параметры.Объект);
		
	ИначеЕсли Параметры.ТекущийТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.Сделка Тогда
		
		Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, Параметры.ТекущийТипДанных, Параметры.Объект);
		
	ИначеЕсли Параметры.ТекущийТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.Счет Тогда
		
		Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, Параметры.ТекущийТипДанных, Параметры.Объект);
		
	ИначеЕсли Параметры.ТекущийТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.Счет2 Тогда
		
		Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, Параметры.ТекущийТипДанных, Параметры.Объект);
		
	Иначе
		Б24_КС_РегистрацияИзмененийСервер.ПроверитьИДобавитьОбъектВТаблицуИзменений(НастройкаПодключения, Параметры.ТекущийТипДанных, Параметры.Объект);
	КонецЕсли;

	СтруктураНастроек.ВремяЗапускаВМиллисекундах = ТекущаяУниверсальнаяДатаВМиллисекундах();	
	СтруктураНастроек.СтатусПроверкиОчереди = 0;
	Б24_КС_ОбщегоНазначенияВызовСервера.ЗапуститьВыполнениеОчередиВыгрузки(СтруктураНастроек);

	Если Параметры.ТекущийТипДанных = СтруктураНастроек.ТипыОбъектовОбмена.Товар Тогда
		ИдБитрикс24 = ПолучитьИдОбъекта(НастройкаПодключения.Портал, Параметры.ТекущийТипДанных, Параметры.Объект, ?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП", Неопределено, Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПредопределенноеЗначениеПоИмени("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка")));			
	Иначе
		ИдБитрикс24 = ПолучитьИдОбъекта(НастройкаПодключения.Портал, Параметры.ТекущийТипДанных, Параметры.Объект);   			
	КонецЕсли;

	Возврат ИдБитрикс24;
	
КонецФункции

&НаСервере
Функция ПолучитьАдресПоДелуОбъекта(Портал, АдресБитрикс24, ОбъектСсылка)
	
	Результат = "";
	
	ТипыДанных = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыДанныхДляОбменаСПорталом();
	
	СтруктураСсылок = ПолучитьАдресаОбъектовБитрикс24();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Портал"				, Портал);
	Запрос.УстановитьПараметр("ТипыДанных"			, Б24_К_RestApiВызовСервера.ПолучитьТипыДанныхДел());
	Запрос.УстановитьПараметр("ТипОбъекта"			, ОбъектСсылка.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("ИдентификаторОбъекта", XMLСтрока(ОбъектСсылка));
	Запрос.Текст =" ВЫБРАТЬ
	|	Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор КАК Идентификатор,
	|	Б24_К_ИдентификаторыДел.ТипДанных КАК ТипДанных
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.Портал = &Портал
	|	И Б24_К_ИдентификаторыДел.ТипДанных В(&ТипыДанных)
	|	И Б24_К_ИдентификаторыДел.ТипОбъекта = &ТипОбъекта
	|	И Б24_К_ИдентификаторыДел.ИдентификаторОбъекта = &ИдентификаторОбъекта"; 
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ИдОбъекта = ?(Лев(Выборка.Идентификатор, 1) = "#", Прав(Выборка.Идентификатор, СтрДлина(Выборка.Идентификатор)-1), Выборка.Идентификатор);
			Если ИдОбъекта = "Да" Тогда
				Возврат Результат;
			КонецЕсли;
			
			Если Выборка.ТипДанных = ТипыДанных.ДелоКомпании ИЛИ Выборка.ТипДанных = ТипыДанных.КонфигурируемоеДелоКомпании Тогда
				Результат = АдресБитрикс24 + СтруктураСсылок.Компания + ИдОбъекта + "/";
			ИначеЕсли Выборка.ТипДанных = ТипыДанных.ДелоКонтакта ИЛИ Выборка.ТипДанных = ТипыДанных.КонфигурируемоеДелоКонтакта Тогда
				Результат = АдресБитрикс24 + СтруктураСсылок.Контакт + ИдОбъекта + "/";
			ИначеЕсли Выборка.ТипДанных = ТипыДанных.ДелоЛида ИЛИ Выборка.ТипДанных = ТипыДанных.КонфигурируемоеДелоЛида Тогда
				Результат = АдресБитрикс24 + СтруктураСсылок.Лид + ИдОбъекта + "/";
			ИначеЕсли Выборка.ТипДанных = ТипыДанных.ДелоСделки ИЛИ Выборка.ТипДанных = ТипыДанных.КонфигурируемоеДелоСделки Тогда
				Результат = АдресБитрикс24 + СтруктураСсылок.Сделка + ИдОбъекта + "/";
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьАдресаОбъектовБитрикс24()
	
	СтруктураСсылок = Новый Структура;
	СтруктураСсылок.Вставить("Компания"	, "/crm/company/details/"); 
	СтруктураСсылок.Вставить("Контакт"	, "/crm/contact/details/"); 
	СтруктураСсылок.Вставить("Счет"		, "/crm/invoice/show/"); 
	СтруктураСсылок.Вставить("Счет2"	, "/crm/type/31/details/"); 
	СтруктураСсылок.Вставить("Сделка"	, "/crm/deal/details/"); 
	СтруктураСсылок.Вставить("Лид"		, "/crm/lead/details/");
	
	Возврат СтруктураСсылок;
	
КонецФункции

