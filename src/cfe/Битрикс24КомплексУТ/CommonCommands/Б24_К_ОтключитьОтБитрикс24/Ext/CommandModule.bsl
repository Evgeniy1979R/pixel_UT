
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения();
	
	Если КоличествоНастроек > 1 Тогда
		 
		ВыбЗнач 	= Неопределено;
		
		Массив 		= Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначения", ЭтотОбъект);

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку подключения", ОписаниеТипов);	
		
	Иначе
		Параметры = Новый Структура;	
		ПослеВводаЗначения(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию(), Параметры);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначения(НастройкаПодключения, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(НастройкаПодключения) Тогда

		ОбработкаКомандыСервер(НастройкаПодключения);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере	
Процедура ОбработкаКомандыСервер(НастройкаПодключения)
	
	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураНастроек = Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);
	
	Если СтруктураНастроек <> Неопределено Тогда
		СтруктураНастроек.Логирование.Измерение1 = "Отключение канала от Битрикс24";
		ТелоЗапроса = "&COMMAND=closePPSession1C&MODULE_ID="+Б24_К_RestApiВызовСервера.ИдПриложенияБитрикс24()+"&params[idAdress]=" + XMLСтрока(НастройкаПодключения.ИдентификаторПодключения) + "&params[portal]=" + XMLСтрока(НастройкаПодключения.Портал);
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/pull.application.event.add", ТелоЗапроса);
	КонецЕсли;
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ИнформационнаяБазаФайловая() Тогда
		
		Б24_К_ЛонгПуллингВызовСервера.УстановитьНастройкуЛонгПуллинг(НастройкаПодключения, Ложь);
		
		ОбщегоНазначения.СообщитьПользователю("Зависший клиент станет активным в течении минуты.");
		
	Иначе
		
		Б24_К_ЛонгПуллингВызовСервера.УстановитьНастройкуЛонгПуллинг(НастройкаПодключения, Ложь);
		
		НаименованиеФоновогоЗадания = Б24_К_ЛонгПуллингКлиентСервер.ПолучитьНазваниеФоновогоЗаданияСоединенияСБитрикс24(НастройкаПодключения);
		
		мФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый структура("Наименование", НаименованиеФоновогоЗадания));
		
		Для каждого ТекЭлемент Из мФоновыеЗадания Цикл
			
			Если ТекЭлемент.Состояние = СостояниеФоновогоЗадания.Активно Тогда		
				Попытка
					РегламентныеЗаданияСлужебный.ОтменитьФоновоеЗадание(ТекЭлемент.УникальныйИдентификатор);
				Исключение
				КонецПопытки;
			КонецЕсли;			

		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
