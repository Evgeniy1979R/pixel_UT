
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	СпособВзаимодействияСБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "СпособВзаимодействияСБитрикс24");
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		
		ПоказатьПредупреждение(, "Когда база 1С в режиме сервиса, то подключение к Б24 происходит через http сервисы.",, "Push&Pull недоступен");	
		
		Если СпособВзаимодействияСБитрикс24 = Неопределено ИЛИ СпособВзаимодействияСБитрикс24 = "Через push&pull сервер" Тогда
			ПоказатьПредупреждение(, "Не настроена работа через http сервисы. Необходимо указать это общих настройках и переуказать токен подключения",, "Ошибка в настройках");	
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если СпособВзаимодействияСБитрикс24 = Неопределено ИЛИ СпособВзаимодействияСБитрикс24 = "Через push&pull сервер" Тогда
		
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ИнформационнаяБазаФайловая() Тогда
			Оповещение = Новый ОписаниеОповещения("ЗапуститьВыполнениеПодключения", ЭтотОбъект);
			ПоказатьПредупреждение(Оповещение, "При запуске соединения к Битрикс24 текущий сеанс 1С становится каналом взаимодействия между 1С и Битрикс24.",, "Сеанс 1С будет заблокирован");	
		Иначе
			ЗапуститьВыполнениеПодключения("");	
		КонецЕсли;	
	Иначе
		ПоказатьПредупреждение(, "Подключение к Б24 происходит через http сервисы. Запускать сеанс не нужно",, "Информация");	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьВыполнениеПодключения(Параметры) Экспорт
	
	Б24_К_ЛонгПуллингВызовСервера.ДобавитьУдалитьРасписаниеМониторингаСоединенияСБитрикс24();
	
	КоличествоНастроек = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьКоличествоНастроекПодключения();
	
	Если КоличествоНастроек > 1 Тогда
		 
		ВыбЗнач 	= Неопределено;
		
		Массив 		= Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.Б24_К_НастройкиПодключения"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив);
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначения", ЭтотОбъект);

		ПоказатьВводЗначения(Оповещение, ВыбЗнач, "Укажите настройку подключения", ОписаниеТипов);	
		
	Иначе
		Параметры = Новый Структура;	
		ПослеВводаЗначения(Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПолучитьНастройкуПодключенияПоУмолчанию(), Параметры);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначения(НастройкаПодключения, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(НастройкаПодключения) Тогда

		Если НЕ Б24_К_СлужебныйВызовСервера.БазовыйМодульДоступен(НастройкаПодключения) Тогда
			Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаБазовогоМодуляПоТарифномуПлану();
			Возврат;	
		КонецЕсли;
		
		Б24_К_ЛонгПуллингВызовСервера.УстановитьНастройкуЛонгПуллинг(НастройкаПодключения, Истина);	
		
		Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ИнформационнаяБазаФайловая() Тогда
			
			Б24_К_ЛонгПуллингКлиентСервер.ЗапускДлительногоСоединенияКПорталуОбщий(НастройкаПодключения);
			
		Иначе
			
			НаименованиеФоновогоЗадания = Б24_К_ЛонгПуллингКлиентСервер.ПолучитьНазваниеФоновогоЗаданияСоединенияСБитрикс24(НастройкаПодключения);
			
			Если Б24_К_ОбщегоНазначенияВызовСервера.СейчасВыполняетсяЗадание(НаименованиеФоновогоЗадания) Тогда
				УдалениеФоновогоЗадания(НаименованиеФоновогоЗадания);			
			КонецЕсли;
			
			ПараметрыВыгрузки = Новый Структура;
			ПараметрыВыгрузки.Вставить("НастройкаПодключения", НастройкаПодключения);
			Б24_К_ОбщегоНазначенияВызовСервера.ЗапуститьЗадание("Б24_К_ЛонгПуллингВызовСервера.ЗапуститьСоединениеСБитрикс24ВФоне", НаименованиеФоновогоЗадания, ПараметрыВыгрузки, 0, Истина);  

		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалениеФоновогоЗадания(НаименованиеФоновогоЗадания)
	
	мФоновыеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый структура("Наименование", НаименованиеФоновогоЗадания));
		
	Для каждого ТекЭлемент Из мФоновыеЗадания Цикл
		
		Если ТекЭлемент.Состояние = СостояниеФоновогоЗадания.Активно Тогда			
			РегламентныеЗаданияСлужебный.ОтменитьФоновоеЗадание(ТекЭлемент.УникальныйИдентификатор);
		КонецЕсли;			
		
	КонецЦикла;
	
КонецПроцедуры
