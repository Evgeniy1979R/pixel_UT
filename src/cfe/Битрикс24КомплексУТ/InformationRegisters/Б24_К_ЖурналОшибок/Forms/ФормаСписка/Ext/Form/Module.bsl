
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтруктураОпераций = Новый Структура(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипыОпераций());
	
	СпкОпераций.Добавить("Все","Все");
	СпкОпераций.Добавить("","Общие");
	
	Для Каждого ТекСтрока Из СтруктураОпераций Цикл 
		
		Если ТекСтрока.Ключ = "БанковскиеСчета" Тогда
			СпкОпераций.Добавить(ТекСтрока.Ключ, "Банковские счета");
		ИначеЕсли ТекСтрока.Ключ = "ГруппыТоваров" Тогда
			СпкОпераций.Добавить(ТекСтрока.Ключ, "Группы товаров");
		ИначеЕсли ТекСтрока.Ключ = "ЕдиницыИзмерения" Тогда
			СпкОпераций.Добавить(ТекСтрока.Ключ, "Единицы измерения");
		ИначеЕсли ТекСтрока.Ключ = "СвойстваТоваров" Тогда
			СпкОпераций.Добавить(ТекСтрока.Ключ, "Свойства товаров");
		ИначеЕсли ТекСтрока.Ключ = "СвойстваКонтактов" Тогда
			СпкОпераций.Добавить(ТекСтрока.Ключ, "Свойства контактов");
		ИначеЕсли ТекСтрока.Ключ = "СвойстваКомпаний" Тогда
			СпкОпераций.Добавить(ТекСтрока.Ключ, "Свойства компаний");
		ИначеЕсли ТекСтрока.Ключ = "СвойстваСделок" Тогда
			СпкОпераций.Добавить(ТекСтрока.Ключ, "Свойства сделок");
		ИначеЕсли ТекСтрока.Ключ = "СвойстваСчетов" Тогда
			СпкОпераций.Добавить(ТекСтрока.Ключ, "Свойства счетов");
		Иначе
			СпкОпераций.Добавить(ТекСтрока.Ключ, ТекСтрока.Ключ);	
		КонецЕсли;
		
	КонецЦикла;
	
	ТекущаяДатаСеанса 	 = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса();
	Период.ДатаНачала 	 = НачалоДня(ТекущаяДатаСеанса);
	Период.ДатаОкончания = КонецДня(ТекущаяДатаСеанса);
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("НастройкаПодключения");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
	КонецЕсли;
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("Получатель");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
	КонецЕсли;
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("ДатаНачала");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
		НайденныйОтбор.Значение = Период.ДатаНачала; 
	КонецЕсли;
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("ДатаОкончания");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
		НайденныйОтбор.Значение = Период.ДатаОкончания; 
	КонецЕсли;
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("Операция");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
		НайденныйОтбор.Значение = "Все"; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьСписокОшибок();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПриИзмененииЭлемента(Элемент)
	ОбновитьСписокОшибок();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокНастроекСинхронизации

&НаКлиенте
Процедура СписокНастроекСинхронизацииПриАктивизацииСтроки(Элемент)
	ОбновитьСписокОшибок();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОшибкаРешена(Команда)
	
	КлючЗаписи = Элементы.Список.ТекущаяСтрока;
	
	Если КлючЗаписи <> Неопределено Тогда
		ОбработатьЗаписьОбОшибке(КлючЗаписи, Истина);	
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОшибкаНеРешена(Команда)
	
	КлючЗаписи = Элементы.Список.ТекущаяСтрока;
	
	Если КлючЗаписи <> Неопределено Тогда
		ОбработатьЗаписьОбОшибке(КлючЗаписи, Ложь);	
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаписи(Команда)
	
	ГраницаУдаления = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТекущуюДатуСеанса() - 60*60*24*7;
	Подсказка 		= "Введите дату по которую будет удалены ошибки";
	ЧастьДаты 		= ЧастиДаты.Дата;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаДаты", ЭтотОбъект, Параметры);
	ПоказатьВводДаты(Оповещение, ГраницаУдаления, Подсказка, ЧастьДаты);	
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьСписокОшибок()
	
	ТекущиеДанныеНастройкаПодключения = Элементы.СписокНастроекСинхронизации.ТекущиеДанные;
	
	Если ТекущиеДанныеНастройкаПодключения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаПодключения = ТекущиеДанныеНастройкаПодключения.Ссылка;
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("НастройкаПодключения");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
		НайденныйОтбор.Значение = НастройкаПодключения; 
	КонецЕсли;
	
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("Получатель");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
		НайденныйОтбор.Значение = ПолучитьПользователяНастройкиСинхронизации(НастройкаПодключения); 
	КонецЕсли;
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("ДатаНачала");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
		НайденныйОтбор.Значение = Период.ДатаНачала; 
	КонецЕсли;
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("ДатаОкончания");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
		НайденныйОтбор.Значение = Период.ДатаОкончания; 
	КонецЕсли;
	                     
	
	ТекущиеДанныеСпкОпераций = Элементы.СпкОпераций.ТекущиеДанные;
	Если ТекущиеДанныеСпкОпераций = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныйОтбор = Список.Параметры.Элементы.Найти("Операция");
	Если НайденныйОтбор <> Неопределено Тогда
		НайденныйОтбор.Использование = Истина;
		НайденныйОтбор.Значение = ТекущиеДанныеСпкОпераций.Значение; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПользователяНастройкиСинхронизации(НастройкаПодключения)
	
	Результат = "Почта";
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеВводаДаты(Дата, Параметры) Экспорт
    Если НЕ Дата = Неопределено Тогда
		УдалитьЗаписиСервер(Дата);	
		ОбновитьСписокОшибок();
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьЗаписиСервер(ГраницаУдаления)
	
	РегистрыСведений.Б24_К_ЖурналОшибок.УдалитьЗаписиСервер(ГраницаУдаления);
	
КонецПроцедуры 

&НаСервере
Процедура ОбработатьЗаписьОбОшибке(КлючЗаписи, Обработано)
	
	МенеджерЗаписи = РегистрыСведений.Б24_К_ЖурналОшибок.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,КлючЗаписи);
	МенеджерЗаписи.Прочитать();
	МенеджерЗаписи.Обработано = Обработано;
	МенеджерЗаписи.Записать();	
	
КонецПроцедуры

#КонецОбласти
