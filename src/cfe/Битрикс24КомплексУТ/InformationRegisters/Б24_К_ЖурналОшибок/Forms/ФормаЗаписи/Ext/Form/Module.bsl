
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	Если Параметры.Свойство("ДанныеЗаписиОбОшибке") Тогда
		
		ИнформацияОбСообщении = Параметры.ДанныеЗаписиОбОшибке;
	
		Запись.Получатель 				=  ИнформацияОбСообщении.Получатель;
		Запись.НастройкаПодключения 	=  ИнформацияОбСообщении.НастройкаПодключения;
		Запись.Операция 				=  ИнформацияОбСообщении.Операция;
		Запись.ВремяЗапуска 			=  ИнформацияОбСообщении.ВремяЗапуска;
		Запись.НомерСообщения 			=  ИнформацияОбСообщении.НомерСообщения;
		
		Запись.Сообщение 				= ИнформацияОбСообщении.Сообщение;
		Запись.ТипСообщения 			= ИнформацияОбСообщении.ТипСообщения;
		Запись.ДатаСообщения 			= ИнформацияОбСообщении.ДатаСообщения;
		Запись.ОписаниеИзмерения 		= ИнформацияОбСообщении.ОписаниеИзмерения;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы Тогда
		ПометитьКакПрочитанное();    
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПометитьКакПрочитанное()
	
	НаборЗаписей = РегистрыСведений.Б24_К_ЖурналОшибок.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Получатель.Установить(Запись.Получатель);
	НаборЗаписей.Отбор.НастройкаПодключения.Установить(Запись.НастройкаПодключения);
	НаборЗаписей.Отбор.Операция.Установить(Запись.Операция);
	НаборЗаписей.Отбор.ВремяЗапуска.Установить(Запись.ВремяЗапуска);
	НаборЗаписей.Отбор.НомерСообщения.Установить(Запись.НомерСообщения);
	НаборЗаписей.Прочитать();
	
	Для каждого ТекСтрока Из НаборЗаписей Цикл
		ТекСтрока.Просмотрено = Истина;
	КонецЦикла;
	
	НаборЗаписей.Записать();

КонецПроцедуры

