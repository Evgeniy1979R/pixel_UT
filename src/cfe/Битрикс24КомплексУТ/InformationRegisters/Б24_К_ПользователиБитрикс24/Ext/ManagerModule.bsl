
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Логирование

Процедура ЗаданиеКонтроляСопоставленияПользователей() Экспорт      
	
	Выборка = Справочники.Б24_К_НастройкиПодключения.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ПометкаУдаления Тогда Продолжить КонецЕсли;   
			
		Если НЕ Б24_К_СлужебныйВызовСервера.БазовыйМодульДоступен(Выборка.Ссылка) Тогда
			Возврат;	
		КонецЕсли;
		
		СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(Выборка.Ссылка);  
		Если СтруктураНастроек = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СтруктураНастроек.Логирование.Измерение2 = "Загрузка пользователей с портала.";
		
		ЗагрузитьИзБитрикс24(СтруктураНастроек);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьИзБитрикс24(СтруктураНастроек) Экспорт
	
	СтруктураНастроек.Логирование.Измерение2 = "Загрузка сотрудников Битрикс24";
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Портал", СтруктураНастроек.Портал);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ПользователиБитрикс24.Идентификатор КАК Идентификатор,
	|	Б24_К_ПользователиБитрикс24.Пользователь1С КАК Пользователь1С

	|ИЗ
	|	РегистрСведений.Б24_К_ПользователиБитрикс24 КАК Б24_К_ПользователиБитрикс24
	|ГДЕ
	|	Б24_К_ПользователиБитрикс24.Портал = &Портал";
	тзнДанных1С = Запрос.Выполнить().Выгрузить();
	тзнДанных1С.Индексы.Добавить("Идентификатор");
	
	ТзнДанных = Новый ТаблицаЗначений;
	ТзнДанных.Колонки.Добавить("Портал"			, Новый ОписаниеТипов("Строка"));
	ТзнДанных.Колонки.Добавить("Идентификатор"	, Новый ОписаниеТипов("Строка"));
	ТзнДанных.Колонки.Добавить("Наименование"	, Новый ОписаниеТипов("Строка"));
	
	ДанныеПользователей = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/user.get.json", "ID");	
	Для каждого ТекЭлемент Из ДанныеПользователей Цикл
		
		Если ТекЭлемент.Получить("ACTIVE") <> Истина Тогда
			Продолжить;
		КонецЕсли;
		
 		Идентификатор = ТекЭлемент.Получить("ID");
		
		НоваяСтрока = ТзнДанных.Добавить();
		НоваяСтрока.Портал 			= СтруктураНастроек.Портал;
		НоваяСтрока.Идентификатор 	= Идентификатор;
		НоваяСтрока.Наименование 	= Строка(ТекЭлемент.Получить("NAME")) + " " + Строка(ТекЭлемент.Получить("LAST_NAME"));
		
	КонецЦикла;
	
	НаборЗаписей = РегистрыСведений.Б24_К_ПользователиБитрикс24.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Портал.Установить(СтруктураНастроек.Портал);
	
	Для каждого ТекСтрока Из ТзнДанных Цикл
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Портал 			= СтруктураНастроек.Портал; 
		НоваяЗапись.Идентификатор 	= ТекСтрока.Идентификатор; 
		НоваяЗапись.Наименование 	= ТекСтрока.Наименование; 

		НайденнаяСтрока = тзнДанных1С.Найти(ТекСтрока.Идентификатор, "Идентификатор");
		Если НайденнаяСтрока <> Неопределено Тогда НоваяЗапись.Пользователь1С = НайденнаяСтрока.Пользователь1С КонецЕсли; 
		
	КонецЦикла;  
	
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
