			ПараметрыФормы.Вставить("ПолнаяСинхронизация"	, Истина);
			
			ОткрытьФорму("РегистрСведений.Б24_КС_НастройкиСинхронизации.Форма.ФормаВыполнениеСинхронизации", ПараметрыФормы, , ТекущаяСтрока);
			
