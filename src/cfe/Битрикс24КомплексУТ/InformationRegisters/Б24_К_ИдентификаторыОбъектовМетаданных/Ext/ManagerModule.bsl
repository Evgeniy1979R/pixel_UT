
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьИдентификаторОбъектаМетаданных(ОбъектМетаданных) Экспорт   

	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПолноеИмяОбъекта", ОбъектМетаданных.ПолноеИмя());
	Запрос.Текст ="ВЫБРАТЬ
	|	Б24_К_ИдентификаторыОбъектовМетаданных.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыОбъектовМетаданных КАК Б24_К_ИдентификаторыОбъектовМетаданных
	|ГДЕ
	|	Б24_К_ИдентификаторыОбъектовМетаданных.ПолноеИмяОбъекта = &ПолноеИмяОбъекта";    
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если ВыполненныйЗапрос.Пустой() Тогда
		Результат = СоздатьИдентификаторОбъектаМетаданных(ОбъектМетаданных);
	Иначе   
		Выборка = ВыполненныйЗапрос.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Идентификатор;	
	КонецЕсли;
	
	Возврат Формат(Результат, "ЧГ=0");

КонецФункции

Функция СоздатьИдентификаторОбъектаМетаданных(ОбъектМетаданных)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Идентификатор = 0;
	Если ТипКонфигурации = "БП" Тогда
		Если ОбъектМетаданных = Метаданные.Документы.Найти("АктОбОказанииПроизводственныхУслуг") Тогда 
			Идентификатор = 1;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("АктСверкиВзаиморасчетов") Тогда 
			Идентификатор = 2;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ОказаниеУслуг") Тогда 
			Идентификатор = 3;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ОплатаПлатежнойКартой") Тогда 
			Идентификатор = 4;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ПлатежноеПоручение") Тогда 
			Идентификатор = 5;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ПоступлениеНаРасчетныйСчет") Тогда 
			Идентификатор = 6;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ПоступлениеТоваровУслуг") Тогда 
			Идентификатор = 7;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ПриходныйКассовыйОрдер") Тогда 
			Идентификатор = 8;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("РеализацияТоваровУслуг") Тогда 
			Идентификатор = 9;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("СчетНаОплатуПокупателю") Тогда 
			Идентификатор = 10;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("СчетНаОплатуПоставщика") Тогда 
			Идентификатор = 11;		
		КонецЕсли;
	ИначеЕсли ТипКонфигурации = "УТ" Тогда
		Если ОбъектМетаданных = Метаданные.Документы.Найти("АктВыполненныхРабот") Тогда 
			Идентификатор = 1;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ВозвратТоваровОтКлиента") Тогда 
			Идентификатор = 2;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ВозвратТоваровПоставщику") Тогда 
			Идентификатор = 3;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ЗаказПоставщику") Тогда 
			Идентификатор = 4;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ПриходныйКассовыйОрдер") Тогда 
			Идентификатор = 5;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ПоступлениеБезналичныхДенежныхСредств") Тогда 
			Идентификатор = 6;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ОперацияПоПлатежнойКарте") Тогда 
			Идентификатор = 7;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ПриобретениеТоваровУслуг") Тогда 
			Идентификатор = 8;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("РеализацияТоваровУслуг") Тогда 
			Идентификатор = 9;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("ЗаказКлиента") Тогда 
			Идентификатор = 11;	
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("КоммерческоеПредложениеКлиенту") Тогда 
			Идентификатор = 12;	            
		ИначеЕсли ОбъектМетаданных = Метаданные.Документы.Найти("СчетНаОплатуКлиенту") Тогда 
			Идентификатор = 14;	
		КонецЕсли;
	КонецЕсли;
	
	Если Идентификатор = 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ПолноеИмяОбъекта", ОбъектМетаданных.ПолноеИмя());
		Запрос.Текст ="ВЫБРАТЬ
		|	МАКСИМУМ(Б24_К_ИдентификаторыОбъектовМетаданных.Идентификатор) КАК МаксИдентификатор
		|ИЗ
		|	РегистрСведений.Б24_К_ИдентификаторыОбъектовМетаданных КАК Б24_К_ИдентификаторыОбъектовМетаданных";
		ВыполненныйЗапрос = Запрос.Выполнить();  
		Если ВыполненныйЗапрос.Пустой() Тогда
			Идентификатор = 15;	       
		Иначе   
			
			Выборка = ВыполненныйЗапрос.Выбрать();
			Выборка.Следующий();
			МаксИдентификатор = Выборка.МаксИдентификатор;  
			Если ЗначениеЗаполнено(МаксИдентификатор) Тогда
				Если МаксИдентификатор<15 Тогда Идентификатор = 15 Иначе Идентификатор = МаксИдентификатор + 1 КонецЕсли;
			Иначе
				Идентификатор = 15;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НоваяЗапись = РегистрыСведений.Б24_К_ИдентификаторыОбъектовМетаданных.СоздатьМенеджерЗаписи(); 
	НоваяЗапись.ПолноеИмяОбъекта 	= ОбъектМетаданных.ПолноеИмя();	
	НоваяЗапись.Идентификатор 		= Идентификатор;	
	НоваяЗапись.Записать();
	
	Возврат Идентификатор;
	
КонецФункции

#КонецЕсли