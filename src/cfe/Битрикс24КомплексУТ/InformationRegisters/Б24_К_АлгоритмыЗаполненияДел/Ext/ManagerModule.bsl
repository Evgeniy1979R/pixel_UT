#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция АлгоритмДляДела(НастройкаПодключения, Объект) Экспорт
 
	Результат = "";
  
  	Если НЕ ЗначениеЗаполнено(Объект) Тогда
  		Возврат Результат;
  	КонецЕсли;
 
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Б24_К_АлгоритмыЗаполненияДел.Алгоритм КАК Алгоритм
	|ИЗ
	|	РегистрСведений.Б24_К_АлгоритмыЗаполненияДел КАК Б24_К_АлгоритмыЗаполненияДел
	|ГДЕ
	|	Б24_К_АлгоритмыЗаполненияДел.НастройкаПодключения = &НастройкаПодключения
	|	И Б24_К_АлгоритмыЗаполненияДел.ОбъектМетаданных = &ОбъектМетаданных";

	Запрос.УстановитьПараметр("НастройкаПодключения", НастройкаПодключения);
	Запрос.УстановитьПараметр("ОбъектМетаданных", Объект.Метаданные().ПолноеИмя());

	ВыполненныйЗапрос = Запрос.Выполнить();

	Если Не ВыполненныйЗапрос.Пустой() Тогда

		Выборка = ВыполненныйЗапрос.Выбрать();
		Выборка.следующий();

		Результат = Выборка.Алгоритм;

	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецЕсли