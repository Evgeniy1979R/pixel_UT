
#Область ОбработчикиСобытийФормы      

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаПодключения = Параметры.НастройкаПодключения;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
			
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Недоступно в модели сервиса");
		Возврат;
	КонецЕсли;

	Элементы.НастройкаПодключения.Видимость = НЕ ЗначениеЗаполнено(НастройкаПодключения);
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьАлгоритм(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НастройкаПодключения", НастройкаПодключения);
	ОткрытьФорму("РегистрСведений.Б24_К_АлгоритмыЗаполненияДел.Форма.ФормаЗаписи", ПараметрыФормы,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

#КонецОбласти

