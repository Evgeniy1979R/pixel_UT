
#Область ОбработчикиСобытийФормы      

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастройкаПодключения = Параметры.НастройкаПодключения;

	Для Каждого ТекОбъект Из Метаданные.Документы Цикл
		Элементы.ОбъектДела.СписокВыбора.Добавить(ТекОбъект.ПолноеИмя(), "Документ: " + ТекОбъект.Синоним);
	КонецЦикла;

	Для Каждого ТекОбъект Из Метаданные.Справочники Цикл
		Элементы.ОбъектДела.СписокВыбора.Добавить(ТекОбъект.ПолноеИмя(), "Справочник: " + ТекОбъект.Синоним);
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Запись.Алгоритм) Тогда

		Запись.Алгоритм = "//  Пример алгоритма:
						  |
						  |[Результат] = Строка([Объект1С]);";

	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкаПодключения) Тогда
		НастройкаПодключения = Запись.НастройкаПодключения;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.НастройкаПодключения.Видимость = НЕ ЗначениеЗаполнено(НастройкаПодключения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Запись.НастройкаПодключения =  НастройкаПодключения;
	
	Если ЗначениеЗаполнено(Запись.ОбъектМетаданных) Тогда
		Запись.ПредставлениеОбъектаДела = Элементы.ОбъектДела.СписокВыбора.НайтиПоЗначению(Запись.ОбъектМетаданных).Представление;
	Иначе
		
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо выбрать объект метаданных";
		Сообщение.Поле = "Запись.ОбъектМетаданных";
		Сообщение.Сообщить();
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

#КонецОбласти


#Область СобытияЭлементовФормы  

&НаКлиенте
Процедура АлгоритмНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПараметрыОО = Новый Структура;
	ОО = Новый ОписаниеОповещения("ПослеВводаАлгоритмаДела", ЭтотОбъект, ПараметрыОО);

	ПередаваемыеПараметры = Новый Структура;
	ПередаваемыеПараметры.Вставить("Тип"		, "Функция");
	ПередаваемыеПараметры.Вставить("Назначение"	, "Выгрузка");

	Если ЗначениеЗаполнено(Запись.Алгоритм) Тогда
		ПередаваемыеПараметры.Вставить("Алгоритм", Запись.Алгоритм);
	КонецЕсли;

	ОткрытьФорму("ОбщаяФорма.Б24_К_УстановкиАлгоритмов", ПередаваемыеПараметры, , , , , ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаАлгоритмаДела(Алгоритм, пПараметры) Экспорт
	
	Запись.Алгоритм = Алгоритм;
	
КонецПроцедуры

#КонецОбласти  


#Область Прочие  

#КонецОбласти  
