
Процедура ПередЗаписью(Отказ, Замещение)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ХранитьФлагСинхронизированности = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "ХранитьФлагСинхронизированности");
	Если ХранитьФлагСинхронизированности <> Истина Тогда Возврат КонецЕсли;
	
	СвойствоФлагСинхронизацииБитрикс24 = Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.СоздатьПолучитьСвойствоФлагСинхронизацииБитрикс24();
	
	УдаленныеЗаписи 	= Новый Массив;
	ДобавленныеЗаписи 	= Новый Массив;
	
	Если Замещение Тогда
		
		СтарыйНаборЗаписей = РегистрыСведений.Б24_СМ_ИдентификаторыОбъектов.СоздатьНаборЗаписей();
		
		Для Каждого ЗначениеОтбора Из Отбор Цикл
			
			Если ЗначениеОтбора.Использование = Ложь Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаОтбора = СтарыйНаборЗаписей.Отбор.Найти(ЗначениеОтбора.Имя);
			СтрокаОтбора.Значение = ЗначениеОтбора.Значение;
			СтрокаОтбора.Использование = Истина;
			
		КонецЦикла;
		
		СтарыйНаборЗаписей.Прочитать();
		
		
		Для каждого Запись Из СтарыйНаборЗаписей Цикл   
			Если ЗначениеЗаполнено(Запись.ИдентификаторОбъекта) Тогда   
				
				Попытка
				
					ТипОбъекта 		= РегистрыСведений.Б24_СМ_ИдентификаторыОбъектов.ТипОбъектаПоТипуСущностиСП(Запись.ТипСущности1С, Запись.Сущность1С);
					СсылкаНаОбъект 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(ТипОбъекта, Запись.ИдентификаторОбъекта);	
						
					УдаленныеЗаписи.Добавить(СсылкаНаОбъект);  
					
				Исключение
				КонецПопытки;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого Запись Из ЭтотОбъект Цикл     
		Если ЗначениеЗаполнено(Запись.ИдентификаторОбъекта) Тогда 
			
			Попытка
				
				ТипОбъекта 		= РегистрыСведений.Б24_СМ_ИдентификаторыОбъектов.ТипОбъектаПоТипуСущностиСП(Запись.ТипСущности1С, Запись.Сущность1С);
				СсылкаНаОбъект 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоXML(ТипОбъекта, Запись.ИдентификаторОбъекта);	
				
				ДобавленныеЗаписи.Добавить(СсылкаНаОбъект);      
				
			Исключение
			КонецПопытки;
			
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого ТекЭлемент Из УдаленныеЗаписи Цикл     
		
		НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(ТекЭлемент);
		НаборЗаписей.Отбор.Свойство.Установить(СвойствоФлагСинхронизацииБитрикс24);
		НаборЗаписей.Прочитать();
		
		НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
	Для каждого ТекЭлемент Из ДобавленныеЗаписи Цикл
		
		НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(ТекЭлемент);
		НаборЗаписей.Отбор.Свойство.Установить(СвойствоФлагСинхронизацииБитрикс24);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		НовоеСвойство = НаборЗаписей.Добавить();
		НовоеСвойство.Объект = ТекЭлемент;
		НовоеСвойство.Свойство = СвойствоФлагСинхронизацииБитрикс24;
		НовоеСвойство.Значение = Истина;
		
		НаборЗаписей.ДополнительныеСвойства.Вставить("ЗагрузкаСБитрикс24", Истина);
		НаборЗаписей.Записать(); 
		
	КонецЦикла;
	
КонецПроцедуры
