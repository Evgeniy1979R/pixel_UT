
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Логирование

Процедура УдалениеЛогаСервер(Дата) Экспорт
   	
	ДатаКонца = НачалоДня(Дата);
	
	МассивЗаписейНаУдаление = Новый Массив;
	НаборЗаписей = РегистрыСведений.Б24_К_ЛогиИИ.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	Для Каждого Запись из НаборЗаписей Цикл
		Если Запись.МоментВремени<=Дата(ДатаКонца) Тогда
			МассивЗаписейНаУдаление.Добавить(Запись);    
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекЗап Из МассивЗаписейНаУдаление Цикл
		НаборЗаписей.Удалить(ТекЗап);
	КонецЦикла;				
	НаборЗаписей.Записать(Истина);
				
КонецПроцедуры

#КонецОбласти

#КонецЕсли
