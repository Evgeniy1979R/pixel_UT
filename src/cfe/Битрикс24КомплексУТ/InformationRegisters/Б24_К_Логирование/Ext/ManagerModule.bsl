
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Логирование

Процедура ЗаданиеПроверитьУдалитьИсториюОбменов() Экспорт
	
	ОбщиеНастройки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки");
	Если ОбщиеНастройки <> Неопределено И ОбщиеНастройки.РежимОтладки = Истина Тогда
		ДатаВключенияРежимаОтладки = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ДатаВключенияРежимаОтладки");
		ВремяРаботыРежимаОтладки = 60*60*24;
		Если ДатаВключенияРежимаОтладки = Неопределено ИЛИ ДатаВключенияРежимаОтладки < ТекущаяДатаСеанса() - ВремяРаботыРежимаОтладки Тогда
			ОбщиеНастройки.РежимОтладки = Ложь;
			Б24_К_ОбщегоНазначенияВызовСервера.УстановитьЗначениеВХранилищаНастроек("ОбщиеНастройки", ОбщиеНастройки);
		КонецЕсли;
	КонецЕсли;

	ОбрезатьИсториюОбменов = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "ОбрезатьИсториюОбменов");
	Если НЕ ОбрезатьИсториюОбменов = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ВидПериода = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "ВидПериодаУдаленияИстории");
	Если ВидПериода = Неопределено Тогда ВидПериода = "Дней" КонецЕсли;
	
	ЧислоДнейХраненияИстории = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "ЧислоДнейХраненияИстории"); //старая настройка
	ЧислоХраненияИстории = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "ЧислоХраненияИстории");
	Если ЧислоХраненияИстории = Неопределено Тогда ЧислоХраненияИстории = ЧислоДнейХраненияИстории КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЧислоХраненияИстории) Тогда ЧислоХраненияИстории = 7 КонецЕсли;
	
	ОбрезатьЛог(ВидПериода, ЧислоХраненияИстории);
	
КонецПроцедуры

Процедура ОбрезатьЛог(ВидПериода, ЧислоХраненияИстории)
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	Б24_К_Логирование.МоментВремени КАК МоментВремени,
	|	Б24_К_Логирование.НастройкаПодключения КАК НастройкаПодключения
	|ИЗ
	|	РегистрСведений.Б24_К_Логирование КАК Б24_К_Логирование
	|
	|СГРУППИРОВАТЬ ПО
	|	Б24_К_Логирование.МоментВремени,
	|	Б24_К_Логирование.НастройкаПодключения
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Если ВидПериода = "Дней" Тогда
			ДатаКонца = НачалоДня(ТекущаяДатаСеанса())- 60*60*24*ЧислоХраненияИстории;
		Иначе
			ДатаКонца = НачалоЧаса(ТекущаяДатаСеанса())- 60*60*ЧислоХраненияИстории;
		КонецЕсли;
		
		Выборка = ВыполненныйЗапрос.Выбрать(); 
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.МоментВремени <= ДатаКонца Тогда
				
				НаборЗаписей = СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.МоментВремени.Установить(Выборка.МоментВремени);
				НаборЗаписей.Отбор.НастройкаПодключения.Установить(Выборка.НастройкаПодключения);
				
				НаборЗаписей.Записать();
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьИзмеренияЛогирования(СтруктураНастроек) Экспорт
	
	СтруктураНастроек.Логирование.Измерение1 = "";
	СтруктураНастроек.Логирование.Измерение2 = "";
	СтруктураНастроек.Логирование.Измерение3 = "";
	СтруктураНастроек.Логирование.Измерение4 = "";
	СтруктураНастроек.Логирование.Измерение5 = "";
	СтруктураНастроек.Логирование.Измерение6 = "";
	
КонецПроцедуры

Процедура СохранитьРасписаниеОчисткиИсторииСинхронизации(ОбрезатьИсториюОбменов, ВидПериода = "Дней") Экспорт
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		Возврат;
	КонецЕсли;
	
	ИменаИспользуемыхРеглЗаданий 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИменаИспользуемыхРеглЗаданий();
	СтруктураРеглЗаданий 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИспользуемыеРеглЗадания();	
	
УстановитьПривилегированныйРежим(Истина); //Для возможности всем пользователям с правами устанавливать расписания	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", ИменаИспользуемыхРеглЗаданий.ОчисткаЛога);		
	Если ОбщегоНазначения.РазделениеВключено() Тогда		
		Отбор.Вставить("ОбластьДанных", ПараметрыСеанса.ОбластьДанныхЗначение);			
	КонецЕсли;	
	
	НайденныеРеглЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);	
	
	ПараметрыЗапуска = Новый Массив();
	ПараметрыЗапуска.Добавить(СтруктураРеглЗаданий.ОчисткаЛога);
	ПараметрыЗапуска.Добавить(Неопределено);
	
	
	РасписаниеРегламентногоЗаданияУдаленияЛога = Новый РасписаниеРегламентногоЗадания;
	РасписаниеРегламентногоЗаданияУдаленияЛога.ПериодПовтораДней = 1;
	РасписаниеРегламентногоЗаданияУдаленияЛога.ПериодНедель = 1;
	
	мДниРасписания = Новый Массив;
	мДниРасписания.Добавить(1);
	мДниРасписания.Добавить(2);
	мДниРасписания.Добавить(3);
	мДниРасписания.Добавить(4);
	мДниРасписания.Добавить(5);
	мДниРасписания.Добавить(6);
	мДниРасписания.Добавить(7);
	
	РасписаниеРегламентногоЗаданияУдаленияЛога.ДниНедели = мДниРасписания;     
	
	Если ВидПериода = "Часов" Тогда
		РасписаниеРегламентногоЗаданияУдаленияЛога.ПериодПовтораВТечениеДня = 3600;
	КонецЕсли;
	
	Если НайденныеРеглЗадания.Количество() = 0 Тогда	
		
		Если ОбрезатьИсториюОбменов Тогда			
			
			ПараметрыЗадания = Новый Структура();
			ПараметрыЗадания.Вставить("Метаданные"					, Метаданные.РегламентныеЗадания.ЗапускДополнительныхОбработок);
			ПараметрыЗадания.Вставить("Наименование"				, ИменаИспользуемыхРеглЗаданий.ОчисткаЛога);
			ПараметрыЗадания.Вставить("Ключ"						, ИменаИспользуемыхРеглЗаданий.ОчисткаЛога);
			ПараметрыЗадания.Вставить("Использование"				, Истина);
			ПараметрыЗадания.Вставить("ЭксклюзивноеВыполнение"		, Ложь);
			ПараметрыЗадания.Вставить("Параметры"					, ПараметрыЗапуска);
			ПараметрыЗадания.Вставить("Расписание"					, РасписаниеРегламентногоЗаданияУдаленияЛога);		
			ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
			ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);
			
			РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);	
		
		КонецЕсли;
		
	Иначе
	
		ПараметрыИзмененияЗадания = Новый Структура();
		ПараметрыИзмененияЗадания.Вставить("Использование"	, Истина);
		ПараметрыИзмененияЗадания.Вставить("Параметры"		, ПараметрыЗапуска);
		ПараметрыИзмененияЗадания.Вставить("Расписание"		, РасписаниеРегламентногоЗаданияУдаленияЛога);
		ПараметрыИзмененияЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении"		, 0);
		ПараметрыИзмененияЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении"	, 0);		
		
		Если ОбрезатьИсториюОбменов И НЕ Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
		Иначе
			ПараметрыИзмененияЗадания.Использование = Ложь;
			РегламентныеЗаданияСервер.ИзменитьЗадание(НайденныеРеглЗадания[0].УникальныйИдентификатор, ПараметрыИзмененияЗадания);			
		КонецЕсли;
		
	КонецЕсли;
УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура УдалениеЛогаСервер(Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	Б24_К_Логирование.МоментВремени КАК МоментВремени,
	|	Б24_К_Логирование.НастройкаПодключения КАК НастройкаПодключения
	|ИЗ
	|	РегистрСведений.Б24_К_Логирование КАК Б24_К_Логирование
	|
	|СГРУППИРОВАТЬ ПО
	|	Б24_К_Логирование.МоментВремени,
	|	Б24_К_Логирование.НастройкаПодключения
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		ДатаКонца = НачалоДня(Дата);
		
		Выборка = ВыполненныйЗапрос.Выбрать(); 
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.МоментВремени <= ДатаКонца Тогда
				
				НаборЗаписей = РегистрыСведений.Б24_К_Логирование.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.МоментВремени.Установить(Выборка.МоментВремени);
				НаборЗаписей.Отбор.НастройкаПодключения.Установить(Выборка.НастройкаПодключения);
				
				НаборЗаписей.Записать();
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

