
#Область ОбработчикиСобытийФормы   

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаПодключения = Параметры.НастройкаПодключения;    
	
	ОбновитьТриггерыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	Если НЕ Б24_К_СлужебныйВызовСервера.МодульАвтоматизацииДоступен(НастройкаПодключения) Тогда
		Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаАвтоматизацииПоТарифномуПлану();
		Закрыть();	
	КонецЕсли;                          
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОбновить(Команда)  
	ОбновитьТриггерыНаСервере();
КонецПроцедуры 


&НаКлиенте
Процедура УдалитьТриггер(Команда)  
	
	ВыполнитьАсинхронноУдалитьТриггер();

КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьАсинхронноУдалитьТриггер()  
	
	ТекущиеДанныеТЧ = Элементы.ТриггерыБитрикс24.ТекущиеДанные;
	Если ТекущиеДанныеТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    Ответ = Ждать ВопросАсинх("Вы точно хотите удалить триггер?", РежимДиалогаВопрос.ДаНет, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;	
	
	УдалитьТриггераНаСервере(ТекущиеДанныеТЧ.Код);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьТриггераНаСервере(Код)   
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	Метод 			= "/rest/crm.automation.trigger.delete";
	ТелоHTTPЗапроса = "CODE=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Код);	
	
	Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 

	ОбновитьТриггерыНаСервере();
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьТриггер(Команда)   
	
	ВыполнитьАсинхронноДобавитьТриггер();

КонецПроцедуры    

&НаКлиенте
Асинх Процедура ВыполнитьАсинхронноДобавитьТриггер()  
	
	НастройкиТриггеров = ПолучитьНастройкиТриггеров();
	
	спкТриггеры = Новый СписокЗначений;
	Для каждого ТекНастройка Из НастройкиТриггеров Цикл
		спкТриггеры.Добавить(ТекНастройка.Имя, ТекНастройка.Название);	
	КонецЦикла;
	
	ИмяТриггера = Ждать спкТриггеры.ВыбратьЭлементАсинх("Выберите вид триггера");
	Если ИмяТриггера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	спкДокументыТриггеров = Новый СписокЗначений;
	Для каждого ТекНастройка Из НастройкиТриггеров Цикл
		Если ТекНастройка.Имя = ИмяТриггера.Значение Тогда
			
			Для каждого ТекДокумент Из ТекНастройка.Документы Цикл
				спкДокументыТриггеров.Добавить(ТекДокумент.ИдДокумента, ТекДокумент.Название);
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	ИмяДокумента = Ждать спкДокументыТриггеров.ВыбратьЭлементАсинх("Укажите тип документа 1С");
	Если ИмяДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ИмяДокумента.Значение) Тогда  
		ИдОбъектаМетаданных = ИмяДокумента.Значение; 
	Иначе 
		ИдОбъектаМетаданных = ПолучитьИдентификаторОбъектаМетаданных(ИмяДокумента.Представление);	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдОбъектаМетаданных) Тогда
		Возврат;
	КонецЕсли;
		
	ИдентификаторПодключения = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(НастройкаПодключения, "ИдентификаторПодключения");
	
	КодТриггера = ИдентификаторПодключения + "_" + ИмяТриггера.Значение + "_" + ИдОбъектаМетаданных;
	
	ИмяТриггера = "("+ИдентификаторПодключения+") " + ИмяТриггера.Представление + " (" + ИмяДокумента.Представление + ")";
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Метод 			= "/rest/crm.automation.trigger.add";
	ТелоHTTPЗапроса = "CODE=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КодТриггера) + "&NAME=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИмяТриггера);	
	
	Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
	
	ОбновитьТриггерыНаСервере();
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры    

&НаСервере
Функция ПолучитьИдентификаторОбъектаМетаданных(ПредставлениеОбъекта)
	
	ИмяОбъекта = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьИмяОбъектаПоСинониму(ПредставлениеОбъекта);
	Если НЕ ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрНайти(ПредставлениеОбъекта, "Документ: ") > 0 Тогда   
		ПолноеИмяОбъекта = "Документ."+ИмяОбъекта;
	ИначеЕсли СтрНайти(ПредставлениеОбъекта, "Справочник: ") > 0 Тогда   
		ПолноеИмяОбъекта = "Справочник."+ИмяОбъекта;  
	Иначе
		ПолноеИмяОбъекта = "Документ."+ИмяОбъекта;
	КонецЕсли;
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	
	Возврат РегистрыСведений.Б24_К_ИдентификаторыОбъектовМетаданных.ПолучитьИдентификаторОбъектаМетаданных(ОбъектМетаданных);

КонецФункции  

#КонецОбласти


#Область СобытияЭлементовФормы  

#КонецОбласти     

#Область Прочие  

&НаСервере
Процедура ОбновитьТриггерыНаСервере()
	
	ТриггерыБитрикс24.Очистить();
	
    СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
    Если СтруктураНастроек = Неопределено Тогда
    	Возврат;
    КонецЕсли;
    
    ИдентификаторПодключения 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(НастройкаПодключения, "ИдентификаторПодключения");
    
    Метод 			= "/rest/crm.automation.trigger.list";
	ТелоHTTPЗапроса = "";	
    СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
    Если СтруктураОтвета <> Неопределено Тогда
    	
    	result = СтруктураОтвета.Получить("result");	
    	Если result <> Неопределено Тогда
			Для каждого ТекЭлемент Из result Цикл   
				
				КодТриггера = ТекЭлемент.Получить("CODE");
				Если Лев(КодТриггера, СтрДлина(ИдентификаторПодключения)+1)= ИдентификаторПодключения + "_" Тогда
					НоваяСтрока = ТриггерыБитрикс24.Добавить();
					НоваяСтрока.Код 			= КодТриггера;
					НоваяСтрока.Наименование 	= ТекЭлемент.Получить("NAME");
				КонецЕсли;
				
    		КонецЦикла;
    	
    	КонецЕсли;	                                                   
    КонецЕсли;
    
    Следующие = СтруктураОтвета.Получить("next"); 
    Пока ЗначениеЗаполнено(Следующие) Цикл
    	
    	Следующие = Формат(Следующие, "ЧГ=0");

    	ТелоHTTPЗапроса = "&start="+Следующие;	
    	
    	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
    	Если СтруктураОтвета = Неопределено Тогда
    		Прервать;
    	КонецЕсли;
    	
    	result = СтруктураОтвета.Получить("result");
    	Если result <> Неопределено Тогда
    		Для каждого ТекЭлемент Из result Цикл
				
				КодТриггера = ТекЭлемент.Получить("CODE");
				Если Лев(КодТриггера, СтрДлина(ИдентификаторПодключения)+1)= ИдентификаторПодключения + "_" Тогда
					НоваяСтрока = ТриггерыБитрикс24.Добавить();
					НоваяСтрока.Код 			= КодТриггера;
					НоваяСтрока.Наименование 	= ТекЭлемент.Получить("NAME");
				КонецЕсли;
				
    		КонецЦикла;
    	КонецЕсли;
    	
       Следующие = СтруктураОтвета.Получить("next");
       
   КонецЦикла;  
  
   ОбновитьСписокЗарегистрированныхТриггеров();
   
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЗарегистрированныхТриггеров()
    
	мДанные = Новый Массив;
	Для каждого ТекЭлемент Из ТриггерыБитрикс24 Цикл
		
		ОписаниеДанных = Новый Структура;
		
		ОписаниеДанных.Вставить("Код"			, ТекЭлемент.Код);
		ОписаниеДанных.Вставить("Наименование"	, ТекЭлемент.Наименование);
		
		мДанные.Добавить(ОписаниеДанных);
		
	КонецЦикла;
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НастройкаПодключения, "ИдентификаторПодключения, Портал");
	
	Б24_КА_РоботыИТриггерыСервер.ОбновитьСписокЗарегистрированныхТриггеров(РеквизитыОбъекта.ИдентификаторПодключения, РеквизитыОбъекта.Портал, мДанные);

КонецПроцедуры

&НаСервере
Функция ПолучитьНастройкиТриггеров()
	
	Возврат Б24_КА_РоботыИТриггерыСервер.ПолучитьНастройкиТриггеров();
	
КонецФункции        

#КонецОбласти

