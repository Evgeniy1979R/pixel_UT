
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресНавигационнойСсылки") Тогда
		АдресНавигационнойСсылки = Параметры.АдресНавигационнойСсылки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(АдресНавигационнойСсылки) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	
	Если Лев(АдресНавигационнойСсылки, 6) = "Отчет." Тогда
		Типовой = Истина;
		ИмяОтчета = Прав(АдресНавигационнойСсылки, СтрДлина(АдресНавигационнойСсылки)-6);    

	Иначе                 
		
		ИмяОтчета = Прав(АдресНавигационнойСсылки, СтрДлина(АдресНавигационнойСсылки)-18);    
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Наименование", ИмяОтчета);
		Запрос.Текст = "ВЫБРАТЬ
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.Наименование = &Наименование
		|	И ДополнительныеОтчетыИОбработки.Публикация <> ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена)
		|	И ДополнительныеОтчетыИОбработки.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет)
		|	И ДополнительныеОтчетыИОбработки.ПометкаУдаления = ЛОЖЬ";            
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПроизвольныйОтчет = Выборка.Ссылка;	
		КонецЦикла;
		
	КонецЕсли;
	
	Если Параметры.Свойство("СессияБитрикс24") Тогда
		СессияБитрикс24 = Параметры.СессияБитрикс24;
	КонецЕсли;
	
	Если Параметры.Свойство("НастройкаПодключения") Тогда
		НастройкаПодключения = Параметры.НастройкаПодключения;
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ИмяОтчета) Тогда
		ПоказатьПредупреждение(, "Не определен объект 1С. Необходимо перевыгрузить встройки интеграции сервисов",,"Ошибка");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СессияБитрикс24) Тогда
		ПодключитьОбработчикОжидания("Б24_КБ_ПроверитьДанныеБитрикс24", 2, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Б24_КБ_ПроверитьДанныеБитрикс24()
	
	СчетчикПроверок = СчетчикПроверок + 1;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СессияБитрикс24"		, СессияБитрикс24);
	ДополнительныеПараметры.Вставить("НастройкаПодключения"	, НастройкаПодключения);    		
	
	Результат = Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьДанные(СессияБитрикс24);
	
	Если НЕ Результат.ДанныеПолучены И СчетчикПроверок < 5 Тогда  
		
		ПодключитьОбработчикОжидания("Б24_КБ_ПроверитьДанныеБитрикс24", 2, Истина);
		
	ИначеЕсли Результат.ДанныеПолучены  Тогда
		
		ОтключитьОбработчикОжидания("Б24_КБ_ПроверитьДанныеБитрикс24");
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияОтчета", ЭтотОбъект, ДополнительныеПараметры);  
		
		Если Типовой Тогда
			
			ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
			Если ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" ИЛИ ТипКонфигурации = "УНФ" Тогда
				Если Результат.Свойство("Контрагент") И ИмяОтчета <> "АнализДоступности" Тогда
					УсловияОтбора = Новый Структура("Контрагент", Результат.Контрагент);
				Иначе
					УсловияОтбора = Неопределено;
				КонецЕсли;
			ИначеЕсли ТипКонфигурации = "УТ" Тогда
				Если Результат.Свойство("Партнер") И ИмяОтчета <> "ОстаткиИДоступностьТоваров" Тогда
					УсловияОтбора = Новый Структура("Партнер", Результат.Партнер);
				Иначе
					УсловияОтбора = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			Если УсловияОтбора = Неопределено Тогда
				ПараметрыФормы = Новый Структура("СформироватьПриОткрытии", Истина);
			Иначе
				ПараметрыФормы = Новый Структура("Отбор, СформироватьПриОткрытии", УсловияОтбора, Истина);
			КонецЕсли;
			
			Форма = ОткрытьФорму("Отчет."+ИмяОтчета+".ФормаОбъекта", ПараметрыФормы,,,,,ОписаниеОповещения);    
			
		Иначе 
			
			Если ЗначениеЗаполнено(ПроизвольныйОтчет) Тогда
				ПараметрыОбработки = Новый Структура("СформироватьПриОткрытии, ИдентификаторКоманды, ДополнительнаяОбработкаСсылка, ИмяФормы, КлючСессии");
				ПараметрыОбработки.СформироватьПриОткрытии       = Истина;
				ПараметрыОбработки.ДополнительнаяОбработкаСсылка = ПроизвольныйОтчет;
				ПараметрыОбработки.ИмяФормы                      = Неопределено;
				ПараметрыОбработки.КлючСессии 					 = ПроизвольныйОтчет.УникальныйИдентификатор();
							
				ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ПроизвольныйОтчет);
				ОткрытьФорму("ВнешнийОтчет." + ИмяОбработки + ".Форма", ПараметрыОбработки, Форма,,,,ОписаниеОповещения);
			КонецЕсли;
			
		КонецЕсли;
			
		Закрыть(); 
		
	Иначе    
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияОтчета", ЭтотОбъект, ДополнительныеПараметры);  
		Если Типовой Тогда
			ПараметрыФормы = Новый Структура("СформироватьПриОткрытии", Истина);
			Форма = ОткрытьФорму("Отчет."+ИмяОтчета+".ФормаОбъекта", ПараметрыФормы,,,,,ОписаниеОповещения);    
		Иначе 
			
			Если ЗначениеЗаполнено(ПроизвольныйОтчет) Тогда
				ПараметрыОбработки = Новый Структура("СформироватьПриОткрытии, ИдентификаторКоманды, ДополнительнаяОбработкаСсылка, ИмяФормы, КлючСессии");
				ПараметрыОбработки.СформироватьПриОткрытии       = Истина;
				ПараметрыОбработки.ДополнительнаяОбработкаСсылка = ПроизвольныйОтчет;
				ПараметрыОбработки.ИмяФормы                      = Неопределено;
				ПараметрыОбработки.КлючСессии 					 = ПроизвольныйОтчет.УникальныйИдентификатор();
							
				ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ПроизвольныйОтчет);
				ОткрытьФорму("ВнешнийОтчет." + ИмяОбработки + ".Форма", ПараметрыОбработки, Форма,,,,ОписаниеОповещения);
			КонецЕсли;
			
		КонецЕсли;
			
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗакрытияОтчета(Результат, ДополнительныеПараметры) Экспорт

	Б24_КБ_РаботаИзОдногоОкнаКлиент.ЗакрытиеСлайдера(ДополнительныеПараметры.СессияБитрикс24, ДополнительныеПараметры.НастройкаПодключения);  
	Закрыть();
	
КонецПроцедуры
