&НаКлиенте
Процедура ВыгрузкаНастройки(СтруктураНастроек, ЗакрытьПоОкончании)
	
	ДлительнаяОперацияЗавершение = Новый ОписаниеОповещения("ПослеВыгрузкиНастроек", ЭтотОбъект, ЗакрытьПоОкончании);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения             = "Выполняется выгрузка настроек..";
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.ВыводитьОкноОжидания       = Истина;
	ПараметрыОжидания.ВыводитьСообщения          = Истина;
	
	ДлительнаяОперация = НачатьВыгрузкуНастройки(СтруктураНастроек);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ДлительнаяОперацияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыгрузкиНастроек(Результат, ПараметрыВыгрузки) Экспорт
	
	Если Результат <> Неопределено Тогда
		Модифицированность = Ложь;
	КонецЕсли;
	
	Если ПараметрыВыгрузки = Истина Тогда
		Закрыть();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НачатьВыгрузкуНастройки(СтруктураНастроек)
	
	УникальныйИдентификаторЗадания = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификаторЗадания);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Выгрузка настроек Битрикс24";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("НастройкаПодключения"	, НастройкаПодключения);
	ПараметрыВыгрузки.Вставить("Наименование"			, Строка(НастройкаПодключения));
	ПараметрыВыгрузки.Вставить("СтруктураНастроек"		, СтруктураНастроек);
	ПараметрыВыгрузки.Вставить("ВстройкиСсылочныхДанных", ВстройкиСсылочныхДанных.Выгрузить());
	ПараметрыВыгрузки.Вставить("ВстройкиОтчетов"		, ВстройкиОтчетов.Выгрузить());
	                                 
	Возврат ДлительныеОперации.ВыполнитьВФоне("РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ВыгрузитьНастройкиВФоне", ПараметрыВыгрузки, ПараметрыВыполнения);
	
КонецФункции

#КонецОбласти


#Область Прочие

&НаКлиенте
Процедура ОбновитьОтображениеЭлементовФормы()	
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Элементы.ГруппаРаботаИзОдногоОкнаПодробно.Видимость = РаботаИзОдногоОкна;
	
	Если ТипКонфигурации = "ЗУП" Тогда
		Возврат;	
	КонецЕсли;
	
	Элементы.ГруппаНастройки1СПАРКРиски.Доступность 	= ИспользоватьСервис1СПАРКРиски;
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
		
		СинхронизацияДоступна = Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения);
		
		Если СинхронизацияДоступна И Элементы.СпособЗагрузкиКлиентов.СписокВыбора.НайтиПоЗначению("Через подсистему синхронизации") = Неопределено Тогда
			Элементы.СпособЗагрузкиКлиентов.СписокВыбора.Добавить("Через подсистему синхронизации", "Через подсистему синхронизации");	
		КонецЕсли;
		
		Элементы.ДекорацияВозможности.Видимость	= НЕ СинхронизацияДоступна;
		Элементы.ГруппаСинхронизация.Видимость 	= СинхронизацияДоступна;
		
	КонецЕсли;
	
	Элементы.ГруппаКонтрагенты.Видимость = СпособЗагрузкиКлиентов = "Через интеграцию сервисов";
	
	Элементы.СпособВыгрузкиКлиентов.Видимость 				= БитриксПоиск;
	Элементы.НазваниеВстройкиБитриксПоиск.Видимость 		= БитриксПоиск;
	
	Если Б24_К_СлужебныйВызовСервера.МодульБитриксПоискДоступен(НастройкаПодключения) Тогда
		Элементы.ОТарифеБитриксПоиск.Видимость = Ложь;
	Иначе
		Элементы.БитриксПоиск.Доступность = Ложь;
		Элементы.ГруппаНастройкиБитриксПоиск.Доступность = Ложь;
	КонецЕсли;                          
	
	Если Б24_К_СлужебныйВызовСервера.МодульСПАРКДоступен(НастройкаПодключения) Тогда
		Элементы.ОТарифеСПАРК.Видимость = Ложь;
	Иначе
		Элементы.ИспользоватьСервис1СПАРКРиски.Доступность 	= Ложь;
		Элементы.ГруппаНастройки1СПАРКРиски.Доступность 	= Ложь;
	КонецЕсли;                          
	
КонецПроцедуры


&НаСервере
Функция ПолучитьСписокТиповДляВыбора(Назначение)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Результат = Неопределено;
	
	Если Назначение = "Документ" Тогда   
		
		Результат = Новый СписокЗначений;
		Для каждого ТекЭлемент Из Метаданные.Документы Цикл  
			Если Лев(ТекЭлемент.Имя, 7) <> "Удалить" Тогда
				Результат.Добавить(ТекЭлемент.Имя, ТекЭлемент.Синоним); 
				Если ТекЭлемент.Имя = "ЗаказПокупателя" Тогда
					Результат.Добавить("ЗаказПокупателяНаряд", "Заказ покупателя Наряд");  
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Назначение = "Справочник" Тогда  
		
		Результат = Новый СписокЗначений;
		Для каждого ТекЭлемент Из Метаданные.Справочники Цикл      
			Если Лев(ТекЭлемент.Имя, 7) <> "Удалить" Тогда
				Результат.Добавить(ТекЭлемент.Имя, ТекЭлемент.Синоним); 
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Назначение = "Отчет" Тогда  
		
		Результат = Новый СписокЗначений;
		Для каждого ТекЭлемент Из Метаданные.Отчеты Цикл        
			Если Лев(ТекЭлемент.Имя, 7) <> "Удалить" Тогда
				Результат.Добавить(ТекЭлемент.Имя, ТекЭлемент.Синоним); 
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Назначение = "ПроизвольныйОтчет" Тогда  
		
		Результат = Новый СписокЗначений;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ДополнительныеОтчетыИОбработки.Наименование КАК Наименование,
		|	ДополнительныеОтчетыИОбработки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
		|ГДЕ
		|	ДополнительныеОтчетыИОбработки.Публикация <> ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена)
		|	И ДополнительныеОтчетыИОбработки.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет)
		|	И ДополнительныеОтчетыИОбработки.ПометкаУдаления = ЛОЖЬ";            
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции      

&НаСервере
Процедура ЗаполнитьТаблицуСмартПроцессов()

	Если НЕ ЗначениеЗаполнено(НастройкаПодключения) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтруктураНастроек.Логирование.Измерение2 = "Получение списка смарт процессов";
	
	ДанныеПортала = Б24_К_RestApiВызовСервера.ПолучитьМассивДанныхСПорталаЧерезСписок(СтруктураНастроек, "/rest/crm.type.list", "id", "", "types");
	Для каждого ТекЭлемент Из ДанныеПортала Цикл
		НоваяСтрока = СмартПроцессы.Добавить();
		НоваяСтрока.Ид 				= Формат(ТекЭлемент.Получить("id"), "ЧГ=0");
		НоваяСтрока.Наименование 	= ТекЭлемент.Получить("title"); 
		НоваяСтрока.ТипВладельца 	= Формат(ТекЭлемент.Получить("entityTypeId"), "ЧГ=0"); 
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВстройкиПоУмолчаниюНаСервере(ВидДанных)
	
	Если ВидДанных = "Ссылка" Тогда     
		ВстройкиСсылочныхДанных.Загрузить(РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ЗаполнитьВстройкиПоУмолчанию(ВидДанных));
	ИначеЕсли ВидДанных = "Отчет" Тогда   
		ВстройкиОтчетов.Загрузить(РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ЗаполнитьВстройкиПоУмолчанию(ВидДанных));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти  

 
#Область Встройки
 
&НаКлиенте
Процедура ЗаполнитьВстройкиПоУмолчаниюО(Команда)
	
	ЗаполнитьВстройкиПоУмолчаниюНаСервере("Отчет");
	
	Модифицированность 			= Истина;
	ВыгружатьНастройкиНаПортал 	= Истина; 
	
КонецПроцедуры
 
&НаКлиенте
Процедура ЗаполнитьВстройкиПоУмолчаниюС(Команда)
	
	ЗаполнитьВстройкиПоУмолчаниюНаСервере("Ссылка");
	
	Модифицированность 			= Истина;
	ВыгружатьНастройкиНаПортал 	= Истина;  
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьВстройку(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	
	Если Команда.Имя = "ДобавитьВстройкуО" Тогда        
		
		Режим = РежимДиалогаВопрос.ДаНет;       
		ДополнительныеПараметры.Вставить("Вид", "Отчет");
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОВыбореНазначения", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, "Выбрать из типового отчета?", Режим, 0);
		
	ИначеЕсли Команда.Имя = "ДобавитьВстройкуС" Тогда  
		
		Режим = РежимДиалогаВопрос.ДаНет;     
		ДополнительныеПараметры.Вставить("Вид", "Ссылка");
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОВыбореНазначения", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, "Выбрать из документов?", Режим, 0);
		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОВыбореНазначения(Результат, ДополнительныеПараметры) Экспорт

	СписокВыбора = Неопределено;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ДополнительныеПараметры.Вид = "Ссылка" Тогда    
			СписокВыбора = ПолучитьСписокТиповДляВыбора("Документ");  
			ДополнительныеПараметры.Вставить("Назначение", "Документ");
		ИначеЕсли ДополнительныеПараметры.Вид = "Отчет" Тогда  
			СписокВыбора = ПолучитьСписокТиповДляВыбора("Отчет"); 
			ДополнительныеПараметры.Вставить("Назначение", "Отчет");
	    КонецЕсли;
	Иначе
		Если ДополнительныеПараметры.Вид = "Ссылка" Тогда    
			СписокВыбора = ПолучитьСписокТиповДляВыбора("Справочник");
			ДополнительныеПараметры.Вставить("Назначение", "Справочник");
		ИначеЕсли ДополнительныеПараметры.Вид = "Отчет" Тогда 
			СписокВыбора = ПолучитьСписокТиповДляВыбора("ПроизвольныйОтчет"); 
			ДополнительныеПараметры.Вставить("Назначение", "ПроизвольныйОтчет");
	    КонецЕсли;
	КонецЕсли;    
	
	Если НЕ СписокВыбора = Неопределено Тогда
		Оп = Новый ОписаниеОповещения("ПослеВыбораОбъектаДляВстройки", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВыборИзСписка(Оп, СписокВыбора, ?(ДополнительныеПараметры.Вид = "Ссылка", Элементы.ВстройкиСсылочныхДанныхПредставлениеВстройки, Элементы.ВстройкиОтчетовПредставлениеВстройки));
	КонецЕсли;
	


КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОбъектаДляВстройки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт    

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ИндексСтроки = Неопределено;

	Если ДополнительныеПараметры.Вид = "Ссылка" Тогда      
		
		НайденныеСтроки = ВстройкиСсылочныхДанных.НайтиСтроки(Новый Структура("ТипОбъекта, ИмяОбъекта", ДополнительныеПараметры.Назначение, ВыбранныйЭлемент.Значение));
		Если НайденныеСтроки.Количество()> 0 Тогда
			Возврат;
		КонецЕсли;
		
		НоваяСтрока = ВстройкиСсылочныхДанных.Добавить();
		НоваяСтрока.ТипОбъекта 	= ДополнительныеПараметры.Назначение; 
		НоваяСтрока.ИмяОбъекта 	= ВыбранныйЭлемент.Значение; 
		НоваяСтрока.ИмяВстройки = ВыбранныйЭлемент.Значение; 
		НоваяСтрока.ПредставлениеВстройки = Лев(ВыбранныйЭлемент.Представление, 33); 
			
		ИндексСтроки = ВстройкиСсылочныхДанных.Индекс(НоваяСтрока);
		
	ИначеЕсли ДополнительныеПараметры.Вид = "Отчет" Тогда 
		
		НайденныеСтроки = ВстройкиОтчетов.НайтиСтроки(Новый Структура("ТипОбъекта, ИмяОбъекта", ДополнительныеПараметры.Назначение, ВыбранныйЭлемент.Значение));
		Если НайденныеСтроки.Количество()> 0 Тогда
			Возврат;
		КонецЕсли;
		
		Если ДополнительныеПараметры.Назначение = "Отчет" Тогда     
			
			НоваяСтрока = ВстройкиОтчетов.Добавить();
			НоваяСтрока.ТипОбъекта 	= ДополнительныеПараметры.Назначение; 
			НоваяСтрока.ИмяОбъекта 	= ВыбранныйЭлемент.Значение; 
			НоваяСтрока.ИмяВстройки = ВыбранныйЭлемент.Значение; 
			НоваяСтрока.ПредставлениеВстройки = Лев(ВыбранныйЭлемент.Представление, 33);   
			
			ИндексСтроки = ВстройкиОтчетов.Индекс(НоваяСтрока);
		
		ИначеЕсли ДополнительныеПараметры.Назначение = "ПроизвольныйОтчет" Тогда   
			
			НоваяСтрока = ВстройкиОтчетов.Добавить();
			НоваяСтрока.ТипОбъекта 				= ДополнительныеПараметры.Назначение; 
			НоваяСтрока.ИмяОбъекта 				= ВыбранныйЭлемент.Значение; 
			НоваяСтрока.ИмяВстройки 			= ВыбранныйЭлемент.Представление;  
			НоваяСтрока.ПредставлениеВстройки 	= Лев(ВыбранныйЭлемент.Представление, 33); 
			НоваяСтрока.ДополнительныйОтчет 	= ВыбранныйЭлемент.Значение; 
			
			ИндексСтроки = ВстройкиОтчетов.Индекс(НоваяСтрока);
		
		КонецЕсли; 
		
	КонецЕсли;   
	
	СформироватьСписокМест(ДополнительныеПараметры.Вид, ИндексСтроки);

	ВыгружатьНастройкиНаПортал 	= Истина;
	
КонецПроцедуры      

 
&НаКлиенте
Процедура ИзменитьВстройку(Команда) 
	
	ИндексСтроки = Неопределено;
	
	Если Команда.Имя = "ИзменитьВстройкуО" Тогда
		
		ТекущиеДанные = Элементы.ВстройкиОтчетов.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;      
		
		ВидДанных 	 = "Отчет";
		ИндексСтроки = ВстройкиОтчетов.Индекс(ТекущиеДанные);
		
	ИначеЕсли Команда.Имя = "ИзменитьВстройкуС" Тогда
		
		ТекущиеДанные = Элементы.ВстройкиСсылочныхДанных.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;     
		
		ВидДанных 		= "Ссылка";
		ИндексСтроки 	= ВстройкиСсылочныхДанных.Индекс(ТекущиеДанные);
		
	КонецЕсли; 
	
	СформироватьСписокМест(ВидДанных, ИндексСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСписокМест(ВидДанных, ИндексСтроки)
	
	Если ИндексСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	спкСущностей = Новый СписокЗначений;
	Если ВидДанных = "Ссылка" Тогда 
		спкСущностей = ВстройкиСсылочныхДанных.Получить(ИндексСтроки).СущностиБитрикс24;	
	ИначеЕсли ВидДанных = "Отчет" Тогда  
		спкСущностей = ВстройкиОтчетов.Получить(ИндексСтроки).СущностиБитрикс24;	
	КонецЕсли;
	
	Если спкСущностей.Количество() = 0 Тогда
		
		спкСущностей.Добавить("CRM_COMPANY_DETAIL_TOOLBAR"		, "Компании");	
		спкСущностей.Добавить("CRM_CONTACT_DETAIL_TOOLBAR"		, "Контакты");	
		спкСущностей.Добавить("CRM_LEAD_DETAIL_TOOLBAR"			, "Лиды");	
		спкСущностей.Добавить("CRM_DEAL_DETAIL_TOOLBAR"			, "Сделки");	
		спкСущностей.Добавить("CRM_SMART_INVOICE_DETAIL_TOOLBAR", "Счета");	 
		
	КонецЕсли;
	
	Для каждого ТекЭлемент Из СмартПроцессы Цикл
		КлючВстройки = "CRM_DYNAMIC_"+ТекЭлемент.ТипВладельца+"_DETAIL_TOOLBAR";
		Если спкСущностей.НайтиПоЗначению(КлючВстройки) = Неопределено Тогда
			спкСущностей.Добавить(КлючВстройки, ТекЭлемент.Наименование);	 
		КонецЕсли;
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Вид"		, ВидДанных);
	ДополнительныеПараметры.Вставить("Индекс"	, ИндексСтроки);
	Оповещение = Новый ОписаниеОповещения("ПослеУказанияМестВстроек", ЭтотОбъект, ДополнительныеПараметры);   

	спкСущностей.ПоказатьОтметкуЭлементов(Оповещение, "Выберите места встройки");
	
КонецПроцедуры      

&НаКлиенте
Процедура ПослеУказанияМестВстроек(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт   
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыгружатьНастройкиНаПортал 	= Истина;  
	Модифицированность 			= Истина;   
	
	Если ДополнительныеПараметры.Вид = "Ссылка" Тогда 
		ВстройкиСсылочныхДанных.Получить(ДополнительныеПараметры.Индекс).СущностиБитрикс24 = ВыбранныйЭлемент;	
	ИначеЕсли ДополнительныеПараметры.Вид = "Отчет" Тогда  
		ВстройкиОтчетов.Получить(ДополнительныеПараметры.Индекс).СущностиБитрикс24 = ВыбранныйЭлемент;	
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура УдалитьВстройку(Команда)
	
	Если Команда.Имя = "УдалитьВстройкуО" Тогда  
		
		ТекущиеДанные = Элементы.ВстройкиОтчетов.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ВстройкиОтчетов.Удалить(ВстройкиОтчетов.Индекс(ТекущиеДанные));  
			ВыгружатьНастройкиНаПортал = Истина;
			Модифицированность 			= Истина;
		КонецЕсли;   
		
	ИначеЕсли Команда.Имя = "УдалитьВстройкуС" Тогда   
		
		ТекущиеДанные = Элементы.ВстройкиСсылочныхДанных.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ВстройкиСсылочныхДанных.Удалить(ВстройкиСсылочныхДанных.Индекс(ТекущиеДанные)); 
			ВыгружатьНастройкиНаПортал = Истина;
			Модифицированность 			= Истина;
		КонецЕсли;  
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти  
