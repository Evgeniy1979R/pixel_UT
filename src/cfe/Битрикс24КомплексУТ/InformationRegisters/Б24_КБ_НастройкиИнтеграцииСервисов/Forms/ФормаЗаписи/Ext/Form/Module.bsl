КонецПроцедуры

&НаКлиенте
Процедура ПорядокИдентификацииПриИзменении(Элемент)
	
	лТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если лТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если лТекущиеДанные.Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.Имя = "ПорядокИдентификацииФизЛиц" Тогда
		лСпособыИдентификации = ПорядокИдентификацииФизЛиц;
	Иначе
		лСпособыИдентификации = ПорядокИдентификацииЮрЛиц;
	КонецЕсли;
	
	мДанные = Новый Массив;
	мДанные.Добавить("Внешний идентификатор");
	
	Для каждого ТекЗначение Из лСпособыИдентификации Цикл
		Если ТекЗначение.Значение	<> "Внешний идентификатор" Тогда
			мДанные.Добавить(ТекЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	лСпособыИдентификации.ЗагрузитьЗначения(мДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокИдентификацииПередУдалением(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные.Значение = "Внешний идентификатор" Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ДобавитьСписокВЭлемент(Элемент)
	
	Элемент.СписокВыбора.Очистить();
	Элемент.СписокВыбора.Добавить("Внешний идентификатор");
	Элемент.СписокВыбора.Добавить("Наименование");
	Элемент.СписокВыбора.Добавить("Email");
	Элемент.СписокВыбора.Добавить("Телефон");
	Элемент.СписокВыбора.Добавить("Не использовать");
	Элемент.СписокВыбора.Добавить("ИНН+КПП");
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьСервис1СПАРКРискиПриИзменении(Элемент)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если НЕ ТипКонфигурации = "ЗУП" Тогда
		
		Модуль = Б24_К_ОбщегоНазначенияКлиент.ОбщийМодуль("Б24_КБ_1СПАРКВызовСервера");
		Модуль.ПроверитьДобавитьРасписаниеСПАРК(ИспользоватьСервис1СПАРКРиски);
		
		Если ИспользоватьСервис1СПАРКРиски  Тогда
			
			Модуль.ПересоздатьПолеСПАРК(НастройкаПодключения);
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗапускеВыгрузкиИндексовСПАРК", ЭтотОбъект, Параметры);
			ПоказатьВопрос(Оповещение, "Запустить выгрузку индексов СПАРК?", РежимДиалогаВопрос.ДаНет, 0);
		КонецЕсли;
		
		ОбновитьОтображениеЭлементовФормы();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗапускеВыгрузкиИндексовСПАРК(Результат, Параметры) Экспорт
	
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	Если ТипКонфигурации = "ЗУП" Тогда
		Возврат;	
	КонецЕсли;
	
	Модуль = Б24_К_ОбщегоНазначенияКлиент.ОбщийМодуль("Б24_КБ_1СПАРКВызовСервера");
	Модуль.ОбновитьИнформациюСПАРК(НастройкаПодключения);	
	
	ПоказатьОповещениеПользователя("Выгрузка индексов СПАРК запущена");
	
