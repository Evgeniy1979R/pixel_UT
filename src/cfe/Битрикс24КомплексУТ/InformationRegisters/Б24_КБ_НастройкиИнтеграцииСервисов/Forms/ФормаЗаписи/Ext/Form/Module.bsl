
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	НастройкаПодключения 	= Параметры.НастройкаПодключения;
	
	ЗаполнитьТаблицуСмартПроцессов();
	
	НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
	
	РаботаИзОдногоОкна 				= НастройкиИнтеграцииСервисов.РаботаИзОдногоОкна;
	РеестрПечатныхФорм 				= НастройкиИнтеграцииСервисов.РеестрПечатныхФорм;
	ИспользоватьСервис1СПАРКРиски 	= НастройкиИнтеграцииСервисов.Сервис1СПАРКРиски;
	БитриксПоиск 					= НастройкиИнтеграцииСервисов.БитриксПоиск;

	Если НастройкиИнтеграцииСервисов.Настройки.Получить() = Неопределено Тогда
		НастройкиИнтеграцииСервисов.Настройки = Новый ХранилищеЗначения(РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоУмолчанию());	
	КонецЕсли;
	
	СохраненныеНастройки = НастройкиИнтеграцииСервисов.Настройки.Получить();
	НастройкиКлиентов = СохраненныеНастройки.НастройкиКлиентов;
	
	Если ТипКонфигурации <> "УТ" Тогда
		ТекГруппаКонтрагентов = "";
		НастройкиКлиентов.Свойство("ГруппаДляНовыхКонтрагентов"		, ТекГруппаКонтрагентов);
		ЭтотОбъект["ГруппаДляНовыхКонтрагентов"] = ТекГруппаКонтрагентов;
	КонецЕсли;
	НастройкиКлиентов.Свойство("ОбновлятьКонтрагентов"			, ОбновлятьКонтрагентов);
	НастройкиКлиентов.Свойство("ПорядокИдентификацииФизЛиц"		, ПорядокИдентификацииФизЛиц);
	НастройкиКлиентов.Свойство("ПорядокИдентификацииЮрЛиц"		, ПорядокИдентификацииЮрЛиц);
	
	НастройкиКлиентов.Свойство("ЗагружатьКонтрагентов"						, ЗагружатьКонтрагентов);
	НастройкиКлиентов.Свойство("ЗагружатьКонтрагентовМодулемСинхронизации"	, ЗагружатьКонтрагентовМодулемСинхронизации);
	
	Если СохраненныеНастройки.Свойство("ВстройкиОтчетов") Тогда
		ВстройкиОтчетов.Загрузить(СохраненныеНастройки.ВстройкиОтчетов);	
	Иначе
		ЗаполнитьВстройкиПоУмолчаниюНаСервере("Отчет");
	КонецЕсли;  
	
	Если СохраненныеНастройки.Свойство("ВстройкиСсылочныхДанных") Тогда
		ВстройкиСсылочныхДанных.Загрузить(СохраненныеНастройки.ВстройкиСсылочныхДанных);	
	Иначе
		ЗаполнитьВстройкиПоУмолчаниюНаСервере("Ссылка");
	КонецЕсли;  
	
	Если СохраненныеНастройки.Свойство("НазваниеВстройкиБитриксПоиск") Тогда 
		НазваниеВстройкиБитриксПоиск = СохраненныеНастройки.НазваниеВстройкиБитриксПоиск;
	Иначе
		НазваниеВстройкиБитриксПоиск = "Искать в 1С (ИНН, ФИО или название)";
	КонецЕсли;
	Если СохраненныеНастройки.Свойство("ПериодичностьОбновленияИндексаКлиента") Тогда 
		ПериодичностьОбновленияИндексаКлиента = СохраненныеНастройки.ПериодичностьОбновленияИндексаКлиента;
	КонецЕсли;
	Если СохраненныеНастройки.Свойство("ФормироватьСправки1СПАРКРиски") Тогда 
		ФормироватьСправки1СПАРКРиски = СохраненныеНастройки.ФормироватьСправки1СПАРКРиски;
	КонецЕсли;
	
	Если СохраненныеНастройки.Свойство("ЭкспортТоваровИзСделок") Тогда 
		ЭкспортТоваровИзСделок = СохраненныеНастройки.ЭкспортТоваровИзСделок;
	КонецЕсли;
	
	Если СохраненныеНастройки.Свойство("ИмпортТоваровВСделки") Тогда 
		ИмпортТоваровВСделки = СохраненныеНастройки.ИмпортТоваровВСделки;
	КонецЕсли;
	
	Если СохраненныеНастройки.Свойство("НеСинхронизироватьЗаказыПривязанныеКСделкам") Тогда 
		НеСинхронизироватьЗаказыПривязанныеКСделкам = СохраненныеНастройки.НеСинхронизироватьЗаказыПривязанныеКСделкам;
	КонецЕсли;
	
	Если СохраненныеНастройки.Свойство("ПривязыватьЗаказКСделке") Тогда 
		ПривязыватьЗаказКСделке = СохраненныеНастройки.ПривязыватьЗаказКСделке;
	КонецЕсли;
	
	СохраненныеНастройки.Свойство("ВыгружатьКонтрагентовМодулемСинхронизации"	, ВыгружатьКонтрагентовМодулемСинхронизации);
	
	Если НЕ ТипКонфигурации = "ЗУП" Тогда
		СПАРК = ПолучитьФункциональнуюОпцию("ИспользоватьСервисСПАРКРиски");
		Элементы.ИспользоватьСервис1СПАРКРиски.Доступность = СПАРК;	
	КонецЕсли;	  
	
	Если СпособВыгрузкиКлиентов = "Через модуль 1С:Бэкофис" Тогда СпособВыгрузкиКлиентов = "Через интеграцию сервисов" КонецЕсли;      // для совместимости
	Если СпособЗагрузкиКлиентов = "Через модуль 1С:Синхронизация" Тогда СпособЗагрузкиКлиентов = "Через подсистему синхронизации" КонецЕсли;      // для совместимости
	
	Если ТипКонфигурации = "ЗУП" Тогда
		Элементы.ГруппаБитриксПоиск.Видимость = Ложь;
		Элементы.ГруппаСинхронизация.Видимость = Ложь;
		Элементы.ДекорацияВозможности.Видимость = Ложь;
		Элементы.СпособЗагрузкиКлиентов.Видимость = Ложь;
		Элементы.ГруппаКонтрагенты.Видимость = Ложь;
		Элементы.Группа1СПАРК.Видимость = Ложь;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ Б24_К_СлужебныйВызовСервера.МодульРаботыИзОдногоОкнаДоступен(НастройкаПодключения) Тогда
		Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаРаботыИзОдногоОкнаПоТарифномуПлану();
		Закрыть();	
	КонецЕсли;                          
	
	Заголовок = Строка(НастройкаПодключения);
	
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.ПодсистемаСуществует("СинхронизацияДанных") Тогда
		
		СинхронизацияДоступна = Б24_К_СлужебныйВызовСервера.МодульСинхронизацииДоступен(НастройкаПодключения);
		
		Если СинхронизацияДоступна И Элементы.СпособЗагрузкиКлиентов.СписокВыбора.НайтиПоЗначению("Через подсистему синхронизации") = Неопределено Тогда
			Элементы.СпособЗагрузкиКлиентов.СписокВыбора.Добавить("Через подсистему синхронизации", "Через подсистему синхронизации");	
		КонецЕсли;
		
		Если СинхронизацияДоступна И Элементы.СпособВыгрузкиКлиентов.СписокВыбора.НайтиПоЗначению("Через подсистему синхронизации") = Неопределено Тогда
			Элементы.СпособВыгрузкиКлиентов.СписокВыбора.Добавить("Через подсистему синхронизации", "Через подсистему синхронизации");	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗагружатьКонтрагентовМодулемСинхронизации Тогда
		СпособЗагрузкиКлиентов = "Через подсистему синхронизации";
	ИначеЕсли ЗагружатьКонтрагентов Тогда
		СпособЗагрузкиКлиентов = "Через интеграцию сервисов";
	Иначе
		СпособЗагрузкиКлиентов = "Не загружать";
	КонецЕсли;
	
	Если ВыгружатьКонтрагентовМодулемСинхронизации Тогда
		СпособВыгрузкиКлиентов = "Через подсистему синхронизации";
	Иначе
		СпособВыгрузкиКлиентов = "Через интеграцию сервисов";
	КонецЕсли;
	
	ОбновитьОтображениеЭлементовФормы();
	
КонецПроцедуры


&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И НЕ НужноЗакрытьОкно Тогда
		
		Отказ = Истина; 
		
		Если ЗавершениеРаботы Тогда 
			ТекстПредупреждения = "Настройки не будут сохранены. Закрыть?"; 
		Иначе
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОЗакрытииОкна", ЭтотОбъект, Параметры);
			ПоказатьВопрос(Оповещение, "Настройки были изменены. Сохранить изменения перед закрытием?", РежимДиалогаВопрос.ДаНетОтмена, 0);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОЗакрытииОкна(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		НужноЗакрытьОкно = Истина;
		
		СохранитьВыгрузитьНастройки(Истина);
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		
		НужноЗакрытьОкно = Истина;
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СохранитьВыгрузитьНастройки(ЗакрытьПоОкончании = Ложь)
	
	НастройкаСохранена = СохранитьНастройкуСервер();
	
	Если НастройкаСохранена И ВыгружатьНастройкиНаПортал Тогда
		
		Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(НастройкаПодключения, "ПометкаУдаления") = Ложь Тогда
			
			СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);  
			
			Если СтруктураНастроек = Неопределено Тогда
				ПоказатьПредупреждение(, "Не удалось подключиться к Битрикс24");
				Возврат Ложь;
			КонецЕсли;
			
			СтруктураНастроек.Логирование.Измерение2 = "Выгрузка настроек для интеграции сервисов";
	
			ВыгрузкаНастройки(СтруктураНастроек, ЗакрытьПоОкончании);
			
			ВыгружатьНастройкиНаПортал = Ложь;
			
		Иначе
			Если ЗакрытьПоОкончании Тогда Закрыть() КонецЕсли;
		КонецЕсли;
		
	Иначе
		Если ЗакрытьПоОкончании Тогда Закрыть() КонецЕсли;
	КонецЕсли;
	
	Оповестить("СозданаИзмененаНастройка");
	
	Возврат НастройкаСохранена
	
КонецФункции  

&НаСервере
Функция СохранитьНастройкуСервер()
	
	Если Модифицированность Тогда
		
		НоваяЗаписьНастройки = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.СоздатьМенеджерЗаписи();
		НоваяЗаписьНастройки.НастройкаПодключения 	= НастройкаПодключения;
		НоваяЗаписьНастройки.РаботаИзОдногоОкна 	= РаботаИзОдногоОкна;
		НоваяЗаписьНастройки.РеестрПечатныхФорм 	= РеестрПечатныхФорм;
		НоваяЗаписьНастройки.Сервис1СПАРКРиски 		= ИспользоватьСервис1СПАРКРиски;
		НоваяЗаписьНастройки.БитриксПоиск 			= БитриксПоиск;
		
		НастройкиВзаимодействияОбъектов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоУмолчанию();	
		
		НастройкиВзаимодействияОбъектов.НастройкиКлиентов.ЗагружатьКонтрагентов 		= ЗагружатьКонтрагентов;
		НастройкиВзаимодействияОбъектов.НастройкиКлиентов.ОбновлятьКонтрагентов			= ОбновлятьКонтрагентов;
		Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() <> "УТ" Тогда
			НастройкиВзаимодействияОбъектов.НастройкиКлиентов.ГруппаДляНовыхКонтрагентов 	= ЭтотОбъект["ГруппаДляНовыхКонтрагентов"];
		КонецЕсли;
		
		НастройкиВзаимодействияОбъектов.НастройкиКлиентов.ПорядокИдентификацииФизЛиц 	= ПорядокИдентификацииФизЛиц;
		НастройкиВзаимодействияОбъектов.НастройкиКлиентов.ПорядокИдентификацииЮрЛиц 	= ПорядокИдентификацииЮрЛиц;
		
		НастройкиВзаимодействияОбъектов.НастройкиКлиентов.ЗагружатьКонтрагентовМодулемСинхронизации = ЗагружатьКонтрагентовМодулемСинхронизации;
		
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "ВстройкиСсылочныхДанных"				, ВстройкиСсылочныхДанных.Выгрузить());
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "ВстройкиОтчетов"						, ВстройкиОтчетов.Выгрузить());
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "ПериодичностьОбновленияИндексаКлиента"	, ПериодичностьОбновленияИндексаКлиента);
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "ФормироватьСправки1СПАРКРиски"			, ФормироватьСправки1СПАРКРиски);
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "ЭкспортТоваровИзСделок"					, ЭкспортТоваровИзСделок);
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "ИмпортТоваровВСделки"					, ИмпортТоваровВСделки);
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "НазваниеВстройкиБитриксПоиск"			, НазваниеВстройкиБитриксПоиск);

		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "НеСинхронизироватьЗаказыПривязанныеКСделкам", НеСинхронизироватьЗаказыПривязанныеКСделкам);
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "ПривязыватьЗаказКСделке"                     , ПривязыватьЗаказКСделке);
		РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ДобавитьНастройкуВСтруктуру(НастройкиВзаимодействияОбъектов, "ВыгружатьКонтрагентовМодулемСинхронизации"	, ВыгружатьКонтрагентовМодулемСинхронизации);
				
		НоваяЗаписьНастройки.Настройки = Новый ХранилищеЗначения(НастройкиВзаимодействияОбъектов);
		
		Попытка 
			
			НоваяЗаписьНастройки.Записать();
			
			ОбновитьПовторноИспользуемыеЗначения();

			Модифицированность = Ложь;
			                                                           
		Исключение
			Возврат Ложь;	
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Истина
	
КонецФункции  

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	СохранитьВыгрузитьНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	СохранитьВыгрузитьНастройки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьНастройку(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбУдалении", ЭтотОбъект, Параметры);
	ПоказатьВопрос(Оповещение, "Настройка интеграции сервисов будет удалена. Продолжить?", РежимДиалогаВопрос.ДаНет, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбУдалении(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

	УдалитьНастройкуСервер();
	
	Модифицированность = Ложь;
	
	Оповестить("СозданаИзмененаНастройка");
	
	Закрыть();

КонецПроцедуры

&НаСервере
Процедура УдалитьНастройкуСервер()
	
	ЗаписьНастройкиСинхронизации = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.СоздатьМенеджерЗаписи();
	ЗаписьНастройкиСинхронизации.НастройкаПодключения = НастройкаПодключения;
	ЗаписьНастройкиСинхронизации.Прочитать();
	ЗаписьНастройкиСинхронизации.Удалить();
	
	ОбновитьПовторноИспользуемыеЗначения();
	
