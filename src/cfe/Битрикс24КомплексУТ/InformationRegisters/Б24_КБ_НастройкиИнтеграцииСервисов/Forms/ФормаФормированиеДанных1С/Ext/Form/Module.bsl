	 
#Область ОписаниеПеременных

&НаКлиенте
Перем ФормаНовогоОбъекта;  

#КонецОбласти	 


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресНавигационнойСсылки") Тогда
		АдресНавигационнойСсылки = Параметры.АдресНавигационнойСсылки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(АдресНавигационнойСсылки) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Лев(АдресНавигационнойСсылки, 20) = "e1cib/data/Документ." Тогда  
		ВидОбъекта = "Документ";    
		ИмяОбъекта = СтрЗаменить(АдресНавигационнойСсылки, "e1cib/data/Документ.", "");  
		ИмяОбъекта = Лев(ИмяОбъекта, СтрНайти(ИмяОбъекта, "?ref=")-1);	
	ИначеЕсли Лев(АдресНавигационнойСсылки, 22) = "e1cib/data/Справочник." Тогда  
		ВидОбъекта = "Справочник"; 
		ИмяОбъекта = СтрЗаменить(АдресНавигационнойСсылки, "e1cib/data/Справочник.", "");
		ИмяОбъекта = Лев(ИмяОбъекта, СтрНайти(ИмяОбъекта, "?ref=")-1);	
	ИначеЕсли Лев(АдресНавигационнойСсылки, 9) = "Документ." Тогда  
		ВидОбъекта = "Документ";    
		ИмяОбъекта = СтрЗаменить(АдресНавигационнойСсылки, "Документ.", ""); 
	ИначеЕсли Лев(АдресНавигационнойСсылки, 27) = "e1cib/list/РегистрСведений." Тогда  
		ВидОбъекта = "РегистрСведений";    
		ИмяОбъекта = СтрЗаменить(АдресНавигационнойСсылки, "e1cib/list/РегистрСведений.", "");  
	Иначе
		ВидОбъекта = "Справочник"; 
		ИмяОбъекта = СтрЗаменить(АдресНавигационнойСсылки, "Справочник.", "");  
	КонецЕсли;
	
	СлужебноеИмяОбъекта = ИмяОбъекта;
	
	
	Если Параметры.Свойство("СессияБитрикс24") Тогда
		СессияБитрикс24 = Параметры.СессияБитрикс24;
	КонецЕсли;
	
	Если Параметры.Свойство("НоваяСущность") Тогда
		НоваяСущность = Параметры.НоваяСущность;
	КонецЕсли;
	
	Если Параметры.Свойство("НастройкаПодключения") Тогда
		НастройкаПодключения = Параметры.НастройкаПодключения;
	КонецЕсли;

	// Экземпляр формы пишется в лог: две записи с разными экземплярами и одной сессией
	// означают, что форма нового документа открылась дважды.
	Б24_БП_ЗаписатьЛогОткрытия("Форма открытия объекта создана. Экземпляр формы='" + Строка(УникальныйИдентификатор) + "', Сессия='" + Строка(СессияБитрикс24) + "', Объект='" + Строка(ВидОбъекта) + "." + Строка(ИмяОбъекта) + "', НоваяСущность=" + Строка(НоваяСущность) + ", Настройка='" + Строка(НастройкаПодключения) + "'");

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	Если НЕ ЗначениеЗаполнено(ИмяОбъекта) Тогда
		ПоказатьПредупреждение(, "Не определен объект 1С. Необходимо перевыгрузить встройки интеграции сервисов",,"Ошибка");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресНавигационнойСсылки) Тогда
		ПодключитьОбработчикОжидания("ИнициализацияДляБитрикс24", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИнициализацияДляБитрикс24()
	

	Если НЕ НоваяСущность Тогда
		ОткрытьСущность1С(АдресНавигационнойСсылки);
	Иначе
		Если ЗначениеЗаполнено(СессияБитрикс24) Тогда  
			Если НоваяСущность Тогда
				ПодключитьОбработчикОжидания("ПроверитьДанныеБитрикс24", 2, Истина);
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСущность1С(АдресНавигационнойСсылки = "", Объект1С = Неопределено, ПараметрыОбъекта = Неопределено)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СессияБитрикс24"		, СессияБитрикс24);
	ДополнительныеПараметры.Вставить("НастройкаПодключения"	, НастройкаПодключения);    		
	ДополнительныеПараметры.Вставить("ВидОбъекта"			, ВидОбъекта);    		
	ДополнительныеПараметры.Вставить("ИмяОбъекта"			, ИмяОбъекта);   
	
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
 	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОткрытияФормыОбъекта", ЭтотОбъект, ДополнительныеПараметры);  
	
	Если АдресНавигационнойСсылки = "" И Объект1С = Неопределено Тогда
		
		Если ИмяОбъекта = "РеализацияТоваровУслуг" ИЛИ ИмяОбъекта = "ПоступлениеТоваровУслуг"	
			ИЛИ ИмяОбъекта = "ВозвратТоваровОтПокупателя" ИЛИ ИмяОбъекта = "ВозвратТоваровПоставщику" Тогда	

			спкВыбора = ПолучитьВидыОперацииДляВыбора(ВидОбъекта, ИмяОбъекта);
			
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораВидаОперации", ЭтотОбъект, ПараметрыОбъекта);
			спкВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите операцию");
				
		Иначе
				
			ФормаНовогоОбъекта = ОткрытьФорму(ВидОбъекта+"."+ИмяОбъекта+".Форма."+ИмяОсновнойФормыОбъекта(ВидОбъекта, ИмяОбъекта),ПараметрыОбъекта, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.Независимый);  
			
			Если НоваяСущность И НЕ ВводитсяНаОсновании Тогда        
				Б24_КБ_РаботаИзОдногоОкнаКлиент.ЗаполнениеОбъекта1С(ФормаНовогоОбъекта, ВидОбъекта, ИмяОбъекта, СлужебноеИмяОбъекта, ПараметрыОбъекта);	
			КонецЕсли;	 
			
		КонецЕсли;
		
		
	ИначеЕсли ЗначениеЗаполнено(АдресНавигационнойСсылки) И Объект1С = Неопределено Тогда

		Попытка                                                                  
			Если ВидОбъекта = "РегистрСведений" Тогда
				ФормаНовогоОбъекта = ОткрытьФорму(ВидОбъекта+"."+ИмяОбъекта+".ФормаСписка", ДополнительныеПараметры,,,,,ОписаниеОповещения);
			Иначе
					
				СсылкаНаОбъект = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьСсылкуНаОбъектИзНавигационнойСсылки(АдресНавигационнойСсылки);
				
				ДополнительныеПараметры.Вставить("Ключ", СсылкаНаОбъект);
				ФормаНовогоОбъекта = ОткрытьФорму(ВидОбъекта+"."+ИмяОбъекта+".Форма."+ИмяОсновнойФормыОбъекта(ВидОбъекта, ИмяОбъекта), ДополнительныеПараметры,,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.Независимый);
				
			КонецЕсли;
		Исключение
			Б24_БП_ЗаписатьЛогОткрытия("ОшибкаОткрытияФормыОбъекта: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "Ошибка");
		КонецПопытки; 
		
	ИначеЕсли ЗначениеЗаполнено(Объект1С) Тогда 
		
		ДополнительныеПараметры.Вставить("Ключ", Объект1С);
		ФормаНовогоОбъекта = ОткрытьФорму(ВидОбъекта+"."+ИмяОбъекта+".Форма."+ИмяОсновнойФормыОбъекта(ВидОбъекта, ИмяОбъекта), ДополнительныеПараметры, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.Независимый);
		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОткрытияФормыОбъекта(Результат, ДополнительныеПараметры) Экспорт

	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	
	Если ФормаНовогоОбъекта <> Неопределено Тогда
		
		Если ФормаНовогоОбъекта.Параметры.Свойство("Ключ") Тогда

			ОбъектСсылка = ФормаНовогоОбъекта.Параметры.Ключ;
			Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
				
				Если НоваяСущность Тогда    
					
					Если НЕ ВводитсяНаОсновании Тогда
						ВыгрузитьДелоВБитрикс24(ОбъектСсылка, НастройкаПодключения, ТипВладельца, ИдентификаторВладельца);  
					КонецЕсли;
					
					Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПривязатьОбъектИнтеграцииСервисовКНастройкеПодключения(НастройкаПодключения, ТипВладельца, ОбъектСсылка);    
					
					Если (ТипКонфигурации = "БП"
						И (ДополнительныеПараметры.ИмяОбъекта = "АктОбОказанииПроизводственныхУслуг"
							ИЛИ ДополнительныеПараметры.ИмяОбъекта = "СчетНаОплатуПокупателю" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "СчетНаОплатуПоставщика"
							ИЛИ ДополнительныеПараметры.ИмяОбъекта = "РеализацияТоваровУслуг" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "ПоступлениеТоваровУслуг"))
						ИЛИ (ТипКонфигурации = "УТ"
							И (ДополнительныеПараметры.ИмяОбъекта = "ЗаказКлиента" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "ЗаказПоставщику" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "АктВыполненныхРабот" 
								ИЛИ ДополнительныеПараметры.ИмяОбъекта = "КоммерческоеПредложениеКлиенту" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "РеализацияТоваровУслуг" 
								ИЛИ ДополнительныеПараметры.ИмяОбъекта = "ПриобретениеТоваровУслуг" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "ПоступлениеТоваровНаСклад"
								ИЛИ ДополнительныеПараметры.ИмяОбъекта = "ВозвратТоваровОтКлиента" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "ВозвратТоваровПоставщику"))
						ИЛИ (ТипКонфигурации = "УНФ"
							И (ДополнительныеПараметры.ИмяОбъекта = "ЗаказПокупателя" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "ЗаказПоставщику" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "АктВыполненныхРабот"
								ИЛИ ДополнительныеПараметры.ИмяОбъекта = "СчетНаОплату" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "СчетНаОплатуПоставщика"
								ИЛИ ДополнительныеПараметры.ИмяОбъекта = "РасходнаяНакладная" ИЛИ ДополнительныеПараметры.ИмяОбъекта = "ПриходнаяНакладная")) Тогда    
						
						Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ВыгрузитьТоварыДокументовВСделкуСмартПроцесс(НастройкаПодключения, НоваяСущность, ОбъектСсылка, ТипВладельца, ИдентификаторВладельца);
						
					КонецЕсли;    
					
					ПроверитьЗапуститьТриггерПроведенияДокумента(ОбъектСсылка);
					
					Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаНовогоОбъекта,"ПараметрыБ24") Тогда
						ПривязыватьЗаказКСделкеНаСервере(ФормаНовогоОбъекта.ПараметрыБ24, ОбъектСсылка);
					КонецЕсли;
					
				КонецЕсли;	
					
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	Б24_КБ_РаботаИзОдногоОкнаКлиент.ЗакрытиеСлайдера(ДополнительныеПараметры.СессияБитрикс24, ДополнительныеПараметры.НастройкаПодключения);
	
	ЗакрытьФорму();
	
КонецПроцедуры     

&НаКлиенте
Процедура ПроверитьДанныеБитрикс24()

	Если КоличествоПроверокНаДанные = 0 Тогда
		Б24_БП_ЗаписатьЛогОжидания("Ожидание данных для нового документа начато. Экземпляр формы='" + Строка(ЭтаФорма.УникальныйИдентификатор) + "', Сессия='" + Строка(СессияБитрикс24) + "', Объект='" + Строка(ВидОбъекта) + "." + Строка(ИмяОбъекта) + "'", "Информация", Истина);
	КонецЕсли;

	Результат = Б24_КБ_РаботаИзОдногоОкнаВызовСервера.ПроверитьДанные(СессияБитрикс24);
	Если НЕ Результат.ДанныеПолучены Тогда

		КоличествоПроверокНаДанные = КоличествоПроверокНаДанные + 1;

		Если КоличествоПроверокНаДанные > 15 Тогда

			Б24_БП_ЗаписатьЛогОжидания("Данные не дождались: истекли 15 проверок по 2 с, форма закрывается с предупреждением. Экземпляр формы='" + Строка(ЭтаФорма.УникальныйИдентификатор) + "', Сессия='" + Строка(СессияБитрикс24) + "'", "Ошибка", Истина);

			ПоказатьПредупреждение(, "Не удалось открыть объект 1С. Возможно нет подключения к Битрикс24");
			Закрыть();
		Иначе
			ПодключитьОбработчикОжидания("ПроверитьДанныеБитрикс24", 2, Истина);
		КонецЕсли;

	Иначе

		Б24_БП_ЗаписатьЛогОжидания("Данные получены. Экземпляр формы='" + Строка(ЭтаФорма.УникальныйИдентификатор) + "', Сессия='" + Строка(СессияБитрикс24) + "', опросов=" + Строка(КоличествоПроверокНаДанные + 1));

		НастройкаПодключения 	= Результат.НастройкаПодключения;
		ИдентификаторВладельца	= Результат.ИдентификаторВладельца;
		ТипВладельца			= Результат.ТипВладельца;
		
		ПараметрыОбъекта = Новый Структура;
		ПараметрыОбъекта.Вставить("ДанныеСущностиБитрикс24", Результат);
		
		ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
		Если ТипКонфигурации = "УНФ" И ИмяОбъекта = "ЗаказПокупателяНаряд" > 0 Тогда
			ИмяОбъекта = "ЗаказПокупателя";
			ЗначенияЗаполнения = Новый Структура;
			ЗначенияЗаполнения.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление." + "ВидыОперацийЗаказПокупателя.ЗаказНаряд"));
			ПараметрыОбъекта.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		КонецЕсли;
		
		мДокументы = ПолучитьДокументыСущностиБ24(Результат.НастройкаПодключения, Результат.ТипВладельца, Результат.ИдентификаторВладельца);
			
		Если мДокументы.Количество() > 0 Тогда
			
			мДокументыТекущегоТипа = Новый Массив;
			Для каждого ТекДокумент Из мДокументы Цикл
				Если ТипЗнч(ТекДокумент) = Тип(ВидОбъекта+"Ссылка."+ИмяОбъекта) Тогда
					мДокументыТекущегоТипа.Добавить(ТекДокумент);	
				КонецЕсли;
			КонецЦикла;
			
			ПараметрыНовойФормы = Новый Структура;        
			ПараметрыНовойФормы.Вставить("Документы"			, мДокументы);
			ПараметрыНовойФормы.Вставить("ПараметрыОбъекта"		, ПараметрыОбъекта);  
			ПараметрыНовойФормы.Вставить("ДокументыТекущегоТипа", мДокументыТекущегоТипа);    
				
			Если мДокументыТекущегоТипа.Количество() = 0 Тогда
			
			   	Оповещение = Новый ОписаниеОповещения("ПослеВыбораОснования", ЭтотОбъект, ПараметрыОбъекта);

				ПараметрыНовойФормы.Вставить("Заголовок", "Выберите основание");
			
				ОткрытьФорму("РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов.Форма.ФормаВыбораОснования", ПараметрыНовойФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
			ИначеЕсли мДокументыТекущегоТипа.Количество() = 1 Тогда

				Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбОткрытииСуществующего", ЭтотОбъект, ПараметрыНовойФормы);
				ПоказатьВопрос(Оповещение, "Уже есть документ выбранного типа. Открыть существующий?", РежимДиалогаВопрос.ДаНет, 0);
				
			Иначе
				
				Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбВыбореСуществующего", ЭтотОбъект, ПараметрыНовойФормы);
				ПоказатьВопрос(Оповещение, "Уже есть документы выбранного типа. Выбрать из существующих?", РежимДиалогаВопрос.ДаНет, 0);
				
			КонецЕсли;
			
		Иначе
			ПослеВыбораОснования(Неопределено, ПараметрыОбъекта);	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОснования(Результат, ПараметрыОбъекта) Экспорт

	ВводитсяНаОсновании = Результат <> Неопределено;	
	
	Если Результат <> Неопределено Тогда
		ПараметрыОбъекта.Вставить("Основание", Результат);
	КонецЕсли;

	Попытка   
		
		ОткрытьСущность1С(,, ПараметрыОбъекта);
		
	Исключение
		
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Оповещение = Новый ОписаниеОповещения("ПослеПредупреждения", ЭтотОбъект, ПараметрыОбъекта);
		ПоказатьПредупреждение(Оповещение, ОписаниеОшибки,,"Не удалось сформировать документ");  
		
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьНазваниеМодуля(), "Ошибка", ОписаниеОшибки,, Истина);
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОткрытииСуществующего(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораОснования", ЭтотОбъект, Параметры.ПараметрыОбъекта);
		
		ПараметрыНовойФормы = Новый Структура;      
		ПараметрыНовойФормы.Вставить("Заголовок"		, "Выберите основание");
		ПараметрыНовойФормы.Вставить("Документы"		, Параметры.Документы);
		
		ОткрытьФорму("РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов.Форма.ФормаВыбораОснования", ПараметрыНовойФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ВводитсяНаОсновании = Истина;
		ОткрытьСущность1С(, Параметры.ДокументыТекущегоТипа[0]);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбВыбореСуществующего(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораОснования", ЭтотОбъект, Параметры.ПараметрыОбъекта);
		
		ПараметрыНовойФормы = Новый Структура;   
		ПараметрыНовойФормы.Вставить("Заголовок"		, "Выберите основание");
		ПараметрыНовойФормы.Вставить("Документы"		, Параметры.Документы);
		
		ОткрытьФорму("РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов.Форма.ФормаВыбораОснования", ПараметрыНовойФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
 	Иначе
		
		ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();

		Оповещение = Новый ОписаниеОповещения("ПослеВыбораДокумента", ЭтотОбъект, Параметры.ПараметрыОбъекта);
		
		ПараметрыНовойФормы = Новый Структура;        
		ПараметрыНовойФормы.Вставить("Заголовок"		, ?(ТипКонфигурации = "БП" ИЛИ ТипКонфигурации = "ЗУП" ИЛИ ТипКонфигурации = "УНФ", "Выберите открываемый документ", "Выберите открываемый объект"));
		ПараметрыНовойФормы.Вставить("Документы"		, Параметры.ДокументыТекущегоТипа);
		
		ОткрытьФорму("РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов.Форма.ФормаВыбораОснования", ПараметрыНовойФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДокумента(Результат, ПараметрыБитрикс24) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ВводитсяНаОсновании = Истина;
		ОткрытьСущность1С(, Результат);
	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПредупреждения(ПередаваемыеПараметры) Экспорт 
	Закрыть();
КонецПроцедуры

&НаСервере
Функция ПолучитьДокументыСущностиБ24(НастройкаПодключения, ТипВладельца, ИдентификаторВладельца)
	
	Результат = Новый Массив;
	
	ТипыДанных = Б24_К_RestApiВызовСервера.ТипыДанныхДелаПоТипуВладельца(ТипВладельца);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипыДанных"		, ТипыДанных);
	Запрос.УстановитьПараметр("Портал"			, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаПодключения, "Портал"));
	Запрос.УстановитьПараметр("Идентификатор"	, ИдентификаторВладельца);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_К_ИдентификаторыДел.ТипОбъекта КАК ТипОбъекта,
	|	Б24_К_ИдентификаторыДел.ИдентификаторОбъекта КАК ИдентификаторОбъекта
	|ИЗ
	|	РегистрСведений.Б24_К_ИдентификаторыДел КАК Б24_К_ИдентификаторыДел
	|ГДЕ
	|	Б24_К_ИдентификаторыДел.ТипДанных В (&ТипыДанных)
	|	И Б24_К_ИдентификаторыДел.Портал = &Портал
	|	И Б24_К_ИдентификаторыДел.ДополнительныйИдентификатор = &Идентификатор";
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		Пока Выборка.Следующий() Цикл        
			
			НайденныйОбъектСсылка  = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеПоИмениИИдентификатору(Выборка.ТипОбъекта, Выборка.ИдентификаторОбъекта);	
			Если ЗначениеЗаполнено(НайденныйОбъектСсылка) Тогда
				ОбъектСсылка = НайденныйОбъектСсылка;
			КонецЕсли;
				
			Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
	       		Результат.Добавить(ОбъектСсылка);
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытьФорму()

	Закрыть();

КонецПроцедуры


&НаСервере
Функция ПолучитьВидыОперацииДляВыбора(ВидОбъекта, ИмяОбъекта)     
	
	Результат = Новый СписокЗначений;
	
	Мета = Неопределено;
	Если ВидОбъекта = "Справочник" Тогда
		Мета = Метаданные.Справочники[ИмяОбъекта];	
	ИначеЕсли ВидОбъекта = "Документ" Тогда  
		Мета = Метаданные.Документы[ИмяОбъекта];	
	КонецЕсли;	
	
	Если Мета <> Неопределено Тогда      
		
		ВидОперации = Мета.Реквизиты.Найти("ВидОперации");
		Если ВидОперации <> Неопределено Тогда   
			
			НайденныйТип 	= ВидОперации.Тип.Типы()[0];
			НайденныйОбъект = Метаданные.НайтиПоТипу(НайденныйТип);
				
			Если Метаданные.Перечисления.Найти(НайденныйОбъект.Имя) <> Неопределено Тогда
				Для каждого ТекЗначение Из НайденныйОбъект.ЗначенияПеречисления Цикл
					Результат.Добавить(Перечисления[НайденныйОбъект.Имя][ТекЗначение.Имя], ТекЗначение.Синоним);
				КонецЦикла;
			КонецЕсли;	
		
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
&НаСервере
Функция ПолучитьСоответствиеВидовОперацийФормам(ИмяОбъекта, ВыбранныйВидОперации)     
	
	Если ИмяОбъекта = "РеализацияТоваровУслуг" Тогда
		Возврат Документы["РеализацияТоваровУслуг"].ПолучитьСоответствиеВидовОперацийФормам(); 
	ИначеЕсли ИмяОбъекта = "ПоступлениеТоваровУслуг" Тогда
		Возврат Документы["ПоступлениеТоваровУслуг"].ПолучитьСоответствиеВидовОперацийФормам(); 
	ИначеЕсли ИмяОбъекта = "ВозвратТоваровОтПокупателя" Тогда
		Возврат Документы["ВозвратТоваровОтПокупателя"].ПолучитьСоответствиеВидовОперацийФормам();  
	ИначеЕсли ИмяОбъекта = "ВозвратТоваровПоставщику" Тогда
		Возврат Документы["ВозвратТоваровПоставщику"].ПолучитьСоответствиеВидовОперацийФормам();  
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ИмяОсновнойФормыОбъекта(ВидОбъекта, ИмяОбъекта)

	// Имя основной формы у объектов конфигурации разное (ФормаДокумента, ФормаЭлемента, в отдельных
	// объектах ERP-наследия — ФормаОбъекта), поэтому берем его из метаданных, а не задаем строкой.
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ВидОбъекта + "." + ИмяОбъекта);

	Если ОбъектМетаданных <> Неопределено
		И (Метаданные.Документы.Содержит(ОбъектМетаданных)
			ИЛИ Метаданные.Справочники.Содержит(ОбъектМетаданных)) Тогда

		ОсновнаяФорма = ОбъектМетаданных.ОсновнаяФормаОбъекта;
		Если ОсновнаяФорма <> Неопределено Тогда
			Возврат ОсновнаяФорма.Имя;
		КонецЕсли;

	КонецЕсли;

	// Основная форма не определена — сохраняем прежнее поведение модуля.
	Возврат "ФормаОбъекта";

КонецФункции

&НаКлиенте
Процедура ПослеВыбораВидаОперации(ВыбранныйЭлемент, ПараметрыОбъекта) Экспорт
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СессияБитрикс24"		, СессияБитрикс24);
	ДополнительныеПараметры.Вставить("НастройкаПодключения"	, НастройкаПодключения);    		
	ДополнительныеПараметры.Вставить("ВидОбъекта"			, ВидОбъекта);    		
	ДополнительныеПараметры.Вставить("ИмяОбъекта"			, ИмяОбъекта);    		     
	
	Если ВыбранныйЭлемент <> Неопределено Тогда    
		
		ВыбранныйВидОперации = ВыбранныйЭлемент.Значение;  

		ПараметрыОбъекта.Вставить("ЗначенияЗаполнения", Новый Структура("ВидОперации", ВыбранныйВидОперации));    		     
		
	 	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОткрытияФормыОбъекта", ЭтотОбъект, ДополнительныеПараметры);  
		
		ФормыДокумента   = Новый ФиксированноеСоответствие(ПолучитьСоответствиеВидовОперацийФормам(ИмяОбъекта, ВыбранныйВидОперации));
		ФормаНовогоОбъекта = ОткрытьФорму(ВидОбъекта+"."+ИмяОбъекта+".Форма."+ФормыДокумента[ВыбранныйВидОперации], ПараметрыОбъекта, ЭтотОбъект,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.Независимый);  
		
		Если НоваяСущность И НЕ ВводитсяНаОсновании Тогда 
			Б24_КБ_РаботаИзОдногоОкнаКлиент.ЗаполнениеОбъекта1С(ФормаНовогоОбъекта, ВидОбъекта, ИмяОбъекта, СлужебноеИмяОбъекта, ПараметрыОбъекта);	
		КонецЕсли;   
	Иначе
		ПослеОткрытияФормыОбъекта(Истина, ДополнительныеПараметры); 	
	КонецЕсли; 
	
КонецПроцедуры


