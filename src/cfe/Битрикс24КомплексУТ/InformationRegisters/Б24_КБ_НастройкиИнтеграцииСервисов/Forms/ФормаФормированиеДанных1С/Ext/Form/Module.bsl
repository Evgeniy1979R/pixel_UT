&НаСервере
Процедура ПривязыватьЗаказКСделкеНаСервере(ФормаПараметрыБ24, Ссылка)

	Если НЕ ФормаПараметрыБ24 = Неопределено
		и ФормаПараметрыБ24.Свойство("ДанныеСущностиБитрикс24") Тогда
		
		ДанныеСущностиБитрикс24 = ФормаПараметрыБ24.ДанныеСущностиБитрикс24;	
		СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(ДанныеСущностиБитрикс24.НастройкаПодключения);
		НастройкиИнтеграцииСервисов = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(ДанныеСущностиБитрикс24.НастройкаПодключения);		
		Если НастройкиИнтеграцииСервисов.Настройки.Получить() = Неопределено Тогда
			НастройкиИнтеграцииСервисов.Настройки = Новый ХранилищеЗначения(РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоУмолчанию());	
		КонецЕсли;		
		СохраненныеНастройки = НастройкиИнтеграцииСервисов.Настройки.Получить();
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СохраненныеНастройки, "ПривязыватьЗаказКСделке") Тогда
			ПривязыватьЗаказКСделке = СохраненныеНастройки.ПривязыватьЗаказКСделке;
		Иначе
			ПривязыватьЗаказКСделке = Ложь;
		КонецЕсли;	
		Если ПривязыватьЗаказКСделке и ДанныеСущностиБитрикс24.ТипВладельца = "2" Тогда 
			РегистрыСведений.Б24_К_ИдентификаторыОбъектов.ЗаписатьИдБ24Объекта(
			СтруктураНастроек, СтруктураНастроек.ТипыОбъектовОбмена.Сделка, Ссылка, ДанныеСущностиБитрикс24.ИдентификаторВладельца);
			ПараметрыЗапроса = Б24_К_ВыгрузкаДелСервер.ПолучитьТелоЗапросаДела(СтруктураНастроек, "Стандартное", ДанныеСущностиБитрикс24.ТипВладельца,
			ДанныеСущностиБитрикс24.ИдентификаторВладельца, "", Ссылка,, Истина);
			ДелоСоздано = Б24_К_ВыгрузкаДелСервер.ДелоСозданоВБитрикс24(СтруктураНастроек, "Стандартное", ПараметрыЗапроса,
			Ссылка, ДанныеСущностиБитрикс24.ТипВладельца, ДанныеСущностиБитрикс24.ИдентификаторВладельца, СтруктураНастроек.ТипыОбъектовОбмена.ДелоСделки);  
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры


&НаСервере
Процедура Б24_БП_ЗаписатьЛогОжидания(ТекстСообщения, ТипСтрокой = "Информация", ПоказатьСостояниеРегистра = Ложь)

	// Диагностика ожидания данных формы нового документа. Экземпляр формы пишется в лог,
	// чтобы по нему отличить двойное открытие формы от не найденных данных.
	Если ПоказатьСостояниеРегистра Тогда
		ТекстСообщения = ТекстСообщения + ". Состояние регистра Б24_КБ_ДанныеДляНовыхДокументовИзБитрикс24 по сессии: " + Б24_БП_ОписаниеДанныхРегистра();
	КонецЕсли;

	Б24_БП_ЗаписатьЛогОткрытия(ТекстСообщения, ТипСтрокой);

КонецПроцедуры

&НаСервере
Функция Б24_БП_ОписаниеДанныхРегистра()

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СессияБитрикс24", СессияБитрикс24);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_КБ_ДанныеДляНовыхДокументовИзБитрикс24.ТипОбъекта КАК ТипОбъекта
	|ИЗ
	|	РегистрСведений.Б24_КБ_ДанныеДляНовыхДокументовИзБитрикс24 КАК Б24_КБ_ДанныеДляНовыхДокументовИзБитрикс24
	|ГДЕ
	|	Б24_КБ_ДанныеДляНовыхДокументовИзБитрикс24.ИдСессии = &СессияБитрикс24";

	Выборка = Запрос.Выполнить().Выбрать();

	ВсегоСтрок = 0;
	ЕстьКонецДанных = Ложь;
	ТипыСтрок = "";

	Пока Выборка.Следующий() Цикл

		ВсегоСтрок = ВсегоСтрок + 1;

		Если Выборка.ТипОбъекта = "КонецДанных" Тогда
			ЕстьКонецДанных = Истина;
		КонецЕсли;

		ТипыСтрок = ТипыСтрок + ?(ПустаяСтрока(ТипыСтрок), "", ",") + Строка(Выборка.ТипОбъекта);

	КонецЦикла;

	Возврат "всего строк=" + Строка(ВсегоСтрок) + ", КонецДанных=" + ?(ЕстьКонецДанных, "есть", "НЕТ") + ", типы=" + ?(ПустаяСтрока(ТипыСтрок), "нет", ТипыСтрок);

КонецФункции

&НаСервере
Процедура Б24_БП_ЗаписатьЛогОткрытия(ТекстСообщения, ТипСтрокой = "Информация") Экспорт
	Если ЗначениеЗаполнено(НастройкаПодключения) Тогда
		СтруктураНастроек = Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения);
		Если СтруктураНастроек <> Неопределено И СтруктураНастроек.Свойство("ТипыСообщений") Тогда
			ТипСообщения = ?(ТипСтрокой = "Ошибка", СтруктураНастроек.ТипыСообщений.Ошибка, СтруктураНастроек.ТипыСообщений.Информация);
			Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек, ТипСообщения, "Б24_БП_ОткрытиеДокумента: " + ТекстСообщения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
