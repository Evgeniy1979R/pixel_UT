	Результат.Вставить("Учет"					, Учет);
	
	Возврат Результат;
	
КонецФункции

Функция ЗаполнитьВстройкиПоУмолчанию(ВидДанных) Экспорт
	
	//1 - лиды
	//2 - сделка
	//4 - контакт
	//8 - компания
	//1 лид
	//2 сделка
	//3 лид, сделка
	//4 контакт
	//5 лид, контакт
	//6 сделка, контакт
	//7 лид, сделка, контакт
	//8 компания
	//9 лид, компания
	//10 сделка, компания
	//11 лид, сделка, компания
	//12 контакт, компания      
	//15 лид, сделка, контакт, компания	

	ТзнВстройки = Новый ТаблицаЗначений;
	ТзнВстройки.Колонки.Добавить("ТипОбъекта"			, Новый ОписаниеТипов("Строка"));
	ТзнВстройки.Колонки.Добавить("ИмяОбъекта"			, Новый ОписаниеТипов("Строка"));
	ТзнВстройки.Колонки.Добавить("ПредставлениеВстройки", Новый ОписаниеТипов("Строка"));
	ТзнВстройки.Колонки.Добавить("ИмяВстройки"			, Новый ОписаниеТипов("Строка"));
	ТзнВстройки.Колонки.Добавить("СущностиБитрикс24"	, Новый ОписаниеТипов("СписокЗначений")); 
		
	Если ВидДанных = "Отчет" Тогда  
		ТзнВстройки.Колонки.Добавить("ДополнительныйОтчет", Новый ОписаниеТипов("СправочникСсылка.ДополнительныеОтчетыИОбработки"));
	КонецЕсли;
	
	Если ВидДанных = "Ссылка" Тогда     
		мДанные = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьДокументыДляВзаимодействия();
	ИначеЕсли ВидДанных = "Отчет" Тогда  
		мДанные = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьОтчетыДляВзаимодействия();
	КонецЕсли;
	
	Для каждого ТекЭлемент Из мДанные Цикл
			
		Если НЕ ТекЭлемент.ОтображатьПоУмолчанию Тогда
			Продолжить;
		КонецЕсли;
			
		НоваяСтрока = ТзнВстройки.Добавить();	 
		
		НоваяСтрока.ТипОбъекта 	= ?(ВидДанных = "Ссылка", "Документ", "Отчет"); 
		НоваяСтрока.ИмяОбъекта 	= ТекЭлемент.Имя; 
		НоваяСтрока.ИмяВстройки = ТекЭлемент.Имя; 
		НоваяСтрока.ПредставлениеВстройки = Лев(ТекЭлемент.Представление, 33); 
		
		НоваяСтрока.СущностиБитрикс24.Добавить("CRM_SMART_INVOICE_DETAIL_TOOLBAR", "Счета", Истина);
		
		Если ТекЭлемент.Местоположение = "1" ИЛИ ТекЭлемент.Местоположение = "3" ИЛИ ТекЭлемент.Местоположение = "5" ИЛИ ТекЭлемент.Местоположение = "7" 
			ИЛИ ТекЭлемент.Местоположение = "9" ИЛИ ТекЭлемент.Местоположение = "11" ИЛИ ТекЭлемент.Местоположение = "15" Тогда	 
			
			НоваяСтрока.СущностиБитрикс24.Добавить("CRM_LEAD_DETAIL_TOOLBAR", "Лиды", Истина);
			
		КонецЕсли;
		Если ТекЭлемент.Местоположение = "4" ИЛИ ТекЭлемент.Местоположение = "5" ИЛИ ТекЭлемент.Местоположение = "6" ИЛИ ТекЭлемент.Местоположение = "7" 
			ИЛИ ТекЭлемент.Местоположение = "12" ИЛИ ТекЭлемент.Местоположение = "15" Тогда	
			
			НоваяСтрока.СущностиБитрикс24.Добавить("CRM_CONTACT_DETAIL_TOOLBAR", "Контакты", Истина);
			
		КонецЕсли;
		Если ТекЭлемент.Местоположение = "8" ИЛИ ТекЭлемент.Местоположение = "9" ИЛИ ТекЭлемент.Местоположение = "10" ИЛИ ТекЭлемент.Местоположение = "11" 
			ИЛИ ТекЭлемент.Местоположение = "12" ИЛИ ТекЭлемент.Местоположение = "15" Тогда	
			
			НоваяСтрока.СущностиБитрикс24.Добавить("CRM_COMPANY_DETAIL_TOOLBAR", "Компании", Истина);
			
		КонецЕсли;
		Если ТекЭлемент.Местоположение = "2" ИЛИ ТекЭлемент.Местоположение = "3" ИЛИ ТекЭлемент.Местоположение = "6" ИЛИ ТекЭлемент.Местоположение = "7" 
			ИЛИ ТекЭлемент.Местоположение = "10" ИЛИ ТекЭлемент.Местоположение = "11" ИЛИ ТекЭлемент.Местоположение = "15" Тогда	
			
			НоваяСтрока.СущностиБитрикс24.Добавить("CRM_DEAL_DETAIL_TOOLBAR", "Сделки", Истина);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат ТзнВстройки;
	
КонецФункции

#КонецОбласти


#Область Прочее

Функция ПолучитьНастройкиИнтеграцииСервисовПоУмолчанию() Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	НастройкиОбмена = Новый Структура;
	
	///////////////////////////////////////////
	// 			КОНТРАГЕНТЫ					//
	/////////////////////////////////////////
	
		СпкПорядокИдентификацииЮ = Новый СписокЗначений;
		СпкПорядокИдентификацииЮ.Добавить("Внешний идентификатор");
		
		СпкПорядокИдентификацииФ = Новый СписокЗначений;
		СпкПорядокИдентификацииФ.Добавить("Внешний идентификатор");
	
		НастройкиКлиентов = Новый Структура;
		НастройкиКлиентов.Вставить("ПорядокИдентификацииФизЛиц"	, СпкПорядокИдентификацииФ);
		НастройкиКлиентов.Вставить("ПорядокИдентификацииЮрЛиц"	, СпкПорядокИдентификацииЮ);
		
		НастройкиКлиентов.Вставить("ЗагружатьКонтрагентовМодулемСинхронизации"	, Ложь);
		НастройкиКлиентов.Вставить("ЗагружатьКонтрагентов"						, Истина);
		НастройкиКлиентов.Вставить("ОбновлятьКонтрагентов"						, Истина);
		Если ТипКонфигурации = "БП" или ТипКонфигурации = "ЗУП" Тогда
			НастройкиКлиентов.Вставить("ГруппаДляНовыхКонтрагентов"	, Справочники.Контрагенты.ПустаяСсылка());
		ИначеЕсли ТипКонфигурации = "УТ" Тогда
			НастройкиКлиентов.Вставить("ГруппаДляНовыхКонтрагентов"	, Справочники["Партнеры"].ПустаяСсылка());
		ИначеЕсли ТипКонфигурации = "УНФ" Тогда
			НастройкиКлиентов.Вставить("ГруппаДляНовыхКонтрагентов"	, Справочники.Контрагенты.ПустаяСсылка());
		КонецЕсли;

	НастройкиОбмена.Вставить("НастройкиКлиентов", НастройкиКлиентов);
	
	///////////////////////////////////////////
	// 			ПРОЧЕЕ						//
	/////////////////////////////////////////
	
	НастройкиОбмена.Вставить("ПериодичностьОбновленияИндексаКлиента", 7);
	НастройкиОбмена.Вставить("ФормироватьСправки1СПАРКРиски"				, Ложь);
	НастройкиОбмена.Вставить("ЭкспортТоваровИзСделок"						, Ложь);
	НастройкиОбмена.Вставить("ИмпортТоваровВСделки"							, Ложь);
	НастройкиОбмена.Вставить("НеСинхронизироватьЗаказыПривязанныеКСделкам"	, Ложь);
	НастройкиОбмена.Вставить("НазваниеВстройкиБитриксПоиск"					, "Искать в 1С (ИНН, ФИО или название)");
	Если ТипКонфигурации = "УТ" ИЛИ ТипКонфигурации = "УНФ" Тогда
		НастройкиОбмена.Вставить("ПривязыватьЗаказКСделке"					, Ложь);
	КонецЕсли;
	
	Возврат НастройкиОбмена;
	
КонецФункции

Процедура ДобавитьНастройкуВСтруктуру(СтруктураНастроек, НазваниеНастройки, ЗначениеНастройки) Экспорт
	
	Если СтруктураНастроек.Свойство(НазваниеНастройки) Тогда
		СтруктураНастроек[НазваниеНастройки] = ЗначениеНастройки;	
	Иначе
		СтруктураНастроек.Вставить(НазваниеНастройки, ЗначениеНастройки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


