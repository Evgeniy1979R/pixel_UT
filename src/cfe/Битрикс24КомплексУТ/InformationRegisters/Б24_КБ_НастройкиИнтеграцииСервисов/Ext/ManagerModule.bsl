Функция ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("НастройкаПодключения"	, Справочники.Б24_К_НастройкиПодключения.ПустаяСсылка());
	Результат.Вставить("РаботаИзОдногоОкна"		, Ложь);
	Результат.Вставить("РеестрПечатныхФорм"		, Ложь);
	Результат.Вставить("Сервис1СПАРКРиски"		, Ложь);
	Результат.Вставить("БитриксПоиск"			, Ложь);
	Результат.Вставить("Настройки"				, Новый ХранилищеЗначения(Неопределено));
	Результат.Вставить("НаименованиеВстройкиБитриксПоиск", "Искать в 1С (ИНН, ФИО или название)");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкаПодключения", НастройкаПодключения);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_КБ_НастройкиИнтеграцииСервисов.НастройкаПодключения КАК НастройкаПодключения,
	|	Б24_КБ_НастройкиИнтеграцииСервисов.РаботаИзОдногоОкна КАК РаботаИзОдногоОкна,
	|	Б24_КБ_НастройкиИнтеграцииСервисов.РеестрПечатныхФорм КАК РеестрПечатныхФорм,
	|	Б24_КБ_НастройкиИнтеграцииСервисов.Сервис1СПАРКРиски КАК Сервис1СПАРКРиски,
	|	Б24_КБ_НастройкиИнтеграцииСервисов.БитриксПоиск КАК БитриксПоиск,
	|	Б24_КБ_НастройкиИнтеграцииСервисов.Настройки КАК Настройки
	|ИЗ
	|	РегистрСведений.Б24_КБ_НастройкиИнтеграцииСервисов КАК Б24_КБ_НастройкиИнтеграцииСервисов
	|ГДЕ
	|	Б24_КБ_НастройкиИнтеграцииСервисов.НастройкаПодключения = &НастройкаПодключения";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Результат.Настройки.Получить() = Неопределено Тогда
		Результат.Настройки = Новый ХранилищеЗначения(ПолучитьНастройкиИнтеграцииСервисовПоУмолчанию());	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСохраненнуюНастройкуИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения, Ключ, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Результат = ЗначениеПоУмолчанию;
	
	НайденнаяНастройка = РегистрыСведений.Б24_КБ_НастройкиИнтеграцииСервисов.ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения); 
	Если ЗначениеЗаполнено(НайденнаяНастройка) Тогда
		НастройкиОбмена = НайденнаяНастройка.Настройки.Получить();
		Если НастройкиОбмена.Свойство(Ключ) Тогда 
			Результат = НастройкиОбмена[Ключ];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

