
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ВыгрузкаНастроек

Процедура ВыгрузитьНастройкиВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт
	
	НастройкаПодключения 		= ПараметрыВыгрузки.НастройкаПодключения;
	Наименование 				= ПараметрыВыгрузки.Наименование;
	СтруктураНастроек 			= ПараметрыВыгрузки.СтруктураНастроек;
	ИдентификаторПодключения	= ПараметрыВыгрузки.СтруктураНастроек.ИдентификаторПодключения;
	
	
	ИнформацияОНастройке = Неопределено;
	
	мНастройки = Справочники.Б24_К_НастройкиПодключения.ПолучитьНастройкиСПортала(СтруктураНастроек);
	Для каждого ТекЭлемент Из мНастройки Цикл
		
		Если ТекЭлемент.КлючНастройки = ИдентификаторПодключения Тогда
			ИнформацияОНастройке = ТекЭлемент;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИнформацияОНастройке = Неопределено Тогда
		
		Б24_К_ОбщегоНазначенияВызовСервера.ДобавитьВЛог(СтруктураНастроек,  СтруктураНастроек.ТипыСообщений.Информация, "Для настройки подключения:" + Строка(СтруктураНастроек.НастройкаПодключения) + " не выгружена встройка. Перевыгрузка встроек.");	
		
		НовыеПараметрыВыгрузки = Новый Структура;
		НовыеПараметрыВыгрузки.Вставить("НастройкаПодключения"			, НастройкаПодключения);
		НовыеПараметрыВыгрузки.Вставить("Наименование"					, Строка(НастройкаПодключения));
		НовыеПараметрыВыгрузки.Вставить("СтруктураНастроек"				, СтруктураНастроек);
		НовыеПараметрыВыгрузки.Вставить("ВстройкиСсылочныхДанных"		, ПараметрыВыгрузки.ВстройкиСсылочныхДанных);
		НовыеПараметрыВыгрузки.Вставить("ВстройкиОтчетов"				, ПараметрыВыгрузки.ВстройкиОтчетов);
	                                 
		Справочники.Б24_К_НастройкиПодключения.ВыгрузитьНастройки(НовыеПараметрыВыгрузки);
		ВыгрузитьНастройкиВФоне(НовыеПараметрыВыгрузки, "");
		
		Возврат;
		
	КонецЕсли;
			
	ДобавитьУдалитьВстройкиБитрикс24(ПараметрыВыгрузки);
	
КонецПроцедуры

Процедура ДобавитьУдалитьВстройкиБитрикс24(ПараметрыВыгрузки, УдалитьВстройки = Ложь) Экспорт
	
	СтруктураНастроек 			= ПараметрыВыгрузки.СтруктураНастроек;
	НастройкаПодключения		= ПараметрыВыгрузки.НастройкаПодключения;
	
	НастройкиИнтеграцииСервисов = ПолучитьНастройкиИнтеграцииСервисовПоНастройкеПодключения(НастройкаПодключения);
	Открывать1СИзБитрикс24		= НастройкиИнтеграцииСервисов.РаботаИзОдногоОкна;
	ВестиРеестрПечатныхФорм		= НастройкиИнтеграцииСервисов.РеестрПечатныхФорм;
	ВключитьБитриксПоиск	 	= НастройкиИнтеграцииСервисов.БитриксПоиск; 	
	Наименование 				= ПараметрыВыгрузки.Наименование;
	Портал 						= СтруктураНастроек.Портал;
	ИдентификаторПодключения 	= СтруктураНастроек.ИдентификаторПодключения;
	
	ВстройкиСсылочныхДанных 	= ПараметрыВыгрузки.ВстройкиСсылочныхДанных;
	ВстройкиОтчетов 			= ПараметрыВыгрузки.ВстройкиОтчетов;
	
	СпособОткрытия1С 			= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеХранилищаНастроек("ОбщиеНастройки", "СпособОткрытия1С");
	
	АдресДоПриложения = Б24_К_RestApiВызовСервера.ПолучитьАдресДоПриложенияБитрикс24()+"?idAdress="+ИдентификаторПодключения;
	СформированныеЗапросы = Новый Массив;

#Область УдалениеВстроек   
	ДанныеПортала = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/placement.get", ""); 
	Если ДанныеПортала <> Неопределено Тогда
	
		мВстройкиПортала = ДанныеПортала.Получить("result");
		Если мВстройкиПортала <> Неопределено Тогда     
			Для каждого ТекЭлемент Из мВстройкиПортала Цикл   
				
				МестоВстройки = ТекЭлемент.Получить("placement");
				
				Если МестоВстройки = "1C_PAGE" Тогда
					Продолжить;
				КонецЕсли;
				
				Если МестоВстройки = "CATALOG_EXTERNAL_PRODUCT" Тогда
					Продолжить;
				КонецЕсли;
				
				Хэндлер = ТекЭлемент.Получить("handler");
				Если СтрНайти(Хэндлер, "?idAdress="+ИдентификаторПодключения) > 0 Тогда
					СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.unbind?PLACEMENT="+МестоВстройки+"&HANDLER="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Хэндлер)));
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;  
		
	КонецЕсли; 
#КонецОбласти


#Область ЗапросыВстроекСлайдера   

	мКлючиВстроек = Новый Массив;
	
	ДанныеВстроек = Новый Массив;
	ДанныеВстроек.Добавить(ВстройкиСсылочныхДанных);
	ДанныеВстроек.Добавить(ВстройкиОтчетов);
	
	Для каждого ТекДанныеВстроек Из ДанныеВстроек Цикл 
		Для каждого ТекЭлемент Из ТекДанныеВстроек Цикл
			
			ИдентификаторБлокаНастройки = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(АдресДоПриложения+"&doc="+(ТекЭлемент.ПредставлениеВстройки)+"&webAdress="+(ТекЭлемент.ТипОбъекта+"."+ТекЭлемент.ИмяОбъекта));
			
			Если Открывать1СИзБитрикс24 <> Ложь И НЕ УдалитьВстройки Тогда
				Для каждого ТекМесто Из ТекЭлемент.СущностиБитрикс24 Цикл   
					
					Если ТекМесто.Пометка Тогда  
						мКлючиВстроек.Добавить(ТекМесто.Значение);
						СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT="+ТекМесто.Значение+"&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE="+ТекЭлемент.ПредставлениеВстройки+"&GROUP_NAME="+Наименование));
					КонецЕсли;
					
				КонецЦикла; 
			КонецЕсли;	
			
		КонецЦикла;  

	КонецЦикла;
	
	ИдентификаторБлокаНастройки = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(АдресДоПриложения+"&auth1c");

	Если СпособОткрытия1С <> "Горячий старт" И НЕ УдалитьВстройки Тогда
		
		Если мКлючиВстроек.Найти("CRM_COMPANY_DETAIL_TOOLBAR") <> Неопределено Тогда
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_COMPANY_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Авторизация&GROUP_NAME="+Наименование));
		КонецЕсли;
		
		Если мКлючиВстроек.Найти("CRM_CONTACT_DETAIL_TOOLBAR") <> Неопределено Тогда
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_CONTACT_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Авторизация&GROUP_NAME="+Наименование));
		КонецЕсли;
		
		Если мКлючиВстроек.Найти("CRM_LEAD_DETAIL_TOOLBAR") <> Неопределено Тогда
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_LEAD_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Авторизация&GROUP_NAME="+Наименование));
		КонецЕсли;
		
		Если мКлючиВстроек.Найти("CRM_DEAL_DETAIL_TOOLBAR") <> Неопределено Тогда
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_DEAL_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Авторизация&GROUP_NAME="+Наименование));
		КонецЕсли;
		
		Если мКлючиВстроек.Найти("CRM_SMART_INVOICE_DETAIL_TOOLBAR") <> Неопределено Тогда
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_SMART_INVOICE_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Авторизация&GROUP_NAME="+Наименование));
		КонецЕсли;
		
	КонецЕсли;
#КонецОбласти
	
	
#Область ЗапросыВстроекРеестра
	ИдентификаторБлокаНастройки = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(АдресДоПриложения+"&reg");

	Если ВестиРеестрПечатныхФорм <> Ложь И НЕ УдалитьВстройки Тогда
		СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_COMPANY_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Реестр документов в 1С&GROUP_NAME="+Наименование));
		СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_CONTACT_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Реестр документов в 1С&GROUP_NAME="+Наименование));
		СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_LEAD_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Реестр документов в 1С&GROUP_NAME="+Наименование));
		СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_DEAL_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Реестр документов в 1С&GROUP_NAME="+Наименование));
		СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_SMART_INVOICE_DETAIL_TOOLBAR&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=Реестр документов в 1С&GROUP_NAME="+Наименование));
	КонецЕсли;
#КонецОбласти


#Область ЗапросыВстроекCRMАналитики   
	Для каждого ТекЭлемент Из ВстройкиОтчетов Цикл

		ИдентификаторБлокаНастройки = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(АдресДоПриложения+"&analytics="+(ТекЭлемент.ПредставлениеВстройки)+"&webAdress="+(ТекЭлемент.ТипОбъекта+"."+ТекЭлемент.ИмяОбъекта));
		
		Если НЕ УдалитьВстройки Тогда
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_ANALYTICS_MENU&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE="+ТекЭлемент.ПредставлениеВстройки+"&GROUP_NAME=1С: "+Наименование));
		КонецЕсли;
		
	КонецЦикла;
#КонецОбласти
	

#Область ЗапросыВстроекБитриксПоиск
	ИдентификаторБлокаНастройки = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(АдресДоПриложения+"&seach");
	
	Если ВключитьБитриксПоиск <> Ложь И НЕ УдалитьВстройки Тогда
		
		СохраненныеНастройки = НастройкиИнтеграцииСервисов.Настройки.Получить();
		Если СохраненныеНастройки.Свойство("НазваниеВстройкиБитриксПоиск") Тогда 
			НазваниеВстройкиБитриксПоиск = СохраненныеНастройки.НазваниеВстройкиБитриксПоиск;
		Иначе
			НазваниеВстройкиБитриксПоиск = "Искать в 1С (ИНН, ФИО или название)";
		КонецЕсли;
		
		ФайлИконки = Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Base64Строка(БиблиотекаКартинок.Б24_К_ИконкаПоиска.ПолучитьДвоичныеДанные()));
		Иконка = "&ICON[fileData][0]=icon1C.png&ICON[fileData][1]=" + ФайлИконки;
		
		СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=CRM_DETAIL_SEARCH&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE=" + НазваниеВстройкиБитриксПоиск + Иконка));
	КонецЕсли;
#КонецОбласти


	КоличествоВЗапросе = 0;	
	ТелоHTTPЗапроса = "";
	Для каждого ТекЭлемент Из СформированныеЗапросы Цикл
		
		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + ТекЭлемент;	
		
		КоличествоВЗапросе = КоличествоВЗапросе + 1;
		
		Если КоличествоВЗапросе = 50 Тогда
			Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
			КоличествоВЗапросе = 0;	
			ТелоHTTPЗапроса= "";
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоВЗапросе > 0 Тогда
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУдалитьВстройкиБитрикс24ВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт
	
	ДобавитьУдалитьВстройкиБитрикс24(ПараметрыВыгрузки, ПараметрыВыгрузки.УдалитьВстройки);

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПараметрыВыгрузки);
	
КонецПроцедуры

Функция ПолучитьДокументыДляВзаимодействия() Экспорт
	
	ТипКонфигурации = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации();
	ОписаниеИспользуемыхДокументов = Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьОписаниеИспользуемыхДокументов();
	Результат = Новый Массив;
	
	Если ТипКонфигурации = "ЗУП" Тогда
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("ПриемНаРаботу"			, ОписаниеИспользуемыхДокументов.ПриемНаРаботу				, Истина, "15", "-"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("Увольнение"				, ОписаниеИспользуемыхДокументов.Увольнение					, Истина, "15", "-"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("КадровыйПеревод"			, ОписаниеИспользуемыхДокументов.КадровыйПеревод			, Истина, "15", "-"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("Отгул"					, ОписаниеИспользуемыхДокументов.Отгул						, Истина, "15", "-"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("Отпуск"					, ОписаниеИспользуемыхДокументов.Отпуск						, Истина, "15", "-"));
	ИначеЕсли ТипКонфигурации = "БП" Тогда
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("АктОбОказанииПроизводственныхУслуг"	, ОписаниеИспользуемыхДокументов.АктОбОказанииПроизводственныхУслуг		, Истина, "15", "+"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("АктСверкиВзаиморасчетов"				, ОписаниеИспользуемыхДокументов.АктСверкиВзаиморасчетов				, Ложь	, "15"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("ОказаниеУслуг"						, ОписаниеИспользуемыхДокументов.ОказаниеУслуг							, Истина, "15", "+"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("ОплатаПлатежнойКартой"				, ОписаниеИспользуемыхДокументов.ОплатаПлатежнойКартой					, Ложь	, "15"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("ПлатежноеПоручение"					, ОписаниеИспользуемыхДокументов.ПлатежноеПоручение						, Ложь	, "15"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("ПоступлениеНаРасчетныйСчет"			, ОписаниеИспользуемыхДокументов.ПоступлениеНаРасчетныйСчет				, Ложь	, "15"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("ПоступлениеТоваровУслуг"				, ОписаниеИспользуемыхДокументов.ПоступлениеТоваровУслуг				, Ложь	, "15", "-"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("ПриходныйКассовыйОрдер"				, ОписаниеИспользуемыхДокументов.ПриходныйКассовыйОрдер					, Ложь	, "15"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("РеализацияТоваровУслуг"				, ОписаниеИспользуемыхДокументов.РеализацияТоваровУслуг					, Истина, "15", "+"));
		Результат.Добавить(ПолучитьСтруктуруДанныхДляМенюБ24("СчетНаОплатуПокупателю"				, ОписаниеИспользуемыхДокументов.СчетНаОплатуПокупателю					, Истина, "15", "+"));
