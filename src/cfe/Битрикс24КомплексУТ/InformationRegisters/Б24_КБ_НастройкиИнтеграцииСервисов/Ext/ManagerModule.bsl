Функция ПолучитьСтруктуруДанныхДляМенюБ24(Имя, Представление, ОтображатьПоУмолчанию, Местоположение, Учет = "")

	Результат = Новый Структура;
	Результат.Вставить("Имя"					, Имя);
	Результат.Вставить("Представление"			, Представление);
	Результат.Вставить("ОтображатьПоУмолчанию"	, ОтображатьПоУмолчанию);
