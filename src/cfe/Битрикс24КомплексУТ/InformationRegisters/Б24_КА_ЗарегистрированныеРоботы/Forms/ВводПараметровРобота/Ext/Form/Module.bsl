
#Область ОбработчикиСобытийФормы   

 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)     
	 
	 мДанные = Новый Соответствие;
	 мДанные.Вставить(ВходныеПараметрыРобота, Параметры.ВходныеПараметры);
	 мДанные.Вставить(ВыходныеПараметрыРобота, Параметры.ВыходныеПараметры);
	 
	 Для каждого ТекДанные Из мДанные Цикл 
		 Для каждого ТекЭлемент Из ТекДанные.Значение Цикл
			 НоваяСтрока = ТекДанные.Ключ.Добавить();   
			 ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекЭлемент);
		 КонецЦикла;
	 КонецЦикла;
	 
	 КодОбработки 	= Параметры.КодОбработки;
	 ЭтоНовый		= Параметры.ЭтоНовый;
	 
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)   
	
	Элементы.ГруппаЛеваяЧасть.ТолькоПросмотр = НЕ ЭтоНовый; 
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОтмена(Команда)
	Закрыть();
КонецПроцедуры 

&НаКлиенте
Процедура КомандаГотово(Команда)   

	ПередаваемыеДанные = Новый Структура;
	ПередаваемыеДанные.Вставить("КодОбработки"				, КодОбработки);
	ПередаваемыеДанные.Вставить("ВходныеПараметрыРобота"	, Новый Массив);
	ПередаваемыеДанные.Вставить("ВыходныеПараметрыРобота"	, Новый Массив);
	
	соТаблицы = Новый Соответствие;
	соТаблицы.Вставить("ВходныеПараметрыРобота"	, ВходныеПараметрыРобота);
	соТаблицы.Вставить("ВыходныеПараметрыРобота", ВыходныеПараметрыРобота);
	Для каждого ТекТаблица Из соТаблицы Цикл
		Для каждого ТекСтрока Из ТекТаблица.Значение Цикл
			
			НовыйЭлемент = Новый Структура;
			НовыйЭлемент.Вставить("Имя"					, ТекСтрока.Имя);
			НовыйЭлемент.Вставить("Описание"			, ТекСтрока.Описание);
			НовыйЭлемент.Вставить("Тип"					, ТекСтрока.Тип);
			НовыйЭлемент.Вставить("ЗначениеПоУмолчанию"	, ТекСтрока.ЗначениеПоУмолчанию);
			НовыйЭлемент.Вставить("ЗначенияСписка"		, ТекСтрока.ЗначенияСписка);
			НовыйЭлемент.Вставить("Множественный"		, ТекСтрока.Множественный);
			НовыйЭлемент.Вставить("Обязательный"		, ТекСтрока.Обязательный);
			
			ПередаваемыеДанные[ТекТаблица.Ключ].Добавить(НовыйЭлемент);
			
		КонецЦикла;
	КонецЦикла;
	
	Закрыть(ПередаваемыеДанные);

КонецПроцедуры

#КонецОбласти    


#Область СобытияЭлементовФормы

&НаКлиенте
Процедура ПараметрыРоботаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр) 
	
	Отказ = Истина;
	
	Если Элемент.Имя = "ВходныеПараметрыРобота" Тогда
		НоваяСтрока = ВходныеПараметрыРобота.Добавить(); 
	Иначе
		НоваяСтрока = ВыходныеПараметрыРобота.Добавить();  
	КонецЕсли;
	
	НоваяСтрока.Имя 		= "parameter" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0");	
	НоваяСтрока.Описание 	= "Новый параметр";
	НоваяСтрока.Тип			= "Строка";
	
КонецПроцедуры  

&НаКлиенте
Процедура ПараметрыРоботаПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.Имя = "ВходныеПараметрыРобота" Тогда
		ТекущиеДанныеТЧ 	= Элементы.ВходныеПараметрыРобота.ТекущиеДанные;    
		ТекущийЭлементРТЧ	= Элементы.ВходныеПараметрыРобота.ТекущийЭлемент;
		лЭлементСписка 		= Элементы.ВходныеПараметрыРоботаЗначенияСписка;
		лЭлементЗначНаУМ 	= Элементы.ВходныеПараметрыРоботаЗначениеПоУмолчанию;      
	Иначе     
		ТекущиеДанныеТЧ 	= Элементы.ВыходныеПараметрыРобота.ТекущиеДанные; 
		ТекущийЭлементРТЧ	= Элементы.ВыходныеПараметрыРобота.ТекущийЭлемент;
		лЭлементСписка 		= Элементы.ВыходныеПараметрыРоботаЗначенияСписка;
		лЭлементЗначНаУМ 	= Элементы.ВыходныеПараметрыРоботаЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ТекущиеДанныеТЧ = Неопределено Тогда  
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекущийЭлементРТЧ.Имя = "ВходныеПараметрыРоботаЗначениеПоУмолчанию" И НЕ ТекущийЭлементРТЧ.Имя = "ВыходныеПараметрыРоботаЗначениеПоУмолчанию" 
		И НЕ ТекущийЭлементРТЧ.Имя = "ВходныеПараметрыРоботаЗначенияСписка" И НЕ ТекущийЭлементРТЧ.Имя = "ВыходныеПараметрыРоботаЗначенияСписка" Тогда
		Возврат;
	КонецЕсли;
	
	лЭлементСписка.ТолькоПросмотр 	= Истина;         
	ТекущиеДанныеТЧ.ЗначенияСписка.ТипЗначения =  Новый ОписаниеТипов("Строка"); 	
	
	лЭлементЗначНаУМ.ТолькоПросмотр 	= Ложь;		
	лЭлементЗначНаУМ.КнопкаСпискаВыбора = Ложь;
	лЭлементЗначНаУМ.МногострочныйРежим	= Ложь;

	Если ТекущиеДанныеТЧ.Тип = "Да/Нет" Тогда  
		лЭлементЗначНаУМ.ОграничениеТипа = Новый ОписаниеТипов("Булево");  
	ИначеЕсли ТекущиеДанныеТЧ.Тип = "Дата" Тогда     
		лЭлементЗначНаУМ.ОграничениеТипа = Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.Дата));  
	ИначеЕсли ТекущиеДанныеТЧ.Тип = "Дата/Время" Тогда  
		лЭлементЗначНаУМ.ОграничениеТипа = Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));  
	ИначеЕсли ТекущиеДанныеТЧ.Тип = "Число" Тогда  
		лЭлементЗначНаУМ.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12,4));  
	ИначеЕсли ТекущиеДанныеТЧ.Тип = "Целое число" Тогда   
		лЭлементЗначНаУМ.ОграничениеТипа = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12,0));  
	ИначеЕсли ТекущиеДанныеТЧ.Тип = "Список" Тогда 
		
		лЭлементСписка.ТолькоПросмотр 	= Ложь;    
		лЭлементЗначНаУМ.ТолькоПросмотр = Истина;		
		
	ИначеЕсли ТекущиеДанныеТЧ.Тип = "Строка" Тогда 
		лЭлементЗначНаУМ.ОграничениеТипа = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(200));  
	ИначеЕсли ТекущиеДанныеТЧ.Тип = "Текст" Тогда     
		лЭлементЗначНаУМ.МногострочныйРежим	= Истина;
		лЭлементЗначНаУМ.ОграничениеТипа = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(0));  
	ИначеЕсли ТекущиеДанныеТЧ.Тип = "Пользователь" Тогда 
		лЭлементЗначНаУМ.ТолькоПросмотр = Истина;		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыРоботаТипПриИзменении(Элемент)	
	Если Элемент.Имя = "ВходныеПараметрыРоботаТип" Тогда
		ТекущиеДанныеТЧ 	= Элементы.ВходныеПараметрыРобота.ТекущиеДанные;    
	Иначе     
		ТекущиеДанныеТЧ 	= Элементы.ВыходныеПараметрыРобота.ТекущиеДанные; 
	КонецЕсли;
	
	Если ТекущиеДанныеТЧ = Неопределено Тогда  
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеТЧ.ЗначениеПоУмолчанию = Неопределено;	
	ТекущиеДанныеТЧ.ЗначенияСписка.Очистить();
	
КонецПроцедуры

#КонецОбласти    
