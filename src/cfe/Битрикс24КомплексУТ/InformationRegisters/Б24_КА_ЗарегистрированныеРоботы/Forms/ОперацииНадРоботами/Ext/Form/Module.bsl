
#Область ОбработчикиСобытийФормы   

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкаПодключения = Параметры.НастройкаПодключения;    
	
	ИдентификаторПодключения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаПодключения, "ИдентификаторПодключения");
	
	ОбновитьРоботыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	Если НЕ Б24_К_СлужебныйВызовСервера.МодульАвтоматизацииДоступен(НастройкаПодключения) Тогда
		Б24_К_СлужебныйКлиент.ОповеститьОбНедоступностиФункционалаАвтоматизацииПоТарифномуПлану();
		Закрыть();	
	КонецЕсли;                          

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОбновить(Команда)
	ОбновитьРоботыНаСервере();
КонецПроцедуры 


&НаКлиенте
Процедура УдалитьРобота(Команда)  
	
	ВыполнитьАсинхронноУдалитьРобота();	  
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьАсинхронноУдалитьРобота()  
	
	ТекущиеДанныеТЧ = Элементы.РоботыБитрикс24.ТекущиеДанные;
	Если ТекущиеДанныеТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    Ответ = Ждать ВопросАсинх("Вы точно хотите удалить робота?", РежимДиалогаВопрос.ДаНет, 0);
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;	
	
	УдалитьРоботаНаСервере(ТекущиеДанныеТЧ.Код);   
	
КонецПроцедуры

&НаСервере
Процедура УдалитьРоботаНаСервере(Код)   
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Метод 			= "/rest/bizproc.robot.delete";
	ТелоHTTPЗапроса = "CODE=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Код);	
	
	Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 

	ОбновитьРоботыНаСервере();
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьРобота(Команда)  
			
	ВыполнитьАсинхронноДобавитьРобота();
	
КонецПроцедуры    

&НаКлиенте
Асинх Процедура ВыполнитьАсинхронноДобавитьРобота()  
			
	Если Б24_К_ОбщегоНазначенияВызовСервераПовтИсп.БазаИспользуетсяВМоделиСервиса() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Недоступно в модели сервиса");
		Возврат;
	КонецЕсли;

	Обещание = ВвестиСтрокуАсинх("", "Укажите название робота");
	
	Результат = Ждать обещание;   
	
	Если Результат = Неопределено Тогда
		Возврат;   
	ИначеЕсли Результат = "" Тогда     
		ДобавитьРобота(Неопределено); 
		Возврат;   
	КонецЕсли;
	
	ПередаваемыеПараметры = Новый Структура;     
	ПередаваемыеПараметры.Вставить("КодОбработки"		, ИнформацияЗаполненияКодаОбработки());
	ПередаваемыеПараметры.Вставить("ВходныеПараметры"	, Новый Массив);
	ПередаваемыеПараметры.Вставить("ВыходныеПараметры"	, Новый Массив);   
    ПередаваемыеПараметры.Вставить("ЭтоНовый"			, Истина);       
	
	ПередаваемыеПараметрыПриЗакрытии = Новый Структура;
    ПередаваемыеПараметрыПриЗакрытии.Вставить("НазваниеРобота"	, Результат);
    ПередаваемыеПараметрыПриЗакрытии.Вставить("ЭтоНовый"		, Истина);
	
	ОткрытьФорму("РегистрСведений.Б24_КА_ЗарегистрированныеРоботы.Форма.ВводПараметровРобота", ПередаваемыеПараметры,,,,, Новый ОписаниеОповещения("ВыполнитьПослеУказанияПараметровРобота", ЭтотОбъект, ПередаваемыеПараметрыПриЗакрытии), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры    

#КонецОбласти


#Область СобытияЭлементовФормы  

&НаКлиенте
Процедура РоботыБитрикс24Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанныеТЧ = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанныеТЧ.Типовой Тогда
		Возврат;
	КонецЕсли;   
	
	КодОбработки = ?(ЗначениеЗаполнено(ТекущиеДанныеТЧ.КодОбработки), ТекущиеДанныеТЧ.КодОбработки, ИнформацияЗаполненияКодаОбработки());
	
	ПередаваемыеПараметры = Новый Структура;     
	ПередаваемыеПараметры.Вставить("КодОбработки"		, КодОбработки);
	ПередаваемыеПараметры.Вставить("ВходныеПараметры"	, ТекущиеДанныеТЧ.ВходныеПараметры.ВыгрузитьЗначения());
	ПередаваемыеПараметры.Вставить("ВыходныеПараметры"	, ТекущиеДанныеТЧ.ВыходныеПараметры.ВыгрузитьЗначения());   
    ПередаваемыеПараметры.Вставить("ЭтоНовый"			, Ложь);   
	
	ПередаваемыеПараметрыПриЗакрытии = Новый Структура;
    ПередаваемыеПараметрыПриЗакрытии.Вставить("НазваниеРобота"	, "");
    ПередаваемыеПараметрыПриЗакрытии.Вставить("ЭтоНовый"		, Ложь);
	
	ОткрытьФорму("РегистрСведений.Б24_КА_ЗарегистрированныеРоботы.Форма.ВводПараметровРобота", ПередаваемыеПараметры,,,,, Новый ОписаниеОповещения("ВыполнитьПослеУказанияПараметровРобота", ЭтотОбъект, ПередаваемыеПараметрыПриЗакрытии), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти     


#Область РегистрацияРобота   

&НаСервере
Функция ЗарегистрироватьРоботаНаСервере(КодРобота, ИмяРобота, ПараметрыРобота)
	
	Результат = Истина;
			
	ТелоHTTPЗапроса = "CODE="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КодРобота) + "&NAME=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИмяРобота)       
	+"&HANDLER="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Б24_К_RestApiВызовСервера.ПолучитьАдресДоРоботаПриложенияБитрикс24()+"?idAdress="+ИдентификаторПодключения+"&robot="+КодРобота)
	+"&USE_SUBSCRIPTION=Y&USE_PLACEMENT=N"
	+"&PLACEMENT_HANDLER="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Б24_К_RestApiВызовСервера.ПолучитьАдресДоПриложенияБитрикс24()+"?idAdress="+ИдентификаторПодключения+"&setting"+"&robot="+КодРобота);
	
	ДополнитьЗапросРоботаПараметрами(ТелоHTTPЗапроса, Истина, ПараметрыРобота.ВходныеПараметрыРобота);
	ДополнитьЗапросРоботаПараметрами(ТелоHTTPЗапроса, Ложь, ПараметрыРобота.ВыходныеПараметрыРобота);
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, "/rest/bizproc.robot.add", ТелоHTTPЗапроса); 
	Если СтруктураОтвета <> Неопределено Тогда     
		result = СтруктураОтвета.Получить("result");
		Возврат result = Истина 
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДополнитьЗапросРоботаПараметрами(ТелоHTTPЗапроса, ЭтоВходящие, ПараметрыРобота)
	
	Если ЭтоВходящие Тогда
		КлючПараметраЗапроса = "PROPERTIES";
	Иначе
		КлючПараметраЗапроса = "RETURN_PROPERTIES";
	КонецЕсли;
	
	Для каждого ТекПараметр Из ПараметрыРобота Цикл     
		
		Если ТекПараметр.Тип = "Да/Нет" Тогда   
			ТипПараметра = "bool";
		ИначеЕсли ТекПараметр.Тип = "Дата" Тогда    
			ТипПараметра = "date";
		ИначеЕсли ТекПараметр.Тип = "Дата/Время" Тогда 
			ТипПараметра = "datetime";
		ИначеЕсли ТекПараметр.Тип = "Число" Тогда   
			ТипПараметра = "double";
		ИначеЕсли ТекПараметр.Тип = "Целое число" Тогда 
			ТипПараметра = "int";
		ИначеЕсли ТекПараметр.Тип = "Список" Тогда  
			ТипПараметра = "select";
		ИначеЕсли ТекПараметр.Тип = "Строка" Тогда
			ТипПараметра = "string";
		ИначеЕсли ТекПараметр.Тип = "Текст" Тогда 
			ТипПараметра = "text";
		ИначеЕсли ТекПараметр.Тип = "Пользователь" Тогда
			ТипПараметра = "user";
		Иначе
			Продолжить;
		КонецЕсли;
		
		ТелоHTTPЗапроса = ТелоHTTPЗапроса
		+"&"+КлючПараметраЗапроса+"["+ТекПараметр.Имя+"][Name]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПараметр.Описание)
		+"&"+КлючПараметраЗапроса+"["+ТекПараметр.Имя+"][Type]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТипПараметра)
		+"&"+КлючПараметраЗапроса+"["+ТекПараметр.Имя+"][Required]="+?(ТекПараметр.Обязательный, "Y", "N")
		+"&"+КлючПараметраЗапроса+"["+ТекПараметр.Имя+"][Multiple]="+?(ТекПараметр.Множественный, "Y", "N");    
		
		Если ТипПараметра = "bool" Тогда
			ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&"+КлючПараметраЗапроса+"["+ТекПараметр.Имя+"][Default]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(?(ТекПараметр.ЗначениеПоУмолчанию = Истина, "Y", "N"));
		Иначе
			ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&"+КлючПараметраЗапроса+"["+ТекПараметр.Имя+"][Default]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекПараметр.ЗначениеПоУмолчанию);
		КонецЕсли;			
		
		Если ТипПараметра = "select" Тогда     
			
			Для каждого ТекЗначениеСписка Из ТекПараметр.ЗначенияСписка Цикл     
				ТелоHTTPЗапроса = ТелоHTTPЗапроса+"&"+КлючПараметраЗапроса+"["+ТекПараметр.Имя+"][Options][]="+Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекЗначениеСписка.Значение);    
			КонецЦикла;
		КонецЕсли;		
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти  


#Область Прочие  

&НаСервере
Процедура ОбновитьРоботыНаСервере()
	
	РоботыБитрикс24.Очистить();
	
	СтруктураНастроек =  Б24_К_ОбщегоНазначенияВызовСервера.СформироватьСтруктуруНастроек(НастройкаПодключения, Истина);  
	Если СтруктураНастроек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторПодключения 	= Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьЗначениеРеквизитаОбъекта(НастройкаПодключения, "ИдентификаторПодключения");
	
	Метод 			= "/rest/bizproc.robot.list";
	ТелоHTTPЗапроса = "&start=-1&select[]=NAME&select[]=HANDLER";	
	
	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
	Если СтруктураОтвета <> Неопределено Тогда
		
		result = СтруктураОтвета.Получить("result");	
		Если result <> Неопределено Тогда
		
			Для каждого ТекЭлемент Из result Цикл
				Если Лев(ТекЭлемент, СтрДлина(ИдентификаторПодключения)+1)= ИдентификаторПодключения + "_" Тогда    
					РоботыБитрикс24.Добавить().Код = ТекЭлемент; 
				КонецЕсли;
			КонецЦикла;
		
		КонецЕсли;	                                                   
	КонецЕсли;
	
	Следующие = СтруктураОтвета.Получить("next"); 
	Пока ЗначениеЗаполнено(Следующие) Цикл
		
		Следующие = Формат(Следующие, "ЧГ=0");

		ТелоHTTPЗапроса = "&start="+Следующие;	
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		Если СтруктураОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		result = СтруктураОтвета.Получить("result");
		Если result <> Неопределено Тогда
			
			Для каждого ТекЭлемент Из result Цикл
				Если Лев(ТекЭлемент, СтрДлина(ИдентификаторПодключения)+1)= ИдентификаторПодключения + "_" Тогда
					РоботыБитрикс24.Добавить().Код = ТекЭлемент; 
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	   Следующие = СтруктураОтвета.Получить("next");
	   
   КонецЦикла;  

   Для Каждого ТекСтрока Из РоботыБитрикс24 Цикл  
	   
	   НазваниеРобота = Б24_КА_РоботыИТриггерыСервер.НазваниеРоботаПоКоду(ТекСтрока.Код);
	   Если ЗначениеЗаполнено(НазваниеРобота) Тогда
		   
		   ТекСтрока.Наименование 	= НазваниеРобота;
		   ТекСтрока.Типовой 		= Истина;   
		   
	   ИначеЕсли НЕ ТекСтрока.Типовой Тогда   
		   
		  Выборка = РегистрыСведений.Б24_КА_ЗарегистрированныеРоботы.Выбрать(Новый Структура("КодРобота",  ТекСтрока.Код));
		  Пока Выборка.Следующий() Цикл
			  
			  ДанныеРобота = Выборка.ДанныеРобота.Получить();  
			  Если ДанныеРобота <> Неопределено Тогда
				  ТекСтрока.Наименование 	= ДанныеРобота.Наименование;
				  ТекСтрока.КодОбработки 	= ДанныеРобота.КодОбработки;
				  ТекСтрока.ВходныеПараметры.ЗагрузитьЗначения(ДанныеРобота.ВходныеПараметры);
				  ТекСтрока.ВыходныеПараметры.ЗагрузитьЗначения(ДанныеРобота.ВыходныеПараметры); 
			  КонецЕсли;
			  
		  КонецЦикла;
		   
	   КонецЕсли;
	   
   КонецЦикла;
   
	ОбновитьСписокЗарегистрированныхРоботов();
   
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЗарегистрированныхРоботов()
    
	мДанные = Новый Массив;
	Для каждого ТекЭлемент Из РоботыБитрикс24 Цикл
		
		ОписаниеДанных = Новый Структура;
		
		ОписаниеДанных.Вставить("КодРобота"		, ТекЭлемент.Код);
		ОписаниеДанных.Вставить("Типовой"		, ТекЭлемент.Типовой); 
		
		ДанныеРобота = Новый Структура();
		ДанныеРобота.Вставить("Наименование"		, ТекЭлемент.Наименование);
		ДанныеРобота.Вставить("КодОбработки"		, ТекЭлемент.КодОбработки);
		ДанныеРобота.Вставить("ВходныеПараметры"	, ТекЭлемент.ВходныеПараметры.ВыгрузитьЗначения());
		ДанныеРобота.Вставить("ВыходныеПараметры"	, ТекЭлемент.ВыходныеПараметры.ВыгрузитьЗначения());
		
		ОписаниеДанных.Вставить("ДанныеРобота"	, ДанныеРобота);
		
		мДанные.Добавить(ОписаниеДанных);
		
	КонецЦикла;
	
	Б24_КА_РоботыИТриггерыСервер.ОбновитьСписокЗарегистрированныхРоботов(НастройкаПодключения.ИдентификаторПодключения, НастройкаПодключения.Портал, мДанные);

КонецПроцедуры

&НаСервере
Функция НовыйКодРобота()       
	
	СтруктураИменРоботов = Б24_КА_РоботыИТриггерыСервер.ПолучитьСтруктуруИменРоботов();
	
	КодРобота = НастройкаПодключения.ИдентификаторПодключения +"_"+ СтруктураИменРоботов.ПроизвольныйРобот +"_"+ Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0"); 

	Возврат КодРобота; 
	 
КонецФункции
 
&НаКлиенте
Процедура ВыполнитьПослеУказанияПараметровРобота(Результат, ДополнительныеПараметры) Экспорт
    
    Если Результат <> Неопределено Тогда
		
		Если ДополнительныеПараметры.ЭтоНовый Тогда      
			
			КодРобота = НовыйКодРобота();
			
			Зарегистрирован = ЗарегистрироватьРоботаНаСервере(КодРобота, ДополнительныеПараметры.НазваниеРобота, Результат);      
			Если Зарегистрирован Тогда    
				СтрокаРобота = РоботыБитрикс24.Добавить(); 
				СтрокаРобота.Код 			= КодРобота;   
				СтрокаРобота.Наименование 	= ДополнительныеПараметры.НазваниеРобота; 
				СтрокаРобота.КодОбработки 	= Результат.КодОбработки; 
				СтрокаРобота.ВходныеПараметры.ЗагрузитьЗначения(Результат.ВходныеПараметрыРобота);
				СтрокаРобота.ВыходныеПараметры.ЗагрузитьЗначения(Результат.ВыходныеПараметрыРобота);
			КонецЕсли;
			
		Иначе   
			СтрокаРобота = Элементы.РоботыБитрикс24.ТекущиеДанные;  
			СтрокаРобота.КодОбработки 	= Результат.КодОбработки; 
			СтрокаРобота.ВходныеПараметры.ЗагрузитьЗначения(Результат.ВходныеПараметрыРобота);
			СтрокаРобота.ВыходныеПараметры.ЗагрузитьЗначения(Результат.ВыходныеПараметрыРобота);
		КонецЕсли;   
		
		ОбновитьСписокЗарегистрированныхРоботов();  

    КонецЕсли;
	
КонецПроцедуры


