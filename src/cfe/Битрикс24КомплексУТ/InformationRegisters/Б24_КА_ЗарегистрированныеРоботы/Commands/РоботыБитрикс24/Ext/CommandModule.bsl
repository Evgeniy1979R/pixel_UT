
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ВыполнитьАсинхронноОбработкуКоманды();

КонецПроцедуры   

&НаКлиенте
Асинх Процедура ВыполнитьАсинхронноОбработкуКоманды()  
	
	МодульРоботыИТриггеры = Б24_К_ОбщегоНазначенияКлиент.ОбщийМодуль("Б24_КА_РоботыИТриггерыСерверПовтИсп");
	НастройкиПодключения = МодульРоботыИТриггеры.ПолучитьМассивНастроекАвтоматизации("ИспользоватьРоботов", Истина);
	
	КоличествоНастроек = НастройкиПодключения.Количество();
	Если КоличествоНастроек > 1 Тогда
		
		спкНастроек = Новый СписокЗначений;
		спкНастроек.ЗагрузитьЗначения(НастройкиПодключения);
		обещание = спкНастроек.ВыбратьЭлементАсинх("Выберите настройку подключения");
		
		Результат = Ждать обещание;   
		Если Результат = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Результат.Значение) Тогда
			Возврат;
		КонецЕсли;
		
		ПередаваемыеПараметры = Новый Структура("НастройкаПодключения"	, Результат.Значение);  
		ОткрытьФорму("РегистрСведений.Б24_КА_ЗарегистрированныеРоботы.Форма.ОперацииНадРоботами", ПередаваемыеПараметры,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли КоличествоНастроек = 1 Тогда             
		
		ПередаваемыеПараметры = Новый Структура("НастройкаПодключения"	, НастройкиПодключения[0]);   
		ОткрытьФорму("РегистрСведений.Б24_КА_ЗарегистрированныеРоботы.Форма.ОперацииНадРоботами", ПередаваемыеПараметры,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нет настроек с включенным функционалом роботов");
		Возврат;      
		
	КонецЕсли;     
	
КонецПроцедуры   
