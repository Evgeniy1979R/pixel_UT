
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область РаботаСНастройками

Функция ПолучитьМассивНастроекАвтоматизации(КлючНастройки = "", ЗначениеНастройки = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	
	Запрос = Новый Запрос;
	Если НЕ КлючНастройки = "" Тогда
		Запрос.УстановитьПараметр("ПараметрПоиска", ЗначениеНастройки);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Б24_КА_НастройкиАвтоматизации.НастройкаПодключения КАК НастройкаПодключения
	|ИЗ
	|	РегистрСведений.Б24_КА_НастройкиАвтоматизации КАК Б24_КА_НастройкиАвтоматизации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|		ПО Б24_КА_НастройкиАвтоматизации.НастройкаПодключения = Б24_К_НастройкиПодключения.Ссылка
	|ГДЕ
	|	Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	
	Если НЕ КлючНастройки = "" Тогда
		Запрос.Текст = Запрос.Текст + "
		|" + " И Б24_КА_НастройкиАвтоматизации."+КлючНастройки+" = &ПараметрПоиска";
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НастройкаПодключения");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКоличествоНастроекПодключенияАвтоматизации(КлючНастройки = "", ЗначениеНастройки = "") Экспорт
	
УстановитьПривилегированныйРежим(Истина);
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	Если НЕ КлючНастройки = "" Тогда
		Запрос.УстановитьПараметр("ПараметрПоиска", ЗначениеНастройки);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Б24_КА_НастройкиАвтоматизации.НастройкаПодключения) КАК Количество
	|ИЗ
	|	РегистрСведений.Б24_КА_НастройкиАвтоматизации КАК Б24_КА_НастройкиАвтоматизации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|		ПО Б24_КА_НастройкиАвтоматизации.НастройкаПодключения = Б24_К_НастройкиПодключения.Ссылка
	|ГДЕ
	|	Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	
	Если НЕ КлючНастройки = "" Тогда
		Запрос.Текст = Запрос.Текст + "
		|" + " И Б24_КА_НастройкиАвтоматизации."+КлючНастройки+" = &ПараметрПоиска";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Количество; 
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкуПодключенияПоУмолчаниюАвтоматизации(КлючНастройки = "", ЗначениеНастройки = "") Экспорт
	
УстановитьПривилегированныйРежим(Истина);
	
	Результат = Справочники.Б24_К_НастройкиПодключения.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Если НЕ КлючНастройки = "" Тогда
		Запрос.УстановитьПараметр("ПараметрПоиска", ЗначениеНастройки);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_КА_НастройкиАвтоматизации.НастройкаПодключения КАК НастройкаПодключения
	|ИЗ
	|	РегистрСведений.Б24_КА_НастройкиАвтоматизации КАК Б24_КА_НастройкиАвтоматизации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Б24_К_НастройкиПодключения КАК Б24_К_НастройкиПодключения
	|		ПО Б24_КА_НастройкиАвтоматизации.НастройкаПодключения = Б24_К_НастройкиПодключения.Ссылка
	|ГДЕ
	|	Б24_К_НастройкиПодключения.ПометкаУдаления = ЛОЖЬ";
	
	Если НЕ КлючНастройки = "" Тогда
		Запрос.Текст = Запрос.Текст + "
		|" + " И Б24_КА_НастройкиАвтоматизации."+КлючНастройки+" = &ПараметрПоиска";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка; 	
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкуАвтоматизацииПоНастройкеПодключения(НастройкаПодключения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьРоботов"		, Ложь);
	Результат.Вставить("ИспользоватьТриггеры"		, Ложь);
	Результат.Вставить("ПечатныеФормыСФаксимиле"	, Ложь);
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НастройкаПодключения", НастройкаПодключения);
	Запрос.Текст = "ВЫБРАТЬ
	|	Б24_КА_НастройкиАвтоматизации.НастройкаПодключения КАК НастройкаПодключения,
	|	Б24_КА_НастройкиАвтоматизации.ПечатныеФормыСФаксимиле КАК ПечатныеФормыСФаксимиле,
	|	Б24_КА_НастройкиАвтоматизации.ИспользоватьРоботов КАК ИспользоватьРоботов,
	|	Б24_КА_НастройкиАвтоматизации.ИспользоватьТриггеры КАК ИспользоватьТриггеры
	|ИЗ
	|	РегистрСведений.Б24_КА_НастройкиАвтоматизации КАК Б24_КА_НастройкиАвтоматизации
	|ГДЕ
	|	Б24_КА_НастройкиАвтоматизации.НастройкаПодключения = &НастройкаПодключения";
	
	ВыполненныйЗапрос = Запрос.Выполнить();
	
	Если НЕ ВыполненныйЗапрос.Пустой() Тогда
		
		Выборка = ВыполненныйЗапрос.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
			
			Возврат Результат;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область ВыгрузкаНастроек

Процедура ВыгрузитьНастройкиВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт
	
	СтруктураНастроек 			= ПараметрыВыгрузки.СтруктураНастроек;
	ИдентификаторПодключения	= ПараметрыВыгрузки.СтруктураНастроек.ИдентификаторПодключения;
	
	ИнформацияОНастройке = Неопределено;
	
	мНастройки = Справочники.Б24_К_НастройкиПодключения.ПолучитьНастройкиСПортала(СтруктураНастроек);
	Для каждого ТекЭлемент Из мНастройки Цикл
		
		Если ТекЭлемент.КлючНастройки = ИдентификаторПодключения Тогда
			ИнформацияОНастройке = ТекЭлемент;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИнформацияОНастройке = Неопределено Тогда
		ИнформацияОНастройке = Новый Структура;
		ИнформацияОНастройке.Вставить("КлючНастройки", ИдентификаторПодключения);
		
		ПараметрыНастройки = Новый Структура;
		ИнформацияОНастройке.Вставить("ПараметрыНастройки", ПараметрыНастройки);
		мНастройки.Добавить(ИнформацияОНастройке);
	КонецЕсли;
	
	ПараметрыНастройки = ИнформацияОНастройке.ПараметрыНастройки;
	
	Ключ_robots = Новый Структура;
#Область Роботы	
	ИтераторРоботов 	= 1;
	
	мРоботы 	=  Б24_КА_РоботыИТриггерыСервер.ПолучитьНастройкиРоботов();
	
	Для Каждого ТекРобот Из мРоботы Цикл
		
		РоботПортала = Новый Структура;
		
		РоботПортала.Вставить("code", ТекРобот.Имя);
		РоботПортала.Вставить("name", ТекРобот.Название);
		
		ИтераторОписанийПараметров = 1;
		ОписаниеПараметров = Новый Структура;
		Для каждого ТекОписаниеПараметра Из ТекРобот.ОписаниеПараметров Цикл
			ОписаниеПараметров.Вставить("Ключ_" + Формат(ИтераторОписанийПараметров, "ЧГ=0"), ТекОписаниеПараметра);
			ИтераторОписанийПараметров = ИтераторОписанийПараметров + 1;
		КонецЦикла;
		РоботПортала.Вставить("Ключ_descriptionParams", ОписаниеПараметров);
		
		ДокументыРобота = Новый Структура;
		ИтераторДокументов 	= 1;
		Для Каждого ТекДокумент Из ТекРобот.Документы Цикл
			
			ДокументРобота = Новый Структура;
			ДокументРобота.Вставить("name", ТекДокумент.Название);
			
			мДанныеДопПризнака = Новый Массив;
			Если ТекДокумент.ПечатныеФормы.Количество() > 0 Тогда
				мДанныеДопПризнака = ТекДокумент.ПечатныеФормы;	
			ИначеЕсли ТекДокумент.ДокументыНаОсновании.Количество() > 0 Тогда
				
				мВТ_Данные = Новый Массив;
				Для каждого ТекВремЭлемент Из ТекДокумент.ДокументыНаОсновании Цикл
					мВТ_Данные.Добавить(ТекВремЭлемент.Имя);	
				КонецЦикла;
				
				мДанныеДопПризнака = мВТ_Данные;	
			КонецЕсли;
			
			Если мДанныеДопПризнака.Количество() > 0 Тогда
				ДокументРобота.Вставить("params", мДанныеДопПризнака);
			КонецЕсли;

			ДокументыРобота.Вставить("Ключ_" + Формат(ИтераторДокументов, "ЧГ=0"), ДокументРобота);
			ИтераторДокументов = ИтераторДокументов + 1;
			
		КонецЦикла;
		РоботПортала.Вставить("Ключ_documents", ДокументыРобота);
		
		Ключ_robots.Вставить("Ключ_" + Формат(ИтераторРоботов, "ЧГ=0"), РоботПортала);
		ИтераторРоботов = ИтераторРоботов + 1;
		
	КонецЦикла;
#КонецОбласти	
	ПараметрыНастройки.Вставить("Ключ_robots", Ключ_robots);
	
	ИнформацияОНастройке.Вставить("ПараметрыНастройки", ПараметрыНастройки);
	
	
	ПараметрыЗапроса = "";
	Для каждого ТекНастройка Из мНастройки Цикл
		Для каждого ТекПараметр Из ТекНастройка.ПараметрыНастройки Цикл
			Справочники.Б24_К_НастройкиПодключения.СформироватьЗапросНастроекРекурсивно(ПараметрыЗапроса, "&options[ACCOUNTING]["+ТекНастройка.КлючНастройки+"]", ТекПараметр);
		КонецЦикла;
	КонецЦикла;
	
	Метод 		= "/rest/app.option.set";	
	
	Результат = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ПараметрыЗапроса); 
	
	Если ТипЗнч(Результат) = Тип("Соответствие") Тогда
		Если Результат.Получить("result") = Истина Тогда
			
			ДобавитьУдалитьВстройкиБитрикс24(ПараметрыВыгрузки);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУдалитьВстройкиБитрикс24(ПараметрыВыгрузки, УдалитьВстройки = Ложь)
	
	Наименование 				= ПараметрыВыгрузки.Наименование;
	СтруктураНастроек 			= ПараметрыВыгрузки.СтруктураНастроек;
	ИдентификаторПодключения	= ПараметрыВыгрузки.СтруктураНастроек.ИдентификаторПодключения;
	ИспользоватьРоботов			= ПараметрыВыгрузки.ИспользоватьРоботов;
	ИспользоватьТриггеры		= ПараметрыВыгрузки.ИспользоватьТриггеры;
	Портал                      = СтруктураНастроек.Портал;
	
	АдресДоПриложения = Б24_К_RestApiВызовСервера.ПолучитьАдресДоПриложенияБитрикс24()+"?idAdress="+ИдентификаторПодключения;
	СформированныеЗапросы = Новый Массив;
	
	ИдентификаторБлокаНастройки = АдресДоПриложения;
	СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.unbind?PLACEMENT=1C_PAGE&HANDLER="+ИдентификаторБлокаНастройки));
	
	Если НЕ УдалитьВстройки Тогда
		СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("placement.bind?PLACEMENT=1C_PAGE&HANDLER="+ИдентификаторБлокаНастройки+"&TITLE="+Наименование));
	КонецЕсли;
	      

#Область ЗапросыПоТриггерам
	Если УдалитьВстройки ИЛИ НЕ ИспользоватьТриггеры Тогда

		мТриггеры 		= Новый Массив;
		
		Метод 			= "/rest/crm.automation.trigger.list";
		ТелоHTTPЗапроса = "";	
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		
		Если СтруктураОтвета <> Неопределено Тогда
			
			Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
			
				Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
					
					КодТриггера = ТекЭлемент.Получить("CODE");
					
					Если Лев(КодТриггера, СтрДлина(ИдентификаторПодключения)+1)= ИдентификаторПодключения + "_" Тогда
						мТриггеры.Добавить(КодТриггера);
					КонецЕсли;
					
				КонецЦикла;
			
			КонецЕсли;	                                                   
		КонецЕсли;
		
		Если СтруктураОтвета <> Неопределено Тогда
	
			Следующие = СтруктураОтвета.Получить("next"); 
			
			Пока ЗначениеЗаполнено(Следующие) Цикл
				
				Следующие = Формат(Следующие, "ЧГ=0");

				ТелоHTTPЗапроса = "&start="+Следующие;	
				
				СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
				
				Если СтруктураОтвета = Неопределено Тогда
					Прервать;
				КонецЕсли;
				
				Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
					
					Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
						
						КодТриггера = ТекЭлемент.Получить("CODE");
						
						Если Лев(КодТриггера, СтрДлина(ИдентификаторПодключения)+1)= ИдентификаторПодключения + "_" Тогда
							мТриггеры.Добавить(КодТриггера);
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
				
			   Следующие = СтруктураОтвета.Получить("next");
			   
		   КонецЦикла;
		   
	   КонецЕсли;	   
	   
		Метод = "/rest/crm.automation.trigger.delete";	
		Для каждого ТекЭлемент Из мТриггеры Цикл
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("crm.automation.trigger.delete?CODE=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекЭлемент)));
		КонецЦикла;
		
		НаборЗаписей = РегистрыСведений.Б24_КА_ЗарегистрированныеТриггеры.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторПодключения.Установить(ИдентификаторПодключения);
		НаборЗаписей.Отбор.Портал.Установить(Портал);
		НаборЗаписей.Записать();
		
	КонецЕсли;		
#КонецОбласти


#Область ЗапросыПоРоботам

	мРоботы 		= Новый Массив;

	Метод 			= "/rest/bizproc.robot.list";
	ТелоHTTPЗапроса = "";	

	СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 

	Если СтруктураОтвета <> Неопределено Тогда
		
		Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
			
			Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
				
				КодРобота = ТекЭлемент;
				
				Если Лев(КодРобота, СтрДлина(ИдентификаторПодключения)+1)= ИдентификаторПодключения + "_" Тогда
					мРоботы.Добавить(КодРобота);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	                                                   
	КонецЕсли;

	Если СтруктураОтвета <> Неопределено Тогда
	
		Следующие = СтруктураОтвета.Получить("next"); 

		Пока ЗначениеЗаполнено(Следующие) Цикл
			
			Следующие = Формат(Следующие, "ЧГ=0");
			
			ТелоHTTPЗапроса = "&start="+Следующие;	
			
			СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
			
			Если СтруктураОтвета = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
				
				Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
					
					КодРобота = ТекЭлемент;
					
					Если Лев(КодРобота, СтрДлина(ИдентификаторПодключения)+1)= ИдентификаторПодключения + "_" Тогда
						мРоботы.Добавить(КодРобота);
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Следующие = СтруктураОтвета.Получить("next");
			
		КонецЦикла;
	КонецЕсли;         
	
	СтруктураИменРоботов = Б24_КА_РоботыИТриггерыСервер.ПолучитьСтруктуруИменРоботов();    
	
	Если УдалитьВстройки ИЛИ НЕ ИспользоватьРоботов Тогда
		
		Для каждого ТекЭлемент Из мРоботы Цикл      
			
			Если СтрНайти(ТекЭлемент, СтруктураИменРоботов.ПроизвольныйРобот) > 0 Тогда  //произвольные роботы не удаляем автоматом
				Продолжить;
			КонецЕсли;
			
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("bizproc.robot.delete?CODE=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ТекЭлемент))); 
			
		КонецЦикла;
		
	Иначе
		
		Для каждого ТекКлюч Из СтруктураИменРоботов Цикл 
			
			Если ТекКлюч.Значение = СтруктураИменРоботов.ПроизвольныйРобот Тогда
				Продолжить;	
			КонецЕсли;
			
			КодРобота = ИдентификаторПодключения + "_" + ТекКлюч.Значение;
			
			Если мРоботы.Найти(КодРобота) <> Неопределено Тогда
				Продолжить;	
			КонецЕсли;
			
			Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда				
				Если ТекКлюч.Значение = СтруктураИменРоботов.Проведение Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Проведение документа";	
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.Распроведение Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Распроведение документа";				   
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ЭкспортПечатнойФормы2 Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Экспорт печатной формы объекта";				
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ПроверкаНаличияДела Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Проверка наличия дела";	     
				КонецЕсли;				
			Иначе
				Если ТекКлюч.Значение = СтруктураИменРоботов.Проведение Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Проведение документа";	
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.Распроведение Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Распроведение документа";	
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ЭкспортПечатнойФормы Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Экспорт печатной формы документа";	   
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ЭкспортПечатнойФормы2 Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Экспорт печатной формы объекта";	
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.СозданиеДокументаНаОсновании Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Создание документа на основании";	 
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.СозданиеОбъектаНаОсновании Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Создание объекта на основании";	
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ПечатьЧека Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Добавить чек в очередь на печать";	
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ВыгрузкаДокументаВФайл Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Выгрузка документа в файл XML";	
				ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ПроверкаНаличияДела Тогда
					ИмяРобота = "("+ИдентификаторПодключения+") Проверка наличия дела";	     
				КонецЕсли;
			КонецЕсли;
			
		
			ТелоHTTPЗапроса = "?CODE=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(КодРобота) + "&NAME=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(ИмяРобота)
			+"&HANDLER=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Б24_К_RestApiВызовСервера.ПолучитьАдресДоРоботаПриложенияБитрикс24()+"?idAdress="+ИдентификаторПодключения+"&robot="+ТекКлюч.Значение)
			+"&USE_SUBSCRIPTION=Y&USE_PLACEMENT=Y"
			+"&PLACEMENT_HANDLER=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Б24_К_RestApiВызовСервера.ПолучитьАдресДоПриложенияБитрикс24()+"?idAdress="+ИдентификаторПодключения+"&setting"+"&robot="+ТекКлюч.Значение)
			
			+"&PROPERTIES[doc][Name]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Первый параметр")
			+"&PROPERTIES[doc][Type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("string")
			+"&PROPERTIES[doc][Required]=Y"
			
			+"&PROPERTIES[optParam][Name]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Второй параметр")
			+"&PROPERTIES[optParam][Type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("string")
			
			
			+"&RETURN_PROPERTIES[result][Name]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Результат")
			+"&RETURN_PROPERTIES[result][Type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("bool")
			+"&RETURN_PROPERTIES[result][Description]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Результат");
			
			Если ТекКлюч.Значение = СтруктураИменРоботов.ЭкспортПечатнойФормы ИЛИ ТекКлюч.Значение = СтруктураИменРоботов.ЭкспортПечатнойФормы2 Тогда    
				
            	ТелоHTTPЗапроса = ТелоHTTPЗапроса +"&RETURN_PROPERTIES[file][Name]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Файл")
				+"&RETURN_PROPERTIES[file][Type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("file")
				+"&RETURN_PROPERTIES[file][Description]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Файл")	 
				
				+"&RETURN_PROPERTIES[idDoc][Name]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Ид документа")
				+"&RETURN_PROPERTIES[idDoc][Type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("string")
				+"&RETURN_PROPERTIES[idDoc][Description]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Ид документа");
				
				Если ТекКлюч.Значение = СтруктураИменРоботов.ЭкспортПечатнойФормы2 Тогда    
					ТелоHTTPЗапроса = ТелоHTTPЗапроса +"&RETURN_PROPERTIES[pdfUrlMachine][Name]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Адрес pdf")
					+"&RETURN_PROPERTIES[pdfUrlMachine][Type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("string")
					+"&RETURN_PROPERTIES[pdfUrlMachine][Description]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Адрес pdf");
				КонецЕсли; 
				
			ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ВыгрузкаДокументаВФайл Тогда    
				
            	ТелоHTTPЗапроса = ТелоHTTPЗапроса +"&RETURN_PROPERTIES[idDoc][Name]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Ид комментария")
				+"&RETURN_PROPERTIES[idDoc][Type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("string")
				+"&RETURN_PROPERTIES[idDoc][Description]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Ид комментария");
				
			ИначеЕсли ТекКлюч.Значение = СтруктураИменРоботов.ПроверкаНаличияДела Тогда    
				
            	ТелоHTTPЗапроса = ТелоHTTPЗапроса +"&RETURN_PROPERTIES[Confirmed][Name]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Проведен")
				+"&RETURN_PROPERTIES[Confirmed][Type]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("bool")
				+"&RETURN_PROPERTIES[Confirmed][Description]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Проведен");
				
			КонецЕсли;          
			
			СформированныеЗапросы.Добавить("cmd[]=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("bizproc.robot.add"+ТелоHTTPЗапроса));
		
		КонецЦикла;
		
		СтроковыйИдентификаторХранилищаДанныхРоботов = Б24_КА_РоботыИТриггерыСервер.ПолучитьСтроковыйИдентификаторХранилищаДанныхРоботов();
		
		ЕстьХранилищеДанных = Ложь;
		
		Метод = "/rest/entity.get";
		//ТелоHTTPЗапроса = "ENTITY=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(Б24_КА_РоботыИТриггерыСервер.ПолучитьСтроковыйИдентификаторХранилищаДанныхРоботов());
		ТелоHTTPЗапроса = "";
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		
		Если СтруктураОтвета <> Неопределено Тогда
			
			Если СтруктураОтвета.Получить("result") <> Неопределено Тогда
				
				Для каждого ТекЭлемент Из СтруктураОтвета.Получить("result") Цикл
					
					Если ТекЭлемент.Получить("ENTITY") = СтроковыйИдентификаторХранилищаДанныхРоботов Тогда
						ЕстьХранилищеДанных = Истина;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;	                                                   
		КонецЕсли;
		
		Если ЕстьХранилищеДанных Тогда 
			Метод = "/rest/entity.update";
		Иначе
			Метод = "/rest/entity.add";
		КонецЕсли;
		
		ТелоHTTPЗапроса = "ENTITY=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер(СтроковыйИдентификаторХранилищаДанныхРоботов) 
		+"&NAME=" + Б24_К_RestApiВызовСервера.ЗакодироватьСтрокуСервер("Хранилище событий роботов коннектора к 1С")	
		+"&ACCESS[AU]=W";	
		
		СтруктураОтвета = Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПортал(СтруктураНастроек, Метод, ТелоHTTPЗапроса); 
		
	КонецЕсли;	
		
#КонецОбласти

	КоличествоВЗапросе = 0;	
	ТелоHTTPЗапроса = "";
	Для каждого ТекЭлемент Из СформированныеЗапросы Цикл
		
		ТелоHTTPЗапроса = ТелоHTTPЗапроса + "&" + ТекЭлемент;	
		
		КоличествоВЗапросе = КоличествоВЗапросе + 1;
		
		Если КоличествоВЗапросе = 50 Тогда
			Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
			КоличествоВЗапросе = 0;	
			ТелоHTTPЗапроса= "";
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоВЗапросе > 0 Тогда
		Б24_К_RestApiВызовСервера.ОтправкаДанныхНаПорталЧерезBatch(СтруктураНастроек, ТелоHTTPЗапроса);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУдалитьВстройкиБитрикс24ВФоне(ПараметрыВыгрузки, АдресРезультата) Экспорт
	
	ДобавитьУдалитьВстройкиБитрикс24(ПараметрыВыгрузки, ПараметрыВыгрузки.УдалитьВстройки);

	Б24_К_ОбщегоНазначенияВызовСервера.ПроверитьФоновоеЗаданиеВОчереди(ПараметрыВыгрузки);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли 
