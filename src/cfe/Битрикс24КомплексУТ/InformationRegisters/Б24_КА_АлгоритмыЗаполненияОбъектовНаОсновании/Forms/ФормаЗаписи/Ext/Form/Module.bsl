
#Область ОбработчикиСобытийФормы      

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтруктураИменРоботов = Б24_КА_РоботыИТриггерыСервер.ПолучитьСтруктуруИменРоботов();      
	Запись.Робот = СтруктураИменРоботов.СозданиеОбъектаНаОсновании; 
	
	ДанныеСозданияНаОсновании = Б24_КА_РоботыИТриггерыСервер.НастройкиРоботаСозданияНаОсновании();
	Для каждого ТекЭлемент Из ДанныеСозданияНаОсновании Цикл
		Элементы.ПервичныйКлюч.СписокВыбора.Добавить(ТекЭлемент.ИдДокумента, ТекЭлемент.Название);
	КонецЦикла;   

	ЗаполнитьСписокВторичногоКлюча();
	
	Если НЕ ЗначениеЗаполнено(Запись.Алгоритм) Тогда
		
		Если Б24_К_ОбщегоНазначенияВызовСервера.ПолучитьТипКонфигурации() = "ЗУП" Тогда
			Запись.Алгоритм = "
			|	//// Параметры.Основание		- ОбъектСсылка основание
			|	//// Параметры.НовыйОбъект	- Создаваемый объект				 	
			|
			|	//Параметры.НовыйОбъект.Комментарий = ""Основание - "" + Строка(Параметры.Основание); 
			|
			|	//УжеОбработан = Истина;  // Если истина, то пропускается кастомный код из модуля ""Б24_КА_РоботыИТриггерыСерверПереопределяемый""";
		Иначе
			Запись.Алгоритм = "
			|	//// Параметры.Основание		- ОбъектСсылка основание
			|	//// Параметры.НовыйОбъект	- Создаваемый объект
			|	
			|	//Параметры.НовыйОбъект.ЭквайринговыйТерминал = Справочники.СпособыОплаты.НайтиПоНаименованию(""Эквайринговый терминал  (ККТ с передачей в ОФД, фискальный регистратор или АСПД, принтер чеков (Розн""); 
			|	//Параметры.НовыйОбъект.ВидПлатежнойКарты = ""Картой""; 	
			|
			|	//Параметры.НовыйОбъект.Комментарий = ""Основание - "" + Строка(Параметры.Основание); 
			|
			|	//УжеОбработан = Истина;  // Если истина, то пропускается кастомный код из модуля ""Б24_КА_РоботыИТриггерыСерверПереопределяемый""";			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

#КонецОбласти


#Область СобытияЭлементовФормы  

&НаКлиенте
Процедура ПервичныйКлючОчистка(Элемент, СтандартнаяОбработка)   
	
	Запись.ВторичныйКлюч = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ПервичныйКлючОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)      

	Если Запись.ПервичныйКлюч <> ВыбранноеЗначение Тогда
		Запись.ВторичныйКлюч = "";
	КонецЕсли;
	
КонецПроцедуры        

&НаКлиенте
Процедура ВторичныйКлючНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Элементы.ВторичныйКлюч.СписокВыбора.Очистить();

	ЗаполнитьСписокВторичногоКлюча();

КонецПроцедуры

#КонецОбласти  


#Область Прочие  

&НаСервере
Процедура ЗаполнитьСписокВторичногоКлюча()
	
	ДанныеСозданияНаОсновании = Б24_КА_РоботыИТриггерыСервер.НастройкиРоботаСозданияНаОсновании();
	Для каждого ТекЭлемент Из ДанныеСозданияНаОсновании Цикл   
		
		Если ТекЭлемент.ИдДокумента = Запись.ПервичныйКлюч Тогда
			Для каждого ТекЭлемент2 Из ТекЭлемент.ДокументыНаОсновании Цикл
				Элементы.ВторичныйКлюч.СписокВыбора.Добавить(ТекЭлемент2.Ид, ТекЭлемент2.Имя);
			КонецЦикла;  
		КонецЕсли;  
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти  
